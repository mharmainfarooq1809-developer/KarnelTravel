
@model KarnelTravel.Models.Resort
@using KarnelTravel.Models

@{
    ViewData["Title"] = Model.Name;

    var reviews = ViewBag.Reviews as List<Review> ?? new List<Review>();
    double averageRating = ViewBag.AverageRating ?? 0;
    int totalReviews = ViewBag.TotalReviews ?? 0;

    var reviewUrl = Url.Action("Create", "Reviews", new
    {
        type = "Resort",
        id = Model.Id
    });

    var bookingUrl = Url.Action("Create", "Bookings", new
    {
        serviceType = "Resort",
        serviceId = Model.Id
    });
}

<style>
    .resort-details {
        background: var(--ivory, #f6f4ed);
        padding: 45px 0 80px;
    }

    .resort-container {
        max-width: 1180px;
        margin: auto;
        padding: 0 22px;
    }

    .resort-breadcrumb {
        margin-bottom: 25px;
        color: var(--muted, #777);
        font-size: 13px;
    }

    .resort-breadcrumb a {
        color: inherit;
        text-decoration: none;
    }

    .resort-hero {
        position: relative;
        min-height: 430px;
        overflow: hidden;
        border-radius: 18px;
        background: #263c32;
        display: flex;
        align-items: flex-end;
    }

    .resort-hero img {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .resort-hero::after {
        content: "";
        position: absolute;
        inset: 0;
        background: linear-gradient(
            0deg,
            rgba(12, 29, 22, .88),
            rgba(12, 29, 22, .05)
        );
    }

    .resort-hero-content {
        position: relative;
        z-index: 2;
        padding: 42px;
        color: white;
        max-width: 750px;
    }

    .resort-hero-content h1 {
        font-size: clamp(34px, 5vw, 58px);
        line-height: 1.1;
        margin: 12px 0;
        color: white;
    }

    .resort-location {
        color: rgba(255,255,255,.85);
        font-size: 15px;
    }

    .resort-layout {
        display: grid;
        grid-template-columns: minmax(0, 1fr) 330px;
        gap: 35px;
        margin-top: 38px;
        align-items: start;
    }

    .resort-panel {
        background: white;
        padding: 30px;
        border-radius: 14px;
        margin-bottom: 25px;
        border: 1px solid rgba(0,0,0,.06);
    }

    .resort-panel h2 {
        font-size: 25px;
        color: var(--forest-deep, #203d31);
        margin: 0 0 18px;
    }

    .resort-description {
        line-height: 1.9;
        color: #626a64;
        white-space: pre-line;
    }

    .resort-info-list {
        display: grid;
        gap: 18px;
    }

    .resort-info-item {
        display: flex;
        justify-content: space-between;
        gap: 15px;
        padding-bottom: 14px;
        border-bottom: 1px solid #e9ece7;
        font-size: 14px;
    }

    .resort-info-item span:first-child {
        color: #777;
    }

    .resort-info-item strong {
        text-align: right;
        color: #263d31;
    }

    .resort-price {
        font-size: 28px;
        font-weight: 700;
        color: var(--forest-deep, #203d31);
        margin: 8px 0;
    }

    .resort-book-btn,
    .resort-review-btn {
        display: inline-block;
        width: 100%;
        text-align: center;
        padding: 15px 20px;
        border-radius: 7px;
        text-decoration: none;
        font-weight: 600;
        transition: .2s ease;
    }

    .resort-book-btn {
        background: var(--forest-deep, #203d31);
        color: white;
    }

    .resort-book-btn:hover {
        background: #345846;
        color: white;
    }

    .resort-review-btn {
        border: 1px solid #355b46;
        color: #355b46;
        margin-top: 12px;
    }

    .resort-review-btn:hover {
        background: #355b46;
        color: white;
    }

    .resort-rating-summary {
        display: flex;
        align-items: center;
        gap: 18px;
        padding: 20px;
        background: #f5f7f2;
        border-radius: 10px;
        margin-bottom: 25px;
    }

    .resort-rating-number {
        font-size: 38px;
        font-weight: 700;
        color: #284b38;
    }

    .resort-stars {
        color: #c3913e;
        letter-spacing: 2px;
        font-size: 17px;
    }

    .resort-review-card {
        padding: 22px 0;
        border-bottom: 1px solid #e8eae5;
    }

    .resort-review-card:last-child {
        border-bottom: 0;
    }

    .resort-review-card h3 {
        margin: 7px 0;
        color: #294333;
        font-size: 17px;
    }

    .resort-review-card p {
        color: #68716a;
        line-height: 1.8;
        margin: 8px 0 0;
    }

    .resort-review-meta {
        display: flex;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 8px;
        color: #858b85;
        font-size: 13px;
    }

    .resort-empty {
        color: #777;
        padding: 20px 0;
    }

    @@media (max-width: 800px) {
        .resort-layout {
            grid-template-columns: 1fr;
        }

        .resort-hero {
            min-height: 350px;
        }

        .resort-hero-content {
            padding: 25px;
        }

        .resort-panel {
            padding: 22px;
        }
    }
</style>

<main class="resort-details">
    <div class="resort-container">

        <div class="resort-breadcrumb">
            <a asp-controller="Home" asp-action="Index">Home</a>
            /
            <a asp-controller="Resorts" asp-action="Index">Resorts</a>
            / @Model.Name
        </div>

        <!-- HERO -->
        <section class="resort-hero">

            @if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
            {
                <img src="@Model.ImageUrl" alt="@Model.Name" />
            }

            <div class="resort-hero-content">
                <span>RESORT EXPERIENCE</span>

                <h1>@Model.Name</h1>

                @if (!string.IsNullOrWhiteSpace(Model.CityOrRegion))
                {
                    <div class="resort-location">
                        @Model.CityOrRegion
                    </div>
                }
            </div>

        </section>

        <div class="resort-layout">

            <!-- MAIN CONTENT -->
            <div>

                <section class="resort-panel">
                    <h2>About This Resort</h2>

                    @if (!string.IsNullOrWhiteSpace(Model.ShortDescription))
                    {
                        <p class="resort-description">
                            @Model.ShortDescription
                        </p>
                    }

                    @if (!string.IsNullOrWhiteSpace(Model.Description))
                    {
                        <p class="resort-description">
                            @Model.Description
                        </p>
                    }

                    @if (string.IsNullOrWhiteSpace(Model.ShortDescription)
                        && string.IsNullOrWhiteSpace(Model.Description))
                    {
                        <p class="resort-empty">
                            More information about this resort will be available soon.
                        </p>
                    }
                </section>

                <!-- LOCATION -->
                <section class="resort-panel">
                    <h2>Location & Contact</h2>

                    <div class="resort-info-list">

                        @if (!string.IsNullOrWhiteSpace(Model.CityOrRegion))
                        {
                            <div class="resort-info-item">
                                <span>City / Region</span>
                                <strong>@Model.CityOrRegion</strong>
                            </div>
                        }

                        @if (!string.IsNullOrWhiteSpace(Model.Address))
                        {
                            <div class="resort-info-item">
                                <span>Address</span>
                                <strong>@Model.Address</strong>
                            </div>
                        }

                        @if (!string.IsNullOrWhiteSpace(Model.ContactPhone))
                        {
                            <div class="resort-info-item">
                                <span>Contact</span>
                                <strong>@Model.ContactPhone</strong>
                            </div>
                        }

                    </div>
                </section>

                <!-- REVIEWS -->
                <section class="resort-panel" id="reviews">
                    <h2>Traveller Experiences</h2>

                    <div class="resort-rating-summary">
                        <div class="resort-rating-number">
                            @averageRating.ToString("0.0")
                        </div>

                        <div>
                            <div class="resort-stars">
                                @{
                                    var fullStars = (int)Math.Round(averageRating);
                                }
                                @for (int i = 1; i <= 5; i++)
                                {
                                    <span>@(i <= fullStars ? "★" : "☆")</span>
                                }
                            </div>

                            <div>
                                Based on @totalReviews review@(totalReviews == 1 ? "" : "s")
                            </div>
                        </div>
                    </div>

                    @if (reviews.Any())
                    {
                        @foreach (var review in reviews)
                        {
                            <article class="resort-review-card">

                                <div class="resort-review-meta">
                                    <strong>@review.ReviewerName</strong>
                                    <span>@review.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")</span>
                                </div>

                                <div class="resort-stars">
                                    @for (int i = 1; i <= 5; i++)
                                    {
                                        <span>@(i <= review.Rating ? "★" : "☆")</span>
                                    }
                                </div>

                                <h3>@review.Title</h3>

                                <p>@review.Comment</p>

                            </article>
                        }
                    }
                    else
                    {
                        <p class="resort-empty">
                            No approved reviews yet. Be the first to share your experience.
                        </p>
                    }

                    <a href="@reviewUrl" class="resort-review-btn">
                        Write a Review
                    </a>
                </section>

            </div>

            <!-- BOOKING SIDEBAR -->
            <aside>

                <section class="resort-panel">
                    <h2>Your Stay</h2>

                    @if (Model.StartingPricePerNight.HasValue)
                    {
                        <div class="resort-price">
                            PKR @Model.StartingPricePerNight.Value.ToString("N0")
                        </div>

                        <p class="muted">Starting price per night</p>
                    }
                    else
                    {
                        <p class="resort-empty">
                            Contact us for pricing information.
                        </p>
                    }

                    <a href="@bookingUrl" class="resort-book-btn">
                        Request a Booking
                    </a>

                    <p class="muted" style="font-size:12px;line-height:1.7;margin-top:15px;">
                        Booking requests are subject to availability and confirmation.
                    </p>
                </section>

                <section class="resort-panel">
                    <h2>Need Assistance?</h2>

                    <p class="muted">
                        Contact our team for help planning your resort stay.
                    </p>

                    @if (!string.IsNullOrWhiteSpace(Model.ContactPhone))
                    {
                        <p><strong>@Model.ContactPhone</strong></p>
                    }
                </section>

            </aside>

        </div>
    </div>
</main>
