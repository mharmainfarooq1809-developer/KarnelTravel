
@model KarnelTravel.Models.Restaurant
@using KarnelTravel.Models

@{
    ViewData["Title"] = Model.Name + " | Karnel Travel Guide";
    ViewData["Description"] = Model.ShortDescription ?? Model.Description ?? "Restaurant information.";

    var imageUrl = !string.IsNullOrWhiteSpace(Model.ImageUrl)
        ? Model.ImageUrl
        : "https://images.unsplash.com/photo-1517248135467-4c7edcad34c4?auto=format&fit=crop&w=1400&q=85";

    var bookingUrl = Url.Action("Create", "Bookings", new
    {
        serviceType = "Restaurant",
        serviceId = Model.Id
    });

    var reviews = ViewBag.Reviews as List<Review> ?? new List<Review>();
    double averageRating = ViewBag.AverageRating ?? 0;
    int totalReviews = ViewBag.TotalReviews ?? 0;

    var reviewUrl = Url.Action(
        "Create",
        "Reviews",
        new { type = "Restaurant", id = Model.Id }
    );
}

@section Styles {
    <style>
        .restaurant-detail {
            background: var(--ivory);
            padding-bottom: 90px;
        }

        .restaurant-hero {
            padding: calc(var(--header-h) + 45px) 0 45px;
            background: var(--sand);
        }

        .restaurant-breadcrumb {
            font-size: .78rem;
            color: var(--muted);
            margin-bottom: 25px;
        }

        .restaurant-breadcrumb a {
            color: var(--forest);
            text-decoration: none;
        }

        .restaurant-heading {
            max-width: 850px;
        }

        .restaurant-heading h1 {
            margin: 12px 0;
        }

        .restaurant-heading p {
            max-width: 65ch;
            color: var(--muted);
            font-size: 1.05rem;
        }

        .restaurant-meta {
            display: flex;
            flex-wrap: wrap;
            gap: 10px;
            margin-top: 22px;
        }

        .restaurant-meta span {
            padding: 8px 14px;
            border: 1px solid var(--line);
            border-radius: 50px;
            font-size: .78rem;
            color: var(--forest);
            background: rgba(255,255,255,.45);
        }

        .restaurant-layout {
            display: grid;
            grid-template-columns: minmax(0, 1.6fr) minmax(280px, .8fr);
            gap: 35px;
            align-items: start;
        }

        .restaurant-main-image {
            width: 100%;
            height: 460px;
            object-fit: cover;
            display: block;
            border-radius: var(--radius-lg);
            background: var(--sand);
        }

        .restaurant-section {
            margin-top: 38px;
        }

        .restaurant-section h2 {
            margin-bottom: 16px;
        }

        .restaurant-description {
            color: var(--muted);
            line-height: 1.9;
            white-space: pre-line;
        }

        .restaurant-sidebar {
            background: var(--white);
            border: 1px solid var(--line);
            border-radius: var(--radius-lg);
            padding: 28px;
            position: sticky;
            top: calc(var(--header-h) + 25px);
        }

        .restaurant-sidebar h2 {
            font-size: 1.5rem;
            margin-bottom: 22px;
        }

        .restaurant-info-item {
            padding: 17px 0;
            border-bottom: 1px solid var(--line);
        }

        .restaurant-info-item:last-of-type {
            border-bottom: none;
        }

        .restaurant-info-item small {
            display: block;
            text-transform: uppercase;
            letter-spacing: .12em;
            font-size: .65rem;
            color: var(--muted);
            margin-bottom: 7px;
        }

        .restaurant-info-item strong {
            color: var(--forest-deep);
            font-weight: 500;
            overflow-wrap: anywhere;
        }

        .restaurant-price {
            font-family: var(--serif);
            font-size: 1.65rem;
            color: var(--forest-deep);
        }

        .restaurant-sidebar .btn {
            width: 100%;
            margin-top: 24px;
            text-align: center;
        }

        .restaurant-note {
            color: var(--muted);
            font-size: .78rem;
            line-height: 1.7;
            margin-top: 15px;
        }

        .restaurant-back {
            display: inline-block;
            margin-top: 30px;
            color: var(--forest);
            text-decoration: none;
            font-size: .9rem;
        }

        /* RESTAURANT REVIEWS */

        .restaurant-reviews {
            padding: 70px 0 20px;
            border-top: 1px solid var(--line);
        }

        .restaurant-reviews__heading {
            margin-bottom: 35px;
        }

        .restaurant-reviews__eyebrow {
            text-transform: uppercase;
            letter-spacing: .17em;
            font-size: .7rem;
            color: var(--forest);
            margin-bottom: 12px;
        }

        .restaurant-reviews__heading h2 {
            font-size: clamp(2rem, 4vw, 3rem);
            margin: 0 0 12px;
        }

        .restaurant-reviews__heading p {
            color: var(--muted);
            line-height: 1.7;
            margin: 0;
        }

        .restaurant-reviews__summary {
            display: flex;
            align-items: center;
            flex-wrap: wrap;
            gap: 24px;
            padding: 25px 28px;
            margin-bottom: 30px;
            background: var(--white);
            border: 1px solid var(--line);
            border-radius: var(--radius-lg);
        }

        .restaurant-reviews__average {
            font-family: var(--serif);
            font-size: 3rem;
            line-height: 1;
        }

        .restaurant-reviews__stars {
            color: #b28a43;
            letter-spacing: 3px;
            font-size: 1.05rem;
        }

        .restaurant-reviews__count {
            color: var(--muted);
            font-size: .82rem;
            margin-top: 6px;
        }

        .restaurant-reviews__grid {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 18px;
        }

        .restaurant-review-card {
            padding: 25px;
            background: var(--white);
            border: 1px solid var(--line);
            border-radius: var(--radius-lg);
        }

        .restaurant-review-card__top {
            display: flex;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 10px;
            margin-bottom: 17px;
        }

        .restaurant-review-card__name {
            font-weight: 650;
            font-size: .95rem;
        }

        .restaurant-review-card__date {
            color: var(--muted);
            font-size: .75rem;
            margin-top: 5px;
        }

        .restaurant-review-card h3 {
            font-size: 1.15rem;
            margin: 12px 0 9px;
        }

        .restaurant-review-card__comment {
            color: var(--muted);
            font-size: .9rem;
            line-height: 1.8;
            white-space: pre-line;
            overflow-wrap: anywhere;
        }

        .restaurant-reviews__empty {
            padding: 35px;
            text-align: center;
            background: var(--white);
            border: 1px dashed var(--line);
            border-radius: var(--radius-lg);
        }

        .restaurant-reviews__empty h3 {
            margin: 0 0 9px;
        }

        .restaurant-reviews__empty p {
            color: var(--muted);
            font-size: .9rem;
            line-height: 1.7;
        }

        .restaurant-review-button {
            display: inline-flex;
            justify-content: center;
            align-items: center;
            margin-top: 25px;
            padding: 14px 25px;
            background: var(--forest-deep);
            color: var(--ivory);
            border-radius: 999px;
            text-decoration: none;
            font-size: .85rem;
            font-weight: 600;
            transition: background .3s ease, transform .3s ease;
        }

        .restaurant-review-button:hover {
            background: var(--forest);
            color: var(--ivory);
            transform: translateY(-2px);
        }

        .restaurant-reviews__note {
            margin-top: 22px;
            color: var(--muted);
            font-size: .76rem;
            line-height: 1.7;
        }

        @@media (max-width: 850px) {
            .restaurant-layout {
                grid-template-columns: 1fr;
            }

            .restaurant-sidebar {
                position: static;
            }

            .restaurant-main-image {
                height: 350px;
            }
        }

        @@media (max-width: 600px) {
            .restaurant-main-image {
                height: 260px;
            }

            .restaurant-sidebar {
                padding: 22px;
            }

            .restaurant-reviews__grid {
                grid-template-columns: 1fr;
            }

            .restaurant-reviews__summary {
                padding: 20px;
            }
        }
    </style>
}

<main class="restaurant-detail">

    <header class="restaurant-hero">
        <div class="container">

            <div class="restaurant-breadcrumb">
                <a href="@Url.Action("Index", "Home")">Home</a>
                /
                <a href="@Url.Action("Index", "Restaurants")">Restaurants</a>
                /
                @Model.Name
            </div>

            <div class="restaurant-heading" data-reveal>
                <span class="eyebrow">Restaurant Information</span>

                <h1>@Model.Name</h1>

                <p>
                    @(Model.ShortDescription ?? "Discover this restaurant during your journey.")
                </p>

                <div class="restaurant-meta">
                    @if (!string.IsNullOrWhiteSpace(Model.City))
                    {
                        <span>@Model.City</span>
                    }

                    @if (!string.IsNullOrWhiteSpace(Model.CuisineType))
                    {
                        <span>@Model.CuisineType</span>
                    }

                    @if (Model.IsFeatured)
                    {
                        <span>Featured Restaurant</span>
                    }
                </div>
            </div>

        </div>
    </header>

    <section class="section">
        <div class="container">

            <div class="restaurant-layout">

                <div class="restaurant-content" data-reveal>

                    <img class="restaurant-main-image"
                         src="@imageUrl"
                         alt="@Model.Name"
                         onerror="this.onerror=null;this.src='https://images.unsplash.com/photo-1517248135467-4c7edcad34c4?auto=format&fit=crop&w=1400&q=85';" />

                    <div class="restaurant-section">
                        <span class="eyebrow">About the Restaurant</span>
                        <h2>Discover the Experience.</h2>

                        <div class="restaurant-description">
                            @if (!string.IsNullOrWhiteSpace(Model.Description))
                            {
                                @Model.Description
                            }
                            else if (!string.IsNullOrWhiteSpace(Model.ShortDescription))
                            {
                                @Model.ShortDescription
                            }
                            else
                            {
                                <p>Further information about this restaurant will be added soon.</p>
                            }
                        </div>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(Model.Address))
                    {
                        <div class="restaurant-section">
                            <span class="eyebrow">Location</span>
                            <h2>Find the Restaurant.</h2>
                            <p class="restaurant-description">@Model.Address</p>
                        </div>
                    }

                    <a class="restaurant-back"
                       href="@Url.Action("Index", "Restaurants")">
                        ← Back to Restaurants
                    </a>

                </div>

                <aside class="restaurant-sidebar" data-reveal>

                    <span class="eyebrow">Restaurant Overview</span>
                    <h2>Plan Your Visit.</h2>

                    @if (Model.AverageMealPrice.HasValue && Model.AverageMealPrice.Value > 0)
                    {
                        <div class="restaurant-info-item">
                            <small>Average Meal Price</small>
                            <strong class="restaurant-price">
                                PKR @Model.AverageMealPrice.Value.ToString("N0")
                            </strong>
                        </div>
                    }

                    @if (!string.IsNullOrWhiteSpace(Model.CuisineType))
                    {
                        <div class="restaurant-info-item">
                            <small>Cuisine Type</small>
                            <strong>@Model.CuisineType</strong>
                        </div>
                    }

                    @if (!string.IsNullOrWhiteSpace(Model.City))
                    {
                        <div class="restaurant-info-item">
                            <small>City</small>
                            <strong>@Model.City</strong>
                        </div>
                    }

                    @if (!string.IsNullOrWhiteSpace(Model.Address))
                    {
                        <div class="restaurant-info-item">
                            <small>Address</small>
                            <strong>@Model.Address</strong>
                        </div>
                    }

                    @if (!string.IsNullOrWhiteSpace(Model.ContactPhone))
                    {
                        <div class="restaurant-info-item">
                            <small>Contact Number</small>
                            <strong>@Model.ContactPhone</strong>
                        </div>
                    }

                    <a href="@bookingUrl" class="btn btn--primary">
                        Book / Make an Inquiry
                    </a>

                    <p class="restaurant-note">
                        Contact and booking details are subject to confirmation.
                        Please verify arrangements before your visit.
                    </p>

                </aside>

            </div>

        </div>
    </section>

    <!-- RESTAURANT REVIEWS -->
    <section class="restaurant-reviews">
        <div class="container">

            <div class="restaurant-reviews__heading" data-reveal>
                <p class="restaurant-reviews__eyebrow">Traveller experiences</p>
                <h2>Reviews of @Model.Name</h2>
                <p>Read feedback shared by visitors about this restaurant.</p>
            </div>

            @if (totalReviews > 0)
            {
                <div class="restaurant-reviews__summary" data-reveal>
                    <div class="restaurant-reviews__average">
                        @averageRating.ToString("0.0")
                    </div>

                    <div>
                        <div class="restaurant-reviews__stars">
                            @for (int i = 1; i <= 5; i++)
                            {
                                @(i <= Math.Round(averageRating, MidpointRounding.AwayFromZero) ? "★" : "☆")
                            }
                        </div>

                        <div class="restaurant-reviews__count">
                            @totalReviews approved review(s)
                        </div>
                    </div>
                </div>

                <div class="restaurant-reviews__grid">
                    @foreach (var review in reviews)
                    {
                        <article class="restaurant-review-card" data-reveal>

                            <div class="restaurant-review-card__top">
                                <div>
                                    <div class="restaurant-review-card__name">
                                        @review.ReviewerName
                                    </div>

                                    <div class="restaurant-review-card__date">
                                        @review.CreatedAt.ToString("dd MMM yyyy")
                                    </div>
                                </div>

                                <div class="restaurant-reviews__stars"
                                     aria-label="@review.Rating out of 5 stars">
                                    @for (int i = 1; i <= 5; i++)
                                    {
                                        @(i <= review.Rating ? "★" : "☆")
                                    }
                                </div>
                            </div>

                            <h3>@review.Title</h3>

                            <p class="restaurant-review-card__comment">
                                @review.Comment
                            </p>

                        </article>
                    }
                </div>
            }
            else
            {
                <div class="restaurant-reviews__empty" data-reveal>
                    <h3>No reviews yet</h3>
                    <p>
                        Be the first to share your experience
                        at @Model.Name.
                    </p>
                </div>
            }

            <a href="@reviewUrl" class="restaurant-review-button">
                Write a review →
            </a>

            <p class="restaurant-reviews__note">
                Reviews are submitted for moderation before they appear publicly.
            </p>

        </div>
    </section>

</main>
