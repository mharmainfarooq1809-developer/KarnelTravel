@model KarnelTravel.ViewModels.DestinationDetailsViewModel
@using KarnelTravel.Models

@{
    var destination = Model.Destination;

    ViewData["Title"] = destination.Name + " | Karnel Travel Guide";
    Layout = null;

    var destinationInquiryUrl =
        "/Contact?category=" +
        Uri.EscapeDataString("Tour or destination inquiry") +
        "&service=" +
        Uri.EscapeDataString(destination.Name);

    var reviewUrl =
        "/Reviews/Create?type=Destination&id=" +
        destination.Id;

    int totalListings =
        (Model.Hotels?.Count() ?? 0) +
        (Model.Resorts?.Count() ?? 0) +
        (Model.Restaurants?.Count() ?? 0) +
        (Model.Packages?.Count() ?? 0);
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>@ViewData["Title"]</title>
    <meta name="description" content="@destination.ShortDescription" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet"
          href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;0,800;1,400;1,500;1,600&display=swap" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <style>
        :root {
            --forest-deep: #14271f;
            --forest: #173b32;
            --moss: #536b50;
            --sage: #8fa888;
            --ivory: #f8f6f0;
            --sand: #e8dfc9;
            --white: #ffffff;
            --charcoal: #24312c;
            --muted: #5a6b60;
            --line: #e6e2d6;
            --serif: "Playfair Display", Georgia, "Times New Roman", serif;
            --sans: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            --radius: 12px;
            --radius-lg: 24px;
            --card-radius: 20px;
            --card-radius-sm: 14px;
            --header-h: 72px;
            --ease: cubic-bezier(.22, .61, .36, 1);
            --ease-out: cubic-bezier(.16, 1, .3, 1);
        }

        * { box-sizing: border-box; }
        html { scroll-behavior: smooth; }
        body {
            margin: 0;
            background: var(--ivory);
            color: var(--charcoal);
            font-family: var(--sans);
            font-size: 16px;
            line-height: 1.65;
            -webkit-font-smoothing: antialiased;
        }
        a { color: inherit; text-decoration: none; }
        img { max-width: 100%; display: block; }
        button { font: inherit; }

        ::selection { background: var(--forest); color: var(--ivory); }
        ::-webkit-scrollbar { width: 10px; }
        ::-webkit-scrollbar-track { background: var(--ivory); }
        ::-webkit-scrollbar-thumb {
            background: var(--moss);
            border-radius: 10px;
            border: 2px solid var(--ivory);
        }
        ::-webkit-scrollbar-thumb:hover { background: var(--forest); }
        :focus-visible {
            outline: 2px solid var(--moss);
            outline-offset: 3px;
            border-radius: 4px;
        }

        .container {
            width: 100%;
            max-width: 1200px;
            margin: 0 auto;
            padding: 0 clamp(20px, 4vw, 40px);
        }

        /* ---------- Reveal ---------- */
        .reveal {
            opacity: 0;
            transform: translateY(30px);
            filter: blur(5px);
            transition:
                opacity 0.95s var(--ease-out),
                transform 0.95s var(--ease-out),
                filter 0.95s var(--ease-out);
        }
        .reveal.is-in {
            opacity: 1 !important;
            transform: none !important;
            filter: blur(0) !important;
        }

        /* ---------- Atoms ---------- */
        .eyebrow {
            display: inline-flex;
            align-items: center;
            gap: 12px;
            margin: 0 0 16px;
            font-family: var(--sans);
            font-size: 0.66rem;
            font-weight: 600;
            letter-spacing: 0.24em;
            text-transform: uppercase;
            color: var(--moss);
        }
        .eyebrow::before {
            content: '';
            width: 28px;
            height: 1px;
            background: currentColor;
            opacity: 0.85;
        }
        .eyebrow--light { color: var(--sage); }

        .tag {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            font-size: 0.6rem;
            font-weight: 600;
            letter-spacing: 0.18em;
            text-transform: uppercase;
            color: var(--moss);
        }
        .tag::before {
            content: '';
            width: 6px;
            height: 6px;
            border-radius: 50%;
            background: var(--sage);
            flex: 0 0 auto;
        }

        .price {
            font-family: var(--serif);
            font-size: 1.06rem;
            line-height: 1.15;
            color: var(--forest-deep);
            letter-spacing: -0.01em;
        }
        .price small {
            display: block;
            margin-bottom: 3px;
            font-family: var(--sans);
            font-size: 0.56rem;
            font-weight: 500;
            letter-spacing: 0.16em;
            text-transform: uppercase;
            color: var(--muted);
        }

        /* ---------- Buttons ---------- */
        .btn {
            position: relative;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            min-height: 52px;
            padding: 0 26px;
            overflow: hidden;
            isolation: isolate;
            border: 1px solid transparent;
            border-radius: 999px;
            background: var(--forest);
            color: var(--ivory);
            font-family: var(--sans);
            font-size: 0.7rem;
            font-weight: 600;
            letter-spacing: 0.16em;
            text-transform: uppercase;
            text-decoration: none;
            cursor: pointer;
            transition:
                transform 0.5s var(--ease-out),
                box-shadow 0.5s var(--ease-out),
                background 0.4s var(--ease),
                color 0.4s var(--ease),
                border-color 0.4s var(--ease);
        }
        .btn::after {
            content: '';
            position: absolute;
            inset: 0;
            z-index: 1;
            background: linear-gradient(120deg, transparent 20%, rgba(255,255,255,.35) 50%, transparent 80%);
            transform: translateX(-120%);
            transition: transform 0.85s var(--ease-out);
            pointer-events: none;
        }
        .btn:hover { transform: translateY(-3px); box-shadow: 0 18px 32px -18px rgba(20,39,31,.55); }
        .btn:hover::after { transform: translateX(120%); }
        .btn:active { transform: translateY(-1px); }

        .btn--ghost {
            background: transparent;
            color: var(--forest);
            border-color: rgba(20,39,31,.24);
        }
        .btn--ghost:hover { border-color: var(--forest); }

        .btn--light {
            background: var(--ivory);
            color: var(--forest-deep);
            border-color: var(--ivory);
        }
        .btn--light:hover { background: var(--sand); border-color: var(--sand); }

        .btn--ghost-light {
            background: transparent;
            color: var(--ivory);
            border-color: rgba(248,246,240,.4);
        }
        .btn--ghost-light:hover { border-color: var(--ivory); }

        .btn--sm { min-height: 44px; padding: 0 20px; font-size: 0.64rem; }
        .btn--block { width: 100%; }

        .link-arrow {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            font-size: 0.64rem;
            font-weight: 600;
            letter-spacing: 0.16em;
            text-transform: uppercase;
            color: var(--forest);
            transition: color 0.3s var(--ease);
        }
        .link-arrow::after {
            content: '\2192';
            font-size: 0.9rem;
            transition: transform 0.4s var(--ease-out);
        }
        .link-arrow:hover { color: var(--forest-deep); }
        .link-arrow:hover::after { transform: translateX(4px); }

        /* ---------- Nav ---------- */
        .kd-nav {
            position: sticky;
            top: 0;
            z-index: 100;
            background: rgba(248,246,240,.92);
            backdrop-filter: blur(14px);
            border-bottom: 1px solid var(--line);
        }
        .kd-nav__inner {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 20px;
            padding: 14px 0;
        }
        .kd-brand {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            font-family: var(--serif);
            font-size: 1.15rem;
            font-weight: 600;
            letter-spacing: -0.01em;
            color: var(--forest-deep);
        }
        .kd-brand::before {
            content: '';
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background: var(--moss);
            box-shadow: 0 0 0 4px rgba(83,107,80,.16);
        }
        .kd-back {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            font-size: 0.62rem;
            font-weight: 600;
            letter-spacing: 0.18em;
            text-transform: uppercase;
            color: var(--moss);
            transition: color 0.3s var(--ease);
        }
        .kd-back::before {
            content: '\2190';
            font-size: 0.86rem;
            transition: transform 0.35s var(--ease-out);
        }
        .kd-back:hover { color: var(--forest); }
        .kd-back:hover::before { transform: translateX(-3px); }

        /* ---------- Hero ---------- */
        .kd-hero {
            position: relative;
            min-height: clamp(480px, 62vh, 680px);
            display: flex;
            align-items: flex-end;
            padding: clamp(120px, 14vw, 180px) 0 clamp(48px, 6vw, 72px);
            overflow: hidden;
            color: var(--ivory);
            isolation: isolate;
            background: var(--forest-deep);
        }
        .kd-hero__bg {
            position: absolute;
            inset: 0;
            z-index: -2;
            overflow: hidden;
        }
        .kd-hero__bg img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transform: scale(1.06);
            transition: transform 2.2s var(--ease-out);
        }
        .kd-hero.is-in .kd-hero__bg img { transform: scale(1); }
        .kd-hero::after {
            content: '';
            position: absolute;
            inset: 0;
            z-index: -1;
            background:
                linear-gradient(180deg,
                    rgba(10,22,17,.28) 0%,
                    rgba(10,22,17,.5) 42%,
                    rgba(10,22,17,.94) 100%),
                radial-gradient(ellipse 70% 70% at 20% 20%, rgba(20,39,31,.14), transparent 65%);
            pointer-events: none;
        }
        .kd-hero__inner {
            position: relative;
            z-index: 2;
            max-width: 780px;
        }
        .kd-hero__meta {
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            gap: 10px 22px;
            margin-bottom: 20px;
        }
        .kd-hero__meta span {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            font-size: 0.6rem;
            letter-spacing: 0.22em;
            text-transform: uppercase;
            color: rgba(248,246,240,.72);
        }
        .kd-hero__meta span + span::before {
            content: '';
            width: 12px;
            height: 1px;
            background: currentColor;
            opacity: 0.5;
            margin-right: 6px;
        }
        .kd-hero h1 {
            margin: 0 0 20px;
            color: var(--ivory);
            font-family: var(--serif);
            font-weight: 500;
            font-size: clamp(2.4rem, 5.4vw, 4.4rem);
            line-height: 1;
            letter-spacing: -0.025em;
            text-wrap: balance;
        }
        .kd-hero__lead {
            max-width: 60ch;
            margin: 0 0 28px;
            color: rgba(248,246,240,.85);
            font-size: clamp(0.98rem, 1.15vw, 1.08rem);
            line-height: 1.75;
        }
        .kd-hero__actions {
            display: flex;
            flex-wrap: wrap;
            gap: 12px;
        }

        .kd-hero__inner > * {
            opacity: 0;
            transform: translateY(24px);
            filter: blur(6px);
            animation: heroIn 1s var(--ease-out) forwards;
        }
        .kd-hero__inner > *:nth-child(1) { animation-delay: 0.1s; }
        .kd-hero__inner > *:nth-child(2) { animation-delay: 0.22s; }
        .kd-hero__inner > *:nth-child(3) { animation-delay: 0.34s; }
        .kd-hero__inner > *:nth-child(4) { animation-delay: 0.46s; }
        @@keyframes heroIn {
            to { opacity: 1; transform: none; filter: blur(0); }
        }

        /* ---------- Body layout ---------- */
        .kd-body {
            padding: clamp(48px, 6vw, 96px) 0;
        }
        .kd-layout {
            display: grid;
            grid-template-columns: minmax(0, 1fr) 340px;
            gap: clamp(32px, 5vw, 72px);
            align-items: start;
        }
        .kd-main { min-width: 0; }

        /* ---------- Intro + rail ---------- */
        .kd-intro-block {
            padding-bottom: clamp(32px, 4vw, 48px);
            border-bottom: 1px solid var(--line);
        }
        .kd-intro-block h2 {
            margin: 0 0 20px;
            font-family: var(--serif);
            font-weight: 500;
            font-size: clamp(1.8rem, 3vw, 2.6rem);
            line-height: 1.08;
            letter-spacing: -0.02em;
            color: var(--forest-deep);
        }
        .kd-prose {
            max-width: 68ch;
            font-size: 1rem;
            line-height: 1.85;
            color: var(--charcoal);
            white-space: pre-line;
        }

        .kd-rail {
            position: sticky;
            top: calc(var(--header-h) + 24px);
            display: flex;
            flex-direction: column;
            gap: 18px;
        }
        .kd-rail__card {
            overflow: hidden;
            border: 1px solid var(--line);
            border-radius: var(--card-radius);
            background: var(--white);
            box-shadow: 0 30px 60px -40px rgba(20,39,31,.4);
        }
        .kd-rail__head {
            padding: clamp(20px, 2.6vw, 26px);
            background:
                radial-gradient(ellipse 80% 80% at 20% 10%, rgba(143,168,136,.24), transparent 60%),
                linear-gradient(140deg, var(--forest) 0%, #1d3629 55%, var(--moss) 140%);
            color: var(--ivory);
        }
        .kd-rail__head span {
            display: block;
            font-size: 0.56rem;
            font-weight: 600;
            letter-spacing: 0.22em;
            text-transform: uppercase;
            color: rgba(248,246,240,.62);
            margin-bottom: 8px;
        }
        .kd-rail__head strong {
            display: block;
            font-family: var(--serif);
            font-weight: 500;
            font-size: 1.5rem;
            line-height: 1.1;
            letter-spacing: -0.02em;
        }
        .kd-rail__body {
            display: flex;
            flex-direction: column;
            padding: 4px clamp(20px, 2.6vw, 26px);
        }
        .kd-info-row {
            display: flex;
            align-items: flex-start;
            justify-content: space-between;
            gap: 14px;
            padding: 14px 0;
            border-bottom: 1px solid var(--line);
            font-size: 0.82rem;
        }
        .kd-info-row:last-child { border-bottom: 0; }
        .kd-info-row span:first-child {
            color: var(--muted);
            letter-spacing: 0.02em;
        }
        .kd-info-row span:last-child {
            color: var(--charcoal);
            font-weight: 600;
            text-align: right;
            max-width: 60%;
        }
        .kd-rail__foot {
            display: flex;
            flex-direction: column;
            gap: 10px;
            padding: 16px clamp(20px, 2.6vw, 26px) clamp(20px, 2.6vw, 26px);
        }
        .kd-rail__note {
            margin: 0;
            font-size: 0.7rem;
            line-height: 1.55;
            color: var(--muted);
            text-align: center;
        }

        /* ---------- Listing sections ---------- */
        .kd-listing {
            padding: clamp(44px, 6vw, 72px) 0;
            border-top: 1px solid var(--line);
        }
        .kd-listing:first-of-type { border-top: 0; padding-top: 0; }

        .kd-section-head {
            display: flex;
            flex-wrap: wrap;
            align-items: flex-end;
            justify-content: space-between;
            gap: 16px 24px;
            padding-bottom: 20px;
            border-bottom: 1px solid var(--line);
            margin-bottom: clamp(22px, 3vw, 32px);
        }
        .kd-section-head__title {
            display: flex;
            align-items: baseline;
            gap: 16px;
        }
        .kd-section-num {
            font-family: var(--serif);
            font-style: italic;
            font-size: 0.92rem;
            letter-spacing: 0.06em;
            color: var(--sage);
        }
        .kd-section-head h2 {
            margin: 0;
            font-family: var(--serif);
            font-weight: 500;
            font-size: clamp(1.45rem, 2.4vw, 1.95rem);
            line-height: 1.1;
            letter-spacing: -0.015em;
            color: var(--forest-deep);
        }
        .kd-section-head__desc {
            margin: 8px 0 0;
            max-width: 60ch;
            font-size: 0.92rem;
            line-height: 1.65;
            color: var(--muted);
        }
        .kd-count-pill {
            display: inline-flex;
            align-items: baseline;
            gap: 8px;
            padding: 8px 14px;
            border-radius: 999px;
            background: var(--sand);
            color: var(--forest-deep);
            white-space: nowrap;
        }
        .kd-count-pill strong {
            font-family: var(--serif);
            font-weight: 500;
            font-size: 1.05rem;
            line-height: 1;
        }
        .kd-count-pill span {
            font-size: 0.56rem;
            font-weight: 600;
            letter-spacing: 0.18em;
            text-transform: uppercase;
            color: var(--muted);
        }

        /* ---------- Card grid ---------- */
        .kd-cards {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr));
            gap: clamp(16px, 2.4vw, 26px);
        }
        .kd-card {
            position: relative;
            display: flex;
            flex-direction: column;
            overflow: hidden;
            background: var(--white);
            border: 1px solid var(--line);
            border-radius: var(--card-radius);
            transition:
                transform 0.5s var(--ease-out),
                box-shadow 0.5s var(--ease-out),
                border-color 0.4s var(--ease);
        }
        .kd-card:hover {
            transform: translateY(-5px);
            border-color: rgba(83,107,80,.25);
            box-shadow: 0 30px 60px -34px rgba(20,39,31,.4);
        }
        .kd-card__media {
            position: relative;
            aspect-ratio: 16 / 10;
            overflow: hidden;
            background: var(--sand);
        }
        .kd-card__media img {
            display: block;
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 1s var(--ease-out);
        }
        .kd-card:hover .kd-card__media img { transform: scale(1.06); }

        .kd-card__badge {
            position: absolute;
            top: 14px;
            right: 14px;
            z-index: 2;
            padding: 6px 11px;
            border-radius: 999px;
            background: rgba(20,39,31,.82);
            backdrop-filter: blur(8px);
            color: var(--ivory);
            font-family: var(--sans);
            font-size: 0.54rem;
            font-weight: 600;
            letter-spacing: 0.16em;
            text-transform: uppercase;
            box-shadow: 0 12px 24px -16px rgba(0,0,0,.5);
        }

        .kd-card__body {
            display: flex;
            flex-direction: column;
            gap: 8px;
            flex: 1;
            padding: clamp(16px, 2.2vw, 22px);
        }
        .kd-card__title {
            margin: 2px 0 0;
            font-family: var(--serif);
            font-weight: 500;
            font-size: clamp(1.14rem, 1.7vw, 1.35rem);
            line-height: 1.2;
            letter-spacing: -0.01em;
            color: var(--forest-deep);
        }
        .kd-card__location {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            font-size: 0.6rem;
            font-weight: 500;
            letter-spacing: 0.14em;
            text-transform: uppercase;
            color: var(--muted);
        }
        .kd-card__location::before {
            content: '';
            width: 5px;
            height: 5px;
            border-radius: 50%;
            background: var(--sage);
            flex: 0 0 auto;
        }
        .kd-card__desc {
            margin: 0;
            color: var(--muted);
            font-size: 0.87rem;
            line-height: 1.6;
            display: -webkit-box;
            -webkit-line-clamp: 3;
            -webkit-box-orient: vertical;
            overflow: hidden;
            flex: 1;
        }
        .kd-card__meta {
            display: flex;
            flex-wrap: wrap;
            gap: 6px;
        }
        .kd-card__meta span {
            padding: 4px 10px;
            border: 1px solid var(--line);
            border-radius: 999px;
            background: var(--ivory);
            color: var(--muted);
            font-size: 0.54rem;
            font-weight: 600;
            letter-spacing: 0.12em;
            text-transform: uppercase;
        }
        .kd-card__foot {
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            margin-top: 6px;
            padding-top: 14px;
            border-top: 1px solid var(--line);
        }

        /* fallback image */
        .kd-card__fallback {
            display: grid;
            place-items: center;
            width: 100%;
            height: 100%;
            background:
                radial-gradient(ellipse 80% 80% at 20% 10%, rgba(143,168,136,.35), transparent 60%),
                linear-gradient(140deg, var(--forest) 0%, #1d3629 55%, var(--moss) 130%);
            color: rgba(248,246,240,.92);
            font-family: var(--serif);
            font-style: italic;
            font-size: 0.95rem;
            position: relative;
            overflow: hidden;
        }
        .kd-card__fallback::after {
            content: '';
            position: absolute;
            inset: 9px;
            border: 1px solid rgba(248,246,240,.14);
            border-radius: inherit;
            pointer-events: none;
        }

        /* ---------- Empty state ---------- */
        .kd-empty {
            display: grid;
            place-items: center;
            text-align: center;
            padding: clamp(32px, 4vw, 48px) clamp(20px, 3vw, 32px);
            border: 1px dashed var(--line);
            border-radius: var(--card-radius);
            background: var(--white);
        }
        .kd-empty__icon {
            display: grid;
            place-items: center;
            width: 48px;
            height: 48px;
            margin-bottom: 16px;
            border-radius: 50%;
            background: var(--ivory);
            color: var(--moss);
            font-family: var(--serif);
            font-size: 1.2rem;
        }
        .kd-empty h3 {
            margin: 0 0 8px;
            font-family: var(--serif);
            font-weight: 500;
            font-size: 1.15rem;
            color: var(--forest-deep);
        }
        .kd-empty p {
            margin: 0;
            max-width: 44ch;
            color: var(--muted);
            font-size: 0.9rem;
            line-height: 1.65;
        }

        /* ---------- Reviews ---------- */
        .kd-reviews {
            background: var(--white);
            border-top: 1px solid var(--line);
            border-bottom: 1px solid var(--line);
            padding: clamp(48px, 6vw, 80px) 0;
        }
        .kd-reviews__head {
            display: flex;
            flex-wrap: wrap;
            align-items: flex-end;
            justify-content: space-between;
            gap: 24px;
            margin-bottom: clamp(24px, 3vw, 36px);
        }
        .kd-reviews__head h2 {
            margin: 0 0 8px;
            font-family: var(--serif);
            font-weight: 500;
            font-size: clamp(1.6rem, 2.6vw, 2.2rem);
            line-height: 1.1;
            letter-spacing: -0.02em;
            color: var(--forest-deep);
        }
        .kd-reviews__head p {
            margin: 0;
            max-width: 60ch;
            color: var(--muted);
            font-size: 0.94rem;
            line-height: 1.65;
        }
        .kd-rating {
            display: inline-flex;
            align-items: center;
            gap: 16px;
            padding: 16px 22px;
            border-radius: var(--card-radius-sm);
            background: var(--ivory);
            border: 1px solid var(--line);
        }
        .kd-rating__score {
            font-family: var(--serif);
            font-weight: 500;
            font-size: 2.2rem;
            line-height: 1;
            color: var(--forest-deep);
        }
        .kd-rating__meta {
            display: flex;
            flex-direction: column;
            gap: 2px;
        }
        .kd-stars {
            color: #bd914a;
            font-size: 0.95rem;
            letter-spacing: 2px;
            white-space: nowrap;
        }
        .kd-rating__count {
            font-size: 0.62rem;
            letter-spacing: 0.14em;
            text-transform: uppercase;
            color: var(--muted);
        }

        .kd-review-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr));
            gap: clamp(16px, 2.4vw, 24px);
        }
        .kd-review-card {
            display: flex;
            flex-direction: column;
            gap: 12px;
            padding: clamp(20px, 2.6vw, 26px);
            background: var(--ivory);
            border: 1px solid var(--line);
            border-radius: var(--card-radius-sm);
            transition:
                transform 0.4s var(--ease-out),
                box-shadow 0.4s var(--ease-out),
                border-color 0.3s var(--ease);
        }
        .kd-review-card:hover {
            transform: translateY(-3px);
            border-color: rgba(83,107,80,.25);
            box-shadow: 0 20px 40px -30px rgba(20,39,31,.35);
        }
        .kd-review-card__top {
            display: flex;
            align-items: flex-start;
            justify-content: space-between;
            gap: 14px;
        }
        .kd-review-card__who {
            display: flex;
            align-items: center;
            gap: 12px;
        }
        .kd-review-card__avatar {
            display: grid;
            place-items: center;
            width: 40px;
            height: 40px;
            border-radius: 50%;
            background:
                radial-gradient(ellipse 80% 80% at 20% 10%, rgba(143,168,136,.4), transparent 60%),
                linear-gradient(140deg, var(--forest) 0%, var(--moss) 140%);
            color: var(--ivory);
            font-family: var(--serif);
            font-style: italic;
            font-size: 1rem;
            font-weight: 500;
        }
        .kd-review-card__name {
            font-weight: 600;
            font-size: 0.88rem;
            color: var(--forest-deep);
            line-height: 1.2;
        }
        .kd-review-card__date {
            display: block;
            margin-top: 2px;
            font-size: 0.6rem;
            letter-spacing: 0.14em;
            text-transform: uppercase;
            color: var(--muted);
        }
        .kd-review-card h3 {
            margin: 0;
            font-family: var(--serif);
            font-weight: 500;
            font-size: 1.08rem;
            line-height: 1.3;
            color: var(--forest-deep);
        }
        .kd-review-card__body {
            margin: 0;
            color: var(--muted);
            font-size: 0.9rem;
            line-height: 1.65;
            white-space: pre-line;
            overflow-wrap: anywhere;
        }

        .kd-review-notice {
            margin-top: clamp(20px, 2.6vw, 28px);
            padding: 14px 18px;
            border-left: 3px solid var(--sand);
            border-radius: 8px;
            background: var(--ivory);
            color: var(--muted);
            font-size: 0.78rem;
            line-height: 1.6;
        }
        .kd-reviews__actions {
            display: flex;
            flex-wrap: wrap;
            gap: 12px;
            margin-top: 24px;
        }

        /* ---------- Planning CTA ---------- */
        .kd-plan {
            position: relative;
            overflow: hidden;
            padding: clamp(64px, 8vw, 108px) 0;
            background: var(--forest-deep);
            color: var(--ivory);
            isolation: isolate;
        }
        .kd-plan::before {
            content: '';
            position: absolute;
            inset: 0;
            z-index: -1;
            background:
                radial-gradient(ellipse 60% 60% at 15% 20%, rgba(143,168,136,.18), transparent 60%),
                radial-gradient(ellipse 60% 60% at 100% 100%, rgba(232,223,201,.08), transparent 65%),
                linear-gradient(180deg, #173b32 0%, #1d3629 60%, #14271f 100%);
        }
        .kd-plan__inner {
            max-width: 780px;
            margin: 0 auto;
            text-align: center;
        }
        .kd-plan__inner .eyebrow { justify-content: center; }
        .kd-plan h2 {
            margin: 0 0 18px;
            font-family: var(--serif);
            font-weight: 500;
            font-size: clamp(2rem, 4vw, 3.2rem);
            line-height: 1.08;
            letter-spacing: -0.025em;
            color: var(--ivory);
        }
        .kd-plan p {
            margin: 0 auto 28px;
            max-width: 54ch;
            color: rgba(248,246,240,.8);
            font-size: clamp(0.98rem, 1.1vw, 1.06rem);
            line-height: 1.75;
        }
        .kd-plan__actions {
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
            gap: 12px;
        }
        .kd-plan__notice {
            margin: 28px auto 0;
            max-width: 620px;
            padding: 14px 18px;
            border-left: 3px solid var(--sand);
            border-radius: 8px;
            background: rgba(248,246,240,.06);
            color: rgba(248,246,240,.7);
            font-size: 0.78rem;
            line-height: 1.6;
            text-align: left;
        }

        /* ---------- Footer ---------- */
        .kd-foot {
            padding: 28px 0;
            background: #0e1f19;
            color: rgba(248,246,240,.7);
            font-size: 0.8rem;
            text-align: center;
        }
        .kd-foot strong { color: var(--ivory); font-weight: 500; }

        /* ---------- Responsive ---------- */
        @@media (max-width: 1024px) {
            .kd-layout { grid-template-columns: 1fr; }
            .kd-rail {
                position: static;
                order: -1;
            }
        }

        @@media (max-width: 760px) {
            .kd-hero { min-height: 0; padding-top: calc(var(--header-h) + 56px); }
            .kd-hero__actions { flex-direction: column; }
            .kd-hero__actions .btn { width: 100%; }
            .kd-nav__inner { padding: 12px 0; }
            .kd-reviews__head { align-items: flex-start; }
            .kd-reviews__actions { flex-direction: column; }
            .kd-reviews__actions .btn { width: 100%; }
        }

        @@media (prefers-reduced-motion: reduce) {
            html { scroll-behavior: auto; }
            .reveal, .kd-hero__bg img {
                opacity: 1 !important;
                transform: none !important;
                filter: none !important;
                transition: none !important;
            }
            .kd-hero__inner > * {
                opacity: 1 !important;
                transform: none !important;
                filter: none !important;
                animation: none !important;
            }
            .btn, .kd-card, .kd-card__media img, .kd-review-card, .link-arrow {
                transition: none !important;
            }
            .btn:hover, .kd-card:hover, .kd-review-card:hover {
                transform: none !important;
            }
            .kd-card:hover .kd-card__media img { transform: none !important; }
            .kd-hero.is-in .kd-hero__bg img { transform: none !important; }
        }
    </style>
</head>

<body>
    <header class="kd-nav">
        <div class="container kd-nav__inner">
            <a class="kd-brand" href="/">Karnel Travel Guide</a>
            <a class="kd-back" href="/Destinations">All destinations</a>
        </div>
    </header>

    <main>
        <!-- ==================== HERO ==================== -->
        <section class="kd-hero reveal">
            @if (!string.IsNullOrWhiteSpace(destination.ImageUrl))
            {
                <div class="kd-hero__bg">
                    <img src="@destination.ImageUrl"
                         alt="@destination.Name"
                         loading="eager" fetchpriority="high" />
                </div>
            }

            <div class="container kd-hero__inner">
                <div class="kd-hero__meta">
                    <span>@(string.IsNullOrWhiteSpace(destination.Region) ? "Pakistan" : destination.Region)</span>
                    <span>Pakistan</span>
                    @if (!string.IsNullOrWhiteSpace(destination.BestTimeToVisit))
                    {
                        <span>Best: @destination.BestTimeToVisit</span>
                    }
                    @if (totalListings > 0)
                    {
                        <span>@totalListings listing(s)</span>
                    }
                </div>

                <h1>@destination.Name</h1>

                @if (!string.IsNullOrWhiteSpace(destination.ShortDescription))
                {
                    <p class="kd-hero__lead">@destination.ShortDescription</p>
                }

                <div class="kd-hero__actions">
                    <a class="btn btn--light" href="#travel-information">Discover this destination</a>
                    <a class="btn btn--ghost-light" href="#plan-trip">Plan your trip</a>
                </div>
            </div>
        </section>

        <!-- ==================== BODY ==================== -->
        <section class="kd-body">
            <div class="container">
                <div class="kd-layout">

                    <!-- ============ MAIN ============ -->
                    <div class="kd-main">

                        <!-- Intro -->
                        <div class="kd-intro-block reveal">
                            <p class="eyebrow">Discover the destination</p>
                            <h2>Experience @destination.Name</h2>

                            @if (!string.IsNullOrWhiteSpace(destination.Description))
                            {
                                <div class="kd-prose">@destination.Description</div>
                            }
                            else
                            {
                                <p class="kd-prose" style="color:var(--muted);">
                                    More destination information will be added soon.
                                </p>
                            }
                        </div>

                        <!-- ---------- HOTELS ---------- -->
                        <section class="kd-listing reveal" id="hotels" aria-labelledby="hotels-title">
                            <div class="kd-section-head">
                                <div>
                                    <div class="kd-section-head__title">
                                        <span class="kd-section-num">01</span>
                                        <h2 id="hotels-title">Hotels in @destination.Name</h2>
                                    </div>
                                    <p class="kd-section-head__desc">
                                        Accommodation options selected for comfort and location.
                                    </p>
                                </div>
                                @if (Model.Hotels != null && Model.Hotels.Any())
                                {
                                    <div class="kd-count-pill">
                                        <strong>@Model.Hotels.Count()</strong>
                                        <span>Hotel(s)</span>
                                    </div>
                                }
                            </div>

                            @if (Model.Hotels != null && Model.Hotels.Any())
                            {
                                <div class="kd-cards">
                                    @foreach (var hotel in Model.Hotels)
                                    {
                                        var inquiryUrl = "/Contact?category=" +
                                            Uri.EscapeDataString("Hotel inquiry") +
                                            "&service=" + Uri.EscapeDataString(hotel.Name) +
                                            "&destination=" + Uri.EscapeDataString(destination.Name);

                                        <article class="kd-card">
                                            <div class="kd-card__media">
                                                @if (!string.IsNullOrWhiteSpace(hotel.ImageUrl))
                                                {
                                                    <img src="@hotel.ImageUrl" alt="@hotel.Name" loading="lazy" />
                                                }
                                                else
                                                {
                                                    <div class="kd-card__fallback" aria-hidden="true">
                                                        <span>@hotel.Name</span>
                                                    </div>
                                                }
                                                @if (hotel.StarRating > 0)
                                                {
                                                    <span class="kd-card__badge">@hotel.StarRating ★</span>
                                                }
                                            </div>
                                            <div class="kd-card__body">
                                                <span class="tag">Accommodation</span>
                                                <h3 class="kd-card__title">@hotel.Name</h3>
                                                @if (!string.IsNullOrWhiteSpace(hotel.City) || !string.IsNullOrWhiteSpace(hotel.Address))
                                                {
                                                    <span class="kd-card__location">
                                                        @hotel.City@(string.IsNullOrWhiteSpace(hotel.City) || string.IsNullOrWhiteSpace(hotel.Address) ? "" : " · ")@hotel.Address
                                                    </span>
                                                }
                                                @if (!string.IsNullOrWhiteSpace(hotel.ShortDescription))
                                                {
                                                    <p class="kd-card__desc">@hotel.ShortDescription</p>
                                                }
                                                <div class="kd-card__foot">
                                                    <span class="price">
                                                        <small>Per night</small>
                                                        @if (hotel.StartingPricePerNight.HasValue && hotel.StartingPricePerNight.Value > 0)
                                                        {
                                                            @($"PKR {hotel.StartingPricePerNight.Value:N0}")
                                                        }
                                                        else
                                                        {
                                                            @("On request")
                                                        }
                                                    </span>
                                                    <a class="link-arrow" href="@inquiryUrl">Ask about</a>
                                                </div>
                                            </div>
                                        </article>
                                    }
                                </div>
                            }
                            else
                            {
                                <div class="kd-empty">
                                    <div class="kd-empty__icon">i</div>
                                    <h3>No hotels listed yet</h3>
                                    <p>Hotels will appear here when they are published and linked to this destination.</p>
                                </div>
                            }
                        </section>

                        <!-- ---------- RESORTS ---------- -->
                        <section class="kd-listing reveal" id="resorts" aria-labelledby="resorts-title">
                            <div class="kd-section-head">
                                <div>
                                    <div class="kd-section-head__title">
                                        <span class="kd-section-num">02</span>
                                        <h2 id="resorts-title">Resorts in @destination.Name</h2>
                                    </div>
                                    <p class="kd-section-head__desc">
                                        Places to unwind and recharge during your journey.
                                    </p>
                                </div>
                                @if (Model.Resorts != null && Model.Resorts.Any())
                                {
                                    <div class="kd-count-pill">
                                        <strong>@Model.Resorts.Count()</strong>
                                        <span>Resort(s)</span>
                                    </div>
                                }
                            </div>

                            @if (Model.Resorts != null && Model.Resorts.Any())
                            {
                                <div class="kd-cards">
                                    @foreach (var resort in Model.Resorts)
                                    {
                                        var inquiryUrl = "/Contact?category=" +
                                            Uri.EscapeDataString("Resort inquiry") +
                                            "&service=" + Uri.EscapeDataString(resort.Name) +
                                            "&destination=" + Uri.EscapeDataString(destination.Name);

                                        <article class="kd-card">
                                            <div class="kd-card__media">
                                                @if (!string.IsNullOrWhiteSpace(resort.ImageUrl))
                                                {
                                                    <img src="@resort.ImageUrl" alt="@resort.Name" loading="lazy" />
                                                }
                                                else
                                                {
                                                    <div class="kd-card__fallback" aria-hidden="true">
                                                        <span>@resort.Name</span>
                                                    </div>
                                                }
                                                @if (resort.StartingPricePerNight.HasValue && resort.StartingPricePerNight.Value > 0)
                                                {
                                                    <span class="kd-card__badge">PKR @resort.StartingPricePerNight.Value.ToString("N0")</span>
                                                }
                                            </div>
                                            <div class="kd-card__body">
                                                <span class="tag">Resort</span>
                                                <h3 class="kd-card__title">@resort.Name</h3>
                                                @if (!string.IsNullOrWhiteSpace(resort.CityOrRegion) || !string.IsNullOrWhiteSpace(resort.Address))
                                                {
                                                    <span class="kd-card__location">
                                                        @resort.CityOrRegion@(string.IsNullOrWhiteSpace(resort.CityOrRegion) || string.IsNullOrWhiteSpace(resort.Address) ? "" : " · ")@resort.Address
                                                    </span>
                                                }
                                                @if (!string.IsNullOrWhiteSpace(resort.ShortDescription))
                                                {
                                                    <p class="kd-card__desc">@resort.ShortDescription</p>
                                                }
                                                <div class="kd-card__foot">
                                                    <span class="price">
                                                        <small>Per night</small>
                                                        @if (resort.StartingPricePerNight.HasValue && resort.StartingPricePerNight.Value > 0)
                                                        {
                                                            @($"PKR {resort.StartingPricePerNight.Value:N0}")
                                                        }
                                                        else
                                                        {
                                                            @("On request")
                                                        }
                                                    </span>
                                                    <a class="link-arrow" href="@inquiryUrl">Ask about</a>
                                                </div>
                                            </div>
                                        </article>
                                    }
                                </div>
                            }
                            else
                            {
                                <div class="kd-empty">
                                    <div class="kd-empty__icon">i</div>
                                    <h3>No resorts listed yet</h3>
                                    <p>Resorts will appear here when they are published and linked to this destination.</p>
                                </div>
                            }
                        </section>

                        <!-- ---------- RESTAURANTS ---------- -->
                        <section class="kd-listing reveal" id="restaurants" aria-labelledby="restaurants-title">
                            <div class="kd-section-head">
                                <div>
                                    <div class="kd-section-head__title">
                                        <span class="kd-section-num">03</span>
                                        <h2 id="restaurants-title">Restaurants in @destination.Name</h2>
                                    </div>
                                    <p class="kd-section-head__desc">
                                        Local flavours and dining options worth trying.
                                    </p>
                                </div>
                                @if (Model.Restaurants != null && Model.Restaurants.Any())
                                {
                                    <div class="kd-count-pill">
                                        <strong>@Model.Restaurants.Count()</strong>
                                        <span>Restaurant(s)</span>
                                    </div>
                                }
                            </div>

                            @if (Model.Restaurants != null && Model.Restaurants.Any())
                            {
                                <div class="kd-cards">
                                    @foreach (var restaurant in Model.Restaurants)
                                    {
                                        var inquiryUrl = "/Contact?category=" +
                                            Uri.EscapeDataString("Restaurant inquiry") +
                                            "&service=" + Uri.EscapeDataString(restaurant.Name) +
                                            "&destination=" + Uri.EscapeDataString(destination.Name);

                                        <article class="kd-card">
                                            <div class="kd-card__media">
                                                @if (!string.IsNullOrWhiteSpace(restaurant.ImageUrl))
                                                {
                                                    <img src="@restaurant.ImageUrl" alt="@restaurant.Name" loading="lazy" />
                                                }
                                                else
                                                {
                                                    <div class="kd-card__fallback" aria-hidden="true">
                                                        <span>@restaurant.Name</span>
                                                    </div>
                                                }
                                                @if (!string.IsNullOrWhiteSpace(restaurant.CuisineType))
                                                {
                                                    <span class="kd-card__badge">@restaurant.CuisineType</span>
                                                }
                                            </div>
                                            <div class="kd-card__body">
                                                <span class="tag">Dining</span>
                                                <h3 class="kd-card__title">@restaurant.Name</h3>
                                                @if (!string.IsNullOrWhiteSpace(restaurant.City) || !string.IsNullOrWhiteSpace(restaurant.Address))
                                                {
                                                    <span class="kd-card__location">
                                                        @restaurant.City@(string.IsNullOrWhiteSpace(restaurant.City) || string.IsNullOrWhiteSpace(restaurant.Address) ? "" : " · ")@restaurant.Address
                                                    </span>
                                                }
                                                @if (!string.IsNullOrWhiteSpace(restaurant.ShortDescription))
                                                {
                                                    <p class="kd-card__desc">@restaurant.ShortDescription</p>
                                                }
                                                <div class="kd-card__foot">
                                                    <span class="price">
                                                        <small>Avg. meal</small>
                                                        @if (restaurant.AverageMealPrice.HasValue && restaurant.AverageMealPrice.Value > 0)
                                                        {
                                                            @($"PKR {restaurant.AverageMealPrice.Value:N0}")
                                                        }
                                                        else
                                                        {
                                                            @("On request")
                                                        }
                                                    </span>
                                                    <a class="link-arrow" href="@inquiryUrl">Ask about</a>
                                                </div>
                                            </div>
                                        </article>
                                    }
                                </div>
                            }
                            else
                            {
                                <div class="kd-empty">
                                    <div class="kd-empty__icon">i</div>
                                    <h3>No restaurants listed yet</h3>
                                    <p>Restaurants will appear here when they are published and linked to this destination.</p>
                                </div>
                            }
                        </section>

                        <!-- ---------- PACKAGES ---------- -->
                        <section class="kd-listing reveal" id="packages" aria-labelledby="packages-title">
                            <div class="kd-section-head">
                                <div>
                                    <div class="kd-section-head__title">
                                        <span class="kd-section-num">04</span>
                                        <h2 id="packages-title">Trips to @destination.Name</h2>
                                    </div>
                                    <p class="kd-section-head__desc">
                                        Published packages with real dates, or request a custom itinerary below.
                                    </p>
                                </div>
                                @if (Model.Packages != null && Model.Packages.Any())
                                {
                                    <div class="kd-count-pill">
                                        <strong>@Model.Packages.Count()</strong>
                                        <span>Package(s)</span>
                                    </div>
                                }
                            </div>

                            @if (Model.Packages != null && Model.Packages.Any())
                            {
                                <div class="kd-cards">
                                    @foreach (var package in Model.Packages)
                                    {
                                        var departures = package.Departures?
                                            .Where(d => d.IsActive && d.DepartureDate.Date >= DateTime.Today && d.AvailableSeats > 0)
                                            .OrderBy(d => d.DepartureDate)
                                            .ToList() ?? new List<KarnelTravel.Models.TourDeparture>();

                                        <article class="kd-card">
                                            <div class="kd-card__media">
                                                @if (!string.IsNullOrWhiteSpace(package.ImageUrl))
                                                {
                                                    <img src="@package.ImageUrl" alt="@package.Name" loading="lazy" />
                                                }
                                                else
                                                {
                                                    <div class="kd-card__fallback" aria-hidden="true">
                                                        <span>@package.Name</span>
                                                    </div>
                                                }
                                                <span class="kd-card__badge">@package.DurationDays day(s)</span>
                                            </div>
                                            <div class="kd-card__body">
                                                <span class="tag">Tour package</span>
                                                <h3 class="kd-card__title">@package.Name</h3>
                                                @if (!string.IsNullOrWhiteSpace(package.ShortDescription))
                                                {
                                                    <p class="kd-card__desc">@package.ShortDescription</p>
                                                }
                                                @if (departures.Any())
                                                {
                                                    <div class="kd-card__meta">
                                                        <span>@departures.Count departure(s)</span>
                                                        <span>From @departures[0].DepartureDate.ToString("dd MMM yyyy")</span>
                                                    </div>
                                                }
                                                <div class="kd-card__foot">
                                                    <span class="price">
                                                        <small>Per adult</small>
                                                        @if (package.PricePerAdult.HasValue)
                                                        {
                                                            @($"PKR {package.PricePerAdult.Value:N0}")
                                                        }
                                                        else
                                                        {
                                                            @("On request")
                                                        }
                                                    </span>
                                                    @if (departures.Any())
                                                    {
                                                        <a class="link-arrow" href="/Bookings/Create?serviceType=Tour&amp;serviceId=@package.Id">Book</a>
                                                    }
                                                    else
                                                    {
                                                        <a class="link-arrow" href="#plan-trip">Inquire</a>
                                                    }
                                                </div>
                                            </div>
                                        </article>
                                    }
                                </div>
                            }
                            else
                            {
                                <div class="kd-empty">
                                    <div class="kd-empty__icon">i</div>
                                    <h3>No packages available yet</h3>
                                    <p>There are no published packages for this destination. You can request a custom itinerary below.</p>
                                </div>
                            }
                        </section>

                    </div>

                    <!-- ============ RAIL ============ -->
                    <aside class="kd-rail" id="travel-information" aria-label="Travel essentials">
                        <div class="kd-rail__card reveal">
                            <div class="kd-rail__head">
                                <span>Destination</span>
                                <strong>@destination.Name</strong>
                            </div>
                            <div class="kd-rail__body">
                                <div class="kd-info-row">
                                    <span>Region</span>
                                    <span>@(string.IsNullOrWhiteSpace(destination.Region) ? "Pakistan" : destination.Region)</span>
                                </div>
                                <div class="kd-info-row">
                                    <span>Best time</span>
                                    <span>@(string.IsNullOrWhiteSpace(destination.BestTimeToVisit) ? "Ask us" : destination.BestTimeToVisit)</span>
                                </div>
                                @if (totalListings > 0)
                                {
                                    <div class="kd-info-row">
                                        <span>Listings</span>
                                        <span>@totalListings</span>
                                    </div>
                                }
                                @if (Model.TotalReviews > 0)
                                {
                                    <div class="kd-info-row">
                                        <span>Reviews</span>
                                        <span>@Model.AverageRating.ToString("0.0") / 5 · @Model.TotalReviews</span>
                                    </div>
                                }
                            </div>
                            <div class="kd-rail__foot">
                                <a class="btn btn--block" href="@destinationInquiryUrl">Ask about @destination.Name</a>
                                <a class="btn btn--ghost btn--block" href="#plan-trip">Plan a trip</a>
                                <p class="kd-rail__note">
                                    Information is indicative. Confirm details with our team before booking.
                                </p>
                            </div>
                        </div>
                    </aside>

                </div>
            </div>
        </section>

        <!-- ==================== REVIEWS ==================== -->
        <section class="kd-reviews" id="reviews" aria-labelledby="reviews-title">
            <div class="container">
                <div class="kd-reviews__head reveal">
                    <div>
                        <p class="eyebrow">Traveller experiences</p>
                        <h2 id="reviews-title">Reviews of @destination.Name</h2>
                        <p>Read feedback shared by visitors about this destination.</p>
                    </div>

                    @if (Model.TotalReviews > 0)
                    {
                        <div class="kd-rating">
                            <span class="kd-rating__score">@Model.AverageRating.ToString("0.0")</span>
                            <div class="kd-rating__meta">
                                <span class="kd-stars">
                                    @for (int i = 1; i <= 5; i++)
                                    {
                                        @(i <= Math.Round(Model.AverageRating) ? "★" : "☆")
                                    }
                                </span>
                                <span class="kd-rating__count">@Model.TotalReviews approved review(s)</span>
                            </div>
                        </div>
                    }
                </div>

                @if (Model.Reviews != null && Model.Reviews.Any())
                {
                    <div class="kd-review-grid">
                        @foreach (var review in Model.Reviews)
                        {
                            var initial = string.IsNullOrWhiteSpace(review.ReviewerName)
                                ? "G"
                                : review.ReviewerName.Trim().Substring(0, 1).ToUpperInvariant();

                            <article class="kd-review-card">
                                <div class="kd-review-card__top">
                                    <div class="kd-review-card__who">
                                        <span class="kd-review-card__avatar" aria-hidden="true">@initial</span>
                                        <div>
                                            <div class="kd-review-card__name">@review.ReviewerName</div>
                                            <span class="kd-review-card__date">
                                                @review.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")
                                            </span>
                                        </div>
                                    </div>
                                    <span class="kd-stars" aria-label="@review.Rating out of 5 stars">
                                        @for (int i = 1; i <= 5; i++)
                                        {
                                            @(i <= review.Rating ? "★" : "☆")
                                        }
                                    </span>
                                </div>
                                @if (!string.IsNullOrWhiteSpace(review.Title))
                                {
                                    <h3>@review.Title</h3>
                                }
                                <p class="kd-review-card__body">@review.Comment</p>
                            </article>
                        }
                    </div>
                }
                else
                {
                    <div class="kd-empty">
                        <div class="kd-empty__icon">★</div>
                        <h3>Be the first to share your experience</h3>
                        <p>There are no approved reviews for this destination yet. If you have visited, you can share your feedback.</p>
                    </div>
                }

                <div class="kd-review-notice">
                    Reviews are published only after moderation by Karnel Travel Guide. Submitting a review does not guarantee publication.
                </div>

                <div class="kd-reviews__actions">
                    <a class="btn" href="@reviewUrl">Write a review</a>
                </div>
            </div>
        </section>

        <!-- ==================== PLAN TRIP ==================== -->
        <section class="kd-plan" id="plan-trip" aria-labelledby="plan-title">
            <div class="container kd-plan__inner reveal">
                <p class="eyebrow eyebrow--light">Your next journey</p>
                <h2 id="plan-title">Ready to explore @destination.Name?</h2>
                <p>
                    Tell us your preferred travel dates, number of travellers, and the
                    arrangements you need. Our team can review your request.
                </p>
                <div class="kd-plan__actions">
                    <a class="btn btn--light" href="/TripRequests/Create?destination=@destination.Id">
                        Plan a trip to @destination.Name
                    </a>
                    <a class="btn btn--ghost-light" href="@destinationInquiryUrl">Ask a question</a>
                </div>
                <div class="kd-plan__notice">
                    Submitting an inquiry does not confirm a booking. Availability, prices
                    and arrangements must be confirmed by Karnel Travel Guide.
                </div>
            </div>
        </section>
    </main>

    <footer class="kd-foot">
        <div class="container">
            © @DateTime.Now.Year <strong>Karnel Travel Guide</strong>. Explore more. Travel better.
        </div>
    </footer>

    <script>
        (function () {
            'use strict';

            var reduceMotion = window.matchMedia
                && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

            if (reduceMotion || !('IntersectionObserver' in window)) {
                document.querySelectorAll('.reveal').forEach(function (el) {
                    el.classList.add('is-in');
                });
                return;
            }

            var observer = new IntersectionObserver(function (entries) {
                entries.forEach(function (entry) {
                    if (!entry.isIntersecting) return;
                    entry.target.classList.add('is-in');
                    observer.unobserve(entry.target);
                });
            }, { threshold: 0.08, rootMargin: '0px 0px -60px 0px' });

            document.querySelectorAll('.reveal').forEach(function (el) {
                observer.observe(el);
            });
        })();
    </script>
</body>
</html>