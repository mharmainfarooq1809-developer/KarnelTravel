
@model KarnelTravel.ViewModels.DestinationDetailsViewModel
@using KarnelTravel.Models

@{
    var destination = Model.Destination;

    ViewData["Title"] = destination.Name + " | Karnel Travel Guide";
    Layout = null;

    var destinationInquiryUrl =
        "/Contact?category=" +
        Uri.EscapeDataString("Tour or destination inquiry") +
        "&service=" +
        Uri.EscapeDataString(destination.Name);

    var reviewUrl =
        "/Reviews/Create?type=Destination&id=" +
        destination.Id;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>@ViewData["Title"]</title>
    <meta name="description" content="@destination.ShortDescription" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <style>
        :root {
            --forest: #183c32;
            --forest-dark: #102820;
            --cream: #f7f5ef;
            --gold: #c6a66b;
            --ink: #24312c;
            --muted: #727b74;
            --white: #ffffff;
            --border: #e8e4d9;
        }

        * { box-sizing: border-box; }
        html { scroll-behavior: smooth; }

        body {
            margin: 0;
            background: var(--cream);
            color: var(--ink);
            font-family: Arial, Helvetica, sans-serif;
            line-height: 1.7;
        }

        a { color: inherit; text-decoration: none; }

        .nav {
            min-height: 76px;
            padding: 18px 7%;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 20px;
            background: var(--white);
        }

        .brand {
            color: var(--forest);
            font-family: Georgia, serif;
            font-size: 23px;
            font-weight: bold;
        }

        .back-link { font-size: 14px; font-weight: 600; }

        .hero {
            position: relative;
            min-height: 510px;
            display: flex;
            align-items: flex-end;
            color: var(--white);
            background-color: var(--forest-dark);
            background-image:
                linear-gradient(0deg, rgba(10,25,19,.88), rgba(10,25,19,.05)),
                url('@(string.IsNullOrWhiteSpace(destination.ImageUrl) ? "" : destination.ImageUrl)');
            background-size: cover;
            background-position: center;
        }

        .hero-content {
            width: 100%;
            max-width: 1250px;
            padding: 70px 7%;
            margin: 0 auto;
        }

        .eyebrow {
            color: #e3c895;
            text-transform: uppercase;
            font-size: 12px;
            font-weight: bold;
            letter-spacing: 3px;
        }

        h1, h2, h3 {
            font-family: Georgia, "Times New Roman", serif;
            font-weight: normal;
            line-height: 1.2;
        }

        h1 { margin: 15px 0; font-size: clamp(42px, 7vw, 76px); }

        h2 {
            margin: 12px 0 20px;
            color: var(--forest);
            font-size: clamp(30px, 4vw, 43px);
        }

        h3 { margin: 8px 0; font-size: 25px; color: var(--forest); }

        .hero-description {
            max-width: 690px;
            font-size: 17px;
            color: rgba(255,255,255,.88);
        }

        .button {
            display: inline-block;
            margin: 22px 8px 0 0;
            padding: 13px 23px;
            border: 1px solid var(--gold);
            background: var(--gold);
            color: #17271f;
            font-size: 14px;
            font-weight: bold;
            transition: .2s ease;
            cursor: pointer;
        }

        .button:hover { transform: translateY(-2px); }
        .button-outline { background: transparent; color: white; border-color: rgba(255,255,255,.65); }

        .container {
            max-width: 1120px;
            margin: auto;
            padding: 70px 24px;
        }

        .intro-grid {
            display: grid;
            grid-template-columns: 1.4fr .8fr;
            gap: 55px;
        }

        .section-label {
            color: #8b7043;
            font-size: 11px;
            font-weight: bold;
            letter-spacing: 2px;
            text-transform: uppercase;
        }

        .description { white-space: pre-line; }

        .info-card {
            padding: 28px;
            background: var(--white);
            border: 1px solid var(--border);
        }

        .info-row { padding: 15px 0; border-bottom: 1px solid var(--border); }
        .info-row:last-child { border-bottom: 0; }

        .info-label {
            display: block;
            color: var(--muted);
            font-size: 12px;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .info-value { display: block; margin-top: 4px; font-weight: 600; }

        .listing-section { border-top: 1px solid var(--border); }

        .section-heading {
            display: flex;
            align-items: flex-end;
            justify-content: space-between;
            gap: 20px;
            margin-bottom: 28px;
        }

        .section-heading h2 { margin-bottom: 0; }
        .section-description { color: var(--muted); margin: 8px 0 0; }

        .listing-grid {
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 24px;
        }

        .listing-card {
            overflow: hidden;
            background: var(--white);
            border: 1px solid var(--border);
            display: flex;
            flex-direction: column;
            min-width: 0;
            transition: transform .25s ease, box-shadow .25s ease;
        }

        .listing-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 14px 30px rgba(24,60,50,.09);
        }

        .listing-image, .image-placeholder {
            width: 100%;
            height: 210px;
            display: block;
            background: #e4e5dc;
        }

        .listing-image { object-fit: cover; }

        .image-placeholder {
            display: grid;
            place-items: center;
            color: var(--forest);
            font-family: Georgia, serif;
            font-size: 20px;
        }

        .listing-content {
            padding: 22px;
            display: flex;
            flex-direction: column;
            flex: 1;
        }

        .listing-type {
            color: #8b7043;
            font-size: 10px;
            font-weight: bold;
            text-transform: uppercase;
            letter-spacing: 1.7px;
        }

        .listing-content h3 { font-size: 24px; }
        .listing-location { color: var(--muted); font-size: 13px; margin: 3px 0 12px; }
        .listing-description { font-size: 14px; margin: 0 0 18px; }

        .listing-meta {
            padding-top: 14px;
            margin-top: auto;
            border-top: 1px solid var(--border);
            font-size: 13px;
            overflow-wrap: anywhere;
        }

        .listing-price { color: var(--forest); font-weight: bold; }

        .listing-link {
            display: inline-block;
            margin-top: 16px;
            color: var(--forest);
            font-weight: bold;
            font-size: 13px;
        }

        .empty-state {
            padding: 30px;
            background: rgba(255,255,255,.7);
            border: 1px dashed #c9c9b9;
            color: var(--muted);
        }

        .empty-state strong {
            display: block;
            color: var(--forest);
            margin-bottom: 5px;
        }

        /* CUSTOMER REVIEWS */

        .reviews-section {
            border-top: 1px solid var(--border);
            background: #f1efe7;
        }

        .reviews-header {
            display: flex;
            align-items: flex-end;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 25px;
            margin-bottom: 35px;
        }

        .reviews-header h2 { margin-bottom: 8px; }

        .reviews-summary {
            display: flex;
            align-items: center;
            gap: 15px;
            padding: 17px 22px;
            background: var(--white);
            border: 1px solid var(--border);
            min-width: 190px;
        }

        .reviews-average {
            color: var(--forest);
            font-family: Georgia, serif;
            font-size: 38px;
            line-height: 1;
        }

        .reviews-stars {
            color: #bd914a;
            font-size: 17px;
            letter-spacing: 2px;
            white-space: nowrap;
        }

        .reviews-count {
            display: block;
            margin-top: 3px;
            color: var(--muted);
            font-size: 11px;
        }

        .reviews-grid {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 18px;
        }

        .review-card {
            padding: 25px;
            background: var(--white);
            border: 1px solid var(--border);
            min-width: 0;
        }

        .review-card-top {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            gap: 15px;
            margin-bottom: 14px;
        }

        .reviewer-name {
            color: var(--forest);
            font-weight: bold;
            font-size: 14px;
        }

        .review-date {
            display: block;
            color: var(--muted);
            font-size: 11px;
            margin-top: 3px;
        }

        .review-card h3 {
            font-size: 21px;
            margin: 12px 0 8px;
        }

        .review-comment {
            color: #626d65;
            font-size: 13.5px;
            white-space: pre-line;
            overflow-wrap: anywhere;
        }

        .review-empty {
            padding: 35px;
            text-align: center;
            background: var(--white);
            border: 1px dashed #c9c9b9;
        }

        .review-empty h3 { font-size: 24px; }
        .review-empty p { color: var(--muted); font-size: 13px; }

        .review-guideline {
            margin-top: 25px;
            color: var(--muted);
            font-size: 12px;
        }

        .planning { background: var(--forest); color: var(--white); }
        .planning h2 { color: var(--white); }
        .planning p { max-width: 650px; color: rgba(255,255,255,.8); }
        .planning .section-label { color: #e3c895; }

        .notice {
            margin-top: 24px;
            padding: 15px;
            border-left: 3px solid var(--gold);
            background: rgba(255,255,255,.07);
            font-size: 13px;
        }

        footer {
            padding: 25px;
            text-align: center;
            background: var(--forest-dark);
            color: rgba(255,255,255,.75);
            font-size: 13px;
        }

        @@media (max-width: 850px) {
            .listing-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
            .intro-grid { gap: 30px; }
        }

        @@media (max-width: 700px) {
            .nav { padding: 16px 5%; }
            .brand { font-size: 19px; }
            .hero { min-height: 430px; }
            .hero-content { padding: 45px 6%; }
            .intro-grid { grid-template-columns: 1fr; }
            .container { padding: 48px 20px; }
            .listing-grid, .reviews-grid { grid-template-columns: 1fr; }
            .section-heading { display: block; }
            .reviews-header { align-items: flex-start; }
        }
    </style>
</head>

<body>
    @await Html.PartialAsync("_KarnelCursor")
    <header class="nav">
        <a class="brand" href="/">Karnel Travel Guide</a>
        <a class="back-link" href="/Destinations">← All destinations</a>
    </header>

    <main>
        <section class="hero">
            <div class="hero-content">
                <div class="eyebrow">
                    @(destination.Region ?? "Explore Pakistan") · Pakistan
                </div>

                <h1>@destination.Name</h1>

                @if (!string.IsNullOrWhiteSpace(destination.ShortDescription))
                {
                    <p class="hero-description">@destination.ShortDescription</p>
                }

                <a class="button" href="#travel-information">Discover this destination ↓</a>
                <a class="button button-outline" href="#plan-trip">Plan your trip</a>
            </div>
        </section>

        <section class="container">
            <div class="intro-grid">
                <div>
                    <div class="section-label">Discover the destination</div>
                    <h2>Experience @destination.Name</h2>

                    @if (!string.IsNullOrWhiteSpace(destination.Description))
                    {
                        <div class="description">@destination.Description</div>
                    }
                    else
                    {
                        <p>More destination information will be added soon.</p>
                    }
                </div>

                <aside class="info-card" id="travel-information">
                    <div class="section-label">Travel essentials</div>

                    <div class="info-row">
                        <span class="info-label">Destination</span>
                        <span class="info-value">@destination.Name</span>
                    </div>

                    <div class="info-row">
                        <span class="info-label">Region</span>
                        <span class="info-value">@(destination.Region ?? "Information coming soon")</span>
                    </div>

                    <div class="info-row">
                        <span class="info-label">Best time to visit</span>
                        <span class="info-value">@(destination.BestTimeToVisit ?? "Information coming soon")</span>
                    </div>
                </aside>
            </div>
        </section>

        <!-- HOTELS -->
        <section class="container listing-section" id="hotels">
            <div class="section-heading">
                <div>
                    <div class="section-label">Stay comfortably</div>
                    <h2>Hotels in @destination.Name</h2>
                    <p class="section-description">Explore accommodation options for your visit.</p>
                </div>
            </div>

            @if (Model.Hotels.Any())
            {
                <div class="listing-grid">
                    @foreach (var hotel in Model.Hotels)
                    {
                        var inquiryUrl = "/Contact?category=" +
                            Uri.EscapeDataString("Hotel inquiry") +
                            "&service=" + Uri.EscapeDataString(hotel.Name) +
                            "&destination=" + Uri.EscapeDataString(destination.Name);

                        <article class="listing-card">
                            @if (!string.IsNullOrWhiteSpace(hotel.ImageUrl))
                            {
                                <img class="listing-image" src="@hotel.ImageUrl" alt="@hotel.Name" loading="lazy" />
                            }
                            else
                            {
                                <div class="image-placeholder">Hotel</div>
                            }

                            <div class="listing-content">
                                <div class="listing-type">Accommodation</div>
                                <h3>@hotel.Name</h3>

                                @if (!string.IsNullOrWhiteSpace(hotel.City) || !string.IsNullOrWhiteSpace(hotel.Address))
                                {
                                    <div class="listing-location">
                                        @hotel.City
                                        @if (!string.IsNullOrWhiteSpace(hotel.City) && !string.IsNullOrWhiteSpace(hotel.Address))
                                        {
                                            <span> · </span>
                                        }
                                        @hotel.Address
                                    </div>
                                }

                                @if (!string.IsNullOrWhiteSpace(hotel.ShortDescription))
                                {
                                    <p class="listing-description">@hotel.ShortDescription</p>
                                }

                                <div class="listing-meta">
                                    @if (hotel.StartingPricePerNight.HasValue && hotel.StartingPricePerNight.Value > 0)
                                    {
                                        <div class="listing-price">
                                            From PKR @string.Format("{0:N0}", hotel.StartingPricePerNight.Value) / night
                                        </div>
                                    }

                                    @if (hotel.StarRating > 0)
                                    {
                                        <div>Rating: @hotel.StarRating stars</div>
                                    }

                                    @if (!string.IsNullOrWhiteSpace(hotel.ContactPhone))
                                    {
                                        <div>Contact: @hotel.ContactPhone</div>
                                    }

                                    <a class="listing-link" href="@inquiryUrl">
                                        Ask about this hotel →
                                    </a>
                                </div>
                            </div>
                        </article>
                    }
                </div>
            }
            else
            {
                <div class="empty-state">
                    <strong>No hotels listed yet</strong>
                    Hotels will appear here when they are published and linked to this destination.
                </div>
            }
        </section>

        <!-- RESORTS -->
        <section class="container listing-section" id="resorts">
            <div class="section-heading">
                <div>
                    <div class="section-label">Relax and recharge</div>
                    <h2>Resorts in @destination.Name</h2>
                    <p class="section-description">Find resorts and places to unwind during your journey.</p>
                </div>
            </div>

            @if (Model.Resorts.Any())
            {
                <div class="listing-grid">
                    @foreach (var resort in Model.Resorts)
                    {
                        var inquiryUrl = "/Contact?category=" +
                            Uri.EscapeDataString("Resort inquiry") +
                            "&service=" + Uri.EscapeDataString(resort.Name) +
                            "&destination=" + Uri.EscapeDataString(destination.Name);

                        <article class="listing-card">
                            @if (!string.IsNullOrWhiteSpace(resort.ImageUrl))
                            {
                                <img class="listing-image" src="@resort.ImageUrl" alt="@resort.Name" loading="lazy" />
                            }
                            else
                            {
                                <div class="image-placeholder">Resort</div>
                            }

                            <div class="listing-content">
                                <div class="listing-type">Resort</div>
                                <h3>@resort.Name</h3>

                                @if (!string.IsNullOrWhiteSpace(resort.CityOrRegion) || !string.IsNullOrWhiteSpace(resort.Address))
                                {
                                    <div class="listing-location">
                                        @resort.CityOrRegion
                                        @if (!string.IsNullOrWhiteSpace(resort.CityOrRegion) && !string.IsNullOrWhiteSpace(resort.Address))
                                        {
                                            <span> · </span>
                                        }
                                        @resort.Address
                                    </div>
                                }

                                @if (!string.IsNullOrWhiteSpace(resort.ShortDescription))
                                {
                                    <p class="listing-description">@resort.ShortDescription</p>
                                }

                                <div class="listing-meta">
                                    @if (resort.StartingPricePerNight.HasValue && resort.StartingPricePerNight.Value > 0)
                                    {
                                        <div class="listing-price">
                                            From PKR @string.Format("{0:N0}", resort.StartingPricePerNight.Value) / night
                                        </div>
                                    }

                                    @if (!string.IsNullOrWhiteSpace(resort.ContactPhone))
                                    {
                                        <div>Contact: @resort.ContactPhone</div>
                                    }

                                    <a class="listing-link" href="@inquiryUrl">
                                        Ask about this resort →
                                    </a>
                                </div>
                            </div>
                        </article>
                    }
                </div>
            }
            else
            {
                <div class="empty-state">
                    <strong>No resorts listed yet</strong>
                    Resorts will appear here when they are published and linked to this destination.
                </div>
            }
        </section>

        <!-- RESTAURANTS -->
        <section class="container listing-section" id="restaurants">
            <div class="section-heading">
                <div>
                    <div class="section-label">Discover local flavours</div>
                    <h2>Restaurants in @destination.Name</h2>
                    <p class="section-description">Explore places to eat while visiting this destination.</p>
                </div>
            </div>

            @if (Model.Restaurants.Any())
            {
                <div class="listing-grid">
                    @foreach (var restaurant in Model.Restaurants)
                    {
                        var inquiryUrl = "/Contact?category=" +
                            Uri.EscapeDataString("Restaurant inquiry") +
                            "&service=" + Uri.EscapeDataString(restaurant.Name) +
                            "&destination=" + Uri.EscapeDataString(destination.Name);

                        <article class="listing-card">
                            @if (!string.IsNullOrWhiteSpace(restaurant.ImageUrl))
                            {
                                <img class="listing-image" src="@restaurant.ImageUrl" alt="@restaurant.Name" loading="lazy" />
                            }
                            else
                            {
                                <div class="image-placeholder">Restaurant</div>
                            }

                            <div class="listing-content">
                                <div class="listing-type">Dining</div>
                                <h3>@restaurant.Name</h3>

                                @if (!string.IsNullOrWhiteSpace(restaurant.City) || !string.IsNullOrWhiteSpace(restaurant.Address))
                                {
                                    <div class="listing-location">
                                        @restaurant.City
                                        @if (!string.IsNullOrWhiteSpace(restaurant.City) && !string.IsNullOrWhiteSpace(restaurant.Address))
                                        {
                                            <span> · </span>
                                        }
                                        @restaurant.Address
                                    </div>
                                }

                                @if (!string.IsNullOrWhiteSpace(restaurant.ShortDescription))
                                {
                                    <p class="listing-description">@restaurant.ShortDescription</p>
                                }

                                <div class="listing-meta">
                                    @if (!string.IsNullOrWhiteSpace(restaurant.CuisineType))
                                    {
                                        <div>Cuisine: @restaurant.CuisineType</div>
                                    }

                                    @if (restaurant.AverageMealPrice.HasValue && restaurant.AverageMealPrice.Value > 0)
                                    {
                                        <div class="listing-price">
                                            Average meal: PKR @string.Format("{0:N0}", restaurant.AverageMealPrice.Value)
                                        </div>
                                    }

                                    @if (!string.IsNullOrWhiteSpace(restaurant.ContactPhone))
                                    {
                                        <div>Contact: @restaurant.ContactPhone</div>
                                    }

                                    <a class="listing-link" href="@inquiryUrl">
                                        Ask about this restaurant →
                                    </a>
                                </div>
                            </div>
                        </article>
                    }
                </div>
            }
            else
            {
                <div class="empty-state">
                    <strong>No restaurants listed yet</strong>
                    Restaurants will appear here when they are published and linked to this destination.
                </div>
            }
        </section>

        <!-- CUSTOMER REVIEWS -->
        <section class="reviews-section" id="reviews">
            <div class="container">

                <div class="reviews-header">
                    <div>
                        <div class="section-label">Traveller experiences</div>
                        <h2>Reviews of @destination.Name</h2>
                        <p class="section-description">
                            Read feedback shared by visitors about this destination.
                        </p>
                    </div>

                    @if (Model.TotalReviews > 0)
                    {
                        <div class="reviews-summary">
                            <div class="reviews-average">
                                @Model.AverageRating.ToString("0.0")
                            </div>
                            <div>
                                <div class="reviews-stars">
                                    @for (int i = 1; i <= 5; i++)
                                    {
                                        @(i <= Math.Round(Model.AverageRating) ? "★" : "☆")
                                    }
                                </div>
                                <span class="reviews-count">
                                    @Model.TotalReviews approved review(s)
                                </span>
                            </div>
                        </div>
                    }
                </div>

                @if (Model.Reviews.Any())
                {
                    <div class="reviews-grid">
                        @foreach (var review in Model.Reviews)
                        {
                            <article class="review-card">
                                <div class="review-card-top">
                                    <div>
                                        <div class="reviewer-name">@review.ReviewerName</div>
                                        <span class="review-date">
                                            @review.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")
                                        </span>
                                    </div>

                                    <div class="reviews-stars" aria-label="@review.Rating out of 5 stars">
                                        @for (int i = 1; i <= 5; i++)
                                        {
                                            @(i <= review.Rating ? "★" : "☆")
                                        }
                                    </div>
                                </div>

                                <h3>@review.Title</h3>
                                <div class="review-comment">@review.Comment</div>
                            </article>
                        }
                    </div>
                }
                else
                {
                    <div class="review-empty">
                        <h3>Be the first to share your experience</h3>
                        <p>
                            There are no approved reviews for this destination yet.
                            If you have visited, you can share your feedback.
                        </p>
                    </div>
                }

                <div class="review-guideline">
                    Reviews are published only after moderation by Karnel Travel Guide.
                    Submitting a review does not guarantee publication.
                </div>

                <a class="button" href="@reviewUrl">
                    Write a review →
                </a>

            </div>
        </section>

        <section class="listing-section" id="packages">
            <div class="container">
                <div class="section-heading">
                    <div>
                        <div class="section-label">Published experiences</div>
                        <h2>Trips to @destination.Name</h2>
                        <p class="section-description">Choose a published package with real dates and availability, or request a custom itinerary below.</p>
                    </div>
                </div>

                @if (Model.Packages.Any())
                {
                    <div class="listing-grid">
                        @foreach (var package in Model.Packages)
                        {
                            var departures = package.Departures
                                .Where(d => d.IsActive && d.DepartureDate.Date >= DateTime.Today && d.AvailableSeats > 0)
                                .OrderBy(d => d.DepartureDate)
                                .ToList();
                            <article class="listing-card">
                                @if (!string.IsNullOrWhiteSpace(package.ImageUrl))
                                {
                                    <img class="listing-image" src="@package.ImageUrl" alt="@package.Name" />
                                }
                                <div class="listing-content">
                                    <div class="section-label">@package.DurationDays day package</div>
                                    <h3>@package.Name</h3>
                                    <p>@package.ShortDescription</p>
                                    @if (package.PricePerAdult.HasValue)
                                    {
                                        <p><strong>From @package.PricePerAdult.Value.ToString("N0") PKR per adult</strong></p>
                                    }
                                    @if (departures.Any())
                                    {
                                        <p>@departures.Count available departure(s), from @departures[0].DepartureDate.ToString("dd MMM yyyy")</p>
                                        <a class="button" href="/Bookings/Create?serviceType=Tour&amp;serviceId=@package.Id">Book this package →</a>
                                    }
                                    else
                                    {
                                        <p class="notice">No published departure is currently available.</p>
                                    }
                                </div>
                            </article>
                        }
                    </div>
                }
                else
                {
                    <div class="notice">There are no published packages for this destination yet.</div>
                }
            </div>
        </section>

        <!-- TRIP INQUIRY -->
        <section class="planning" id="plan-trip">
            <div class="container">
                <div class="section-label">Your next journey</div>
                <h2>Ready to explore @destination.Name?</h2>
                <p>
                    Tell us your preferred travel dates, number of travellers
                    and the arrangements you need. Our team can review your request.
                </p>

                <a class="button" href="/TripRequests/Create?destination=@destination.Id">
                    Plan a trip to @destination.Name →
                </a>

                <div class="notice">
                    Submitting an inquiry does not confirm a booking. Availability,
                    prices and arrangements must be confirmed by Karnel Travel Guide.
                </div>
            </div>
        </section>
    </main>

    <footer>
        © @DateTime.Now.Year Karnel Travel Guide. Explore more. Travel better.
    </footer>
    <script src="~/js/site.js" asp-append-version="true"></script>
</body>
</html>
