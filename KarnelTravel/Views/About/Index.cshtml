@{
    var websiteContent = ViewBag.WebsiteContent as KarnelTravel.Models.WebsiteContent ?? new KarnelTravel.Models.WebsiteContent();
    ViewData["Title"] = "Our Story | Karnel Travel Guide";
    ViewData["Description"] = "Learn about Karnel Travel Guide — a travel and tourism guide for destinations, transport, accommodation and packages across Pakistan.";
}

@section Styles {
    <style>
        @@import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;0,800;1,400;1,500;1,600&display=swap');

        /* ============================================================
           GLOBAL ENHANCEMENTS
        ============================================================ */
        :root {
            --ease-out: cubic-bezier(0.16, 1, 0.3, 1);
            --ease-spring: cubic-bezier(0.34, 1.56, 0.64, 1);
            --about-y: clamp(76px, 9vw, 140px);
        }

        html { scroll-behavior: smooth; }

        ::selection { background: var(--forest); color: var(--ivory); }

        ::-webkit-scrollbar { width: 10px; }
        ::-webkit-scrollbar-track { background: var(--ivory); }
        ::-webkit-scrollbar-thumb {
            background: var(--moss);
            border-radius: 10px;
            border: 2px solid var(--ivory);
        }
        ::-webkit-scrollbar-thumb:hover { background: var(--forest); }

        /* Reveal system (activated by JS) */
        .reveal-pending {
            opacity: 0;
            transform: translateY(44px);
            filter: blur(6px);
            transition:
                opacity 1.1s var(--ease-out),
                transform 1.1s var(--ease-out),
                filter 1.1s var(--ease-out);
        }
        .reveal-pending.is-revealed {
            opacity: 1 !important;
            transform: none !important;
            filter: blur(0) !important;
        }

        /* ============================================================
           SHARED EDITORIAL ATOMS
        ============================================================ */
        .about-eyebrow {
            display: inline-flex;
            align-items: center;
            gap: 12px;
            margin: 0 0 18px;
            font-family: var(--sans);
            font-size: 0.68rem;
            font-weight: 600;
            letter-spacing: 0.24em;
            text-transform: uppercase;
            color: var(--moss);
        }
        .about-eyebrow::before {
            content: '';
            width: 28px;
            height: 1px;
            background: currentColor;
            flex: 0 0 auto;
            opacity: 0.85;
        }
        .about-eyebrow--light { color: var(--sage); }

        .about-section { position: relative; padding: var(--about-y) 0; }

        .about-section--ivory {
            background-color: var(--ivory);
            background-image:
                radial-gradient(ellipse 60% 50% at 92% 8%, rgba(143, 168, 136, 0.10), transparent 60%),
                radial-gradient(ellipse 50% 60% at 8% 92%, rgba(232, 223, 201, 0.30), transparent 60%);
        }
        .about-section--sand {
            background-color: var(--sand);
            background-image:
                radial-gradient(ellipse 70% 60% at 100% 0%, rgba(255, 255, 255, 0.40), transparent 60%),
                radial-gradient(ellipse 50% 50% at 0% 100%, rgba(83, 107, 80, 0.08), transparent 60%);
        }
        .about-section--forest {
            background-color: var(--forest);
            color: var(--ivory);
        }

        .about-lede {
            max-width: 56ch;
            color: var(--muted);
            font-size: clamp(1rem, 1.15vw, 1.1rem);
            line-height: 1.75;
        }
        .about-section--forest .about-lede { color: rgba(248, 246, 240, 0.74); }

        /* Buttons */
        .btn {
            position: relative;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            min-height: 52px;
            padding: 0 28px;
            overflow: hidden;
            isolation: isolate;
            border: 1px solid transparent;
            border-radius: var(--radius);
            background: var(--forest);
            color: var(--ivory);
            font-family: var(--sans);
            font-size: 0.74rem;
            font-weight: 600;
            letter-spacing: 0.16em;
            text-transform: uppercase;
            text-decoration: none;
            cursor: pointer;
            transition:
                transform 0.5s var(--ease-out),
                box-shadow 0.5s var(--ease-out),
                background 0.4s var(--ease),
                color 0.4s var(--ease),
                border-color 0.4s var(--ease);
        }
        .btn::after {
            content: '';
            position: absolute;
            inset: 0;
            background: linear-gradient(120deg,
                transparent 20%,
                rgba(255, 255, 255, 0.35) 50%,
                transparent 80%);
            transform: translateX(-120%);
            transition: transform 0.85s var(--ease-out);
            pointer-events: none;
            z-index: 1;
        }
        .btn:hover {
            transform: translateY(-3px);
            box-shadow: 0 18px 32px -18px rgba(20, 39, 31, 0.55);
        }
        .btn:hover::after { transform: translateX(120%); }
        .btn:active { transform: translateY(-1px); }

        .btn--light {
            background: var(--ivory);
            color: var(--forest-deep);
            border-color: var(--ivory);
        }
        .btn--ghost-light {
            background: transparent;
            color: var(--ivory);
            border-color: rgba(248, 246, 240, 0.45);
        }
        .btn--ghost-light:hover {
            border-color: var(--ivory);
            background: rgba(248, 246, 240, 0.08);
        }
        .btn--forest {
            background: var(--forest);
            color: var(--ivory);
        }

        .link-arrow {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            padding-bottom: 3px;
            border-bottom: 1px solid transparent;
            font-size: 0.7rem;
            font-weight: 600;
            letter-spacing: 0.16em;
            text-transform: uppercase;
            color: var(--forest);
            text-decoration: none;
            transition: color 0.3s var(--ease), border-color 0.3s var(--ease);
        }
        .link-arrow::after {
            content: '\2192';
            font-size: 0.95rem;
            transition: transform 0.4s var(--ease-out);
        }
        .link-arrow:hover {
            color: var(--forest-deep);
            border-color: currentColor;
        }
        .link-arrow:hover::after { transform: translateX(4px); }

        .link-arrow--light { color: var(--sand); }
        .link-arrow--light:hover { color: #fff; }

        /* ============================================================
           SECTION 01 — CINEMATIC BRAND INTRODUCTION
        ============================================================ */
        .intro {
            position: relative;
            padding: calc(var(--header-h) + clamp(40px, 6vw, 90px)) 0 var(--about-y);
            overflow: hidden;
            background: var(--ivory);
        }
        .intro__grid {
            display: grid;
            grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
            gap: clamp(30px, 5vw, 80px);
            align-items: end;
        }
        .intro__content { position: relative; z-index: 2; }
        .intro h1 {
            max-width: 15ch;
            margin: 0 0 26px;
            font-size: clamp(2.6rem, 5.4vw, 4.8rem);
            line-height: 0.98;
            letter-spacing: -0.025em;
            text-wrap: balance;
        }
        .intro h1 em {
            font-style: italic;
            color: var(--moss);
        }
        .intro__lede {
            max-width: 52ch;
            margin: 0 0 32px;
            color: var(--muted);
            font-size: clamp(1rem, 1.15vw, 1.1rem);
            line-height: 1.75;
        }
        .intro__actions {
            display: flex;
            flex-wrap: wrap;
            gap: 14px;
        }
        .intro__meta {
            display: flex;
            flex-wrap: wrap;
            gap: clamp(20px, 3vw, 46px);
            margin-top: clamp(28px, 4vw, 46px);
            padding-top: 22px;
            border-top: 1px solid var(--line);
        }
        .intro__meta > div {
            min-width: 110px;
        }
        .intro__meta strong {
            display: block;
            font-family: var(--serif);
            font-weight: 500;
            font-size: clamp(1.4rem, 2.2vw, 1.9rem);
            line-height: 1;
            color: var(--forest-deep);
        }
        .intro__meta span {
            display: block;
            margin-top: 6px;
            font-size: 0.62rem;
            letter-spacing: 0.18em;
            text-transform: uppercase;
            color: var(--muted);
        }

        .intro__media {
            position: relative;
            aspect-ratio: 4 / 5;
            overflow: hidden;
            border-radius: var(--radius-lg);
            box-shadow: 0 50px 90px -50px rgba(20, 39, 31, 0.55);
        }
        .intro__media img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            will-change: transform;
            transform: scale(1.05);
        }
        .intro__media::after {
            content: '';
            position: absolute;
            inset: 0;
            background: linear-gradient(180deg, transparent 55%, rgba(20, 39, 31, 0.32) 100%);
            pointer-events: none;
        }
        .intro__tag {
            position: absolute;
            left: -24px;
            bottom: 28px;
            z-index: 2;
            padding: 14px 20px;
            background: var(--ivory);
            border: 1px solid var(--line);
            border-radius: var(--radius);
            box-shadow: 0 24px 44px -26px rgba(20, 39, 31, 0.4);
            display: flex;
            align-items: center;
            gap: 12px;
        }
        .intro__tag b {
            font-family: var(--serif);
            font-style: italic;
            font-weight: 400;
            font-size: 1.35rem;
            color: var(--forest);
            line-height: 1;
        }
        .intro__tag span {
            font-size: 0.62rem;
            letter-spacing: 0.2em;
            text-transform: uppercase;
            color: var(--muted);
        }

        /* ============================================================
           SECTION 02 — THE REASON BEHIND KARNEL
        ============================================================ */
        .reason__grid {
            display: grid;
            grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr);
            gap: clamp(30px, 5vw, 84px);
            align-items: center;
        }
        .reason__media-wrap {
            position: relative;
            min-height: clamp(420px, 46vw, 620px);
        }
        .reason__media {
            position: absolute;
            inset: 0 12% 14% 0;
            overflow: hidden;
            border-radius: var(--radius-lg);
            box-shadow: 0 40px 70px -46px rgba(20, 39, 31, 0.5);
        }
        .reason__media img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }
        .reason__accent {
            position: absolute;
            right: 0;
            bottom: 0;
            width: 46%;
            aspect-ratio: 1 / 1;
            overflow: hidden;
            border: 10px solid var(--ivory);
            border-radius: var(--radius-lg);
            box-shadow: 0 30px 60px -34px rgba(20, 39, 31, 0.5);
        }
        .reason__accent img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }
        .reason__caption {
            position: absolute;
            left: 8%;
            bottom: 4%;
            padding: 8px 14px;
            background: var(--ivory);
            border: 1px solid var(--line);
            border-radius: 999px;
            font-size: 0.62rem;
            letter-spacing: 0.18em;
            text-transform: uppercase;
            color: var(--muted);
        }

        .reason__body h2 {
            margin: 0 0 22px;
            font-size: clamp(2rem, 3.6vw, 3.2rem);
            line-height: 1.04;
            letter-spacing: -0.02em;
            text-wrap: balance;
        }
        .reason__body p {
            margin: 0;
            color: var(--muted);
            line-height: 1.75;
        }
        .reason__body p + p { margin-top: 16px; }

        .reason__pull {
            margin: 30px 0 0;
            padding: 22px 0 0 26px;
            border-top: 1px solid var(--line);
            border-left: 1px solid var(--line);
            font-family: var(--serif);
            font-style: italic;
            font-weight: 400;
            font-size: clamp(1.15rem, 1.5vw, 1.35rem);
            line-height: 1.5;
            color: var(--forest-deep);
        }

        /* ============================================================
           SECTION 03 — OUR TRAVEL PHILOSOPHY
        ============================================================ */
        .philosophy__head {
            display: grid;
            grid-template-columns: 1.1fr 0.9fr;
            gap: clamp(24px, 4vw, 64px);
            align-items: end;
            margin-bottom: clamp(40px, 6vw, 72px);
        }
        .philosophy__head h2 {
            margin: 0;
            font-size: clamp(2rem, 3.8vw, 3.4rem);
            line-height: 1.02;
            letter-spacing: -0.02em;
            text-wrap: balance;
        }
        .philosophy__head p {
            margin: 0;
            color: var(--muted);
            line-height: 1.7;
        }
        .about-section--forest .philosophy__head p { color: rgba(248, 246, 240, 0.72); }
        .about-section--forest .philosophy__head h2 { color: var(--ivory); }

        .philosophy {
            margin: 0;
            padding: 0;
            list-style: none;
            border-top: 1px solid var(--line);
        }
        .about-section--forest .philosophy { border-top-color: rgba(248, 246, 240, 0.15); }

        .philosophy__row {
            display: grid;
            grid-template-columns: minmax(0, 0.28fr) minmax(0, 0.32fr) minmax(0, 0.4fr);
            gap: clamp(24px, 4vw, 56px);
            align-items: baseline;
            padding: clamp(28px, 4vw, 44px) 0;
            border-bottom: 1px solid var(--line);
            transition: border-color 0.4s var(--ease);
        }
        .about-section--forest .philosophy__row {
            border-bottom-color: rgba(248, 246, 240, 0.15);
        }
        .philosophy__row:hover { border-bottom-color: var(--moss); }
        .about-section--forest .philosophy__row:hover {
            border-bottom-color: var(--sage);
        }

        .philosophy__num {
            font-family: var(--serif);
            font-style: italic;
            font-weight: 400;
            font-size: clamp(2.2rem, 4vw, 3.4rem);
            line-height: 1;
            color: var(--sage);
            transition: color 0.4s var(--ease), transform 0.5s var(--ease-out);
            display: inline-block;
        }
        .philosophy__row:hover .philosophy__num {
            color: var(--forest);
            transform: translateX(6px);
        }
        .about-section--forest .philosophy__row:hover .philosophy__num { color: var(--sand); }

        .philosophy__title {
            margin: 0;
            font-size: clamp(1.3rem, 1.9vw, 1.6rem);
            line-height: 1.15;
            letter-spacing: -0.01em;
        }
        .about-section--forest .philosophy__title { color: var(--ivory); }

        .philosophy__body {
            margin: 0;
            color: var(--muted);
            line-height: 1.7;
        }
        .about-section--forest .philosophy__body { color: rgba(248, 246, 240, 0.72); }

        /* ============================================================
           SECTION 04 — ONE CONNECTED TRAVEL EXPERIENCE
        ============================================================ */
        .connected__head {
            max-width: 720px;
            margin-bottom: clamp(40px, 6vw, 72px);
        }
        .connected__head h2 {
            margin: 0 0 18px;
            font-size: clamp(2rem, 3.8vw, 3.4rem);
            line-height: 1.02;
            letter-spacing: -0.02em;
            text-wrap: balance;
        }
        .connected__head p {
            margin: 0;
            color: var(--muted);
            line-height: 1.7;
        }

        .journey {
            position: relative;
            margin: 0;
            padding: 0;
            list-style: none;
        }
        .journey::before {
            content: '';
            position: absolute;
            left: 50%;
            top: 8px;
            bottom: 8px;
            width: 1px;
            background: linear-gradient(180deg,
                transparent,
                var(--line) 8%,
                var(--line) 92%,
                transparent);
            transform: translateX(-0.5px);
        }

        .journey__step {
            position: relative;
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: clamp(24px, 4vw, 56px);
            padding: clamp(20px, 2.6vw, 30px) 0;
        }
        .journey__step::before {
            content: '';
            position: absolute;
            left: 50%;
            top: 40px;
            width: 11px;
            height: 11px;
            transform: translateX(-50%) rotate(45deg);
            background: var(--ivory);
            border: 1px solid var(--moss);
            transition: background 0.4s var(--ease), transform 0.5s var(--ease-out);
        }
        .journey__step:hover::before {
            background: var(--forest);
            transform: translateX(-50%) rotate(45deg) scale(1.25);
        }

        .journey__card {
            position: relative;
            padding: clamp(20px, 2.6vw, 30px);
            background: var(--white);
            border: 1px solid var(--line);
            border-radius: var(--radius-lg);
            transition:
                transform 0.5s var(--ease-out),
                box-shadow 0.5s var(--ease-out),
                border-color 0.4s var(--ease);
        }
        .journey__card:hover {
            transform: translateY(-4px);
            border-color: rgba(83, 107, 80, 0.28);
            box-shadow: 0 30px 55px -34px rgba(20, 39, 31, 0.4);
        }

        .journey__step:nth-child(odd) .journey__card {
            grid-column: 1;
            margin-right: clamp(12px, 2vw, 28px);
            text-align: right;
        }
        .journey__step:nth-child(even) .journey__card {
            grid-column: 2;
            margin-left: clamp(12px, 2vw, 28px);
        }

        .journey__num {
            display: inline-block;
            margin-bottom: 10px;
            font-family: var(--serif);
            font-style: italic;
            font-size: 0.95rem;
            letter-spacing: 0.06em;
            color: var(--sage);
        }
        .journey__card h3 {
            margin: 0 0 8px;
            font-size: clamp(1.15rem, 1.6vw, 1.35rem);
            letter-spacing: -0.01em;
        }
        .journey__card p {
            margin: 0 0 16px;
            color: var(--muted);
            font-size: 0.9rem;
            line-height: 1.65;
        }
        .journey__step:nth-child(odd) .journey__card .link-arrow {
            flex-direction: row-reverse;
        }
        .journey__step:nth-child(odd) .journey__card .link-arrow::after {
            content: '\2190';
        }

        /* ============================================================
           SECTION 05 — MISSION & VISION
        ============================================================ */
        .mission {
            position: relative;
            overflow: hidden;
            padding: clamp(90px, 12vw, 160px) 0;
            background:
                radial-gradient(ellipse 60% 70% at 20% 30%, rgba(83, 107, 80, 0.45), transparent 60%),
                radial-gradient(ellipse 55% 60% at 85% 75%, rgba(143, 168, 136, 0.22), transparent 65%),
                linear-gradient(135deg, #0e1e17 0%, #14271f 50%, #1c3529 100%);
            color: var(--ivory);
            isolation: isolate;
        }
        .mission::before {
            content: '';
            position: absolute;
            inset: 0;
            background-image:
                linear-gradient(rgba(255, 255, 255, 0.04) 1px, transparent 1px),
                linear-gradient(90deg, rgba(255, 255, 255, 0.04) 1px, transparent 1px);
            background-size: 64px 64px;
            mask-image: radial-gradient(ellipse 72% 72% at 50% 50%, black 20%, transparent 82%);
            -webkit-mask-image: radial-gradient(ellipse 72% 72% at 50% 50%, black 20%, transparent 82%);
            pointer-events: none;
            z-index: 0;
        }
        .mission::after {
            content: '';
            position: absolute;
            top: 10%;
            right: -6%;
            width: 42vw;
            height: 42vw;
            border: 1px solid rgba(232, 223, 201, 0.08);
            border-radius: 50%;
            pointer-events: none;
            z-index: 0;
        }
        .mission > .container {
            position: relative;
            z-index: 1;
        }
        .mission__head {
            max-width: 760px;
            margin-bottom: clamp(44px, 6vw, 80px);
        }
        .mission__head h2 {
            margin: 0 0 20px;
            color: var(--ivory);
            font-size: clamp(2.2rem, 4.4vw, 4rem);
            line-height: 1.02;
            letter-spacing: -0.02em;
            text-wrap: balance;
        }
        .mission__head p {
            margin: 0;
            max-width: 58ch;
            color: rgba(248, 246, 240, 0.74);
            line-height: 1.75;
        }

        .mission__grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: clamp(28px, 5vw, 80px);
            align-items: start;
        }
        .mission__block {
            position: relative;
            padding-top: 28px;
            border-top: 1px solid rgba(248, 246, 240, 0.16);
        }
        .mission__block::before {
            content: '';
            position: absolute;
            top: -1px;
            left: 0;
            width: 0;
            height: 1px;
            background: var(--sand);
            transition: width 0.7s var(--ease-out);
        }
        .mission__block:hover::before { width: 72px; }

        .mission__block-tag {
            display: block;
            margin-bottom: 14px;
            font-family: var(--serif);
            font-style: italic;
            font-size: 0.9rem;
            letter-spacing: 0.05em;
            color: var(--sand);
        }
        .mission__block h3 {
            margin: 0 0 14px;
            color: var(--ivory);
            font-size: clamp(1.4rem, 2.2vw, 1.9rem);
            line-height: 1.12;
            letter-spacing: -0.01em;
        }
        .mission__block p {
            margin: 0;
            color: rgba(248, 246, 240, 0.76);
            line-height: 1.75;
        }
        .mission__foot {
            margin-top: clamp(40px, 6vw, 72px);
            padding-top: 28px;
            border-top: 1px solid rgba(248, 246, 240, 0.16);
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            justify-content: space-between;
            gap: 20px;
        }
        .mission__foot p {
            margin: 0;
            max-width: 52ch;
            color: rgba(248, 246, 240, 0.62);
            font-size: 0.88rem;
            line-height: 1.7;
        }

        /* ============================================================
           SECTION 06 — CLOSING BRAND STATEMENT
        ============================================================ */
        .closing {
            position: relative;
            display: grid;
            align-items: end;
            min-height: clamp(560px, 82vh, 820px);
            overflow: hidden;
            color: var(--ivory);
            isolation: isolate;
        }
        .closing__media {
            position: absolute;
            inset: 0;
            z-index: -1;
        }
        .closing__media img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transform: scale(1.06);
            will-change: transform;
        }
        .closing::after {
            content: '';
            position: absolute;
            inset: 0;
            z-index: -1;
            background:
                linear-gradient(180deg, rgba(20, 39, 31, 0.35) 0%, rgba(20, 39, 31, 0.55) 45%, rgba(20, 39, 31, 0.92) 100%),
                radial-gradient(ellipse 60% 70% at 15% 30%, rgba(20, 39, 31, 0.1), transparent 65%);
        }
        .closing > .container {
            position: relative;
            z-index: 1;
            padding-top: clamp(60px, 8vw, 120px);
            padding-bottom: clamp(50px, 7vw, 100px);
        }
        .closing__content {
            max-width: 820px;
        }
        .closing h2 {
            margin: 0 0 22px;
            color: var(--ivory);
            font-size: clamp(2.4rem, 5vw, 4.4rem);
            line-height: 1.02;
            letter-spacing: -0.025em;
            text-wrap: balance;
        }
        .closing h2 em {
            font-style: italic;
            color: var(--sand);
        }
        .closing p {
            margin: 0 0 32px;
            max-width: 56ch;
            color: rgba(248, 246, 240, 0.82);
            font-size: clamp(1rem, 1.15vw, 1.08rem);
            line-height: 1.75;
        }
        .closing__actions {
            display: flex;
            flex-wrap: wrap;
            gap: 14px;
        }
        .closing__mark {
            margin-top: clamp(40px, 6vw, 70px);
            display: flex;
            align-items: center;
            gap: 16px;
            color: rgba(248, 246, 240, 0.6);
        }
        .closing__mark::before {
            content: '';
            width: 40px;
            height: 1px;
            background: currentColor;
            flex: 0 0 auto;
        }
        .closing__mark span {
            font-size: 0.62rem;
            letter-spacing: 0.24em;
            text-transform: uppercase;
        }

        /* ============================================================
           RESPONSIVE
        ============================================================ */
        @@media (max-width: 1024px) {
            .intro__grid,
            .reason__grid,
            .mission__grid {
                grid-template-columns: 1fr;
            }
            .intro__grid { gap: clamp(32px, 5vw, 52px); }
            .intro__media { aspect-ratio: 16 / 11; }
            .intro__tag { left: 20px; bottom: 20px; }
            .reason__media-wrap { min-height: clamp(360px, 60vw, 520px); }
            .reason__media { inset: 0 6% 12% 0; }
        }

        @@media (max-width: 900px) {
            .philosophy__head {
                grid-template-columns: 1fr;
                align-items: start;
            }
            .philosophy__row {
                grid-template-columns: minmax(0, 0.24fr) minmax(0, 1fr);
                gap: clamp(18px, 3vw, 28px);
                align-items: start;
            }
            .philosophy__body {
                grid-column: 2;
            }
            .philosophy__num {
                font-size: clamp(1.9rem, 3.4vw, 2.8rem);
            }

            .journey::before { left: 22px; }
            .journey__step {
                grid-template-columns: 1fr;
                padding: 14px 0 14px 56px;
            }
            .journey__step::before {
                left: 22px;
                top: 32px;
            }
            .journey__step:nth-child(odd) .journey__card,
            .journey__step:nth-child(even) .journey__card {
                grid-column: 1;
                margin-left: 0;
                margin-right: 0;
                text-align: left;
            }
            .journey__step:nth-child(odd) .journey__card .link-arrow {
                flex-direction: row;
            }
            .journey__step:nth-child(odd) .journey__card .link-arrow::after {
                content: '\2192';
            }
        }

        @@media (max-width: 720px) {
            .intro__tag {
                padding: 10px 16px;
            }
            .intro__tag b { font-size: 1.15rem; }
            .reason__accent { border-width: 8px; width: 52%; }
            .reason__caption { display: none; }
        }

        @@media (max-width: 600px) {
            .intro {
                padding-top: calc(var(--header-h) + 32px);
            }
            .intro h1 { max-width: none; }
            .intro__media { aspect-ratio: 4 / 5; }
            .reason__media-wrap { min-height: 380px; }
            .reason__media { inset: 0 0 18% 0; }
            .reason__accent { width: 58%; }
            .mission__grid { gap: 28px; }
            .mission__foot {
                flex-direction: column;
                align-items: flex-start;
            }
        }

        /* ============================================================
           REDUCED MOTION
        ============================================================ */
        @@media (prefers-reduced-motion: reduce) {
            html { scroll-behavior: auto; }
            .reveal-pending {
                opacity: 1 !important;
                transform: none !important;
                filter: none !important;
                transition: none !important;
            }
            .btn,
            .journey__card,
            .journey__step::before,
            .philosophy__num,
            .mission__block::before,
            .intro__media img,
            .closing__media img {
                transition: none !important;
            }
            .btn:hover,
            .journey__card:hover,
            .philosophy__row:hover .philosophy__num {
                transform: none !important;
            }
        }
    </style>
}

<!-- ==================== SECTION 01 — CINEMATIC BRAND INTRODUCTION ==================== -->
<header class="intro">
