        <ol class="journey" data-reveal-group>
            <li class="journey__step" data-reveal>
                <article class="journey__card">
                    <span class="journey__num">i.</span>
                    <h3>Tourist Destinations</h3>
                    <p>
                        Region introductions, landscape notes and curated spots — from Hunza
                        to Thar. The starting point for every journey on Karnel.
                    </p>
                    <a class="link-arrow" href="@Url.Action("Index", "Destinations")">Explore destinations</a>
                </article>
            </li>

            <li class="journey__step" data-reveal>
