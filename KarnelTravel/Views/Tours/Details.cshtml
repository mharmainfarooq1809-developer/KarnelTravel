@model KarnelTravel.Models.TourPackage

@{
    ViewData["Title"] = Model.Name + " | Karnel Travel Guide";

    var departures = Model.Departures
        .Where(d => d.IsActive && d.DepartureDate.Date >= DateTime.Today)
        .OrderBy(d => d.DepartureDate)
        .ToList();

    var itinerary = Model.ItineraryDays?
        .OrderBy(d => d.DayNumber)
        .ToList() ?? new List<KarnelTravel.Models.TourItineraryDay>();

    var hasInclusions = !string.IsNullOrWhiteSpace(Model.Inclusions);
    var hasExclusions = !string.IsNullOrWhiteSpace(Model.Exclusions);

    string FormatPrice(decimal? value) =>
        value.HasValue ? $"PKR {value.Value:N0}" : "On request";
}

@section Styles {
    <style>
        @@import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;0,800;1,400;1,500;1,600&display=swap');

        :root {
            --ease-out: cubic-bezier(0.16, 1, 0.3, 1);
            --ease-spring: cubic-bezier(0.34, 1.56, 0.64, 1);
            --card-radius: 20px;
            --card-radius-sm: 14px;
        }

        html { scroll-behavior: smooth; }
        ::selection { background: var(--forest); color: var(--ivory); }
        ::-webkit-scrollbar { width: 10px; }
        ::-webkit-scrollbar-track { background: var(--ivory); }
        ::-webkit-scrollbar-thumb {
            background: var(--moss);
            border-radius: 10px;
            border: 2px solid var(--ivory);
        }
        ::-webkit-scrollbar-thumb:hover { background: var(--forest); }

        :focus-visible {
            outline: 2px solid var(--moss);
            outline-offset: 3px;
            border-radius: 4px;
        }

        /* ---------- Reveal ---------- */
        .reveal-pending {
            opacity: 0;
            transform: translateY(36px);
            filter: blur(5px);
            transition:
                opacity 0.95s var(--ease-out),
                transform 0.95s var(--ease-out),
                filter 0.95s var(--ease-out);
        }
        .reveal-pending.is-revealed {
            opacity: 1 !important;
            transform: none !important;
            filter: blur(0) !important;
        }

        /* ---------- Shared atoms ---------- */
        .eyebrow {
            display: inline-flex;
            align-items: center;
            gap: 12px;
            margin: 0 0 16px;
            font-family: var(--sans);
            font-size: 0.66rem;
            font-weight: 600;
            letter-spacing: 0.24em;
            text-transform: uppercase;
            color: var(--moss);
        }
        .eyebrow::before {
            content: '';
            width: 28px;
            height: 1px;
            background: currentColor;
            flex: 0 0 auto;
            opacity: 0.85;
        }
        .eyebrow--light { color: var(--sage); }

        .tag {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            font-size: 0.62rem;
            letter-spacing: 0.16em;
            text-transform: uppercase;
            color: var(--moss);
        }
        .tag::before {
            content: '';
            width: 5px;
            height: 5px;
            border-radius: 50%;
            background: var(--sage);
            flex: 0 0 auto;
        }

        .price {
            font-family: var(--serif);
            font-size: 1.12rem;
            line-height: 1.15;
            color: var(--forest-deep);
            letter-spacing: -0.01em;
        }
        .price small {
            display: block;
            margin-bottom: 3px;
            font-family: var(--sans);
            font-size: 0.58rem;
            font-weight: 400;
            letter-spacing: 0.16em;
            text-transform: uppercase;
            color: var(--muted);
        }

        .media--fallback {
            display: grid;
            place-items: center;
            width: 100%;
            height: 100%;
            padding: 18px;
            border-radius: inherit;
            text-align: center;
            background:
                radial-gradient(ellipse 80% 80% at 20% 10%, rgba(143, 168, 136, 0.35), transparent 60%),
                linear-gradient(140deg, var(--forest) 0%, #1d3629 55%, var(--moss) 130%);
            color: rgba(248, 246, 240, 0.92);
            font-family: var(--serif);
            font-style: italic;
            font-size: 1rem;
            line-height: 1.35;
            position: relative;
            overflow: hidden;
        }
        .media--fallback::after {
            content: '';
            position: absolute;
            inset: 9px;
            border: 1px solid rgba(248, 246, 240, 0.14);
            border-radius: inherit;
            pointer-events: none;
        }

        /* ---------- Buttons ---------- */
        .btn {
            position: relative;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            min-height: 52px;
            padding: 0 26px;
            overflow: hidden;
            isolation: isolate;
            border: 1px solid transparent;
            border-radius: var(--radius);
            background: var(--forest);
            color: var(--ivory);
            font-family: var(--sans);
            font-size: 0.72rem;
            font-weight: 600;
            letter-spacing: 0.16em;
            text-transform: uppercase;
            text-decoration: none;
            cursor: pointer;
            transition:
                transform 0.5s var(--ease-out),
                box-shadow 0.5s var(--ease-out),
                background 0.4s var(--ease),
                color 0.4s var(--ease),
                border-color 0.4s var(--ease);
        }
        .btn::after {
            content: '';
            position: absolute;
            inset: 0;
            z-index: 1;
            background: linear-gradient(120deg, transparent 20%, rgba(255, 255, 255, 0.35) 50%, transparent 80%);
            transform: translateX(-120%);
            transition: transform 0.85s var(--ease-out);
            pointer-events: none;
        }
        .btn:hover {
            transform: translateY(-3px);
            box-shadow: 0 18px 32px -18px rgba(20, 39, 31, 0.55);
        }
        .btn:hover::after { transform: translateX(120%); }
        .btn:active { transform: translateY(-1px); }

        .btn--ghost-dark {
            background: transparent;
            color: var(--forest);
            border-color: rgba(20, 39, 31, 0.26);
        }
        .btn--ghost-dark:hover { border-color: var(--forest); }

        .btn--block { width: 100%; }

        .link-arrow {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            padding-bottom: 3px;
            border-bottom: 1px solid transparent;
            font-size: 0.64rem;
            font-weight: 600;
            letter-spacing: 0.16em;
            text-transform: uppercase;
            color: var(--forest);
            text-decoration: none;
            transition: color 0.3s var(--ease), border-color 0.3s var(--ease);
        }
        .link-arrow::after {
            content: '\2192';
            font-size: 0.92rem;
            transition: transform 0.4s var(--ease-out);
        }
        .link-arrow:hover { color: var(--forest-deep); border-color: currentColor; }
        .link-arrow:hover::after { transform: translateX(4px); }

        /* ---------- Hero ---------- */
        .tour-hero {
            position: relative;
            display: flex;
            align-items: flex-end;
            min-height: clamp(440px, 58vh, 620px);
            padding: calc(var(--header-h) + clamp(48px, 7vw, 90px)) 0 clamp(48px, 6vw, 72px);
            overflow: hidden;
            color: var(--ivory);
            isolation: isolate;
            background: var(--forest-deep);
        }
        .tour-hero::before {
            content: '';
            position: absolute;
            inset: 0;
            z-index: -2;
            background:
                radial-gradient(ellipse 70% 70% at 15% 20%, rgba(143, 168, 136, 0.2), transparent 60%),
                linear-gradient(180deg, #173b32 0%, #1d3629 60%, #14271f 100%);
        }
        .tour-hero::after {
            content: '';
            position: absolute;
            inset: 0;
            z-index: -1;
            opacity: 0.4;
            background-image:
                radial-gradient(circle at 20% 30%, rgba(255, 255, 255, 0.05) 1px, transparent 1px),
                radial-gradient(circle at 80% 70%, rgba(255, 255, 255, 0.04) 1px, transparent 1px);
            background-size: 40px 40px, 56px 56px;
            pointer-events: none;
        }
        .tour-hero__inner {
            position: relative;
            z-index: 1;
            max-width: 860px;
        }
        .tour-hero h1 {
            margin: 12px 0 16px;
            color: var(--ivory);
            font-family: var(--serif);
            font-size: clamp(2.4rem, 5vw, 4.2rem);
            line-height: 1.02;
            letter-spacing: -0.025em;
            text-wrap: balance;
        }
        .tour-hero h1 em { font-style: italic; color: var(--sand); }
        .tour-hero__lead {
            max-width: 60ch;
            margin: 0;
            color: rgba(248, 246, 240, 0.82);
            font-size: clamp(1rem, 1.15vw, 1.08rem);
            line-height: 1.7;
        }
        .tour-hero__meta {
            display: flex;
            flex-wrap: wrap;
            gap: 10px 22px;
            margin-top: 28px;
            padding-top: 20px;
            border-top: 1px solid rgba(248, 246, 240, 0.18);
            max-width: 720px;
        }
        .tour-hero__meta span {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            font-size: 0.62rem;
            letter-spacing: 0.2em;
            text-transform: uppercase;
            color: rgba(248, 246, 240, 0.7);
        }
        .tour-hero__meta span::before {
            content: '';
            width: 16px;
            height: 1px;
            background: currentColor;
            opacity: 0.7;
        }
        .tour-hero__back {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            margin-bottom: 24px;
            font-size: 0.6rem;
            letter-spacing: 0.22em;
            text-transform: uppercase;
            color: rgba(248, 246, 240, 0.6);
            text-decoration: none;
            transition: color 0.3s var(--ease);
        }
        .tour-hero__back::before {
            content: '\2190';
            font-size: 0.9rem;
            transition: transform 0.35s var(--ease-out);
        }
        .tour-hero__back:hover { color: var(--ivory); }
        .tour-hero__back:hover::before { transform: translateX(-3px); }

        .tour-hero__inner > * {
            opacity: 0;
            transform: translateY(24px);
            filter: blur(6px);
            animation: heroIn 1.05s var(--ease-out) forwards;
        }
        .tour-hero__inner > *:nth-child(1) { animation-delay: 0.1s; }
        .tour-hero__inner > *:nth-child(2) { animation-delay: 0.24s; }
        .tour-hero__inner > *:nth-child(3) { animation-delay: 0.38s; }
        .tour-hero__inner > *:nth-child(4) { animation-delay: 0.52s; }
        .tour-hero__inner > *:nth-child(5) { animation-delay: 0.66s; }

        @@keyframes heroIn {
            to { opacity: 1; transform: none; filter: blur(0); }
        }

        /* ---------- Main layout ---------- */
        .tour-body {
            background: var(--ivory);
            padding: clamp(48px, 7vw, 88px) 0 clamp(64px, 9vw, 120px);
        }
        .tour-layout {
            display: grid;
            grid-template-columns: minmax(0, 1fr) 360px;
            gap: clamp(32px, 5vw, 72px);
            align-items: start;
        }
        .tour-main { min-width: 0; }

        /* Feature image */
        .tour-cover {
            position: relative;
            aspect-ratio: 16 / 9;
            margin-bottom: clamp(32px, 5vw, 56px);
            overflow: hidden;
            border-radius: var(--card-radius);
            background: var(--sand);
            box-shadow: 0 30px 60px -40px rgba(20, 39, 31, 0.45);
        }
        .tour-cover img,
        .tour-cover .media--fallback {
            display: block;
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        /* Article blocks */
        .tour-section {
            padding: clamp(28px, 4vw, 44px) 0;
            border-top: 1px solid var(--line);
        }
        .tour-section:first-of-type { border-top: 0; padding-top: 0; }
        .tour-section__head {
            display: flex;
            align-items: baseline;
            gap: 16px;
            margin-bottom: clamp(18px, 2.4vw, 26px);
        }
        .tour-section__num {
            font-family: var(--serif);
            font-style: italic;
            font-size: 0.95rem;
            letter-spacing: 0.06em;
            color: var(--sage);
        }
        .tour-section h2 {
            margin: 0;
            font-size: clamp(1.5rem, 2.4vw, 2rem);
            line-height: 1.1;
            letter-spacing: -0.02em;
        }
        .tour-section__prose {
            max-width: 68ch;
            color: var(--charcoal);
            font-size: 1rem;
            line-height: 1.85;
            white-space: pre-line;
        }
        .tour-section__prose p { margin: 0 0 1em; }
        .tour-section__prose p:last-child { margin-bottom: 0; }

        /* Tour info grid */
        .tour-info {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
            gap: 14px;
        }
        .tour-info__item {
            padding: clamp(16px, 2vw, 22px);
            border: 1px solid var(--line);
            border-radius: var(--card-radius-sm);
            background: var(--white);
        }
        .tour-info__item span {
            display: block;
            margin-bottom: 6px;
            font-size: 0.56rem;
            font-weight: 600;
            letter-spacing: 0.2em;
            text-transform: uppercase;
            color: var(--muted);
        }
        .tour-info__item strong {
            font-family: var(--serif);
            font-weight: 500;
            font-size: 1.15rem;
            line-height: 1.15;
            letter-spacing: -0.01em;
            color: var(--forest-deep);
        }

        /* Itinerary timeline */
        .itinerary {
            margin: 0;
            padding: 0;
            list-style: none;
            position: relative;
        }
        .itinerary::before {
            content: '';
            position: absolute;
            top: 12px;
            bottom: 12px;
            left: 23px;
            width: 1px;
            background: linear-gradient(180deg, var(--sage), var(--line));
        }
        .itinerary__item {
            position: relative;
            display: grid;
            grid-template-columns: 48px minmax(0, 1fr);
            gap: 20px;
            padding: 0 0 clamp(24px, 3.2vw, 32px);
        }
        .itinerary__item:last-child { padding-bottom: 0; }
        .itinerary__marker {
            position: relative;
            z-index: 1;
            display: grid;
            place-items: center;
            width: 48px;
            height: 48px;
            border-radius: 50%;
            background: var(--ivory);
            border: 1px solid var(--line);
            box-shadow: 0 0 0 6px var(--ivory);
        }
        .itinerary__marker span {
            font-family: var(--serif);
            font-style: italic;
            font-size: 0.92rem;
            color: var(--forest-deep);
            letter-spacing: 0.02em;
        }
        .itinerary__content {
            padding: clamp(16px, 2vw, 22px) clamp(18px, 2.2vw, 24px);
            border: 1px solid var(--line);
            border-radius: var(--card-radius-sm);
            background: var(--white);
            transition:
                border-color 0.35s var(--ease),
                box-shadow 0.4s var(--ease-out),
                transform 0.4s var(--ease-out);
        }
        .itinerary__item:hover .itinerary__content {
            border-color: rgba(83, 107, 80, 0.28);
            box-shadow: 0 22px 42px -30px rgba(20, 39, 31, 0.35);
            transform: translateY(-2px);
        }
        .itinerary__content h3 {
            margin: 0 0 8px;
            font-size: 1.06rem;
            letter-spacing: -0.01em;
            line-height: 1.3;
            color: var(--charcoal);
        }
        .itinerary__content p {
            margin: 0;
            color: var(--muted);
            font-size: 0.9rem;
            line-height: 1.65;
            white-space: pre-line;
        }
        .itinerary__overnight {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            margin-top: 12px;
            padding: 5px 11px;
            border-radius: 999px;
            background: var(--ivory);
            border: 1px solid var(--line);
            font-size: 0.56rem;
            font-weight: 600;
            letter-spacing: 0.16em;
            text-transform: uppercase;
            color: var(--moss);
        }
        .itinerary__overnight::before {
            content: '';
            width: 5px;
            height: 5px;
            border-radius: 50%;
            background: var(--sage);
        }

        /* Inclusions / Exclusions */
        .inc-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: clamp(16px, 2.4vw, 28px);
        }
        .inc-card {
            position: relative;
            padding: clamp(18px, 2.4vw, 26px);
            border: 1px solid var(--line);
            border-radius: var(--card-radius-sm);
            background: var(--white);
        }
        .inc-card__head {
            display: flex;
            align-items: center;
            gap: 12px;
            margin-bottom: 16px;
            padding-bottom: 14px;
            border-bottom: 1px solid var(--line);
        }
        .inc-card__icon {
            display: grid;
            place-items: center;
            width: 32px;
            height: 32px;
            border-radius: 50%;
            font-size: 0.9rem;
            flex: 0 0 auto;
        }
        .inc-card--yes .inc-card__icon {
            background: rgba(143, 168, 136, 0.22);
            color: var(--forest-deep);
        }
        .inc-card--no .inc-card__icon {
            background: rgba(196, 122, 102, 0.16);
            color: #8a4a3a;
        }
        .inc-card__head h3 {
            margin: 0;
            font-size: 1rem;
            letter-spacing: -0.005em;
        }
        .inc-list {
            margin: 0;
            padding: 0;
            list-style: none;
            display: flex;
            flex-direction: column;
            gap: 10px;
        }
        .inc-list li {
            position: relative;
            padding-left: 22px;
            color: var(--charcoal);
            font-size: 0.9rem;
            line-height: 1.55;
            white-space: pre-line;
        }
        .inc-card--yes .inc-list li::before {
            content: '\2713';
            position: absolute;
            left: 0;
            top: 0;
            color: var(--moss);
            font-weight: 700;
        }
        .inc-card--no .inc-list li::before {
            content: '\2715';
            position: absolute;
            left: 0;
            top: 0;
            color: #a25c4a;
            font-weight: 700;
        }

        /* Departures */
        .departure-list {
            display: flex;
            flex-direction: column;
            gap: 12px;
            margin: 0;
            padding: 0;
            list-style: none;
        }
        .departure {
            display: grid;
            grid-template-columns: 96px minmax(0, 1fr) auto;
            gap: clamp(16px, 2.4vw, 24px);
            align-items: center;
            padding: clamp(16px, 2.2vw, 20px);
            border: 1px solid var(--line);
            border-radius: var(--card-radius-sm);
            background: var(--white);
            transition:
                border-color 0.35s var(--ease),
                box-shadow 0.4s var(--ease-out),
                transform 0.4s var(--ease-out);
        }
        .departure:hover {
            border-color: rgba(83, 107, 80, 0.28);
            box-shadow: 0 22px 42px -30px rgba(20, 39, 31, 0.35);
            transform: translateY(-2px);
        }
        .departure__date {
            padding: 12px 10px;
            border-radius: 12px;
            background: var(--ivory);
            text-align: center;
            border: 1px solid var(--line);
        }
        .departure__date strong {
            display: block;
            font-family: var(--serif);
            font-weight: 500;
            font-size: 1.4rem;
            line-height: 1;
            color: var(--forest-deep);
        }
        .departure__date span {
            display: block;
            margin-top: 4px;
            font-size: 0.56rem;
            letter-spacing: 0.16em;
            text-transform: uppercase;
            color: var(--muted);
        }
        .departure__body h4 {
            margin: 0 0 4px;
            font-size: 0.98rem;
            letter-spacing: -0.005em;
            color: var(--charcoal);
        }
        .departure__body p {
            margin: 0;
            font-size: 0.82rem;
            color: var(--muted);
            line-height: 1.55;
        }
        .departure__seats {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            margin-top: 8px;
            font-size: 0.56rem;
            letter-spacing: 0.16em;
            text-transform: uppercase;
            color: var(--moss);
        }
        .departure__seats::before {
            content: '';
            width: 6px;
            height: 6px;
            border-radius: 50%;
            background: var(--sage);
        }
        .departure__cta {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            min-height: 40px;
            padding: 0 16px;
            border-radius: 10px;
            background: var(--forest);
            color: var(--ivory);
            font-family: var(--sans);
            font-size: 0.6rem;
            font-weight: 600;
            letter-spacing: 0.14em;
            text-transform: uppercase;
            text-decoration: none;
            white-space: nowrap;
            transition:
                transform 0.35s var(--ease-out),
                box-shadow 0.4s var(--ease-out),
                background 0.3s var(--ease);
        }
        .departure__cta::after {
            content: '\2192';
            font-size: 0.85rem;
        }
        .departure__cta:hover {
            background: var(--forest-deep);
            transform: translateY(-2px);
            box-shadow: 0 14px 26px -16px rgba(20, 39, 31, 0.55);
        }

        /* ---------- Booking rail ---------- */
        .tour-rail {
            position: sticky;
            top: calc(var(--header-h) + 24px);
            align-self: start;
        }
        .rail-card {
            overflow: hidden;
            border: 1px solid var(--line);
            border-radius: var(--card-radius);
            background: var(--white);
            box-shadow: 0 30px 60px -40px rgba(20, 39, 31, 0.4);
        }
        .rail-card__head {
            padding: clamp(20px, 2.6vw, 26px);
            background:
                radial-gradient(ellipse 80% 80% at 20% 10%, rgba(143, 168, 136, 0.22), transparent 60%),
                linear-gradient(140deg, var(--forest) 0%, #1d3629 55%, var(--moss) 140%);
            color: var(--ivory);
        }
        .rail-card__head span {
            display: block;
            font-size: 0.56rem;
            letter-spacing: 0.22em;
            text-transform: uppercase;
            color: rgba(248, 246, 240, 0.62);
            margin-bottom: 8px;
        }
        .rail-card__head strong {
            display: block;
            font-family: var(--serif);
            font-weight: 500;
            font-size: clamp(1.6rem, 2.6vw, 2rem);
            line-height: 1;
            letter-spacing: -0.02em;
        }
        .rail-card__head small {
            display: block;
            margin-top: 8px;
            font-size: 0.6rem;
            letter-spacing: 0.16em;
            text-transform: uppercase;
            color: rgba(248, 246, 240, 0.68);
        }
        .rail-card__body {
            display: flex;
            flex-direction: column;
            gap: 14px;
            padding: clamp(20px, 2.6vw, 26px);
        }
        .rail-row {
            display: flex;
            align-items: baseline;
            justify-content: space-between;
            gap: 12px;
            padding-bottom: 12px;
            border-bottom: 1px solid var(--line);
            font-size: 0.82rem;
            color: var(--muted);
        }
        .rail-row:last-of-type { border-bottom: 0; padding-bottom: 0; }
        .rail-row strong {
            color: var(--charcoal);
            font-weight: 600;
            font-size: 0.88rem;
            text-align: right;
        }
        .rail-card__foot {
            display: flex;
            flex-direction: column;
            gap: 10px;
            padding: 0 clamp(20px, 2.6vw, 26px) clamp(20px, 2.6vw, 26px);
        }
        .rail-card__note {
            margin: 0;
            font-size: 0.7rem;
            line-height: 1.55;
            color: var(--muted);
            text-align: center;
        }

        /* ---------- Empty states ---------- */
        .empty-note {
            padding: clamp(20px, 2.6vw, 28px);
            border: 1px dashed var(--line);
            border-radius: var(--card-radius-sm);
            background: var(--white);
            color: var(--muted);
            font-size: 0.9rem;
            line-height: 1.65;
            text-align: center;
        }
        .empty-note strong {
            display: block;
            margin-bottom: 6px;
            color: var(--charcoal);
            font-family: var(--serif);
            font-size: 1.05rem;
            letter-spacing: -0.01em;
        }

        /* ---------- Responsive ---------- */
        @@media (max-width: 1024px) {
            .tour-layout { grid-template-columns: 1fr; }
            .tour-rail {
                position: static;
                order: -1;
            }
            .inc-grid { grid-template-columns: 1fr; }
        }

        @@media (max-width: 760px) {
            .departure { grid-template-columns: 80px minmax(0, 1fr); }
            .departure__cta {
                grid-column: 1 / -1;
                justify-content: center;
            }
        }

        @@media (max-width: 600px) {
            .tour-hero { min-height: 0; }
            .itinerary { padding-left: 0; }
            .itinerary__item { grid-template-columns: 40px minmax(0, 1fr); gap: 14px; }
            .itinerary__marker { width: 40px; height: 40px; }
            .itinerary::before { left: 19px; }
            .departure { grid-template-columns: 1fr; text-align: left; }
            .departure__date { width: max-content; padding: 8px 14px; text-align: left; }
            .departure__date strong { font-size: 1.15rem; }
        }

        @@media (prefers-reduced-motion: reduce) {
            html { scroll-behavior: auto; }
            .tour-hero__inner > * {
                opacity: 1 !important;
                transform: none !important;
                filter: none !important;
                animation: none !important;
            }
            .reveal-pending {
                opacity: 1 !important;
                transform: none !important;
                filter: none !important;
                transition: none !important;
            }
            .btn,
            .itinerary__content,
            .departure,
            .departure__cta {
                transition: none !important;
            }
            .btn:hover,
            .itinerary__item:hover .itinerary__content,
            .departure:hover,
            .departure__cta:hover {
                transform: none !important;
            }
        }
    </style>
}

<!-- ==================== HERO ==================== -->
<header class="tour-hero">
    <div class="container tour-hero__inner">
        <a class="tour-hero__back" asp-controller="Tours" asp-action="Index">All packages</a>
        <p class="eyebrow eyebrow--light">@Model.DestinationName</p>
        <h1>@Model.Name</h1>
        <p class="tour-hero__lead">@Model.ShortDescription</p>
        <div class="tour-hero__meta">
            <span>@Model.DurationDays day(s)</span>
            <span>Adult from @FormatPrice(Model.PricePerAdult)</span>
            @if (Model.PricePerChild.HasValue)
            {
                <span>Child @FormatPrice(Model.PricePerChild)</span>
            }
        </div>
    </div>
</header>

<!-- ==================== BODY ==================== -->
<section class="tour-body">
    <div class="container">
        <div class="tour-layout">

            <!-- ============ MAIN COLUMN ============ -->
            <div class="tour-main">

                <!-- Feature image -->
                <div class="tour-cover" data-reveal>
                    @if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
                    {
                        <img src="@Model.ImageUrl"
                             alt="@Model.Name"
                             loading="eager" decoding="async"
                             onerror="this.onerror=null;this.outerHTML='&lt;div class=&quot;media--fallback&quot; aria-hidden=&quot;true&quot;&gt;&lt;span&gt;@Model.Name&lt;/span&gt;&lt;/div&gt;';" />
                    }
                    else
                    {
                        <div class="media--fallback" aria-hidden="true">
                            <span>@Model.Name</span>
                        </div>
                    }
                </div>

                <!-- About -->
                @if (!string.IsNullOrWhiteSpace(Model.Description))
                {
                    <section class="tour-section" data-reveal>
                        <div class="tour-section__head">
                            <span class="tour-section__num">01</span>
                            <h2>About this journey</h2>
                        </div>
                        <div class="tour-section__prose">@Model.Description</div>
                    </section>
                }

                <!-- Tour info -->
                <section class="tour-section" data-reveal>
                    <div class="tour-section__head">
                        <span class="tour-section__num">02</span>
                        <h2>Tour information</h2>
                    </div>
                    <div class="tour-info">
                        <div class="tour-info__item">
                            <span>Duration</span>
                            <strong>@Model.DurationDays day(s)</strong>
                        </div>
                        <div class="tour-info__item">
                            <span>Adult price</span>
                            <strong>@FormatPrice(Model.PricePerAdult)</strong>
                        </div>
                        <div class="tour-info__item">
                            <span>Child price</span>
                            <strong>@FormatPrice(Model.PricePerChild)</strong>
                        </div>
                        @if (departures.Any())
                        {
                            <div class="tour-info__item">
                                <span>Next departure</span>
                                <strong>@departures.First().DepartureDate.ToString("dd MMM yyyy")</strong>
                            </div>
                        }
                    </div>
                </section>

                <!-- Itinerary -->
                <section class="tour-section" data-reveal>
                    <div class="tour-section__head">
                        <span class="tour-section__num">03</span>
                        <h2>Tour itinerary</h2>
                    </div>

                    @if (itinerary.Any())
                    {
                        <ol class="itinerary">
                            @foreach (var day in itinerary)
                            {
                                <li class="itinerary__item">
                                    <div class="itinerary__marker">
                                        <span>@day.DayNumber.ToString("00")</span>
                                    </div>
                                    <div class="itinerary__content">
                                        <h3>Day @day.DayNumber — @day.Title</h3>
                                        <p>@day.Description</p>
                                        @if (!string.IsNullOrWhiteSpace(day.OvernightLocation))
                                        {
                                            <span class="itinerary__overnight">
                                                Overnight · @day.OvernightLocation
                                            </span>
                                        }
                                    </div>
                                </li>
                            }
                        </ol>
                    }
                    else
                    {
                        <div class="empty-note">
                            <strong>Itinerary coming soon</strong>
                            Our team is finalising the day-by-day plan. Reach out and we'll
                            share it as soon as it's ready.
                        </div>
                    }
                </section>

                <!-- Inclusions / Exclusions -->
                @if (hasInclusions || hasExclusions)
                {
                    <section class="tour-section" data-reveal>
                        <div class="tour-section__head">
                            <span class="tour-section__num">04</span>
                            <h2>What's included</h2>
                        </div>

                        <div class="inc-grid">
                            @if (hasInclusions)
                            {
                                <div class="inc-card inc-card--yes">
                                    <div class="inc-card__head">
                                        <span class="inc-card__icon" aria-hidden="true">✓</span>
                                        <h3>Included</h3>
                                    </div>
                                    <ul class="inc-list">
                                        @foreach (var line in Model.Inclusions
                                            .Split('\n', StringSplitOptions.RemoveEmptyEntries)
                                            .Select(l => l.Trim().TrimStart('-', '•', '*').Trim())
                                            .Where(l => !string.IsNullOrWhiteSpace(l)))
                                        {
                                            <li>@line</li>
                                        }
                                    </ul>
                                </div>
                            }
                            @if (hasExclusions)
                            {
                                <div class="inc-card inc-card--no">
                                    <div class="inc-card__head">
                                        <span class="inc-card__icon" aria-hidden="true">✕</span>
                                        <h3>Not included</h3>
                                    </div>
                                    <ul class="inc-list">
                                        @foreach (var line in Model.Exclusions
                                            .Split('\n', StringSplitOptions.RemoveEmptyEntries)
                                            .Select(l => l.Trim().TrimStart('-', '•', '*').Trim())
                                            .Where(l => !string.IsNullOrWhiteSpace(l)))
                                        {
                                            <li>@line</li>
                                        }
                                    </ul>
                                </div>
                            }
                        </div>
                    </section>
                }

                <!-- Departures -->
                <section class="tour-section" data-reveal>
                    <div class="tour-section__head">
                        <span class="tour-section__num">05</span>
                        <h2>Available departures</h2>
                    </div>

                    @if (departures.Any())
                    {
                        <ul class="departure-list">
                            @foreach (var departure in departures)
                            {
                                <li class="departure">
                                    <div class="departure__date">
                                        <strong>@departure.DepartureDate.ToString("dd")</strong>
                                        <span>@departure.DepartureDate.ToString("MMM yyyy")</span>
                                    </div>
                                    <div class="departure__body">
                                        <h4>Returns @departure.ReturnDate.ToString("dd MMM yyyy")</h4>
                                        <p>@departure.AvailableSeats seat(s) available</p>
                                        @if (departure.AvailableSeats > 0)
                                        {
                                            <span class="departure__seats">Open for booking</span>
                                        }
                                        else
                                        {
                                            <span class="departure__seats">Fully booked</span>
                                        }
                                    </div>
                                    <a class="departure__cta"
                                       asp-controller="Bookings"
                                       asp-action="Create"
                                       asp-route-serviceType="tour"
                                       asp-route-serviceId="@Model.Id"
                                       asp-route-departureId="@departure.Id">
                                        Book
                                    </a>
                                </li>
                            }
                        </ul>
                    }
                    else
                    {
                        <div class="empty-note">
                            <strong>No scheduled departures</strong>
                            Contact us for custom travel dates — we can shape this journey
                            around your calendar.
                        </div>
                    }
                </section>

            </div>

            <!-- ============ BOOKING RAIL ============ -->
            <aside class="tour-rail" aria-label="Booking summary">
                <div class="rail-card">
                    <div class="rail-card__head">
                        <span>From</span>
                        <strong>@FormatPrice(Model.PricePerAdult)</strong>
                        <small>per adult · @Model.DurationDays day(s)</small>
                    </div>
                    <div class="rail-card__body">
                        <div class="rail-row">
                            <span>Duration</span>
                            <strong>@Model.DurationDays day(s)</strong>
                        </div>
                        <div class="rail-row">
                            <span>Child price</span>
                            <strong>@FormatPrice(Model.PricePerChild)</strong>
                        </div>
                        <div class="rail-row">
                            <span>Departures</span>
                            <strong>@(departures.Any() ? $"{departures.Count} scheduled" : "On request")</strong>
                        </div>
                        <div class="rail-row">
                            <span>Destination</span>
                            <strong>@Model.DestinationName</strong>
                        </div>
                    </div>
                    <div class="rail-card__foot">
                        <a class="btn btn--block"
                           asp-controller="Bookings"
                           asp-action="Create"
                           asp-route-serviceType="tour"
                           asp-route-serviceId="@Model.Id">
                            Book this tour
                        </a>
                        <a class="btn btn--ghost-dark btn--block"
                           asp-controller="Tours"
                           asp-action="Index">
                            Back to tours
                        </a>
                        <p class="rail-card__note">
                            Prices are indicative and may change based on departure dates and
                            group size.
                        </p>
                    </div>
                </div>
            </aside>

        </div>
    </div>
</section>

@section Scripts {
    <script>
        (function () {
            'use strict';

            var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
            if (reduceMotion) return;

            var observer = new IntersectionObserver(function (entries) {
                entries.forEach(function (entry) {
                    if (!entry.isIntersecting) return;
                    entry.target.classList.add('is-revealed');
                    observer.unobserve(entry.target);
                });
            }, { threshold: 0.1, rootMargin: '0px 0px -60px 0px' });

            document.querySelectorAll('[data-reveal]').forEach(function (el) {
                el.classList.add('reveal-pending');
                observer.observe(el);
            });
        })();
    </script>
}