@model KarnelTravel.ViewModels.CustomerBookingDetailsViewModel
@using System.Linq

@{
    ViewData["Title"] = "Booking details";

    var booking = Model.Booking;

    var reference    = string.IsNullOrWhiteSpace(booking?.ReferenceNumber) ? "—" : booking.ReferenceNumber;
    var serviceName  = string.IsNullOrWhiteSpace(booking?.ServiceName)     ? "Booking details" : booking.ServiceName;
    var statusText   = string.IsNullOrWhiteSpace(booking?.Status)          ? "—" : booking.Status;
    var travelDate   = booking?.BookingDate.ToString("dd MMM yyyy");
    var returnDate   = booking?.ReturnDate?.ToString("dd MMM yyyy");
    var totalDisplay = booking?.EstimatedTotalPKR.HasValue == true
        ? booking.EstimatedTotalPKR.Value.ToString("N2")
        : null;

    var history    = Model.StatusHistory?.OrderBy(e => e.ChangedAt).ToList();
    var hasHistory = history is not null && history.Count > 0;

    var hasNotes  = !string.IsNullOrWhiteSpace(booking?.CustomerNotes);
    var hasTicket = Model.ActiveTicket is not null;
    var demoPayment = booking?.DemoPaymentTransactions?.OrderByDescending(x => x.CreatedAt).FirstOrDefault();
    var tripRequest = booking?.TripInquiry;
    var isCustomTrip = booking?.ServiceType == "Custom Trip" || tripRequest is not null;
}

@*
   SELF-CONTAINED — designed to work with any _Layout.cshtml.

   ✓ All styles are inline, so no dependency on @RenderSection("Styles").
   ✓ The copy button uses an inline <script>, so no dependency on @RenderSection("Scripts").
   ✓ The wrapper uses negative margins to span the full viewport even when the
     layout places @RenderBody() inside a centered container. If the parent is
     already viewport-width, those margins resolve to 0 and nothing changes.
   ✓ If a Windows scrollbar causes horizontal overflow from the breakout, the
     script at the bottom hides only the horizontal scrollbar — content stays
     fully visible.
   ✓ The main body is a <div>, not a <main>, so it's safe if your layout already
     renders its own <main> element.
*@

<style>
    .krn-booking {
        --forest: #14271F;
        --forest-soft: #1E3A2C;
        --ivory: #F8F6F0;
        --sage: #8FA888;
        --sand: #E8DFC9;
        --white: #FFFFFF;
        --ink-60: rgba(20, 39, 31, .62);
        --ink-40: rgba(20, 39, 31, .42);
        --hairline: rgba(20, 39, 31, .12);

        /* Full-bleed breakout from any centered layout container */
        margin-left: calc(50% - 50vw);
        margin-right: calc(50% - 50vw);

        background: var(--ivory);
        color: var(--forest);
        font-family: "Inter", system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
        -webkit-font-smoothing: antialiased;
        text-rendering: optimizeLegibility;
    }

    .krn-booking *,
    .krn-booking *::before,
    .krn-booking *::after { box-sizing: border-box; }

    .bk-shell {
        width: 100%;
        max-width: 880px;
        margin: 0 auto;
        padding: 0 clamp(1.15rem, 4.5vw, 2.5rem);
    }

    .bk-sr {
        position: absolute;
        width: 1px; height: 1px;
        padding: 0; margin: -1px;
        overflow: hidden;
        clip: rect(0 0 0 0);
        white-space: nowrap;
        border: 0;
    }

    .krn-booking a:focus-visible,
    .krn-booking button:focus-visible {
        outline: 2px solid var(--sage);
        outline-offset: 3px;
    }

    /* ---------- Hero ---------- */

    .bk-hero {
        position: relative;
        overflow: hidden;
        background: linear-gradient(160deg, #1B3628 0%, #14271F 50%, #0E1D16 100%);
        color: var(--ivory);
        text-align: center;
    }

    .bk-hero__glow {
        position: absolute;
        top: -300px;
        left: 50%;
        transform: translateX(-50%);
        width: 720px;
        height: 720px;
        border-radius: 50%;
        background: radial-gradient(circle, rgba(143, 168, 136, .28) 0%, rgba(143, 168, 136, 0) 66%);
        pointer-events: none;
    }

    .bk-hero__inner {
        position: relative;
        z-index: 1;
        padding-top: clamp(1.85rem, 4.5vw, 3rem);
        padding-bottom: clamp(2.5rem, 6vw, 4.25rem);
    }

    /* Back to dashboard */
    .bk-hero__top {
        display: flex;
        justify-content: center;
        margin-bottom: clamp(1.5rem, 3.5vw, 2.15rem);
    }

    .bk-back {
        display: inline-flex;
        align-items: center;
        gap: .5rem;
        padding: .55rem 1.05rem;
        border-radius: 999px;
        border: 1px solid rgba(232, 223, 201, .24);
        background: rgba(255, 255, 255, .04);
        color: var(--sand);
        font-size: .68rem;
        font-weight: 500;
        letter-spacing: .14em;
        text-transform: uppercase;
        text-decoration: none;
        transition: background .28s ease, color .28s ease,
                    border-color .28s ease, transform .28s ease;
    }

    .bk-back:hover {
        background: var(--sand);
        border-color: var(--sand);
        color: var(--forest);
        text-decoration: none;
        transform: translateY(-1px);
    }

    .bk-back svg {
        width: 13px;
        height: 13px;
        display: block;
        transition: transform .28s ease;
    }

    .bk-back:hover svg { transform: translateX(-3px); }

    .bk-eyebrow {
        margin: 0 0 1.25rem;
        font-size: .68rem;
        font-weight: 500;
        letter-spacing: .34em;
        text-transform: uppercase;
        color: var(--sage);
    }

    .bk-title {
        margin: 0 auto;
        font-family: "Playfair Display", Georgia, "Times New Roman", serif;
        font-weight: 600;
        font-size: clamp(2rem, 5.4vw, 3.6rem);
        line-height: 1.1;
        letter-spacing: -.015em;
        color: #FBF9F3;
        max-width: 20ch;
        overflow-wrap: break-word;
    }

    .bk-hero__divider {
        width: 44px;
        height: 1px;
        margin: clamp(1.35rem, 3vw, 1.85rem) auto;
        background: linear-gradient(90deg, transparent, var(--sage), transparent);
    }

    .bk-hero__meta {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        align-items: center;
        gap: .75rem;
    }

    .bk-ref {
        display: inline-flex;
        align-items: center;
        gap: .7rem;
        padding: .45rem .5rem .45rem 1.05rem;
        border-radius: 999px;
        border: 1px solid rgba(232, 223, 201, .26);
        background: rgba(255, 255, 255, .05);
        transition: border-color .3s ease, background .3s ease;
    }

    .bk-ref:hover {
        border-color: rgba(232, 223, 201, .5);
        background: rgba(255, 255, 255, .08);
    }

    .bk-ref__label {
        font-size: .62rem;
        letter-spacing: .22em;
        text-transform: uppercase;
        color: rgba(232, 223, 201, .72);
    }

    .bk-ref__value {
        font-size: .92rem;
        font-weight: 500;
        letter-spacing: .1em;
        font-variant-numeric: tabular-nums;
        color: #FBF9F3;
    }

    .bk-copy {
        display: inline-flex;
        align-items: center;
        gap: .4rem;
        padding: .4rem .8rem;
        border-radius: 999px;
        border: 1px solid rgba(232, 223, 201, .3);
        background: transparent;
        color: var(--sand);
        font: inherit;
        font-size: .68rem;
        font-weight: 500;
        letter-spacing: .1em;
        text-transform: uppercase;
        cursor: pointer;
        transition: background .25s ease, color .25s ease, border-color .25s ease;
    }

    .bk-copy:hover {
        background: var(--sand);
        border-color: var(--sand);
        color: var(--forest);
    }

    .bk-copy.is-copied {
        background: var(--sage);
        border-color: var(--sage);
        color: #0E1D16;
    }

    .bk-copy svg { width: 13px; height: 13px; display: block; }

    .bk-status {
        display: inline-flex;
        align-items: center;
        gap: .55rem;
        padding: .6rem 1.15rem;
        border-radius: 999px;
        background: rgba(143, 168, 136, .14);
        border: 1px solid rgba(143, 168, 136, .38);
        color: #DDE9D8;
        font-size: .72rem;
        font-weight: 500;
        letter-spacing: .16em;
        text-transform: uppercase;
    }

    .bk-status__dot {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: var(--sage);
        animation: bkPulse 2.8s ease-out infinite;
    }

    @@keyframes bkPulse {
        0%   { box-shadow: 0 0 0 0 rgba(143, 168, 136, .55); }
        70%  { box-shadow: 0 0 0 10px rgba(143, 168, 136, 0); }
        100% { box-shadow: 0 0 0 0 rgba(143, 168, 136, 0); }
    }

    /* ---------- Main ---------- */

    .bk-main {
        padding-top: clamp(2.25rem, 5.5vw, 3.75rem);
        padding-bottom: clamp(2.75rem, 6.5vw, 4.5rem);
    }

    .bk-section {
        padding-bottom: clamp(2rem, 4.5vw, 3rem);
        margin-bottom: clamp(2rem, 4.5vw, 3rem);
        border-bottom: 1px solid var(--hairline);
    }

    .bk-section:last-child {
        padding-bottom: 0;
        margin-bottom: 0;
        border-bottom: 0;
    }

    .bk-h2 {
        position: relative;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 1rem;
        margin: 0 0 clamp(1.5rem, 3.5vw, 2rem);
        font-family: "Playfair Display", Georgia, "Times New Roman", serif;
        font-weight: 600;
        font-size: clamp(1.15rem, 2.4vw, 1.5rem);
        letter-spacing: .01em;
        color: var(--forest);
        text-align: center;
    }

    .bk-h2::before,
    .bk-h2::after {
        content: "";
        flex: 1 1 0;
        height: 1px;
        background: linear-gradient(90deg, transparent, var(--hairline));
    }

    .bk-h2::after {
        background: linear-gradient(90deg, var(--hairline), transparent);
    }

    .bk-h2__count {
        flex: none;
        order: 1;
        font-family: "Inter", system-ui, sans-serif;
        font-size: .62rem;
        font-weight: 500;
        letter-spacing: .18em;
        text-transform: uppercase;
        color: var(--ink-60);
    }

    /* ---------- Facts ---------- */

    .bk-facts {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 1.75rem 3rem;
        margin: 0 auto;
        max-width: 640px;
        text-align: center;
    }

    .bk-fact {
        padding-top: 1rem;
        border-top: 1px solid var(--hairline);
        transition: border-color .35s ease;
        min-width: 0;
    }

    .bk-fact:hover { border-top-color: var(--sage); }

    .bk-fact__label {
        margin: 0;
        font-size: .64rem;
        font-weight: 500;
        letter-spacing: .2em;
        text-transform: uppercase;
        color: var(--ink-60);
    }

    .bk-fact__value {
        margin: .6rem 0 0;
        font-size: 1.02rem;
        font-weight: 500;
        letter-spacing: .01em;
        color: var(--forest);
        overflow-wrap: break-word;
    }

    .bk-fact--total {
        grid-column: 1 / -1;
        border-top-color: rgba(143, 168, 136, .55);
        padding-top: 1.35rem;
        margin-top: .35rem;
    }

    .bk-fact--total .bk-fact__value {
        font-family: "Playfair Display", Georgia, serif;
        font-size: clamp(1.5rem, 3.6vw, 2rem);
        font-weight: 600;
        line-height: 1.15;
        font-variant-numeric: tabular-nums;
    }

    .bk-unit {
        margin-left: .5rem;
        font-family: "Inter", system-ui, sans-serif;
        font-size: .68rem;
        font-weight: 500;
        letter-spacing: .18em;
        text-transform: uppercase;
        color: var(--ink-60);
        vertical-align: middle;
    }

    @@media (max-width: 560px) {
        .bk-facts { grid-template-columns: minmax(0, 1fr); gap: 1.4rem; }
        .bk-fact--total { margin-top: 0; }
    }

    /* ---------- Timeline ---------- */

    .bk-timeline {
        position: relative;
        margin: 0 auto;
        padding: 0;
        max-width: 520px;
        list-style: none;
    }

    .bk-timeline::before {
        content: "";
        position: absolute;
        left: 50%;
        top: 8px;
        bottom: 8px;
        width: 1px;
        transform: translateX(-50%);
        background: linear-gradient(180deg, var(--sage) 0%, rgba(143, 168, 136, .1) 100%);
    }

    .bk-tl-item {
        position: relative;
        text-align: center;
        padding: 0 0 1.85rem;
        min-height: 60px;
    }

    .bk-tl-item:last-child { padding-bottom: 0; }

    .bk-tl-item::before {
        content: "";
        position: absolute;
        left: 50%;
        top: 4px;
        width: 15px;
        height: 15px;
        border-radius: 50%;
        background: var(--ivory);
        border: 1px solid var(--sage);
        box-shadow: 0 0 0 4px var(--ivory);
        transform: translateX(-50%);
        z-index: 1;
    }

    .bk-tl-item.is-latest::before {
        background: var(--forest);
        border-color: var(--forest);
    }

    .bk-tl-body {
        display: inline-block;
        margin-top: 1.7rem;
    }

    .bk-tl-status {
        display: block;
        font-size: 1rem;
        font-weight: 500;
        color: var(--forest);
        overflow-wrap: break-word;
    }

    .bk-tl-time {
        display: block;
        margin-top: .3rem;
        font-size: .78rem;
        letter-spacing: .05em;
        color: var(--ink-60);
        font-variant-numeric: tabular-nums;
    }

    /* ---------- Notes ---------- */

    .bk-notes {
        margin: 0 auto;
        max-width: 620px;
        padding: 1.5rem 1.75rem;
        background: var(--white);
        border: 1px solid rgba(20, 39, 31, .06);
        border-radius: 16px;
        font-size: 1rem;
        line-height: 1.85;
        color: #22352C;
        white-space: pre-line;
        text-align: center;
        overflow-wrap: break-word;
        box-shadow: 0 14px 30px -26px rgba(20, 39, 31, .55);
        position: relative;
    }

    .bk-notes::before {
        content: "";
        position: absolute;
        top: 0;
        left: 50%;
        transform: translateX(-50%);
        width: 42px;
        height: 2px;
        background: var(--sage);
        border-radius: 2px;
    }

    /* ---------- Empty ---------- */

    .bk-empty {
        margin: 0 auto;
        max-width: 560px;
        padding: 1.35rem 1.5rem;
        border: 1px dashed rgba(20, 39, 31, .18);
        border-radius: 14px;
        background: rgba(255, 255, 255, .55);
        font-size: .9rem;
        color: var(--ink-60);
        text-align: center;
    }

    /* ---------- Ticket ---------- */

    .bk-ticket-wrap {
        display: flex;
        justify-content: center;
    }

    .bk-ticket {
        position: relative;
        overflow: hidden;
        width: 100%;
        max-width: 460px;
        padding: 2rem 1.85rem 1.75rem;
        border-radius: 22px;
        background: linear-gradient(160deg, #1C3829 0%, #14271F 60%, #10211A 100%);
        color: var(--ivory);
        text-align: center;
        box-shadow: 0 34px 60px -34px rgba(20, 39, 31, .9);
        transition: transform .4s cubic-bezier(.22, .68, .32, 1), box-shadow .4s ease;
    }

    .bk-ticket:hover {
        transform: translateY(-3px);
        box-shadow: 0 40px 70px -32px rgba(20, 39, 31, .95);
    }

    .bk-ticket__label {
        margin: 0;
        font-size: .62rem;
        font-weight: 500;
        letter-spacing: .3em;
        text-transform: uppercase;
        color: var(--sage);
    }

    .bk-ticket__service {
        margin: 1rem 0 .4rem;
        font-family: "Playfair Display", Georgia, serif;
        font-size: clamp(1.3rem, 3vw, 1.55rem);
        font-weight: 600;
        line-height: 1.25;
        color: #FBF9F3;
        overflow-wrap: break-word;
    }

    .bk-ticket__ref {
        margin: 0;
        font-size: .78rem;
        letter-spacing: .18em;
        color: rgba(232, 223, 201, .78);
        font-variant-numeric: tabular-nums;
    }

    .bk-ticket__perf {
        position: relative;
        height: 1px;
        margin: 1.75rem -1.85rem;
        background: repeating-linear-gradient(90deg,
            rgba(232, 223, 201, .42) 0 8px,
            transparent 8px 16px);
    }

    .bk-ticket__perf::before,
    .bk-ticket__perf::after {
        content: "";
        position: absolute;
        top: 50%;
        width: 18px;
        height: 18px;
        border-radius: 50%;
        background: var(--ivory);
        transform: translateY(-50%);
    }

    .bk-ticket__perf::before { left: -9px; }
    .bk-ticket__perf::after  { right: -9px; }

    .bk-ticket__cta {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: .7rem;
        padding: .95rem 1.15rem;
        border-radius: 12px;
        background: var(--sand);
        color: var(--forest);
        font-size: .84rem;
        font-weight: 600;
        letter-spacing: .06em;
        text-transform: uppercase;
        text-decoration: none;
        transition: background .3s ease, transform .3s ease, box-shadow .3s ease;
    }

    .bk-ticket__cta:hover {
        background: #F2EAD6;
        color: var(--forest);
        text-decoration: none;
        transform: translateY(-1px);
        box-shadow: 0 16px 26px -16px rgba(0, 0, 0, .7);
    }

    .bk-ticket__cta svg {
        flex: none;
        width: 15px;
        height: 15px;
        transition: transform .3s ease;
    }

    .bk-ticket__cta:hover svg { transform: translateX(4px); }

    /* ---------- Motion ---------- */

    @@keyframes bkRise {
        from { opacity: 0; transform: translateY(18px); }
        to   { opacity: 1; transform: translateY(0); }
    }

    .bk-anim { animation: bkRise .8s cubic-bezier(.22, .68, .32, 1) both; }

    @@media (prefers-reduced-motion: reduce) {
        .krn-booking *,
        .krn-booking *::before,
        .krn-booking *::after {
            animation: none !important;
            transition: none !important;
        }
    }

    /* ---------- Print ---------- */

    @@media print {
        .krn-booking { background: #fff; margin-left: 0; margin-right: 0; }
        .bk-hero { background: #fff; color: #14271F; }
        .bk-hero__glow,
        .bk-copy,
        .bk-back,
        .bk-hero__top,
        .bk-status__dot { display: none !important; }
        .bk-title,
        .bk-ref__value,
        .bk-ref__label,
        .bk-status,
        .bk-ticket__service,
        .bk-ticket__ref,
        .bk-ticket__label { color: #14271F !important; }
        .bk-status { border-color: #8FA888; background: transparent; }
        .bk-ticket { background: #fff; color: #14271F; box-shadow: none; border: 1px solid #E8DFC9; }
        .bk-ticket__cta { background: #F8F6F0; }
        .bk-ticket__perf::before,
        .bk-ticket__perf::after { background: #fff; }
        .bk-anim { animation: none !important; }
    }
</style>

<div class="krn-booking">

    <!-- ===== Hero ===== -->
    <header class="bk-hero">
        <div class="bk-hero__glow" aria-hidden="true"></div>

        <div class="bk-shell bk-hero__inner">

            <!-- Back to dashboard -->
            <div class="bk-hero__top">
                <a class="bk-back"
                   asp-controller="Customer" asp-action="Index"
                   aria-label="Back to my travel dashboard">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                         stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M19 12H5"></path>
                        <path d="m12 19-7-7 7-7"></path>
                    </svg>
                    <span>Back to dashboard</span>
                </a>
            </div>

            <p class="bk-eyebrow">Booking details</p>
            <h1 class="bk-title">@serviceName</h1>

            <div class="bk-hero__divider" aria-hidden="true"></div>

            <div class="bk-hero__meta">
                <div class="bk-ref">
                    <span class="bk-ref__label">Reference</span>
                    <span class="bk-ref__value">@reference</span>
                    <button type="button"
                            class="bk-copy"
                            id="copyRef"
                            data-ref="@booking?.ReferenceNumber"
                            aria-label="Copy booking reference @reference">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
                             stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <rect x="9" y="9" width="11" height="11" rx="2"></rect>
                            <path d="M5 15V6a2 2 0 0 1 2-2h9"></path>
                        </svg>
                        <span class="bk-copy__text">Copy</span>
                    </button>
                </div>

                <span class="bk-status">
                    <span class="bk-status__dot" aria-hidden="true"></span>
                    @statusText
                </span>
            </div>

            <p class="bk-sr" role="status" aria-live="polite" id="copyStatus"></p>
        </div>
    </header>

    <!-- ===== Main (div, not <main> — avoids nesting if layout has its own) ===== -->
    <div class="bk-shell bk-main">

        <!-- Booking information -->
        <section class="bk-section bk-anim" style="animation-delay:.05s" aria-labelledby="bkInfoHeading">
            <h2 class="bk-h2" id="bkInfoHeading">Booking information</h2>

            <dl class="bk-facts">
                <div class="bk-fact">
                    <dt class="bk-fact__label">Travel date</dt>
                    <dd class="bk-fact__value">@travelDate</dd>
                </div>

                @if (returnDate is not null)
                {
                    <div class="bk-fact">
                        <dt class="bk-fact__label">Return date</dt>
                        <dd class="bk-fact__value">@returnDate</dd>
                    </div>
                }

                <div class="bk-fact">
                    <dt class="bk-fact__label">Adults</dt>
                    <dd class="bk-fact__value">@booking?.Adults</dd>
                </div>

                <div class="bk-fact">
                    <dt class="bk-fact__label">Children</dt>
                    <dd class="bk-fact__value">@booking?.Children</dd>
                </div>

                <div class="bk-fact">
                    <dt class="bk-fact__label">Rooms</dt>
                    <dd class="bk-fact__value">@booking?.Rooms</dd>
                </div>

                <div class="bk-fact bk-fact--total">
                    <dt class="bk-fact__label">Estimated total</dt>
                    <dd class="bk-fact__value">
                        @if (totalDisplay is not null)
                        {
                            <text>@totalDisplay<span class="bk-unit">PKR</span></text>
                        }
                        else
                        {
                            <text>Not available</text>
                        }
                    </dd>
                </div>
            </dl>
        </section>

        @if (isCustomTrip)
        {
            <section class="bk-section bk-anim" style="animation-delay:.07s" aria-labelledby="tripRequestHeading">
                <h2 class="bk-h2" id="tripRequestHeading">Original trip request</h2>
                <dl class="bk-facts">
                    <div class="bk-fact"><dt class="bk-fact__label">Destination</dt><dd class="bk-fact__value">@(tripRequest?.Destinations ?? booking?.ServiceName)</dd></div>
                    @if (!string.IsNullOrWhiteSpace(tripRequest?.StartingCity) || !string.IsNullOrWhiteSpace(booking?.StartingCity))
                    {
                        <div class="bk-fact"><dt class="bk-fact__label">Starting city</dt><dd class="bk-fact__value">@(tripRequest?.StartingCity ?? booking?.StartingCity)</dd></div>
                    }
                    <div class="bk-fact"><dt class="bk-fact__label">Requested services</dt><dd class="bk-fact__value">@(tripRequest?.ServiceNeeds ?? booking?.ServiceNeeds)</dd></div>
                    @if (tripRequest?.BudgetPKR is not null || booking?.EstimatedTotalPKR is not null)
                    {
                        <div class="bk-fact"><dt class="bk-fact__label">Requested budget</dt><dd class="bk-fact__value">@((tripRequest?.BudgetPKR ?? booking?.EstimatedTotalPKR)?.ToString("N2")) PKR</dd></div>
                    }
                </dl>
                @if (!string.IsNullOrWhiteSpace(booking?.AdminNotes))
                {
                    <h3 class="bk-h2" style="font-size:1.2rem;margin-top:1.5rem">Approved management plan</h3>
                    <div class="bk-notes">@booking.AdminNotes</div>
                }
            </section>
        }

        <section class="bk-section bk-anim" style="animation-delay:.08s" aria-labelledby="paymentHeading">
            <h2 class="bk-h2" id="paymentHeading">Payment and approval</h2>
            <dl class="bk-facts">
                <div class="bk-fact"><dt class="bk-fact__label">Payment status</dt><dd class="bk-fact__value">@(demoPayment?.PaymentStatus is "Successful" or "Paid (Demo)" ? "Paid" : demoPayment?.PaymentStatus ?? "Not paid")</dd></div>
                <div class="bk-fact"><dt class="bk-fact__label">Booking approval</dt><dd class="bk-fact__value">@statusText</dd></div>
                @if (demoPayment is not null)
                {
                    <div class="bk-fact"><dt class="bk-fact__label">Demo transaction</dt><dd class="bk-fact__value">@demoPayment.TransactionReference</dd></div>
                    <div class="bk-fact"><dt class="bk-fact__label">Amount</dt><dd class="bk-fact__value">@demoPayment.Currency @demoPayment.Amount.ToString("N2")</dd></div>
                    <div class="bk-fact"><dt class="bk-fact__label">Refund status</dt><dd class="bk-fact__value">@demoPayment.RefundStatus</dd></div>
                }
            </dl>
            @if (booking is not null && demoPayment?.PaymentStatus != "Paid (Demo)" && (booking.Status == "Pending" || booking.Status == "Pending Admin Approval"))
            {
                <a class="bk-ticket__cta" asp-controller="DemoPayment" asp-action="Checkout" asp-route-id="@booking.Id">Open demo payment</a>
            }
            @if (demoPayment?.PaymentStatus == "Failed (Demo)" && booking is not null)
            {
                <a class="bk-ticket__cta" asp-controller="DemoPayment" asp-action="Checkout" asp-route-id="@booking.Id">Retry demo payment</a>
            }
        </section>

        <!-- Status timeline -->
        <section class="bk-section bk-anim" style="animation-delay:.12s" aria-labelledby="bkTimelineHeading">
            <h2 class="bk-h2" id="bkTimelineHeading">
                Status timeline
                @if (hasHistory)
                {
                    <span class="bk-h2__count">@history.Count updates</span>
                }
            </h2>

            @if (hasHistory)
            {
                <ol class="bk-timeline">
                    @for (var i = 0; i < history.Count; i++)
                    {
                        var entry = history[i];
                        var itemClass = i == history.Count - 1 ? "bk-tl-item is-latest" : "bk-tl-item";

                        <li class="@itemClass">
                            <div class="bk-tl-body">
                                <span class="bk-tl-status">@entry.NewStatus</span>
                                <time class="bk-tl-time" datetime="@entry.ChangedAt.ToString("s")">
                                    @entry.ChangedAt.ToString("dd MMM yyyy · HH:mm")
                                </time>
                            </div>
                        </li>
                    }
                </ol>
            }
            else
            {
                <p class="bk-empty">No status updates have been recorded yet.</p>
            }
        </section>

        <!-- Customer notes -->
        <section class="bk-section bk-anim" style="animation-delay:.19s" aria-labelledby="bkNotesHeading">
            <h2 class="bk-h2" id="bkNotesHeading">Your notes</h2>

            @if (hasNotes)
            {
                <p class="bk-notes">@booking.CustomerNotes</p>
            }
            else
            {
                <p class="bk-empty">No notes were added to this booking.</p>
            }
        </section>

        <!-- Digital ticket -->
        @if (hasTicket)
        {
            <section class="bk-section bk-anim" style="animation-delay:.26s" aria-labelledby="bkTicketHeading">
                <h2 class="bk-h2" id="bkTicketHeading">Digital ticket</h2>

                <div class="bk-ticket-wrap">
                    <div class="bk-ticket">
                        <p class="bk-ticket__label">Present at check-in</p>
                        <p class="bk-ticket__service">@serviceName</p>
                        <p class="bk-ticket__ref">@reference</p>

                        <div class="bk-ticket__perf" aria-hidden="true"></div>

                        <a class="bk-ticket__cta"
                           asp-controller="Ticket"
                           asp-action="Details"
                           asp-route-id="@Model.ActiveTicket.Id">
                            <span>Open QR ticket</span>
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                                 stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <path d="M5 12h14"></path>
                                <path d="m13 6 6 6-6 6"></path>
                            </svg>
                        </a>
                        <a class="bk-ticket__cta" asp-controller="Ticket" asp-action="Download" asp-route-id="@Model.ActiveTicket.Id">
                            <span>Download PDF ticket</span>
                        </a>
                    </div>
                </div>
            </section>
        }

    </div>
</div>

<script>
    (function () {
        // ---- Copy booking reference ----
        var btn = document.getElementById('copyRef');
        var status = document.getElementById('copyStatus');
        if (btn && status) {
            var text = btn.getAttribute('data-ref') || '';
            var label = btn.querySelector('.bk-copy__text');
            var originalLabel = label ? label.textContent : 'Copy';
            var resetTimer = null;

            function announce(message) { status.textContent = message; }

            function flashCopied() {
                btn.classList.add('is-copied');
                if (label) { label.textContent = 'Copied'; }
                announce('Booking reference copied to clipboard.');
                if (resetTimer) { window.clearTimeout(resetTimer); }
                resetTimer = window.setTimeout(function () {
                    btn.classList.remove('is-copied');
                    if (label) { label.textContent = originalLabel; }
                }, 2000);
            }

            function fallbackCopy() {
                var ta = document.createElement('textarea');
                ta.value = text;
                ta.setAttribute('readonly', '');
                ta.style.position = 'fixed';
                ta.style.top = '-1000px';
                document.body.appendChild(ta);
                ta.select();
                try { document.execCommand('copy'); } catch (e) { /* no-op */ }
                document.body.removeChild(ta);
            }

            btn.addEventListener('click', function () {
                if (!text) { return; }
                if (navigator.clipboard && window.isSecureContext) {
                    navigator.clipboard.writeText(text)
                        .then(flashCopied)
                        .catch(function () { fallbackCopy(); flashCopied(); });
                } else {
                    fallbackCopy();
                    flashCopied();
                }
            });
        }

        // ---- Full-bleed safeguard ----
        // The negative-margin breakout (margin-left/right: calc(50% - 50vw))
        // can add a few pixels of horizontal overflow on Windows because 100vw
        // includes the scrollbar width. Hide only the horizontal scrollbar —
        // content stays fully visible and nothing gets clipped.
        function fixBleedOverflow() {
            if (document.documentElement.scrollWidth > document.documentElement.clientWidth) {
                document.documentElement.style.overflowX = 'hidden';
                document.body.style.overflowX = 'hidden';
            }
        }
        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', fixBleedOverflow);
        } else {
            fixBleedOverflow();
        }
    })();
</script>