@model KarnelTravel.ViewModels.CustomerDashboardViewModel
@{
    ViewData["Title"] = "My travel dashboard";

    var firstName = Model.Customer?.FullName;
    var hasName = !string.IsNullOrWhiteSpace(firstName);

    // Extract first name only for the greeting, if available
    var displayName = hasName ? firstName.Split(' ')[0] : "Traveller";

    // Explicit slugs — avoids "Total bookings" → "total bookings" (space breaks the class)
    var stats = new[]
    {
        new { Label = "Total bookings", Value = Model.TotalBookings,       Slug = "total",     Icon = "M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" },
        new { Label = "Pending",        Value = Model.PendingBookings,     Slug = "pending",   Icon = "M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" },
        new { Label = "Awaiting approval", Value = Model.PendingApprovalBookings, Slug = "approval", Icon = "M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" },
        new { Label = "Confirmed",      Value = Model.ConfirmedBookings,   Slug = "confirmed", Icon = "M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" },
        new { Label = "Completed",      Value = Model.CompletedBookings,   Slug = "completed", Icon = "M5 13l4 4L19 7" },
        new { Label = "Cancelled",      Value = Model.CancelledBookings,   Slug = "cancelled", Icon = "M6 18L18 6M6 6l12 12" }
    };

    var hasRecentBookings = Model.RecentBookings is not null && Model.RecentBookings.Count > 0;
    var hasTripInquiries = Model.TripInquiries is not null && Model.TripInquiries.Count > 0;

    var today = DateTime.Now.ToString("dddd, d MMMM yyyy");
}

<style>
    :root {
        /* Core Palette */
        --krn-forest: #0F1F17;
        --krn-forest-light: #1B3329;
        --krn-ivory: #F8F6F0;
        --krn-sage: #8FA888;
        --krn-sand: #E8DFC9;
        --krn-white: #FFFFFF;
        /* Text & UI Tones */
        --krn-text-main: #14271F;
        --krn-text-muted: #69766D;
        --krn-line: rgba(20, 39, 31, 0.12);
        --krn-line-strong: rgba(20, 39, 31, 0.22);
        /* Semantic Colors */
        --krn-warn: #C98A2E;
        --krn-success: #3D7A4F;
        --krn-danger: #B23B2E;
        /* Shadows */
        --krn-shadow-sm: 0 1px 2px rgba(20, 39, 31, 0.04);
        --krn-shadow-md: 0 8px 24px -12px rgba(20, 39, 31, 0.15);
        --krn-shadow-lg: 0 16px 40px -20px rgba(20, 39, 31, 0.25);
    }

    .krn-dash {
        background: var(--krn-ivory);
        color: var(--krn-text-main);
        font-family: "Inter", system-ui, -apple-system, sans-serif;
        -webkit-font-smoothing: antialiased;
        min-height: 100vh;
        padding-bottom: 4rem;
    }

        .krn-dash *, .krn-dash *::before, .krn-dash *::after {
            box-sizing: border-box;
        }

    .kd-shell {
        width: 100%;
        max-width: 1120px;
        margin: 0 auto;
        padding: 0 clamp(1.25rem, 5vw, 2.5rem);
    }

    .kd-sr {
        position: absolute;
        width: 1px;
        height: 1px;
        padding: 0;
        margin: -1px;
        overflow: hidden;
        clip: rect(0 0 0 0);
        white-space: nowrap;
        border: 0;
    }

    .krn-dash a:focus-visible, .krn-dash button:focus-visible {
        outline: 2px solid var(--krn-sage);
        outline-offset: 3px;
    }

    /* ============================================================
           HERO SECTION
           ============================================================ */
    .kd-hero {
        position: relative;
        overflow: hidden;
        background: var(--krn-forest);
        background-image: radial-gradient(120% 120% at 90% -10%, rgba(143, 168, 136, 0.22) 0%, transparent 60%), linear-gradient(155deg, #182F24 0%, #0F1F17 100%);
        color: var(--krn-ivory);
        border-bottom: 1px solid rgba(255,255,255,0.08);
    }

    .kd-hero__inner {
        position: relative;
        z-index: 1;
        padding-top: clamp(3rem, 7vw, 5rem);
        padding-bottom: clamp(3rem, 7vw, 5rem);
        display: flex;
        flex-direction: column;
        align-items: flex-start;
    }

    @@media (min-width: 860px) {
        .kd-hero__inner {
            flex-direction: row;
            align-items: flex-end;
            justify-content: space-between;
        }
    }

    .kd-hero__text-block {
        max-width: 600px;
    }

    .kd-eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        margin: 0 0 1.25rem;
        font-size: 0.7rem;
        font-weight: 600;
        letter-spacing: 0.25em;
        text-transform: uppercase;
        color: var(--krn-sage);
    }

        .kd-eyebrow::before {
            content: '';
            display: block;
            width: 24px;
            height: 1px;
            background: var(--krn-sage);
        }

    .kd-title {
        margin: 0;
        font-family: "Fraunces", "Playfair Display", Georgia, serif;
        font-weight: 400;
        font-size: clamp(2rem, 4.5vw, 3rem);
        line-height: 1.1;
        letter-spacing: -0.02em;
        color: var(--krn-white);
        text-wrap: balance;
    }

        .kd-title em {
            font-style: italic;
            color: var(--krn-sage);
        }

    .kd-sub {
        margin: 1.25rem 0 0;
        max-width: 48ch;
        font-size: 1rem;
        line-height: 1.65;
        color: rgba(248, 246, 240, 0.7);
    }

    .kd-hero__actions {
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem;
        margin-top: 2rem;
    }

    /* Hero Action Pills */
    .kd-pill {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.6rem;
        padding: 0.75rem 1.25rem;
        border-radius: 999px;
        border: 1px solid rgba(232, 223, 201, 0.25);
        background: rgba(255, 255, 255, 0.04);
        color: var(--krn-sand);
        font-size: 0.75rem;
        font-weight: 600;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        text-decoration: none;
        transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    }

        .kd-pill:hover {
            background: rgba(255, 255, 255, 0.12);
            border-color: rgba(255, 255, 255, 0.4);
            color: var(--krn-white);
            transform: translateY(-2px);
        }

    .kd-pill--accent {
        background: var(--krn-sage);
        border-color: var(--krn-sage);
        color: var(--krn-forest);
    }

        .kd-pill--accent:hover {
            background: #A6BFA0;
            border-color: #A6BFA0;
            color: var(--krn-forest);
            box-shadow: 0 8px 20px -8px rgba(143, 168, 136, 0.5);
        }

    .kd-pill svg {
        width: 15px;
        height: 15px;
        flex-shrink: 0;
    }

    /* Date Widget */
    .kd-date-widget {
        margin-top: 2.5rem;
        padding: 1rem 1.5rem;
        border-radius: 16px;
        background: rgba(0, 0, 0, 0.2);
        border: 1px solid rgba(255, 255, 255, 0.06);
        backdrop-filter: blur(8px);
    }

    @@media (min-width: 860px) {
        .kd-date-widget {
            margin-top: 0;
        }
    }

    .kd-date-widget__label {
        display: block;
        font-size: 0.65rem;
        font-weight: 600;
        letter-spacing: 0.2em;
        text-transform: uppercase;
        color: var(--krn-sage);
        margin-bottom: 0.35rem;
    }

    .kd-date-widget__value {
        display: block;
        font-family: "Fraunces", Georgia, serif;
        font-size: 1.15rem;
        color: var(--krn-white);
    }

    /* ============================================================
           STATS SECTION
           ============================================================ */
    .kd-stats-wrap {
        position: relative;
        z-index: 2;
        margin-top: -2rem; /* Pull up over the hero border */
    }

    .kd-stats {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 1rem;
        margin: 0;
        padding: 0;
        list-style: none;
    }

    @@media (min-width: 640px) {
        .kd-stats {
            grid-template-columns: repeat(3, 1fr);
        }
    }

    @@media (min-width: 980px) {
        .kd-stats {
            grid-template-columns: repeat(6, 1fr);
        }
    }

    .kd-stat {
        background: var(--krn-white);
        border: 1px solid var(--krn-line);
        border-radius: 16px;
        padding: 1.5rem 1.25rem;
        box-shadow: var(--krn-shadow-sm);
        transition: transform 0.3s ease, box-shadow 0.3s ease, border-color 0.3s ease;
        display: flex;
        flex-direction: column;
        position: relative;
        overflow: hidden;
    }

        .kd-stat:hover {
            transform: translateY(-3px);
            box-shadow: var(--krn-shadow-md);
            border-color: var(--krn-line-strong);
        }

    /* Stat Icon */
    .kd-stat__icon {
        position: absolute;
        top: 1.25rem;
        right: 1.25rem;
        width: 18px;
        height: 18px;
        color: var(--krn-line-strong);
        transition: color 0.3s ease;
    }

    .kd-stat:hover .kd-stat__icon {
        color: var(--krn-sage);
    }

    .kd-stat__value {
        font-family: "Fraunces", "Playfair Display", Georgia, serif;
        font-weight: 500;
        font-size: clamp(1.75rem, 3vw, 2.25rem);
        line-height: 1;
        color: var(--krn-forest);
        margin-bottom: 0.75rem;
    }

    .kd-stat__label {
        font-size: 0.68rem;
        font-weight: 600;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--krn-text-muted);
        line-height: 1.4;
        margin-top: auto;
    }

    /* Color overrides for specific stats */
    .kd-stat--pending .kd-stat__value {
        color: var(--krn-warn);
    }

    .kd-stat--confirmed .kd-stat__value {
        color: var(--krn-success);
    }

    .kd-stat--cancelled .kd-stat__value {
        color: var(--krn-danger);
    }

    /* Highlight total stat */
    .kd-stat--total {
        background: linear-gradient(135deg, var(--krn-forest) 0%, var(--krn-forest-light) 100%);
        border-color: var(--krn-forest);
    }

        .kd-stat--total .kd-stat__value {
            color: var(--krn-white);
        }

        .kd-stat--total .kd-stat__label {
            color: rgba(255,255,255,0.6);
        }

        .kd-stat--total .kd-stat__icon {
            color: rgba(255,255,255,0.2);
        }

        .kd-stat--total:hover .kd-stat__icon {
            color: var(--krn-sage);
        }

    /* ============================================================
           MAIN CONTENT
           ============================================================ */
    .kd-main {
        padding-top: clamp(2.5rem, 5vw, 4rem);
    }

    .kd-section {
        margin-bottom: 4rem;
    }

        .kd-section:last-child {
            margin-bottom: 0;
        }

    .kd-h2 {
        display: flex;
        align-items: center;
        gap: 1rem;
        margin: 0 0 2rem;
        font-family: "Fraunces", Georgia, serif;
        font-weight: 500;
        font-size: clamp(1.35rem, 2.5vw, 1.75rem);
        color: var(--krn-forest);
    }

    .kd-h2__line {
        flex: 1;
        height: 1px;
        background: var(--krn-line);
    }

    .kd-h2__count {
        font-family: "Inter", sans-serif;
        font-size: 0.7rem;
        font-weight: 600;
        letter-spacing: 0.15em;
        text-transform: uppercase;
        color: var(--krn-sage);
        background: rgba(143, 168, 136, 0.12);
        padding: 0.35rem 0.75rem;
        border-radius: 999px;
    }

    /* ============================================================
           BOOKINGS LIST (Timeline Style)
           ============================================================ */
    .kd-bookings {
        display: flex;
        flex-direction: column;
        gap: 1rem;
        margin: 0;
        padding: 0;
        list-style: none;
    }

    .kd-booking {
        position: relative;
    }

    .kd-booking__link {
        display: grid;
        grid-template-columns: 1fr auto;
        align-items: center;
        gap: 1.5rem;
        padding: 1.5rem;
        border-radius: 16px;
        background: var(--krn-white);
        border: 1px solid var(--krn-line);
        text-decoration: none;
        color: var(--krn-text-main);
        box-shadow: var(--krn-shadow-sm);
        transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    }

    @@media (min-width: 768px) {
        .kd-booking__link {
            grid-template-columns: minmax(0, 2fr) minmax(0, 1fr) auto;
        }
    }

    .kd-booking__link:hover {
        transform: translateY(-2px);
        box-shadow: var(--krn-shadow-md);
        border-color: rgba(20, 39, 31, 0.2);
        text-decoration: none;
    }

    /* Left: Main Info */
    .kd-booking__body {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }

    .kd-booking__title {
        margin: 0;
        font-family: "Fraunces", Georgia, serif;
        font-size: 1.25rem;
        font-weight: 500;
        line-height: 1.25;
        color: var(--krn-forest);
    }

    .kd-booking__meta {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 1rem;
        font-size: 0.85rem;
        color: var(--krn-text-muted);
    }

        .kd-booking__meta span {
            display: inline-flex;
            align-items: center;
            gap: 0.4rem;
        }

        .kd-booking__meta svg {
            width: 14px;
            height: 14px;
            opacity: 0.6;
        }

    /* Middle: Status Pill */
    .kd-booking__status-wrap {
        display: flex;
        align-items: center;
    }

    @@media (min-width: 768px) {
        .kd-booking__status-wrap {
            justify-content: center;
        }
    }

    .kd-booking__status {
        display: inline-flex;
        align-items: center;
        padding: 0.4rem 0.8rem;
        border-radius: 999px;
        font-size: 0.7rem;
        font-weight: 600;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        background: rgba(232, 223, 201, 0.4);
        color: var(--krn-forest);
    }

    /* Right: Actions / QR */
    .kd-booking__actions {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: 1rem;
    }

    .kd-booking__ticket {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.5rem 1rem;
        border-radius: 8px;
        background: rgba(143, 168, 136, 0.15);
        color: var(--krn-forest);
        font-size: 0.8rem;
        font-weight: 600;
        text-decoration: none;
        transition: background 0.2s ease;
        border: 1px solid rgba(143, 168, 136, 0.3);
    }

        .kd-booking__ticket:hover {
            background: var(--krn-sage);
            color: var(--krn-white);
            text-decoration: none;
        }

    .kd-booking__arrow {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 32px;
        height: 32px;
        border-radius: 50%;
        background: var(--krn-ivory);
        border: 1px solid var(--krn-line);
        color: var(--krn-forest);
        transition: all 0.3s ease;
    }

        .kd-booking__arrow svg {
            width: 16px;
            height: 16px;
        }

    .kd-booking__link:hover .kd-booking__arrow {
        background: var(--krn-forest);
        border-color: var(--krn-forest);
        color: var(--krn-white);
        transform: translateX(4px);
    }

    /* Mobile Restructuring for Booking Row */
    @@media (max-width: 767px) {
        .kd-booking__link {
            grid-template-columns: 1fr auto;
            grid-template-areas:
                "body arrow"
                "status actions";
            gap: 1rem;
            padding: 1.25rem;
        }

        .kd-booking__body {
            grid-area: body;
        }

        .kd-booking__arrow {
            grid-area: arrow;
        }

        .kd-booking__status-wrap {
            grid-area: status;
            justify-content: flex-start;
        }

        .kd-booking__actions {
            grid-area: actions;
        }
    }

    /* ============================================================
           EMPTY STATES (Rich)
           ============================================================ */
    .kd-empty {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        text-align: center;
        padding: 4rem 2rem;
        border-radius: 20px;
        background: var(--krn-white);
        border: 1px dashed var(--krn-line-strong);
    }

    .kd-empty__icon {
        width: 48px;
        height: 48px;
        margin-bottom: 1.25rem;
        color: var(--krn-sage);
        opacity: 0.6;
    }

    .kd-empty__title {
        margin: 0 0 0.5rem;
        font-family: "Fraunces", Georgia, serif;
        font-size: 1.25rem;
        color: var(--krn-forest);
    }

    .kd-empty__desc {
        margin: 0 0 1.5rem;
        font-size: 0.95rem;
        color: var(--krn-text-muted);
        max-width: 36ch;
        line-height: 1.6;
    }

    .kd-empty__btn {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.6rem 1.25rem;
        border-radius: 999px;
        background: var(--krn-forest);
        color: var(--krn-white);
        font-size: 0.75rem;
        font-weight: 600;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        text-decoration: none;
        transition: background 0.2s ease;
    }

        .kd-empty__btn:hover {
            background: var(--krn-forest-light);
            color: var(--krn-white);
            text-decoration: none;
        }

    /* ============================================================
           ANIMATIONS
           ============================================================ */
    @@keyframes kdRise {
        from {
            opacity: 0;
            transform: translateY(20px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .kd-anim {
        animation: kdRise 0.7s cubic-bezier(0.16, 1, 0.3, 1) both;
    }

    @@media (prefers-reduced-motion: reduce) {
        .krn-dash *, .krn-dash *::before, .krn-dash *::after {
            animation: none !important;
            transition: none !important;
        }
    }

    /* ============================================================
           PRINT
           ============================================================ */
    @@media print {
        .krn-dash {
            background: #fff;
        }

        .kd-hero {
            background: #fff;
            color: #000;
            border-bottom: 1px solid #ccc;
        }

        .kd-hero__actions, .kd-date-widget {
            display: none !important;
        }

        .kd-title {
            color: #000 !important;
        }

        .kd-sub {
            color: #333 !important;
        }

        .kd-stat {
            border: 1px solid #ccc;
            box-shadow: none;
        }

        .kd-booking__link {
            border: 1px solid #ccc;
            box-shadow: none;
        }

        .kd-anim {
            animation: none !important;
        }
    }
</style>

<div class="krn-dash">

    <!-- ===== Hero ===== -->
    <header class="kd-hero">
        <div class="kd-shell kd-hero__inner">

            <div class="kd-hero__text-block kd-anim">
                <p class="kd-eyebrow">Customer Portal</p>
                <h1 class="kd-title">
                    Welcome back, <em>@displayName</em>.
                </h1>
                <p class="kd-sub">Manage your reservations, access your tickets, and keep track of your upcoming journeys all in one place.</p>

                <div class="kd-hero__actions">
                    <a class="kd-pill kd-pill--accent" asp-controller="Customer" asp-action="Bookings">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <rect x="3" y="5" width="18" height="16" rx="2"></rect>
                            <path d="M3 10h18"></path>
                            <path d="M8 3v4"></path>
                            <path d="M16 3v4"></path>
                        </svg>
                        My Bookings
                    </a>
                    <a class="kd-pill" asp-controller="Customer" asp-action="Profile">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="12" cy="8" r="4"></circle>
                            <path d="M4 21a8 8 0 0 1 16 0"></path>
                        </svg>
                        My Profile
                    </a>
                </div>
            </div>

            <!-- Optional floating date widget -->
            <div class="kd-date-widget kd-anim" style="animation-delay: 0.1s">
                <span class="kd-date-widget__label">Today's Date</span>
                <span class="kd-date-widget__value">@today</span>
            </div>

        </div>
    </header>

    <!-- ===== Stats Cards ===== -->
    <div class="kd-shell kd-stats-wrap">
        <ul class="kd-stats" aria-label="Booking statistics">
            @foreach (var s in stats)
            {
                <li class="kd-stat kd-anim kd-stat--@s.Slug" style="animation-delay: 0.15s">
                    <svg class="kd-stat__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="@s.Icon"></path>
                    </svg>
                    <span class="kd-stat__value">@s.Value</span>
                    <span class="kd-stat__label">@s.Label</span>
                </li>
            }
        </ul>
    </div>

    <!-- ===== Main Content ===== -->
    <main class="kd-shell kd-main">

        <!-- Recent Bookings -->
        <section class="kd-section kd-anim" style="animation-delay: 0.2s" aria-labelledby="kdBookingsHeading">
            <h2 class="kd-h2" id="kdBookingsHeading">
                Recent Bookings
                <span class="kd-h2__line"></span>
                @if (hasRecentBookings)
                {
                    <span class="kd-h2__count">@Model.RecentBookings.Count recent</span>
                }
            </h2>

            @if (!hasRecentBookings)
            {
                <div class="kd-empty">
                    <svg class="kd-empty__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>
                        <polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline>
                        <line x1="12" y1="22.08" x2="12" y2="12"></line>
                    </svg>
                    <h3 class="kd-empty__title">No bookings yet</h3>
                    <p class="kd-empty__desc">You haven't made any bookings. Start exploring to find your next great journey.</p>
                    <a class="kd-empty__btn" asp-controller="Search" asp-action="Index">
                        Explore Travel Services
                    </a>
                </div>
            }
            else
            {
                <ul class="kd-bookings">
                    @foreach (var booking in Model.RecentBookings)
                    {
                        <li class="kd-booking">
                            <a class="kd-booking__link" asp-controller="Customer" asp-action="BookingDetails" asp-route-id="@booking.Id">

                                <div class="kd-booking__body">
                                    <p class="kd-booking__title">@booking.ServiceName</p>
                                    <div class="kd-booking__meta">
                                        <span>
                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16v16H4z"></path><path d="M4 12h16"></path></svg>
                                            @booking.ReferenceNumber
                                        </span>
                                        <span>
                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
                                            @booking.BookingDate.ToString("dd MMM yyyy")
                                        </span>
                                    </div>
                                </div>

                                <div class="kd-booking__status-wrap">
                                    <span class="kd-booking__status">@booking.Status</span>
                                </div>

                                <div class="kd-booking__actions">
                                    @if (Model.ActiveTickets.TryGetValue(booking.Id, out var ticket))
                                    {
                                        <span class="kd-booking__ticket">
                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:14px;height:14px;"><path d="M2 9a3 3 0 0 1 0 6v2a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-2a3 3 0 0 1 0-6V7a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2v2z"></path><line x1="13" y1="5" x2="13" y2="19"></line></svg>
                                            QR Ticket
                                        </span>
                                    }
                                    <span class="kd-booking__arrow" aria-hidden="true">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                            <path d="M5 12h14"></path>
                                            <path d="m13 6 6 6-6 6"></path>
                                        </svg>
                                    </span>
                                </div>

                                <span class="kd-sr">View booking details for @booking.ServiceName</span>
                            </a>
                        </li>
                    }
                </ul>
            }
        </section>

        <!-- Custom Trip Requests -->
        <section class="kd-section kd-anim" style="animation-delay: 0.3s" aria-labelledby="kdTripRequestsHeading">
            <h2 class="kd-h2" id="kdTripRequestsHeading">
                Custom Trip Requests
                <span class="kd-h2__line"></span>
                @if (hasTripInquiries)
                {
                    <span class="kd-h2__count">@Model.TripInquiries.Count active</span>
                }
            </h2>

            @if (!hasTripInquiries)
            {
                <div class="kd-empty">
                    <svg class="kd-empty__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="10"></circle>
                        <line x1="2" y1="12" x2="22" y2="12"></line>
                        <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
                    </svg>
                    <h3 class="kd-empty__title">No custom trips yet</h3>
                    <p class="kd-empty__desc">Have a specific destination in mind? Let our experts build a bespoke itinerary just for you.</p>
                    <a class="kd-empty__btn" asp-controller="TripRequests" asp-action="Create">
                        Plan a Custom Trip
                    </a>
                </div>
            }
            else
            {
                <ul class="kd-bookings">
                    @foreach (var inquiry in Model.TripInquiries)
                    {
                        <li class="kd-booking">
                            <a class="kd-booking__link" asp-controller="TripRequests" asp-action="Confirmation" asp-route-reference="@inquiry.ReferenceNumber">

                                <div class="kd-booking__body">
                                    <p class="kd-booking__title">@inquiry.Destinations</p>
                                    <div class="kd-booking__meta">
                                        <span>
                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16v16H4z"></path><path d="M4 12h16"></path></svg>
                                            @inquiry.ReferenceNumber
                                        </span>
                                        <span>
                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
                                            @inquiry.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")
                                        </span>
                                    </div>
                                </div>

                                <div class="kd-booking__status-wrap">
                                    <span class="kd-booking__status" style="background: rgba(143, 168, 136, 0.15); color: var(--krn-sage);">@inquiry.Status</span>
                                </div>

                                <div class="kd-booking__actions">
                                    <span class="kd-booking__arrow" aria-hidden="true">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                            <path d="M5 12h14"></path>
                                            <path d="m13 6 6 6-6 6"></path>
                                        </svg>
                                    </span>
                                </div>

                                <span class="kd-sr">View custom trip request @inquiry.ReferenceNumber</span>
                            </a>
                        </li>
                    }
                </ul>
            }
        </section>

    </main>
</div>