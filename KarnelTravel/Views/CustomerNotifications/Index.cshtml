@model IReadOnlyList<KarnelTravel.Models.CustomerNotification>
@{
    ViewData["Title"] = "Notifications";
    var unreadCount = Model.Count(x => !x.IsRead);
}

@section Styles {
    <style>
        .customer-page { max-width: 920px; margin: 0 auto; padding: 3rem 1.25rem 5rem; }
        .customer-page__header { display: flex; justify-content: space-between; gap: 1.5rem; align-items: end; margin-bottom: 2rem; }
        .customer-page__header h1 { margin: 0; }
        .customer-page__header p { margin: .5rem 0 0; color: #64746b; }
        .customer-page__actions { display: flex; gap: .75rem; flex-wrap: wrap; }
        .customer-page button, .customer-page a { font: inherit; }
        .customer-page button, .customer-page__back { display: inline-flex; align-items: center; justify-content: center; border: 0; border-radius: 999px; padding: .7rem 1rem; text-decoration: none; cursor: pointer; }
        .customer-page button { background: #14271f; color: #fff; }
        .customer-page button:disabled { opacity: .5; cursor: not-allowed; }
        .customer-page__back { background: #e8dfc9; color: #14271f; }
        .notification-list { display: grid; gap: 1rem; }
        .notification-card { border: 1px solid rgba(20,39,31,.14); border-radius: 16px; padding: 1.25rem; background: #fff; }
        .notification-card--unread { border-color: #8fa888; box-shadow: 0 8px 24px rgba(20,39,31,.08); }
        .notification-card__top { display: flex; justify-content: space-between; gap: 1rem; align-items: start; }
        .notification-card h2 { margin: 0; font-size: 1.05rem; }
        .notification-card__badge { color: #4e6e5a; font-size: .75rem; font-weight: 700; text-transform: uppercase; letter-spacing: .08em; }
        .notification-card p { margin: .75rem 0; color: #46564d; white-space: pre-line; }
        .notification-card time { color: #7a887f; font-size: .85rem; }
        .notification-card form { margin-top: 1rem; }
        .notification-empty { border: 1px dashed rgba(20,39,31,.2); border-radius: 16px; padding: 2rem; text-align: center; color: #64746b; }
        @@media (max-width: 620px) { .customer-page__header { display: block; } .customer-page__actions { margin-top: 1rem; } }
    </style>
}

<main class="customer-page">
    <header class="customer-page__header">
        <div>
            <h1>Notifications</h1>
            <p>@(unreadCount == 0 ? "You are all caught up." : $"You have {unreadCount} unread notification{(unreadCount == 1 ? "" : "s")}.")</p>
        </div>
        <div class="customer-page__actions">
            <a class="customer-page__back" asp-controller="Customer" asp-action="Dashboard">Back to dashboard</a>
            <form method="post" asp-action="ReadAll">
                @Html.AntiForgeryToken()
                <button type="submit" disabled="@(unreadCount == 0 ? "disabled" : null)">Mark all as read</button>
            </form>
        </div>
    </header>

    @if (Model.Count == 0)
    {
        <p class="notification-empty">You do not have any notifications yet.</p>
    }
    else
    {
        <section class="notification-list" aria-label="Your notifications">
            @foreach (var notification in Model)
            {
                <article class="notification-card @(notification.IsRead ? "" : "notification-card--unread")">
                    <div class="notification-card__top">
                        <h2>@notification.Title</h2>
                        @if (!notification.IsRead)
                        {
                            <span class="notification-card__badge">Unread</span>
                        }
                    </div>
                    <p>@notification.Message</p>
                    <time datetime="@notification.CreatedAt.ToString("s")">@notification.CreatedAt.ToString("dd MMM yyyy, HH:mm")</time>
                    @if (!notification.IsRead)
                    {
                        <form method="post" asp-action="Read" asp-route-id="@notification.Id">
                            @Html.AntiForgeryToken()
                            <button type="submit">Mark as read</button>
                        </form>
                    }
                </article>
            }
        </section>
    }
</main>
