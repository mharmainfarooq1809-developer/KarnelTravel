@model KarnelTravel.Models.TransportRoute
@using KarnelTravel.Models
@{
    Layout = "_Layout";
    ViewData["Title"] = Model.Name;
    var vehicles = ViewBag.Vehicles as List<TransportService> ?? new List<TransportService>();

    var hasDescription = !string.IsNullOrWhiteSpace(Model.Description);
    var hasReturnPrice = Model.ReturnPricePKR.HasValue;
    var hasDistance   = Model.EstimatedDistanceKm.HasValue;
    var hasDuration   = Model.EstimatedDurationMinutes.HasValue;
}

@functions {
    string VehicleMeta(TransportService v)
    {
        var parts = new System.Collections.Generic.List<string>();
        if (!string.IsNullOrWhiteSpace(v.VehicleType))
            parts.Add(v.VehicleType.Trim());

        if (v.PassengerCapacity.HasValue && v.PassengerCapacity.Value > 0)
            parts.Add($"{v.PassengerCapacity.Value} passengers");
        else
            parts.Add("Capacity on request");

        return string.Join(" · ", parts);
    }

    string VehicleIconKey(string type)
    {
        if (string.IsNullOrWhiteSpace(type)) return "car";
        var t = type.ToLowerInvariant();
        if (t.Contains("bus") || t.Contains("coach")) return "bus";
        if (t.Contains("van") || t.Contains("hiace") || t.Contains("minibus") || t.Contains("minivan")) return "van";
        return "car";
    }
}

<!-- ================= SVG SPRITE ================= -->
<svg class="svg-sprite" aria-hidden="true" focusable="false" width="0" height="0" style="position:absolute;overflow:hidden">
    <symbol id="i-car" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
        <path d="M4.5 16.5h15" />
        <path d="M6 16.5 7.2 9.3A2.3 2.3 0 0 1 9.5 7.3h5a2.3 2.3 0 0 1 2.3 2l1.2 7.2" />
        <circle cx="7.5" cy="17.5" r="1.5" />
        <circle cx="16.5" cy="17.5" r="1.5" />
    </symbol>
    <symbol id="i-van" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
        <path d="M3 17h18" />
        <path d="M4 17V11l3-3h7l3 3v6" />
        <path d="M4 11h13" />
        <circle cx="7" cy="17.5" r="1.5" />
        <circle cx="17" cy="17.5" r="1.5" />
    </symbol>
    <symbol id="i-bus" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
        <rect x="3" y="5" width="18" height="11" rx="2" />
        <path d="M3 11h18" />
        <circle cx="7.5" cy="17.5" r="1.5" />
        <circle cx="16.5" cy="17.5" r="1.5" />
    </symbol>
</svg>

<div class="route-page">
    <div class="route-container">

        <!-- ================= A. ROUTE HERO ================= -->
        <section class="hero">
            <nav class="bc" aria-label="Breadcrumb">
                <a href="@Url.Content("~/")">Home</a>
                <span class="bc-sep" aria-hidden="true">/</span>
                <a href="@Url.Action("Index", "Transport")">Transport</a>
                <span class="bc-sep" aria-hidden="true">/</span>
                <span aria-current="page">@Model.Name</span>
            </nav>

            <p class="eyebrow eyebrow-sage">Transport route</p>

            <h1 class="route-title">@Model.Name</h1>

            <div class="journey">
                <div class="city">
                    <span class="city-role">Origin</span>
                    <strong class="city-name">@Model.StartingCity</strong>
                </div>

                <div class="journey-path" aria-hidden="true">
                    <span class="jp-dot"></span>
                    <span class="jp-line"></span>
                    <svg class="jp-arrow" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M5 12h14" />
                        <path d="m13 6 6 6-6 6" />
                    </svg>
                    <span class="jp-line"></span>
                    <span class="jp-dot"></span>
                </div>

                <div class="city city-to">
                    <span class="city-role">Destination</span>
                    <strong class="city-name">@Model.DestinationCity</strong>
                </div>
            </div>

            @if (hasDescription)
            {
                <p class="hero-lead">@Model.Description</p>
            }
        </section>

        <!-- ================= B. JOURNEY INFORMATION STRIP ================= -->
        <section class="strip" aria-label="Journey information">
            <div class="strip-grid">
                @if (hasDistance)
                {
                    <div class="fact">
                        <span class="fact-label">Distance</span>
                        <span class="fact-value">
                            @(Model.EstimatedDistanceKm!.Value.ToString("N0"))
                            <small>km</small>
                        </span>
                    </div>
                }

                @if (hasDuration)
                {
                    <div class="fact">
                        <span class="fact-label">Duration</span>
                        <span class="fact-value">
                            @(Model.EstimatedDurationMinutes!.Value.ToString("N0"))
                            <small>min</small>
                        </span>
                    </div>
                }

                <div class="fact">
                    <span class="fact-label">Starting fare</span>
                    <span class="fact-value">
                        <small class="fact-currency">PKR</small>@Model.StartingPricePKR.ToString("N0")
                    </span>
                </div>

                @if (hasReturnPrice)
                {
                    <div class="fact">
                        <span class="fact-label">Return fare</span>
                        <span class="fact-value">
                            <small class="fact-currency">PKR</small>@Model.ReturnPricePKR!.Value.ToString("N0")
                        </span>
                    </div>
                }
            </div>
        </section>

        <!-- ================= C + D. PRICING & VEHICLES GRID ================= -->
        <div class="content-grid">

            <!-- C. Pricing -->
            <section class="pricing-card" aria-labelledby="pricing-title">
                <header class="card-head">
                    <p class="eyebrow">Fare</p>
                    <h2 id="pricing-title">Route pricing</h2>
                </header>

                <div class="price-display">
                    <span class="price-currency">PKR</span>
                    <span class="price-amount">@Model.StartingPricePKR.ToString("N0")</span>
                </div>
                <p class="price-sublabel">Starting price</p>

                @if (hasReturnPrice)
                {
                    <div class="return-fare">
                        <div>
                            <span class="return-label">Return fare</span>
                            <p class="return-note">For round-trip bookings on this route.</p>
                        </div>
                        <span class="return-amount">PKR @Model.ReturnPricePKR!.Value.ToString("N0")</span>
                    </div>
                }

                <p class="price-note">
                    This is a starting price. The final fare may vary depending on the vehicle selected and your specific travel requirements.
                </p>

                <a href="@Url.Action("Create", "Bookings", new { serviceType = "Transport", serviceId = Model.Id })" class="btn-book">
                    Book this route
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M5 12h14" />
                        <path d="m13 6 6 6-6 6" />
                    </svg>
                </a>
            </section>

            <!-- D. Available vehicles -->
            <section class="vehicles-card" aria-labelledby="vehicles-title">
                <header class="card-head">
                    <p class="eyebrow">Fleet</p>
                    <h2 id="vehicles-title">Available vehicles</h2>
                </header>

                @if (vehicles.Count == 0)
                {
                    <div class="vehicles-empty">
                        <span class="vehicles-empty-icon" aria-hidden="true">
                            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                                <use href="#i-car" />
                            </svg>
                        </span>
                        <p>No vehicles are currently listed for this route.</p>
                        <a href="@Url.Action("Index", "Contact")">Contact our team for assistance →</a>
                    </div>
                }
                else
                {
                    <ul class="vehicle-list">
                        @foreach (var vehicle in vehicles)
                        {
                            <li class="vehicle">
                                <span class="vehicle-icon" aria-hidden="true">
                                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                                        <use href="#i-@VehicleIconKey(vehicle.VehicleType)" />
                                    </svg>
                                </span>
                                <div class="vehicle-info">
                                    <strong class="vehicle-name">@vehicle.Name</strong>
                                    <span class="vehicle-meta">@VehicleMeta(vehicle)</span>
                                </div>
                            </li>
                        }
                    </ul>
                }
            </section>
        </div>

        <!-- ================= E. BOOKING CTA ================= -->
        <section class="cta-section" aria-labelledby="cta-title">
            <div class="cta-content">
                <p class="eyebrow eyebrow-sage">Continue</p>
                <h2 id="cta-title">Ready for the journey?</h2>
                <p>Continue to booking and share your travel requirements.</p>
            </div>
            <a href="@Url.Action("Create", "Bookings", new { serviceType = "Transport", serviceId = Model.Id })" class="btn-cta">
                Book This Route
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M5 12h14" />
                    <path d="m13 6 6 6-6 6" />
                </svg>
            </a>
        </section>

        <!-- ================= F. TRAVEL ASSISTANCE ================= -->
        <section class="help-section" aria-labelledby="help-title">
            <div class="help-content">
                <p class="eyebrow">Assistance</p>
                <h2 id="help-title">Need help choosing the right vehicle?</h2>
                <p>Our team can help you understand the route, select the best vehicle, or clarify any travel requirements.</p>
            </div>
            <a href="@Url.Action("Index", "Contact")" class="btn-help">
                Contact our team
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M5 12h14" />
                    <path d="m13 6 6 6-6 6" />
                </svg>
            </a>
        </section>

    </div>
</div>

<style>
    /* ============================================================
       KARNEL — TRANSPORT ROUTE DETAILS
       "The Journey Experience" — premium editorial travel page
       ============================================================ */

    .route-page {
        --forest: #14271F;
        --forest-2: #1B3428;
        --ivory: #F8F6F0;
        --sand: #E8DFC9;
        --sand-2: #F0E7D2;
        --sage: #8FA888;
        --white: #FFFFFF;
        --ink: #1B2922;
        --muted: #6B7A70;
        --line: rgba(20, 39, 31, .10);
        --line-strong: rgba(20, 39, 31, .16);
        --serif: 'DM Serif Display', 'Iowan Old Style', 'Palatino Linotype', Georgia, serif;
        --sans: 'DM Sans', system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        --radius: 16px;
        --radius-lg: 22px;
        --ease: cubic-bezier(.22, .72, .24, 1);
        --ease-out: cubic-bezier(.16, 1, .3, 1);
        --dur: .22s;

        background: var(--ivory);
        padding: 36px 0 80px;
        font-family: var(--sans);
        color: var(--ink);
        font-size: 15px;
        line-height: 1.6;
        -webkit-font-smoothing: antialiased;
        overflow-x: hidden;
    }

    .route-page *,
    .route-page *::before,
    .route-page *::after { box-sizing: border-box; }

    .route-page a { color: inherit; text-decoration: none; }
    .route-page a:hover { color: var(--forest); }
    .route-page :focus-visible {
        outline: 2px solid var(--sage);
        outline-offset: 3px;
        border-radius: 6px;
    }

    .route-container {
        max-width: 1120px;
        margin: 0 auto;
        padding: 0 24px;
    }

    /* ---------- Shared eyebrow ---------- */
    .route-page .eyebrow {
        margin: 0 0 10px;
        font-family: var(--sans);
        font-size: 11px;
        font-weight: 700;
        letter-spacing: .18em;
        text-transform: uppercase;
        color: var(--muted);
        line-height: 1.3;
    }
    .route-page .eyebrow-sage { color: var(--sage); }

    /* ============================================================
       HERO
       ============================================================ */
    .route-page .hero {
        position: relative;
        background: var(--forest);
        border-radius: var(--radius-lg);
        padding: 40px 44px 48px;
        overflow: hidden;
        isolation: isolate;
        color: var(--ivory);
        box-shadow: 0 30px 70px -40px rgba(20, 39, 31, .55);
    }

    .route-page .hero::before {
        content: "";
        position: absolute;
        inset: 0;
        background:
            radial-gradient(circle at 100% 0%, rgba(143, 168, 136, .22), transparent 55%),
            radial-gradient(circle at 0% 100%, rgba(232, 223, 201, .10), transparent 50%);
        pointer-events: none;
        z-index: -1;
    }

    .route-page .hero::after {
        content: "";
        position: absolute;
        inset: 0;
        background-image: radial-gradient(circle, rgba(232, 223, 201, .09) 1px, transparent 1px);
        background-size: 22px 22px;
        opacity: .55;
        pointer-events: none;
        z-index: -1;
        mask-image: radial-gradient(ellipse at 80% 20%, black 0%, transparent 70%);
        -webkit-mask-image: radial-gradient(ellipse at 80% 20%, black 0%, transparent 70%);
    }

    /* Breadcrumb */
    .route-page .bc {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 8px;
        font-size: 12px;
        color: rgba(248, 246, 240, .55);
        margin-bottom: 32px;
    }
    .route-page .bc a {
        color: rgba(248, 246, 240, .72);
        transition: color var(--dur) var(--ease);
    }
    .route-page .bc a:hover { color: var(--sand); }
    .route-page .bc-sep { opacity: .45; font-size: 11px; }
    .route-page .bc [aria-current="page"] {
        color: rgba(248, 246, 240, .92);
        font-weight: 500;
        max-width: 32ch;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    /* Title */
    .route-page .route-title {
        margin: 0;
        font-family: var(--serif);
        font-weight: 400;
        font-size: clamp(38px, 5.4vw, 64px);
        line-height: 1.03;
        letter-spacing: -.022em;
        color: var(--ivory);
        overflow-wrap: break-word;
        max-width: 22ch;
    }

    /* Journey: cities + path */
    .route-page .journey {
        display: grid;
        grid-template-columns: auto 1fr auto;
        align-items: center;
        gap: 28px;
        margin-top: 36px;
        padding-top: 28px;
        border-top: 1px solid rgba(232, 223, 201, .14);
    }

    .route-page .city { min-width: 0; }

    .route-page .city-role {
        display: block;
        margin-bottom: 6px;
        font-size: 10px;
        font-weight: 700;
        letter-spacing: .20em;
        text-transform: uppercase;
        color: var(--sage);
    }

    .route-page .city-name {
        display: block;
        font-family: var(--serif);
        font-weight: 400;
        font-size: clamp(24px, 3vw, 36px);
        line-height: 1.08;
        letter-spacing: -.01em;
        color: var(--ivory);
        overflow-wrap: break-word;
    }

    .route-page .city-to { text-align: right; }

    .route-page .journey-path {
        display: flex;
        align-items: center;
        gap: 8px;
        min-width: 0;
        color: var(--sand);
    }

    .route-page .jp-dot {
        width: 8px;
        height: 8px;
        flex-shrink: 0;
        border-radius: 50%;
        background: var(--sand);
        box-shadow: 0 0 0 4px rgba(232, 223, 201, .13);
    }

    .route-page .jp-line {
        flex: 1;
        height: 1px;
        min-width: 16px;
        background-image: linear-gradient(to right, var(--sand) 0%, var(--sand) 50%, transparent 50%, transparent 100%);
        background-size: 8px 1px;
        background-repeat: repeat-x;
        background-position: 0 0;
        opacity: .55;
        animation: jp-travel 1.6s linear infinite;
    }

    .route-page .jp-arrow { flex-shrink: 0; color: var(--sand); opacity: .9; }

    @@keyframes jp-travel {
        to { background-position: 8px 0; }
    }

    /* Hero lead */
    .route-page .hero-lead {
        margin: 32px 0 0;
        padding-top: 28px;
        border-top: 1px solid rgba(232, 223, 201, .14);
        font-size: 15.5px;
        line-height: 1.7;
        color: rgba(248, 246, 240, .82);
        max-width: 68ch;
    }

    /* Hero entrance */
    .route-page .hero .bc,
    .route-page .hero .eyebrow,
    .route-page .hero .route-title,
    .route-page .hero .journey,
    .route-page .hero .hero-lead {
        animation: heroIn .7s var(--ease-out) both;
    }
    .route-page .hero .route-title { animation-delay: .06s; }
    .route-page .hero .journey     { animation-delay: .12s; }
    .route-page .hero .hero-lead   { animation-delay: .18s; }

    @@keyframes heroIn {
        from { opacity: 0; transform: translateY(14px); }
        to   { opacity: 1; transform: translateY(0); }
    }

    /* ============================================================
       JOURNEY INFORMATION STRIP
       ============================================================ */
    .route-page .strip {
        margin-top: 22px;
        background: var(--white);
        border: 1px solid var(--line);
        border-radius: var(--radius);
        overflow: hidden;
    }

    .route-page .strip-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
        gap: 1px;
        background: var(--line);
    }

    .route-page .fact {
        padding: 20px 24px;
        background: var(--white);
        min-width: 0;
    }

    .route-page .fact-label {
        display: block;
        margin-bottom: 6px;
        font-size: 10.5px;
        font-weight: 700;
        letter-spacing: .16em;
        text-transform: uppercase;
        color: var(--muted);
    }

    .route-page .fact-value {
        display: flex;
        align-items: baseline;
        gap: 5px;
        font-family: var(--sans);
        font-size: 22px;
        font-weight: 600;
        line-height: 1.1;
        letter-spacing: -.01em;
        color: var(--forest);
        font-variant-numeric: tabular-nums;
        white-space: nowrap;
    }

    .route-page .fact-value small {
        font-size: 12px;
        font-weight: 600;
        color: var(--muted);
        letter-spacing: .02em;
    }

    .route-page .fact-value .fact-currency {
        font-size: 10.5px;
        font-weight: 700;
        letter-spacing: .12em;
        text-transform: uppercase;
        color: var(--muted);
    }

    /* ============================================================
       CONTENT GRID
       ============================================================ */
    .route-page .content-grid {
        display: grid;
        grid-template-columns: 1.15fr 1fr;
        gap: 22px;
        margin-top: 22px;
        align-items: start;
    }

    .route-page .pricing-card,
    .route-page .vehicles-card {
        background: var(--white);
        border: 1px solid var(--line);
        border-radius: var(--radius);
        padding: 30px 30px 32px;
    }

    .route-page .card-head { margin-bottom: 20px; }

    .route-page .card-head h2 {
        margin: 0;
        font-family: var(--serif);
        font-weight: 400;
        font-size: clamp(24px, 2.6vw, 30px);
        line-height: 1.15;
        letter-spacing: -.012em;
        color: var(--forest);
    }

    /* ---------- Pricing ---------- */
    .route-page .price-display {
        display: flex;
        align-items: baseline;
        gap: 10px;
        margin-top: 4px;
    }

    .route-page .price-currency {
        font-family: var(--sans);
        font-size: 13px;
        font-weight: 700;
        letter-spacing: .14em;
        text-transform: uppercase;
        color: var(--muted);
    }

    .route-page .price-amount {
        font-family: var(--serif);
        font-weight: 400;
        font-size: clamp(42px, 5vw, 60px);
        line-height: 1;
        letter-spacing: -.022em;
        color: var(--forest);
        font-variant-numeric: tabular-nums;
    }

    .route-page .price-sublabel {
        margin: 8px 0 0;
        font-size: 12px;
        font-weight: 600;
        letter-spacing: .06em;
        text-transform: uppercase;
        color: var(--sage);
    }

    .route-page .return-fare {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        margin-top: 24px;
        padding: 16px 18px;
        border-radius: 12px;
        background: rgba(143, 168, 136, .08);
        border: 1px solid rgba(143, 168, 136, .20);
    }

    .route-page .return-label {
        display: block;
        font-size: 12.5px;
        font-weight: 700;
        letter-spacing: .01em;
        color: var(--forest);
    }

    .route-page .return-note {
        margin: 2px 0 0;
        font-size: 11.5px;
        color: var(--muted);
        line-height: 1.4;
    }

    .route-page .return-amount {
        flex-shrink: 0;
        font-family: var(--sans);
        font-size: 16px;
        font-weight: 700;
        color: var(--forest);
        font-variant-numeric: tabular-nums;
        white-space: nowrap;
    }

    .route-page .price-note {
        margin: 24px 0 0;
        padding-top: 20px;
        border-top: 1px solid var(--line);
        font-size: 13px;
        line-height: 1.65;
        color: var(--muted);
    }

    .route-page .btn-book {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        margin-top: 24px;
        padding: 12px 20px;
        border-radius: 10px;
        background: var(--forest);
        color: var(--ivory);
        font-family: var(--sans);
        font-size: 13.5px;
        font-weight: 700;
        letter-spacing: .01em;
        transition: background var(--dur) var(--ease),
                    transform var(--dur) var(--ease),
                    box-shadow var(--dur) var(--ease);
    }

    .route-page .btn-book:hover {
        background: var(--forest-2);
        color: var(--ivory);
        transform: translateY(-1px);
        box-shadow: 0 12px 26px -12px rgba(20, 39, 31, .45);
    }

    .route-page .btn-book svg { transition: transform var(--dur) var(--ease); }
    .route-page .btn-book:hover svg { transform: translateX(3px); }

    /* ---------- Vehicles ---------- */
    .route-page .vehicle-list { list-style: none; margin: 0; padding: 0; }

    .route-page .vehicle {
        display: flex;
        align-items: center;
        gap: 14px;
        padding: 15px 0;
    }

    .route-page .vehicle + .vehicle { border-top: 1px solid var(--line); }

    .route-page .vehicle-icon {
        width: 42px;
        height: 42px;
        flex-shrink: 0;
        display: grid;
        place-items: center;
        border-radius: 11px;
        background: rgba(143, 168, 136, .12);
        color: var(--forest);
        transition: background var(--dur) var(--ease);
    }

    .route-page .vehicle:hover .vehicle-icon {
        background: rgba(143, 168, 136, .22);
    }

    .route-page .vehicle-info { min-width: 0; flex: 1; }

