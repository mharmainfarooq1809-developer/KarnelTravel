
@model KarnelTravel.Models.TransportService
@using KarnelTravel.Models

@{
    ViewData["Title"] = Model.Name;

    var reviews = ViewBag.Reviews as List<Review> ?? new List<Review>();
    double averageRating = ViewBag.AverageRating ?? 0;
    int totalReviews = ViewBag.TotalReviews ?? 0;

    var reviewUrl = Url.Action("Create", "Reviews", new
    {
        type = "TransportService",
        id = Model.Id
    });

    var bookingUrl = Url.Action("Create", "Bookings", new
    {
        serviceType = "Transport",
        serviceId = Model.Id
    });
}

<style>
    .transport-details-page {
        background: var(--ivory, #f6f4ed);
        padding: 45px 0 80px;
    }

    .transport-details-container {
        max-width: 1180px;
        margin: auto;
        padding: 0 22px;
    }

    .transport-breadcrumb {
        margin-bottom: 25px;
        color: var(--muted, #777);
        font-size: 13px;
    }

    .transport-breadcrumb a {
        color: inherit;
        text-decoration: none;
    }

    .transport-hero {
        position: relative;
        min-height: 430px;
        overflow: hidden;
        border-radius: 18px;
        background: #263c32;
        display: flex;
        align-items: flex-end;
    }

    .transport-hero img {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .transport-hero::after {
        content: "";
        position: absolute;
        inset: 0;
        background: linear-gradient(
            0deg,
            rgba(12, 29, 22, .9),
            rgba(12, 29, 22, .08)
        );
    }

    .transport-hero-content {
        position: relative;
        z-index: 2;
        padding: 42px;
        color: white;
        max-width: 760px;
    }

    .transport-hero-content h1 {
        color: white;
        font-size: clamp(34px, 5vw, 58px);
        line-height: 1.1;
        margin: 12px 0;
    }

    .transport-hero-content p {
        color: rgba(255,255,255,.85);
        line-height: 1.7;
    }

    .transport-layout {
        display: grid;
        grid-template-columns: minmax(0, 1fr) 330px;
        gap: 35px;
        margin-top: 38px;
        align-items: start;
    }

    .transport-panel {
        background: white;
        padding: 30px;
        border-radius: 14px;
        margin-bottom: 25px;
        border: 1px solid rgba(0,0,0,.06);
    }

    .transport-panel h2 {
        font-size: 25px;
        color: var(--forest-deep, #203d31);
        margin: 0 0 18px;
    }

    .transport-description {
        line-height: 1.9;
        color: #626a64;
        white-space: pre-line;
    }

    .transport-info-list {
        display: grid;
        gap: 18px;
    }

    .transport-info-item {
        display: flex;
        justify-content: space-between;
        gap: 15px;
        padding-bottom: 14px;
        border-bottom: 1px solid #e9ece7;
        font-size: 14px;
    }

    .transport-info-item span:first-child {
        color: #777;
    }

    .transport-info-item strong {
        text-align: right;
        color: #263d31;
    }

    .transport-route {
        background: #f4f6f1;
        border-radius: 10px;
        padding: 22px;
        display: grid;
        grid-template-columns: 1fr auto 1fr;
        align-items: center;
        gap: 15px;
        margin-top: 20px;
    }

    .transport-route small {
        display: block;
        color: #858b85;
        font-size: 11px;
        letter-spacing: .12em;
        text-transform: uppercase;
        margin-bottom: 7px;
    }

    .transport-route strong {
        color: #294333;
        font-size: 16px;
    }

    .transport-route-arrow {
        color: #8a9a89;
        font-size: 22px;
    }

    .transport-price {
        font-size: 29px;
        font-weight: 700;
        color: var(--forest-deep, #203d31);
        margin: 8px 0;
    }

    .transport-book-btn,
    .transport-review-btn {
        display: inline-block;
        width: 100%;
        text-align: center;
        padding: 15px 20px;
        border-radius: 7px;
        text-decoration: none;
        font-weight: 600;
        transition: .2s ease;
    }

    .transport-book-btn {
        background: var(--forest-deep, #203d31);
        color: white;
    }

    .transport-book-btn:hover {
        background: #345846;
        color: white;
    }

    .transport-review-btn {
        border: 1px solid #355b46;
        color: #355b46;
        margin-top: 12px;
    }

    .transport-review-btn:hover {
        background: #355b46;
        color: white;
    }

    .transport-rating-summary {
        display: flex;
        align-items: center;
        gap: 18px;
        padding: 20px;
        background: #f5f7f2;
        border-radius: 10px;
        margin-bottom: 25px;
    }

    .transport-rating-number {
        font-size: 38px;
        font-weight: 700;
        color: #284b38;
    }

    .transport-stars {
        color: #c3913e;
        letter-spacing: 2px;
        font-size: 17px;
    }

    .transport-review-card {
        padding: 22px 0;
        border-bottom: 1px solid #e8eae5;
    }

    .transport-review-card:last-child {
        border-bottom: 0;
    }

    .transport-review-card h3 {
        margin: 7px 0;
        color: #294333;
        font-size: 17px;
    }

    .transport-review-card p {
        color: #68716a;
        line-height: 1.8;
        margin: 8px 0 0;
    }

    .transport-review-meta {
        display: flex;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 8px;
        color: #858b85;
        font-size: 13px;
    }

    .transport-empty {
        color: #777;
        padding: 20px 0;
    }

    @@media (max-width: 800px) {
        .transport-layout {
            grid-template-columns: 1fr;
        }

        .transport-hero {
            min-height: 350px;
        }

        .transport-hero-content {
            padding: 25px;
        }

        .transport-panel {
            padding: 22px;
        }
    }

    @@media (max-width: 480px) {
        .transport-route {
            grid-template-columns: 1fr;
        }

        .transport-route-arrow {
            transform: rotate(90deg);
            width: fit-content;
        }
    }
</style>

<main class="transport-details-page">
    <div class="transport-details-container">

        <!-- BREADCRUMB -->
        <div class="transport-breadcrumb">
            <a asp-controller="Home" asp-action="Index">Home</a>
            /
            <a asp-controller="Transport" asp-action="Index">Transport</a>
            / @Model.Name
        </div>

        <!-- HERO -->
        <section class="transport-hero">

            @if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
            {
                <img src="@Model.ImageUrl" alt="@Model.Name" />
            }

            <div class="transport-hero-content">

                <span>
                    @(string.IsNullOrWhiteSpace(Model.VehicleType)
                        ? "TRANSPORT SERVICE"
                        : Model.VehicleType.ToUpperInvariant())
                </span>

                <h1>@Model.Name</h1>

                <p>
                    @(string.IsNullOrWhiteSpace(Model.Description)
                        ? "Explore this transport service for your journey."
                        : Model.Description)
                </p>

            </div>
        </section>

        <div class="transport-layout">

            <!-- MAIN CONTENT -->
            <div>

                <!-- ABOUT -->
                <section class="transport-panel">
                    <h2>About This Service</h2>

                    @if (!string.IsNullOrWhiteSpace(Model.Description))
                    {
                        <p class="transport-description">
                            @Model.Description
                        </p>
                    }
                    else
                    {
                        <p class="transport-empty">
                            More information about this transport service will be available soon.
                        </p>
                    }
                </section>

                <!-- ROUTE -->
                <section class="transport-panel">
                    <h2>Journey Route</h2>

                    <div class="transport-route">

                        <div>
                            <small>Departure</small>
                            <strong>
                                @(string.IsNullOrWhiteSpace(Model.StartingCity)
                                    ? "To be confirmed"
                                    : Model.StartingCity)
                            </strong>
                        </div>

                        <div class="transport-route-arrow">→</div>

                        <div>
                            <small>Destination</small>
                            <strong>
                                @(string.IsNullOrWhiteSpace(Model.DestinationCity)
                                    ? "To be confirmed"
                                    : Model.DestinationCity)
                            </strong>
                        </div>

                    </div>
                </section>

                <!-- TRANSPORT INFORMATION -->
                <section class="transport-panel">
                    <h2>Transport Information</h2>

                    <div class="transport-info-list">

                        <div class="transport-info-item">
                            <span>Service Name</span>
                            <strong>@Model.Name</strong>
                        </div>

                        <div class="transport-info-item">
                            <span>Vehicle Type</span>
                            <strong>
                                @(string.IsNullOrWhiteSpace(Model.VehicleType)
                                    ? "To be confirmed"
                                    : Model.VehicleType)
                            </strong>
                        </div>

                        <div class="transport-info-item">
                            <span>Passenger Capacity</span>
                            <strong>
                                @(Model.PassengerCapacity.HasValue
                                    ? Model.PassengerCapacity.Value + " passengers"
                                    : "To be confirmed")
                            </strong>
                        </div>

                        <div class="transport-info-item">
                            <span>Starting Price</span>
                            <strong>
                                @(Model.StartingPrice.HasValue
                                    ? "PKR " + Model.StartingPrice.Value.ToString("N0")
                                    : "On request")
                            </strong>
                        </div>

                        @if (!string.IsNullOrWhiteSpace(Model.ContactPhone))
                        {
                            <div class="transport-info-item">
                                <span>Contact</span>
                                <strong>@Model.ContactPhone</strong>
                            </div>
                        }

                    </div>
                </section>

                <!-- REVIEWS -->
                <section class="transport-panel" id="reviews">
                    <h2>Traveller Experiences</h2>

                    <div class="transport-rating-summary">

                        <div class="transport-rating-number">
                            @averageRating.ToString("0.0")
                        </div>

                        <div>
                            <div class="transport-stars">
                                @{
                                    var fullStars = (int)Math.Round(averageRating);
                                }

                                @for (int i = 1; i <= 5; i++)
                                {
                                    <span>@(i <= fullStars ? "★" : "☆")</span>
                                }
                            </div>

                            <div>
                                Based on @totalReviews review@(totalReviews == 1 ? "" : "s")
                            </div>
                        </div>

                    </div>

                    @if (reviews.Any())
                    {
                        @foreach (var review in reviews)
                        {
                            <article class="transport-review-card">

                                <div class="transport-review-meta">
                                    <strong>@review.ReviewerName</strong>
                                    <span>
                                        @review.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")
                                    </span>
                                </div>

                                <div class="transport-stars">
                                    @for (int i = 1; i <= 5; i++)
                                    {
                                        <span>@(i <= review.Rating ? "★" : "☆")</span>
                                    }
                                </div>

                                <h3>@review.Title</h3>

                                <p>@review.Comment</p>

                            </article>
                        }
                    }
                    else
                    {
                        <p class="transport-empty">
                            No approved reviews yet. Be the first to share your experience.
                        </p>
                    }

                    <a href="@reviewUrl" class="transport-review-btn">
                        Write a Review
                    </a>

                </section>

            </div>

            <!-- SIDEBAR -->
            <aside>

                <section class="transport-panel">
                    <h2>Plan Your Journey</h2>

                    @if (Model.StartingPrice.HasValue)
                    {
                        <div class="transport-price">
                            PKR @Model.StartingPrice.Value.ToString("N0")
                        </div>

                        <p class="muted">Starting price</p>
                    }
                    else
                    {
                        <p class="transport-empty">
                            Contact us for pricing information.
                        </p>
                    }

                    <a href="@bookingUrl" class="transport-book-btn">
                        Inquire About Transport
                    </a>

                    <p class="muted" style="font-size:12px;line-height:1.7;margin-top:15px;">
                        Prices and availability are subject to confirmation by our team.
                    </p>
                </section>

                <section class="transport-panel">
                    <h2>Need Assistance?</h2>

                    <p class="muted">
                        Contact our team for help arranging your journey.
                    </p>

                    @if (!string.IsNullOrWhiteSpace(Model.ContactPhone))
                    {
                        <p><strong>@Model.ContactPhone</strong></p>
                    }

                    <a asp-controller="Contact"
                       asp-action="Index"
                       class="transport-review-btn">
                        Contact Our Team
                    </a>
                </section>

            </aside>

        </div>
    </div>
</main>
