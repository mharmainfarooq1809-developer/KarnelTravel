@model KarnelTravel.Models.DemoPaymentTransaction
@{ Layout = null; var booking = Model.Booking; }
<!doctype html><html lang="en"><head><meta charset="utf-8" /><title>Payment receipt @Model.TransactionReference</title><style>body{font-family:Arial,sans-serif;color:#21392f;margin:0;padding:40px}.receipt{max-width:700px;margin:auto;border:1px solid #dfe7df;padding:40px}.brand{letter-spacing:.15em;font-weight:700;color:#286c4e}.line{display:flex;justify-content:space-between;border-bottom:1px solid #e8eee8;padding:12px 0}.notice{background:#fff4d8;padding:14px;margin:25px 0}button{padding:12px 18px;background:#286c4e;color:#fff;border:0;border-radius:7px}@@media print{button{display:none}} </style></head><body><main class="receipt"><div class="brand">KARNEL TRAVEL GUIDE</div><h1>Payment Receipt</h1><div class="notice">DEMO PAYMENT — NO REAL MONEY WILL BE CHARGED</div><div class="line"><span>Payment reference</span><strong>@Model.TransactionReference</strong></div><div class="line"><span>Booking reference</span><strong>@booking.ReferenceNumber</strong></div><div class="line"><span>Customer</span><strong>@booking.CustomerName</strong></div><div class="line"><span>Service</span><strong>@booking.ServiceName</strong></div><div class="line"><span>Transaction date</span><strong>@Model.ProcessedAt?.ToString("dd MMM yyyy, HH:mm") UTC</strong></div><div class="line"><span>Payment method</span><strong>@Model.CardBrand @Model.MaskedCardNumber</strong></div><div class="line"><span>Amount paid</span><strong>PKR @Model.Amount.ToString("N2")</strong></div><div class="line"><span>Status</span><strong>@Model.PaymentStatus</strong></div><p><button onclick="window.print()">Print / save receipt</button></p></main></body></html>
