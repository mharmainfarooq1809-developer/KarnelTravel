@model KarnelTravel.ViewModels.DemoPaymentConfirmationViewModel
@{ Layout = "_Layout"; ViewData["Title"] = Model.IsSuccessful ? "Payment Successful" : "Payment Unsuccessful"; var booking = Model.Booking; }
<style>
    .result{max-width:780px;margin:auto;padding:70px 20px;color:#21392f}.result-card{background:#fffdf8;border:1px solid #dfe7df;border-radius:22px;padding:38px;box-shadow:0 16px 40px #17362a12}.demo-label{display:inline-block;background:#fff4d8;color:#795b15;border-radius:999px;padding:8px 13px;font-size:.75rem;font-weight:800;letter-spacing:.1em}.result h1{font:600 clamp(2.2rem,5vw,3.8rem)/1.1 Georgia,serif;margin:20px 0 12px}.message{padding:17px;border-radius:12px;line-height:1.7;background:@(Model.IsSuccessful ? "#e8f5eb" : "#fff0f0");color:@(Model.IsSuccessful ? "#245f3e" : "#8e3838")}.facts{display:grid;gap:13px;margin:28px 0}.fact{display:flex;justify-content:space-between;gap:20px;border-bottom:1px solid #e8eee8;padding-bottom:11px}.fact span{color:#69786f}.actions{display:flex;flex-wrap:wrap;gap:10px}.actions a{padding:13px 17px;border-radius:9px;background:#286c4e;color:#fff;text-decoration:none;font-weight:800}.actions a.secondary{background:#edf2ed;color:#315342}
</style>
<main class="result"><div class="result-card"><span class="demo-label">DEMO TRANSACTION · NO REAL MONEY CHARGED</span><h1>@(Model.IsSuccessful ? "Payment Successful!" : Model.Transaction.PaymentStatus == "Cancelled" ? "Payment Cancelled" : "Payment Unsuccessful")</h1><div class="message">@(Model.IsSuccessful ? "Your booking has been successfully confirmed." : Model.Transaction.FailureReason ?? "We couldn't complete your simulated transaction.")</div><div class="facts"><div class="fact"><span>Payment reference</span><strong>@Model.Transaction.TransactionReference</strong></div><div class="fact"><span>Booking reference</span><strong>@booking.ReferenceNumber</strong></div><div class="fact"><span>Customer</span><strong>@booking.CustomerName</strong></div><div class="fact"><span>Selected service</span><strong>@booking.ServiceName</strong></div><div class="fact"><span>Transaction date</span><strong>@Model.Transaction.ProcessedAt?.ToString("dd MMM yyyy, HH:mm") UTC</strong></div><div class="fact"><span>Payment method</span><strong>@Model.Transaction.CardBrand @Model.Transaction.MaskedCardNumber</strong></div><div class="fact"><span>Paid amount</span><strong>PKR @Model.Transaction.Amount.ToString("N2")</strong></div><div class="fact"><span>Payment status</span><strong>@(Model.IsSuccessful ? "Paid" : Model.Transaction.PaymentStatus)</strong></div></div><div class="actions">@if (Model.IsSuccessful) { <a asp-controller="Customer" asp-action="BookingDetails" asp-route-id="@booking.Id">View booking</a><a asp-action="Receipt" asp-route-id="@Model.Transaction.Id" target="_blank">Download payment receipt</a> } else if (Model.Transaction.PaymentStatus != "Cancelled") { <a asp-action="Checkout" asp-route-id="@booking.Id">Try again</a> }<a class="secondary" asp-controller="Customer" asp-action="Dashboard">Return to dashboard</a></div></div></main>
