@section Scripts {
    <script>
        /* Home page — search panel forwards to Explore */
        (function () {
            'use strict';
            var form = document.getElementById('home-search');
            if (!form) { return; }

            form.addEventListener('submit', function (event) {
                event.preventDefault();

                var data = new FormData(form);
                var params = new URLSearchParams();

                ['keyword', 'category', 'budget'].forEach(function (key) {
                    var value = (data.get(key) || '').toString().trim();
                    if (value) { params.set(key, value); }
                });

                // Forward to the Explore page so the user's intent is preserved.
                var target = '@Url.Action("Index", "Search")';
                if (params.toString()) { target += '?' + params.toString(); }
                window.location.href = target;
            });
        })();
    </script>
}