@{
    var websiteContent = ViewBag.WebsiteContent as KarnelTravel.Models.WebsiteContent ?? new KarnelTravel.Models.WebsiteContent();
    ViewData["Title"] = "Karnel Travel Guide | Discover Your Next Journey";
    ViewData["Description"] = "Discover destinations, transport, hotels, restaurants, resorts and travel packages across Pakistan with Karnel Travel Guide.";
    ViewData["BodyClass"] = "has-hero";
}

@section Styles {
    <style>
        @@import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;0,800;1,400;1,500&display=swap');

        /* ============================================================
                   GLOBAL ENHANCEMENTS
                ============================================================ */
        :root {
            --ease-out: cubic-bezier(0.16, 1, 0.3, 1);
            --ease-spring: cubic-bezier(0.34, 1.56, 0.64, 1);
            --section-y: clamp(76px, 9vw, 132px);
        }

        html {
            scroll-behavior: smooth;
        }

        ::selection {
            background: var(--forest);
            color: var(--ivory);
        }

        ::-webkit-scrollbar {
            width: 10px;
        }

        ::-webkit-scrollbar-track {
            background: var(--ivory);
        }

        ::-webkit-scrollbar-thumb {
            background: var(--moss);
            border-radius: 10px;
            border: 2px solid var(--ivory);
        }

            ::-webkit-scrollbar-thumb:hover {
                background: var(--forest);
            }

        /* Reveal system (activated by JS) */
        .reveal-pending {
            opacity: 0;
            transform: translateY(44px);
            filter: blur(6px);
            transition: opacity 1.1s var(--ease-out), transform 1.1s var(--ease-out), filter 1.1s var(--ease-out);
        }

            .reveal-pending.is-revealed {
                opacity: 1 !important;
                transform: none !important;
                filter: blur(0) !important;
            }

        /* ============================================================
                   TYPOGRAPHY HELPERS
                ============================================================ */
        .eyebrow {
            display: inline-flex;
            align-items: center;
            gap: 12px;
            margin: 0 0 14px;
            font-family: var(--sans);
            font-size: 0.68rem;
            font-weight: 600;
            letter-spacing: 0.24em;
            text-transform: uppercase;
            color: var(--moss);
        }

            .eyebrow::before {
                content: '';
                width: 28px;
                height: 1px;
                background: currentColor;
                flex: 0 0 auto;
                opacity: 0.85;
            }

        .region-tag {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            font-size: 0.64rem;
            letter-spacing: 0.18em;
            text-transform: uppercase;
            color: var(--moss);
        }

            .region-tag::before {
                content: '';
                width: 5px;
                height: 5px;
                border-radius: 50%;
                background: var(--sage);
                flex: 0 0 auto;
            }

        .badge {
            display: inline-block;
            padding: 5px 12px;
            border-radius: 999px;
            font-size: 0.62rem;
            letter-spacing: 0.14em;
            text-transform: uppercase;
            background: var(--sand);
            color: var(--forest-deep);
        }

        .section {
            position: relative;
            padding: var(--section-y) 0;
        }

        .section--ivory {
            background-color: var(--ivory);
            background-image: radial-gradient(ellipse 60% 50% at 92% 8%, rgba(143, 168, 136, 0.10), transparent 60%), radial-gradient(ellipse 50% 60% at 8% 92%, rgba(232, 223, 201, 0.30), transparent 60%);
        }

        .section--sand {
            background-color: var(--sand);
            background-image: radial-gradient(ellipse 70% 60% at 100% 0%, rgba(255, 255, 255, 0.40), transparent 60%), radial-gradient(ellipse 50% 50% at 0% 100%, rgba(83, 107, 80, 0.08), transparent 60%);
        }

        .section--forest {
            background-color: var(--forest);
            color: var(--ivory);
        }

            .section--forest .section-head h2 {
                color: var(--ivory);
            }

            .section--forest .section-head p {
                color: rgba(248, 246, 240, 0.72);
            }

            .section--forest .eyebrow {
                color: var(--sage);
            }

        .section-head {
            max-width: 720px;
            margin-bottom: clamp(36px, 5vw, 64px);
        }

            .section-head h2 {
                margin: 14px 0 16px;
                font-size: clamp(2rem, 3.6vw, 3.2rem);
                line-height: 1.04;
                letter-spacing: -0.02em;
                text-wrap: balance;
            }

            .section-head p {
                max-width: 60ch;
                margin: 0;
                color: var(--muted);
                line-height: 1.7;
            }

        /* ============================================================
                   BUTTONS & LINKS
                ============================================================ */
        .btn {
            position: relative;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            min-height: 52px;
            padding: 0 28px;
            overflow: hidden;
            isolation: isolate;
            border: 1px solid transparent;
            border-radius: var(--radius);
            background: var(--forest);
            color: var(--ivory);
            font-family: var(--sans);
            font-size: 0.74rem;
            font-weight: 600;
            letter-spacing: 0.16em;
            text-transform: uppercase;
            text-decoration: none;
            cursor: pointer;
            transition: transform 0.5s var(--ease-out), box-shadow 0.5s var(--ease-out), background 0.4s var(--ease), color 0.4s var(--ease), border-color 0.4s var(--ease);
        }

            .btn::after {
                content: '';
                position: absolute;
                inset: 0;
                z-index: 1;
                background: linear-gradient(120deg, transparent 20%, rgba(255, 255, 255, 0.35) 50%, transparent 80%);
                transform: translateX(-120%);
                transition: transform 0.85s var(--ease-out);
                pointer-events: none;
            }

            .btn:hover {
                transform: translateY(-3px);
                box-shadow: 0 18px 32px -18px rgba(20, 39, 31, 0.55);
            }

                .btn:hover::after {
                    transform: translateX(120%);
                }

            .btn:active {
                transform: translateY(-1px);
            }

        .btn--light {
            background: var(--ivory);
            color: var(--forest-deep);
            border-color: var(--ivory);
        }

        .btn--ghost-light {
            background: transparent;
            color: var(--ivory);
            border-color: rgba(248, 246, 240, 0.45);
        }

            .btn--ghost-light:hover {
                border-color: var(--ivory);
                background: rgba(248, 246, 240, 0.08);
            }

        .btn--forest {
            background: var(--forest);
            color: var(--ivory);
        }

        .btn--ghost-dark {
            background: transparent;
            color: var(--forest);
            border-color: rgba(20, 39, 31, 0.28);
        }

            .btn--ghost-dark:hover {
                border-color: var(--forest);
            }

        .link-arrow {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            padding-bottom: 3px;
            border-bottom: 1px solid transparent;
            font-size: 0.7rem;
            font-weight: 600;
            letter-spacing: 0.16em;
            text-transform: uppercase;
            color: var(--forest);
            text-decoration: none;
            transition: color 0.3s var(--ease), border-color 0.3s var(--ease);
        }

            .link-arrow::after {
                content: '\2192';
                font-size: 0.95rem;
                transition: transform 0.4s var(--ease-out);
            }

            .link-arrow:hover {
                color: var(--forest-deep);
                border-color: currentColor;
            }

                .link-arrow:hover::after {
                    transform: translateX(4px);
                }

        .link-arrow--light {
            color: var(--sand);
        }

            .link-arrow--light:hover {
                color: #fff;
            }

        /* ============================================================
                   HERO
                ============================================================ */
        .hero {
            position: relative;
            min-height: 94vh;
            display: grid;
            align-items: center;
            padding: calc(var(--header-h) + 60px) 0 180px;
            overflow: hidden;
            color: var(--ivory);
            isolation: isolate;
        }

        .hero__media {
            position: absolute;
            inset: 0;
            overflow: hidden;
            background: var(--forest-deep);
        }

            .hero__media img {
                width: 100%;
                height: 100%;
                object-fit: cover;
                transform: scale(1.06);
                will-change: transform;
            }

        .hero__overlay {
            position: absolute;
            inset: 0;
            background: radial-gradient(ellipse 70% 80% at 20% 30%, rgba(20, 39, 31, 0.12), transparent 60%), linear-gradient(180deg, rgba(20, 39, 31, 0.40) 0%, rgba(20, 39, 31, 0.55) 45%, rgba(20, 39, 31, 0.88) 100%);
        }

        .hero::after {
            content: '';
            position: absolute;
            left: 0;
            right: 0;
            bottom: 0;
            height: 180px;
            background: linear-gradient(180deg, transparent, var(--ivory));
            pointer-events: none;
            z-index: 1;
        }

        .hero__content {
            position: relative;
            z-index: 2;
            max-width: 940px;
        }

        .hero .eyebrow {
            color: var(--sage);
        }

        .hero h1 {
            max-width: 16ch;
            margin: 0 0 24px;
            color: var(--ivory);
            font-size: clamp(2.8rem, 6.2vw, 5.4rem);
            line-height: 0.98;
            letter-spacing: -0.02em;
            text-wrap: balance;
        }

            .hero h1 em {
                font-style: italic;
                color: var(--sand);
            }

        .hero__lede {
            max-width: 52ch;
            margin-bottom: 32px;
            color: rgba(248, 246, 240, 0.82);
            font-size: clamp(1rem, 1.4vw, 1.15rem);
            line-height: 1.65;
        }

        .hero__cta {
            display: flex;
            flex-wrap: wrap;
            gap: 14px;
        }

        .hero__meta {
            display: flex;
            flex-wrap: wrap;
            gap: clamp(18px, 3vw, 44px);
            margin-top: clamp(28px, 4vw, 46px);
        }

            .hero__meta div {
                min-width: 118px;
                padding-top: 14px;
                border-top: 1px solid rgba(248, 246, 240, 0.22);
            }

            .hero__meta strong {
                display: block;
                font-family: var(--serif);
                font-size: 1.6rem;
                font-weight: 500;
                line-height: 1;
                color: var(--sand);
            }

            .hero__meta span {
                display: block;
                margin-top: 6px;
                font-size: 0.64rem;
                letter-spacing: 0.18em;
                text-transform: uppercase;
                color: rgba(248, 246, 240, 0.6);
            }

        .hero__scroll {
            position: absolute;
            left: 50%;
            bottom: 42px;
            z-index: 2;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 12px;
            transform: translateX(-50%);
            font-size: 0.68rem;
            letter-spacing: 0.26em;
            text-transform: uppercase;
            color: rgba(248, 246, 240, 0.7);
        }

            .hero__scroll::after {
                content: "";
                width: 1px;
                height: 44px;
                background: currentColor;
                animation: heroScroll 2.4s var(--ease) infinite;
                transform-origin: top;
            }

        @@keyframes heroScroll {
            0% {
                transform: scaleY(0);
                opacity: 0;
            }

            40% {
                transform: scaleY(1);
                opacity: 1;
            }

            100% {
                transform: scaleY(1);
                opacity: 0;
            }
        }

        .hero__content > * {
            opacity: 0;
            transform: translateY(30px);
            filter: blur(8px);
            animation: heroIn 1.1s var(--ease-out) forwards;
        }

            .hero__content > *:nth-child(1) {
                animation-delay: 0.15s;
            }

            .hero__content > *:nth-child(2) {
                animation-delay: 0.35s;
            }

            .hero__content > *:nth-child(3) {
                animation-delay: 0.55s;
            }

            .hero__content > *:nth-child(4) {
                animation-delay: 0.75s;
            }

            .hero__content > *:nth-child(5) {
                animation-delay: 0.95s;
            }

        @@keyframes heroIn {
            to {
                opacity: 1;
                transform: none;
                filter: blur(0);
            }
        }

        /* ============================================================
                   SECTION 02 — INTELLIGENT JOURNEY FINDER
                ============================================================ */
        .finder-band {
            position: relative;
            z-index: 6;
            margin-top: clamp(-120px, -9vw, -70px);
            padding-bottom: clamp(40px, 6vw, 72px);
        }

        .finder {
            overflow: hidden;
            background: var(--ivory);
            border: 1px solid var(--line);
            border-radius: var(--radius-lg);
            box-shadow: 0 50px 100px -40px rgba(20, 39, 31, 0.4), 0 2px 4px rgba(20, 39, 31, 0.04), inset 0 1px 0 rgba(255, 255, 255, 0.8);
        }

        .finder__head {
            display: flex;
            flex-wrap: wrap;
            align-items: flex-start;
            justify-content: space-between;
            gap: 18px;
            padding: clamp(22px, 3vw, 34px) clamp(22px, 3vw, 38px) 0;
        }

            .finder__head h2 {
                max-width: 22ch;
                margin: 0;
                font-size: clamp(1.3rem, 2vw, 1.7rem);
                line-height: 1.15;
                letter-spacing: -0.01em;
            }

        .finder__tabs {
            display: flex;
            gap: 4px;
            margin-top: 18px;
            padding: 0 clamp(22px, 3vw, 38px);
            overflow-x: auto;
            border-bottom: 1px solid var(--line);
            -webkit-overflow-scrolling: touch;
            scrollbar-width: none;
        }

            .finder__tabs::-webkit-scrollbar {
                display: none;
            }

        .finder__tab {
            position: relative;
            flex: 0 0 auto;
            padding: 14px 18px;
            border: 0;
            background: none;
            color: var(--muted);
            font: inherit;
            font-size: 0.7rem;
            font-weight: 600;
            letter-spacing: 0.16em;
            text-transform: uppercase;
            cursor: pointer;
            transition: color 0.3s var(--ease);
        }

            .finder__tab::after {
                content: '';
                position: absolute;
                left: 18px;
                right: 18px;
                bottom: -1px;
                height: 2px;
                background: var(--forest);
                transform: scaleX(0);
                transform-origin: left;
                transition: transform 0.45s var(--ease-out);
            }

            .finder__tab:hover {
                color: var(--forest);
            }

            .finder__tab.is-active {
                color: var(--forest);
            }

                .finder__tab.is-active::after {
                    transform: scaleX(1);
                }

        .finder__panels {
            padding: clamp(22px, 3vw, 32px) clamp(22px, 3vw, 38px) 0;
        }

        .finder__panel[hidden] {
            display: none;
        }

        .finder__panel {
            animation: finderIn 0.5s var(--ease-out);
        }

        @@keyframes finderIn {
            from {
                opacity: 0;
                transform: translateY(8px);
            }

            to {
                opacity: 1;
                transform: none;
            }
        }

        .finder__fields {
            display: grid;
            gap: 14px;
        }

        .finder__fields--3 {
            grid-template-columns: 1.4fr 1fr 1fr;
        }

        .finder__fields--2 {
            grid-template-columns: 1fr 1fr;
        }

        .field {
            display: flex;
            flex-direction: column;
            gap: 6px;
        }

            .field > span {
                font-size: 0.64rem;
                letter-spacing: 0.18em;
                text-transform: uppercase;
                color: var(--muted);
            }

            .field input,
            .field select {
                height: 54px;
                padding: 0 16px;
                border: 1px solid var(--line);
                border-radius: var(--radius);
                background: var(--white);
                color: var(--charcoal);
                font: inherit;
                font-size: 0.95rem;
                transition: border-color 0.3s var(--ease), box-shadow 0.3s var(--ease), background 0.3s var(--ease);
            }

                .field input:hover,
                .field select:hover {
                    border-color: rgba(83, 107, 80, 0.4);
                }

                .field input:focus,
                .field select:focus {
                    outline: none;
                    border-color: var(--moss);
                    background: #fff;
                    box-shadow: 0 0 0 4px rgba(83, 107, 80, 0.14);
                }

        .finder__foot {
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            justify-content: space-between;
            gap: 18px;
            padding: clamp(20px, 3vw, 28px) clamp(22px, 3vw, 38px) clamp(22px, 3vw, 32px);
        }

        .finder__note {
            max-width: 58ch;
            margin: 0;
            font-size: 0.74rem;
            line-height: 1.6;
            color: var(--muted);
        }

            .finder__note a {
                color: var(--forest);
                border-bottom: 1px solid currentColor;
                transition: color 0.3s var(--ease);
            }

                .finder__note a:hover {
                    color: var(--forest-deep);
                }

        /* ============================================================
                   SECTION 03 — DISCOVER PAKISTAN
                ============================================================ */
        .discover__head {
            display: grid;
            grid-template-columns: 1.2fr 0.8fr;
            gap: clamp(24px, 4vw, 64px);
            align-items: end;
            margin-bottom: clamp(36px, 5vw, 60px);
        }

            .discover__head .section-head {
                margin-bottom: 0;
            }

        .discover__head-link {
            justify-self: end;
            margin-bottom: 8px;
        }

        .discover__grid {
            display: grid;
            grid-template-columns: 1.45fr 1fr;
            gap: clamp(18px, 2.4vw, 32px);
        }

        .discover__feature {
            position: relative;
            display: flex;
            align-items: flex-end;
            min-height: clamp(460px, 46vw, 680px);
            overflow: hidden;
            border-radius: var(--radius-lg);
            color: var(--ivory);
            isolation: isolate;
        }

            .discover__feature img {
                position: absolute;
                inset: 0;
                z-index: -2;
                width: 100%;
                height: 100%;
                object-fit: cover;
                transition: transform 1.1s var(--ease-out);
            }

            .discover__feature::after {
                content: '';
                position: absolute;
                inset: 0;
                z-index: -1;
                background: linear-gradient(180deg, rgba(20, 39, 31, 0.05) 0%, rgba(20, 39, 31, 0.25) 45%, rgba(20, 39, 31, 0.88) 100%);
            }

            .discover__feature:hover img {
                transform: scale(1.05);
            }

        .discover__feature-body {
            max-width: 560px;
            padding: clamp(26px, 4vw, 48px);
        }

        .discover__region {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            font-size: 0.66rem;
            letter-spacing: 0.2em;
            text-transform: uppercase;
            color: var(--sand);
        }

            .discover__region::before {
                content: '';
                width: 26px;
                height: 1px;
                background: currentColor;
            }

        .discover__feature h3 {
            margin: 14px 0 12px;
            color: var(--ivory);
            font-size: clamp(2rem, 3.4vw, 3.2rem);
            line-height: 1.02;
            letter-spacing: -0.02em;
        }

        .discover__feature p {
            max-width: 46ch;
            margin: 0 0 20px;
            color: rgba(248, 246, 240, 0.82);
            line-height: 1.65;
        }

        .discover__stack {
            display: grid;
            grid-template-rows: 1fr 1fr;
            gap: clamp(18px, 2.4vw, 32px);
        }

        .discover__item {
            display: grid;
            grid-template-columns: 1fr 1fr;
            overflow: hidden;
            background: var(--white);
            border: 1px solid var(--line);
            border-radius: var(--radius-lg);
            transition: transform 0.5s var(--ease-out), box-shadow 0.5s var(--ease-out), border-color 0.4s var(--ease);
        }

            .discover__item:hover {
                transform: translateY(-4px);
                border-color: rgba(83, 107, 80, 0.25);
                box-shadow: 0 30px 60px -34px rgba(20, 39, 31, 0.4);
            }

        .discover__item-media {
            overflow: hidden;
        }

            .discover__item-media img {
                width: 100%;
                height: 100%;
                object-fit: cover;
                transition: transform 1s var(--ease-out);
            }

        .discover__item:hover .discover__item-media img {
            transform: scale(1.06);
        }

        .discover__item-body {
            display: flex;
            flex-direction: column;
            justify-content: center;
            gap: 10px;
            padding: clamp(20px, 2.4vw, 30px);
        }

            .discover__item-body h3 {
                margin: 0;
                font-size: 1.35rem;
                letter-spacing: -0.01em;
            }

            .discover__item-body p {
                margin: 0;
                color: var(--muted);
                font-size: 0.9rem;
                line-height: 1.6;
            }

        /* ============================================================
                   SECTION 04 — THE QUIET ATLAS INTRO
                ============================================================ */
        .atlas-intro {
            padding: var(--section-y) 0 clamp(40px, 6vw, 72px);
            background-color: var(--ivory);
        }

            .atlas-intro .container {
                display: grid;
                grid-template-columns: 0.95fr 1.05fr;
                gap: clamp(24px, 4vw, 72px);
                align-items: end;
            }

            .atlas-intro h2 {
                margin: 14px 0 0;
                font-size: clamp(2rem, 3.6vw, 3.2rem);
                line-height: 1.04;
                letter-spacing: -0.02em;
                text-wrap: balance;
            }

            .atlas-intro p {
                margin: 0 0 16px;
                color: var(--muted);
                line-height: 1.7;
            }

        .atlas-intro__hint {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            font-size: 0.68rem;
            letter-spacing: 0.18em;
            text-transform: uppercase;
            color: var(--moss);
        }

            .atlas-intro__hint::before {
                content: '';
                width: 22px;
                height: 1px;
                background: currentColor;
            }

        /* ============================================================
                   SECTION 04 — NATURE SPOTS / SPHERE (preserved)
                ============================================================ */
        :root {
            --arch-pad: clamp(14px, 2.6vw, 34px);
            --arch-hw: min(56vw, 640px);
        }

        @@media (max-width: 640px) {
            :root {
                --arch-hw: min(84vw, 360px);
            }
        }

        @@media (max-width: 380px) {
            :root {
                --arch-hw: min(88vw, 320px);
            }
        }

        .archive {
            position: relative;
            height: 130vh;
            background: var(--forest-deep);
            color: var(--ivory);
            overflow: hidden;
        }

        .archive__stage {
            position: sticky;
            top: 0;
            height: 100vh;
            height: 100dvh;
            overflow: hidden;
            perspective: 1150px;
            perspective-origin: 50% 50%;
            touch-action: pan-y;
            cursor: grab;
        }

            .archive__stage:active {
                cursor: grabbing;
            }

        .archive__label {
            position: absolute;
            top: calc(var(--header-h, 80px) + 20px);
            left: 50%;
            transform: translateX(-50%);
            text-align: center;
            z-index: 5;
            pointer-events: none;
            white-space: nowrap;
            transition: opacity 0.4s var(--ease);
        }

            .archive__label .eyebrow {
                color: var(--sage);
                margin: 0;
            }

        #arch-world {
            position: absolute;
            top: 50%;
            left: 50%;
            width: 0;
            height: 0;
            transform-style: preserve-3d;
            will-change: transform;
        }

        #arch-orb {
            position: absolute;
            top: 0;
            left: 0;
            width: 0;
            height: 0;
            transform-style: preserve-3d;
        }

        .arch-card {
            position: absolute;
            top: 0;
            left: 0;
            transform-style: preserve-3d;
            will-change: transform, opacity;
        }

            .arch-card figure {
                width: 100%;
                height: 100%;
                margin: 0;
                overflow: hidden;
                border-radius: 6px;
                background: #0a1210;
                position: relative;
                transition: transform 0.5s var(--ease);
            }

                .arch-card figure::after {
                    content: '';
                    position: absolute;
                    inset: 0;
                    background: rgba(0, 0, 0, var(--d, 0));
                    box-shadow: inset 0 0 0 1px rgba(244, 242, 239, 0.07);
                    border-radius: 6px;
                    pointer-events: none;
                }

            .arch-card img {
                width: 100%;
                height: 100%;
                object-fit: cover;
                display: block;
                opacity: 0;
                transition: opacity 0.8s ease-out;
            }

            .arch-card.in img {
                opacity: 1;
            }

            .arch-card:hover figure {
                transform: scale(1.045);
            }

        #arch-headline {
            position: absolute;
            top: 0;
            left: 0;
            width: var(--arch-hw);
            margin: 0 0 0 calc(var(--arch-hw) / -2);
            padding: 0;
            text-align: center;
            font-family: var(--serif, "Playfair Display", Georgia, serif);
            font-weight: 400;
            font-size: clamp(25px, 3.7vw, 55px);
            line-height: 1.06;
            letter-spacing: -0.005em;
            color: var(--ivory);
            text-shadow: 0 2px 34px rgba(0, 0, 0, 0.55);
            pointer-events: none;
            user-select: none;
            -webkit-user-select: none;
        }

            #arch-headline .inner {
                position: absolute;
                top: 0;
                left: 0;
                width: 100%;
                transform: translateY(-50%);
            }

                #arch-headline .inner span {
                    display: inline-block;
                    opacity: 0;
                    transform: translateY(0.42em);
                    filter: blur(7px);
                    transition: opacity 1.05s var(--ease), transform 1.15s var(--ease), filter 1.05s var(--ease);
                    transition-delay: calc(0.3s + var(--i) * 0.085s);
                }

        body.arch-inview #arch-headline .inner span {
            opacity: 1;
            transform: none;
            filter: blur(0);
        }

        .archive__vig {
            position: absolute;
            inset: 0;
            pointer-events: none;
            z-index: 3;
            background: radial-gradient(ellipse 88% 92% at 50% 50%, transparent 48%, rgba(0, 0, 0, 0.26) 80%, rgba(0, 0, 0, 0.72) 100%);
            transition: opacity 0.6s var(--ease);
        }

        body.arch-gridview .archive__vig,
        body.arch-lit .archive__vig {
            opacity: 0;
        }

        .archive__cue {
            position: absolute;
            left: 50%;
            bottom: calc(var(--arch-pad) + env(safe-area-inset-bottom) + 4px);
            transform: translateX(-50%);
            z-index: 4;
            display: flex;
            align-items: center;
            gap: 10px;
            font-size: 10px;
            text-transform: uppercase;
            letter-spacing: 0.24em;
            color: rgba(248, 246, 240, 0.5);
            white-space: nowrap;
            pointer-events: none;
        }

            .archive__cue s {
                display: inline-block;
                width: 44px;
                height: 1px;
                background: rgba(244, 242, 239, 0.28);
                overflow: hidden;
                position: relative;
                text-decoration: none;
            }

                .archive__cue s::after {
                    content: '';
                    position: absolute;
                    inset: 0;
                    background: var(--ivory);
                    animation: archSweep 2.6s ease infinite;
                }

        @@keyframes archSweep {
            0% {
                transform: translateX(-100%);
            }

            55% {
                transform: translateX(0);
            }

            100% {
                transform: translateX(100%);
            }
        }

        @@media (max-width: 640px) {
            .archive__cue {
                display: none;
            }
        }

        .archive__gridbtn {
            position: fixed;
            left: calc(var(--arch-pad) + env(safe-area-inset-left));
            bottom: calc(var(--arch-pad) + env(safe-area-inset-bottom) + 40px);
            z-index: 210;
            width: 44px;
            height: 44px;
            padding: 10px;
            display: grid;
            grid-template-columns: 1fr 1fr;
            grid-template-rows: 1fr 1fr;
            gap: 4px;
            opacity: 0;
            transform: translateY(8px);
            pointer-events: none;
            transition: opacity 0.4s var(--ease), transform 0.4s var(--ease);
            background: rgba(20, 39, 31, 0.82);
            border: 1px solid var(--line);
            border-radius: var(--radius);
            backdrop-filter: blur(6px);
            -webkit-backdrop-filter: blur(6px);
            cursor: pointer;
        }

        body.arch-inview .archive__gridbtn,
        body.arch-gridview .archive__gridbtn,
        body.arch-lit .archive__gridbtn {
            opacity: 1;
            transform: none;
            pointer-events: auto;
        }

        .archive__gridbtn b {
            display: block;
            background: var(--ivory);
            border-radius: 2px;
            transition: background 0.3s var(--ease), transform 0.3s var(--ease);
        }

        .archive__gridbtn:hover b {
            background: #fff;
            transform: scale(0.86);
        }

        body.arch-gridview .archive__gridbtn b:nth-child(1) {
            transform: translate(3px, 3px);
        }

        body.arch-gridview .archive__gridbtn b:nth-child(4) {
            transform: translate(-3px, -3px);
        }

        /* ===== FLAT GRID ===== */
        .arch-grid {
            position: fixed;
            inset: 0;
            z-index: 200;
            background: var(--forest-deep);
            overflow-y: auto;
            overscroll-behavior: contain;
            padding: calc(var(--arch-pad) * 3.4) var(--arch-pad) calc(var(--arch-pad) * 4);
            opacity: 0;
            pointer-events: none;
            transition: opacity 0.5s var(--ease);
        }

        body.arch-gridview .arch-grid {
            opacity: 1;
            pointer-events: auto;
        }

        .arch-grid__rows {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
            gap: clamp(10px, 1.4vw, 20px);
            max-width: 1680px;
            margin: 0 auto;
        }

            .arch-grid__rows figure {
                position: relative;
                margin: 0;
                aspect-ratio: 3 / 2;
                border-radius: var(--radius);
                overflow: hidden;
                background: #0b1210;
                cursor: pointer;
            }

            .arch-grid__rows img {
                width: 100%;
                height: 100%;
                object-fit: cover;
                opacity: 0.85;
                transition: opacity 0.6s var(--ease), transform 0.8s var(--ease);
            }

            .arch-grid__rows figure:hover img {
                opacity: 1;
                transform: scale(1.05);
            }

            .arch-grid__rows figcaption {
                position: absolute;
                left: 0;
                right: 0;
                bottom: 0;
                padding: 26px 14px 12px;
                font-family: var(--serif, "Playfair Display", Georgia, serif);
                font-size: 15px;
                color: var(--ivory);
                background: linear-gradient(to bottom, transparent, rgba(0, 0, 0, 0.82));
                opacity: 0;
                transform: translateY(6px);
                transition: opacity 0.4s var(--ease), transform 0.4s var(--ease);
            }

            .arch-grid__rows figure:hover figcaption {
                opacity: 1;
                transform: none;
            }

        @@media (max-width: 900px) {
            .arch-grid {
                padding-top: calc(var(--arch-pad) * 2.8 + env(safe-area-inset-top));
            }

            .arch-grid__rows {
                grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
            }
        }

        @@media (max-width: 640px) {
            .arch-grid__rows {
                grid-template-columns: 1fr 1fr;
                gap: 8px;
            }

                .arch-grid__rows figcaption {
                    opacity: 1;
                    transform: none;
                    font-size: 13px;
                }

            .arch-grid {
                padding: calc(60px + env(safe-area-inset-top)) env(safe-area-inset-right) 40px env(safe-area-inset-left);
            }
        }

        @@media (max-width: 380px) {
            .arch-grid__rows {
                grid-template-columns: 1fr;
            }
        }

        /* ===== LIGHTBOX ===== */
        .arch-lit {
            position: fixed;
            inset: 0;
            z-index: 300;
            display: grid;
            place-items: center;
            padding: clamp(56px, 8vh, 84px) var(--arch-pad);
            opacity: 0;
            pointer-events: none;
            transition: opacity 0.4s var(--ease);
        }

        body.arch-lit .arch-lit {
            opacity: 1;
            pointer-events: auto;
        }

        .arch-lit__scrim {
            position: absolute;
            inset: 0;
            background: rgba(8, 20, 14, 0.94);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            cursor: pointer;
        }

        .arch-lit__plate {
            position: relative;
            width: min(72vw, 860px, calc((100vh - 230px) * 1.5));
            transition: transform 0.62s var(--ease), opacity 0.42s var(--ease);
        }

        .arch-lit__shot {
            position: relative;
            width: 100%;
            aspect-ratio: 3 / 2;
            border-radius: var(--radius);
            overflow: hidden;
            background: #0b1210;
            box-shadow: 0 30px 90px rgba(0, 0, 0, 0.75);
        }

            .arch-lit__shot img {
                width: 100%;
                height: 100%;
                object-fit: cover;
                display: block;
            }

        .arch-lit__close {
            position: absolute;
            top: 12px;
            right: 14px;
            min-height: 44px;
            padding: 10px 14px;
            font-size: 12.5px;
            letter-spacing: 0.05em;
            color: var(--ivory);
            background: rgba(0, 0, 0, 0.35);
            border: 1px solid rgba(244, 242, 239, 0.78);
            border-radius: 6px;
            cursor: pointer;
            font-family: var(--sans, inherit);
            transition: background 0.3s, border-color 0.3s;
        }

            .arch-lit__close:hover {
                border-color: #fff;
                background: rgba(0, 0, 0, 0.55);
            }

        .arch-lit__meta {
            display: grid;
            grid-template-columns: minmax(0, 0.78fr) minmax(0, 1.22fr);
            gap: clamp(22px, 3.2vw, 48px);
            padding-top: 16px;
            color: var(--ivory);
        }

            .arch-lit__meta h2 {
                font-family: var(--serif, "Playfair Display", Georgia, serif);
                font-weight: 400;
                font-size: clamp(22px, 2.15vw, 32px);
                line-height: 1.08;
                letter-spacing: -0.01em;
                margin: 0 0 6px;
                color: var(--ivory);
            }

        .arch-lit__where {
            font-size: 13px;
            color: rgba(244, 242, 239, 0.62);
            margin: 0;
        }

        .arch-lit__note {
            font-size: 13.5px;
            line-height: 1.55;
            color: rgba(244, 242, 239, 0.92);
            margin: 0;
        }

        @@media (max-width: 900px) {
            .arch-lit__meta {
                grid-template-columns: 1fr;
                gap: 10px;
                padding-top: 14px;
            }

            .arch-lit__plate {
                width: min(92vw, calc((100dvh - 220px) * 1.5));
            }
        }

        @@media (max-width: 768px) {
            #arch-headline {
                font-size: clamp(22px, 6.4vw, 34px);
            }
        }

        @@media (max-width: 640px) {
            .arch-lit {
                display: block;
                overflow-y: auto;
                padding: calc(52px + env(safe-area-inset-top)) env(safe-area-inset-right) calc(52px + env(safe-area-inset-bottom)) env(safe-area-inset-left);
            }

            .arch-lit__plate {
                width: 100%;
                max-width: 560px;
                margin: 0 auto;
            }

            .arch-lit__meta h2 {
                font-size: clamp(20px, 5.6vw, 26px);
            }

            .arch-lit__note {
                font-size: 12.5px;
                line-height: 1.58;
            }

            .arch-lit__close {
                top: 8px;
                right: 8px;
            }
        }

        @@media (max-height: 520px) and (orientation: landscape) {
            #arch-headline {
                font-size: clamp(18px, 4.8vh, 28px);
            }

            .arch-lit {
                padding-top: calc(36px + env(safe-area-inset-top));
            }

            .arch-lit__plate {
                width: min(58vw, calc((100dvh - 80px) * 1.5));
            }

            .arch-lit__meta {
                padding-top: 10px;
            }
        }

        /* ============================================================
                   SECTION 05 — EXCEPTIONAL PLACES TO STAY
                ============================================================ */
        .stay__grid {
            display: grid;
            grid-template-columns: 1.25fr 1fr;
            gap: clamp(22px, 3vw, 44px);
            align-items: stretch;
        }

        .stay-feature {
            display: grid;
            grid-template-columns: 1.15fr 0.85fr;
            min-height: 500px;
            overflow: hidden;
            background: var(--white);
            border: 1px solid var(--line);
            border-radius: var(--radius-lg);
            transition: border-color 0.4s var(--ease), box-shadow 0.5s var(--ease-out);
        }

            .stay-feature:hover {
                border-color: rgba(83, 107, 80, 0.25);
                box-shadow: 0 34px 70px -40px rgba(20, 39, 31, 0.42);
            }

        .stay-feature__media {
            overflow: hidden;
        }

            .stay-feature__media img {
                width: 100%;
                height: 100%;
                object-fit: cover;
                transition: transform 1.1s var(--ease-out);
            }

        .stay-feature:hover .stay-feature__media img {
            transform: scale(1.04);
        }

        .stay-feature__body {
            display: flex;
            flex-direction: column;
            gap: 14px;
            padding: clamp(24px, 3vw, 40px);
        }

            .stay-feature__body h3 {
                margin: 0;
                font-size: clamp(1.6rem, 2.4vw, 2.2rem);
                line-height: 1.06;
                letter-spacing: -0.01em;
            }

            .stay-feature__body p {
                margin: 0;
                color: var(--muted);
                line-height: 1.65;
            }

        .stay-feature__foot {
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            justify-content: space-between;
            gap: 14px;
            margin-top: auto;
            padding-top: 18px;
            border-top: 1px solid var(--line);
        }

        .facilities {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
            margin: 0;
            padding: 0;
            list-style: none;
        }

            .facilities li {
                padding: 5px 11px;
                border: 1px solid var(--line);
                border-radius: 999px;
                background: var(--ivory);
                color: var(--muted);
                font-size: 0.64rem;
                letter-spacing: 0.12em;
                text-transform: uppercase;
            }

        .facilities--dark li {
            border-color: rgba(248, 246, 240, 0.22);
            background: rgba(248, 246, 240, 0.06);
            color: rgba(248, 246, 240, 0.8);
        }

        .price {
            font-family: var(--serif);
            font-size: 1.4rem;
            line-height: 1.1;
            color: var(--forest-deep);
            letter-spacing: -0.01em;
        }

            .price small {
                display: block;
                margin-bottom: 3px;
                color: var(--muted);
                font-family: var(--sans);
                font-size: 0.62rem;
                font-weight: 400;
                letter-spacing: 0.16em;
                text-transform: uppercase;
            }

        .price--light {
            color: var(--sand);
        }

        .stay__list {
            display: flex;
            flex-direction: column;
            justify-content: center;
            border-top: 1px solid var(--line);
        }

        .stay-row {
            display: grid;
            grid-template-columns: 132px 1fr;
            gap: clamp(16px, 2vw, 24px);
            align-items: center;
            padding: clamp(18px, 2.4vw, 26px) 0;
            border-bottom: 1px solid var(--line);
        }

        .stay-row__media {
            aspect-ratio: 4 / 3;
            overflow: hidden;
            border-radius: var(--radius);
        }

            .stay-row__media img {
                width: 100%;
                height: 100%;
                object-fit: cover;
                transition: transform 0.9s var(--ease-out);
            }

        .stay-row:hover .stay-row__media img {
            transform: scale(1.08);
        }

        .stay-row h3 {
            margin: 6px 0 6px;
            font-size: 1.15rem;
            letter-spacing: -0.01em;
        }

        .stay-row p {
            margin: 0 0 10px;
            color: var(--muted);
            font-size: 0.88rem;
            line-height: 1.55;
        }

        .stay-row__foot {
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
        }

        .stay-row__price {
            font-family: var(--serif);
            font-size: 1.02rem;
            color: var(--forest-deep);
        }

            .stay-row__price small {
                font-family: var(--sans);
                font-size: 0.6rem;
                letter-spacing: 0.14em;
                text-transform: uppercase;
                color: var(--muted);
                margin-left: 6px;
            }

        /* ============================================================
                   SECTION 06 — THE JOURNEY BETWEEN
                ============================================================ */
        .route-layout {
            display: grid;
            grid-template-columns: 0.9fr 1.1fr;
            gap: clamp(30px, 5vw, 80px);
            align-items: start;
        }

        .route-intro h2 {
            margin: 14px 0 18px;
            font-size: clamp(2rem, 3.6vw, 3.2rem);
            line-height: 1.04;
            letter-spacing: -0.02em;
            text-wrap: balance;
        }

        .route-intro p {
            max-width: 48ch;
            margin: 0 0 26px;
            color: rgba(248, 246, 240, 0.72);
            line-height: 1.7;
        }

        .route {
            position: relative;
            margin: 0;
            padding: 0;
            list-style: none;
        }

            .route::before {
                content: '';
                position: absolute;
                left: 27px;
                top: 22px;
                bottom: 22px;
                width: 1px;
                background: linear-gradient(180deg, rgba(232, 223, 201, 0.55), rgba(232, 223, 201, 0.12));
            }

        .route__node {
            position: relative;
            padding: 18px 0 18px 76px;
        }

            .route__node::before {
                content: attr(data-step);
                position: absolute;
                left: 4px;
                top: 22px;
                display: grid;
                place-items: center;
                width: 48px;
                height: 48px;
                border: 1px solid rgba(232, 223, 201, 0.35);
                border-radius: 50%;
                background: var(--forest);
                color: var(--sand);
                font-family: var(--serif);
                font-size: 1rem;
                transition: border-color 0.4s var(--ease), transform 0.4s var(--ease-out);
            }

            .route__node:hover::before {
                border-color: var(--sand);
                transform: scale(1.06);
            }

            .route__node h3 {
                margin: 0 0 6px;
                color: var(--ivory);
                font-size: 1.3rem;
                letter-spacing: -0.01em;
            }

            .route__node p {
                max-width: 44ch;
                margin: 0;
                color: rgba(248, 246, 240, 0.7);
                font-size: 0.92rem;
                line-height: 1.6;
            }

        .route__mode {
            display: inline-block;
            margin-top: 10px;
            font-size: 0.62rem;
            letter-spacing: 0.18em;
            text-transform: uppercase;
            color: var(--sage);
        }

        /* ============================================================
                   SECTION 07A — TASTE TRAILS
                ============================================================ */
        .taste {
            display: grid;
            grid-template-columns: 1.2fr 0.8fr;
            gap: clamp(24px, 4vw, 64px);
            align-items: center;
        }

        .taste__media {
            position: relative;
            aspect-ratio: 5 / 4;
            overflow: hidden;
            border-radius: var(--radius-lg);
        }

            .taste__media img {
                width: 100%;
                height: 100%;
                object-fit: cover;
                transition: transform 1.2s var(--ease-out);
            }

            .taste__media:hover img {
                transform: scale(1.05);
            }

        .taste__body h2 {
            margin: 14px 0 18px;
            font-size: clamp(2rem, 3.4vw, 3rem);
            line-height: 1.04;
            letter-spacing: -0.02em;
            text-wrap: balance;
        }

        .taste__body > p {
            margin: 0;
            color: var(--muted);
            line-height: 1.7;
        }

        .taste__list {
            margin: 26px 0 28px;
            padding: 0;
            list-style: none;
            border-top: 1px solid var(--line);
        }

            .taste__list li {
                display: flex;
                align-items: center;
                justify-content: space-between;
                gap: 16px;
                padding: 16px 0;
                border-bottom: 1px solid var(--line);
            }

            .taste__list strong {
                display: block;
                font-family: var(--serif);
                font-size: 1.08rem;
                font-weight: 500;
                color: var(--charcoal);
            }

            .taste__list span {
                display: block;
                margin-top: 3px;
                font-size: 0.78rem;
                color: var(--muted);
            }

        .taste__tag {
            flex: 0 0 auto;
            padding: 5px 11px;
            border: 1px solid var(--line);
            border-radius: 999px;
            font-size: 0.62rem !important;
            letter-spacing: 0.14em;
            text-transform: uppercase;
            color: var(--moss) !important;
            background: var(--white);
        }

        /* ============================================================
                   SECTION 07B — RESORT ESCAPES
                ============================================================ */
        .retreat {
            display: grid;
            grid-template-columns: 0.95fr 1.05fr;
            gap: clamp(24px, 4vw, 64px);
            align-items: center;
        }

        .retreat__body h2 {
            margin: 14px 0 18px;
            color: var(--ivory);
            font-size: clamp(2rem, 3.4vw, 3rem);
            line-height: 1.04;
            letter-spacing: -0.02em;
            text-wrap: balance;
        }

        .retreat__body > p {
            margin: 0 0 22px;
            color: rgba(248, 246, 240, 0.72);
            line-height: 1.7;
        }

        .retreat__media {
            aspect-ratio: 4 / 5;
            overflow: hidden;
            border-radius: var(--radius-lg);
        }

            .retreat__media img {
                width: 100%;
                height: 100%;
                object-fit: cover;
                transition: transform 1.2s var(--ease-out);
            }

            .retreat__media:hover img {
                transform: scale(1.05);
            }

        .retreat__body .facilities {
            margin: 0 0 26px;
        }

        /* ============================================================
                   SECTION 08 — CURATED JOURNEYS
                ============================================================ */
        .journey-feature {
            display: grid;
            grid-template-columns: 1.05fr 0.95fr;
            overflow: hidden;
            background: var(--white);
            border: 1px solid var(--line);
            border-radius: var(--radius-lg);
            transition: border-color 0.4s var(--ease), box-shadow 0.5s var(--ease-out);
        }

            .journey-feature:hover {
                border-color: rgba(83, 107, 80, 0.25);
                box-shadow: 0 34px 70px -40px rgba(20, 39, 31, 0.42);
            }

        .journey-feature__media {
            min-height: 440px;
            overflow: hidden;
        }

            .journey-feature__media img {
                width: 100%;
                height: 100%;
                object-fit: cover;
                transition: transform 1.1s var(--ease-out);
            }

        .journey-feature:hover .journey-feature__media img {
            transform: scale(1.04);
        }

        .journey-feature__body {
            display: flex;
            flex-direction: column;
            gap: 14px;
            padding: clamp(26px, 4vw, 52px);
        }

            .journey-feature__body h3 {
                margin: 0;
                font-size: clamp(1.8rem, 2.8vw, 2.6rem);
                line-height: 1.04;
                letter-spacing: -0.02em;
            }

            .journey-feature__body p {
                margin: 0;
                color: var(--muted);
                line-height: 1.65;
            }

        .meta-row {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
        }

            .meta-row span {
                padding: 5px 11px;
                border: 1px solid var(--line);
                border-radius: 999px;
                background: var(--ivory);
                color: var(--muted);
                font-size: 0.64rem;
                letter-spacing: 0.12em;
                text-transform: uppercase;
            }

        .included {
            display: grid;
            gap: 8px;
            margin: 0;
            padding: 0;
            list-style: none;
        }

            .included li {
                position: relative;
                padding-left: 22px;
                color: var(--muted);
                font-size: 0.9rem;
                line-height: 1.55;
            }

                .included li::before {
                    content: '\2713';
                    position: absolute;
                    left: 0;
                    top: 0;
                    color: var(--moss);
                    font-size: 0.8rem;
                }

        .journey-feature__foot {
            display: flex;
            flex-wrap: wrap;
            align-items: end;
            justify-content: space-between;
            gap: 16px;
            margin-top: auto;
            padding-top: 18px;
            border-top: 1px solid var(--line);
        }

        .journey-list {
            margin-top: clamp(28px, 4vw, 44px);
            border-top: 1px solid var(--line);
        }

        .journey-row {
            display: grid;
            grid-template-columns: 150px 1fr auto;
            gap: clamp(18px, 3vw, 32px);
            align-items: center;
            padding: clamp(18px, 2.6vw, 28px) 0;
            border-bottom: 1px solid var(--line);
        }

        .journey-row__media {
            aspect-ratio: 3 / 2;
            overflow: hidden;
            border-radius: var(--radius);
        }

            .journey-row__media img {
                width: 100%;
                height: 100%;
                object-fit: cover;
                transition: transform 0.9s var(--ease-out);
            }

        .journey-row:hover .journey-row__media img {
            transform: scale(1.07);
        }

        .journey-row h3 {
            margin: 0 0 6px;
            font-size: 1.2rem;
            letter-spacing: -0.01em;
        }

        .journey-row p {
            margin: 0 0 10px;
            color: var(--muted);
            font-size: 0.9rem;
            line-height: 1.55;
        }

        .journey-row__action {
            display: flex;
            flex-direction: column;
            align-items: flex-end;
            gap: 8px;
            text-align: right;
        }

        /* ============================================================
                   SECTION 09 — THE KARNEL DIFFERENCE
                ============================================================ */
        .difference {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: clamp(30px, 5vw, 80px);
            align-items: center;
        }

        .difference__media {
            position: relative;
            min-height: clamp(420px, 44vw, 620px);
        }

            .difference__media img {
                position: absolute;
                display: block;
                object-fit: cover;
                border-radius: var(--radius-lg);
                box-shadow: 0 30px 60px -34px rgba(20, 39, 31, 0.5);
            }

                .difference__media img:first-child {
                    top: 0;
                    left: 0;
                    width: 72%;
                    height: 64%;
                }

                .difference__media img:last-child {
                    right: 0;
                    bottom: 0;
                    width: 56%;
                    height: 52%;
                    border: 8px solid var(--ivory);
                }

        .difference__body h2 {
            margin: 14px 0 18px;
            font-size: clamp(2rem, 3.6vw, 3.2rem);
            line-height: 1.04;
            letter-spacing: -0.02em;
            text-wrap: balance;
        }

        .difference__body > p {
            margin: 0;
            color: var(--muted);
            line-height: 1.7;
        }

        .difference__list {
            margin: 30px 0 0;
            padding: 0;
            list-style: none;
        }

            .difference__list li {
                display: grid;
                grid-template-columns: 48px 1fr;
                gap: 18px;
                padding: 16px 0;
                border-top: 1px solid var(--line);
            }

                .difference__list li:last-child {
                    border-bottom: 1px solid var(--line);
                }

            .difference__list b {
                font-family: var(--serif);
                font-size: 1rem;
                font-weight: 500;
                letter-spacing: 0.04em;
                color: var(--sage);
            }

            .difference__list h3 {
                margin: 0 0 4px;
                font-size: 1.05rem;
                letter-spacing: -0.01em;
            }

            .difference__list p {
                margin: 0;
                color: var(--muted);
                font-size: 0.9rem;
                line-height: 1.6;
            }

        /* ============================================================
                   SECTION 10 — FINAL JOURNEY CTA
                ============================================================ */
        .final-cta {
            position: relative;
            display: grid;
            place-items: center;
            min-height: clamp(560px, 76vh, 780px);
            overflow: hidden;
            color: var(--ivory);
            text-align: center;
            isolation: isolate;
        }

            .final-cta > img {
                position: absolute;
                inset: 0;
                z-index: -2;
                width: 100%;
                height: 100%;
                object-fit: cover;
                transform: scale(1.04);
            }

            .final-cta::after {
                content: '';
                position: absolute;
                inset: 0;
                z-index: -1;
                background: linear-gradient(180deg, rgba(20, 39, 31, 0.45), rgba(20, 39, 31, 0.82));
            }

            .final-cta .container {
                position: relative;
                z-index: 2;
                padding-top: 40px;
                padding-bottom: 40px;
            }

            .final-cta .eyebrow {
                color: var(--sage);
            }

            .final-cta h2 {
                max-width: 18ch;
                margin: 0 auto 20px;
                color: var(--ivory);
                font-size: clamp(2.4rem, 5.4vw, 4.6rem);
                line-height: 1.02;
                letter-spacing: -0.02em;
                text-wrap: balance;
            }

            .final-cta p {
                max-width: 54ch;
                margin: 0 auto 32px;
                color: rgba(248, 246, 240, 0.8);
                line-height: 1.7;
            }

            .final-cta .hero__cta {
                justify-content: center;
            }

        /* ============================================================
                   RESPONSIVE
                ============================================================ */
        @@media (max-width: 1080px) {
            .stay__grid {
                grid-template-columns: 1fr;
            }

            .stay-feature {
                min-height: 420px;
            }

            .route-layout {
                grid-template-columns: 1fr;
            }

            .taste {
                grid-template-columns: 1fr;
            }

            .taste__media {
                aspect-ratio: 16 / 10;
            }

            .retreat {
                grid-template-columns: 1fr;
            }

            .retreat__media {
                aspect-ratio: 16 / 10;
                order: -1;
            }

            .journey-feature {
                grid-template-columns: 1fr;
            }

            .journey-feature__media {
                min-height: 380px;
            }

            .difference {
                grid-template-columns: 1fr;
            }

            .difference__media {
                min-height: 460px;
                order: -1;
            }
        }

        @@media (max-width: 900px) {
            .discover__head {
                grid-template-columns: 1fr;
                align-items: start;
            }

            .discover__head-link {
                justify-self: start;
                margin-top: 8px;
            }

            .discover__grid {
                grid-template-columns: 1fr;
            }

            .discover__feature {
                min-height: 520px;
            }

            .discover__stack {
                grid-template-rows: auto auto;
            }

            .atlas-intro .container {
                grid-template-columns: 1fr;
            }

            .atlas-intro h2 {
                margin-bottom: 18px;
            }

            .stay-feature {
                grid-template-columns: 1fr;
            }

            .stay-feature__media {
                aspect-ratio: 16 / 10;
            }

            .journey-row {
                grid-template-columns: 120px 1fr;
            }

            .journey-row__action {
                grid-column: 2;
                flex-direction: row;
                align-items: center;
                justify-content: space-between;
                text-align: left;
            }
        }

        @@media (max-width: 720px) {
            .finder__fields--3,
            .finder__fields--2 {
                grid-template-columns: 1fr;
            }

            .finder__foot {
                flex-direction: column;
                align-items: stretch;
            }

                .finder__foot .btn {
                    width: 100%;
                }

            .discover__item {
                grid-template-columns: 1fr;
            }

            .discover__item-media {
                aspect-ratio: 16 / 10;
            }

            .stay-row {
                grid-template-columns: 104px 1fr;
            }

            .difference__media {
                min-height: 400px;
            }

                .difference__media img:first-child {
                    width: 78%;
                    height: 60%;
                }

                .difference__media img:last-child {
                    width: 60%;
                    height: 50%;
                    border-width: 6px;
                }
        }

        @@media (max-width: 600px) {
            .hero {
                min-height: auto;
                padding: calc(var(--header-h) + 40px) 0 150px;
            }

            .hero__scroll {
                display: none;
            }

            .finder-band {
                margin-top: -70px;
            }

            .finder__tabs {
                padding: 0 18px;
            }

            .finder__tab {
                padding: 13px 14px;
            }

                .finder__tab::after {
                    left: 14px;
                    right: 14px;
                }

            .discover__feature {
                min-height: 460px;
            }

            .journey-row {
                grid-template-columns: 1fr;
            }

            .journey-row__action {
                grid-column: 1;
            }

            .journey-feature__media {
                min-height: 280px;
            }

            .journey-feature__body {
                padding: 24px;
            }
        }

        /* ============================================================
                   REDUCED MOTION
                ============================================================ */
        @@media (prefers-reduced-motion: reduce) {
            html {
                scroll-behavior: auto;
            }

            .hero__content > * {
                opacity: 1 !important;
                transform: none !important;
                filter: none !important;
                animation: none !important;
            }

            .hero__scroll::after,
            .finder__panel {
                animation: none !important;
            }

            .reveal-pending {
                opacity: 1 !important;
                transform: none !important;
                filter: none !important;
                transition: none !important;
            }

            .archive *, .arch-grid *, .arch-lit * {
                animation-duration: 0.01ms !important;
                transition-duration: 0.14s !important;
            }
        }
    </style>
}

<!-- ==================== SECTION 01 — CINEMATIC HERO ==================== -->
<section class="hero">
    <div class="hero__media media" data-fallback-label="Northern Pakistan mountain landscape">
        <img src="@(string.IsNullOrWhiteSpace(websiteContent.HomeHeroImageUrl) ? "https://images.unsplash.com/photo-1506905925346-21bda4d32df4?auto=format&fit=crop&w=1920&q=80" : websiteContent.HomeHeroImageUrl)"
             alt="Snow-capped mountains of northern Pakistan at golden hour"
             fetchpriority="high" />
        <div class="hero__overlay" aria-hidden="true"></div>
    </div>

    <div class="container hero__content">
        <p class="eyebrow">Your Next Chapter Begins Here</p>
        <h1>@(string.IsNullOrWhiteSpace(websiteContent.HomeHeroHeading) ? "Find your way to somewhere wonderful." : websiteContent.HomeHeroHeading)</h1>
        <p class="hero__lede">@(string.IsNullOrWhiteSpace(websiteContent.HomeHeroSubtitle) ? "Karnel Travel Guide brings destinations, transport, accommodation, dining and travel packages together, so your next journey across Pakistan starts with confidence." : websiteContent.HomeHeroSubtitle)</p>
        <div class="hero__cta">
            <a class="btn btn--light" href="@Url.Action("Index", "Search")">@(string.IsNullOrWhiteSpace(websiteContent.HomeHeroButtonText) ? "Explore destinations" : websiteContent.HomeHeroButtonText)</a>
            <a class="btn btn--ghost-light" href="@Url.Action("Index", "Contact")">Plan Your Journey</a>
        </div>
        <div class="hero__meta">
            <div>
                <strong>21</strong>
                <span>Nature spots</span>
            </div>
            <div>
                <strong>06</strong>
                <span>Travel categories</span>
            </div>
            <div>
                <strong>01</strong>
                <span>Guide to Pakistan</span>
            </div>
        </div>
    </div>

    <div class="hero__scroll" aria-hidden="true">Scroll</div>
</section>

<!-- ==================== SECTION 02 — INTELLIGENT JOURNEY FINDER ==================== -->
<section class="finder-band" aria-labelledby="finder-title">
    <div class="container">
        <form class="finder" id="home-search" action="@Url.Action("Index", "Search")" method="get" novalidate>
            <div class="finder__head">
                <div>
                    <p class="eyebrow">Intelligent Journey Finder</p>
                    <h2 id="finder-title">Start with a place, a stay, or a way to get there.</h2>
                </div>
                <span class="badge">Sample search — refine in Advanced Discovery</span>
            </div>

            <input type="hidden" name="category" id="finder-category" value="destinations" />

            <div class="finder__tabs" role="tablist" aria-label="Journey categories">
                <button class="finder__tab is-active" type="button" role="tab" id="finder-tab-destinations"
                        aria-controls="finder-panel-destinations" aria-selected="true" tabindex="0"
                        data-finder-tab="destinations">
                    Destinations
                </button>
                <button class="finder__tab" type="button" role="tab" id="finder-tab-hotels"
                        aria-controls="finder-panel-hotels" aria-selected="false" tabindex="-1"
                        data-finder-tab="hotels">
                    Hotels
                </button>
                <button class="finder__tab" type="button" role="tab" id="finder-tab-transport"
                        aria-controls="finder-panel-transport" aria-selected="false" tabindex="-1"
                        data-finder-tab="transport">
                    Transport
                </button>
                <button class="finder__tab" type="button" role="tab" id="finder-tab-restaurants"
                        aria-controls="finder-panel-restaurants" aria-selected="false" tabindex="-1"
                        data-finder-tab="restaurants">
                    Restaurants
                </button>
                <button class="finder__tab" type="button" role="tab" id="finder-tab-packages"
                        aria-controls="finder-panel-packages" aria-selected="false" tabindex="-1"
                        data-finder-tab="packages">
                    Packages
                </button>
            </div>

            <div class="finder__panels">
                <div class="finder__panel is-active" id="finder-panel-destinations"
                     role="tabpanel" aria-labelledby="finder-tab-destinations" data-finder-panel="destinations">
                    <div class="finder__fields finder__fields--3">
                        <label class="field">
                            <span>Destination or keyword</span>
                            <input type="text" name="keyword" placeholder="e.g. Hunza, Skardu, Lahore" autocomplete="off" />
                        </label>
                        <label class="field">
                            <span>Region</span>
                            <select name="region">
                                <option value="">All regions</option>
                                <option value="gilgit-baltistan">Gilgit-Baltistan</option>
                                <option value="khyber-pakhtunkhwa">Khyber Pakhtunkhwa</option>
                                <option value="punjab">Punjab</option>
                                <option value="sindh">Sindh</option>
                                <option value="balochistan">Balochistan</option>
                                <option value="azad-kashmir">Azad Kashmir</option>
                            </select>
                        </label>
                        <label class="field">
                            <span>Approx. budget (PKR)</span>
                            <select name="budget">
                                <option value="">Any budget</option>
                                <option value="25000">Up to 25,000</option>
                                <option value="50000">Up to 50,000</option>
                                <option value="100000">Up to 100,000</option>
                                <option value="200000">Up to 200,000</option>
                            </select>
                        </label>
                    </div>
                </div>

                <div class="finder__panel" id="finder-panel-hotels"
                     role="tabpanel" aria-labelledby="finder-tab-hotels" data-finder-panel="hotels" hidden>
                    <div class="finder__fields finder__fields--3">
                        <label class="field">
                            <span>City or hotel name</span>
                            <input type="text" name="keyword" placeholder="e.g. Hunza, Lahore, Karachi" autocomplete="off" />
                        </label>
                        <label class="field">
                            <span>Guests</span>
                            <select name="guests">
                                <option value="">Any number</option>
                                <option value="1">1 guest</option>
                                <option value="2">2 guests</option>
                                <option value="3">3 guests</option>
                                <option value="4">4 guests</option>
                                <option value="5">5+ guests</option>
                            </select>
                        </label>
                        <label class="field">
                            <span>Approx. budget (PKR)</span>
                            <select name="budget">
                                <option value="">Any budget</option>
                                <option value="25000">Up to 25,000</option>
                                <option value="50000">Up to 50,000</option>
                                <option value="100000">Up to 100,000</option>
                                <option value="200000">Up to 200,000</option>
                            </select>
                        </label>
                    </div>
                </div>

                <div class="finder__panel" id="finder-panel-transport"
                     role="tabpanel" aria-labelledby="finder-tab-transport" data-finder-panel="transport" hidden>
                    <div class="finder__fields finder__fields--3">
                        <label class="field">
                            <span>From</span>
                            <input type="text" name="from" placeholder="e.g. Islamabad" autocomplete="off" />
                        </label>
                        <label class="field">
                            <span>To</span>
                            <input type="text" name="to" placeholder="e.g. Gilgit" autocomplete="off" />
                        </label>
                        <label class="field">
                            <span>Mode of travel</span>
                            <select name="mode">
                                <option value="">Any mode</option>
                                <option value="bus">Bus &amp; Coach</option>
                                <option value="private-car">Private Car</option>
                                <option value="shared">Shared Transport</option>
                                <option value="air">Air Travel</option>
                            </select>
                        </label>
                    </div>
                </div>

                <div class="finder__panel" id="finder-panel-restaurants"
                     role="tabpanel" aria-labelledby="finder-tab-restaurants" data-finder-panel="restaurants" hidden>
                    <div class="finder__fields finder__fields--3">
                        <label class="field">
                            <span>Restaurant or dish</span>
                            <input type="text" name="keyword" placeholder="e.g. apricot, karahi" autocomplete="off" />
                        </label>
                        <label class="field">
                            <span>City</span>
                            <input type="text" name="city" placeholder="e.g. Lahore" autocomplete="off" />
                        </label>
                        <label class="field">
                            <span>Cuisine</span>
                            <select name="cuisine">
                                <option value="">Any cuisine</option>
                                <option value="pakistani">Pakistani</option>
                                <option value="regional">Regional</option>
                                <option value="street-food">Street food</option>
                                <option value="continental">Continental</option>
                            </select>
                        </label>
                    </div>
                </div>

                <div class="finder__panel" id="finder-panel-packages"
                     role="tabpanel" aria-labelledby="finder-tab-packages" data-finder-panel="packages" hidden>
                    <div class="finder__fields finder__fields--3">
                        <label class="field">
                            <span>Destination or theme</span>
                            <input type="text" name="keyword" placeholder="e.g. Northern Escape" autocomplete="off" />
                        </label>
                        <label class="field">
                            <span>Duration</span>
                            <select name="duration">
                                <option value="">Any duration</option>
                                <option value="3">3–4 nights</option>
                                <option value="5">5–6 nights</option>
                                <option value="7">7+ nights</option>
                            </select>
                        </label>
                        <label class="field">
                            <span>Approx. budget (PKR)</span>
                            <select name="budget">
                                <option value="">Any budget</option>
                                <option value="50000">Up to 50,000</option>
                                <option value="100000">Up to 100,000</option>
                                <option value="200000">Up to 200,000</option>
                                <option value="300000">Up to 300,000</option>
                            </select>
                        </label>
                    </div>
                </div>
            </div>

            <div class="finder__foot">
                <p class="finder__note">
                    Looking for more control? Try
                    <a href="@Url.Action("Advanced", "Search")#discovery">Advanced Discovery</a>
                    to refine by region, facilities and rating.
                </p>
                <button class="btn" type="submit">Search journeys</button>
            </div>
        </form>
    </div>
</section>

<!-- ==================== SECTION 03 — DISCOVER PAKISTAN ==================== -->
<section class="section section--ivory" aria-labelledby="discover-title">
    <div class="container">
        <div class="discover__head">
            <div class="section-head" data-reveal>
                <p class="eyebrow">Discover Pakistan</p>
                <h2 id="discover-title">Places worth the detour.</h2>
                <p>
                    A small, curated collection of regions across Pakistan — chosen for their
                    landscape, history and quiet moments in between.
                </p>
            </div>
            <a class="link-arrow discover__head-link" href="@Url.Action("Index", "Destinations")" data-reveal>
                Explore all destinations
            </a>
        </div>

        @{ var featuredDestinations = (ViewBag.FeaturedDestinations as IEnumerable<KarnelTravel.Models.Destination>)?.ToList() ?? new List<KarnelTravel.Models.Destination>(); }
        @if (featuredDestinations.Any())
        {
            <div class="discover__grid" data-reveal-group>
            <article class="discover__feature" data-reveal>
                <a href="@Url.Action("Details", "Destinations", new { slug = featuredDestinations[0].Slug })">
                @if (!string.IsNullOrWhiteSpace(featuredDestinations[0].ImageUrl))
                {
                    <img src="@featuredDestinations[0].ImageUrl" alt="@featuredDestinations[0].Name" loading="lazy" decoding="async" />
                }
                <div class="discover__feature-body">
                    <span class="discover__region">@featuredDestinations[0].Region</span>
                    <h3>@featuredDestinations[0].Name</h3>
                    <p>@featuredDestinations[0].ShortDescription</p>
                    <span class="link-arrow link-arrow--light">Explore @featuredDestinations[0].Name</span>
                </div>
                </a>
            </article>

            <div class="discover__stack">
                @foreach (var destination in featuredDestinations.Skip(1).Take(2))
                {
                <article class="discover__item" data-reveal>
                    <a href="@Url.Action("Details", "Destinations", new { slug = destination.Slug })">
                    <div class="discover__item-media">
                        @if (!string.IsNullOrWhiteSpace(destination.ImageUrl))
                        {
                            <img src="@destination.ImageUrl" alt="@destination.Name" loading="lazy" decoding="async" />
                        }
                    </div>
                    <div class="discover__item-body">
                        <span class="region-tag">@destination.Region</span>
                        <h3>@destination.Name</h3>
                        <p>@destination.ShortDescription</p>
                        <span class="link-arrow">Explore @destination.Name</span>
                    </div>
                    </a>
                </article>
                }
            </div>
            </div>
        }
        else
        {
            <div class="notice">Published destinations will appear here when they are available.</div>
        }
    </div>
</section>

<!-- ==================== SECTION 04 — EXPLORE PLACES INTRO ==================== -->
