@section Scripts {
    <script>
        /* ============================================================
           NATURE SPOTS — Fibonacci sphere, drag-to-rotate, scroll dolly,
           flat grid, lightbox. Self-contained.
           Each entry carries its own thumb + full URL (no CDN base).
        ============================================================ */
        (function () {
            'use strict';

            var shots = [
                { thumb: 'https://images.unsplash.com/photo-1506905925346-21bda4d32df4?auto=format&fit=crop&w=800&q=75',
                  full:  'https://images.unsplash.com/photo-1506905925346-21bda4d32df4?auto=format&fit=crop&w=1600&q=85',
                  title: 'Rakaposhi at First Light',
                  place: 'Hunza Valley · Gilgit-Baltistan',
                  note: 'The peak does not appear so much as arrive. One moment the valley is dark, the next the summit holds all the light there is. Hunza rewards early risers.' },

                { thumb: 'https://images.unsplash.com/photo-1464822759023-fed622ff2c3b?auto=format&fit=crop&w=800&q=75',
                  full:  'https://images.unsplash.com/photo-1464822759023-fed622ff2c3b?auto=format&fit=crop&w=1600&q=85',
                  title: 'Shangrila Lake',
                  place: 'Skardu · Baltistan',
                  note: 'Cold desert on one shore, alpine water on the other. Skardu is a gateway to some of the highest peaks on earth and the quietest lakes in the country.' },

                { thumb: 'https://images.unsplash.com/photo-1519681393784-d120267933ba?auto=format&fit=crop&w=800&q=75',
                  full:  'https://images.unsplash.com/photo-1519681393784-d120267933ba?auto=format&fit=crop&w=1600&q=85',
                  title: 'Snow Line',
                  place: 'Nanga Parbat · Diamer',
                  note: 'The snow line is not a line. It is a slow negotiation between altitude, wind and time. Every hour it looks different and by evening it has moved.' },

                { thumb: 'https://images.unsplash.com/photo-1441974231531-c6227db76b6e?auto=format&fit=crop&w=800&q=75',
                  full:  'https://images.unsplash.com/photo-1441974231531-c6227db76b6e?auto=format&fit=crop&w=1600&q=85',
                  title: 'Forest Floor',
                  place: 'Ayubia National Park',
                  note: 'A short drive from the plains and suddenly it is quiet. The pines filter what little light gets through, and the ground absorbs whatever sound is left.' },

                { thumb: 'https://images.unsplash.com/photo-1470071459604-3b5ec3a7fe05?auto=format&fit=crop&w=800&q=75',
                  full:  'https://images.unsplash.com/photo-1470071459604-3b5ec3a7fe05?auto=format&fit=crop&w=1600&q=85',
                  title: 'Morning Fog',
                  place: 'Murree Hills · Punjab',
                  note: 'The fog rolls in most mornings. It lifts slowly and returns suddenly, and that rhythm is the whole weather report. You learn to read the hills by silhouette.' },

                { thumb: 'https://images.unsplash.com/photo-1447752875215-b2761acb3c5d?auto=format&fit=crop&w=800&q=75',
                  full:  'https://images.unsplash.com/photo-1447752875215-b2761acb3c5d?auto=format&fit=crop&w=1600&q=85',
                  title: 'Trail Through Pines',
                  place: 'Naran · Kaghan Valley',
                  note: 'A path that keeps promising something around the next bend and never quite delivers. That is the point, and it is why people walk it twice.' },

                { thumb: 'https://images.unsplash.com/photo-1501785888041-af3ef285b470?auto=format&fit=crop&w=800&q=75',
                  full:  'https://images.unsplash.com/photo-1501785888041-af3ef285b470?auto=format&fit=crop&w=1600&q=85',
                  title: 'Still Water',
                  place: 'Saif-ul-Malook · Kaghan',
                  note: 'A glacial lake with a reflection that is more truthful than the mountain itself. After a while you notice nothing has moved, and you have not either.' },

                { thumb: 'https://images.unsplash.com/photo-1500534623283-312aade485b7?auto=format&fit=crop&w=800&q=75',
                  full:  'https://images.unsplash.com/photo-1500534623283-312aade485b7?auto=format&fit=crop&w=1600&q=85',
                  title: 'High Meadow',
                  place: 'Fairy Meadows · Diamer',
                  note: 'Grass at altitude. Everything here is smaller, slower and more deliberate than it looks from the road, and the road is very far below.' },

                { thumb: 'https://images.unsplash.com/photo-1426604966848-d7adac402bff?auto=format&fit=crop&w=800&q=75',
                  full:  'https://images.unsplash.com/photo-1426604966848-d7adac402bff?auto=format&fit=crop&w=1600&q=85',
                  title: 'Valley View',
                  place: 'Chitral · Khyber Pakhtunkhwa',
                  note: 'Chitral is a valley you read by its rivers. The main one runs dark green most of the year and brown in July, and the locals know exactly which week is which.' },

                { thumb: 'https://images.unsplash.com/photo-1444927714506-8492d94b4e3d?auto=format&fit=crop&w=800&q=75',
                  full:  'https://images.unsplash.com/photo-1444927714506-8492d94b4e3d?auto=format&fit=crop&w=1600&q=85',
