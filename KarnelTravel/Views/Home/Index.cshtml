<section class="section section--sand" aria-labelledby="journeys-title">
    <div class="container">
        @{ var featuredPackages = (ViewBag.FeaturedPackages as IEnumerable<KarnelTravel.Models.TourPackage>)?.ToList() ?? new List<KarnelTravel.Models.TourPackage>(); }
        <div class="section-head" data-reveal>
            <p class="eyebrow">Curated Journeys</p>
            <h2 id="journeys-title">Travel packages for the way you want to go.</h2>
            <p>
                Explore published itineraries, destinations and pricing from our travel catalogue.
            </p>
        </div>

        @if (featuredPackages.Any())
        {
            var primaryPackage = featuredPackages[0];
            <article class="journey-feature" data-reveal>
                <div class="journey-feature__media">
                    <img src="@(string.IsNullOrWhiteSpace(primaryPackage.ImageUrl) ? "https://images.unsplash.com/photo-1501785888041-af3ef285b470?auto=format&fit=crop&w=1200&q=80" : primaryPackage.ImageUrl)"
                         alt="@primaryPackage.Name" loading="lazy" decoding="async" />
                </div>
                <div class="journey-feature__body">
                    <span class="region-tag">@primaryPackage.DestinationName</span>
                    <h3>@primaryPackage.Name</h3>
                    <div class="meta-row">
                        <span>@primaryPackage.DurationDays days</span>
                        @if (primaryPackage.PricePerAdult.HasValue)
                        {
                            <span>From PKR @primaryPackage.PricePerAdult.Value.ToString("N0")</span>
                        }
                    </div>
                    <p>@primaryPackage.ShortDescription</p>
                    <div class="journey-feature__foot">
                        <div class="price">
                            <small>Price / adult</small>
                            @if (primaryPackage.PricePerAdult.HasValue)
                            {
                                <span>PKR @primaryPackage.PricePerAdult.Value.ToString("N0")</span>
                            }
                            else
                            {
                                <span>Contact us</span>
                            }
                        </div>
                        <a class="btn btn--forest" href="@Url.Action("Details", "Tours", new { slug = primaryPackage.Slug })">View package</a>
                    </div>
                </div>
            </article>

            @if (featuredPackages.Count > 1)
            {
                <div class="journey-list" data-reveal-group>
                    @foreach (var package in featuredPackages.Skip(1).Take(2))
                    {
                        <article class="journey-row" data-reveal>
                            <div class="journey-row__media">
                                <img src="@(string.IsNullOrWhiteSpace(package.ImageUrl) ? "https://images.unsplash.com/photo-1500534623283-312aade485b7?auto=format&fit=crop&w=400&q=70" : package.ImageUrl)"
                                     alt="@package.Name" loading="lazy" decoding="async" />
                            </div>
                            <div>
                                <span class="region-tag">@package.DestinationName</span>
                                <h3>@package.Name</h3>
                                <p>@package.ShortDescription</p>
                                <div class="meta-row">
                                    <span>@package.DurationDays days</span>
                                    @if (package.PricePerAdult.HasValue)
                                    {
                                        <span>From PKR @package.PricePerAdult.Value.ToString("N0")</span>
                                    }
                                </div>
                            </div>
                            <div class="journey-row__action">
                                <div class="price">
                                    <small>Price / adult</small>
                                    @if (package.PricePerAdult.HasValue)
                                    {
                                        <span>PKR @package.PricePerAdult.Value.ToString("N0")</span>
                                    }
                                    else
                                    {
                                        <span>Contact us</span>
                                    }
                                </div>
                                <a class="link-arrow" href="@Url.Action("Details", "Tours", new { slug = package.Slug })">View package</a>
                            </div>
                        </article>
                    }
                </div>
            }
        }
        else
        {
            <div class="notice">Published travel packages will appear here when they are available.</div>
        }
    </div>
</section>

