                  title: 'Desert Dunes',
                  place: 'Thar · Sindh',
                  note: 'Thar is a landscape of interruptions: dune, thorn, then nothing, then dune again. The heat rearranges things faster than memory can hold.' },

                { thumb: 'https://images.unsplash.com/photo-1504198453319-5ce911bafcde?auto=format&fit=crop&w=800&q=75',
                  full:  'https://images.unsplash.com/photo-1504198453319-5ce911bafcde?auto=format&fit=crop&w=1600&q=85',
                  title: 'Winter Stillness',
                  place: 'Kalam · Swat',
                  note: 'Kalam in winter is a place of held breath. The river keeps moving because it has to; everything else has agreed to wait.' },

                { thumb: 'https://images.unsplash.com/photo-1465056836041-7f43ac27dcb5?auto=format&fit=crop&w=800&q=75',
                  full:  'https://images.unsplash.com/photo-1465056836041-7f43ac27dcb5?auto=format&fit=crop&w=1600&q=85',
                  title: 'Rock & Ice',
                  place: 'Passu Glacier · Hunza',
                  note: 'Glaciers are slow rivers. Passu moves about a metre a day, which is fast for ice and slow for everything else. The sound is the thing you remember.' },

                { thumb: 'https://images.unsplash.com/photo-1444464666168-49d633b86797?auto=format&fit=crop&w=800&q=75',
                  full:  'https://images.unsplash.com/photo-1444464666168-49d633b86797?auto=format&fit=crop&w=1600&q=85',
                  title: 'Autumn Birches',
                  place: 'Kalash Valleys · Chitral',
                  note: 'The Kalash valleys turn gold in October. For two weeks the whole hillside becomes the subject, and then it becomes the ground.' },

                { thumb: 'https://images.unsplash.com/photo-1476231682828-37e571bc172f?auto=format&fit=crop&w=800&q=75',
                  full:  'https://images.unsplash.com/photo-1476231682828-37e571bc172f?auto=format&fit=crop&w=1600&q=85',
                  title: 'Moonrise',
                  place: 'Khunjerab Pass · Gilgit-Baltistan',
                  note: 'At 4,700 m the air is thinner and the night is louder. Khunjerab is a pass you feel before you see it, and you remember it before you understand it.' },

                { thumb: 'https://images.unsplash.com/photo-1439853949127-fa647821eba0?auto=format&fit=crop&w=800&q=75',
                  full:  'https://images.unsplash.com/photo-1439853949127-fa647821eba0?auto=format&fit=crop&w=1600&q=85',
                  title: 'Coastline',
                  place: 'Gwadar · Balochistan',
                  note: 'The Makran coast is a thin line of road between the sea and the hills. For hours there is nothing else, and that is exactly what it is for.' },

                { thumb: 'https://images.unsplash.com/photo-1502082553048-f009c37129b9?auto=format&fit=crop&w=800&q=75',
                  full:  'https://images.unsplash.com/photo-1502082553048-f009c37129b9?auto=format&fit=crop&w=1600&q=85',
                  title: 'Riverside',
                  place: 'Kalam · Swat',
                  note: 'The river runs cold all year. Locals walk its edge in the evening; visitors learn to do the same, and stop checking the time.' },

                { thumb: 'https://images.unsplash.com/photo-1432405972618-c60b0225b8f9?auto=format&fit=crop&w=800&h=1000&q=75',
                  full:  'https://images.unsplash.com/photo-1432405972618-c60b0225b8f9?auto=format&fit=crop&w=1400&h=1750&q=85',
                  title: 'Above the Clouds',
                  place: 'Rakaposhi Base Camp',
                  note: 'Not every entry has to be a landscape. Sometimes it is a single moment above the cloud line, when the weather agrees to hold still.',
                  tall: true },

                { thumb: 'https://images.unsplash.com/photo-1476514525535-07fb3b4ae5f1?auto=format&fit=crop&w=800&q=75',
                  full:  'https://images.unsplash.com/photo-1476514525535-07fb3b4ae5f1?auto=format&fit=crop&w=1600&q=85',
                  title: 'Beyond the Trail',
                  place: 'Margalla Hills · Islamabad',
                  note: 'The hills above the capital are easy to dismiss until you walk them. Then they stop being background and start being the day.' }
            ];

            var stage    = document.getElementById('arch-stage');
            var archive  = document.getElementById('archive');
            var world    = document.getElementById('arch-world');
            var orb      = document.getElementById('arch-orb');
            var headline = document.getElementById('arch-headline');
            var label    = document.getElementById('arch-label');
            var gridEl   = document.getElementById('arch-grid');
            var gridRows = document.getElementById('arch-grid-rows');
            var gridBtn  = document.getElementById('arch-grid-btn');
            var litEl    = document.getElementById('arch-lit');
            var litImg   = document.getElementById('arch-lit-img');
            var litTitle = document.getElementById('arch-lit-title');
            var litWhere = document.getElementById('arch-lit-where');
            var litNote  = document.getElementById('arch-lit-note');

            if (!stage || !archive) return;

            var cards = [];
            var R = 300, cw = 130, persp = 1150;
            var spin = 0, tilt = -4, dragX = 0, dragY = 0, velX = 0, velY = 0, camZ = 0;
            var dragging = false, lit = false, focused = -1;
            var litToken = 0;
            var raf = null;
            var layoutScheduled = false;

            /* ---------- Build cards on a Fibonacci sphere ---------- */
            var N = shots.length;
            var GA = Math.PI * (3 - Math.sqrt(5));

            for (var i = 0; i < N; i++) {
                var y = 1 - (i / (N - 1)) * 2;
                var rad = Math.sqrt(Math.max(0, 1 - y * y));
                var theta = i * GA;
                var x = Math.cos(theta) * rad;
                var z = Math.sin(theta) * rad;
                var lat = Math.asin(y) * 180 / Math.PI;
                var lon = Math.atan2(x, z) * 180 / Math.PI;

                var el = document.createElement('div');
                el.className = 'arch-card' + (shots[i].tall ? ' is-tall' : '');
                el.dataset.idx = i;

                var fig = document.createElement('figure');
                var img = document.createElement('img');
                img.alt = shots[i].title;
                img.crossOrigin = 'anonymous';
                fig.appendChild(img);
                el.appendChild(fig);
                orb.appendChild(el);

                cards.push({
                    el: el,
                    imgEl: img,
                    ux: x, uy: y, uz: z,
                    lat: lat, lon: lon,
                    lastD: -1
                });
            }

            /* ---------- Build the flat grid ---------- */
            shots.forEach(function (shot, i) {
                var fig = document.createElement('figure');
                fig.dataset.idx = i;
                var im = document.createElement('img');
                im.alt = shot.title;
                im.loading = 'lazy';
                var cap = document.createElement('figcaption');
                cap.textContent = shot.title;
                fig.appendChild(im);
                fig.appendChild(cap);
                gridRows.appendChild(fig);
            });

            /* ---------- Layout ---------- */
            function resize() {
                var w = window.innerWidth;
                var h = window.innerHeight;
                var hr = w <= 380 ? 0.38 : w <= 640 ? 0.42 : 0.46;
                var wr = w <= 380 ? 0.48 : w <= 640 ? 0.52 : 0.58;
                var floor = w <= 380 ? 108 : w <= 640 ? 120 : 155;
                R = Math.max(floor, Math.min(480, h * hr, w * wr));

                var scale = w <= 380 ? 0.44 : w <= 640 ? 0.46 : 0.47;
                cw = Math.round(Math.max(72, R * scale));

                persp = w <= 380 ? 620 : w <= 640 ? 760 : w <= 900 ? 920 : 1150;
                stage.style.perspective = persp + 'px';
                stage.style.setProperty('--persp', persp + 'px');

                cards.forEach(function (c) {
                    var idx = parseInt(c.el.dataset.idx, 10);
                    var tall = shots[idx] && shots[idx].tall;
                    c.el.style.width  = cw + 'px';
                    c.el.style.height = tall ? (cw * 1.25) + 'px' : (cw / 1.5) + 'px';
                    c.el.style.marginLeft = (-cw / 2) + 'px';
                    c.el.style.marginTop  = tall ? (-cw * 0.625) + 'px' : (-cw / 3) + 'px';
                    c.el.style.transform =
                        'translate3d(' + (c.ux * R) + 'px,' +
                                         (-c.uy * R) + 'px,' +
                                         (c.uz * R) + 'px) ' +
                        'rotateY(' + c.lon + 'deg) ' +
                        'rotateX(' + c.lat + 'deg)';
                });
                layoutScheduled = false;
            }

            function scheduleLayout() {
                if (layoutScheduled) return;
                layoutScheduled = true;
                requestAnimationFrame(resize);
            }

            /* ---------- Downscale thumbs via canvas (webp q0.88) ---------- */
            function downscale(url, maxW) {
                return new Promise(function (resolve) {
                    var im = new Image();
                    im.crossOrigin = 'anonymous';
                    im.onload = function () {
                        if (im.naturalWidth <= maxW) return resolve(url);
                        try {
                            var s = maxW / im.naturalWidth;
                            var cvs = document.createElement('canvas');
                            cvs.width = maxW;
                            cvs.height = Math.round(im.naturalHeight * s);
                            cvs.getContext('2d').drawImage(im, 0, 0, cvs.width, cvs.height);
                            cvs.toBlob(function (blob) {
                                resolve(blob ? URL.createObjectURL(blob) : url);
                            }, 'image/webp', 0.88);
                        } catch (e) { resolve(url); }
                    };
                    im.onerror = function () { resolve(url); };
                    im.src = url;
                });
            }

            function decodeMax() {
                var w = window.innerWidth;
                return w <= 380 ? 420 : w <= 640 ? 520 : w <= 900 ? 640 : 760;
            }

            function loadAll() {
                var maxW = decodeMax();
                shots.forEach(function (s, i) {
                    downscale(s.thumb, maxW).then(function (src) {
                        var cardImg = cards[i].imgEl;
                        cardImg.onload = function () { cards[i].el.classList.add('in'); };
                        cardImg.src = src;
                        var gridFig = gridRows.querySelector('figure[data-idx="' + i + '"]');
                        if (gridFig) {
                            var gImg = gridFig.querySelector('img');
                            if (gImg) gImg.src = src;
                        }
                    });
                });
            }

            /* ---------- Scroll progress of the archive section ---------- */
            function getProgress() {
                var rect = archive.getBoundingClientRect();
                var total = archive.offsetHeight - window.innerHeight;
                if (total <= 0) return 0;
                var scrolled = Math.min(Math.max(-rect.top, 0), total);
                return scrolled / total;
            }

            /* ---------- Camera loop ---------- */
            function frame() {
                var inView = document.body.classList.contains('arch-inview');
                var overlay = document.body.classList.contains('arch-gridview') ||
                              document.body.classList.contains('arch-lit');
                if (!inView && !overlay) { raf = null; return; }

                if (!dragging && !lit) {
                    dragX += velX;
                    dragY += velY;
                    velX *= 0.94;
                    velY *= 0.94;
                    if (Math.abs(velX) < 0.002) velX = 0;
                    if (Math.abs(velY) < 0.002) velY = 0;
                }
                var minDY = -32 - tilt;
                var maxDY =  32 - tilt;
                if (dragY < minDY) dragY = minDY;
                if (dragY > maxDY) dragY = maxDY;

                var p = getProgress();
                var camZTarget = p * Math.min(64, R * 0.12);
                camZ += (camZTarget - camZ) * 0.075;

                var sx = tilt + dragY;
                var sy = spin + dragX;

                world.style.transform =
                    'translateZ(' + camZ + 'px) ' +
                    'rotateY(' + sy + 'deg) ' +
                    'rotateX(' + sx + 'deg)';

                headline.style.transform =
                    'rotateX(' + (-sx) + 'deg) ' +
                    'rotateY(' + (-sy) + 'deg) ' +
                    'translateZ(' + (R * 0.62) + 'px)';
                headline.style.opacity = Math.max(0, 1 - p * 0.55).toFixed(3);

                if (label) label.style.opacity = Math.max(0, 1 - p * 1.8).toFixed(3);

                var shade = 1 - Math.min(1, p * 1.6);
                var near  = persp * 0.66;
                var cy = Math.cos(sy * Math.PI / 180), cyS = Math.sin(sy * Math.PI / 180);
                var cx = Math.cos(sx * Math.PI / 180), cxS = Math.sin(sx * Math.PI / 180);

                for (var i = 0; i < cards.length; i++) {
                    var c = cards[i];
                    var x1 = c.ux * cy + c.uz * cyS;
                    var y1 = c.uy;
                    var z1 = -c.ux * cyS + c.uz * cy;
                    var y2 = y1 * cx - z1 * cxS;
                    var z2 = y1 * cxS + z1 * cx;
                    var zf = z2;

                    var base = 0.14 + 0.86 * Math.pow((zf + 1) / 2, 0.85);
                    var d = shade * (1 - base);
                    var f = 1;
                    var absZ = zf * R + camZ;
                    if (absZ > near) f = Math.max(0, 1 - (absZ - near) / 190);

                    if (lit) {
                        d = Math.min(1, d + 0.78);
                        if (i === focused) f = 0;
                    }

                    var fs = String(f);
                    if (c.el.style.opacity !== fs) c.el.style.opacity = fs;
                    if (c.lastD !== d) {
                        c.el.style.setProperty('--d', d.toFixed(3));
                        c.lastD = d;
                    }
                }

                raf = requestAnimationFrame(frame);
            }

            /* ---------- Drag ---------- */
            stage.addEventListener('pointerdown', function (e) {
                if (lit) return;
                if (e.button !== undefined && e.button !== 0) return;

                var target = e.target;
                var cardEl = target && target.closest ? target.closest('.arch-card') : null;
                var startX = e.clientX, startY = e.clientY;
                var isTouch = e.pointerType === 'touch';
                var slop = isTouch ? 14 : 6;
                var captured = !isTouch;
                var lastX = startX, lastY = startY;
                dragging = true;

                if (captured) {
                    try { stage.setPointerCapture(e.pointerId); } catch (_) {}
                }

                function onMove(ev) {
                    if (ev.pointerId !== e.pointerId) return;
                    var tdx = ev.clientX - startX;
                    var tdy = ev.clientY - startY;

                    if (isTouch && !captured) {
                        if (Math.abs(tdy) > Math.abs(tdx) * 1.15 && Math.abs(tdy) > 10) {
                            dragging = false;
                            cleanup();
                            return;
                        }
                        if (Math.abs(tdx) > 10) {
                            captured = true;
                            try { stage.setPointerCapture(e.pointerId); } catch (_) {}
                        }
                        lastX = ev.clientX;
                        lastY = ev.clientY;
                        return;
                    }

                    var dx = ev.clientX - lastX;
                    var dy = ev.clientY - lastY;
                    dragX -= dx * 0.13;
                    dragY += dy * 0.13;
                    velX = -dx * 0.13 * 0.6;
                    velY =  dy * 0.13 * 0.6;
                    lastX = ev.clientX;
                    lastY = ev.clientY;
                }

                function onUp(ev) {
                    if (ev.pointerId !== e.pointerId) return;
                    dragging = false;
                    var movedFar = Math.abs(ev.clientX - startX) > slop ||
                                   Math.abs(ev.clientY - startY) > slop;
                    cleanup();
                }

                function cleanup() {
                    dragging = false;
                    stage.removeEventListener('pointermove', onMove);
                    stage.removeEventListener('pointerup', onUp);
                    stage.removeEventListener('pointercancel', onUp);
                    try { stage.releasePointerCapture(e.pointerId); } catch (_) {}
                }

                stage.addEventListener('pointermove', onMove);
                stage.addEventListener('pointerup', onUp);
                stage.addEventListener('pointercancel', onUp);
            });

            /* ---------- Lightbox ---------- */
            function openLightbox(idx) {
                focused = idx;
                lit = true;
                document.body.classList.add('arch-lit');
                document.body.style.overflow = 'hidden';
                litEl.setAttribute('aria-hidden', 'false');

                var shot = shots[idx];
                litTitle.textContent = shot.title;
                litWhere.textContent = shot.place;
                litNote.textContent  = shot.note;
                litImg.alt = shot.title;

                var thumbSrc = cards[idx].imgEl.currentSrc || cards[idx].imgEl.src;
                if (thumbSrc) litImg.src = thumbSrc;

                var token = ++litToken;
                var full = new Image();
                full.onload = function () {
                    if (token !== litToken) return;
                    litImg.src = full.src;
                };
                full.src = shot.full;

                var plate = litEl.querySelector('.arch-lit__plate');
                plate.style.transition = 'none';
                plate.style.transform = 'scale(.96)';
                plate.style.opacity = '0';
                void plate.offsetWidth;
                plate.style.transition = '';
                plate.style.transform = '';
                plate.style.opacity = '';

                if (!raf) raf = requestAnimationFrame(frame);
            }

            function closeLightbox() {
                focused = -1;
                lit = false;
                litToken++;
                document.body.classList.remove('arch-lit');
                document.body.style.overflow = '';
                litEl.setAttribute('aria-hidden', 'true');
            }

            litEl.addEventListener('click', function (e) {
                if (e.target.closest('[data-close]')) closeLightbox();
            });

            /* ---------- Grid toggle ---------- */
            gridBtn.addEventListener('click', function () {
                var on = document.body.classList.toggle('arch-gridview');
                gridBtn.setAttribute('aria-pressed', on ? 'true' : 'false');
                gridEl.setAttribute('aria-hidden', on ? 'false' : 'true');
                document.body.style.overflow = on ? 'hidden' : '';
                if (on && !raf) raf = requestAnimationFrame(frame);
            });

            /* ---------- Escape / keys ---------- */
            document.addEventListener('keydown', function (e) {
                if (e.key === 'Escape') {
                    if (document.body.classList.contains('arch-lit')) {
                        closeLightbox();
                    } else if (document.body.classList.contains('arch-gridview')) {
                        gridBtn.click();
                    }
                }
            });

            /* ---------- IntersectionObserver ---------- */
            var io = new IntersectionObserver(function (entries) {
                entries.forEach(function (entry) {
                    document.body.classList.toggle('arch-inview', entry.isIntersecting);
                    if (entry.isIntersecting && !raf) raf = requestAnimationFrame(frame);
                });
            }, { threshold: 0 });
            io.observe(archive);

            /* ---------- Resize ---------- */
            var lastW = window.innerWidth, lastH = window.innerHeight;
            function onResize() {
                if (Math.abs(window.innerWidth - lastW) < 20 &&
                    Math.abs(window.innerHeight - lastH) < 20) return;
                lastW = window.innerWidth;
                lastH = window.innerHeight;
                scheduleLayout();
            }
            window.addEventListener('resize', onResize);
            window.addEventListener('orientationchange', function () {
                setTimeout(scheduleLayout, 220);
            });
            if (window.visualViewport) {
                window.visualViewport.addEventListener('resize', onResize);
            }

            /* ---------- Boot ---------- */
            resize();
            loadAll();
            raf = requestAnimationFrame(frame);
        })();

        /* ============================================================
           INTELLIGENT JOURNEY FINDER
           - Category tabs
           - Adaptive fields per category
           - Preserves existing keyword / category / budget parameters
        ============================================================ */
        (function () {
            'use strict';
            var form = document.getElementById('home-search');
            if (!form) { return; }

            var tabs = form.querySelectorAll('[data-finder-tab]');
            var panels = form.querySelectorAll('[data-finder-panel]');
            var categoryInput = document.getElementById('finder-category');

            function activate(name) {
                Array.prototype.forEach.call(tabs, function (tab) {
                    var on = tab.getAttribute('data-finder-tab') === name;
                    tab.classList.toggle('is-active', on);
                    tab.setAttribute('aria-selected', on ? 'true' : 'false');
                    tab.tabIndex = on ? 0 : -1;
                });

                Array.prototype.forEach.call(panels, function (panel) {
                    var on = panel.getAttribute('data-finder-panel') === name;
                    panel.classList.toggle('is-active', on);
                    panel.hidden = !on;
                    Array.prototype.forEach.call(panel.querySelectorAll('input, select, textarea'), function (field) {
                        field.disabled = !on;
                    });
                });

                if (categoryInput) { categoryInput.value = name; }
            }

            Array.prototype.forEach.call(tabs, function (tab, index) {
                tab.addEventListener('click', function () {
                    activate(tab.getAttribute('data-finder-tab'));
                });

                tab.addEventListener('keydown', function (event) {
                    var key = event.key;
                    var next = -1;
                    if (key === 'ArrowRight') { next = (index + 1) % tabs.length; }
                    else if (key === 'ArrowLeft') { next = (index - 1 + tabs.length) % tabs.length; }
                    else if (key === 'Home') { next = 0; }
                    else if (key === 'End') { next = tabs.length - 1; }

                    if (next > -1) {
                        event.preventDefault();
                        tabs[next].focus();
                        activate(tabs[next].getAttribute('data-finder-tab'));
                    }
                });
            });

            var initial = form.querySelector('.finder__tab.is-active') || tabs[0];
            if (initial) {
                activate(initial.getAttribute('data-finder-tab'));
            }

            form.addEventListener('submit', function (event) {
                event.preventDefault();

                var data = new FormData(form);
                var params = new URLSearchParams();

                data.forEach(function (value, key) {
                    var v = (value || '').toString().trim();
                    if (v) { params.append(key, v); }
                });

                var target = '@Url.Action("Index", "Search")';
                var query = params.toString();
                if (query) { target += '?' + query; }

                window.location.href = target;
            });
        })();

        /* ============================================================
           Reveal animations & subtle hero parallax (additive — safe)
        ============================================================ */
        (function () {
            'use strict';

            var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
            if (reduceMotion) return;

            /* --- IntersectionObserver reveal system --- */
            var observer = new IntersectionObserver(function (entries) {
                entries.forEach(function (entry) {
                    if (!entry.isIntersecting) return;
                    var el = entry.target;

                    if (el.hasAttribute('data-reveal-group')) {
                        var children = el.children;
                        for (var i = 0; i < children.length; i++) {
                            children[i].style.transitionDelay = (i * 0.09) + 's';
                            children[i].classList.add('is-revealed');
                        }
                    } else {
                        el.classList.add('is-revealed');
                    }
                    observer.unobserve(el);
                });
            }, { threshold: 0.12, rootMargin: '0px 0px -60px 0px' });

            /* Standalone reveals (skip ones already inside a group) */
            document.querySelectorAll('[data-reveal]').forEach(function (el) {
                if (el.closest('[data-reveal-group]')) return;
                el.classList.add('reveal-pending');
                observer.observe(el);
            });

            /* Grouped reveals */
            document.querySelectorAll('[data-reveal-group]').forEach(function (el) {
                Array.prototype.forEach.call(el.children, function (child) {
                    child.classList.add('reveal-pending');
                });
                observer.observe(el);
            });

            /* --- Hero parallax (very subtle) --- */
            var heroImg = document.querySelector('.hero__media img');
            if (heroImg) {
                var ticking = false;
                window.addEventListener('scroll', function () {
                    if (ticking) return;
                    ticking = true;
                    requestAnimationFrame(function () {
                        var y = window.scrollY;
                        var vh = window.innerHeight;
                        if (y < vh * 1.2) {
                            heroImg.style.transform =
                                'scale(1.08) translate3d(0, ' + (y * 0.35) + 'px, 0)';
                        }
                        ticking = false;
                    });
                }, { passive: true });
            }
        })();
    </script>
}