
@{
    ViewData["Title"] = "Experiences | Karnel Travel Guide";
    ViewData["Description"] = "Discover adventures, cultural tours, nature escapes and unforgettable experiences across Pakistan.";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var experiences = new[]
    {
        new
        {
            Name = "Mountain Trekking",
            Category = "Adventure",
            Location = "Hunza, Gilgit-Baltistan",
            Duration = "1–2 Days",
            Price = "From PKR 8,000",
            Description = "Explore breathtaking mountain trails and discover the natural beauty of northern Pakistan.",
            Image = "https://images.unsplash.com/photo-1464822759023-fed622ff2c3b?auto=format&fit=crop&w=1000&q=85"
        },
        new
        {
            Name = "Lakeside Camping",
            Category = "Camping",
            Location = "Attabad Lake, Hunza",
            Duration = "1 Night",
            Price = "From PKR 6,500",
            Description = "Spend a peaceful night surrounded by mountain scenery and beautiful lake views.",
            Image = "https://images.unsplash.com/photo-1478131143081-80f7f84ca84d?auto=format&fit=crop&w=1000&q=85"
        },
        new
        {
            Name = "Cultural Heritage Tour",
            Category = "Cultural",
            Location = "Lahore, Punjab",
            Duration = "Half Day",
            Price = "From PKR 3,500",
            Description = "Discover historic architecture, local traditions and the stories behind Pakistan's heritage.",
            Image = "https://images.unsplash.com/photo-1587474260584-136574528ed5?auto=format&fit=crop&w=1000&q=85"
        },
        new
        {
            Name = "River Adventure",
            Category = "Water Activities",
            Location = "Kaghan Valley",
            Duration = "2–3 Hours",
            Price = "From PKR 5,000",
            Description = "Enjoy an exciting outdoor water adventure surrounded by beautiful landscapes.",
            Image = "https://images.unsplash.com/photo-1530789253388-582c481c54b0?auto=format&fit=crop&w=1000&q=85"
        },
        new
        {
            Name = "Nature Photography",
            Category = "Nature",
            Location = "Skardu, Gilgit-Baltistan",
            Duration = "Half Day",
            Price = "From PKR 4,000",
            Description = "Explore scenic locations and capture the landscapes, lakes and mountains of the north.",
            Image = "https://images.unsplash.com/photo-1470770841072-f978cf4d019e?auto=format&fit=crop&w=1000&q=85"
        },
        new
        {
            Name = "Family Nature Escape",
            Category = "Family",
            Location = "Nathia Gali, Khyber Pakhtunkhwa",
            Duration = "Full Day",
            Price = "From PKR 7,000",
            Description = "Enjoy a relaxed day outdoors with scenic walks and family-friendly activities.",
            Image = "https://images.unsplash.com/photo-1441974231531-c6227db76b6e?auto=format&fit=crop&w=1000&q=85"
        }
    };

    var categories = new[]
    {
        "All Experiences",
        "Adventure",
        "Nature",
        "Cultural",
        "Water Activities",
        "Camping",
        "Family"
    };
}

<style>
    /* =========================================
       EXPERIENCES PAGE
    ========================================= */

    .experiences-page {
        --exp-forest: #183c32;
        --exp-forest-dark: #102820;
        --exp-cream: #f7f5ef;
        --exp-gold: #c6a66b;
        --exp-ink: #24312c;
        --exp-muted: #727b74;
        --exp-white: #ffffff;
        --exp-border: #e8e4d9;

        background: var(--exp-cream);
        color: var(--exp-ink);
        font-family: Arial, Helvetica, sans-serif;
        line-height: 1.7;
        overflow: hidden;
    }

    .experiences-page *,
    .experiences-page *::before,
    .experiences-page *::after {
        box-sizing: border-box;
    }

    .experiences-page a {
        text-decoration: none;
    }

    .experiences-page button {
        font: inherit;
    }

    .experiences-page h1,
    .experiences-page h2,
    .experiences-page h3 {
        font-family: Georgia, "Times New Roman", serif;
        font-weight: normal;
        line-height: 1.2;
    }

    /* =========================================
       HERO
    ========================================= */

    .exp-hero {
        position: relative;
        min-height: 590px;
        display: flex;
        align-items: center;
        color: white;
        background-color: var(--exp-forest-dark);
        background-image:
            linear-gradient(
                90deg,
                rgba(10, 30, 22, .86),
                rgba(10, 30, 22, .35)
            ),
            url("https://images.unsplash.com/photo-1472396961693-142e6e269027?auto=format&fit=crop&w=2000&q=90");
        background-size: cover;
        background-position: center;
    }

    .exp-hero-inner {
        width: 100%;
        max-width: 1250px;
        padding: 95px 7%;
        margin: 0 auto;
    }

    .exp-eyebrow {
        color: #e3c895;
        font-size: 11px;
        font-weight: bold;
        letter-spacing: 3px;
        text-transform: uppercase;
    }

    .exp-hero h1 {
        max-width: 800px;
        margin: 20px 0;
        color: white;
        font-size: clamp(43px, 7vw, 82px);
        letter-spacing: -1.5px;
    }

    .exp-hero-description {
        max-width: 620px;
        margin: 0;
        color: rgba(255,255,255,.85);
        font-size: 16px;
        line-height: 1.9;
    }

    .exp-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        margin-top: 28px;
        padding: 14px 24px;
        border: 1px solid var(--exp-gold);
        background: var(--exp-gold);
        color: var(--exp-forest-dark) !important;
        font-size: 13px;
        font-weight: bold;
        transition: .25s ease;
    }

    .exp-button:hover {
        background: #dfc28d;
        border-color: #dfc28d;
        transform: translateY(-3px);
    }

    /* =========================================
       COMMON SECTION STYLING
    ========================================= */

    .exp-container {
        width: 100%;
        max-width: 1200px;
        padding: 85px 25px;
        margin: 0 auto;
    }

    .exp-section-label {
        color: #927344;
        font-size: 11px;
        font-weight: bold;
        letter-spacing: 2px;
        text-transform: uppercase;
    }

    .exp-section-title {
        margin: 12px 0;
        color: var(--exp-forest);
        font-size: clamp(32px, 4vw, 46px);
    }

    .exp-section-description {
        max-width: 650px;
        margin: 12px 0 0;
        color: var(--exp-muted);
        font-size: 14px;
        line-height: 1.9;
    }

    /* =========================================
       EXPERIENCE INTRO
    ========================================= */

    .exp-intro {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 30px;
        margin-bottom: 32px;
    }

    /* =========================================
       CATEGORY FILTERS
    ========================================= */

    .exp-category-list {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        margin: 30px 0 40px;
    }

    .exp-category-button {
        padding: 10px 17px;
        border: 1px solid #d9d5c9;
        background: transparent;
        color: var(--exp-ink);
        font-size: 12px;
        cursor: pointer;
        transition: .2s ease;
    }

    .exp-category-button:hover,
    .exp-category-button.active {
        background: var(--exp-forest);
        border-color: var(--exp-forest);
        color: white;
    }

    /* =========================================
       EXPERIENCE CARDS
    ========================================= */

    .exp-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 25px;
    }

    .exp-card {
        display: flex;
        min-width: 0;
        flex-direction: column;
        overflow: hidden;
        background: var(--exp-white);
        border: 1px solid var(--exp-border);
        transition:
            transform .3s ease,
            box-shadow .3s ease;
    }

    .exp-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 15px 35px rgba(24,60,50,.10);
    }

    .exp-card-image-wrap {
        position: relative;
        height: 245px;
        overflow: hidden;
        background: #dfe3da;
    }

    .exp-card-image {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform .5s ease;
    }

    .exp-card:hover .exp-card-image {
        transform: scale(1.05);
    }

    .exp-card-category {
        position: absolute;
        top: 17px;
        left: 17px;
        padding: 7px 11px;
        background: var(--exp-cream);
        color: var(--exp-forest);
        font-size: 10px;
        font-weight: bold;
        letter-spacing: 1px;
        text-transform: uppercase;
    }

    .exp-card-content {
        display: flex;
        flex: 1;
        flex-direction: column;
        padding: 23px;
    }

    .exp-card-location {
        color: var(--exp-muted);
        font-size: 12px;
    }

    .exp-card-content h3 {
        margin: 8px 0;
        color: var(--exp-forest);
        font-size: 25px;
    }

    .exp-card-description {
        min-height: 68px;
        margin: 12px 0 18px;
        color: #626c65;
        font-size: 13px;
        line-height: 1.8;
    }

    .exp-card-bottom {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
        padding-top: 15px;
        margin-top: auto;
        border-top: 1px solid var(--exp-border);
    }

    .exp-card-duration {
        color: var(--exp-muted);
        font-size: 11px;
    }

    .exp-card-price {
        color: var(--exp-forest);
        font-size: 13px;
        font-weight: bold;
        text-align: right;
    }

    .exp-card-link {
        display: inline-block;
        margin-top: 18px;
        color: var(--exp-forest) !important;
        font-size: 12px;
        font-weight: bold;
    }

    .exp-card-link:hover {
        color: #927344 !important;
    }

    .exp-empty-state {
        display: none;
        padding: 35px;
        border: 1px dashed #c9c9b9;
        color: var(--exp-muted);
        text-align: center;
    }

    /* =========================================
       FEATURE SECTION
    ========================================= */

    .exp-feature-section {
        background: #eeece3;
    }

    .exp-feature-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        align-items: center;
        gap: 55px;
    }

    .exp-feature-image {
        display: block;
        width: 100%;
        height: 440px;
        object-fit: cover;
    }

    .exp-feature-copy h2 {
        margin: 12px 0 20px;
        color: var(--exp-forest);
        font-size: clamp(32px, 4vw, 45px);
    }

    .exp-feature-copy p {
        color: var(--exp-muted);
        font-size: 14px;
        line-height: 1.9;
    }

    /* =========================================
       BENEFITS
    ========================================= */

    .exp-benefits {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 20px;
        margin-top: 35px;
    }

    .exp-benefit {
        padding: 25px;
        background: white;
        border: 1px solid var(--exp-border);
        transition: transform .25s ease;
    }

    .exp-benefit:hover {
        transform: translateY(-4px);
    }

    .exp-benefit-number {
        color: var(--exp-gold);
        font-family: Georgia, "Times New Roman", serif;
        font-size: 34px;
    }

    .exp-benefit h3 {
        margin: 10px 0;
        color: var(--exp-forest);
        font-size: 21px;
    }

    .exp-benefit p {
        margin-bottom: 0;
        color: var(--exp-muted);
        font-size: 13px;
        line-height: 1.8;
    }

    /* =========================================
       FINAL CTA
    ========================================= */

    .exp-planning {
        background: var(--exp-forest);
        color: white;
        text-align: center;
    }

    .exp-planning-inner {
        max-width: 800px;
        padding-top: 85px;
        padding-bottom: 85px;
    }

    .exp-planning h2 {
        margin: 15px 0;
        color: white;
        font-size: clamp(32px, 4vw, 47px);
    }

    .exp-planning p {
        max-width: 620px;
        margin: 15px auto;
        color: rgba(255,255,255,.78);
        font-size: 14px;
        line-height: 1.9;
    }

    /* =========================================
       RESPONSIVE
    ========================================= */

    @@media (max-width: 950px) {
        .exp-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .exp-feature-grid {
            gap: 30px;
        }
    }

    @@media (max-width: 650px) {
        .exp-hero {
            min-height: 490px;
            background-position: center;
        }

        .exp-hero-inner {
            padding: 65px 6%;
        }

        .exp-container {
            padding: 60px 20px;
        }

        .exp-intro {
            display: block;
        }

        .exp-grid,
        .exp-feature-grid,
        .exp-benefits {
            grid-template-columns: 1fr;
        }

        .exp-card-image-wrap {
            height: 230px;
        }

        .exp-feature-image {
            height: 300px;
        }

        .exp-category-list {
            gap: 8px;
        }

        .exp-category-button {
            padding: 9px 12px;
            font-size: 11px;
        }

        .exp-card-description {
            min-height: auto;
        }

        .exp-planning-inner {
            padding-top: 65px;
            padding-bottom: 65px;
        }
    }
</style>

<div class="experiences-page">

    <!-- =========================================
         HERO
    ========================================== -->

    <section class="exp-hero">
        <div class="exp-hero-inner">

            <div class="exp-eyebrow">
                Discover · Explore · Experience
            </div>

            <h1>Experience Pakistan Beyond the Journey.</h1>

            <p class="exp-hero-description">
                From mountain adventures and peaceful nature escapes to
                cultural discoveries, find experiences that make every
                journey unforgettable.
            </p>

            <a class="exp-button" href="#explore">
                Explore Experiences <span>↓</span>
            </a>

        </div>
    </section>


    <!-- =========================================
         EXPERIENCE LISTING
    ========================================== -->

    <section class="exp-container" id="explore">

        <div class="exp-intro">
            <div>
                <div class="exp-section-label">
                    Find your next adventure
                </div>

                <h2 class="exp-section-title">
                    Experiences Worth Remembering
                </h2>

                <p class="exp-section-description">
                    Discover activities and experiences across Pakistan.
                    Choose what interests you and start planning your next adventure.
                </p>
            </div>
        </div>


        <!-- Category Filters -->

        <div class="exp-category-list" aria-label="Filter experiences">

            @foreach (var category in categories)
            {
                <button type="button"
                        class="exp-category-button @(category == "All Experiences" ? "active" : "")"
                        data-category="@category">

                    @category

                </button>
            }

        </div>


        <!-- Experience Cards -->

        <div class="exp-grid" id="experienceGrid">

            @foreach (var experience in experiences)
            {
                var inquiryUrl = "/Contact?category=" +
                    Uri.EscapeDataString("Experience inquiry") +
                    "&service=" +
                    Uri.EscapeDataString(experience.Name);

                <article class="exp-card"
                         data-experience-category="@experience.Category">

                    <div class="exp-card-image-wrap">

                        <img class="exp-card-image"
                             src="@experience.Image"
                             alt="@experience.Name"
                             loading="lazy" />

                        <span class="exp-card-category">
                            @experience.Category
                        </span>

                    </div>

                    <div class="exp-card-content">

                        <div class="exp-card-location">
                            ⌖ @experience.Location
                        </div>

                        <h3>@experience.Name</h3>

                        <p class="exp-card-description">
                            @experience.Description
                        </p>

                        <div class="exp-card-bottom">

                            <span class="exp-card-duration">
                                ◷ @experience.Duration
                            </span>

                            <span class="exp-card-price">
                                @experience.Price
                            </span>

                        </div>

                        <a class="exp-card-link" href="@inquiryUrl">
                            Enquire about this experience →
                        </a>

                    </div>

                </article>
            }

        </div>


        <div class="exp-empty-state" id="emptyState">
            No experiences are available in this category yet.
        </div>

    </section>


    <!-- =========================================
         FEATURE SECTION
    ========================================== -->

    <section class="exp-feature-section">

        <div class="exp-container exp-feature-grid">

            <div>
                <img class="exp-feature-image"
                     src="https://images.unsplash.com/photo-1464278533981-50106e6176b1?auto=format&fit=crop&w=1200&q=85"
                     alt="Scenic mountain landscape"
                     loading="lazy" />
            </div>

            <div class="exp-feature-copy">

                <div class="exp-section-label">
                    More than sightseeing
                </div>

                <h2>
                    Make Every Journey an Experience.
                </h2>

                <p>
                    A destination becomes memorable through the moments
                    you experience there. Explore nature, discover local
                    culture and enjoy outdoor activities while travelling
                    through Pakistan.
                </p>

                <p>
                    Tell us what you would like to experience.
                    We can help you discuss suitable arrangements
                    for your journey.
                </p>

                <a class="exp-button"
                   href="/Contact?category=Experience%20planning">

                    Plan an Experience →

                </a>

            </div>

        </div>

    </section>


    <!-- =========================================
         WHY KARNEL
    ========================================== -->

    <section class="exp-container">

        <div class="exp-section-label">
            Travel with confidence
        </div>

        <h2 class="exp-section-title">
            Why Explore With Karnel?
        </h2>

        <p class="exp-section-description">
            Make planning your next experience easier with one place
            to explore your options.
        </p>


        <div class="exp-benefits">

            <article class="exp-benefit">

                <div class="exp-benefit-number">01</div>

                <h3>Discover More</h3>

                <p>
                    Explore different activities, destinations
                    and local experiences.
                </p>

            </article>


            <article class="exp-benefit">

                <div class="exp-benefit-number">02</div>

                <h3>Plan Your Journey</h3>

                <p>
                    Discuss your preferred experience, dates
                    and travel arrangements.
                </p>

            </article>


            <article class="exp-benefit">

                <div class="exp-benefit-number">03</div>

                <h3>One Travel Guide</h3>

                <p>
                    Explore experiences alongside accommodation
                    and destination information.
                </p>

            </article>

        </div>

    </section>


    <!-- =========================================
         FINAL CALL TO ACTION
    ========================================== -->

    <section class="exp-planning">

        <div class="exp-container exp-planning-inner">

            <div class="exp-eyebrow">
                Your next adventure awaits
            </div>

            <h2>
                What Would You Like to Experience?
            </h2>

            <p>
                Share your interests and travel plans with us.
                Our team can help you discuss available experiences
                and arrangements.
            </p>

            <a class="exp-button"
               href="/Contact?category=Experience%20planning">

                Start Planning →

            </a>

        </div>

    </section>

</div>


<script>
    (() => {
        const page = document.querySelector(".experiences-page");

        if (!page) return;

        const categoryButtons = page.querySelectorAll(".exp-category-button");
        const experienceCards = page.querySelectorAll(".exp-card");
        const emptyState = page.querySelector("#emptyState");

        categoryButtons.forEach(button => {

            button.addEventListener("click", () => {

                const selectedCategory = button.dataset.category;
                let visibleCount = 0;

                categoryButtons.forEach(item => {
                    item.classList.remove("active");
                });

                button.classList.add("active");

                experienceCards.forEach(card => {

                    const cardCategory = card.dataset.experienceCategory;

                    const shouldShow =
                        selectedCategory === "All Experiences" ||
                        cardCategory === selectedCategory;

                    card.style.display = shouldShow ? "flex" : "none";

                    if (shouldShow) {
                        visibleCount++;
                    }

                });

                emptyState.style.display =
                    visibleCount === 0 ? "block" : "none";

            });

        });

    })();
</script>
