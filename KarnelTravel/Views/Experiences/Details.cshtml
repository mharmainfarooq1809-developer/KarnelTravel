@model KarnelTravel.Models.Experience
@{
    ViewData["Title"] = $"{Model.Name} | Experiences";
}

<main style="max-width:1000px;margin:0 auto;padding:3rem 1.25rem 5rem;">
    <a asp-controller="Experiences" asp-action="Index">← Back to experiences</a>
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:2rem;margin-top:1.5rem;align-items:start;">
        <div>
            @if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
            {
                <img src="@Model.ImageUrl" alt="@Model.Name" style="width:100%;height:360px;object-fit:cover;border-radius:18px;" />
            }
        </div>
        <div>
            <p style="text-transform:uppercase;letter-spacing:.1em;color:#64746b;">@Model.Category · @Model.Location</p>
            <h1>@Model.Name</h1>
            <p>@Model.Description</p>
            <p><strong>Duration:</strong> @Model.Duration</p>
            <p><strong>Price:</strong> @(Model.StartingPrice.HasValue ? $"From PKR {Model.StartingPrice.Value:N0}" : "Price on request")</p>
            @if (!string.IsNullOrWhiteSpace(Model.Includes))
            {
                <p><strong>Includes:</strong> @Model.Includes</p>
            }
            @if (!string.IsNullOrWhiteSpace(Model.Excludes))
            {
                <p><strong>Excludes:</strong> @Model.Excludes</p>
            }
            <a asp-controller="Bookings" asp-action="Create" asp-route-serviceType="Experience" asp-route-serviceId="@Model.Id" style="display:inline-block;margin-top:1rem;padding:.8rem 1.2rem;border-radius:999px;background:#14271f;color:#fff;text-decoration:none;">Book this experience</a>
        </div>
    </div>
</main>
