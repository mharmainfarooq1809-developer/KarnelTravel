
@using Microsoft.EntityFrameworkCore
@inject KarnelTravel.Services.ISettingsService SettingsService
@inject KarnelTravel.Data.ApplicationDbContext AdminDb
@{
    var pageTitle = ViewData["Title"] as string ?? "Admin workspace";
    var currentPath = Context.Request.Path.Value?.ToLowerInvariant() ?? string.Empty;

    string Active(params string[] fragments)
    {
        foreach (var f in fragments)
            if (currentPath.Contains(f)) return "is-active";
        return "";
    }

    var isDashboard = currentPath == "/admin"
                      || currentPath == "/admin/"
                      || currentPath.Contains("/admin/dashboard");
    var adminSettings = await SettingsService.GetAsync(Context.RequestAborted);
    var pendingNotifications = adminSettings.AdminNotificationIndicators
        ? await AdminDb.Bookings.CountAsync(x => x.Status == "Pending")
            + await AdminDb.ContactInquiries.CountAsync(x => x.Status == "New")
            + await AdminDb.Reviews.CountAsync(x => x.Status == KarnelTravel.Models.ReviewStatus.Pending)
        : 0;
    var adminTheme = adminSettings.AdminTheme.ToLowerInvariant();
    var densityClass = adminSettings.InterfaceDensity.Equals("Compact", StringComparison.OrdinalIgnoreCase)
        ? " admin-density-compact" : "";
}
<!DOCTYPE html>
<html lang="en" data-admin-theme="@adminTheme">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@pageTitle · Karnel Admin</title>
    <meta name="description" content="Karnel Travel Guide administration prototype" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display&family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,600;9..40,700&display=swap" rel="stylesheet" />

    <style>
        :root {
            --forest: #164734;
            --green: #236b4d;
            --accent: #3c9169;
            --paper: #f6f7f3;
            --white: #ffffff;
            --ink: #1b2922;
            --muted: #758078;
            --line: #e5e9e3;
            --line-hi: #d6dcd4;
            --soft: #edf2ed;
            --soft-2: #e3ece5;
            --amber: #b9853c;
            --red: #ae5d50;
            --surface-sunken: #fbfcfa;
            --shadow-xs: 0 1px 2px rgba(22,71,52,.05);
            --shadow-sm: 0 2px 6px -2px rgba(22,71,52,.08);
            --shadow: 0 12px 35px -12px rgba(22,71,52,.12);
            --shadow-lg: 0 28px 70px -28px rgba(22,71,52,.28);
            --ring-accent: 0 0 0 3px rgba(60,145,105,.22);
            --ease: cubic-bezier(.22,.72,.24,1);
            --ease-out: cubic-bezier(.16,1,.3,1);
            --dur-fast: .14s;
            --dur: .22s;
            --dur-slow: .34s;
            --serif: 'DM Serif Display', Georgia, 'Iowan Old Style', serif;
            --sans: 'DM Sans', system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
            --radius: 12px;
            --radius-pill: 999px;
            --sidebar-w: 264px;
            --topbar-h: 72px;
            --maxw: 1440px;
            --pad-x: clamp(20px, 4vw, 64px);
        }

        *, *::before, *::after { box-sizing: border-box; }
        html { scroll-behavior: smooth; -webkit-text-size-adjust: 100%; }

        body.admin-body {
            margin: 0;
            background: var(--paper);
            color: var(--ink);
            font-family: var(--sans);
            font-size: 14px;
            line-height: 1.55;
            -webkit-font-smoothing: antialiased;
        }
        html[data-admin-theme="dark"] body.admin-body {
            --paper: #17231d;
            --surface: #203128;
            --surface-2: #263b30;
            --ink: #edf4ed;
            --muted: #b6c4b8;
            --line: #405248;
        }
        html[data-admin-theme="light"] body.admin-body,
        html[data-admin-theme="system"] body.admin-body { color-scheme: light; }
        @@media (prefers-color-scheme: dark) {
            html[data-admin-theme="system"] body.admin-body {
                --paper: #17231d;
                --surface: #203128;
                --surface-2: #263b30;
                --ink: #edf4ed;
                --muted: #b6c4b8;
                --line: #405248;
            }
        }
        body.admin-density-compact .admin-main { padding-top: 24px; padding-bottom: 32px; }
        body.admin-density-compact .setting-card,
        body.admin-density-compact .table-card { padding: 14px; }

        a { color: inherit; text-decoration: none; }
        a:hover { color: var(--forest); }
        button, input, select, textarea { font: inherit; }
        button { cursor: pointer; border: 0; background: none; color: inherit; }
        img, svg { display: block; max-width: 100%; }
        :focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; border-radius: 6px; }
        ::selection { background: var(--soft-2); color: var(--forest); }

        /* Shell */
        .admin-shell { min-height: 100vh; display: flex; }

        .admin-sidebar {
            position: fixed;
            inset: 0 auto 0 0;
            z-index: 25;
            width: var(--sidebar-w);
            display: flex;
            flex-direction: column;
            background: linear-gradient(180deg, #143d2d 0%, #0f3225 72%);
            color: #d9e7db;
            border-right: 1px solid rgba(255,255,255,.06);
            box-shadow: 8px 0 32px -18px rgba(6,16,24,.55);
        }

        .admin-content {
            flex: 1 1 auto;
            min-width: 0;
            display: flex;
            flex-direction: column;
            margin-left: var(--sidebar-w);
        }

        .admin-topbar {
            height: var(--topbar-h);
            background: rgba(255,255,255,.88);
            backdrop-filter: saturate(160%) blur(12px);
            -webkit-backdrop-filter: saturate(160%) blur(12px);
            border-bottom: 1px solid var(--line);
            display: flex;
            align-items: center;
            padding: 0 var(--pad-x);
            gap: 16px;
            position: sticky;
            top: 0;
            z-index: 20;
        }

        .admin-main {
            flex: 1 1 auto;
            max-width: var(--maxw);
            width: 100%;
            margin: 0 auto;
            padding: 42px var(--pad-x) 64px;
        }

        .admin-footer {
            max-width: var(--maxw);
            width: 100%;
            margin: 0 auto;
            padding: 22px var(--pad-x);
            border-top: 1px solid var(--line);
            display: flex;
            justify-content: space-between;
            color: var(--muted);
            font-size: 12px;
        }

        .live-dot {
            display: inline-block;
            width: 7px;
            height: 7px;
            background: var(--accent);
            border-radius: 50%;
            margin-right: 6px;
            box-shadow: 0 0 0 3px rgba(60,145,105,.15);
            animation: livePulse 2.4s ease-in-out infinite;
        }

        @@keyframes livePulse {
            0%, 100% { box-shadow: 0 0 0 3px rgba(60,145,105,.15); }
            50% { box-shadow: 0 0 0 6px rgba(60,145,105,.05); }
        }

        /* Sidebar */
        .sidebar-head {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 20px 16px 18px 20px;
            border-bottom: 1px solid rgba(255,255,255,.07);
        }

        .admin-brand { display: flex; align-items: center; gap: 11px; min-width: 0; }

        .brand-mark {
            width: 38px;
            height: 38px;
            flex-shrink: 0;
            border-radius: 50%;
            display: grid;
            place-items: center;
            background: linear-gradient(145deg, #f0cf8b, #dca43d);
            color: #1c1305;
            font-family: var(--serif);
            font-size: 22px;
            line-height: 1;
            box-shadow: 0 4px 14px -4px rgba(220,164,61,.55);
        }

        .brand-text strong {
            display: block;
            color: #fff;
            font-family: var(--serif);
            font-size: 20px;
            font-weight: 400;
            line-height: 1;
            letter-spacing: -.01em;
        }

        .brand-text small {
            display: block;
            color: #8ea89b;
            font-size: 8.5px;
            letter-spacing: .18em;
            margin-top: 5px;
            text-transform: uppercase;
            font-weight: 600;
        }

        .sidebar-close {
            display: none;
            margin-left: auto;
            width: 34px;
            height: 34px;
            border: 0;
            border-radius: 8px;
            background: rgba(255,255,255,.06);
            color: #cbd8e2;
            font-size: .85rem;
            cursor: pointer;
            place-items: center;
            transition: background var(--dur-fast) var(--ease);
        }

        .sidebar-close:hover { background: rgba(255,255,255,.14); color: #fff; }

        .admin-nav {
            flex: 1 1 auto;
            overflow-y: auto;
            overscroll-behavior: contain;
            display: flex;
            flex-direction: column;
            gap: 2px;
            padding: 12px 10px 20px;
            scrollbar-width: thin;
            scrollbar-color: rgba(255,255,255,.18) transparent;
        }

        .admin-nav::-webkit-scrollbar { width: 6px; }
        .admin-nav::-webkit-scrollbar-thumb { background: rgba(255,255,255,.15); border-radius: 99px; }

        .nav-group-label {
            margin: 16px 12px 6px;
            font-size: 10.5px;
            font-weight: 700;
            letter-spacing: .16em;
            text-transform: uppercase;
            color: #6b8a7a;
        }

        .nav-group-label:first-child { margin-top: 2px; }

        .admin-nav > a {
            position: relative;
            display: flex;
            align-items: center;
            gap: 11px;
            padding: 10px 12px;
            border-radius: 8px;
            color: #c3d4c6;
            font-size: 13.5px;
            font-weight: 500;
            transition: background var(--dur-fast) var(--ease), color var(--dur-fast) var(--ease);
        }

        .admin-nav > a:hover { background: rgba(255,255,255,.06); color: #fff; }
        .admin-nav > a.is-active { background: rgba(60,145,105,.20); color: #fff; font-weight: 600; }

        .admin-nav > a.is-active::before {
            content: "";
            position: absolute;
            left: -10px;
            top: 50%;
            transform: translateY(-50%);
            width: 3px;
            height: 18px;
            border-radius: 0 3px 3px 0;
            background: var(--accent);
        }

        .nav-icon {
            width: 18px;
            height: 18px;
            flex-shrink: 0;
            fill: none;
            stroke: currentColor;
            stroke-width: 1.7;
            stroke-linecap: round;
            stroke-linejoin: round;
            opacity: .72;
            transition: opacity var(--dur-fast) var(--ease), color var(--dur-fast) var(--ease);
        }

        .admin-nav > a:hover .nav-icon { opacity: .95; }
        .admin-nav > a.is-active .nav-icon { opacity: 1; color: #f0cf8b; }

        .sidebar-foot {
            padding: 12px 10px;
            border-top: 1px solid rgba(255,255,255,.07);
            background: rgba(0,0,0,.14);
        }

        .sidebar-user {
            display: flex;
            align-items: center;
            gap: 10px;
            width: 100%;
            padding: 8px;
            border: 1px solid transparent;
            border-radius: 10px;
            background: rgba(255,255,255,.05);
            text-align: left;
            cursor: pointer;
            transition: background var(--dur-fast) var(--ease), border-color var(--dur-fast) var(--ease);
        }

        .sidebar-user:hover { background: rgba(255,255,255,.10); border-color: rgba(255,255,255,.08); }
        .sidebar-user .avatar { background: linear-gradient(145deg, #f0cf8b, #dca43d); color: #1c1305; width: 34px; height: 34px; flex-shrink: 0; font-size: 11px; }
        .profile-meta { min-width: 0; flex: 1; }

        .sidebar-user .profile-name {
            display: block;
            color: #fff;
            font-size: 12.5px;
            font-weight: 600;
            line-height: 1.2;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .profile-role { display: block; margin-top: 2px; font-size: 10.5px; color: #8ea89b; }

        .user-chevron {
            width: 14px;
            height: 14px;
            flex-shrink: 0;
            fill: none;
            stroke: #8ea89b;
            stroke-width: 1.8;
            stroke-linecap: round;
            stroke-linejoin: round;
        }

        .sidebar-scrim {
            display: none;
            position: fixed;
            inset: 0;
            z-index: 24;
            background: rgba(8,17,26,.50);
            backdrop-filter: blur(2px);
            -webkit-backdrop-filter: blur(2px);
            opacity: 0;
            pointer-events: none;
            transition: opacity var(--dur) var(--ease);
        }

        .sidebar-scrim.is-open { opacity: 1; pointer-events: auto; }

        /* Topbar actions */
        .admin-actions { display: flex; align-items: center; gap: 10px; margin-left: auto; }

        .icon-button {
            font-size: 20px;
            position: relative;
            color: var(--muted);
            width: 38px;
            height: 38px;
            display: grid;
            place-items: center;
            border-radius: 9px;
            border: 1px solid var(--line);
            background: var(--white);
            transition: background var(--dur-fast) var(--ease), color var(--dur-fast) var(--ease), border-color var(--dur-fast) var(--ease);
        }

        .icon-button:hover { background: var(--soft); color: var(--forest); border-color: var(--line-hi); }

        .notification-dot {
            position: absolute;
            right: 8px;
            top: 8px;
            width: 7px;
            height: 7px;
            background: #bd7554;
            border-radius: 50%;
            border: 2px solid var(--white);
            box-sizing: content-box;
        }

        .profile-chip {
            display: flex;
            gap: 9px;
            align-items: center;
            font-weight: 600;
            padding: 4px 12px 4px 4px;
            border-radius: var(--radius-pill);
            border: 1px solid var(--line);
            background: var(--white);
            transition: background var(--dur-fast) var(--ease), border-color var(--dur-fast) var(--ease);
        }

        .profile-chip:hover { background: var(--soft); border-color: var(--line-hi); }

        .avatar {
            width: 32px;
            height: 32px;
            display: grid;
            place-items: center;
            border-radius: 50%;
            background: var(--soft-2);
            color: var(--forest);
            font-size: 10.5px;
            font-weight: 700;
            letter-spacing: .04em;
        }

        .profile-chip .avatar { background: var(--soft-2); color: var(--forest); }
        .profile-chip .profile-name { font-size: 13px; color: var(--ink); }

        .topbar-heading { min-width: 0; display: flex; flex-direction: column; gap: 2px; }
        .topbar-heading .eyebrow { margin: 0; font-size: 9.5px; line-height: 1; color: var(--muted); letter-spacing: .16em; }

        .topbar-title {
            color: var(--forest);
            font-family: var(--serif);
            font-size: 16px;
            font-weight: 400;
            line-height: 1.15;
            letter-spacing: -.01em;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .nav-toggle {
            display: none;
            width: 38px;
            height: 38px;
            border-radius: 9px;
            border: 1px solid var(--line);
            background: var(--white);
            align-items: center;
            justify-content: center;
            flex-direction: column;
            gap: 4px;
        }

        .nav-toggle span {
            display: block;
            height: 2px;
            width: 18px;
            background: var(--forest);
            border-radius: 2px;
            transition: transform var(--dur) var(--ease), width var(--dur) var(--ease);
        }

        .nav-toggle span:nth-child(2) { width: 12px; }
        .nav-toggle:hover { background: var(--soft); }

        /* Buttons */
        .btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            border: 1px solid var(--line);
            border-radius: 8px;
            padding: 10px 16px;
            background: var(--white);
            font-weight: 700;
            font-size: 13px;
            color: var(--ink);
            transition: border-color var(--dur-fast) var(--ease), color var(--dur-fast) var(--ease), background var(--dur-fast) var(--ease), transform var(--dur-fast) var(--ease), box-shadow var(--dur-fast) var(--ease);
        }

        .btn:hover { border-color: var(--accent); color: var(--forest); box-shadow: var(--shadow-xs); }
        .btn:active { transform: translateY(1px); }

        .btn-primary {
            background: var(--forest);
            color: #fff;
            border-color: var(--forest);
            box-shadow: 0 2px 10px -4px rgba(22,71,52,.4);
        }

        .btn-primary:hover {
            background: var(--green);
            border-color: var(--green);
            color: #fff;
            box-shadow: 0 6px 20px -8px rgba(22,71,52,.5);
        }

        .btn-quiet { background: var(--soft); border-color: transparent; color: var(--forest); }
        .btn-quiet:hover { background: var(--soft-2); border-color: transparent; }

        /* Typography */
        .eyebrow {
            font-size: 11px;
            letter-spacing: .15em;
            text-transform: uppercase;
            color: var(--accent);
            font-weight: 700;
            margin: 0 0 10px;
        }

        .page-heading { display: flex; justify-content: space-between; align-items: end; gap: 24px; margin-bottom: 30px; }

        .page-heading h1, .hero-copy h1 {
            font-family: var(--serif);
            font-weight: 400;
            color: var(--forest);
            font-size: clamp(34px, 4vw, 56px);
            line-height: 1.03;
            letter-spacing: -.015em;
            margin: 0;
        }

        .page-heading p { color: var(--muted); margin: 10px 0 0; max-width: 62ch; }

        /* Panels */
        .panel {
            background: var(--white);
            border: 1px solid var(--line);
            border-radius: var(--radius);
            padding: 24px;
            transition: box-shadow var(--dur) var(--ease), border-color var(--dur) var(--ease);
        }

        .panel:hover { border-color: var(--line-hi); }

        .panel-title {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 18px;
            gap: 12px;
        }

        .panel-title h2, .panel-title h3 {
            font-family: var(--serif);
            font-weight: 400;
            color: var(--forest);
            font-size: 24px;
            letter-spacing: -.01em;
            margin: 0;
        }

        .panel-title a { color: var(--accent); font-size: 12px; font-weight: 700; transition: color var(--dur-fast) var(--ease); }
        .panel-title a:hover { color: var(--green); }
        .panel-title > div { min-width: 0; }
        .panel-title > div h2 { margin: 0; line-height: 1.15; }

        .panel-subtitle {
            margin: 5px 0 0;
            color: var(--muted);
            font-size: 12.5px;
            line-height: 1.5;
            letter-spacing: 0;
            font-family: var(--sans);
            font-weight: 400;
        }

        /* Hero */
        .hero-panel {
            min-height: 320px;
            background: linear-gradient(90deg, rgba(15,50,37,.90), rgba(15,50,37,.20)), url('https://images.unsplash.com/photo-1500534623283-312aade485b7?auto=format&fit=crop&w=1500&q=80') center/cover;
            border-radius: var(--radius);
            padding: 44px;
            display: flex;
            align-items: end;
            color: #fff;
            position: relative;
            overflow: hidden;
            isolation: isolate;
            box-shadow: var(--shadow);
        }

        .hero-panel::after {
            content: "";
            position: absolute;
            inset: 0;
            background: radial-gradient(120% 80% at 100% 0%, transparent 40%, rgba(15,50,37,.35));
            z-index: -1;
            pointer-events: none;
        }

        .hero-copy { max-width: 520px; position: relative; z-index: 1; }
        .hero-copy .eyebrow { color: #b9d9bd; }
        .hero-copy h1 { color: #fff; }
        .hero-copy p { color: #e0ece1; max-width: 440px; margin: 12px 0 0; font-size: 15px; line-height: 1.6; }
        .hero-copy .btn { margin-top: 20px; }

        .hero-note {
            position: absolute;
            right: 28px;
            top: 28px;
            padding: 8px 13px;
            background: rgba(255,255,255,.12);
            border: 1px solid rgba(255,255,255,.22);
            border-radius: var(--radius-pill);
            font-size: 11px;
            font-weight: 500;
            letter-spacing: .02em;
            backdrop-filter: blur(6px);
            -webkit-backdrop-filter: blur(6px);
        }

        /* Metrics */
        .dashboard-grid { display: grid; grid-template-columns: 1.35fr .85fr; gap: 20px; margin-top: 20px; }
        .metric-row { display: grid; grid-template-columns: repeat(4, 1fr); gap: 14px; margin-top: 20px; }

        .metric {
            background: var(--white);
            padding: 20px 22px;
            border: 1px solid var(--line);
            border-radius: var(--radius);
            position: relative;
            transition: transform var(--dur) var(--ease), box-shadow var(--dur) var(--ease), border-color var(--dur) var(--ease);
        }

        .metric:hover { transform: translateY(-2px); box-shadow: var(--shadow-sm); border-color: var(--line-hi); }

        .metric label {
            color: var(--muted);
            font-size: 11.5px;
            letter-spacing: .04em;
            text-transform: uppercase;
            font-weight: 600;
        }

        .metric strong {
            display: block;
            font-size: 30px;
            color: var(--forest);
            margin: 8px 0 3px;
            letter-spacing: -.02em;
            font-variant-numeric: tabular-nums;
            line-height: 1.15;
        }

        .metric small { color: var(--muted); font-size: 12px; font-weight: 600; }
        .metric small::before { content: ""; }
        .metric small.metric-up { color: var(--accent); }
        .metric small.metric-up::before { content: "▲ "; font-size: 9px; opacity: .8; }
        .metric small.metric-warn { color: var(--amber); }
        .metric small.metric-warn::before { content: "● "; font-size: 9px; opacity: .85; }
        .metric small.metric-down { color: var(--red); }
        .metric small.metric-down::before { content: "▼ "; font-size: 9px; opacity: .8; }

        /* Activity chart */
        .activity { height: 210px; display: flex; align-items: end; gap: 10px; padding: 20px 6px 0; position: relative; }
        .bar {
            flex: 1;
            background: linear-gradient(180deg, var(--soft-2), #d8e8db);
            border-radius: 6px 6px 2px 2px;
            min-height: 18px;
            position: relative;
            transition: background var(--dur) var(--ease), transform var(--dur) var(--ease);
            cursor: pointer;
        }

        .bar:nth-child(2n) { background: linear-gradient(180deg, var(--accent), var(--green)); }
        .bar:hover { transform: translateY(-3px); }

        .bar:hover::after {
            content: attr(data-value);
            position: absolute;
            bottom: calc(100% + 6px);
            left: 50%;
            transform: translateX(-50%);
            background: var(--forest);
            color: #fff;
            font-size: 10px;
            font-weight: 600;
            padding: 4px 8px;
            border-radius: 5px;
            white-space: nowrap;
            pointer-events: none;
        }

        .bar span {
            position: absolute;
            top: calc(100% + 8px);
            margin-top: 0;
            font-size: 10px;
            color: var(--muted);
            left: 50%;
            transform: translateX(-50%);
            font-weight: 500;
            letter-spacing: .02em;
            white-space: nowrap;
        }

        /* Lists */
        .booking-list, .departure-list { display: grid; gap: 2px; }

        .list-item {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            padding: 14px 0;
            border-bottom: 1px solid var(--line);
            transition: background var(--dur-fast) var(--ease);
            border-radius: 6px;
        }

        .list-item:last-child { border-bottom: 0; }
        .list-item:hover { background: var(--surface-sunken); }
        .list-item strong { display: block; font-weight: 600; color: var(--ink); }
        .list-item small { color: var(--muted); font-size: 12px; }

        .status {
            font-size: 11px;
            font-weight: 700;
            white-space: nowrap;
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 4px 9px;
            background: var(--soft);
            color: var(--forest);
            border-radius: var(--radius-pill);
            letter-spacing: .02em;
        }

        .status i { width: 6px; height: 6px; border-radius: 50%; background: var(--accent); flex-shrink: 0; }
        .status-pending, .status-in-progress { background: rgba(185,133,60,.10); color: #8a5f22; }
        .status-pending i, .status-in-progress i { background: var(--amber); }
        .status-cancelled, .status-rejected { background: rgba(174,93,80,.10); color: #8b4137; }
        .status-cancelled i, .status-rejected i { background: var(--red); }
        .status-draft { background: #eef0ec; color: var(--muted); }
        .status-draft i { background: var(--muted); }

        /* Quick actions */
        .quick-actions { display: grid; grid-template-columns: repeat(2, 1fr); gap: 9px; }

        .quick-action {
            padding: 14px;
            background: var(--soft);
            border-radius: 9px;
            color: var(--forest);
            font-weight: 700;
            font-size: 12.5px;
            transition: background var(--dur-fast) var(--ease), transform var(--dur-fast) var(--ease);
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .quick-action::before {
            content: "+";
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 20px;
            height: 20px;
            background: var(--white);
            border-radius: 50%;
            font-size: 14px;
            color: var(--green);
            font-weight: 700;
            box-shadow: var(--shadow-xs);
        }

        .quick-action:hover { background: var(--soft-2); transform: translateY(-1px); color: var(--forest); }

        /* Utils */
        .section-space { margin-top: 20px; }
        .muted { color: var(--muted); font-size: 13px; line-height: 1.55; margin: 0; }

        /* Toast */
        .toast {
            position: fixed;
            bottom: 25px;
            right: 25px;
            background: var(--forest);
            color: #fff;
            padding: 14px 20px;
            border-radius: 9px;
            box-shadow: var(--shadow-lg);
            transform: translateY(20px);
            opacity: 0;
            pointer-events: none;
            transition: transform var(--dur) var(--ease-out), opacity var(--dur) var(--ease-out);
            z-index: 50;
            font-size: 13px;
            font-weight: 500;
            max-width: min(360px, calc(100vw - 40px));
            border-left: 3px solid var(--accent);
        }

        .toast.is-visible { transform: translateY(0); opacity: 1; }

        /* Responsive */
        @@media (max-width: 1050px) {
            .dashboard-grid { grid-template-columns: 1fr; }
            .metric-row { grid-template-columns: repeat(2, 1fr); }
            .profile-chip .profile-name { display: none; }
            .profile-chip { padding: 4px; }
        }

        @@media (max-width: 1024px) {
            .admin-content { margin-left: 0; }

            .admin-sidebar {
                transform: translateX(-100%);
                transition: transform .28s var(--ease);
                box-shadow: 0 0 60px rgba(0,0,0,.45);
            }

            .admin-sidebar.is-open { transform: translateX(0); }
            .sidebar-scrim { display: block; }
            .nav-toggle { display: flex; }
            .sidebar-close { display: grid; }
            body.is-nav-open { overflow: hidden; }
        }

        @@media (max-width: 760px) {
            .admin-topbar { height: 66px; padding: 0 16px; gap: 10px; }
            .admin-main { padding: 28px 16px 48px; }
            .admin-footer { padding: 18px 16px; display: block; text-align: left; }
            .admin-footer span { display: block; margin: 4px 0; }
            .hero-panel { padding: 28px; min-height: 380px; }
            .hero-copy h1 { font-size: 40px; }
            .metric-row { grid-template-columns: 1fr 1fr; gap: 10px; }
            .metric { padding: 16px; }
            .metric strong { font-size: 24px; }
            .panel { padding: 18px; }
            .profile-chip { display: none; }
            .topbar-heading .eyebrow { display: none; }
            .toast { right: 16px; left: 16px; bottom: 16px; max-width: none; }
        }

        @@media (prefers-reduced-motion: reduce) {
            *, *::before, *::after {
                animation-duration: .001ms !important;
                transition-duration: .001ms !important;
                scroll-behavior: auto !important;
            }
        }
    </style>
</head>
<body class="admin-body@densityClass">
    <div class="admin-shell">

        <!-- SIDEBAR -->
        <aside class="admin-sidebar" id="adminSidebar" data-sidebar aria-label="Primary administration">

            <div class="sidebar-head">
                <a class="admin-brand" asp-controller="Admin" asp-action="Dashboard" aria-label="Karnel admin home">
