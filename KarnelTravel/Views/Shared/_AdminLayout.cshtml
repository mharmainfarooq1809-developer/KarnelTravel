@inject KarnelTravel.Services.ISettingsService SettingsService
@{
    var pageTitle = ViewData["Title"] as string ?? "Admin workspace";
    var currentPath = Context.Request.Path.Value?.ToLowerInvariant() ?? string.Empty;

    string Active(params string[] fragments)
    {
        foreach (var f in fragments)
            if (currentPath.Contains(f)) return "is-active";
        return "";
    }

    var isDashboard = currentPath == "/admin"
                      || currentPath == "/admin/"
                      || currentPath.Contains("/admin/dashboard");

    // --- Route groups (drive rail highlight + panel auto-expand) ---
    var isVehicles = currentPath.Contains("/admin/vehicles");
    var isTransport = currentPath.Contains("/admin/transport") && !isVehicles;

    var travelActive = currentPath.Contains("/admin/destinations")
                    || currentPath.Contains("/admin/properties")
                    || currentPath.Contains("/admin/tours");

    var opsActive = isTransport
                    || isVehicles
                    || currentPath.Contains("/admin/bookings")
                     || currentPath.Contains("/admin/customtriprequests")
                    || currentPath.Contains("/admin/customers")
                    || currentPath.Contains("/admin/inquiries")
                    || currentPath.Contains("/admin/reviews");

    var aiActive = currentPath.Contains("/admin/ai")
                || currentPath.Contains("/adminai");

    var isAccountPage = currentPath.Contains("/admin/settings/account")
                     || currentPath.Contains("/admin/accountsettings");
    var isSystemInfoPage = currentPath.Contains("/admin/settings/system")
                        || currentPath.Contains("/admin/systeminformation");
    var isSettingsPage = currentPath.Contains("/admin/settings")
                      && !isAccountPage && !isSystemInfoPage;

    var systemActive = currentPath.Contains("/admin/websitecontent")
                    || currentPath.Contains("/admin/website-content")
                    || currentPath.Contains("/admin/reports")
                    || isSettingsPage || isAccountPage || isSystemInfoPage;

    string Ar(bool v) => v ? "true" : "false";

    var adminSettings = await SettingsService.GetAsync(Context.RequestAborted);
    var adminTheme = adminSettings.AdminTheme.ToLowerInvariant();
    var densityClass = adminSettings.InterfaceDensity.Equals("Compact", StringComparison.OrdinalIgnoreCase)
        ? " admin-density-compact" : "";
}
<!DOCTYPE html>
<html lang="en" data-admin-theme="@adminTheme">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@pageTitle · Karnel Admin</title>
    <meta name="description" content="Karnel Travel Guide administration prototype" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display&family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,600;9..40,700&display=swap" rel="stylesheet" />

    <style>
            :root {
                --forest: #164734;
                --green: #236b4d;
                --accent: #3c9169;
                --paper: #f6f7f3;
                --white: #ffffff;
                --ink: #1b2922;
                --muted: #758078;
                --line: #e5e9e3;
                --line-hi: #d6dcd4;
                --soft: #edf2ed;
                --soft-2: #e3ece5;
                --amber: #b9853c;
                --red: #ae5d50;
                --surface-sunken: #fbfcfa;
                --shadow-xs: 0 1px 2px rgba(22,71,52,.05);
                --shadow-sm: 0 2px 6px -2px rgba(22,71,52,.08);
                --shadow: 0 12px 35px -12px rgba(22,71,52,.12);
                --shadow-lg: 0 28px 70px -28px rgba(22,71,52,.28);
                --ring-accent: 0 0 0 3px rgba(60,145,105,.22);
                --ease: cubic-bezier(.22,.72,.24,1);
                --ease-out: cubic-bezier(.16,1,.3,1);
                --dur-fast: .14s;
                --dur: .22s;
                --dur-slow: .34s;
                --serif: 'DM Serif Display', Georgia, 'Iowan Old Style', serif;
                --sans: 'DM Sans', system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
                --radius: 12px;
                --radius-pill: 999px;
                --topbar-h: 72px;
                --maxw: 1440px;
                --pad-x: clamp(20px, 4vw, 64px);
            }

            /* ---------- Karnel command-rail identity ---------- */
            :root {
                --rail-w: 76px;
                --panel-w: 292px;
                --forest-deep: #14271F;
                --forest-deep-2: #0E1D17;
                --forest-panel: #1B3428;
                --forest-panel-2: #162B21;
                --sage: #8FA888;
                --sand: #E8DFC9;
                --ivory: #F8F6F0;
                --rail-line: rgba(232,223,201,.10);
                --rail-line-strong: rgba(232,223,201,.18);
                --rail-ink: #9DB4A4;
                --rail-ink-hi: #E9E1CD;
            }

            *, *::before, *::after {
                box-sizing: border-box;
            }

            html {
                scroll-behavior: smooth;
                -webkit-text-size-adjust: 100%;
            }

            body.admin-body {
                margin: 0;
                background: var(--paper);
                color: var(--ink);
                font-family: var(--sans);
                font-size: 14px;
                line-height: 1.55;
                -webkit-font-smoothing: antialiased;
            }

            html[data-admin-theme="dark"] body.admin-body {
                --paper: #17231d;
                --surface: #203128;
                --surface-2: #263b30;
                --ink: #edf4ed;
                --muted: #b6c4b8;
                --line: #405248;
            }

            html[data-admin-theme="light"] body.admin-body,
            html[data-admin-theme="system"] body.admin-body {
                color-scheme: light;
            }

            @@media (prefers-color-scheme: dark) {
                html[data-admin-theme="system"] body.admin-body {
                    --paper: #17231d;
                    --surface: #203128;
                    --surface-2: #263b30;
                    --ink: #edf4ed;
                    --muted: #b6c4b8;
                    --line: #405248;
                }
            }

            body.admin-density-compact .admin-main {
                padding-top: 24px;
                padding-bottom: 32px;
            }

            body.admin-density-compact .setting-card,
            body.admin-density-compact .table-card {
                padding: 14px;
            }

            a {
                color: inherit;
                text-decoration: none;
            }

                a:hover {
                    color: var(--forest);
                }

            button, input, select, textarea {
                font: inherit;
            }

            button {
                cursor: pointer;
                border: 0;
                background: none;
                color: inherit;
            }

            img, svg {
                display: block;
                max-width: 100%;
            }

            :focus-visible {
                outline: 2px solid var(--accent);
                outline-offset: 2px;
                border-radius: 6px;
            }

            ::selection {
                background: var(--soft-2);
                color: var(--forest);
            }

            /* Shell */
            .admin-shell {
                min-height: 100vh;
                display: flex;
            }

            .admin-content {
                flex: 1 1 auto;
                min-width: 0;
                display: flex;
                flex-direction: column;
                margin-left: var(--rail-w);
            }

            .admin-topbar {
                height: var(--topbar-h);
                background: rgba(255,255,255,.88);
                backdrop-filter: saturate(160%) blur(12px);
                -webkit-backdrop-filter: saturate(160%) blur(12px);
                border-bottom: 1px solid var(--line);
                display: flex;
                align-items: center;
                padding: 0 var(--pad-x);
                gap: 16px;
                position: sticky;
                top: 0;
                z-index: 20;
            }

            .admin-main {
                flex: 1 1 auto;
                max-width: var(--maxw);
                width: 100%;
                margin: 0 auto;
                padding: 42px var(--pad-x) 64px;
            }

            .admin-footer {
                max-width: var(--maxw);
                width: 100%;
                margin: 0 auto;
                padding: 22px var(--pad-x);
                border-top: 1px solid var(--line);
                display: flex;
                justify-content: space-between;
                color: var(--muted);
                font-size: 12px;
            }

            .live-dot {
                display: inline-block;
                width: 7px;
                height: 7px;
                background: var(--accent);
                border-radius: 50%;
                margin-right: 6px;
                box-shadow: 0 0 0 3px rgba(60,145,105,.15);
                animation: livePulse 2.4s ease-in-out infinite;
            }

            @@keyframes livePulse {
                0%, 100% {
                    box-shadow: 0 0 0 3px rgba(60,145,105,.15);
                }

                50% {
                    box-shadow: 0 0 0 6px rgba(60,145,105,.05);
                }
            }

            /* ============================================================
                       ICON SYSTEM
                       ============================================================ */
            .icon-sprite {
                position: absolute;
                width: 0;
                height: 0;
                overflow: hidden;
            }

            .nav-icon {
                width: 18px;
                height: 18px;
                flex-shrink: 0;
                fill: none;
                stroke: currentColor;
                stroke-width: 1.65;
                stroke-linecap: round;
                stroke-linejoin: round;
            }

            /* ============================================================
                       ADAPTIVE COMMAND RAIL — COLLAPSED STATE (76px)
                       ============================================================ */
            .admin-rail {
                position: fixed;
                inset: 0 auto 0 0;
                z-index: 46;
                width: var(--rail-w);
                display: flex;
                flex-direction: column;
                align-items: center;
                padding: 16px 0 14px;
                background: linear-gradient(180deg, var(--forest-deep) 0%, var(--forest-deep-2) 100%);
                border-right: 1px solid var(--rail-line);
            }

            .rail-brand {
                width: 44px;
                height: 44px;
                display: grid;
                place-items: center;
                border-radius: 14px;
                background: linear-gradient(150deg, #F3EAD1 0%, #D8C79B 100%);
                color: var(--forest-deep);
                font-family: var(--serif);
                font-size: 23px;
                line-height: 1;
                letter-spacing: -.02em;
                box-shadow: 0 10px 22px -12px rgba(0,0,0,.95);
                transition: transform var(--dur) var(--ease), box-shadow var(--dur) var(--ease);
            }

                .rail-brand:hover {
                    color: var(--forest-deep);
                    transform: translateY(-1px);
                    box-shadow: 0 14px 26px -12px rgba(0,0,0,1);
                }

            .rail-toggle {
                margin-top: 14px;
                width: 42px;
                height: 30px;
                display: grid;
                place-items: center;
                border-radius: 9px;
                color: var(--sage);
                border: 1px solid var(--rail-line);
                background: rgba(232,223,201,.035);
                transition: color var(--dur-fast) var(--ease), background var(--dur-fast) var(--ease), border-color var(--dur-fast) var(--ease);
            }

                .rail-toggle:hover {
                    color: var(--sand);
                    background: rgba(232,223,201,.09);
                    border-color: var(--rail-line-strong);
                }

                .rail-toggle .nav-icon {
                    width: 15px;
                    height: 15px;
                    transition: transform var(--dur) var(--ease);
                }

            .admin-rail.is-expanded .rail-toggle .nav-icon {
                transform: rotate(180deg);
            }

            .rail-divider {
                width: 26px;
                height: 1px;
                margin: 12px 0;
                background: var(--rail-line);
                flex-shrink: 0;
            }

            .rail-nav {
                width: 100%;
                display: flex;
                flex-direction: column;
                align-items: center;
                gap: 4px;
            }

            .rail-spacer {
                flex: 1 1 auto;
                min-height: 12px;
            }

            .rail-btn {
                position: relative;
                width: 46px;
                height: 46px;
                display: grid;
                place-items: center;
                border-radius: 12px;
                color: var(--rail-ink);
                transition: color var(--dur-fast) var(--ease), background var(--dur-fast) var(--ease);
            }

                .rail-btn .nav-icon {
                    width: 20px;
                    height: 20px;
                    stroke-width: 1.55;
                    opacity: .9;
                    transition: opacity var(--dur-fast) var(--ease), transform var(--dur-fast) var(--ease);
                }

                .rail-btn:hover {
                    color: var(--rail-ink-hi);
                    background: rgba(232,223,201,.075);
                }

                    .rail-btn:hover .nav-icon {
                        opacity: 1;
                        transform: translateY(-.5px);
                    }

                .rail-btn.is-active {
                    color: var(--rail-ink-hi);
                    background: rgba(143,168,136,.18);
                }

                    .rail-btn.is-active .nav-icon {
                        color: var(--sand);
                        opacity: 1;
                    }

                    .rail-btn.is-active::before {
                        content: "";
                        position: absolute;
                        left: -15px;
                        top: 50%;
                        transform: translateY(-50%);
                        width: 3px;
                        height: 20px;
                        border-radius: 0 3px 3px 0;
                        background: var(--sand);
                    }

            .rail-profile {
                position: relative;
                margin-top: 6px;
                width: 46px;
                height: 46px;
                display: grid;
                place-items: center;
                border-radius: 50%;
                transition: transform var(--dur-fast) var(--ease);
            }

                .rail-profile:hover {
                    transform: translateY(-1px);
                }

                .rail-profile .avatar {
                    width: 38px;
                    height: 38px;
                    font-size: 11px;
                    background: linear-gradient(145deg, #F3EAD1 0%, #D8C79B 100%);
                    color: var(--forest-deep);
                    box-shadow: 0 0 0 2px rgba(232,223,201,.16);
                    transition: box-shadow var(--dur-fast) var(--ease);
                }

                .rail-profile:hover .avatar {
                    box-shadow: 0 0 0 3px rgba(232,223,201,.30);
                }

            /* --- Rail tooltips (never clipped) --- */
            [data-tip]::after {
                content: attr(data-tip);
                position: absolute;
                left: calc(100% + 14px);
                top: 50%;
                transform: translateY(-50%) translateX(-5px);
                padding: 6px 10px;
                border-radius: 8px;
                background: var(--forest-deep);
                color: var(--ivory);
                border: 1px solid var(--rail-line-strong);
                font-family: var(--sans);
                font-size: 11.5px;
                font-weight: 600;
                letter-spacing: .01em;
                white-space: nowrap;
                opacity: 0;
                visibility: hidden;
                pointer-events: none;
                z-index: 60;
                box-shadow: 0 14px 30px -14px rgba(0,0,0,.9);
                transition: opacity var(--dur-fast) var(--ease), transform var(--dur-fast) var(--ease), visibility var(--dur-fast) linear;
            }

            [data-tip]:hover::after,
            [data-tip]:focus-visible::after {
                opacity: 1;
                visibility: visible;
                transform: translateY(-50%) translateX(0);
            }

            .admin-rail.is-expanded [data-tip]::after {
                display: none;
            }

            /* ============================================================
                       ADAPTIVE COMMAND RAIL — EXPANDED PANEL (292px, floating)
                       ============================================================ */
            .admin-panel {
                position: fixed;
                top: 0;
                bottom: 0;
                left: var(--rail-w);
                z-index: 44;
                width: var(--panel-w);
                display: flex;
                flex-direction: column;
                background: linear-gradient(180deg, var(--forest-panel) 0%, var(--forest-panel-2) 100%);
                border-right: 1px solid var(--rail-line);
                box-shadow: 34px 0 80px -44px rgba(0,0,0,.9);
                transform: translateX(-100%);
                opacity: 0;
                visibility: hidden;
                pointer-events: none;
                transition: transform .28s var(--ease), opacity .22s var(--ease), visibility 0s linear .28s;
            }

                .admin-panel.is-open {
                    transform: translateX(0);
                    opacity: 1;
                    visibility: visible;
                    pointer-events: auto;
                    transition: transform .28s var(--ease), opacity .22s var(--ease), visibility 0s linear 0s;
                }

            .panel-head {
                flex-shrink: 0;
                display: flex;
                align-items: center;
                gap: 10px;
                padding: 21px 14px 17px 20px;
                border-bottom: 1px solid var(--rail-line);
            }

            .panel-brand {
                min-width: 0;
                flex: 1 1 auto;
            }

                .panel-brand strong {
                    display: block;
                    font-family: var(--serif);
                    font-weight: 400;
                    font-size: 20px;
                    line-height: 1;
                    letter-spacing: -.01em;
                    color: #fff;
                }

                .panel-brand small {
                    display: block;
                    margin-top: 6px;
                    font-size: 8.5px;
                    font-weight: 600;
                    letter-spacing: .18em;
                    text-transform: uppercase;
                    color: var(--sage);
                }

            .panel-collapse {
                flex-shrink: 0;
                width: 30px;
                height: 30px;
                display: grid;
                place-items: center;
                border-radius: 8px;
                color: var(--sage);
                border: 1px solid var(--rail-line);
                transition: color var(--dur-fast) var(--ease), background var(--dur-fast) var(--ease), border-color var(--dur-fast) var(--ease);
            }

                .panel-collapse:hover {
                    color: var(--sand);
                    background: rgba(232,223,201,.09);
                    border-color: var(--rail-line-strong);
                }

                .panel-collapse .nav-icon {
                    width: 14px;
                    height: 14px;
                }

            .panel-nav {
                position: relative;
                flex: 1 1 auto;
                overflow-y: auto;
                overscroll-behavior: contain;
                padding: 14px 12px 22px;
                scrollbar-width: thin;
                scrollbar-color: rgba(232,223,201,.20) transparent;
            }

                .panel-nav::-webkit-scrollbar {
                    width: 6px;
                }

                .panel-nav::-webkit-scrollbar-thumb {
                    background: rgba(232,223,201,.18);
                    border-radius: 99px;
                }

                .panel-nav::-webkit-scrollbar-track {
                    background: transparent;
                }

            .nav-link {
                position: relative;
                display: flex;
                align-items: center;
                gap: 10px;
                padding: 9px 10px;
                border-radius: 8px;
                color: #BFD0C2;
                font-size: 13.5px;
                font-weight: 500;
                line-height: 1.3;
                transition: background var(--dur-fast) var(--ease), color var(--dur-fast) var(--ease);
            }

                .nav-link .nav-icon {
                    width: 17px;
                    height: 17px;
                    opacity: .68;
                    transition: opacity var(--dur-fast) var(--ease), color var(--dur-fast) var(--ease);
                }

                .nav-link:hover {
                    background: rgba(232,223,201,.065);
                    color: #fff;
                }

                    .nav-link:hover .nav-icon {
                        opacity: .95;
                    }

                .nav-link.is-active {
                    background: rgba(143,168,136,.17);
                    color: #fff;
                    font-weight: 600;
                }

                    .nav-link.is-active .nav-icon {
                        opacity: 1;
                        color: var(--sand);
                    }

                    .nav-link.is-active::before {
                        content: "";
                        position: absolute;
                        left: -12px;
                        top: 50%;
                        transform: translateY(-50%);
                        width: 3px;
                        height: 18px;
                        border-radius: 0 3px 3px 0;
                        background: var(--sand);
                    }

            .nav-sep {
                height: 1px;
                margin: 12px 10px;
                background: var(--rail-line);
            }

            .nav-group {
                margin-top: 10px;
            }

                .nav-group:first-of-type {
                    margin-top: 4px;
                }

            .nav-group-toggle {
                display: flex;
                align-items: center;
                justify-content: space-between;
                gap: 10px;
                width: 100%;
                padding: 7px 10px;
                border-radius: 8px;
                color: var(--sage);
                font-size: 9.5px;
                font-weight: 700;
                letter-spacing: .17em;
                text-transform: uppercase;
                transition: color var(--dur-fast) var(--ease), background var(--dur-fast) var(--ease);
            }

                .nav-group-toggle:hover {
                    color: var(--sand);
                    background: rgba(232,223,201,.055);
                }

            .group-chevron {
                width: 13px;
                height: 13px;
                stroke-width: 2;
                opacity: .85;
                transition: transform var(--dur) var(--ease);
            }

            .nav-group.is-open .group-chevron {
                transform: rotate(180deg);
            }

            .nav-group-body {
                display: none;
                padding-top: 2px;
            }

            .nav-group.is-open .nav-group-body {
                display: block;
            }

            .panel-foot {
                flex-shrink: 0;
                padding: 12px;
                border-top: 1px solid var(--rail-line);
                background: rgba(0,0,0,.16);
            }

            .panel-user {
                display: flex;
                align-items: center;
                gap: 10px;
                width: 100%;
                padding: 8px;
                border-radius: 10px;
                border: 1px solid transparent;
                background: rgba(232,223,201,.055);
                text-align: left;
                transition: background var(--dur-fast) var(--ease), border-color var(--dur-fast) var(--ease);
            }

                .panel-user:hover {
                    background: rgba(232,223,201,.11);
                    border-color: var(--rail-line-strong);
                }

                .panel-user .avatar {
                    width: 34px;
                    height: 34px;
                    flex-shrink: 0;
                    font-size: 10.5px;
                    background: linear-gradient(145deg, #F3EAD1 0%, #D8C79B 100%);
                    color: var(--forest-deep);
                }

            .profile-meta {
                min-width: 0;
                flex: 1 1 auto;
            }

            .profile-name {
                display: block;
                color: #fff;
                font-size: 12.5px;
                font-weight: 600;
                line-height: 1.2;
                white-space: nowrap;
                overflow: hidden;
                text-overflow: ellipsis;
            }

            .profile-role {
                display: block;
                margin-top: 2px;
                font-size: 10.5px;
                color: var(--sage);
            }

            /* Mobile drawer scrim */
            .admin-scrim {
                display: none;
                position: fixed;
                inset: 0;
                z-index: 43;
                background: rgba(6,14,11,.55);
                backdrop-filter: blur(2px);
                -webkit-backdrop-filter: blur(2px);
                opacity: 0;
                pointer-events: none;
                transition: opacity var(--dur) var(--ease);
            }

                .admin-scrim.is-open {
                    opacity: 1;
                    pointer-events: auto;
                }

            /* ============================================================
                       Topbar actions (unchanged behaviour)
                       ============================================================ */
            .admin-actions {
                display: flex;
                align-items: center;
                gap: 10px;
                margin-left: auto;
            }

            .icon-button {
                font-size: 20px;
                position: relative;
                color: var(--muted);
                width: 38px;
                height: 38px;
                display: grid;
                place-items: center;
                border-radius: 9px;
                border: 1px solid var(--line);
                background: var(--white);
                transition: background var(--dur-fast) var(--ease), color var(--dur-fast) var(--ease), border-color var(--dur-fast) var(--ease);
            }

                .icon-button:hover {
                    background: var(--soft);
                    color: var(--forest);
                    border-color: var(--line-hi);
                }

            .profile-chip {
                display: flex;
                gap: 9px;
                align-items: center;
                font-weight: 600;
                padding: 4px 12px 4px 4px;
                border-radius: var(--radius-pill);
                border: 1px solid var(--line);
                background: var(--white);
                transition: background var(--dur-fast) var(--ease), border-color var(--dur-fast) var(--ease);
            }

                .profile-chip:hover {
                    background: var(--soft);
                    border-color: var(--line-hi);
                }

            .avatar {
                width: 32px;
                height: 32px;
                display: grid;
                place-items: center;
                border-radius: 50%;
                background: var(--soft-2);
                color: var(--forest);
                font-size: 10.5px;
                font-weight: 700;
                letter-spacing: .04em;
            }

            .profile-chip .avatar {
                background: var(--soft-2);
                color: var(--forest);
            }

            .profile-chip .profile-name {
                font-size: 13px;
                color: var(--ink);
            }

            .topbar-heading {
                min-width: 0;
                display: flex;
                flex-direction: column;
                gap: 2px;
            }

                .topbar-heading .eyebrow {
                    margin: 0;
                    font-size: 9.5px;
                    line-height: 1;
                    color: var(--muted);
                    letter-spacing: .16em;
                }

            .topbar-title {
                color: var(--forest);
                font-family: var(--serif);
                font-size: 16px;
                font-weight: 400;
                line-height: 1.15;
                letter-spacing: -.01em;
                white-space: nowrap;
                overflow: hidden;
                text-overflow: ellipsis;
            }

            .nav-toggle {
                display: none;
                width: 38px;
                height: 38px;
                border-radius: 9px;
                border: 1px solid var(--line);
                background: var(--white);
                align-items: center;
                justify-content: center;
                flex-direction: column;
                gap: 4px;
            }

                .nav-toggle span {
                    display: block;
                    height: 2px;
                    width: 18px;
                    background: var(--forest);
                    border-radius: 2px;
                    transition: transform var(--dur) var(--ease), width var(--dur) var(--ease);
                }

                    .nav-toggle span:nth-child(2) {
                        width: 12px;
                    }

                .nav-toggle:hover {
                    background: var(--soft);
                }

            /* Buttons */
            .btn {
                display: inline-flex;
                align-items: center;
                justify-content: center;
                gap: 8px;
                border: 1px solid var(--line);
                border-radius: 8px;
                padding: 10px 16px;
                background: var(--white);
                font-weight: 700;
                font-size: 13px;
                color: var(--ink);
                transition: border-color var(--dur-fast) var(--ease), color var(--dur-fast) var(--ease), background var(--dur-fast) var(--ease), transform var(--dur-fast) var(--ease), box-shadow var(--dur-fast) var(--ease);
            }

                .btn:hover {
                    border-color: var(--accent);
                    color: var(--forest);
                    box-shadow: var(--shadow-xs);
                }

                .btn:active {
                    transform: translateY(1px);
                }

            .btn-primary {
                background: var(--forest);
                color: #fff;
                border-color: var(--forest);
                box-shadow: 0 2px 10px -4px rgba(22,71,52,.4);
            }

                .btn-primary:hover {
                    background: var(--green);
                    border-color: var(--green);
                    color: #fff;
                    box-shadow: 0 6px 20px -8px rgba(22,71,52,.5);
                }

            .btn-quiet {
                background: var(--soft);
                border-color: transparent;
                color: var(--forest);
            }

                .btn-quiet:hover {
                    background: var(--soft-2);
                    border-color: transparent;
                }

            /* Typography */
            .eyebrow {
                font-size: 11px;
                letter-spacing: .15em;
                text-transform: uppercase;
                color: var(--accent);
                font-weight: 700;
                margin: 0 0 10px;
            }

            .page-heading {
                display: flex;
                justify-content: space-between;
                align-items: end;
                gap: 24px;
                margin-bottom: 30px;
            }

                .page-heading h1, .hero-copy h1 {
                    font-family: var(--serif);
                    font-weight: 400;
                    color: var(--forest);
                    font-size: clamp(34px, 4vw, 56px);
                    line-height: 1.03;
                    letter-spacing: -.015em;
                    margin: 0;
                }

                .page-heading p {
                    color: var(--muted);
                    margin: 10px 0 0;
                    max-width: 62ch;
                }

            /* Panels */
            .panel {
                background: var(--white);
                border: 1px solid var(--line);
                border-radius: var(--radius);
                padding: 24px;
                transition: box-shadow var(--dur) var(--ease), border-color var(--dur) var(--ease);
            }

                .panel:hover {
                    border-color: var(--line-hi);
                }

            .panel-title {
                display: flex;
                justify-content: space-between;
                align-items: center;
                margin-bottom: 18px;
                gap: 12px;
            }

                .panel-title h2, .panel-title h3 {
                    font-family: var(--serif);
                    font-weight: 400;
                    color: var(--forest);
                    font-size: 24px;
                    letter-spacing: -.01em;
                    margin: 0;
                }

                .panel-title a {
                    color: var(--accent);
                    font-size: 12px;
                    font-weight: 700;
                    transition: color var(--dur-fast) var(--ease);
                }

                    .panel-title a:hover {
                        color: var(--green);
                    }

                .panel-title > div {
                    min-width: 0;
                }

                    .panel-title > div h2 {
                        margin: 0;
                        line-height: 1.15;
                    }

            .panel-subtitle {
                margin: 5px 0 0;
                color: var(--muted);
                font-size: 12.5px;
                line-height: 1.5;
                letter-spacing: 0;
                font-family: var(--sans);
                font-weight: 400;
            }

            /* Hero */
            .hero-panel {
                min-height: 320px;
                background: linear-gradient(90deg, rgba(15,50,37,.90), rgba(15,50,37,.20)), url('https://images.unsplash.com/photo-1500534623283-312aade485b7?auto=format&fit=crop&w=1500&q=80') center/cover;
                border-radius: var(--radius);
                padding: 44px;
                display: flex;
                align-items: end;
                color: #fff;
                position: relative;
                overflow: hidden;
                isolation: isolate;
                box-shadow: var(--shadow);
            }

                .hero-panel::after {
                    content: "";
                    position: absolute;
                    inset: 0;
                    background: radial-gradient(120% 80% at 100% 0%, transparent 40%, rgba(15,50,37,.35));
                    z-index: -1;
                    pointer-events: none;
                }

            .hero-copy {
                max-width: 520px;
                position: relative;
                z-index: 1;
            }

                .hero-copy .eyebrow {
                    color: #b9d9bd;
                }

                .hero-copy h1 {
                    color: #fff;
                }

                .hero-copy p {
                    color: #e0ece1;
                    max-width: 440px;
                    margin: 12px 0 0;
                    font-size: 15px;
                    line-height: 1.6;
                }

                .hero-copy .btn {
                    margin-top: 20px;
                }

            .hero-note {
                position: absolute;
                right: 28px;
                top: 28px;
                padding: 8px 13px;
                background: rgba(255,255,255,.12);
                border: 1px solid rgba(255,255,255,.22);
                border-radius: var(--radius-pill);
                font-size: 11px;
                font-weight: 500;
                letter-spacing: .02em;
                backdrop-filter: blur(6px);
                -webkit-backdrop-filter: blur(6px);
            }

            /* Metrics */
            .dashboard-grid {
                display: grid;
                grid-template-columns: 1.35fr .85fr;
                gap: 20px;
                margin-top: 20px;
            }

            .metric-row {
                display: grid;
                grid-template-columns: repeat(4, 1fr);
                gap: 14px;
                margin-top: 20px;
            }

            .metric {
                background: var(--white);
                padding: 20px 22px;
                border: 1px solid var(--line);
                border-radius: var(--radius);
                position: relative;
                transition: transform var(--dur) var(--ease), box-shadow var(--dur) var(--ease), border-color var(--dur) var(--ease);
            }

                .metric:hover {
                    transform: translateY(-2px);
                    box-shadow: var(--shadow-sm);
                    border-color: var(--line-hi);
                }

                .metric label {
                    color: var(--muted);
                    font-size: 11.5px;
                    letter-spacing: .04em;
                    text-transform: uppercase;
                    font-weight: 600;
                }

                .metric strong {
                    display: block;
                    font-size: 30px;
                    color: var(--forest);
                    margin: 8px 0 3px;
                    letter-spacing: -.02em;
                    font-variant-numeric: tabular-nums;
                    line-height: 1.15;
                }

                .metric small {
                    color: var(--muted);
                    font-size: 12px;
                    font-weight: 600;
                }

                    .metric small.metric-up {
                        color: var(--accent);
                    }

                        .metric small.metric-up::before {
                            content: "▲ ";
                            font-size: 9px;
                            opacity: .8;
                        }

                    .metric small.metric-warn {
                        color: var(--amber);
                    }

                        .metric small.metric-warn::before {
                            content: "● ";
                            font-size: 9px;
                            opacity: .85;
                        }

                    .metric small.metric-down {
                        color: var(--red);
                    }

                        .metric small.metric-down::before {
                            content: "▼ ";
                            font-size: 9px;
                            opacity: .8;
                        }

            /* Activity chart */
            .activity {
                height: 210px;
                display: flex;
                align-items: end;
                gap: 10px;
                padding: 20px 6px 0;
                position: relative;
            }

            .bar {
                flex: 1;
                background: linear-gradient(180deg, var(--soft-2), #d8e8db);
                border-radius: 6px 6px 2px 2px;
                min-height: 18px;
                position: relative;
                transition: background var(--dur) var(--ease), transform var(--dur) var(--ease);
                cursor: pointer;
            }

                .bar:nth-child(2n) {
                    background: linear-gradient(180deg, var(--accent), var(--green));
                }

                .bar:hover {
                    transform: translateY(-3px);
                }

                    .bar:hover::after {
                        content: attr(data-value);
                        position: absolute;
                        bottom: calc(100% + 6px);
                        left: 50%;
                        transform: translateX(-50%);
                        background: var(--forest);
                        color: #fff;
                        font-size: 10px;
                        font-weight: 600;
                        padding: 4px 8px;
                        border-radius: 5px;
                        white-space: nowrap;
                        pointer-events: none;
                    }

                .bar span {
                    position: absolute;
                    top: calc(100% + 8px);
                    margin-top: 0;
                    font-size: 10px;
                    color: var(--muted);
                    left: 50%;
                    transform: translateX(-50%);
                    font-weight: 500;
                    letter-spacing: .02em;
                    white-space: nowrap;
                }

            /* Lists */
            .booking-list, .departure-list {
                display: grid;
                gap: 2px;
            }

            .list-item {
                display: flex;
                align-items: center;
                justify-content: space-between;
                gap: 12px;
                padding: 14px 0;
                border-bottom: 1px solid var(--line);
                transition: background var(--dur-fast) var(--ease);
                border-radius: 6px;
            }

                .list-item:last-child {
                    border-bottom: 0;
                }

                .list-item:hover {
                    background: var(--surface-sunken);
                }

                .list-item strong {
                    display: block;
                    font-weight: 600;
                    color: var(--ink);
                }

                .list-item small {
                    color: var(--muted);
                    font-size: 12px;
                }

            .status {
                font-size: 11px;
                font-weight: 700;
                white-space: nowrap;
                display: inline-flex;
                align-items: center;
                gap: 6px;
                padding: 4px 9px;
                background: var(--soft);
                color: var(--forest);
                border-radius: var(--radius-pill);
                letter-spacing: .02em;
            }

                .status i {
                    width: 6px;
                    height: 6px;
                    border-radius: 50%;
                    background: var(--accent);
                    flex-shrink: 0;
                }

            .status-pending, .status-in-progress {
                background: rgba(185,133,60,.10);
                color: #8a5f22;
            }

                .status-pending i, .status-in-progress i {
                    background: var(--amber);
                }

            .status-cancelled, .status-rejected {
                background: rgba(174,93,80,.10);
                color: #8b4137;
            }

                .status-cancelled i, .status-rejected i {
                    background: var(--red);
                }

            .status-draft {
                background: #eef0ec;
                color: var(--muted);
            }

                .status-draft i {
                    background: var(--muted);
                }

            /* Quick actions */
            .quick-actions {
                display: grid;
                grid-template-columns: repeat(2, 1fr);
                gap: 9px;
            }

            .quick-action {
                padding: 14px;
                background: var(--soft);
                border-radius: 9px;
                color: var(--forest);
                font-weight: 700;
                font-size: 12.5px;
                transition: background var(--dur-fast) var(--ease), transform var(--dur-fast) var(--ease);
                display: flex;
                align-items: center;
                gap: 8px;
            }

                .quick-action::before {
                    content: "+";
                    display: inline-flex;
                    align-items: center;
                    justify-content: center;
                    width: 20px;
                    height: 20px;
                    background: var(--white);
                    border-radius: 50%;
                    font-size: 14px;
                    color: var(--green);
                    font-weight: 700;
                    box-shadow: var(--shadow-xs);
                }

                .quick-action:hover {
                    background: var(--soft-2);
                    transform: translateY(-1px);
                    color: var(--forest);
                }

            /* Utils */
            .section-space {
                margin-top: 20px;
            }

            .muted {
                color: var(--muted);
                font-size: 13px;
                line-height: 1.55;
                margin: 0;
            }

            /* Toast */
            .toast {
                position: fixed;
                bottom: 25px;
                right: 25px;
                background: var(--forest);
                color: #fff;
                padding: 14px 20px;
                border-radius: 9px;
                box-shadow: var(--shadow-lg);
                transform: translateY(20px);
                opacity: 0;
                pointer-events: none;
                transition: transform var(--dur) var(--ease-out), opacity var(--dur) var(--ease-out);
                z-index: 50;
                font-size: 13px;
                font-weight: 500;
                max-width: min(360px, calc(100vw - 40px));
                border-left: 3px solid var(--accent);
            }

                .toast.is-visible {
                    transform: translateY(0);
                    opacity: 1;
                }

            /* Responsive */
            @@media (max-width: 1050px) {
                .dashboard-grid {
                    grid-template-columns: 1fr;
                }

                .metric-row {
                    grid-template-columns: repeat(2, 1fr);
                }

                .profile-chip .profile-name {
                    display: none;
                }

                .profile-chip {
                    padding: 4px;
                }
            }

            @@media (max-width: 1024px) {
                .admin-rail {
                    display: none;
                }

                .admin-content {
                    margin-left: 0;
                }

                .admin-panel {
                    left: 0;
                    width: min(320px, 86vw);
                    z-index: 45;
                    box-shadow: 0 0 60px rgba(0,0,0,.55);
                }

                .admin-scrim {
                    display: block;
                }

                .nav-toggle {
                    display: flex;
                }

                body.is-nav-open {
                    overflow: hidden;
                }
            }

            @@media (max-width: 760px) {
                .admin-topbar {
                    height: 66px;
                    padding: 0 16px;
                    gap: 10px;
                }

                .admin-main {
                    padding: 28px 16px 48px;
                }

                .admin-footer {
                    padding: 18px 16px;
                    display: block;
                    text-align: left;
                }

                    .admin-footer span {
                        display: block;
                        margin: 4px 0;
                    }

                .hero-panel {
                    padding: 28px;
                    min-height: 380px;
                }

                .hero-copy h1 {
                    font-size: 40px;
                }

                .metric-row {
                    grid-template-columns: 1fr 1fr;
                    gap: 10px;
                }

                .metric {
                    padding: 16px;
                }

                    .metric strong {
                        font-size: 24px;
                    }

                .panel {
                    padding: 18px;
                }

                .profile-chip {
                    display: none;
                }

                .topbar-heading .eyebrow {
                    display: none;
                }

                .toast {
                    right: 16px;
                    left: 16px;
                    bottom: 16px;
                    max-width: none;
                }
            }

            @@media (prefers-reduced-motion: reduce) {
                *, *::before, *::after {
                    animation-duration: .001ms !important;
                    transition-duration: .001ms !important;
                    scroll-behavior: auto !important;
                }
            }
    </style>
</head>
