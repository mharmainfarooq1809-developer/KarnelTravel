    <div class="toast" role="status" aria-live="polite" data-toast-region></div>

    <script>
            (function () {
                "use strict";

                var rail = document.querySelector("[data-rail]");
                var panel = document.querySelector("[data-panel]");
                var scrim = document.querySelector("[data-panel-scrim]");
                var openers = document.querySelectorAll("[data-panel-toggle]");
                var closers = document.querySelectorAll("[data-panel-close]");
                var mq = window.matchMedia("(max-width: 1024px)");

                function isMobile() { return mq.matches; }
                function panelNav() { return panel ? panel.querySelector(".panel-nav") : null; }

                /* ---------- Panel open / close ---------- */
                function setPanel(open) {
                    if (!panel) return;

                    panel.classList.toggle("is-open", open);
                    if (rail) rail.classList.toggle("is-expanded", open);
                    if (scrim) scrim.classList.toggle("is-open", open);

                    openers.forEach(function (b) {
                        b.setAttribute("aria-expanded", String(open));
                    });

                    document.body.classList.toggle("is-nav-open", open && isMobile());

                    if ("inert" in panel) panel.inert = !open;

                    if (open) revealActive();
                }

                function revealActive() {
                    var nav = panelNav();
                    var active = panel ? panel.querySelector(".nav-link.is-active") : null;
                    if (!nav || !active) return;
                    var target = active.offsetTop - (nav.clientHeight / 2) + (active.offsetHeight / 2);
                    nav.scrollTop = Math.max(0, target);
                }

                openers.forEach(function (btn) {
                    btn.addEventListener("click", function () {
                        if (!panel) return;
                        setPanel(!panel.classList.contains("is-open"));
                    });
                });

                closers.forEach(function (btn) {
                    btn.addEventListener("click", function () { setPanel(false); });
                });

                if (scrim) {
                    scrim.addEventListener("click", function () { setPanel(false); });
                }

                /* ---------- Collapsible groups ---------- */
                function setGroup(group, open) {
                    if (!group) return;
                    group.classList.toggle("is-open", open);
                    var toggle = group.querySelector("[data-group-toggle]");
                    if (toggle) toggle.setAttribute("aria-expanded", String(open));
                }

                Array.prototype.forEach.call(
                    document.querySelectorAll("[data-group-toggle]"),
                    function (btn) {
                        btn.addEventListener("click", function () {
                            var group = btn.closest("[data-group]");
                            if (!group) return;
                            setGroup(group, !group.classList.contains("is-open"));
                        });
                    }
                );

                /* ---------- Rail group shortcuts ---------- */
                Array.prototype.forEach.call(
                    document.querySelectorAll("[data-open-group]"),
                    function (btn) {
                        btn.addEventListener("click", function () {
                            if (!panel) return;
                            setPanel(true);

                            var name = btn.getAttribute("data-open-group");
                            var group = panel.querySelector('[data-group="' + name + '"]');
                            if (!group) return;

                            setGroup(group, true);

                            var nav = panelNav();
                            if (!nav) return;

                            window.setTimeout(function () {
                                var top = Math.max(0, group.offsetTop - 16);
                                if (typeof nav.scrollTo === "function") {
                                    nav.scrollTo({ top: top, behavior: "smooth" });
                                } else {
                                    nav.scrollTop = top;
                                }
                            }, 60);
                        });
                    }
                );

                /* ---------- Mobile link dismissal ---------- */
                if (panel) {
                    panel.addEventListener("click", function (event) {
                        if (event.target.closest("a") && isMobile()) setPanel(false);
                    });
                }

                /* ---------- Dismissal outside the rail (desktop only) ---------- */
                document.addEventListener("click", function (event) {
                    if (!panel || !panel.classList.contains("is-open")) return;
                    if (isMobile()) return;
                    if (event.target.closest("[data-panel]")) return;
                    if (event.target.closest("[data-rail]")) return;
                    setPanel(false);
                });

                /* ---------- Escape ---------- */
                document.addEventListener("keydown", function (event) {
                    if (event.key === "Escape" && panel && panel.classList.contains("is-open")) {
                        setPanel(false);
                    }
                });

                /* ---------- Breakpoint ---------- */
                function onBreakpoint() { setPanel(false); }

                if (typeof mq.addEventListener === "function") {
                    mq.addEventListener("change", onBreakpoint);
                } else if (typeof mq.addListener === "function") {
                    mq.addListener(onBreakpoint);
                }

                /* ---------- Initial state ---------- */
                setPanel(false);

                /* ---------- Toast ---------- */
                var toastEl = document.querySelector("[data-toast-region]");
                var timer = null;

                document.addEventListener("click", function (event) {
                    var trigger = event.target.closest("[data-toast]");

                    if (!trigger || !toastEl) return;

                    toastEl.textContent = trigger.getAttribute("data-toast");
                    toastEl.classList.add("is-visible");

                    clearTimeout(timer);

                    timer = setTimeout(function () {
                        toastEl.classList.remove("is-visible");
                    }, 3400);
                });
            })();
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>