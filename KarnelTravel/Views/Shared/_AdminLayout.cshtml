                    <span>Stays</span>
                </a>

                <a class="@Active("/admin/tours")" asp-controller="Admin" asp-action="Tours">
                    <svg class="nav-icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="m15.6 8.4-2.1 5.1-5.1 2.1 2.1-5.1z"/></svg>
                    <span>Experiences</span>
                </a>

              

                <p class="nav-group-label">Operations</p>

                <a class="@Active("/admin/transport", "/admin/calendar")" asp-controller="Admin" asp-action="Transport">
                    <svg class="nav-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 16.5V9a3 3 0 0 1 3-3h10a3 3 0 0 1 3 3v7.5"/><path d="M3 16.5h18"/><circle cx="7.5" cy="18.5" r="1.6"/><circle cx="16.5" cy="18.5" r="1.6"/></svg>
                    <span>Transport</span>
                </a>

                <a class="@Active("/admin/transport/vehicles")" asp-controller="Admin" asp-action="Vehicles">
                    <svg class="nav-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 16.5V9a3 3 0 0 1 3-3h10a3 3 0 0 1 3 3v7.5"/><path d="M3 16.5h18"/><circle cx="7.5" cy="18.5" r="1.6"/><circle cx="16.5" cy="18.5" r="1.6"/></svg>
                    <span>Vehicle inventory</span>
                </a>

                <a class="@Active("/admin/bookings")" asp-controller="Admin" asp-action="Bookings">
                    <svg class="nav-icon" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="2.5"/><path d="M8 3v4M16 3v4M3 10h18"/></svg>
                    <span>Bookings</span>
                </a>

                <p class="nav-group-label">System</p>

                <p class="nav-group-label">Karnel AI</p>
                <a class="@Active("/admin/ai")" asp-controller="AdminAI" asp-action="Overview"><span>AI Overview</span></a>
                <a class="@Active("/admin/ai/configuration")" asp-controller="AdminAI" asp-action="Configuration"><span>AI Configuration</span></a>
                <a class="@Active("/admin/ai/capabilities")" asp-controller="AdminAI" asp-action="Capabilities"><span>Capabilities</span></a>
                <a class="@Active("/admin/ai/knowledge")" asp-controller="AdminAI" asp-action="Knowledge"><span>Knowledge base</span></a>
                <a class="@Active("/admin/ai/prompts")" asp-controller="AdminAI" asp-action="Prompts"><span>Quick prompts</span></a>
                <a class="@Active("/admin/ai/recommendations")" asp-controller="AdminAI" asp-action="Recommendations"><span>Recommendations</span></a>
                <a class="@Active("/admin/ai/conversations")" asp-controller="AdminAI" asp-action="Conversations"><span>Conversations</span></a>
                <a class="@Active("/admin/ai/feedback")" asp-controller="AdminAI" asp-action="Feedback"><span>Feedback</span></a>
                <a class="@Active("/admin/ai/auditlogs")" asp-controller="AdminAI" asp-action="AuditLogs"><span>Audit logs</span></a>
                <a class="@Active("/admin/ai/health")" asp-controller="AdminAI" asp-action="Health"><span>System health</span></a>

                <a class="@Active("/admin/inquiries")" asp-controller="Admin" asp-action="Inquiries">
                    <svg class="nav-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 15.5a2.5 2.5 0 0 1-2.5 2.5H8l-4 3V6.5A2.5 2.5 0 0 1 6.5 4h11A2.5 2.5 0 0 1 20 6.5z"/></svg>
                    <span>Inquiries</span>
                </a>

                <a class="@Active("/admin/reviews")" asp-controller="Admin" asp-action="Reviews">
                    <svg class="nav-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="m12 3.8 2.6 5.3 5.9.9-4.3 4.1 1 5.9-5.2-2.8-5.2 2.8 1-5.9-4.3-4.1 5.9-.9z"/></svg>
                    <span>Reviews</span>
                </a>

                <a class="@Active("/admin/websitecontent", "/admin/website-content")" asp-controller="Admin" asp-action="WebsiteContent">
                    <svg class="nav-icon" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="4" width="18" height="16" rx="2.5"/><path d="M3 9h18M9 20V9"/></svg>
                    <span>Website content</span>
                </a>

                <a class="@Active("/admin/reports")" asp-controller="Admin" asp-action="Reports">
                    <svg class="nav-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 20V4"/><path d="M4 20h16"/><path d="M8 16v-4M12.5 16V8M17 16v-6"/></svg>
                    <span>Reports</span>
                </a>

                <a class="@Active("/admin/settings")" asp-controller="Admin" asp-action="Settings">
                    <svg class="nav-icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.7 1.7 0 0 0 .3 1.9l.1.1a2 2 0 1 1-2.8 2.8l-.1-.1a1.7 1.7 0 0 0-1.9-.3 1.7 1.7 0 0 0-1 1.5V21a2 2 0 1 1-4 0v-.1a1.7 1.7 0 0 0-1-1.5 1.7 1.7 0 0 0-1.9.3l-.1.1a2 2 0 1 1-2.8-2.8l.1-.1a1.7 1.7 0 0 0 .3-1.9 1.7 1.7 0 0 0-.3-1.9l-.1-.1a2 2 0 1 1 2.8-2.8l.1.1a1.7 1.7 0 0 0 1.9.3H9a1.7 1.7 0 0 0 1-1.5V3a2 2 0 1 1 4 0v.1a1.7 1.7 0 0 0 1 1.5 1.7 1.7 0 0 0 1.9-.3l.1-.1a2 2 0 1 1 2.8 2.8l.1.1a1.7 1.7 0 0 0-.3 1.9V9a1.7 1.7 0 0 0 1.5 1H21a2 2 0 1 1 0 4h-.1a1.7 1.7 0 0 0-1.5 1z"/></svg>
                    <span>Settings</span>
                </a>
                <a class="@Active("/admin/settings/account")" asp-controller="Admin" asp-action="AccountSettings">
                    <svg class="nav-icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="8" r="3.5"/><path d="M5 21a7 7 0 0 1 14 0"/></svg>
                    <span>Account & security</span>
                </a>
                <a class="@Active("/admin/settings/system")" asp-controller="Admin" asp-action="SystemInformation">
                    <svg class="nav-icon" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="4" width="18" height="16" rx="2"/><path d="M8 8h8M8 12h8M8 16h4"/></svg>
                    <span>System information</span>
                </a>
            </nav>

            <div class="sidebar-foot">
                <button class="sidebar-user" type="button" data-toast="Signed in as Muhammad Harmain">
                    <span class="avatar">MH</span>
                    <span class="profile-meta">
                        <span class="profile-name">Muhammad Harmain</span>
                        <span class="profile-role">Administrator</span>
                    </span>
                    <svg class="user-chevron" viewBox="0 0 24 24" aria-hidden="true"><path d="m9 6 6 6-6 6"/></svg>
                </button>
            </div>
        </aside>

        <div class="sidebar-scrim" data-sidebar-scrim aria-hidden="true"></div>

        <!-- CONTENT -->
        <div class="admin-content">
            <header class="admin-topbar">
                <button class="nav-toggle" type="button" data-nav-toggle
                        aria-label="Open navigation" aria-expanded="false" aria-controls="adminSidebar">
                    <span></span><span></span><span></span>
                </button>

                <div class="topbar-heading">
                    <span class="eyebrow">Admin</span>
                    <strong class="topbar-title">@pageTitle</strong>
                </div>

                <div class="admin-actions">
                    <button class="icon-button" type="button" aria-label="View notifications"
                            data-toast="@(pendingNotifications == 0 ? "No new alerts. Your workspace is up to date." : $"You have {pendingNotifications} pending items to review.")">
                        ♢@(pendingNotifications > 0 ? pendingNotifications.ToString() : "")<span class="notification-dot" style="@(pendingNotifications > 0 ? "" : "display:none")"></span>
                    </button>

                    <button class="profile-chip" type="button" data-toast="Signed in as Muhammad Harmain">
                        <span class="avatar">MH</span>
                        <span class="profile-name">Muhammad Harmain</span>
                    </button>
                </div>
            </header>

            <main class="admin-main">
                @RenderBody()
            </main>

            <footer class="admin-footer">
                <span>© @DateTime.Now.Year Karnel Travel Guide</span>
                <span><i class="live-dot"></i> Connected to booking database</span>
            </footer>
        </div>
    </div>

    <div class="toast" role="status" aria-live="polite" data-toast-region></div>

    <script>
        (function () {
            "use strict";

            var sidebar = document.querySelector("[data-sidebar]");
            var scrim = document.querySelector("[data-sidebar-scrim]");
            var openers = document.querySelectorAll("[data-nav-toggle]");
            var closer = document.querySelector("[data-sidebar-close]");
            var mq = window.matchMedia("(max-width: 1024px)");

            function isMobile() {
                return mq.matches;
            }

            function setOpen(open) {
                if (!sidebar) return;

                sidebar.classList.toggle("is-open", open);

                if (scrim)
                    scrim.classList.toggle("is-open", open);

                openers.forEach(function (button) {
                    button.setAttribute("aria-expanded", String(open));
                });

                if (isMobile()) {
                    document.body.classList.toggle("is-nav-open", open);
                } else {
                    document.body.classList.remove("is-nav-open");
                }
            }

            openers.forEach(function (button) {
                button.addEventListener("click", function () {
                    setOpen(!sidebar.classList.contains("is-open"));
                });
            });

            if (closer)
                closer.addEventListener("click", function () {
                    setOpen(false);
                });

            if (scrim)
                scrim.addEventListener("click", function () {
                    setOpen(false);
                });

            if (sidebar) {
                sidebar.addEventListener("click", function (event) {
                    if (event.target.closest("a") && isMobile())
                        setOpen(false);
                });
            }

            document.addEventListener("keydown", function (event) {
                if (event.key === "Escape" && sidebar && sidebar.classList.contains("is-open"))
                    setOpen(false);
            });

            function handleBreakpoint() {
                setOpen(false);
            }

            if (typeof mq.addEventListener === "function")
                mq.addEventListener("change", handleBreakpoint);
            else if (typeof mq.addListener === "function")
                mq.addListener(handleBreakpoint);

            /* Toast */
            var toastEl = document.querySelector("[data-toast-region]");
            var timer = null;

            document.addEventListener("click", function (event) {
                var trigger = event.target.closest("[data-toast]");

                if (!trigger || !toastEl)
                    return;

                toastEl.textContent = trigger.getAttribute("data-toast");
                toastEl.classList.add("is-visible");

                clearTimeout(timer);

                timer = setTimeout(function () {
                    toastEl.classList.remove("is-visible");
                }, 3400);
            });
        })();
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
