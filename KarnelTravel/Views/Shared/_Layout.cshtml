        @if (ShowKarnelCursor)
        {
            <div class="klc" id="klc" aria-hidden="true">
                <span class="klc__halo" data-klc="halo"></span>
                <span class="klc__ring" data-klc="ring"></span>
                <span class="klc__dot" data-klc="dot"></span>
                <span class="klc__label" data-klc="label">Explore</span>
            </div>
        }

        <script>
                /* ==========================================================
                   SHARED JAVASCRIPT — Karnel Travel Guide
                   Progressive enhancement only: the site works without it.
                   ========================================================== */
                (function () {
                    'use strict';

                    var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

                    /* ---------- 1. Graceful image fallback ---------- */
                    document.addEventListener('error', function (event) {
                        var el = event.target;
                        if (!el || el.tagName !== 'IMG') { return; }
                        var frame = el.closest('.media');
                        if (frame) { frame.classList.add('is-missing'); }
                    }, true);

                    /* ---------- 2. Header state, progress bar, back-to-top ---------- */
                    var header = document.querySelector('[data-header]');
                    var progress = document.querySelector('[data-scroll-progress]');
                    var toTop = document.querySelector('[data-to-top]');

                    function onScroll() {
                        var y = window.pageYOffset || document.documentElement.scrollTop;

                        if (header) { header.classList.toggle('is-scrolled', y > 24); }

                        if (progress) {
                            var max = document.documentElement.scrollHeight - window.innerHeight;
                            progress.style.width = (max > 0 ? (y / max) * 100 : 0) + '%';
                        }
                        if (toTop) { toTop.classList.toggle('is-visible', y > 640); }
                    }
                    window.addEventListener('scroll', onScroll, { passive: true });
                    onScroll();

                    if (toTop) {
                        toTop.addEventListener('click', function () {
                            window.scrollTo({ top: 0, behavior: reduceMotion ? 'auto' : 'smooth' });
                            var skip = document.querySelector('.skip-link');
                            if (skip) { skip.focus({ preventScroll: true }); }
                        });
                    }

                    /* ---------- 3. Full-screen overlay menu ---------- */
                    var menu = document.querySelector('[data-menu]');
                    var menuOpenBtn = document.querySelector('[data-menu-open]');
                    var menuCloseBtn = document.querySelector('[data-menu-close]');
                    var lastFocused = null;

                    function openMenu() {
                        if (!menu) { return; }
                        lastFocused = document.activeElement;
                        menu.classList.add('is-open');
                        menu.setAttribute('aria-hidden', 'false');
                        document.body.classList.add('menu-open');
                        if (menuOpenBtn) { menuOpenBtn.setAttribute('aria-expanded', 'true'); }
                        window.requestAnimationFrame(function () {
                            var first = menu.querySelector('.menu__link, .menu__close');
                            if (first) { first.focus({ preventScroll: true }); }
                        });
                    }

                    function closeMenu(restoreFocus) {
                        if (!menu) { return; }
                        menu.classList.remove('is-open');
                        menu.setAttribute('aria-hidden', 'true');
                        document.body.classList.remove('menu-open');
                        if (menuOpenBtn) { menuOpenBtn.setAttribute('aria-expanded', 'false'); }
                        if (restoreFocus !== false) {
                            var target = (lastFocused && document.body.contains(lastFocused))
                                ? lastFocused
                                : menuOpenBtn;
                            if (target) { target.focus({ preventScroll: true }); }
                        }
                    }

                    if (menuOpenBtn) {
                        menuOpenBtn.addEventListener('click', openMenu);
                    }
                    if (menuCloseBtn) {
                        menuCloseBtn.addEventListener('click', function () { closeMenu(true); });
                    }

                    if (menu) {
                        menu.addEventListener('click', function (event) {
                            var link = event.target.closest('a');
                            if (link) { closeMenu(false); }
                        });
                    }

                    document.addEventListener('keydown', function (event) {
                        if (event.key !== 'Escape') { return; }
                        if (menu && menu.classList.contains('is-open')) {
                            closeMenu(true);
                        }
                    });

                    /* ---------- 4. Hover/focus updates the preview ---------- */
                    var previewFigures = Array.prototype.slice.call(
                        document.querySelectorAll('[data-preview-item]')
                    );
                    var previewRows = Array.prototype.slice.call(
                        document.querySelectorAll('.menu__item[data-preview]')
                    );

                    function activatePreview(key) {
                        previewFigures.forEach(function (figure) {
                            figure.classList.toggle(
                                'is-active',
                                figure.getAttribute('data-preview-item') === key
                            );
                        });
                    }

                    previewRows.forEach(function (row) {
                        var key = row.getAttribute('data-preview');
                        row.addEventListener('mouseenter', function () { activatePreview(key); });
                        row.addEventListener('focusin', function () { activatePreview(key); });
                    });

                    /* ---------- 5. Discover More submenu toggle ---------- */
                    var subToggles = Array.prototype.slice.call(
                        document.querySelectorAll('[data-submenu-toggle]')
                    );

                    subToggles.forEach(function (btn) {
                        btn.addEventListener('click', function () {
                            var item = btn.closest('.menu__item');
                            if (!item) { return; }
                            var open = item.classList.toggle('is-open');
                            btn.setAttribute('aria-expanded', String(open));
                        });
                    });

                    /* ---------- 6. Scroll reveal ---------- */
                    var revealTargets = Array.prototype.slice.call(
                        document.querySelectorAll('[data-reveal]')
                    );

                    document.querySelectorAll('[data-reveal-group]').forEach(function (group) {
                        group.querySelectorAll('[data-reveal]').forEach(function (el, index) {
                            el.style.setProperty('--reveal-delay', (index * 80) + 'ms');
                        });
                    });

                    if (reduceMotion || !('IntersectionObserver' in window)) {
                        revealTargets.forEach(function (el) { el.classList.add('is-visible'); });
                    } else {
                        var observer = new IntersectionObserver(function (entries) {
                            entries.forEach(function (entry) {
                                if (entry.isIntersecting) {
                                    entry.target.classList.add('is-visible');
                                    observer.unobserve(entry.target);
                                }
                            });
                        }, { rootMargin: '0px 0px -12% 0px', threshold: 0.08 });

                        revealTargets.forEach(function (el) { observer.observe(el); });
                    }

                    /* ---------- 7. Motion-safe in-page anchors ---------- */
                    document.addEventListener('click', function (event) {
                        var link = event.target.closest('a[href^="#"]');
                        if (!link) { return; }
                        var id = link.getAttribute('href');
                        if (!id || id === '#') { return; }
                        var target = document.querySelector(id);
                        if (!target) { return; }
                        event.preventDefault();
                        target.scrollIntoView({
                            behavior: reduceMotion ? 'auto' : 'smooth',
                            block: 'start'
                        });
                    });

                    /* ---------- 8. Meadow Footer Video ---------- */
                    var video = document.querySelector('.mf__video');
                    if (video) {
                        if (reduceMotion) { video.pause(); }
                        video.addEventListener('error', function () {
                            var stage = video.closest('.mf__stage');
                            if (stage) { stage.classList.add('is-fallback'); }
                        });
                    }
                })();
        </script>

        @if (ShowKarnelCursor)
        {
            @* ==========================================================
               KARNEL LUMINOUS CURSOR — vanilla JS, no dependencies.
               - only initialises on fine pointers and wide viewports
               - exposes window.__karnelCursor.dispose() for cleanup
               - respects prefers-reduced-motion
               ========================================================== *@
            <script>
                (function () {
                    'use strict';
                    if (window.__karnelCursor) { return; }

                    var root = document.getElementById('klc');
                    if (!root) { return; }

                    // Bail out on touch and reduced-motion devices so the native
                    // pointer remains available as a reliable accessibility aid.
                    var mqFine   = window.matchMedia('(hover: hover) and (pointer: fine)');
                    var mqReduce = window.matchMedia('(prefers-reduced-motion: reduce)');

                    if (!mqFine.matches || mqReduce.matches) { return; }

                    var dot   = root.querySelector('[data-klc="dot"]');
                    var halo  = root.querySelector('[data-klc="halo"]');
                    var ring  = root.querySelector('[data-klc="ring"]');
                    var label = root.querySelector('[data-klc="label"]');

                    // ── State ─────────────────────────────────────────────
                    var target  = { x: window.innerWidth / 2, y: window.innerHeight / 2 };
                    var pointer = { x: target.x, y: target.y };
                    var haloPos = { x: target.x, y: target.y };
                    var visible = false;
                    var pressed = false;
                    var state   = 'default';
                    var rafId   = null;
                    var disposed = false;

                    var reduce = mqReduce.matches;
                    var stateLabels = {
                        image: 'Explore',
                        view: 'View',
                        discover: 'Discover',
                        route: 'View route',
                        drag: 'Drag'
                    };

                    function applyClass() {
                        root.classList.remove('klc--link', 'klc--button', 'klc--image', 'klc--view', 'klc--discover', 'klc--route', 'klc--drag', 'klc--disabled');
                        if (state === 'link')     { root.classList.add('klc--link'); }
                        if (state === 'button')   { root.classList.add('klc--button'); }
                        if (state === 'image')    { root.classList.add('klc--image'); }
                        if (state === 'view')     { root.classList.add('klc--view'); }
                        if (state === 'discover') { root.classList.add('klc--discover'); }
                        if (state === 'route')    { root.classList.add('klc--route'); }
                        if (state === 'drag')     { root.classList.add('klc--drag'); }
                        if (state === 'disabled') { root.classList.add('klc--disabled'); }
                        label.textContent = stateLabels[state] || '';
                    }

                    // Classify an element into a cursor state.
                    function classify(el) {
                        if (!el || !(el instanceof Element)) { return 'default'; }
                        if (el.closest('[disabled], [aria-disabled="true"]')) { return 'disabled'; }

                        var explicit = el.closest('[data-cursor]');
                        if (explicit) {
                            var requested = explicit.getAttribute('data-cursor');
                            if (requested === 'explore' || requested === 'image') { return 'image'; }
                            if (requested === 'view' || requested === 'discover' || requested === 'route' || requested === 'drag') {
                                return requested;
                            }
                        }

                        var textCtx = el.closest('input:not([type="button"]):not([type="submit"]):not([type="checkbox"]):not([type="radio"]):not([type="reset"]):not([type="file"]):not([type="range"]):not([type="color"]), textarea, [contenteditable="true"], [contenteditable=""]');
                        if (textCtx) { return 'text'; }

                        var btn = el.closest('button, a.btn, [role="button"], input[type="button"], input[type="submit"], input[type="reset"]');
                        if (btn) { return 'button'; }

                        var media = el.closest('img, picture, video, canvas, figure.media');
                        if (media) {
                            // Only treat as image hover if it isn't inside an interactive element
                            if (!media.closest('a, button, [role="button"]')) { return 'image'; }
                        }

                        var link = el.closest('a[href], summary, label, [role="link"]');
                        if (link) { return 'link'; }

                        return 'default';
                    }

                    function setState(next) {
                        if (next === state) { return; }
                        state = next;
                        // Native caret takes over in text contexts:
                        if (state === 'text') {
                            root.style.opacity = '0';
                            return;
                        }
                        root.style.opacity = '';
                        applyClass();
                    }

                    // ── rAF loop ─────────────────────────────────────────
                    function tick() {
                        if (disposed) { return; }

                        // Dot follows pointer exactly.
                        pointer.x += (target.x - pointer.x) * 0.9;
                        pointer.y += (target.y - pointer.y) * 0.9;

                        // Halo trails slightly (only if motion is allowed).
                        var lerp = reduce ? 1 : 0.18;
                        haloPos.x += (pointer.x - haloPos.x) * lerp;
                        haloPos.y += (pointer.y - haloPos.y) * lerp;

                        root.style.transform = 'translate3d(' + pointer.x + 'px,' + pointer.y + 'px,0)';
                        dot.style.transform  = 'translate(-50%,-50%)' + (pressed ? ' scale(.7)' : '');
                        halo.style.transform = 'translate(-50%,-50%)';
                        halo.style.left      = (haloPos.x - pointer.x) + 'px';
                        halo.style.top       = (haloPos.y - pointer.y) + 'px';

                        rafId = window.requestAnimationFrame(tick);
                    }

                    // ── Events ───────────────────────────────────────────
                    function onMove(e) {
                        target.x = e.clientX;
                        target.y = e.clientY;
                        if (!visible) {
                            visible = true;
                            root.style.opacity = '';
                        }
                    }

                    function onOver(e) {
                        setState(classify(e.target));
                    }

                    function onOut(e) {
                        setState(classify(e.relatedTarget));
                    }

                    function onDown(e) {
                        if (e.button !== 0) { return; }
                        pressed = true;
                        root.classList.add('klc--press');
                        spawnRipple(e.clientX, e.clientY);
                    }

                    function onUp() {
                        if (!pressed) { return; }
                        pressed = false;
                        root.classList.remove('klc--press');
                    }

                    function onLeaveDoc(e) {
                        if (e.relatedTarget === null) {
                            visible = false;
                            root.style.opacity = '0';
                        }
                    }

                    function onVisibility() {
                        if (document.hidden) {
                            visible = false;
                            root.style.opacity = '0';
                        }
                    }

                    function spawnRipple(x, y) {
                        if (reduce) { return; }
                        var r = document.createElement('span');
                        r.className = 'klc__ripple';
                        r.style.left = x + 'px';
                        r.style.top  = y + 'px';
                        document.body.appendChild(r);
                        r.addEventListener('animationend', function () {
                            if (r.parentNode) { r.parentNode.removeChild(r); }
                        });
                        // Hard timeout safety net
                        setTimeout(function () {
                            if (r.parentNode) { r.parentNode.removeChild(r); }
                        }, 800);
                    }

                    // ── Init ─────────────────────────────────────────────
                    // Only mark the document now that JS is genuinely live.
                    document.documentElement.classList.add('klc-active');
                    root.style.left = '0';
                    root.style.top  = '0';

                    window.addEventListener('mousemove', onMove, { passive: true });
                    document.addEventListener('mouseover', onOver, true);
                    document.addEventListener('mouseout', onOut, true);
                    document.addEventListener('mousedown', onDown, true);
                    document.addEventListener('mouseup', onUp, true);
                    document.addEventListener('mouseleave', onLeaveDoc, true);
                    document.addEventListener('visibilitychange', onVisibility);

                    // Re-classify when the pointer enters a new page (SPA-ish nav)
                    window.addEventListener('pageshow', function () {
                        setState('default');
                    });

                    // Media query change → dispose if the cursor is no longer valid.
                    function onMqChange() {
                        if (!mqFine.matches || mqReduce.matches) {
                            dispose();
                        }
                    }
                    if (mqFine.addEventListener) {
                        mqFine.addEventListener('change', onMqChange);
                    } else {
                        mqFine.addListener(onMqChange);
                    }

                    rafId = window.requestAnimationFrame(tick);

                    // ── Cleanup ──────────────────────────────────────────
                    function dispose() {
                        if (disposed) { return; }
                        disposed = true;

                        if (rafId) { window.cancelAnimationFrame(rafId); }

                        window.removeEventListener('mousemove', onMove, { passive: true });
                        document.removeEventListener('mouseover', onOver, true);
                        document.removeEventListener('mouseout', onOut, true);
                        document.removeEventListener('mousedown', onDown, true);
                        document.removeEventListener('mouseup', onUp, true);
                        document.removeEventListener('mouseleave', onLeaveDoc, true);
                        document.removeEventListener('visibilitychange', onVisibility);

                        if (mqFine.removeEventListener) {
                            mqFine.removeEventListener('change', onMqChange);
                        } else {
                            mqFine.removeListener(onMqChange);
                        }

                        document.documentElement.classList.remove('klc-active');
                        if (root.parentNode) { root.parentNode.removeChild(root); }

                        // Clean up any orphan ripples
                        document.querySelectorAll('.klc__ripple').forEach(function (n) {
                            if (n.parentNode) { n.parentNode.removeChild(n); }
                        });

                        window.__karnelCursor = null;
                    }

                    // Public handle for teardown (e.g. when swapping SPA layouts).
                    window.__karnelCursor = { dispose: dispose };
                })();
            </script>
        }

        @await RenderSectionAsync("Scripts", required: false)
    </body>
