@* ============================================================
   Views/Shared/_Layout.cshtml — Karnel Travel Guide
   Shared shell: design tokens, header, full-screen overlay
   navigation, footer, back-to-top, scroll progress, reveal,
   and Karnel Luminous Cursor.
   NOTE: every CSS at-rule is written as @@rule so Razor does
         not try to parse it as C#.
   ============================================================ *@
@inject KarnelTravel.Services.IWebsiteContentService WebsiteContentService

@functions {
    private string CurrentController =>
        (ViewContext.RouteData.Values["controller"] as string ?? "Home");

    private static readonly string[] DiscoverMoreControllers =
        { "Information", "Destinations", "Transport", "Hotels", "Restaurants", "Resorts", "Tours" };

    private bool IsDiscoverMore =>
        Array.IndexOf(DiscoverMoreControllers, CurrentController) >= 0;

    private string MenuLinkClass(string controllerName) =>
        string.Equals(controllerName, CurrentController, StringComparison.OrdinalIgnoreCase)
            ? "menu__link is-active"
            : "menu__link";

    private string SubMenuLinkClass(string controllerName) =>
        string.Equals(controllerName, CurrentController, StringComparison.OrdinalIgnoreCase)
            ? "menu__sub-link is-active"
            : "menu__sub-link";

    private string DiscoverToggleClass =>
        IsDiscoverMore ? "menu__link menu__link--toggle is-active" : "menu__link menu__link--toggle";

    private string BodyClass => ViewData["BodyClass"] as string ?? string.Empty;

    private string FooterLink(string controller, string action = "Index", object? routeValues = null, string? fragment = null)
    {
        var destination = Url.Action(action, controller, routeValues) ?? "/";
        if (!string.IsNullOrWhiteSpace(fragment))
            destination += fragment.StartsWith("#", StringComparison.Ordinal) ? fragment : $"#{fragment}";

        if (string.Equals(CurrentController, "Landing", StringComparison.OrdinalIgnoreCase) && User.Identity?.IsAuthenticated != true)
        {
            return Url.Action("Login", "Account", new { returnUrl = destination }) ?? destination;
        }

        return destination;
    }

    // Karnel Luminous Cursor is disabled on the admin area.
    // If your admin lives under /Admin without an "Area", extend the check:
    //   && !Context.Request.Path.StartsWithSegments("/Admin")
    private bool ShowKarnelCursor =>
        !string.Equals(
            ViewContext.RouteData.Values["area"] as string ?? string.Empty,
            "Admin",
            StringComparison.OrdinalIgnoreCase);
}
@{
    var websiteContent = ViewBag.WebsiteContent as KarnelTravel.Models.WebsiteContent
        ?? await WebsiteContentService.GetAsync();
    var pageTitle = ViewData["Title"] as string;
    var pageDescription = ViewData["Description"] as string;
    pageTitle = string.IsNullOrWhiteSpace(pageTitle)
        ? (string.IsNullOrWhiteSpace(websiteContent.DefaultMetaTitle)
            ? "Karnel Travel Guide"
            : websiteContent.DefaultMetaTitle)
        : pageTitle;
    pageDescription = string.IsNullOrWhiteSpace(pageDescription)
        ? (string.IsNullOrWhiteSpace(websiteContent.DefaultMetaDescription)
            ? "Discover destinations, experiences and journeys across Pakistan with Karnel Travel Guide."
            : websiteContent.DefaultMetaDescription)
        : pageDescription;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@pageTitle</title>
    <meta name="description" content="@pageDescription" />
    <meta name="theme-color" content="#20382D" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet"
          href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=DM+Sans:opsz,wght@9..40,300;9..40,400;9..40,500;9..40,700&family=Inter:opsz,wght@14..32,300;400;500;600;700&display=swap" />

    <style>
            /* ==========================================================
                                       1. DESIGN TOKENS
                                       ========================================================== */
            :root {
                --forest: #20382D;
                --forest-deep: #14271F;
                --forest-ink: #0E1A15;
                --moss: #536B50;
                --sage: #A8B59A;
                --sand: #E9DFC9;
                --ivory: #F8F6F0;
                --white: #FFFFFF;
                --charcoal: #242923;
                --muted: #73796F;
                --line: #DCDCCF;
                --serif: "DM Serif Display", "Playfair Display", Georgia, "Times New Roman", serif;
                --sans: "DM Sans", "Manrope", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
                --shadow-sm: 0 1px 2px rgba(20, 39, 31, .06), 0 2px 10px rgba(20, 39, 31, .05);
                --shadow-md: 0 14px 34px rgba(20, 39, 31, .10);
                --shadow-lg: 0 28px 70px rgba(20, 39, 31, .18);
                --radius: 3px;
                --radius-lg: 6px;
                --container: 1240px;
                --header-h: 84px;
                --ease: cubic-bezier(.22, .61, .36, 1);
            }

            /* ==========================================================
                                       2. RESET / BASE
                                       ========================================================== */
            *, *::before, *::after {
                box-sizing: border-box;
            }

            html {
                -webkit-text-size-adjust: 100%;
                scroll-behavior: smooth;
                scroll-padding-top: calc(var(--header-h) + 16px);
            }

            body {
                margin: 0;
                font-family: var(--sans);
                font-size: 16px;
                line-height: 1.65;
                color: var(--charcoal);
                background: var(--ivory);
                -webkit-font-smoothing: antialiased;
                -moz-osx-font-smoothing: grayscale;
                overflow-x: hidden;
            }

                body.menu-open {
                    overflow: hidden;
                }

            img {
                max-width: 100%;
                display: block;
            }

            a {
                color: inherit;
                text-decoration: none;
            }

            button {
                font: inherit;
                color: inherit;
                cursor: pointer;
            }

            h1, h2, h3, h4 {
                font-family: var(--serif);
                font-weight: 400;
                line-height: 1.08;
                letter-spacing: -.01em;
                margin: 0 0 .5em;
                color: var(--forest-deep);
            }

            h1 {
                font-size: clamp(2.6rem, 6vw, 5rem);
            }

            h2 {
                font-size: clamp(2rem, 3.6vw, 3.1rem);
            }

            h3 {
                font-size: clamp(1.25rem, 1.8vw, 1.6rem);
            }

            h4 {
                font-size: 1rem;
            }

            p {
                margin: 0 0 1.1em;
            }

            ::selection {
                background: var(--sage);
                color: var(--forest-deep);
            }

            :focus-visible {
                outline: 2px solid var(--moss);
                outline-offset: 3px;
                border-radius: 2px;
            }

            /* ==========================================================
                                       3. LAYOUT HELPERS
                                       ========================================================== */
            .container {
                width: 100%;
                max-width: var(--container);
                margin-inline: auto;
                padding-inline: 24px;
            }

            .section {
                padding-block: clamp(64px, 9vw, 128px);
            }

            .section--tight {
                padding-block: clamp(48px, 6vw, 84px);
            }

            .section--sand {
                background: var(--sand);
            }

            .section--ivory {
                background: var(--ivory);
            }

            .eyebrow {
                display: inline-flex;
                align-items: center;
                gap: 10px;
                font-size: .72rem;
                font-weight: 500;
                letter-spacing: .22em;
                text-transform: uppercase;
                color: var(--moss);
                margin: 0 0 18px;
            }

                .eyebrow::before {
                    content: "";
                    width: 34px;
                    height: 1px;
                    background: currentColor;
                    opacity: .6;
                }

            .section-head {
                max-width: 720px;
                margin-bottom: clamp(32px, 4vw, 56px);
            }

                .section-head p {
                    color: var(--muted);
                    font-size: 1.02rem;
                    max-width: 60ch;
                }

            .muted {
                color: var(--muted);
            }

            .skip-link {
                position: absolute;
                left: 16px;
                top: -100px;
                z-index: 500;
                background: var(--forest);
                color: var(--ivory);
                padding: 12px 20px;
                border-radius: var(--radius);
                transition: top .25s var(--ease);
            }

                .skip-link:focus {
                    top: 16px;
                }

            /* ==========================================================
                                       4. BUTTONS
                                       ========================================================== */
            .btn {
                --btn-bg: var(--forest);
                --btn-fg: var(--ivory);
                --btn-bd: var(--forest);
                display: inline-flex;
                align-items: center;
                justify-content: center;
                gap: 10px;
                min-height: 48px;
                padding: 0 26px;
                border: 1px solid var(--btn-bd);
                border-radius: 999px;
                background: var(--btn-bg);
                color: var(--btn-fg);
                font-size: .85rem;
                font-weight: 500;
                letter-spacing: .08em;
                text-transform: uppercase;
                text-align: center;
                transition: background .35s var(--ease), color .35s var(--ease), border-color .35s var(--ease), transform .35s var(--ease), box-shadow .35s var(--ease);
            }

                .btn:hover {
                    transform: translateY(-2px);
                    box-shadow: var(--shadow-md);
                }

                .btn:active {
                    transform: translateY(0);
                    box-shadow: none;
                }

            .btn--outline {
                --btn-bg: transparent;
                --btn-fg: var(--forest);
                --btn-bd: var(--forest);
            }

                .btn--outline:hover {
                    --btn-bg: var(--forest);
                    --btn-fg: var(--ivory);
                }

            .btn--light {
                --btn-bg: var(--ivory);
                --btn-fg: var(--forest-deep);
                --btn-bd: var(--ivory);
            }

            .btn--ghost-light {
                --btn-bg: rgba(248, 246, 240, .06);
                --btn-fg: var(--ivory);
                --btn-bd: rgba(248, 246, 240, .55);
            }

                .btn--ghost-light:hover {
                    --btn-bg: var(--ivory);
                    --btn-fg: var(--forest-deep);
                }

            .link-arrow {
                display: inline-flex;
                align-items: center;
                gap: 8px;
                font-size: .82rem;
                font-weight: 500;
                letter-spacing: .12em;
                text-transform: uppercase;
                color: var(--forest);
                border-bottom: 1px solid transparent;
                padding-bottom: 3px;
                transition: gap .3s var(--ease), border-color .3s var(--ease);
            }

                .link-arrow::after {
                    content: "\2192";
                    transition: transform .3s var(--ease);
                }

                .link-arrow:hover {
                    border-color: currentColor;
                }

                    .link-arrow:hover::after {
                        transform: translateX(4px);
                    }

            /* ==========================================================
                                       5. MEDIA FRAMES
                                       ========================================================== */
            .media {
                position: relative;
                overflow: hidden;
                background: linear-gradient(135deg, var(--moss), var(--forest-deep));
                border-radius: var(--radius);
                isolation: isolate;
            }

                .media img {
                    width: 100%;
                    height: 100%;
                    object-fit: cover;
                    transition: opacity .4s var(--ease), transform 1.1s var(--ease);
                }

                .media.is-missing img {
                    opacity: 0;
                }

                .media.is-missing::after {
                    content: attr(data-fallback-label);
                    position: absolute;
                    inset: 0;
                    display: grid;
                    place-items: center;
                    padding: 20px;
                    text-align: center;
                    font-size: .72rem;
                    letter-spacing: .18em;
                    text-transform: uppercase;
                    color: rgba(248, 246, 240, .62);
                }

            .badge {
                display: inline-flex;
                align-items: center;
                gap: 6px;
                padding: 5px 12px;
                border-radius: 999px;
                background: var(--sand);
                color: var(--forest-deep);
                font-size: .66rem;
                font-weight: 500;
                letter-spacing: .16em;
                text-transform: uppercase;
            }

            .badge--sample {
                background: rgba(233, 223, 201, .9);
            }

            .badge--ghost {
                background: rgba(248, 246, 240, .14);
                color: var(--ivory);
                backdrop-filter: blur(6px);
            }

            /* ==========================================================
                                       6. FORM FIELDS
                                       ========================================================== */
            .field {
                display: flex;
                flex-direction: column;
                gap: 6px;
            }

                .field > span {
                    font-size: .66rem;
                    letter-spacing: .18em;
                    text-transform: uppercase;
                    color: var(--muted);
                }

                .field input,
                .field select,
                .field textarea {
                    height: 52px;
                    width: 100%;
                    padding: 0 16px;
                    border: 1px solid var(--line);
                    border-radius: var(--radius);
                    background: var(--white);
                    color: var(--charcoal);
                    font: inherit;
                    font-size: .95rem;
                    transition: border-color .3s var(--ease), box-shadow .3s var(--ease);
                }

                .field textarea {
                    height: auto;
                    min-height: 130px;
                    padding: 14px 16px;
                    resize: vertical;
                }

                    .field input:focus,
                    .field select:focus,
                    .field textarea:focus {
                        outline: none;
                        border-color: var(--moss);
                        box-shadow: 0 0 0 3px rgba(83, 107, 80, .16);
                    }

                    .field input::placeholder,
                    .field textarea::placeholder {
                        color: #A9AFA4;
                    }

            /* ==========================================================
                                       7. SCROLL PROGRESS + HEADER
                                       ========================================================== */
            .scroll-progress {
                position: fixed;
                inset: 0 auto auto 0;
                height: 2px;
                width: 0;
                background: var(--moss);
                z-index: 210;
                transition: width .1s linear;
            }

            .site-header {
                position: fixed;
                inset: 0 0 auto 0;
                z-index: 200;
                background: rgba(248, 246, 240, .96);
                border-bottom: 1px solid transparent;
                transition: background .45s var(--ease), border-color .45s var(--ease), box-shadow .45s var(--ease);
            }

                .site-header.is-scrolled {
                    background: rgba(248, 246, 240, .94);
                    backdrop-filter: saturate(180%) blur(14px);
                    -webkit-backdrop-filter: saturate(180%) blur(14px);
                    border-bottom-color: var(--line);
                    box-shadow: var(--shadow-sm);
                }

            /* Transparent over the hero — only on pages with body.has-hero. */
            .has-hero .site-header:not(.is-scrolled) {
                background: transparent;
                border-bottom-color: rgba(248, 246, 240, .18);
            }

                .has-hero .site-header:not(.is-scrolled) .brand__name,
                .has-hero .site-header:not(.is-scrolled) .brand__mark,
                .has-hero .site-header:not(.is-scrolled) .header-link,
                .has-hero .site-header:not(.is-scrolled) .menu-btn {
                    color: var(--ivory);
                }

                .has-hero .site-header:not(.is-scrolled) .brand__tag {
                    color: rgba(248, 246, 240, .7);
                }

                .has-hero .site-header:not(.is-scrolled) .menu-btn {
                    border-color: rgba(248, 246, 240, .38);
                }

                .has-hero .site-header:not(.is-scrolled) .menu-btn__icon {
                    background: var(--ivory);
                    color: var(--forest-deep);
                }

            .header-inner {
                display: flex;
                align-items: center;
                justify-content: space-between;
                gap: 24px;
                height: var(--header-h);
            }

            .brand {
                display: inline-flex;
                align-items: center;
                gap: 12px;
            }

            .brand__mark {
                display: inline-flex;
                align-items: center;
                justify-content: center;
                color: var(--forest);
                transition: color .4s var(--ease);
            }

                .brand__mark-image {
                    display: block;
                    width: 42px;
                    height: 42px;
                    max-width: 42px;
                    max-height: 42px;
                    object-fit: contain;
                }

                .brand__mark svg {
                    width: 30px;
                    height: 30px;
                    display: block;
                }

            .brand__text {
                display: flex;
                flex-direction: column;
                line-height: 1.05;
            }

            .brand__name {
                font-family: var(--serif);
                font-size: 1.16rem;
                letter-spacing: .01em;
                color: var(--forest-deep);
                transition: color .4s var(--ease);
            }

            .brand__tag {
                font-size: .58rem;
                letter-spacing: .3em;
                text-transform: uppercase;
                color: var(--muted);
                transition: color .4s var(--ease);
            }

            .header-actions {
                display: flex;
                align-items: center;
                gap: 30px;
            }

            .header-link {
                position: relative;
                padding: 6px 0;
                font-size: .78rem;
                font-weight: 500;
                letter-spacing: .14em;
                text-transform: uppercase;
                color: var(--forest-deep);
                transition: color .3s var(--ease);
            }

                .header-link::after {
                    content: "";
                    position: absolute;
                    left: 0;
                    bottom: 0;
                    width: 100%;
                    height: 1px;
                    background: currentColor;
                    transform: scaleX(0);
                    transform-origin: left;
                    transition: transform .4s var(--ease);
                }

                .header-link:hover::after {
                    transform: scaleX(1);
                }

            /* ---------- Karnel AI navigation CTA (premium animated pill) ---------- */
            .karnel-ai-link {
                position: relative;
                display: inline-flex;
                align-items: center;
                gap: 8px;
                height: 42px;
                padding: 0 18px 0 12px;
                border-radius: 999px;
                background: linear-gradient(135deg, #FBF8F0 0%, #ECEFE5 100%);
                color: var(--forest-deep);
                border: 1px solid rgba(143, 168, 136, .55);
                font-size: .72rem;
                font-weight: 600;
                letter-spacing: .14em;
                text-transform: uppercase;
                white-space: nowrap;
                overflow: hidden;
                isolation: isolate;
                box-shadow: 0 2px 8px rgba(20, 39, 31, .06);
                transition: border-color .3s var(--ease), box-shadow .3s var(--ease),
                            transform .3s var(--ease), background .3s var(--ease);
            }

            .karnel-ai-link:hover,
            .karnel-ai-link:focus-visible {
                border-color: var(--sage);
                background: linear-gradient(135deg, #FFFFFF 0%, #F2F4EB 100%);
                box-shadow: 0 4px 16px rgba(20, 39, 31, .12),
                            0 0 0 3px rgba(143, 168, 136, .20);
                transform: translateY(-1px);
            }

            /* Sparkle wrapper — gentle float */
            .karnel-ai-link__icon {
                position: relative;
                z-index: 2;
                display: inline-flex;
                align-items: center;
                justify-content: center;
                width: 18px;
                height: 18px;
                flex: 0 0 auto;
                color: var(--forest-deep);
                animation: kai-nav-float 3.4s ease-in-out infinite;
            }

            /* Sparkle glyph — slow rotation */
            .karnel-ai-link__icon svg {
                position: relative;
                z-index: 1;
                width: 100%;
                height: 100%;
                display: block;
                animation: kai-nav-spin 14s linear infinite;
                transform-origin: 50% 50%;
            }

            /* Sage halo — soft pulse */
            .karnel-ai-link__icon::after {
                content: "";
                position: absolute;
                inset: -7px;
                z-index: 0;
                border-radius: 50%;
                background: radial-gradient(circle,
                    rgba(143, 168, 136, .55) 0%,
                    rgba(143, 168, 136, 0) 70%);
                animation: kai-nav-pulse 3.4s ease-in-out infinite;
                pointer-events: none;
            }

            /* Faster, brighter on hover / focus */
            .karnel-ai-link:hover .karnel-ai-link__icon,
            .karnel-ai-link:focus-visible .karnel-ai-link__icon {
                animation-duration: 1.8s;
            }

            .karnel-ai-link:hover .karnel-ai-link__icon::after,
            .karnel-ai-link:focus-visible .karnel-ai-link__icon::after {
                background: radial-gradient(circle,
                    rgba(143, 168, 136, .85) 0%,
                    rgba(143, 168, 136, 0) 70%);
            }

            /* Label kept above the sweep layer */
            .karnel-ai-link__label {
                position: relative;
                z-index: 2;
            }

            /* Periodic light sweep */
            .karnel-ai-link::before {
                content: "";
                position: absolute;
                inset: 0;
                z-index: 1;
                background: linear-gradient(105deg,
                    transparent 35%,
                    rgba(255, 255, 255, .85) 50%,
                    transparent 65%);
                transform: translateX(-160%);
                animation: kai-nav-sweep 8s ease-in-out infinite;
                animation-delay: 2.5s;
                pointer-events: none;
            }

            @@keyframes kai-nav-float {
                0%, 100% { transform: translateY(0); }
                50%      { transform: translateY(-1.5px); }
            }

            @@keyframes kai-nav-spin {
                from { transform: rotate(0deg); }
                to   { transform: rotate(360deg); }
            }

            @@keyframes kai-nav-pulse {
                0%, 100% { opacity: .55; transform: scale(.85); }
                50%      { opacity: 1;   transform: scale(1.18); }
            }

            @@keyframes kai-nav-sweep {
                0%, 78%   { transform: translateX(-160%); }
                90%, 100% { transform: translateX(160%); }
            }

            @@media (max-width: 620px) {
                .karnel-ai-link {
                    height: 38px;
                    padding: 0 14px 0 10px;
                    gap: 6px;
                    font-size: .66rem;
                    letter-spacing: .11em;
                }
                .karnel-ai-link__icon { width: 16px; height: 16px; }
            }

            @@media (max-width: 460px) {
                .karnel-ai-link {
                    padding: 0 12px 0 8px;
                    gap: 5px;
                    font-size: .62rem;
                    letter-spacing: .09em;
                }
                .karnel-ai-link__icon { width: 14px; height: 14px; }
            }

            /* Pill menu button */
            .menu-btn {
                display: inline-flex;
                align-items: center;
                gap: 14px;
                height: 46px;
                padding: 0 7px 0 22px;
                border: 1px solid var(--line);
                border-radius: 999px;
                background: transparent;
                color: var(--forest-deep);
                font-size: .72rem;
                font-weight: 500;
                letter-spacing: .18em;
                text-transform: uppercase;
                transition: background .35s var(--ease), border-color .35s var(--ease), color .35s var(--ease), transform .35s var(--ease);
            }

                .menu-btn:hover {
                    background: var(--forest);
                    color: var(--ivory);
                    border-color: var(--forest);
                    transform: translateY(-1px);
                }

            .menu-btn__icon {
                position: relative;
                display: grid;
                place-items: center;
                width: 32px;
                height: 32px;
                border-radius: 50%;
                background: var(--forest);
                color: var(--ivory);
                transition: background .35s var(--ease), color .35s var(--ease), transform .35s var(--ease);
            }

            .menu-btn:hover .menu-btn__icon {
                background: var(--ivory);
                color: var(--forest);
            }

            .menu-btn__icon span {
                position: absolute;
                width: 12px;
                height: 1.4px;
                background: currentColor;
                border-radius: 2px;
                transition: transform .35s var(--ease);
            }

                .menu-btn__icon span:nth-child(1) {
                    transform: translateY(-3px);
                }

                .menu-btn__icon span:nth-child(2) {
                    transform: translateY(3px);
                }

            .menu-btn:hover .menu-btn__icon span:nth-child(1) {
                transform: translateY(-3px) scaleX(1.35);
            }

            .menu-btn:hover .menu-btn__icon span:nth-child(2) {
                transform: translateY(3px) scaleX(1.35);
            }

            /* ==========================================================
                                       8. FULL-SCREEN MENU OVERLAY
                                       ========================================================== */
            .menu {
                position: fixed;
                inset: 0;
                z-index: 400;
                display: grid;
                background: var(--forest-ink);
                visibility: hidden;
                opacity: 0;
                transition: opacity .5s var(--ease), visibility .5s var(--ease);
                overflow: hidden;
                isolation: isolate;
            }

                .menu.is-open {
                    visibility: visible;
                    opacity: 1;
                }

            .menu__shell {
                display: grid;
                grid-template-columns: minmax(0, 38%) minmax(0, 62%);
                height: 100%;
                min-height: 0;
            }

            /* --- Left preview -------------------------------------- */
            .menu__preview {
                position: relative;
                background: radial-gradient(120% 80% at 30% 20%, rgba(83, 107, 80, .35), transparent 60%), linear-gradient(160deg, #14271F, #0E1A15);
                overflow: hidden;
                opacity: 0;
                transition: opacity .7s ease .05s;
            }

            .menu.is-open .menu__preview {
                opacity: 1;
            }

            .menu__preview-item {
                position: absolute;
                inset: 0;
                margin: 0;
                opacity: 0;
                transform: scale(1.06);
                transition: opacity .8s ease, transform 1.4s var(--ease);
                pointer-events: none;
            }

                .menu__preview-item.is-active {
                    opacity: 1;
                    transform: scale(1);
                }

                .menu__preview-item img {
                    width: 100%;
                    height: 100%;
                    object-fit: cover;
                    opacity: .82;
                }

                .menu__preview-item::after {
                    content: "";
                    position: absolute;
                    inset: 0;
                    background: linear-gradient(to bottom, rgba(14, 26, 21, .15), rgba(14, 26, 21, .85) 88%), linear-gradient(to right, rgba(14, 26, 21, .55), transparent 45%);
                }

            .menu__preview-caption {
                position: absolute;
                left: clamp(24px, 4vw, 52px);
                right: clamp(24px, 4vw, 52px);
                bottom: clamp(28px, 5vw, 56px);
                z-index: 2;
                color: var(--ivory);
                display: flex;
                flex-direction: column;
                gap: 10px;
            }

            .menu__preview-kicker {
                font-size: .64rem;
                font-weight: 500;
                letter-spacing: .28em;
                text-transform: uppercase;
                color: var(--sage);
            }

            .menu__preview-title {
                font-family: var(--serif);
                font-size: clamp(1.5rem, 2.2vw, 2.1rem);
                line-height: 1.1;
                color: var(--ivory);
            }

            .menu__preview-text {
                font-size: .85rem;
                color: rgba(248, 246, 240, .7);
                max-width: 32ch;
            }

            .menu__preview-brand {
                position: absolute;
                top: clamp(24px, 4vw, 40px);
                left: clamp(24px, 4vw, 52px);
                z-index: 2;
                display: inline-flex;
                align-items: center;
                gap: 10px;
                color: var(--ivory);
                font-family: var(--serif);
                font-size: 1.05rem;
                letter-spacing: .01em;
            }

            .menu__preview-brand-mark {
                display: grid;
                place-items: center;
                width: 30px;
                height: 30px;
                border-radius: 8px;
                border: 1px solid rgba(248, 246, 240, .28);
            }

                .menu__preview-brand-mark svg {
                    width: 16px;
                    height: 16px;
                    display: block;
                }

            /* --- Right panel --------------------------------------- */
            .menu__panel {
                position: relative;
                display: flex;
                flex-direction: column;
                padding: 96px clamp(28px, 6vw, 96px) 48px;
                background: radial-gradient(140% 90% at 100% 0%, rgba(83, 107, 80, .22), transparent 55%), radial-gradient(80% 60% at 0% 100%, rgba(168, 181, 154, .06), transparent 60%), var(--forest-ink);
                color: var(--ivory);
                overflow-y: auto;
                transform: translateX(60px);
                opacity: 0;
                transition: transform .8s var(--ease), opacity .5s ease;
            }

            .menu.is-open .menu__panel {
                transform: none;
                opacity: 1;
            }

            .menu__close {
                position: absolute;
                top: 26px;
                right: clamp(22px, 4vw, 46px);
                z-index: 5;
                width: 48px;
                height: 48px;
                border-radius: 50%;
                border: 1px solid rgba(248, 246, 240, .22);
                background: transparent;
                color: var(--ivory);
                transition: background .35s var(--ease), color .35s var(--ease), border-color .35s var(--ease), transform .45s var(--ease);
            }

                .menu__close:hover {
                    background: var(--ivory);
                    color: var(--forest-deep);
                    border-color: var(--ivory);
                    transform: rotate(90deg);
                }

                .menu__close span {
                    position: absolute;
                    top: 50%;
                    left: 50%;
                    width: 16px;
                    height: 1.5px;
                    background: currentColor;
                    border-radius: 2px;
                }

                    .menu__close span:nth-child(1) {
                        transform: translate(-50%, -50%) rotate(45deg);
                    }

                    .menu__close span:nth-child(2) {
                        transform: translate(-50%, -50%) rotate(-45deg);
                    }

            .menu__content {
                width: 100%;
                max-width: 720px;
                margin-block: auto;
            }

            .menu__eyebrow {
                display: inline-flex;
                align-items: center;
                gap: 10px;
                font-size: .66rem;
                font-weight: 500;
                letter-spacing: .3em;
                text-transform: uppercase;
                color: var(--sage);
                margin-bottom: 12px;
            }

                .menu__eyebrow::before {
                    content: "";
                    width: 28px;
                    height: 1px;
                    background: currentColor;
                    opacity: .6;
                }

            .menu__list {
                list-style: none;
                margin: 0;
                padding: 0;
                border-bottom: 1px solid rgba(248, 246, 240, .1);
            }

            .menu__item {
                border-top: 1px solid rgba(248, 246, 240, .1);
                opacity: 0;
                transform: translateY(18px);
                transition: opacity .5s ease, transform .6s var(--ease);
            }

            .menu.is-open .menu__item {
                opacity: 1;
                transform: none;
            }

                .menu.is-open .menu__item:nth-child(1) {
                    transition-delay: .18s;
                }

                .menu.is-open .menu__item:nth-child(2) {
                    transition-delay: .26s;
                }

                .menu.is-open .menu__item:nth-child(3) {
                    transition-delay: .34s;
                }

                .menu.is-open .menu__item:nth-child(4) {
                    transition-delay: .42s;
                }

                .menu.is-open .menu__item:nth-child(5) {
                    transition-delay: .50s;
                }

                .menu.is-open .menu__item:nth-child(6) {
                    transition-delay: .58s;
                }

            .menu__link {
                display: grid;
                grid-template-columns: 46px minmax(0, 1fr) auto;
                align-items: center;
                gap: 18px;
                width: 100%;
                padding: 22px 0;
                border: 0;
                background: none;
                color: var(--ivory);
                text-align: left;
                font-family: var(--serif);
                font-size: clamp(1.9rem, 4vw, 3.35rem);
                line-height: 1;
                letter-spacing: -.018em;
                transition: color .4s var(--ease);
            }

                .menu__link:hover,
                .menu__link:focus-visible {
                    color: var(--sand);
                }

                .menu__link.is-active {
                    color: var(--sand);
                }

            .menu__index {
                font-family: var(--sans);
                font-size: .68rem;
                font-weight: 500;
                letter-spacing: .24em;
                color: rgba(248, 246, 240, .38);
                transition: color .4s var(--ease);
                padding-top: .2em;
            }

            .menu__link:hover .menu__index,
            .menu__link.is-active .menu__index {
                color: var(--sage);
            }

            .menu__text {
                display: block;
                transition: transform .5s var(--ease);
            }

            .menu__link:hover .menu__text {
                transform: translateX(6px);
            }

            .menu__arrow {
                display: grid;
                place-items: center;
                width: 46px;
                height: 46px;
                border-radius: 50%;
                border: 1px solid rgba(248, 246, 240, .18);
                color: rgba(248, 246, 240, .65);
                flex: 0 0 auto;
                transition: background .4s var(--ease), border-color .4s var(--ease), color .4s var(--ease), transform .4s var(--ease);
            }

                .menu__arrow svg {
                    width: 13px;
                    height: 13px;
                    transition: transform .4s var(--ease);
                }

            .menu__link:hover .menu__arrow,
            .menu__link:focus-visible .menu__arrow {
                background: var(--sand);
                border-color: var(--sand);
                color: var(--forest-deep);
                transform: translateX(4px);
            }

            .menu__link.is-active .menu__arrow {
                border-color: rgba(168, 181, 154, .55);
                color: var(--sage);
            }

            /* Discover More toggle */
            .menu__item.is-open .menu__link--toggle .menu__arrow {
                background: var(--sand);
                border-color: var(--sand);
                color: var(--forest-deep);
                transform: none;
            }

                .menu__item.is-open .menu__link--toggle .menu__arrow svg {
                    transform: rotate(180deg);
                }

            /* Submenu */
            .menu__submenu {
                list-style: none;
                margin: 0;
                padding: 0 0 0 64px;
                display: grid;
                grid-template-columns: repeat(2, minmax(0, 1fr));
                column-gap: 32px;
                max-height: 0;
                overflow: hidden;
                opacity: 0;
                transition: max-height .55s var(--ease), opacity .4s ease, padding .4s var(--ease);
            }

            .menu__item.is-open .menu__submenu {
                max-height: 560px;
                padding-bottom: 20px;
                opacity: 1;
            }

            .menu__sub-link {
                display: flex;
                flex-direction: column;
                gap: 3px;
                padding: 12px 0;
                color: rgba(248, 246, 240, .74);
                transition: color .3s var(--ease), padding-left .35s var(--ease);
            }

                .menu__sub-link:hover,
                .menu__sub-link:focus-visible {
                    color: var(--sand);
                    padding-left: 8px;
                }

                .menu__sub-link.is-active {
                    color: var(--sand);
                }

            .menu__sub-title {
                font-family: var(--serif);
                font-size: 1.02rem;
                line-height: 1.2;
            }

            .menu__sub-note {
                font-size: .62rem;
                letter-spacing: .18em;
                text-transform: uppercase;
                color: rgba(248, 246, 240, .36);
            }

            .menu__sub-link:hover .menu__sub-note,
            .menu__sub-link.is-active .menu__sub-note {
                color: var(--sage);
            }

            /* Panel footer */
            .menu__foot {
                display: flex;
                flex-wrap: wrap;
                gap: 28px 64px;
                margin-top: clamp(28px, 4vw, 48px);
                padding-top: 24px;
                border-top: 1px solid rgba(248, 246, 240, .12);
            }

            .menu__foot-col {
                display: flex;
                flex-direction: column;
                gap: 8px;
            }

            .menu__foot-label {
                font-size: .62rem;
                font-weight: 500;
                letter-spacing: .24em;
                text-transform: uppercase;
                color: rgba(248, 246, 240, .4);
            }

            .menu__foot-link {
                font-family: var(--serif);
                font-size: 1.05rem;
                color: var(--ivory);
                transition: color .3s var(--ease);
            }

                .menu__foot-link:hover {
                    color: var(--sand);
                }

            .menu__socials {
                list-style: none;
                margin: 0;
                padding: 0;
                display: flex;
                gap: 20px;
            }

                .menu__socials a {
                    font-size: .76rem;
                    letter-spacing: .1em;
                    color: rgba(248, 246, 240, .72);
                    transition: color .3s var(--ease);
                }

                    .menu__socials a:hover {
                        color: var(--sand);
                    }

            /* ==========================================================
                                       9. MEADOW FOOTER  (unchanged)
                                       ========================================================== */
            .mf {
                --mf-paper: #f1f1ee;
                --mf-ink: #0c0c0c;
                --mf-body: #6f6f6c;
                --mf-muted: #9c9c98;
                --mf-mist: #e2e3f1;
                --mf-font: "Inter", system-ui, sans-serif;
                --u: min(100vw / 1440, 100vh / 672);
                --u: min(100vw / 1440, 100svh / 672);
                position: relative;
                height: 100vh;
                height: 100svh;
                background: var(--mf-paper);
                overflow: hidden;
                isolation: isolate;
                font-family: var(--mf-font);
                color: var(--mf-ink);
            }

                .mf *, .mf *::before, .mf *::after {
                    box-sizing: border-box;
                }

                .mf a {
                    color: inherit;
                    text-decoration: none;
                }

                .mf ul {
                    margin: 0;
                    padding: 0;
                    list-style: none;
                }

            .mf__stage {
                position: absolute;
                inset: 0;
                z-index: 0;
            }

                .mf__stage.is-fallback {
                    background: linear-gradient(to bottom, var(--mf-mist), var(--mf-paper));
                }

            .mf__video {
                display: block;
                width: 100%;
                height: 100%;
                object-fit: cover;
                object-position: 50% 100%;
                transform: translateY(9%);
            }

            .mf__stage::after {
                content: "";
                position: absolute;
                inset: 0;
                background: linear-gradient(to bottom, var(--mf-paper) 0%, rgb(241 241 238 / .96) 26%, rgb(241 241 238 / .72) 44%, rgb(241 241 238 / 0) 70%);
            }

            .mf__wordmark {
                position: absolute;
                left: 50%;
                bottom: calc(-2 * var(--u));
                transform: translateX(-50%);
                z-index: 1;
                margin: 0;
                font-family: var(--mf-font);
                font-size: calc(450 * var(--u));
                font-weight: 600;
                line-height: .74;
                letter-spacing: -.045em;
                white-space: nowrap;
                pointer-events: none;
                user-select: none;
                color: rgb(232 234 250 / .4);
                background: linear-gradient(to bottom, rgb(255 255 255 / .78), rgb(214 218 246 / .36) 48%, rgb(255 255 255 / .62));
                -webkit-background-clip: text;
                background-clip: text;
                -webkit-text-fill-color: transparent;
                filter: drop-shadow(0 calc(-1 * var(--u)) 0 rgb(255 255 255 / .55)) drop-shadow(0 0 calc(18 * var(--u)) rgb(190 200 255 / .45));
            }

            .mf__fog {
                position: absolute;
                inset: auto 0 0;
                z-index: 2;
                height: 17%;
                pointer-events: none;
                background: linear-gradient(to top, var(--mf-mist) 0%, rgb(226 227 241 / .6) 30%, rgb(226 227 241 / 0) 100%);
            }

            .mf__content {
                position: relative;
                z-index: 3;
                display: grid;
                grid-template-columns: calc(440 * var(--u)) calc(240 * var(--u)) calc(240 * var(--u)) 1fr;
                align-items: start;
                width: calc(1440 * var(--u));
                margin: 0 auto;
                padding: calc(86 * var(--u)) calc(100 * var(--u)) 0 calc(160 * var(--u));
            }

            .mf-brand__logo {
                display: inline-flex;
                align-items: center;
                gap: calc(10 * var(--u));
                font-size: calc(17 * var(--u));
                font-weight: 500;
                letter-spacing: -.02em;
            }

            .mf-brand__mark {
                display: grid;
                place-items: center;
                width: calc(30 * var(--u));
                height: calc(30 * var(--u));
                border-radius: calc(8 * var(--u));
                background: linear-gradient(to bottom, #2f4a3d, #14271F 55%);
                box-shadow: 0 calc(1 * var(--u)) calc(2 * var(--u)) rgb(0 0 0 / .25);
                color: #fff;
                flex: 0 0 auto;
            }

                .mf-brand__mark svg {
                    width: 60%;
                    height: 60%;
                    display: block;
                }

                .mf-brand__mark-image {
                    display: block;
                    width: 60%;
                    height: 60%;
                    max-width: 100%;
                    max-height: 100%;
                    object-fit: contain;
                }

            .mf-brand__title {
                margin: calc(19 * var(--u)) 0 0;
                font-family: var(--mf-font);
                font-size: calc(20 * var(--u));
                font-weight: 600;
                line-height: 1.2;
                letter-spacing: -.045em;
                color: var(--mf-ink);
            }

            .mf-brand__text {
                max-width: calc(412 * var(--u));
                margin: calc(18 * var(--u)) 0 0;
                color: var(--mf-body);
                font-size: calc(13.7 * var(--u));
                line-height: 1.43;
                letter-spacing: -.012em;
            }

            .mf-brand__cta {
                display: inline-flex;
                align-items: center;
                gap: calc(6 * var(--u));
                height: calc(32.5 * var(--u));
                margin-top: calc(20 * var(--u));
                padding: 0 calc(16 * var(--u)) 0 calc(15 * var(--u));
                border-radius: calc(7 * var(--u));
                background: #000;
                color: #fff;
                font-size: calc(11.8 * var(--u));
                font-weight: 500;
                letter-spacing: -.01em;
                transition: background .2s, transform .2s;
            }

                .mf-brand__cta:hover {
                    background: #262626;
                    transform: translateY(-1px);
                }

            .mf-brand__cta-icon {
                width: calc(13 * var(--u));
                height: calc(13 * var(--u));
                margin-top: calc(-1.5 * var(--u));
                flex: 0 0 auto;
            }

            .mf-brand__copy {
                margin: calc(23 * var(--u)) 0 0;
                color: var(--mf-muted);
                font-size: calc(12.2 * var(--u));
                letter-spacing: .01em;
            }

            .mf-brand__by {
                display: flex;
                align-items: center;
                flex-wrap: wrap;
                gap: calc(5 * var(--u));
                margin: calc(21 * var(--u)) 0 0;
                font-size: calc(11.8 * var(--u));
                font-weight: 500;
                letter-spacing: -.01em;
            }

            .mf-brand__heart {
                font-size: .95em;
            }

            .mf-brand__author {
                display: inline-flex;
                align-items: center;
                gap: calc(6 * var(--u));
                margin-left: calc(5 * var(--u));
            }

            .mf-brand__avatar {
                display: inline-block;
                width: calc(23 * var(--u));
                height: calc(23 * var(--u));
                border-radius: 50%;
                overflow: hidden;
                background: #e3e3e0;
                flex: 0 0 auto;
            }

                .mf-brand__avatar svg {
                    display: block;
                    width: 100%;
                    height: 100%;
                }

            .mf-brand__status {
                display: flex;
                flex-wrap: wrap;
                gap: calc(8 * var(--u));
                margin-top: calc(16 * var(--u));
            }

            .mf-chip {
                display: inline-flex;
                align-items: center;
                gap: calc(6 * var(--u));
                height: calc(25 * var(--u));
                padding: 0 calc(10 * var(--u));
                border: 1px solid rgb(12 12 12 / .12);
                border-radius: 999px;
                background: rgb(255 255 255 / .55);
                font-size: calc(10.8 * var(--u));
                font-weight: 500;
                letter-spacing: -.01em;
                white-space: nowrap;
            }

                .mf-chip svg {
                    width: calc(11 * var(--u));
                    height: calc(11 * var(--u));
                    fill: none;
                    stroke: currentColor;
                    stroke-width: 2;
                    stroke-linecap: round;
                    stroke-linejoin: round;
                }

            .mf-chip__dot {
                display: inline-block;
                width: calc(6 * var(--u));
                height: calc(6 * var(--u));
                border-radius: 50%;
                background: #2fb36a;
                box-shadow: 0 0 0 calc(2.5 * var(--u)) rgb(47 179 106 / .18);
            }

            .mf-col__title {
                margin: 0;
                font-family: var(--mf-font);
                font-size: calc(16 * var(--u));
                font-weight: 600;
                line-height: 1;
                letter-spacing: -.045em;
                color: var(--mf-ink);
            }

            .mf-col__list {
                display: grid;
                gap: calc(20.5 * var(--u));
                margin-top: calc(24 * var(--u));
                font-size: calc(13.7 * var(--u));
                line-height: 1.24;
                letter-spacing: .022em;
                color: #161616;
            }

            .mf__col--menu .mf-col__list {
                gap: calc(15 * var(--u));
                margin-top: calc(21 * var(--u));
                font-weight: 500;
                letter-spacing: -.025em;
                color: var(--mf-ink);
            }

            .mf-col__list a {
                transition: opacity .2s;
            }

                .mf-col__list a:hover {
                    opacity: .55;
                }

            .mf-col__soon {
                color: var(--mf-muted);
                font-style: italic;
            }

            /* ==========================================================
                                       10. BACK TO TOP
                                       ========================================================== */
            .to-top {
                position: fixed;
                right: 22px;
                bottom: 22px;
                z-index: 190;
                display: grid;
                place-items: center;
                width: 46px;
                height: 46px;
                border: 1px solid var(--line);
                border-radius: 50%;
                background: var(--ivory);
                color: var(--forest);
                box-shadow: var(--shadow-md);
                opacity: 0;
                visibility: hidden;
                transform: translateY(12px);
                transition: opacity .35s var(--ease), transform .35s var(--ease), visibility .35s var(--ease), background .3s var(--ease), color .3s var(--ease), border-color .3s var(--ease);
            }

                .to-top.is-visible {
                    opacity: 1;
                    visibility: visible;
                    transform: none;
                }

                .to-top:hover {
                    background: var(--forest);
                    color: var(--ivory);
                    border-color: var(--forest);
                }

                .to-top svg {
                    width: 15px;
                    height: 15px;
                }

            /* ==========================================================
                                       11. SCROLL REVEAL
                                       ========================================================== */
            [data-reveal] {
                opacity: 0;
                transform: translateY(26px);
                transition: opacity .85s var(--ease), transform .85s var(--ease);
                transition-delay: var(--reveal-delay, 0ms);
            }

                [data-reveal].is-visible {
                    opacity: 1;
                    transform: none;
                }

            /* ==========================================================
                                       12. REDUCED MOTION
                                       ========================================================== */
            @@media (prefers-reduced-motion: reduce) {
                html {
                    scroll-behavior: auto;
                }

                *, *::before, *::after {
                    animation-duration: .001ms !important;
                    animation-iteration-count: 1 !important;
                    transition-duration: .001ms !important;
                    scroll-behavior: auto !important;
                }

                [data-reveal] {
                    opacity: 1;
                    transform: none;
                }

                .mf-brand__cta, .mf-col__list a {
                    transition: none;
                }
            }

            /* ==========================================================
                                       13. RESPONSIVE
                                       ========================================================== */
            @@media (max-width: 1100px) {
                .header-actions {
                    gap: 22px;
                }
            }

            @@media (max-width: 960px) {
                .header-link {
                    display: none;
                }

                .menu__shell {
                    grid-template-columns: 1fr;
                }

                .menu__preview {
                    display: none;
                }

                .menu__panel {
                    padding: 92px 24px 32px;
                    transform: translateY(30px);
                }

                .menu.is-open .menu__panel {
                    transform: none;
                }

                .menu__link {
                    grid-template-columns: 34px minmax(0, 1fr) auto;
                    gap: 12px;
                    padding: 18px 0;
                    font-size: clamp(1.65rem, 6.5vw, 2.4rem);
                }

                .menu__index {
