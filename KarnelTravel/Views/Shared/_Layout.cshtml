@* ============================================================
   Views/Shared/_Layout.cshtml — Karnel Travel Guide
   Shared shell: design tokens, header, navigation, dropdown,
   footer, back-to-top, scroll progress, reveal engine.
   NOTE: every CSS at-rule is written as @@rule so Razor does
         not try to parse it as C#.
   ============================================================ *@
@functions {
    private string CurrentController =>
        (ViewContext.RouteData.Values["controller"] as string ?? "Home");

    private static readonly string[] DiscoverMoreControllers =
        { "Information", "Destinations", "Transport", "Hotels", "Restaurants", "Resorts" };

    private bool IsDiscoverMore =>
        Array.IndexOf(DiscoverMoreControllers, CurrentController) >= 0;

    private string NavClass(string controllerName) =>
        string.Equals(controllerName, CurrentController, StringComparison.OrdinalIgnoreCase)
            ? "nav-link is-active"
            : "nav-link";

    private string NavCurrent(string controllerName) =>
        string.Equals(controllerName, CurrentController, StringComparison.OrdinalIgnoreCase)
            ? "page"
            : null;

    private string DropdownClass =>
        IsDiscoverMore ? "nav-link is-active" : "nav-link";

    private string DropdownCurrent => IsDiscoverMore ? "page" : null;

    private string BodyClass => ViewData["BodyClass"] as string ?? string.Empty;
}
@{
    var pageTitle = ViewData["Title"] as string ?? "Karnel Travel Guide";
    var pageDescription = ViewData["Description"] as string
        ?? "Karnel Travel Guide — discover destinations, transport, hotels, restaurants, resorts and travel packages across Pakistan.";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@pageTitle</title>
    <meta name="description" content="@pageDescription" />
    <meta name="theme-color" content="#20382D" />

    @* Editorial serif for headings, clean sans for interface, Inter for the footer. *@
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet"
          href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=DM+Sans:opsz,wght@9..40,300;9..40,400;9..40,500;9..40,700&family=Inter:opsz,wght@14..32,300;400;500;600;700&display=swap" />

    <style>
            /* ==========================================================
                           1. DESIGN TOKENS
                           ========================================================== */
            :root {
                --forest: #20382D;
                --forest-deep: #14271F;
                --moss: #536B50;
                --sage: #A8B59A;
                --sand: #E9DFC9;
                --ivory: #F8F6F0;
                --white: #FFFFFF;
                --charcoal: #242923;
                --muted: #73796F;
                --line: #DCDCCF;
                --serif: "DM Serif Display", "Playfair Display", Georgia, "Times New Roman", serif;
                --sans: "DM Sans", "Manrope", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
                --shadow-sm: 0 1px 2px rgba(20, 39, 31, .06), 0 2px 10px rgba(20, 39, 31, .05);
                --shadow-md: 0 14px 34px rgba(20, 39, 31, .10);
                --shadow-lg: 0 28px 70px rgba(20, 39, 31, .18);
                --radius: 3px;
                --radius-lg: 6px;
                --container: 1240px;
                --header-h: 84px;
                --ease: cubic-bezier(.22, .61, .36, 1);
            }

            /* ==========================================================
                           2. RESET / BASE
                           ========================================================== */
            *, *::before, *::after {
                box-sizing: border-box;
            }

            html {
                -webkit-text-size-adjust: 100%;
                scroll-behavior: smooth;
                scroll-padding-top: calc(var(--header-h) + 16px);
            }

            body {
                margin: 0;
                font-family: var(--sans);
                font-size: 16px;
                line-height: 1.65;
                color: var(--charcoal);
                background: var(--ivory);
                -webkit-font-smoothing: antialiased;
                -moz-osx-font-smoothing: grayscale;
                overflow-x: hidden;
            }

                body.nav-open {
                    overflow: hidden;
                }

            img {
                max-width: 100%;
                display: block;
            }

            a {
                color: inherit;
                text-decoration: none;
            }

            button {
                font: inherit;
                color: inherit;
                cursor: pointer;
            }

            h1, h2, h3, h4 {
                font-family: var(--serif);
                font-weight: 400;
                line-height: 1.08;
                letter-spacing: -.01em;
                margin: 0 0 .5em;
                color: var(--forest-deep);
            }

            h1 {
                font-size: clamp(2.6rem, 6vw, 5rem);
            }

            h2 {
                font-size: clamp(2rem, 3.6vw, 3.1rem);
            }

            h3 {
                font-size: clamp(1.25rem, 1.8vw, 1.6rem);
            }

            h4 {
                font-size: 1rem;
            }

            p {
                margin: 0 0 1.1em;
            }

            ::selection {
                background: var(--sage);
                color: var(--forest-deep);
            }

            :focus-visible {
                outline: 2px solid var(--moss);
                outline-offset: 3px;
                border-radius: 2px;
            }

            /* ==========================================================
                           3. LAYOUT HELPERS
                           ========================================================== */
            .container {
                width: 100%;
                max-width: var(--container);
                margin-inline: auto;
                padding-inline: 24px;
            }

            .section {
                padding-block: clamp(64px, 9vw, 128px);
            }

            .section--tight {
                padding-block: clamp(48px, 6vw, 84px);
            }

            .section--sand {
                background: var(--sand);
            }

            .section--ivory {
                background: var(--ivory);
            }

            .eyebrow {
                display: inline-flex;
                align-items: center;
                gap: 10px;
                font-size: .72rem;
                font-weight: 500;
                letter-spacing: .22em;
                text-transform: uppercase;
                color: var(--moss);
                margin: 0 0 18px;
            }

                .eyebrow::before {
                    content: "";
                    width: 34px;
                    height: 1px;
                    background: currentColor;
                    opacity: .6;
                }

            .section-head {
                max-width: 720px;
                margin-bottom: clamp(32px, 4vw, 56px);
            }

                .section-head p {
                    color: var(--muted);
                    font-size: 1.02rem;
                    max-width: 60ch;
                }

            .muted {
                color: var(--muted);
            }

            .skip-link {
                position: absolute;
                left: 16px;
                top: -100px;
                z-index: 300;
                background: var(--forest);
                color: var(--ivory);
                padding: 12px 20px;
                border-radius: var(--radius);
                transition: top .25s var(--ease);
            }

                .skip-link:focus {
                    top: 16px;
                }

            /* ==========================================================
                           4. BUTTONS
                           ========================================================== */
            .btn {
                --btn-bg: var(--forest);
                --btn-fg: var(--ivory);
                --btn-bd: var(--forest);
                display: inline-flex;
                align-items: center;
                justify-content: center;
                gap: 10px;
                min-height: 48px;
                padding: 0 26px;
                border: 1px solid var(--btn-bd);
                border-radius: 999px;
                background: var(--btn-bg);
                color: var(--btn-fg);
                font-size: .85rem;
                font-weight: 500;
                letter-spacing: .08em;
                text-transform: uppercase;
                text-align: center;
                transition: background .35s var(--ease), color .35s var(--ease), border-color .35s var(--ease), transform .35s var(--ease), box-shadow .35s var(--ease);
            }

                .btn:hover {
                    transform: translateY(-2px);
                    box-shadow: var(--shadow-md);
                }

                .btn:active {
                    transform: translateY(0);
                    box-shadow: none;
                }

            .btn--outline {
                --btn-bg: transparent;
                --btn-fg: var(--forest);
                --btn-bd: var(--forest);
            }

                .btn--outline:hover {
                    --btn-bg: var(--forest);
                    --btn-fg: var(--ivory);
                }

            .btn--light {
                --btn-bg: var(--ivory);
                --btn-fg: var(--forest-deep);
                --btn-bd: var(--ivory);
            }

            .btn--ghost-light {
                --btn-bg: rgba(248, 246, 240, .06);
                --btn-fg: var(--ivory);
                --btn-bd: rgba(248, 246, 240, .55);
            }

                .btn--ghost-light:hover {
                    --btn-bg: var(--ivory);
                    --btn-fg: var(--forest-deep);
                }

            .link-arrow {
                display: inline-flex;
                align-items: center;
                gap: 8px;
                font-size: .82rem;
                font-weight: 500;
                letter-spacing: .12em;
                text-transform: uppercase;
                color: var(--forest);
                border-bottom: 1px solid transparent;
                padding-bottom: 3px;
                transition: gap .3s var(--ease), border-color .3s var(--ease);
            }

                .link-arrow::after {
                    content: "\2192";
                    transition: transform .3s var(--ease);
                }

                .link-arrow:hover {
                    border-color: currentColor;
                }

                    .link-arrow:hover::after {
                        transform: translateX(4px);
                    }

            /* ==========================================================
                           5. MEDIA FRAMES  (with graceful image fallback)
                           ========================================================== */
            .media {
                position: relative;
                overflow: hidden;
                background: linear-gradient(135deg, var(--moss), var(--forest-deep));
                border-radius: var(--radius);
                isolation: isolate;
            }

                .media img {
                    width: 100%;
                    height: 100%;
                    object-fit: cover;
                    transition: opacity .4s var(--ease), transform 1.1s var(--ease);
                }

                .media.is-missing img {
                    opacity: 0;
                }

                .media.is-missing::after {
                    content: attr(data-fallback-label);
                    position: absolute;
                    inset: 0;
                    display: grid;
                    place-items: center;
                    padding: 20px;
                    text-align: center;
                    font-size: .72rem;
                    letter-spacing: .18em;
                    text-transform: uppercase;
                    color: rgba(248, 246, 240, .62);
                }

            .badge {
                display: inline-flex;
                align-items: center;
                gap: 6px;
                padding: 5px 12px;
                border-radius: 999px;
                background: var(--sand);
                color: var(--forest-deep);
                font-size: .66rem;
                font-weight: 500;
                letter-spacing: .16em;
                text-transform: uppercase;
            }

            .badge--sample {
                background: rgba(233, 223, 201, .9);
            }

            .badge--ghost {
                background: rgba(248, 246, 240, .14);
                color: var(--ivory);
                backdrop-filter: blur(6px);
            }

            /* ==========================================================
                           6. FORM FIELDS  (shared by every page's filters)
                           ========================================================== */
            .field {
                display: flex;
                flex-direction: column;
                gap: 6px;
            }

                .field > span {
                    font-size: .66rem;
                    letter-spacing: .18em;
                    text-transform: uppercase;
                    color: var(--muted);
                }

                .field input,
                .field select,
                .field textarea {
                    height: 52px;
                    width: 100%;
                    padding: 0 16px;
                    border: 1px solid var(--line);
                    border-radius: var(--radius);
                    background: var(--white);
                    color: var(--charcoal);
                    font: inherit;
                    font-size: .95rem;
                    transition: border-color .3s var(--ease), box-shadow .3s var(--ease);
                }

                .field textarea {
                    height: auto;
                    min-height: 130px;
                    padding: 14px 16px;
                    resize: vertical;
                }

                    .field input:focus,
                    .field select:focus,
                    .field textarea:focus {
                        outline: none;
                        border-color: var(--moss);
                        box-shadow: 0 0 0 3px rgba(83, 107, 80, .16);
                    }

                    .field input::placeholder,
                    .field textarea::placeholder {
                        color: #A9AFA4;
                    }

            /* ==========================================================
                           7. SCROLL PROGRESS + HEADER
                           ========================================================== */
            .scroll-progress {
                position: fixed;
                inset: 0 auto auto 0;
                height: 2px;
                width: 0;
                background: var(--moss);
                z-index: 210;
                transition: width .1s linear;
            }

            .site-header {
                position: fixed;
                inset: 0 0 auto 0;
                z-index: 200;
                background: rgba(248, 246, 240, .96);
                border-bottom: 1px solid transparent;
                transition: background .45s var(--ease), border-color .45s var(--ease), box-shadow .45s var(--ease);
            }

                .site-header.is-scrolled {
                    background: rgba(248, 246, 240, .94);
                    backdrop-filter: saturate(180%) blur(14px);
                    -webkit-backdrop-filter: saturate(180%) blur(14px);
                    border-bottom-color: var(--line);
                    box-shadow: var(--shadow-sm);
                }

            /* Transparent over the hero — only on pages with body.has-hero. */
            .has-hero .site-header:not(.is-scrolled):not(.is-locked) {
                background: transparent;
                border-bottom-color: rgba(248, 246, 240, .18);
            }

                .has-hero .site-header:not(.is-scrolled):not(.is-locked) .brand__name,
                .has-hero .site-header:not(.is-scrolled):not(.is-locked) .brand__mark,
                .has-hero .site-header:not(.is-scrolled):not(.is-locked) .nav-link,
                .has-hero .site-header:not(.is-scrolled):not(.is-locked) .nav-caret {
                    color: var(--ivory);
                }

                .has-hero .site-header:not(.is-scrolled):not(.is-locked) .brand__tag {
                    color: rgba(248, 246, 240, .7);
                }

                .has-hero .site-header:not(.is-scrolled):not(.is-locked) .nav-link::after {
                    background: var(--ivory);
                }

                .has-hero .site-header:not(.is-scrolled):not(.is-locked) .nav-toggle__bar {
                    background: var(--ivory);
                }

            /* While the mobile drawer is open the header stays solid. */
            .site-header.is-locked,
            body.nav-open .site-header {
                background: var(--forest-deep);
                border-bottom-color: rgba(248, 246, 240, .14);
                box-shadow: none;
                backdrop-filter: none;
                -webkit-backdrop-filter: none;
            }

                .site-header.is-locked .brand__name,
                .site-header.is-locked .brand__mark,
                body.nav-open .site-header .brand__name,
                body.nav-open .site-header .brand__mark {
                    color: var(--ivory);
                }

                .site-header.is-locked .brand__tag,
                body.nav-open .site-header .brand__tag {
                    color: rgba(248, 246, 240, .6);
                }

                .site-header.is-locked .nav-toggle__bar,
                body.nav-open .site-header .nav-toggle__bar {
                    background: var(--ivory);
                }

            .header-inner {
                display: flex;
                align-items: center;
                justify-content: space-between;
                gap: 24px;
                height: var(--header-h);
            }

            .brand {
                display: inline-flex;
                align-items: center;
                gap: 12px;
            }

            .brand__mark {
                color: var(--forest);
                transition: color .4s var(--ease);
            }

                .brand__mark svg {
                    width: 30px;
                    height: 30px;
                    display: block;
                }

            .brand__text {
                display: flex;
                flex-direction: column;
                line-height: 1.05;
            }

            .brand__name {
                font-family: var(--serif);
                font-size: 1.16rem;
                letter-spacing: .01em;
                color: var(--forest-deep);
                transition: color .4s var(--ease);
            }

            .brand__tag {
                font-size: .58rem;
                letter-spacing: .3em;
                text-transform: uppercase;
                color: var(--muted);
                transition: color .4s var(--ease);
            }

            /* ==========================================================
                           8. NAVIGATION
                           ========================================================== */
            .site-nav {
                display: flex;
                align-items: center;
                gap: 34px;
            }

            .nav-list {
                display: flex;
                align-items: center;
                gap: 30px;
                list-style: none;
                margin: 0;
                padding: 0;
            }

            .nav-item {
                position: relative;
            }

            .nav-link {
                position: relative;
                display: inline-block;
                padding: 10px 0;
                font-size: .8rem;
                font-weight: 500;
                letter-spacing: .13em;
                text-transform: uppercase;
                color: var(--forest-deep);
                transition: color .3s var(--ease);
            }

                .nav-link::after {
                    content: "";
                    position: absolute;
                    left: 0;
                    bottom: 2px;
                    height: 1px;
                    width: 100%;
                    background: var(--forest);
                    transform: scaleX(0);
                    transform-origin: left;
                    transition: transform .4s var(--ease);
                }

                .nav-link:hover::after,
                .nav-link.is-active::after {
                    transform: scaleX(1);
                }

                .nav-link.is-active {
                    color: var(--moss);
                }

            /* Discover More */
            .nav-dropdown {
                display: inline-flex;
                align-items: center;
                gap: 2px;
            }

            .nav-caret {
                display: inline-grid;
                place-items: center;
                width: 28px;
                height: 28px;
                padding: 0;
                border: 0;
                background: none;
                color: var(--forest-deep);
                transition: color .3s var(--ease), transform .35s var(--ease);
            }

                .nav-caret svg {
                    width: 11px;
                    height: 11px;
                }

            .nav-item.is-open .nav-caret {
                transform: rotate(180deg);
            }

            .dropdown {
                position: absolute;
                top: calc(100% + 14px);
                left: 50%;
                width: 340px;
                margin: 0;
                padding: 12px;
                list-style: none;
                background: var(--white);
                border: 1px solid var(--line);
                border-radius: var(--radius-lg);
                box-shadow: var(--shadow-lg);
                opacity: 0;
                visibility: hidden;
                transform: translate(-50%, -10px);
                transition: opacity .3s var(--ease), transform .35s var(--ease), visibility .3s var(--ease);
            }

            .nav-item.is-open > .dropdown {
                opacity: 1;
                visibility: visible;
                transform: translate(-50%, 0);
            }

            /* Hover opening on real pointer devices only. */
            @@media (hover: hover) and (min-width: 900px) {
                .nav-item.has-dropdown:hover > .dropdown {
                    opacity: 1;
                    visibility: visible;
                    transform: translate(-50%, 0);
                }
            }

            .dropdown__link {
                display: block;
                padding: 11px 14px;
                border-radius: var(--radius);
                transition: background .25s var(--ease), padding-left .25s var(--ease);
            }

                .dropdown__link:hover,
                .dropdown__link:focus-visible {
                    background: var(--ivory);
                    padding-left: 18px;
                }

            .dropdown__title {
                display: block;
                font-family: var(--serif);
                font-size: 1rem;
                color: var(--forest-deep);
            }

            .dropdown__sub {
                display: block;
                font-size: .68rem;
                letter-spacing: .14em;
                text-transform: uppercase;
                color: var(--muted);
                margin-top: 2px;
            }

            /* Hamburger */
            .nav-toggle {
                display: none;
                width: 46px;
                height: 46px;
                align-items: center;
                justify-content: center;
                flex-direction: column;
                gap: 5px;
                padding: 0;
                border: 0;
                background: none;
                border-radius: 50%;
            }

            .nav-toggle__bar {
                display: block;
                width: 22px;
                height: 1.5px;
                background: var(--forest-deep);
                transition: transform .4s var(--ease), opacity .3s var(--ease), background .4s var(--ease);
            }

            body.nav-open .nav-toggle__bar:nth-child(1) {
                transform: translateY(6.5px) rotate(45deg);
            }

            body.nav-open .nav-toggle__bar:nth-child(2) {
                opacity: 0;
            }

            body.nav-open .nav-toggle__bar:nth-child(3) {
                transform: translateY(-6.5px) rotate(-45deg);
            }

            .nav-backdrop {
                position: fixed;
                inset: 0;
                z-index: 150;
                background: rgba(20, 39, 31, .5);
                opacity: 0;
                visibility: hidden;
                transition: opacity .4s var(--ease), visibility .4s var(--ease);
            }

            body.nav-open .nav-backdrop {
                opacity: 1;
                visibility: visible;
            }

            /* ==========================================================
                           9. MEADOW FOOTER
                           ========================================================== */
            .mf {
                --mf-paper: #f1f1ee;
                --mf-ink: #0c0c0c;
                --mf-body: #6f6f6c;
                --mf-muted: #9c9c98;
                --mf-mist: #e2e3f1;
                --mf-font: "Inter", system-ui, sans-serif;
                --u: min(100vw / 1440, 100vh / 672);
                --u: min(100vw / 1440, 100svh / 672);
                position: relative;
                height: 100vh;
                height: 100svh;
                background: var(--mf-paper);
                overflow: hidden;
                isolation: isolate;
                font-family: var(--mf-font);
                color: var(--mf-ink);
            }

                .mf *, .mf *::before, .mf *::after {
                    box-sizing: border-box;
                }

                .mf a {
                    color: inherit;
                    text-decoration: none;
                }

                .mf ul {
                    margin: 0;
                    padding: 0;
                    list-style: none;
                }

            .mf__stage {
                position: absolute;
                inset: 0;
                z-index: 0;
            }

                .mf__stage.is-fallback {
                    background: linear-gradient(to bottom, var(--mf-mist), var(--mf-paper));
                }

            .mf__video {
                display: block;
                width: 100%;
                height: 100%;
                object-fit: cover;
                object-position: 50% 100%;
                transform: translateY(9%);
            }

            .mf__stage::after {
                content: "";
                position: absolute;
                inset: 0;
                background: linear-gradient(to bottom, var(--mf-paper) 0%, rgb(241 241 238 / .96) 26%, rgb(241 241 238 / .72) 44%, rgb(241 241 238 / 0) 70%);
            }

            .mf__wordmark {
                position: absolute;
                left: 50%;
                bottom: calc(-2 * var(--u));
                transform: translateX(-50%);
                z-index: 1;
                margin: 0;
                font-family: var(--mf-font);
                font-size: calc(450 * var(--u));
                font-weight: 600;
                line-height: .74;
                letter-spacing: -.045em;
                white-space: nowrap;
                pointer-events: none;
                user-select: none;
                color: rgb(232 234 250 / .4);
                background: linear-gradient(to bottom, rgb(255 255 255 / .78), rgb(214 218 246 / .36) 48%, rgb(255 255 255 / .62));
                -webkit-background-clip: text;
                background-clip: text;
                -webkit-text-fill-color: transparent;
                filter: drop-shadow(0 calc(-1 * var(--u)) 0 rgb(255 255 255 / .55)) drop-shadow(0 0 calc(18 * var(--u)) rgb(190 200 255 / .45));
            }

            .mf__fog {
                position: absolute;
                inset: auto 0 0;
                z-index: 2;
                height: 17%;
                pointer-events: none;
                background: linear-gradient(to top, var(--mf-mist) 0%, rgb(226 227 241 / .6) 30%, rgb(226 227 241 / 0) 100%);
            }

            .mf__content {
                position: relative;
                z-index: 3;
                display: grid;
                grid-template-columns: calc(440 * var(--u)) calc(240 * var(--u)) calc(240 * var(--u)) 1fr;
                align-items: start;
                width: calc(1440 * var(--u));
                margin: 0 auto;
                padding: calc(86 * var(--u)) calc(100 * var(--u)) 0 calc(160 * var(--u));
            }

            .mf-brand__logo {
                display: inline-flex;
                align-items: center;
                gap: calc(10 * var(--u));
                font-size: calc(17 * var(--u));
                font-weight: 500;
                letter-spacing: -.02em;
            }

            .mf-brand__mark {
                display: grid;
                place-items: center;
                width: calc(30 * var(--u));
                height: calc(30 * var(--u));
                border-radius: calc(8 * var(--u));
                background: linear-gradient(to bottom, #2f4a3d, #14271F 55%);
                box-shadow: 0 calc(1 * var(--u)) calc(2 * var(--u)) rgb(0 0 0 / .25);
                color: #fff;
                flex: 0 0 auto;
            }

                .mf-brand__mark svg {
                    width: 60%;
                    height: 60%;
                    display: block;
                }

            .mf-brand__title {
                margin: calc(19 * var(--u)) 0 0;
                font-family: var(--mf-font);
                font-size: calc(20 * var(--u));
                font-weight: 600;
                line-height: 1.2;
                letter-spacing: -.045em;
                color: var(--mf-ink);
            }

            .mf-brand__text {
                max-width: calc(412 * var(--u));
                margin: calc(18 * var(--u)) 0 0;
                color: var(--mf-body);
                font-size: calc(13.7 * var(--u));
                line-height: 1.43;
                letter-spacing: -.012em;
            }

            .mf-brand__cta {
                display: inline-flex;
                align-items: center;
                gap: calc(6 * var(--u));
                height: calc(32.5 * var(--u));
                margin-top: calc(20 * var(--u));
                padding: 0 calc(16 * var(--u)) 0 calc(15 * var(--u));
                border-radius: calc(7 * var(--u));
                background: #000;
                color: #fff;
                font-size: calc(11.8 * var(--u));
                font-weight: 500;
                letter-spacing: -.01em;
                transition: background .2s, transform .2s;
            }

                .mf-brand__cta:hover {
                    background: #262626;
                    transform: translateY(-1px);
                }

            .mf-brand__cta-icon {
                width: calc(13 * var(--u));
                height: calc(13 * var(--u));
                margin-top: calc(-1.5 * var(--u));
                flex: 0 0 auto;
            }

            .mf-brand__copy {
                margin: calc(23 * var(--u)) 0 0;
                color: var(--mf-muted);
                font-size: calc(12.2 * var(--u));
                letter-spacing: .01em;
            }

            .mf-brand__by {
                display: flex;
                align-items: center;
                flex-wrap: wrap;
                gap: calc(5 * var(--u));
                margin: calc(21 * var(--u)) 0 0;
                font-size: calc(11.8 * var(--u));
                font-weight: 500;
                letter-spacing: -.01em;
            }

            .mf-brand__heart {
                font-size: .95em;
            }

            .mf-brand__author {
                display: inline-flex;
                align-items: center;
                gap: calc(6 * var(--u));
                margin-left: calc(5 * var(--u));
            }

            .mf-brand__avatar {
                display: inline-block;
                width: calc(23 * var(--u));
                height: calc(23 * var(--u));
                border-radius: 50%;
                overflow: hidden;
                background: #e3e3e0;
                flex: 0 0 auto;
            }

                .mf-brand__avatar svg {
                    display: block;
                    width: 100%;
                    height: 100%;
                }

            .mf-brand__status {
                display: flex;
                flex-wrap: wrap;
                gap: calc(8 * var(--u));
                margin-top: calc(16 * var(--u));
            }

            .mf-chip {
                display: inline-flex;
                align-items: center;
                gap: calc(6 * var(--u));
                height: calc(25 * var(--u));
                padding: 0 calc(10 * var(--u));
                border: 1px solid rgb(12 12 12 / .12);
                border-radius: 999px;
                background: rgb(255 255 255 / .55);
                font-size: calc(10.8 * var(--u));
                font-weight: 500;
                letter-spacing: -.01em;
                white-space: nowrap;
            }

                .mf-chip svg {
                    width: calc(11 * var(--u));
                    height: calc(11 * var(--u));
                    fill: none;
                    stroke: currentColor;
                    stroke-width: 2;
                    stroke-linecap: round;
                    stroke-linejoin: round;
                }

            .mf-chip__dot {
                display: inline-block;
                width: calc(6 * var(--u));
                height: calc(6 * var(--u));
                border-radius: 50%;
                background: #2fb36a;
                box-shadow: 0 0 0 calc(2.5 * var(--u)) rgb(47 179 106 / .18);
            }

            .mf-col__title {
                margin: 0;
                font-family: var(--mf-font);
                font-size: calc(16 * var(--u));
                font-weight: 600;
                line-height: 1;
                letter-spacing: -.045em;
                color: var(--mf-ink);
            }

            .mf-col__list {
                display: grid;
                gap: calc(20.5 * var(--u));
                margin-top: calc(24 * var(--u));
                font-size: calc(13.7 * var(--u));
                line-height: 1.24;
                letter-spacing: .022em;
                color: #161616;
            }

            .mf__col--menu .mf-col__list {
                gap: calc(15 * var(--u));
                margin-top: calc(21 * var(--u));
                font-weight: 500;
                letter-spacing: -.025em;
                color: var(--mf-ink);
            }

            .mf-col__list a {
                transition: opacity .2s;
            }

                .mf-col__list a:hover {
                    opacity: .55;
                }

            .mf-col__soon {
                color: var(--mf-muted);
                font-style: italic;
            }

            /* ==========================================================
                           10. BACK TO TOP
                           ========================================================== */
            .to-top {
                position: fixed;
                right: 22px;
                bottom: 22px;
                z-index: 190;
                display: grid;
                place-items: center;
                width: 46px;
                height: 46px;
                border: 1px solid var(--line);
                border-radius: 50%;
                background: var(--ivory);
                color: var(--forest);
                box-shadow: var(--shadow-md);
                opacity: 0;
                visibility: hidden;
                transform: translateY(12px);
                transition: opacity .35s var(--ease), transform .35s var(--ease), visibility .35s var(--ease), background .3s var(--ease), color .3s var(--ease), border-color .3s var(--ease);
            }

                .to-top.is-visible {
                    opacity: 1;
                    visibility: visible;
                    transform: none;
                }

                .to-top:hover {
                    background: var(--forest);
                    color: var(--ivory);
                    border-color: var(--forest);
                }

                .to-top svg {
                    width: 15px;
                    height: 15px;
                }

            /* ==========================================================
                           11. SCROLL REVEAL
                           ========================================================== */
            [data-reveal] {
                opacity: 0;
                transform: translateY(26px);
                transition: opacity .85s var(--ease), transform .85s var(--ease);
                transition-delay: var(--reveal-delay, 0ms);
            }

                [data-reveal].is-visible {
                    opacity: 1;
                    transform: none;
                }

            /* ==========================================================
                           12. REDUCED MOTION
                           ========================================================== */
            @@media (prefers-reduced-motion: reduce) {
                html {
                    scroll-behavior: auto;
                }

                *, *::before, *::after {
                    animation-duration: .001ms !important;
                    animation-iteration-count: 1 !important;
                    transition-duration: .001ms !important;
                    scroll-behavior: auto !important;
                }

                [data-reveal] {
                    opacity: 1;
                    transform: none;
                }

                .mf-brand__cta, .mf-col__list a {
                    transition: none;
                }
            }

            /* ==========================================================
                           13. RESPONSIVE
                           ========================================================== */
            @@media (max-width: 1080px) {
                .nav-list {
                    gap: 22px;
                }
            }

            @@media (max-width: 899px) {
                .nav-toggle {
                    display: flex;
                }

                .site-nav {
                    position: fixed;
                    inset: 0 0 0 auto;
                    z-index: 160;
                    width: min(90vw, 400px);
                    display: block;
                    padding: calc(var(--header-h) + 28px) 30px 44px;
                    background: var(--forest-deep);
                    overflow-y: auto;
                    transform: translateX(100%);
                    transition: transform .5s var(--ease);
                }

                    .site-nav.is-open {
                        transform: none;
                    }

                .nav-list {
                    flex-direction: column;
                    align-items: stretch;
                    gap: 0;
                }

                .nav-item {
                    border-bottom: 1px solid rgba(248, 246, 240, .12);
                }

                .nav-link,
                .has-hero .site-header:not(.is-scrolled):not(.is-locked) .nav-link {
                    display: block;
                    padding: 18px 0;
                    font-size: .95rem;
                    letter-spacing: .12em;
                    color: var(--ivory);
                }

                    .nav-link::after {
                        display: none;
                    }

                    .nav-link.is-active {
                        color: var(--sage);
                    }

                .nav-dropdown {
                    justify-content: space-between;
                    width: 100%;
                }

                .nav-caret,
                .has-hero .site-header:not(.is-scrolled):not(.is-locked) .nav-caret {
                    color: var(--ivory);
                }

                .dropdown {
                    position: static;
                    width: 100%;
                    max-height: 0;
                    padding: 0;
                    border: 0;
                    border-radius: 0;
                    background: transparent;
                    box-shadow: none;
                    overflow: hidden;
                    opacity: 1;
                    visibility: visible;
                    transform: none;
                    transition: max-height .45s var(--ease), padding .45s var(--ease);
                }

                .nav-item.is-open > .dropdown {
                    max-height: 480px;
                    padding: 4px 0 16px;
                }

                .dropdown__link {
                    padding: 12px 10px;
                }

                    .dropdown__link:hover,
                    .dropdown__link:focus-visible {
                        background: rgba(248, 246, 240, .07);
                    }

                .dropdown__title {
                    color: var(--ivory);
                    font-size: .98rem;
                }

                .dropdown__sub {
                    color: rgba(248, 246, 240, .5);
                }
            }

            @@media (max-width: 767px) {
                .mf {
                    --u: 1px;
                    display: flex;
                    flex-direction: column;
                    height: auto;
                    min-height: 100svh;
                }

                .mf__stage::after {
                    background: linear-gradient(to bottom, var(--mf-paper) 0%, rgb(241 241 238 / .95) 50%, rgb(241 241 238 / .8) 68%, rgb(241 241 238 / 0) 90%);
                }

                .mf__content {
                    display: grid;
                    grid-template-columns: auto auto auto;
                    justify-content: space-between;
                    column-gap: 12px;
                    row-gap: 36px;
                    width: 100%;
                    padding: 40px 20px 0;
                    margin-bottom: max(34vw, 150px);
                }

                .mf__brand {
                    grid-column: 1 / -1;
                }

                .mf-brand__title {
                    font-size: 21px;
                    margin-top: 20px;
                }

                .mf-brand__text {
                    max-width: 34em;
                    font-size: 14px;
                    margin-top: 16px;
                }

                .mf-brand__cta {
                    height: 38px;
                    padding: 0 18px 0 16px;
                    border-radius: 8px;
                    font-size: 13px;
                    margin-top: 20px;
                }

                .mf-brand__cta-icon {
                    width: 14px;
                    height: 14px;
                    margin-top: -1.5px;
                }

                .mf-brand__copy, .mf-brand__by {
                    font-size: 12.5px;
                    margin-top: 16px;
                }

                .mf-brand__avatar {
                    width: 22px;
                    height: 22px;
                }

                .mf-brand__status {
                    gap: 8px;
                    margin-top: 16px;
                }

                .mf-chip {
                    height: 28px;
                    padding: 0 12px;
                    font-size: 12px;
                }

                    .mf-chip svg {
                        width: 12px;
                        height: 12px;
                    }

                .mf-chip__dot {
                    width: 7px;
                    height: 7px;
                    box-shadow: 0 0 0 2.5px rgb(47 179 106 / .18);
                }

                .mf-col__title {
                    font-size: 15px;
                }

                .mf-col__list {
                    gap: 14px;
                    margin-top: 20px;
                    font-size: 13px;
                    letter-spacing: 0;
                    white-space: nowrap;
                }

                .mf__col--menu .mf-col__list {
                    gap: 14px;
                    margin-top: 20px;
                    letter-spacing: 0;
                }

                .mf__wordmark {
                    bottom: 5vw;
                    font-size: 27vw;
                }

                .mf__fog {
                    height: 7%;
                }
            }

            @@media (max-width: 767px) and (min-width: 360px) {
                .mf__content {
                    grid-template-columns: auto auto auto;
                }
            }

            @@media (max-width: 359px) {
                .mf__content {
                    grid-template-columns: 1fr 1fr;
                }
            }

            @@media (max-width: 620px) {
                :root {
                    --header-h: 72px;
                }

                .container {
                    padding-inline: 18px;
                }

                .brand__tag {
                    display: none;
                }

                .to-top {
                    right: 16px;
                    bottom: 16px;
                }
            }
    </style>

