        <script>
                /* ==========================================================
                   SHARED JAVASCRIPT — Karnel Travel Guide
                   Progressive enhancement only: the site works without it.
                   ========================================================== */
                (function () {
                    'use strict';

                    var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

                    /* ---------- 1. Graceful image fallback ---------- */
                    document.addEventListener('error', function (event) {
                        var el = event.target;
                        if (!el || el.tagName !== 'IMG') { return; }
                        var frame = el.closest('.media');
                        if (frame) { frame.classList.add('is-missing'); }
                    }, true);

                    /* ---------- 2. Header state, progress bar, back-to-top ---------- */
                    var header = document.querySelector('[data-header]');
                    var progress = document.querySelector('[data-scroll-progress]');
                    var toTop = document.querySelector('[data-to-top]');

                    function onScroll() {
                        var y = window.pageYOffset || document.documentElement.scrollTop;

                        if (header) { header.classList.toggle('is-scrolled', y > 24); }

                        if (progress) {
                            var max = document.documentElement.scrollHeight - window.innerHeight;
                            progress.style.width = (max > 0 ? (y / max) * 100 : 0) + '%';
                        }
                        if (toTop) { toTop.classList.toggle('is-visible', y > 640); }
                    }
                    window.addEventListener('scroll', onScroll, { passive: true });
                    onScroll();

                    if (toTop) {
                        toTop.addEventListener('click', function () {
                            window.scrollTo({ top: 0, behavior: reduceMotion ? 'auto' : 'smooth' });
                            var skip = document.querySelector('.skip-link');
                            if (skip) { skip.focus({ preventScroll: true }); }
                        });
                    }

                    /* ---------- 3. Full-screen overlay menu ---------- */
                    var menu = document.querySelector('[data-menu]');
                    var menuOpenBtn = document.querySelector('[data-menu-open]');
                    var menuCloseBtn = document.querySelector('[data-menu-close]');
                    var lastFocused = null;

                    function openMenu() {
                        if (!menu) { return; }
                        lastFocused = document.activeElement;
                        menu.classList.add('is-open');
                        menu.setAttribute('aria-hidden', 'false');
                        document.body.classList.add('menu-open');
                        if (menuOpenBtn) { menuOpenBtn.setAttribute('aria-expanded', 'true'); }
                        // Give the browser a frame so the menu is visible before we focus.
                        window.requestAnimationFrame(function () {
                            var first = menu.querySelector('.menu__link, .menu__close');
                            if (first) { first.focus({ preventScroll: true }); }
                        });
                    }

                    function closeMenu(restoreFocus) {
                        if (!menu) { return; }
                        menu.classList.remove('is-open');
                        menu.setAttribute('aria-hidden', 'true');
                        document.body.classList.remove('menu-open');
                        if (menuOpenBtn) { menuOpenBtn.setAttribute('aria-expanded', 'false'); }
                        if (restoreFocus !== false) {
                            var target = (lastFocused && document.body.contains(lastFocused))
                                ? lastFocused
                                : menuOpenBtn;
                            if (target) { target.focus({ preventScroll: true }); }
                        }
                    }

                    if (menuOpenBtn) {
                        menuOpenBtn.addEventListener('click', openMenu);
                    }
                    if (menuCloseBtn) {
                        menuCloseBtn.addEventListener('click', function () { closeMenu(true); });
                    }

                    /* Close when a link inside the overlay is chosen. */
                    if (menu) {
                        menu.addEventListener('click', function (event) {
                            var link = event.target.closest('a');
                            if (link) { closeMenu(false); }
                        });
                    }

                    /* Escape closes the overlay. */
                    document.addEventListener('keydown', function (event) {
                        if (event.key !== 'Escape') { return; }
                        if (menu && menu.classList.contains('is-open')) {
                            closeMenu(true);
                        }
                    });

                    /* ---------- 4. Hovering / focusing a row updates the preview ---------- */
                    var previewFigures = Array.prototype.slice.call(
                        document.querySelectorAll('[data-preview-item]')
                    );
                    var previewRows = Array.prototype.slice.call(
                        document.querySelectorAll('.menu__item[data-preview]')
                    );

                    function activatePreview(key) {
                        previewFigures.forEach(function (figure) {
                            figure.classList.toggle(
                                'is-active',
                                figure.getAttribute('data-preview-item') === key
                            );
                        });
                    }

                    previewRows.forEach(function (row) {
                        var key = row.getAttribute('data-preview');
                        row.addEventListener('mouseenter', function () { activatePreview(key); });
                        row.addEventListener('focusin', function () { activatePreview(key); });
                    });

                    /* ---------- 5. Discover More submenu toggle ---------- */
                    var subToggles = Array.prototype.slice.call(
                        document.querySelectorAll('[data-submenu-toggle]')
                    );

                    subToggles.forEach(function (btn) {
                        btn.addEventListener('click', function () {
                            var item = btn.closest('.menu__item');
                            if (!item) { return; }
                            var open = item.classList.toggle('is-open');
                            btn.setAttribute('aria-expanded', String(open));
                        });
                    });

                    /* ---------- 6. Scroll reveal ---------- */
                    var revealTargets = Array.prototype.slice.call(
                        document.querySelectorAll('[data-reveal]')
                    );

                    document.querySelectorAll('[data-reveal-group]').forEach(function (group) {
                        group.querySelectorAll('[data-reveal]').forEach(function (el, index) {
                            el.style.setProperty('--reveal-delay', (index * 80) + 'ms');
                        });
                    });

                    if (reduceMotion || !('IntersectionObserver' in window)) {
                        revealTargets.forEach(function (el) { el.classList.add('is-visible'); });
                    } else {
                        var observer = new IntersectionObserver(function (entries) {
                            entries.forEach(function (entry) {
                                if (entry.isIntersecting) {
                                    entry.target.classList.add('is-visible');
                                    observer.unobserve(entry.target);
                                }
                            });
                        }, { rootMargin: '0px 0px -12% 0px', threshold: 0.08 });

                        revealTargets.forEach(function (el) { observer.observe(el); });
                    }

                    /* ---------- 7. Motion-safe in-page anchors ---------- */
                    document.addEventListener('click', function (event) {
                        var link = event.target.closest('a[href^="#"]');
                        if (!link) { return; }
                        var id = link.getAttribute('href');
                        if (!id || id === '#') { return; }
                        var target = document.querySelector(id);
                        if (!target) { return; }
                        event.preventDefault();
                        target.scrollIntoView({
                            behavior: reduceMotion ? 'auto' : 'smooth',
                            block: 'start'
                        });
                    });

                    /* ---------- 8. Meadow Footer Video Controls ---------- */
                    var video = document.querySelector('.mf__video');
                    if (video) {
                        if (reduceMotion) { video.pause(); }
                        video.addEventListener('error', function () {
                            var stage = video.closest('.mf__stage');
                            if (stage) { stage.classList.add('is-fallback'); }
                        });
                    }
                })();
        </script>

        @await RenderSectionAsync("Scripts", required: false)
    </body>
