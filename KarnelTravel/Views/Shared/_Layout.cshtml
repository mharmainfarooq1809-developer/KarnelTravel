            /* ==========================================================
               14. KARNEL LUMINOUS CURSOR — scoped styles
                   (rendered only when ShowKarnelCursor is true)
               ========================================================== */
            :root {
                --klc-ivory: #F8F6F0;
                --klc-forest-deep: #14271F;
                --klc-sage: #8FA888;
                --klc-z: 2147483000;
            }

            html.klc-active,
            html.klc-active body {
                cursor: none;
            }

            /* Native caret back in text contexts */
            html.klc-active input:not([type="button"]):not([type="submit"]):not([type="checkbox"]):not([type="radio"]):not([type="reset"]):not([type="file"]):not([type="range"]):not([type="color"]),
            html.klc-active textarea,
            html.klc-active [contenteditable="true"],
            html.klc-active [contenteditable=""] {
                cursor: text;
            }

            html.klc-active select,
            html.klc-active input[type="checkbox"],
            html.klc-active input[type="radio"],
            html.klc-active input[type="file"],
            html.klc-active input[type="range"],
            html.klc-active input[type="color"] {
                cursor: pointer;
            }

            html.klc-active [disabled],
            html.klc-active [aria-disabled="true"] {
                cursor: default;
            }

            .klc {
                position: fixed;
                top: 0;
                left: 0;
                width: 0;
                height: 0;
                z-index: var(--klc-z);
                pointer-events: none;
                contain: layout style;
                will-change: transform;
                transform: translate3d(-100px, -100px, 0);
                opacity: 0;
                transition: opacity 180ms ease;
            }

            html.klc-active .klc { opacity: 1; }

            .klc__halo,
            .klc__dot,
            .klc__ring,
            .klc__label {
                position: absolute;
                top: 0;
                left: 0;
                border-radius: 50%;
                pointer-events: none;
                will-change: transform, opacity, background-color, border-color;
                transform: translate(-50%, -50%);
            }

            .klc__halo {
                width: 44px;
                height: 44px;
                background: radial-gradient(circle at center,
                    rgba(248, 246, 240, .28) 0%,
                    rgba(248, 246, 240, .10) 55%,
                    rgba(248, 246, 240, 0) 72%);
                mix-blend-mode: difference;
                transition: width 220ms ease, height 220ms ease, background 220ms ease, opacity 180ms ease;
            }

            .klc__dot {
                width: 8px;
                height: 8px;
                background: var(--klc-ivory);
                box-shadow: 0 0 12px rgba(248, 246, 240, .7);
                transition: width 180ms ease, height 180ms ease, background 180ms ease, box-shadow 180ms ease, opacity 120ms ease;
            }

            .klc__ring {
                width: 30px;
                height: 30px;
                border: 1px solid rgba(143, 168, 136, .55);
                opacity: 0;
                transition: width 220ms ease, height 220ms ease, opacity 180ms ease, border-color 200ms ease, background 200ms ease;
            }

            .klc__label {
                display: grid;
                place-items: center;
                font-family: "DM Sans", "Inter", system-ui, sans-serif;
                font-size: 9px;
                font-weight: 700;
                letter-spacing: .22em;
                text-transform: uppercase;
                color: var(--klc-forest-deep);
                opacity: 0;
                transform: translate(-50%, -50%) scale(.85);
                transition: opacity 200ms ease, transform 240ms ease;
                white-space: nowrap;
            }

            .klc__ripple {
                position: fixed;
                top: 0; left: 0;
                width: 10px; height: 10px;
                border-radius: 50%;
                border: 1px solid var(--klc-sage);
                pointer-events: none;
                z-index: var(--klc-z);
                transform: translate(-50%, -50%) scale(.4);
                opacity: .8;
                animation: klc-ripple 480ms ease-out forwards;
                will-change: transform, opacity;
            }

            @@keyframes klc-ripple {
                to { transform: translate(-50%, -50%) scale(6); opacity: 0; }
            }

            /* Link hover */
            .klc.klc--link .klc__dot {
                background: var(--klc-sage);
                box-shadow: 0 0 16px rgba(143, 168, 136, .75);
            }
            .klc.klc--link .klc__halo { width: 60px; height: 60px; }
            .klc.klc--link .klc__ring {
                width: 40px; height: 40px;
                opacity: 1;
                border-color: var(--klc-sage);
            }

            /* Button hover */
            .klc.klc--button .klc__dot {
                background: var(--klc-forest-deep);
                box-shadow: 0 0 0 2px var(--klc-ivory), 0 0 18px rgba(143, 168, 136, .6);
            }
            .klc.klc--button .klc__halo {
                width: 68px; height: 68px;
                background: radial-gradient(circle at center,
                    rgba(143, 168, 136, .55) 0%,
                    rgba(143, 168, 136, .20) 60%,
                    rgba(143, 168, 136, 0) 75%);
            }
            .klc.klc--button .klc__ring {
                width: 46px; height: 46px;
                opacity: 1;
                border-color: var(--klc-forest-deep);
            }

            /* Image hover — EXPLORE */
            .klc.klc--image .klc__halo {
                width: 72px; height: 72px;
                background: radial-gradient(circle at center,
                    rgba(20, 39, 31, .55) 0%,
                    rgba(20, 39, 31, .20) 62%,
                    rgba(20, 39, 31, 0) 76%);
                mix-blend-mode: normal;
            }
            .klc.klc--image .klc__dot { width: 0; height: 0; opacity: 0; }
            .klc.klc--image .klc__ring {
                width: 72px; height: 72px;
                opacity: 1;
                border-color: var(--klc-ivory);
                background: rgba(20, 39, 31, .35);
            }
            .klc.klc--image .klc__label {
                width: 72px; height: 72px;
                opacity: 1;
                color: var(--klc-ivory);
                transform: translate(-50%, -50%) scale(1);
            }

            /* Disabled */
            .klc.klc--disabled .klc__dot {
                background: rgba(143, 168, 136, .6);
                box-shadow: none;
            }
            .klc.klc--disabled .klc__halo { opacity: .35; }
            .klc.klc--disabled .klc__ring {
                width: 26px; height: 26px;
                opacity: .5;
                border-color: rgba(143, 168, 136, .4);
            }

            /* Click press */
            .klc.klc--press .klc__dot { transform: translate(-50%, -50%) scale(.7); }
            .klc.klc--press .klc__halo { transform: translate(-50%, -50%) scale(.85); }

            @@media (prefers-reduced-motion: reduce) {
                html.klc-active,
                html.klc-active body { cursor: auto; }
                .klc { display: none !important; }
                .klc, .klc__halo, .klc__dot, .klc__ring, .klc__label {
                    transition: none !important;
                    animation: none !important;
                }
                .klc__ripple { display: none; }
            }

            @@media (hover: none), (pointer: coarse) {
                html.klc-active,
                html.klc-active body { cursor: auto; }
                .klc, .klc__ripple { display: none !important; }
            }
    </style>

    <noscript>
        <style>
                    [data-reveal] {
                        opacity: 1 !important;
                        transform: none !important;
            }</style>
    </noscript>

