<button class="to-top" type="button" data-to-top aria-label="Back to top">
    <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
        <path d="M8 13V3M3.5 7.5 8 3l4.5 4.5" />
    </svg>
</button>

<script>
    (() => {
        const clamp = (v, min = 0, max = 1) => Math.min(max, Math.max(min, v));
        const smoothstep = (e0, e1, v) => {
            const x = clamp((v - e0) / (e1 - e0));
            return x * x * (3 - 2 * x);
        };
        const lerp = (a, b, t) => a + (b - a) * t;
        const segmentInOut = (s, a, b, c, d) => {
            const enter = smoothstep(a, b, s);
            const exit = smoothstep(c, d, s);
            return { enter, exit, active: enter * (1 - exit) };
        };

        const section = document.querySelector(".cinema-scroll");
        if (!section) return;

        const docEl = document.documentElement;
        const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

        // Anchor → scroll position inside the cinema stage
        const navigationTargets = {
            "#discover": 0,
            "#mountains": 900,
            "#culture": 2140,
            "#destinations": 3660
        };

        document.querySelectorAll(".site-nav a, .site-logo").forEach(link => {
            link.addEventListener("click", event => {
                const href = link.getAttribute("href");
                const target = navigationTargets[href];
                if (target === undefined) return;

                event.preventDefault();
                const sectionTop = section.getBoundingClientRect().top + window.scrollY;

                window.scrollTo({
                    top: sectionTop + target,
                    behavior: reduceMotion.matches ? "auto" : "smooth"
                });
            });
        });

        const sightsTrack = document.querySelector(".sights-track");
        const sightsControls = document.querySelector(".sights-controls");
        const sightPrev = document.querySelector(".sight-nav.sight-prev");
        const sightNext = document.querySelector(".sight-nav.sight-next");
        const sightCardsOriginal = Array.from(document.querySelectorAll(".sight-card"));

        let targetMouseX = 0, targetMouseY = 0;
        let mouseX = 0, mouseY = 0;
        let targetScroll = 0, smoothScroll = 0;
        let initialized = false, rafPending = false;
        let sightCards = [];
        const originalSightCount = sightCardsOriginal.length;
        let activeSight = originalSightCount;

        function requestTick() {
            if (rafPending) return;
            rafPending = true;
            requestAnimationFrame(update);
        }

        function getScrollDistance() {
            return clamp(
                -section.getBoundingClientRect().top,
                0,
                section.offsetHeight - window.innerHeight
            );
        }

        function setupSightSlider() {
            if (!sightsTrack) return;
            sightsTrack.replaceChildren();

            for (let setIndex = 0; setIndex < 3; setIndex++) {
                sightCardsOriginal.forEach((card, cardIndex) => {
                    const clone = card.cloneNode(true);
                    clone.dataset.sightIndex = setIndex * originalSightCount + cardIndex;
                    clone.addEventListener("click", () => selectSightCard(clone));
                    clone.addEventListener("keydown", (ev) => {
                        if (ev.key === "Enter" || ev.key === " ") {
                            ev.preventDefault();
                            selectSightCard(clone);
                        }
                    });
                    sightsTrack.appendChild(clone);
                });
            }

            sightCards = Array.from(sightsTrack.children);
            activeSight = originalSightCount;
            updateSightSlider();
            sightsTrack.addEventListener("transitionend", normalizeSightSlider);
        }

        function updateSightSlider() {
            if (!sightCards.length) return;

            const trackStyle = getComputedStyle(sightsTrack);
            const gap = parseFloat(trackStyle.columnGap || "0");
            const cardWidth = sightCards[0].offsetWidth;
            const shift = -(cardWidth + gap) * activeSight;

            docEl.style.setProperty("--sights-shift", `${shift}px`);
            sightCards.forEach((card, index) => {
                card.classList.toggle("is-active", index === activeSight);
            });
        }

        function moveSightSlider(dir) {
            activeSight += dir;
            updateSightSlider();
        }

        function selectSightCard(card) {
            const index = Number(card.dataset.sightIndex);
            if (!Number.isFinite(index)) return;
            activeSight = index;
            updateSightSlider();
        }

        function jumpSightSlider(index) {
            sightsTrack.classList.add("is-jumping");
            activeSight = index;
            updateSightSlider();
            requestAnimationFrame(() => {
                requestAnimationFrame(() => {
                    sightsTrack.classList.remove("is-jumping");
                });
            });
        }

        function normalizeSightSlider() {
            if (activeSight >= originalSightCount * 2) {
                jumpSightSlider(activeSight - originalSightCount);
            } else if (activeSight < originalSightCount) {
                jumpSightSlider(activeSight + originalSightCount);
            }
        }

        if (sightPrev) sightPrev.addEventListener("click", () => moveSightSlider(-1));
        if (sightNext) sightNext.addEventListener("click", () => moveSightSlider(1));

        window.addEventListener("scroll", requestTick, { passive: true });
        window.addEventListener("resize", () => {
            updateSightSlider();
            requestTick();
        });
        window.addEventListener("pointermove", (event) => {
            targetMouseX = event.clientX / window.innerWidth - 0.5;
            targetMouseY = event.clientY / window.innerHeight - 0.5;
            requestTick();
        }, { passive: true });

        function update() {
            rafPending = false;
            targetScroll = getScrollDistance();

            if (!initialized || reduceMotion.matches) {
                smoothScroll = targetScroll;
                initialized = true;
            } else {
                smoothScroll = lerp(smoothScroll, targetScroll, 0.14);
            }

            if (Math.abs(smoothScroll - targetScroll) < 0.08) {
                smoothScroll = targetScroll;
            }

            mouseX = lerp(mouseX, targetMouseX, 0.12);
            mouseY = lerp(mouseY, targetMouseY, 0.12);

            const frame2 = segmentInOut(smoothScroll, 560, 900, 1300, 1620);
            const frame3 = segmentInOut(smoothScroll, 1760, 2140, 2540, 2700);
            const progress = clamp(smoothScroll / 2700);
            const introExit = smoothstep(90, 650, smoothScroll);
            const sightsEnterRaw = smoothstep(2760, 3560, smoothScroll);
            const sightsEnter = Math.pow(sightsEnterRaw, 1.55);
            const sightsControlsEnter = smoothstep(3360, 3660, smoothScroll);

            const blurActive = clamp(frame2.active + frame3.active);
            const frame2Opacity = frame2.active * (1 - frame3.enter);
            const splitDrift = Math.pow(frame2.enter, 1.5);
            const panel2Opacity = frame2.active * (1 - frame2.exit);
            const panel3Opacity = frame3.active * (1 - frame3.exit);

            const backScale = 0.76 + progress * 0.2 + frame2.enter * 0.18 + frame3.enter * 0.16;
            const sharedHeroY = progress * -74;
            const sharedHeroScale = progress * 0.23;

            const sightsScreenTop = Math.min(220, Math.max(112, window.innerHeight * 0.19)) - 50;
            const sightsParentTop = window.innerHeight - (window.innerHeight - sightsScreenTop) / backScale;

            const D = docEl.style;
            const mX = reduceMotion.matches ? 0 : mouseX;
            const mY = reduceMotion.matches ? 0 : mouseY;

            D.setProperty("--mx", mX.toFixed(4));
            D.setProperty("--my", mY.toFixed(4));

            D.setProperty("--back-opacity", String(1 - frame2.active * 0.06));
            D.setProperty("--back-x", `${mX * -12}px`);
            D.setProperty("--back-y", `${mY * -4}px`);
            D.setProperty("--back-scale", String(backScale));
            D.setProperty("--four-y", `${10 + progress * 10}vh`);
            D.setProperty("--four-scale", String(0.78 + progress * 0.16));
            D.setProperty("--bazaar-y", `${20 - progress * 8}vh`);
            D.setProperty("--blur-px", `${blurActive * 14}px`);
            D.setProperty("--back-brightness", String(1 - blurActive * 0.255));
            D.setProperty("--bazaar-blur-px", `${frame2.active * 14}px`);
            D.setProperty("--bazaar-brightness", String(1 - frame2.active * 0.255 - frame3.active * 0.06));
            D.setProperty("--bazaar-saturation", String(1 + frame3.active * 0.18));

            D.setProperty("--shade-opacity", "1");
            D.setProperty("--shade-z", frame2.active > 0.02 ? "2" : "0");
            D.setProperty("--shade-top-alpha", String(blurActive * 0.465));
            D.setProperty("--shade-mid-alpha", String(blurActive * 0.42));
            D.setProperty("--shade-bottom-alpha", String(blurActive * 0.51));

            D.setProperty("--title-y", `${introExit * -210}px`);
            D.setProperty("--title-scale", String(1 - introExit * 0.08));
            D.setProperty("--title-opacity", String(1 - introExit));

            D.setProperty("--bridge-x", `calc(-50% + ${mX * 18}px)`);
            D.setProperty("--bridge-y", `${mY * 8 + sharedHeroY - frame2.exit * 760}px`);
            D.setProperty("--bridge-bottom", `${5 - frame2.enter * 13}vh`);
            D.setProperty("--bridge-width", `${67.2 + frame2.enter * 37.8}vw`);
            D.setProperty("--bridge-scale", String(1.02 + sharedHeroScale + frame2.exit * 0.46));

            D.setProperty("--split-left-x", `calc(-50% + ${-splitDrift * 46}vw + ${mX * 22}px)`);
            D.setProperty("--split-left-y", `${mY * 10 + sharedHeroY - splitDrift * 180}px`);
            D.setProperty("--split-left-scale", String(1 + sharedHeroScale + frame2.enter * 0.74));

            D.setProperty("--split-right-x", `calc(-50% + ${splitDrift * 46}vw + ${mX * 22}px)`);
            D.setProperty("--split-right-y", `${mY * 10 + sharedHeroY - splitDrift * 180}px`);
            D.setProperty("--split-right-scale", String(1 + sharedHeroScale + frame2.enter * 0.74));

            D.setProperty("--frame2-opacity", String(frame2Opacity));
            D.setProperty("--frame2-x", `calc(-50% + ${mX * 10}px)`);
            D.setProperty("--frame2-y", `calc(-50% + ${mY * 8 - frame2.exit * 150}px)`);
            D.setProperty("--frame2-scale", String(1.06 + frame2.enter * 0.08 + frame2.exit * 0.08));

            D.setProperty("--intro-copy-y", `${introExit * 90}px`);
            D.setProperty("--intro-copy-opacity", String(1 - introExit));

            D.setProperty("--panel2-opacity", String(panel2Opacity));
            D.setProperty("--panel2-y", `calc(-50% + ${-frame2.exit * 86 + (1 - frame2.enter) * 58}px)`);

            D.setProperty("--panel3-opacity", String(panel3Opacity));
            D.setProperty("--panel3-y", `calc(-50% + ${-frame3.exit * 86 + (1 - frame3.enter) * 58}px)`);

            D.setProperty("--sights-opacity", String(sightsEnter));
            D.setProperty("--sights-controls-opacity", String(sightsControlsEnter));

            if (sightsControls) {
                sightsControls.classList.toggle("is-ready", sightsControlsEnter > 0.98);
            }

            D.setProperty("--sights-visibility", sightsEnter > 0.01 ? "visible" : "hidden");
            D.setProperty("--sights-y", "0px");
            D.setProperty("--sights-enter-x", `${(1 - sightsEnter) * 420}vw`);
            D.setProperty("--sights-scale", String(1 / backScale));
            D.setProperty("--sights-top", `${sightsParentTop}px`);
            D.setProperty("--sights-screen-top", `${sightsScreenTop}px`);

            if (
                Math.abs(smoothScroll - targetScroll) > 0.08 ||
                Math.abs(mouseX - targetMouseX) > 0.001 ||
                Math.abs(mouseY - targetMouseY) > 0.001
            ) {
                requestTick();
            }
        }

        setupSightSlider();
        requestTick();
    })();
</script>

<script>
    (function () {
        'use strict';

        var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

        /* ---------- Back-to-top ---------- */
        var toTop = document.querySelector('[data-to-top]');
        function updateToTop() {
            if (!toTop) return;
            var y = window.pageYOffset || document.documentElement.scrollTop;
            toTop.classList.toggle('is-visible', y > 640);
        }
        window.addEventListener('scroll', updateToTop, { passive: true });
        updateToTop();

        if (toTop) {
            toTop.addEventListener('click', function () {
                window.scrollTo({ top: 0, behavior: reduceMotion ? 'auto' : 'smooth' });
            });
        }

        /* ---------- Footer video ---------- */
        var video = document.querySelector('.mf__video');
        if (video) {
            // Failure fallback
            video.addEventListener('error', function () {
                var stage = video.closest('.mf__stage');
                if (stage) stage.classList.add('is-fallback');
            });

            // Respect reduced motion — never autoplay
            if (reduceMotion) {
                video.removeAttribute('autoplay');
                try { video.pause(); } catch (e) {}
            } else {
                // Lazy play when footer approaches the viewport
                var startPlayback = function () {
                    video.preload = 'auto';
                    var p = video.play();
                    if (p && typeof p.catch === 'function') {
                        p.catch(function () {
                            // Autoplay blocked — poster remains as fallback
                        });
                    }
                };

                if ('IntersectionObserver' in window) {
                    var obs = new IntersectionObserver(function (entries) {
                        entries.forEach(function (entry) {
                            if (entry.isIntersecting) {
                                startPlayback();
                                obs.disconnect();
                            }
                        });
                    }, { rootMargin: '400px' });
                    obs.observe(video.closest('.mf') || video);
                } else {
                    startPlayback();
                }
            }
        }
    })();
</script>

