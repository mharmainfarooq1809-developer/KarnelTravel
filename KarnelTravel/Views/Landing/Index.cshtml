@{
    Layout = null;
    ViewData["Title"] = "Hunza Valley, Pakistan";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <meta name="description" content="A cinematic journey through Hunza Valley, Pakistan, exploring its dramatic mountains, historic forts, turquoise lakes, and mountain villages." />
    <link rel="icon" href="data:," />
    <style>
        /* ---------- Intro loader styles (inserted) ---------- */
        /* NOTE: Razor treats at-rules as code; use @@media / @@keyframes to output literal at-rules */
        :root {
            --night: #101c1d;
            --night-soft: #172728;
            --forest: #243b36;
            --sage: #8fae9d;
            --snow: #f4f3ec;
            --mist: #c7d6cc;
            --lake: #70d6cb;
            --gold: #c9ad7c;
            --muted: #a4b5ad;
        }

        *, *::before, *::after { box-sizing: border-box; }

        html, body { width: 100%; min-height: 100%; margin: 0; }

        /* Lock scrolling only while intro is present */
        body.intro-open { overflow: hidden; }
        body { background: var(--night); color: var(--snow); font-family: "DM Sans", sans-serif; -webkit-font-smoothing: antialiased; }

        button, a { font: inherit; } a { color: inherit; }

        .intro { position: relative; display: grid; min-height: 100svh; min-height: 100vh; place-items: center; overflow: hidden; isolation: isolate; background: radial-gradient(ellipse at 50% 65%, rgba(65,105,89,.22), transparent 53%), linear-gradient(180deg, #101c1d 0%, #142322 55%, #20352f 100%); }

        .intro::before { content: ""; position: absolute; inset: 0; z-index: -1; opacity: .17; background-image: radial-gradient(#d9e6dc 0.55px, transparent 0.55px); background-size: 5px 5px; mask-image: linear-gradient(to bottom, transparent, black 35%, transparent); pointer-events: none; }

        .intro::after { content: ""; position: absolute; inset: 0; z-index: 5; pointer-events: none; border: 1px solid rgba(235,241,228,.07); box-shadow: inset 0 0 110px rgba(0,0,0,.15); }

        .intro-top { position: absolute; top: clamp(24px,5vh,52px); left: clamp(22px,5vw,68px); right: clamp(22px,5vw,68px); display:flex; align-items:center; justify-content:space-between; gap:20px; z-index:10; animation: fade-in 1s .2s both; }

        .edition { display:flex; align-items:center; gap:11px; color:#c2cec5; font-size:10px; font-weight:600; letter-spacing:.22em; text-transform:uppercase; }
        .edition-mark { width:8px; height:8px; border:1px solid var(--lake); border-radius:50%; box-shadow:0 0 12px rgba(112,214,203,.35); }
        .top-coordinate { color:#82988e; font-size:9px; letter-spacing:.19em; text-align:right; text-transform:uppercase; }

        .scene { position:absolute; inset:0; width:100%; height:100%; pointer-events:none; }
        .star { fill:#f4f3ec; opacity:.45; animation: star-pulse 3s ease-in-out infinite alternate; }
        .mountain-far { fill:#293b37; opacity:.8; } .mountain-mid { fill:#304b40; } .mountain-front { fill:#1b342e; } .mountain-shadow { fill:#132722; opacity:.7; }
        .snow { fill:#dce5db; opacity:.93; } .snow-shadow { fill:#a9c0b6; opacity:.8; }
        .contour { fill:none; stroke:#9ebcac; stroke-width:.85; stroke-opacity:.21; stroke-linecap:round; stroke-dasharray:2 5; vector-effect:non-scaling-stroke; }
        .contour-bright { stroke:#b9d3c8; stroke-opacity:.32; stroke-dasharray:1 4; }
        .lake { fill:url(#lakeGradient); opacity:.86; }
        .lake-ripple { fill:none; stroke:#8be2d9; stroke-width:1; stroke-opacity:.3; stroke-dasharray:3 9; animation: ripple-drift 12s linear infinite; }
        .route-glow { fill:none; stroke:var(--lake); stroke-width:7; stroke-opacity:.12; filter:url(#softGlow); }
        .route { fill:none; stroke:var(--lake); stroke-width:1.6; stroke-linecap:round; stroke-dasharray:5 8; stroke-dashoffset:250; filter:url(#softGlow); animation: route-reveal 3.8s 1.1s ease-out forwards; }
        .marker-ring { fill:none; stroke:var(--lake); stroke-width:1; transform-box:fill-box; transform-origin:center; animation: ring-pulse 2.1s ease-out infinite; }
        .marker-core { fill:#effff7; stroke:var(--lake); stroke-width:2; }

        .intro-content { position:relative; z-index:4; width:min(700px,90vw); padding:30px 0 0; text-align:center; transform:translateY(-2vh); }
        .eyebrow { display:inline-flex; align-items:center; gap:12px; color:#b8c9bf; font-size:9px; font-weight:600; letter-spacing:.38em; text-transform:uppercase; opacity:0; animation: fade-up .9s .35s forwards; }
        .eyebrow::before, .eyebrow::after { content:""; width:27px; height:1px; background:rgba(201,173,124,.7); }
        .brand { margin:22px 0 0; color:var(--snow); font-family:"Playfair Display", Georgia, serif; font-size:clamp(48px,8.4vw,108px); font-weight:400; line-height:.98; letter-spacing:-.055em; text-shadow:0 4px 50px rgba(0,0,0,.16); opacity:0; animation: brand-reveal 1.25s .55s cubic-bezier(.2,.75,.2,1) forwards; }
        .brand span { display:block; margin-top:10px; color:var(--snow); font-size:.76em; letter-spacing:.015em; }
        .brand-description { max-width:370px; margin:25px auto 0; color:#b3c1b8; font-size:clamp(11px,1.3vw,13px); font-weight:400; line-height:1.9; letter-spacing:.035em; opacity:0; animation: fade-up .9s 1s forwards; }

        .intro-bottom { position:absolute; z-index:10; right:clamp(22px,5vw,68px); bottom:clamp(24px,5vh,48px); left:clamp(22px,5vw,68px); display:grid; grid-template-columns:1fr auto 1fr; align-items:end; gap:20px; animation: fade-in 1s 1s both; }
        .bottom-note { color:#a3b4a9; font-size:9px; line-height:1.8; letter-spacing:.16em; text-transform:uppercase; }
        .bottom-note strong { display:block; color:#dce5dc; font-size:10px; font-weight:500; letter-spacing:.2em; }
        .progress-block { width:clamp(125px,18vw,210px); }
        .progress-meta { display:flex; justify-content:space-between; gap:15px; margin-bottom:10px; color:#c1cdc4; font-size:9px; letter-spacing:.14em; }
        .progress-track { width:100%; height:1px; overflow:hidden; background:rgba(225,238,228,.19); }
        .progress-fill { width:100%; height:100%; background:linear-gradient(90deg,var(--lake),#d4e9dc); transform:scaleX(0); transform-origin:left; }
        .skip { justify-self:end; display:inline-flex; align-items:center; gap:12px; padding:12px 0 12px 12px; border:0; background:transparent; color:#d6e0d8; font-size:9px; font-weight:600; letter-spacing:.2em; text-transform:uppercase; text-decoration:none; cursor:pointer; transition:color .25s ease; }
        .skip-arrow { display:grid; width:30px; height:30px; place-items:center; border:1px solid rgba(223,238,225,.3); border-radius:50%; font-size:15px; transition:background .25s ease, transform .25s ease; }
        .skip:hover { color:var(--lake); } .skip:hover .skip-arrow { background:rgba(112,214,203,.12); transform:translateX(3px); }
        .skip:focus-visible { outline:2px solid var(--lake); outline-offset:6px; }

        .intro.is-leaving { animation: scene-exit .85s cubic-bezier(.7,0,.3,1) forwards; pointer-events:none; }
        .intro.is-leaving .intro-content { animation: content-exit .55s ease forwards; }
        .intro.is-leaving .scene { animation: landscape-exit .85s ease forwards; }
        .intro.is-leaving .intro-top, .intro.is-leaving .intro-bottom { opacity:0; transition:opacity .25s ease; }

        @@keyframes fade-in { from { opacity: 0; } to { opacity: 1; } }
        @@keyframes fade-up { from { opacity: 0; transform: translateY(15px); } to { opacity: 1; transform: translateY(0); } }
        @@keyframes brand-reveal { from { opacity: 0; transform: translateY(24px); letter-spacing: .015em; filter: blur(5px); } to { opacity: 1; transform: translateY(0); letter-spacing: -.055em; filter: blur(0); } }
        @@keyframes route-reveal { to { stroke-dashoffset: 0; } }
        @@keyframes ring-pulse { 0% { transform: scale(.7); opacity: .9; } 100% { transform: scale(2.2); opacity: 0; } }
        @@keyframes star-pulse { from { opacity: .18; } to { opacity: .65; } }
        @@keyframes ripple-drift { to { stroke-dashoffset: -120; } }
        @@keyframes scene-exit { to { opacity: 0; visibility: hidden; } }
        @@keyframes content-exit { to { opacity: 0; transform: translateY(-18px); } }
        @@keyframes landscape-exit { to { transform: scale(1.045); opacity: .5; } }

        @@media (min-width: 1500px) { .scene { transform: scale(1.04); } }
        @@media (max-width: 600px) { .intro-top { top:24px; align-items:flex-start; } .edition { max-width:180px; font-size:8px; line-height:1.8; letter-spacing:.15em; } .top-coordinate { max-width:120px; font-size:8px; line-height:1.8; } .intro-content { transform: translateY(-3vh); } .brand { font-size: clamp(47px, 13vw, 72px); } .brand-description { max-width:290px; margin-top:18px; font-size:11px; } .eyebrow { font-size:8px; letter-spacing:.24em; } .intro-bottom { grid-template-columns:1fr auto; align-items:end; row-gap:18px; bottom:23px; } .bottom-note { font-size:8px; } .progress-block { grid-column:1; grid-row:2; width:min(180px,45vw); } .skip { grid-column:2; grid-row:1 / span 2; font-size:8px; } }

        @@media (max-height: 650px) and (min-width: 601px) { .intro-content { transform: translateY(-1vh) scale(.82); } .intro-top { top:18px; } .intro-bottom { bottom:18px; } }

        @@media (prefers-reduced-motion: reduce) { *, *::before, *::after { scroll-behavior: auto !important; animation-duration: .01ms !important; animation-delay: 0ms !important; animation-iteration-count: 1 !important; transition-duration: .01ms !important; } .star, .lake-ripple, .marker-ring { animation: none !important; } }
        :root {
            --mx: 0; --my: 0;
            --back-opacity: 1; --back-x: 0px; --back-y: 0px; --back-scale: 0.76;
            --four-y: 10vh; --four-scale: 0.78;
            --bazaar-y: 20vh;
            --blur-px: 0px; --back-brightness: 1;
            --bazaar-blur-px: 0px; --bazaar-brightness: 1; --bazaar-saturation: 1;
            --shade-opacity: 1; --shade-z: 2;
            --shade-top-alpha: 0; --shade-mid-alpha: 0; --shade-bottom-alpha: 0;
            --blur-tint: 74, 181, 224;
            --title-y: 0px; --title-scale: 1; --title-opacity: 1;
            --bridge-x: -50%; --bridge-y: 0px; --bridge-bottom: 5vh;
            --bridge-width: 67.2vw; --bridge-scale: 1.02;
            --split-left-x: -50%;  --split-left-y: 0px;  --split-left-scale: 1;
            --split-right-x: -50%; --split-right-y: 0px; --split-right-scale: 1;
            --frame2-opacity: 0; --frame2-x: -50%; --frame2-y: -50%; --frame2-scale: 1.06;
            --intro-copy-y: 0px; --intro-copy-opacity: 1;
            --panel2-opacity: 0; --panel2-y: calc(-50% + 58px);
            --panel3-opacity: 0; --panel3-y: calc(-50% + 58px);
            --sights-opacity: 0; --sights-controls-opacity: 0; --sights-y: 0px;
            --sights-enter-x: 420vw; --sights-visibility: hidden;
            --sights-shift: 0px; --sights-scale: 1;
            --sights-top: clamp(112px, 19vh, 220px);
            --sights-screen-top: clamp(112px, 19vh, 220px);
            --ink: #111411; --paper: #fdf1e1; --shadow: rgba(0, 0, 0, 0.32);
            font-family: Inter, Satoshi, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
            color: var(--paper);
            background: #0b1110;
            letter-spacing: 0;
        }

        * { box-sizing: border-box }
        html { min-height:100%; scroll-behavior:smooth; background:#0b1110 }
        body { min-height:100%; margin:0; overflow-x:clip; background:#0b1110 }
        button { border:0; font:inherit }
        .site-shell { min-height:100vh }

        .cinema-scroll { position: relative; height: calc(100vh + 3700px) }
        .stage {
            position: sticky; top: 0; height: 100vh; height: 100dvh; min-height: 620px;
            overflow: hidden; isolation: isolate; background: #7fb4d4;
        }

        .world, .back-stack, .sky-img, .shade, .scene-img, .site-header,
        .sights-slider, .sights-controls, .hero-title, .intro-copy, .story-panel {
            position: absolute;
        }

        .world { inset: 0; overflow: hidden; background: #79b7dd }

        .site-header {
            top:0; left:0; right:0; z-index:10;
            display:grid; grid-template-columns: minmax(260px,1fr) auto minmax(260px,1fr);
            align-items:center; gap:32px; padding:32px;
            color:rgba(253,241,225,0.86); pointer-events:auto;
        }
        .site-logo {
            justify-self:start; font-family: "Ogg Medium", serif; font-size:24px; line-height:1;
            font-weight:500; color:rgba(253,241,225,0.92); text-decoration:none; white-space:nowrap;
        }
        .site-nav { display:flex; justify-content:center; gap: clamp(24px, 2.2vw, 44px) }
        .site-nav a, .language-switcher {
            color: rgba(253,241,225,0.86); font-weight:700; line-height:1;
            text-shadow: 0 2px 16px rgba(0,0,0,0.2);
        }
        .site-nav a { font-size:20px; font-weight:400 }
        .language-switcher {
            justify-self:end; display:inline-flex; align-items:center; justify-content:center;
            gap:5px; padding:0; background:transparent; font-size:16px; cursor:pointer;
        }
        .language-switcher span { display:inline-flex; line-height:1 }

        .scene-img {
            display:block; user-select:none; -webkit-user-drag:none;
            will-change: transform, opacity, filter; pointer-events:none;
        }

        .sky-img {
            inset:0; width:100%; height:100%; object-fit:cover; transform:none; z-index:0;
            filter: blur(var(--blur-px)) brightness(var(--back-brightness));
        }

        .back-stack {
            top:0; bottom:0; left:-3vw; right:-3vw; z-index:1;
            opacity: var(--back-opacity);
            transform: translate3d(var(--back-x), var(--back-y), 0) scale(var(--back-scale));
            transform-origin: 50% 100%;
            will-change: transform, filter, opacity;
        }

        .back-img {
            inset:0; width:100%; height:100%; object-fit:cover;
            filter: blur(var(--blur-px)) brightness(var(--back-brightness));
        }

        .back-bazaar, .back-four {
            top:auto; bottom:0; left:48%; right:auto; width:112%; height:auto; object-fit:contain;
        }
        .back-bazaar {
            z-index:3; opacity:1;
            filter: blur(var(--bazaar-blur-px)) brightness(var(--bazaar-brightness)) saturate(var(--bazaar-saturation));
            transform: translate3d(-50%, var(--bazaar-y), 0) scale(0.86);
        }
        .back-four {
            z-index:1; opacity:0.72; mix-blend-mode:screen;
            transform: translate3d(-50%, calc(var(--four-y) - 110px), 0) scale(var(--four-scale));
        }

        .sights-slider {
            left:0; right:0; top: var(--sights-top); padding:0; z-index:2;
            opacity: var(--sights-opacity);
            visibility: var(--sights-visibility);
            transform: translate3d(var(--sights-enter-x), var(--sights-y), 0) scale(var(--sights-scale));
            transform-origin: 0 0; pointer-events:auto; will-change:transform, opacity;
        }

        .sights-track {
            display:flex; gap: clamp(16px, 1.15vw, 24px); align-items:stretch;
            transform: translate3d(calc(var(--sights-shift) - 18vw), 0, 0);
            transition: transform 640ms cubic-bezier(0.22, 1, 0.36, 1);
            will-change:transform;
        }
        .sights-track.is-jumping { transition: none }

        .sight-card {
            position: relative; flex: 0 0 clamp(360px, 19.4vw, 430px); height:220px;
            padding:24px; overflow:hidden;
            border:1px solid rgba(253,241,225,0.42); border-radius:24px;
            color:#000; background:#fdf1e1;
            box-shadow: 0 18px 52px rgba(2,47,64,0.12);
            backdrop-filter:none; cursor:pointer; pointer-events:auto; user-select:none;
        }
        .sight-card::before, .sight-card::after { content:none }
        .sight-card:focus-visible { outline: 3px solid #0b1110; outline-offset: 4px; }
        .sight-card.is-active { border-color: #111411; }

        .sight-kicker {
            display:block; margin-bottom:56px; color:#000;
            font-size:12px; font-weight:500; line-height:1.05; text-transform:uppercase;
            position:relative; z-index:1; text-shadow:none;
        }
        .sight-pin {
            position:absolute; top:24px; right:24px; width:67.2px; height:67.2px;
            pointer-events:none;
        }
        .sight-card h3 {
            position:absolute; left:24px; right:24px;
            bottom: calc(24px + (16px * 1.16 * 2) + 12px);
            max-width: calc(100% - 76px); margin:0; color:#000;
            font-size:24px; font-weight:800; line-height:0.95;
            overflow:hidden; text-overflow:ellipsis; white-space:nowrap;
            z-index:1; text-shadow:none;
        }
        .sight-card p {
            position:absolute; left:24px; right:24px; bottom:24px; max-width:100%;
            margin:12px 0 0; color:#000; font-size:16px; font-weight:400; line-height:1.16;
            display:-webkit-box; max-height: calc(2em * 1.16); overflow:hidden;
            -webkit-box-orient:vertical; -webkit-line-clamp:2;
            z-index:1; text-shadow:none;
        }

        .sights-controls {
            left:48px; right:auto;
            top: calc(var(--sights-screen-top) + 220px + 16px); z-index:5;
            display:flex; justify-content:flex-start; gap:14px;
            opacity: var(--sights-controls-opacity);
            transform: translate3d(0, var(--sights-y), 0);
            pointer-events:none; will-change:transform, opacity;
        }
        .sights-controls.is-ready { pointer-events:auto }

        .sight-nav {
            width:54px; height:54px; display:inline-flex; align-items:center; justify-content:center;
            border-radius:999px; color:#111411; background:rgba(253,241,225,0.94);
            box-shadow: 0 18px 36px rgba(0,0,0,0.2); cursor:pointer;
            transition: transform .2s ease, background .2s ease;
        }
        .sight-nav:hover { transform: scale(1.05); background: #fff; }

        .hero-title {
            left:50%; top: clamp(122px, 19vh, 205px); width: min(94vw, 1780px);
            margin:0; color:#fdf1e1; z-index:3;
            font-family:"Ogg Medium", serif; font-size:14rem; font-weight:500; line-height:0.78;
            text-align:center; text-shadow:none;
            transform: translate3d(-50%, var(--title-y), 0) scale(var(--title-scale));
            opacity: var(--title-opacity); will-change: transform, opacity;
        }

        .bridge-img {
            left:50%; bottom: var(--bridge-bottom); width: min(var(--bridge-width), 2140px);
            height:auto; z-index:4;
            transform: translate3d(var(--bridge-x), var(--bridge-y), 0) scale(var(--bridge-scale));
            transform-origin: 50% 48%;
        }

        .splitframe-img {
            left:50%; bottom:-2vh; width: min(118vw, 2240px); height:auto;
            pointer-events:none; z-index:6;
        }
        .splitframe-left {
            transform: translate3d(var(--split-left-x), var(--split-left-y), 0) scale(var(--split-left-scale));
            transform-origin: 21% 52%;
        }
        .splitframe-right {
            transform: translate3d(var(--split-right-x), var(--split-right-y), 0) scale(var(--split-right-scale));
            transform-origin: 79% 52%;
        }

        .frame-two-img {
            filter: none !important; backdrop-filter:none;
            left:50%; top:50%; width: min(122vw, 2160px); height:auto; z-index:5;
            opacity: var(--frame2-opacity);
            transform: translate3d(var(--frame2-x), var(--frame2-y), 0) scale(var(--frame2-scale));
            transform-origin: 50% 48%;
        }

        .shade {
            inset:0; z-index: var(--shade-z); pointer-events:none; opacity: var(--shade-opacity);
            background: linear-gradient(180deg,
                rgba(var(--blur-tint), var(--shade-top-alpha)) 0%,
                rgba(var(--blur-tint), var(--shade-mid-alpha)) 48%,
                rgba(var(--blur-tint), var(--shade-bottom-alpha)) 100%);
        }

        .intro-copy {
            left:50%; bottom: clamp(56px, 28vh, 400px);
            width: min(560px, calc(100vw - 40px)); text-align:center; z-index:9;
            transform: translate3d(-50%, var(--intro-copy-y), 0);
            opacity: var(--intro-copy-opacity); will-change: transform, opacity;
        }
        .intro-copy p {
            margin:0 auto; max-width:560px; color:#fdf1e1;
            font-size:1.18rem; font-weight:500; line-height:1.18;
            text-shadow: 0 2px 18px rgba(0,0,0,0.42);
        }
        .hero-tags { display:flex; flex-wrap:wrap; justify-content:center; gap:10px; margin-top:26px }
        .hero-tags span {
            min-height:42px; display:inline-flex; align-items:center; justify-content:center;
            padding:0 25px; color:var(--ink); border-radius:999px; background:#fdf1e1;
            font-size:0.98rem; font-weight:500; box-shadow: 0 12px 30px rgba(0,0,0,0.18);
        }

        .story-panel {
            left:50%; top:45%; width: min(760px, calc(100vw - 42px)); z-index:10;
            text-align:center; pointer-events:none;
            transform: translate3d(-50%, -50%, 0);
            will-change: transform, opacity;
        }
        .story-panel h2 {
            margin:0; color:#fdf1e1; font-family:"Ogg Medium", serif;
            font-size:4.75rem; font-weight:500; line-height:0.95;
            text-shadow: 0 16px 38px var(--shadow);
        }
        .story-panel p {
            width: min(520px, 100%); margin:26px auto 0; color:#fdf1e1;
            font-size:1.14rem; font-weight:500; line-height:1.18;
            text-shadow: 0 2px 18px rgba(0,0,0,0.42);
        }
        .story-panel-bridge {
            top:60%; opacity: var(--panel2-opacity);
            transform: translate3d(-50%, var(--panel2-y), 0);
        }
        .story-panel-bazaar {
            top:29%; opacity: var(--panel3-opacity);
            transform: translate3d(-50%, var(--panel3-y), 0);
        }

        .facts {
            display:grid; grid-template-columns: repeat(2, minmax(0,1fr)); gap:86px;
            width: min(470px, 100%); margin:72px auto 0;
        }
        .facts dt {
            color:#fdf1e1; font-family:"Ogg Medium", serif;
            font-size:4.2rem; font-weight:500; line-height:0.9;
            text-shadow: 0 14px 34px var(--shadow);
        }
        .facts dd {
            margin:18px 0 0; color:#fdf1e1; font-size:1rem; font-weight:500; line-height:1.14;
            text-shadow: 0 2px 18px rgba(0,0,0,0.42);
        }

        .note-button {
            min-height:50px; margin-top:28px; display:inline-flex; align-items:center;
            justify-content:center; gap:12px; padding:0 28px; border-radius:999px;
            color:var(--ink); background:#fdf1e1; box-shadow: 0 16px 34px rgba(0,0,0,0.18);
            pointer-events:auto; cursor:pointer;
            transition: transform .2s ease, background .2s ease;
        }
        .note-button:hover { transform: translateY(-1px); }
        .note-button span:first-child { font-size:1.25rem; line-height:1 }

        /* ==========================================================
           BACK-TO-TOP BUTTON
           ========================================================== */
        .to-top {
            position: fixed;
            right: 24px;
            bottom: 24px;
            z-index: 100;
            width: 48px;
            height: 48px;
            display: grid;
            place-items: center;
            border-radius: 50%;
            background: #1a3d2e;
            color: #fdf1e1;
            box-shadow: 0 8px 24px rgb(0 0 0 / .28);
            cursor: pointer;
            opacity: 0;
            visibility: hidden;
            transform: translateY(8px);
            transition: opacity .3s ease, transform .3s ease, visibility .3s ease, background .2s ease;
        }
        .to-top svg { width: 16px; height: 16px; display: block; }
        .to-top:hover { background: #23503c; }
        .to-top.is-visible {
            opacity: 1;
            visibility: visible;
            transform: translateY(0);
        }
        .to-top:focus-visible {
            outline: 2px solid #fdf1e1;
            outline-offset: 4px;
        }

        /* ==========================================================
           MEADOW FOOTER (greenish theme)
           ========================================================== */
        .mf {
            --mf-paper: #eaf0e8;
            --mf-ink: #14261a;
            --mf-body: #4c6350;
            --mf-muted: #7d9182;
            --mf-mist: #cbdcc8;
            --mf-font: "Inter", system-ui, sans-serif;
            --u: min(100vw / 1440, 100vh / 672);
            --u: min(100vw / 1440, 100svh / 672);
            position: relative;
            height: 100vh;
            height: 100svh;
            background: var(--mf-paper);
            overflow: hidden;
            isolation: isolate;
            font-family: var(--mf-font);
            color: var(--mf-ink);
        }
        .mf *, .mf *::before, .mf *::after { box-sizing: border-box; }
        .mf a { color: inherit; text-decoration: none; }
        .mf ul { margin: 0; padding: 0; list-style: none; }

        .mf__stage {
            position: absolute; inset: 0; z-index: 0;
            background: var(--mf-paper);
        }
        .mf__stage.is-fallback {
            background: linear-gradient(to bottom, var(--mf-mist), var(--mf-paper));
        }

        .mf__video {
            display: block; width: 100%; height: 100%;
            object-fit: cover; object-position: 50% 100%;
            transform: translateY(9%);
        }

        .mf__stage::after {
            content: "";
            position: absolute; inset: 0;
            background: linear-gradient(to bottom,
                var(--mf-paper) 0%,
                rgb(234 240 232 / .96) 26%,
                rgb(234 240 232 / .72) 44%,
                rgb(234 240 232 / 0) 70%);
        }

        .mf__wordmark {
            position: absolute;
            left: 50%; bottom: calc(-2 * var(--u));
            transform: translateX(-50%);
            z-index: 1;
            margin: 0;
            font-family: var(--mf-font);
            font-size: calc(450 * var(--u));
            font-weight: 600;
            line-height: .74;
            letter-spacing: -.045em;
            white-space: nowrap;
            pointer-events: none;
            user-select: none;
            color: rgb(200 220 200 / .4);
            background: linear-gradient(to bottom,
                rgb(240 255 240 / .78),
                rgb(180 210 180 / .36) 48%,
                rgb(240 255 240 / .62));
            -webkit-background-clip: text;
            background-clip: text;
            -webkit-text-fill-color: transparent;
            filter: drop-shadow(0 calc(-1 * var(--u)) 0 rgb(240 255 240 / .55))
                    drop-shadow(0 0 calc(18 * var(--u)) rgb(170 200 170 / .45));
        }

        .mf__fog {
            position: absolute; inset: auto 0 0;
            z-index: 2; height: 17%;
            pointer-events: none;
            background: linear-gradient(to top,
                var(--mf-mist) 0%,
                rgb(203 220 200 / .6) 30%,
                rgb(203 220 200 / 0) 100%);
        }

        .mf__content {
            position: relative;
            z-index: 3;
            display: grid;
            grid-template-columns: calc(440 * var(--u)) calc(240 * var(--u)) calc(240 * var(--u)) 1fr;
            align-items: start;
            width: calc(1440 * var(--u));
            margin: 0 auto;
            padding: calc(86 * var(--u)) calc(100 * var(--u)) 0 calc(160 * var(--u));
        }

        .mf-brand__logo {
            display: inline-flex; align-items: center; gap: calc(10 * var(--u));
            font-size: calc(17 * var(--u)); font-weight: 500; letter-spacing: -.02em;
        }

        .mf-brand__mark {
            display: grid; place-items: center;
            width: calc(30 * var(--u)); height: calc(30 * var(--u));
            border-radius: calc(8 * var(--u));
            background: linear-gradient(to bottom, #2f4a3d, #14271F 55%);
            box-shadow: 0 calc(1 * var(--u)) calc(2 * var(--u)) rgb(0 0 0 / .25);
            color: #fff;
            flex: 0 0 auto;
        }
        .mf-brand__mark svg { width: 60%; height: 60%; display: block; }

        .mf-brand__title {
            margin: calc(19 * var(--u)) 0 0;
            font-family: var(--mf-font);
            font-size: calc(20 * var(--u));
            font-weight: 600;
            line-height: 1.2;
            letter-spacing: -.045em;
            color: var(--mf-ink);
        }

        .mf-brand__text {
            max-width: calc(412 * var(--u));
            margin: calc(18 * var(--u)) 0 0;
            color: var(--mf-body);
            font-size: calc(13.7 * var(--u));
            line-height: 1.43;
            letter-spacing: -.012em;
        }

        .mf-brand__cta {
            display: inline-flex; align-items: center; gap: calc(6 * var(--u));
            height: calc(32.5 * var(--u));
            margin-top: calc(20 * var(--u));
            padding: 0 calc(16 * var(--u)) 0 calc(15 * var(--u));
            border-radius: calc(7 * var(--u));
            background: #1a3d2e;
            color: #fff;
            font-size: calc(11.8 * var(--u));
            font-weight: 500;
            letter-spacing: -.01em;
            transition: background .2s, transform .2s;
        }
        .mf-brand__cta:hover { background: #23503c; transform: translateY(-1px); }

        .mf-brand__cta-icon {
            width: calc(13 * var(--u)); height: calc(13 * var(--u));
            margin-top: calc(-1.5 * var(--u));
            flex: 0 0 auto;
        }

        .mf-brand__copy {
            margin: calc(23 * var(--u)) 0 0;
            color: var(--mf-muted);
            font-size: calc(11 * var(--u));
            letter-spacing: -.005em;
        }

        /* Column headings & lists */
        .mf-col__title {
            margin: 0;
            font-family: var(--mf-font);
            font-size: calc(14 * var(--u));
            font-weight: 600;
            line-height: 1.3;
            letter-spacing: -.015em;
            color: var(--mf-ink);
        }

        .mf-col__list {
            display: flex;
            flex-direction: column;
            gap: calc(12 * var(--u));
            margin-top: calc(18 * var(--u));
            font-size: calc(13 * var(--u));
            line-height: 1.38;
            letter-spacing: -.005em;
            color: var(--mf-body);
        }

        .mf-col__list a {
            display: inline-block;
            transition: color .2s ease, transform .2s ease;
        }
        .mf-col__list a:hover {
            color: var(--mf-ink);
            transform: translateX(2px);
        }
        .mf-col__list a:focus-visible {
            outline: 2px solid var(--mf-ink);
            outline-offset: 3px;
            border-radius: 2px;
        }

        .mf-col__soon {
            display: inline-block;
            color: var(--mf-muted);
            font-style: italic;
            font-size: 0.94em;
        }

        /* ==========================================================
           RESPONSIVE — media queries come AFTER base styles so they
           properly override.
           ========================================================== */

        /* Cinema breakpoints */
        @@media (max-width: 1500px) {
            .hero-title { font-size: 11rem; }
            .story-panel h2 { font-size: 4.1rem; }
        }

        @@media (max-width: 1100px) {
            .hero-title { top: 15vh; font-size: 7.5rem; }
            .bridge-img { width: 138vw; }
            .frame-two-img { width: 132vw; }
            .story-panel h2 { font-size: 3.2rem; }
            .facts { gap: 34px; margin-top: 44px; }
            .facts dt { font-size: 3.2rem; }
            .sight-card { flex-basis: clamp(320px, 40vw, 390px); min-height: 178px; }
        }

        @@media (max-width: 1000px) {
            .site-header {
                grid-template-columns: 1fr auto;
                gap: 16px 24px;
                padding: 24px 28px;
            }
            .site-nav {
                grid-column: 1 / -1;
                grid-row: 2;
                justify-content: flex-start;
                gap: 20px;
                overflow-x: auto;
                scrollbar-width: none;
                -webkit-overflow-scrolling: touch;
            }
            .site-nav::-webkit-scrollbar { display: none; }
        }

        @@media (max-width: 640px) {
            .stage { min-height: 640px; }
            .site-header { grid-template-columns: 1fr auto; gap: 18px; padding: 24px; }
            .site-nav {
                grid-column: 1 / -1; grid-row: 2; justify-content: flex-start;
                gap: 18px; overflow-x: auto; scrollbar-width: none;
            }
            .site-nav::-webkit-scrollbar { display: none; }
            .hero-title { top: 16vh; font-size: 4.5rem; }
            .bridge-img { bottom: 2vh; width: 190vw; }
            .frame-two-img { width: 176vw; }
            .intro-copy { bottom: 42px; }
            .intro-copy p, .story-panel p { font-size: 1rem; }
            .hero-tags { gap: 8px; }
            .hero-tags span { min-height: 38px; padding: 0 16px; font-size: 0.88rem; }
            .story-panel { top: 42%; }
            .story-panel-bazaar { top: 26%; }
            .story-panel h2 { font-size: 2.45rem; }
            .facts { gap: 18px; margin-top: 34px; }
            .facts dt { font-size: 2.5rem; }
            .sights-slider { padding: 0; }
            .sights-track { gap: 12px; transform: translate3d(calc(var(--sights-shift) - 18vw), 0, 0); }
            .sight-card { flex-basis: min(82vw, 330px); height: 220px; padding: 24px; border-radius: 24px; }
            .sights-controls { top: calc(var(--sights-screen-top) + 236px); }
            .sight-card h3 { max-width: 78%; }
            .sight-card p { max-width: 100%; margin-top: 10px; }
            .sight-kicker { margin-bottom: 56px; }
            .sight-pin { top: 24px; right: 24px; width: 57.6px; height: 57.6px; }
        }

        @@media (max-width: 400px) {
            .facts { grid-template-columns: 1fr; gap: 24px; margin-top: 28px; }
            .facts dt { font-size: 2.4rem; }
            .story-panel p { font-size: 0.95rem; }
            .hero-tags span { font-size: 0.8rem; padding: 0 14px; }
        }

        /* Footer — tablet / mobile grid restructure */
        @@media (max-width: 767px) {
            .mf {
                --u: 1px;
                display: flex;
                flex-direction: column;
                height: auto;
                min-height: 100svh;
            }

            .mf__stage::after {
                background: linear-gradient(to bottom,
                    var(--mf-paper) 0%,
                    rgb(234 240 232 / .95) 50%,
                    rgb(234 240 232 / .8) 68%,
                    rgb(234 240 232 / 0) 90%);
            }

            .mf__content {
                display: grid;
                grid-template-columns: auto auto auto;
                justify-content: space-between;
                column-gap: 12px;
                row-gap: 36px;
                width: 100%;
                padding: 40px 20px 0;
                margin-bottom: max(34vw, 150px);
            }

            .mf__brand {
                grid-column: 1 / -1;
            }

            .mf-brand__title {
                font-size: 21px;
                margin-top: 20px;
            }

            .mf-brand__text {
                max-width: 34em;
                font-size: 14px;
                margin-top: 16px;
            }

            .mf-brand__cta {
                height: 38px;
                padding: 0 18px 0 16px;
                border-radius: 8px;
                font-size: 13px;
                margin-top: 20px;
            }

            .mf-brand__cta-icon {
                width: 14px;
                height: 14px;
                margin-top: -1.5px;
            }

            .mf-brand__copy {
                font-size: 12.5px;
                margin-top: 16px;
            }

            .mf-col__title {
                font-size: 14px;
            }

            .mf-col__list {
                gap: 12px;
                margin-top: 16px;
                font-size: 12.5px;
                letter-spacing: 0;
                white-space: normal;
                line-height: 1.4;
            }

            .mf__wordmark {
                bottom: 5vw;
                font-size: 27vw;
            }

            .mf__fog {
                height: 7%;
            }
        }

        @@media (max-width: 359px) {
            .mf__content {
                grid-template-columns: 1fr 1fr;
            }
        }

        @@media (max-width: 620px) {
            .to-top {
                right: 16px;
                bottom: 16px;
                width: 44px;
                height: 44px;
            }
        }

        /* Short viewports (landscape phones / short windows) */
        @@media (max-height: 700px) and (min-width: 641px) {
            .stage { min-height: 100vh; min-height: 100dvh; }
            .hero-title { top: 13vh; font-size: clamp(4rem, 10vw, 9rem); }
            .intro-copy { bottom: 28px; }
            .intro-copy p { font-size: 1rem; }
            .hero-tags { margin-top: 16px; gap: 8px; }
            .hero-tags span { min-height: 34px; font-size: 0.82rem; padding: 0 14px; }
            .story-panel h2 { font-size: clamp(2.2rem, 4vw, 3.4rem); }
            .story-panel p { font-size: 0.98rem; margin-top: 18px; }
            .facts { margin-top: 28px; gap: 32px; }
            .facts dt { font-size: clamp(2rem, 3.5vw, 2.8rem); }
            .facts dd { font-size: 0.88rem; margin-top: 12px; }
            .note-button { min-height: 44px; padding: 0 22px; margin-top: 20px; }
            .note-button span:last-child { font-size: 0.92rem; }
        }

        @@media (prefers-reduced-motion: reduce) {
            html { scroll-behavior: auto; }
            .scene-img, .back-stack, .hero-title, .intro-copy,
            .story-panel, .sights-track, .sights-slider,
            .sight-nav, .note-button, .mf-col__list a, .to-top { transition: none; }
        }

        /* Font-face — loaded last but valid in CSS anywhere */
        @@font-face {
            font-family: "Ogg Medium";
            src: url("https://dcym8fthxf5uu.cloudfront.net/fonts/247a073c-29f5-4a89-aa3a-741020f346fc/OggText-Medium.woff2") format("woff2");
            font-weight: 500;
            font-style: normal;
            font-display: swap;
        }
    </style>
</head>
<body>

    <!-- Loader inserted at top of landing page -->
    <main class="intro" id="intro" aria-label="Karnel Travel Guide introduction">

        <header class="intro-top">
            <div class="edition">
                <span class="edition-mark"></span>
                <span>Independent Travel Guide</span>
            </div>
            <div class="top-coordinate">Northern Pakistan<br />35° N · 74° E</div>
        </header>

        <!-- Vector landscape (kept minimal here) -->
        <svg class="scene" viewBox="0 0 1440 900" preserveAspectRatio="xMidYMid slice" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Layered mountains and lake">
            <defs>
                <radialGradient id="skyGlow" cx="50%" cy="43%" r="55%">
                    <stop offset="0%" stop-color="#46675b" stop-opacity=".65" />
                    <stop offset="100%" stop-color="#101c1d" stop-opacity="0" />
                </radialGradient>
                <linearGradient id="lakeGradient" x1="0" y1="0" x2="0" y2="1">
                    <stop offset="0%" stop-color="#477e70" />
                    <stop offset="50%" stop-color="#315d55" />
                    <stop offset="100%" stop-color="#172f2d" />
                </linearGradient>
                <filter id="softGlow" x="-100%" y="-100%" width="300%" height="300%"><feGaussianBlur stdDeviation="3" /></filter>
                <clipPath id="landscapeClip"><rect width="1440" height="900" /></clipPath>
                <path id="expeditionPath" d="M 330,680 C 430,650 470,590 550,560 S 675,530 730,485 S 830,445 885,485 S 980,570 1080,590" />
            </defs>
            <g clip-path="url(#landscapeClip)">
                <rect width="1440" height="900" fill="url(#skyGlow)" />
                <path class="mountain-far" d="M0 580 L120 470 L205 510 L335 360 L425 450 L555 300 L665 430 L760 340 L850 430 L980 290 L1100 440 L1210 350 L1320 465 L1440 390 L1440 900 L0 900 Z" />
                <path class="lake" d="M0 700 Q220 675 410 700 T790 700 T1140 685 T1440 700 L1440 900 L0 900 Z" />
            </g>
        </svg>

        <section class="intro-content" aria-label="Welcome">
            <div class="eyebrow">Beyond the familiar</div>

            <h1 class="brand">KARNEL <span>TRAVEL GUIDE</span></h1>

            <p class="brand-description">Follow the road less travelled. Discover the extraordinary landscapes and hidden stories of Pakistan.</p>
        </section>

        <footer class="intro-bottom">
            <div class="bottom-note">
                <strong>Pakistan, Uncovered</strong>
                Mountains · Valleys · Journeys
            </div>

            <div class="progress-block" aria-label="Intro progress">
                <div class="progress-meta">
                    <span id="progress-label">ENTERING THE NORTH</span>
                    <span id="progress-percent">00%</span>
                </div>
                <div class="progress-track">
                    <div class="progress-fill" id="progress-fill"></div>
                </div>
            </div>

            <a class="skip" id="skip-intro" href="#" role="button">
                Explore
                <span class="skip-arrow" aria-hidden="true">↗</span>
            </a>
        </footer>
    </main>

    <script>
        (function () {
            "use strict";

            const intro = document.getElementById("intro");
            const fill = document.getElementById("progress-fill");
            const percent = document.getElementById("progress-percent");
            const label = document.getElementById("progress-label");
            const skip = document.getElementById("skip-intro");

            if (!intro || !fill || !percent || !skip) return;

            // Lock scrolling while intro is active
            document.body.classList.add('intro-open');

            const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
            const duration = reducedMotion ? 500 : 5200;
            const exitDuration = reducedMotion ? 0 : 850;

            const start = performance.now();
            let navigated = false;
            let animationFrame = 0;
            let exitTimer = 0;

            const milestones = [
                { at: 0, text: "ENTERING THE NORTH" },
                { at: 0.35, text: "TRACING NEW PATHS" },
                { at: 0.72, text: "YOUR JOURNEY AWAITS" }
            ];

            function updateProgress(progress) {
                const p = Math.max(0, Math.min(1, progress));
                const value = Math.floor(p * 100);
                fill.style.transform = `scaleX(${p})`;
                percent.textContent = `${String(value).padStart(2, "0")}%`;
                const milestone = [...milestones].reverse().find(item => p >= item.at);
                if (milestone && label) label.textContent = milestone.text;
            }

            function navigate() {
                if (navigated) return;
                navigated = true;
                cancelAnimationFrame(animationFrame);
                clearTimeout(exitTimer);
                updateProgress(1);
                skip.setAttribute("aria-disabled", "true");
                intro.classList.add("is-leaving");
                exitTimer = window.setTimeout(() => {
                    // Remove loader and restore scrolling so landing page is usable
                    document.body.classList.remove('intro-open');
                    intro.remove();
                }, exitDuration);
            }

            function tick(now) {
                if (navigated) return;
                const progress = Math.min((now - start) / duration, 1);
                updateProgress(progress);
                if (progress >= 1) { navigate(); return; }
                animationFrame = requestAnimationFrame(tick);
            }

            skip.addEventListener("click", event => { event.preventDefault(); navigate(); });
            animationFrame = requestAnimationFrame(tick);
        })();
    </script>

