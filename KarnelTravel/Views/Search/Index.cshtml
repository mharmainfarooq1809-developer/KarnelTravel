@{
    ViewData["Title"] = "Explore | Karnel Travel Guide";
    ViewData["Description"] = "Search destinations, hotels, restaurants, resorts and transport across Pakistan. Sample-data filtering is fully functional in this frontend demo.";
}

@section Styles {
    <style>
        .search-hero {
            padding: calc(var(--header-h) + 60px) 0 40px;
            background: var(--sand);
        }
        .search-hero h1 { max-width: 16ch; }
        .search-hero p { color: var(--muted); max-width: 60ch; }

        .filter-bar {
            background: var(--white);
            border: 1px solid var(--line);
            border-radius: var(--radius-lg);
            padding: 22px 24px;
            box-shadow: var(--shadow-sm);
            display: grid;
            grid-template-columns: 1.4fr 1fr 1fr 1fr 1fr;
            gap: 14px;
            margin-top: -20px;
            position: relative;
            z-index: 2;
        }
        .filter-bar__actions {
            grid-column: 1 / -1;
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 16px;
            flex-wrap: wrap;
            padding-top: 8px;
            border-top: 1px solid var(--line);
            margin-top: 4px;
        }
        .filter-bar__actions .muted { font-size: .78rem; color: var(--muted); }

        .results-section { padding-block: 56px 96px; }
        .results-head {
            display: flex;
            justify-content: space-between;
            align-items: baseline;
            gap: 16px;
            flex-wrap: wrap;
            margin-bottom: 28px;
        }
        .results-head h2 { margin: 0; }
        .results-count { font-size: .82rem; letter-spacing: .12em; text-transform: uppercase; color: var(--muted); }

        .listing-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
            gap: 26px;
        }
        .listing-card {
            display: flex;
            flex-direction: column;
            background: var(--white);
            border: 1px solid var(--line);
            border-radius: var(--radius-lg);
            overflow: hidden;
            transition: transform .4s var(--ease), box-shadow .4s var(--ease);
        }
        .listing-card:hover { transform: translateY(-4px); box-shadow: var(--shadow-md); }
        .listing-card .media { aspect-ratio: 4 / 3; }
        .listing-card__body { padding: 20px 22px 22px; display: flex; flex-direction: column; gap: 10px; flex: 1; }
        .listing-card__meta { font-size: .68rem; letter-spacing: .16em; text-transform: uppercase; color: var(--muted); }
        .listing-card h3 { margin: 0; font-size: 1.2rem; }
        .listing-card__desc { color: var(--muted); font-size: .9rem; margin: 0; flex: 1; }
        .listing-card__footer {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding-top: 14px;
            border-top: 1px solid var(--line);
            margin-top: auto;
            gap: 10px;
        }
        .listing-card__price { font-family: var(--serif); font-size: 1.1rem; color: var(--forest-deep); }
        .listing-card__price small {
            display: block;
            font-family: var(--sans);
            font-size: .66rem;
            letter-spacing: .12em;
            text-transform: uppercase;
            color: var(--muted);
            font-weight: 400;
        }

        .empty-state {
            grid-column: 1 / -1;
            text-align: center;
            padding: 60px 24px;
            border: 1px dashed var(--line);
            border-radius: var(--radius-lg);
            background: var(--white);
        }
        .empty-state h3 { margin: 0 0 8px; }
        .empty-state p { color: var(--muted); margin: 0; }

        @@media (max-width: 1080px) {
            .filter-bar { grid-template-columns: 1fr 1fr 1fr; }
        }
        @@media (max-width: 640px) {
            .filter-bar { grid-template-columns: 1fr; }
        }
    </style>
}

<header class="search-hero">
    <div class="container" data-reveal>
        <p class="eyebrow">Explore</p>
        <h1>Search across destinations, stays and journeys.</h1>
        <p>This page filters sample records so you can see how the catalogue will behave
           once the SQL Server backend is connected. Sample prices and availability are
           marked, not live.</p>
    </div>
</header>

<section class="container">
    <form class="filter-bar" id="explore-filters" novalidate>
        <label class="field" style="grid-column: span 1;">
            <span>Keyword</span>
            <input type="search" name="keyword" placeholder="e.g. Hunza, hotel, bus" autocomplete="off" />
        </label>
        <label class="field">
            <span>Category</span>
            <select name="category">
                <option value="">All categories</option>
                <option value="destinations">Tourist Spots</option>
                <option value="hotels">Hotels</option>
                <option value="restaurants">Restaurants</option>
                <option value="resorts">Resorts</option>
                <option value="transport">Transportation</option>
            </select>
        </label>
        <label class="field">
            <span>Location</span>
            <input type="text" name="location" placeholder="e.g. Hunza" autocomplete="off" />
        </label>
        <label class="field">
            <span>Min budget (PKR)</span>
            <input type="number" name="minBudget" min="0" step="1000" placeholder="0" />
        </label>
        <label class="field">
            <span>Max budget (PKR)</span>
            <input type="number" name="maxBudget" min="0" step="1000" placeholder="Any" />
        </label>

        <div class="filter-bar__actions">
            <span class="muted">Filters apply as you type. Sample data only.</span>
            <div style="display:flex;gap:10px;flex-wrap:wrap;">
                <a class="btn btn--outline" href="@Url.Action("Advanced", "Search")">Advanced Discovery</a>
                <button class="btn" type="submit" style="display:none;">Search</button>
                <button class="btn btn--outline" type="reset">Clear filters</button>
            </div>
        </div>
    </form>
</section>

<section class="results-section">
    <div class="container">
