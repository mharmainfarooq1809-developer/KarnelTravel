    </div>
</section>

@section Scripts {
    <script>
        /* Explore — working frontend filter on sample records */
        (function () {
            'use strict';
            var form = document.getElementById('explore-filters');
            var cards = Array.prototype.slice.call(document.querySelectorAll('[data-card]'));
            var countEl = document.getElementById('results-count');
            var emptyEl = document.getElementById('empty-state');
            if (!form || !cards.length) { return; }

            var keywordEl = form.querySelector('[name="keyword"]');
            var categoryEl = form.querySelector('[name="category"]');
            var locationEl = form.querySelector('[name="location"]');
            var minEl = form.querySelector('[name="minBudget"]');
            var maxEl = form.querySelector('[name="maxBudget"]');

            function apply() {
                var kw = (keywordEl.value || '').toLowerCase().trim();
                var cat = categoryEl.value;
                var loc = (locationEl.value || '').toLowerCase().trim();
                var min = parseFloat(minEl.value) || 0;
                var max = parseFloat(maxEl.value) || Infinity;
                if (max < min) { max = min; }

                var visible = 0;
                cards.forEach(function (card) {
                    var name = (card.dataset.name || '').toLowerCase();
                    var text = (card.textContent || '').toLowerCase();
                    var category = card.dataset.category;
                    var location = (card.dataset.location || '').toLowerCase();
                    var budget = parseFloat(card.dataset.budget) || 0;

                    var match =
                        (!kw || name.indexOf(kw) !== -1 || text.indexOf(kw) !== -1) &&
                        (!cat || category === cat) &&
                        (!loc || location.indexOf(loc) !== -1) &&
                        (budget >= min) &&
                        (budget <= max);

                    card.hidden = !match;
                    if (match) { visible++; }
                });

                countEl.textContent = visible;
                emptyEl.hidden = visible > 0;
            }

            form.addEventListener('submit', function (e) { e.preventDefault(); apply(); });
            form.addEventListener('input', apply);
            form.addEventListener('reset', function () {
                // Reset is fired before values clear; defer so we read empty inputs.
                setTimeout(apply, 0);
            });

            // Read query string (from the home search panel) once on load.
            var params = new URLSearchParams(window.location.search);
            ['keyword', 'category', 'location'].forEach(function (key) {
                if (params.get(key)) {
                    var el = form.querySelector('[name="' + key + '"]');
                    if (el) { el.value = params.get(key); }
                }
            });
            if (params.get('budget')) {
                maxEl.value = params.get('budget');
            }

            apply();
        })();
    </script>
}