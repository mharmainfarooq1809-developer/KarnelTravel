
@using KarnelTravel.Models
@{
    ViewData["Title"] = "Explore | Karnel Travel Guide";

    var destinations =
        ViewBag.Destinations as IEnumerable<Destination>
        ?? Enumerable.Empty<Destination>();

    var hotels =
        ViewBag.Hotels as IEnumerable<Hotel>
        ?? Enumerable.Empty<Hotel>();

    var restaurants =
        ViewBag.Restaurants as IEnumerable<Restaurant>
        ?? Enumerable.Empty<Restaurant>();

    var resorts =
        ViewBag.Resorts as IEnumerable<Resort>
        ?? Enumerable.Empty<Resort>();

    var transport =
        ViewBag.Transport as IEnumerable<TransportService>
        ?? Enumerable.Empty<TransportService>();

    var packages =
        ViewBag.Packages as IEnumerable<TourPackage>
        ?? Enumerable.Empty<TourPackage>();

    int total = ViewBag.TotalResults ?? 0;
    string keyword = ViewBag.Keyword as string ?? "";
    string category = ViewBag.Category as string ?? "all";
    decimal? budget = ViewBag.Budget as decimal?;
}

@section Styles {
<style>
    .search-hero {
        padding: calc(var(--header-h) + 60px) 0 40px;
        background: var(--sand);
    }

    .search-hero h1 { max-width: 16ch; }
    .search-hero p { color: var(--muted); max-width: 60ch; }

    .filter-bar {
        background: var(--white);
        border: 1px solid var(--line);
        border-radius: var(--radius-lg);
        padding: 22px 24px;
        box-shadow: var(--shadow-sm);
        display: grid;
        grid-template-columns: 1.4fr 1fr 1fr;
        gap: 14px;
        margin-top: -20px;
        position: relative;
        z-index: 2;
    }

    .filter-bar__actions {
        grid-column: 1 / -1;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 16px;
        flex-wrap: wrap;
        padding-top: 16px;
        border-top: 1px solid var(--line);
    }

    .results-section { padding-block: 56px 96px; }

    .results-head {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        gap: 16px;
        flex-wrap: wrap;
        margin-bottom: 24px;
    }

    .results-count {
        font-size: .82rem;
        letter-spacing: .12em;
        text-transform: uppercase;
        color: var(--muted);
    }

    .result-group { margin-bottom: 56px; }

    .listing-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
        gap: 26px;
    }

    .listing-card {
        display: flex;
        flex-direction: column;
        background: var(--white);
        border: 1px solid var(--line);
        border-radius: var(--radius-lg);
        overflow: hidden;
        transition: transform .3s var(--ease),
                    box-shadow .3s var(--ease);
    }

    .listing-card:hover {
        transform: translateY(-4px);
        box-shadow: var(--shadow-md);
    }

    .listing-card .media {
        aspect-ratio: 4 / 3;
        overflow: hidden;
        background: var(--sand);
    }

    .listing-card .media img {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .listing-card__body {
        padding: 20px 22px 22px;
        display: flex;
        flex-direction: column;
        gap: 10px;
        flex: 1;
    }

    .listing-card__meta {
        font-size: .68rem;
        letter-spacing: .12em;
        text-transform: uppercase;
        color: var(--muted);
    }

    .listing-card h3 { margin: 0; font-size: 1.2rem; }

    .listing-card__desc {
        color: var(--muted);
        font-size: .9rem;
        margin: 0;
    }

    .listing-card__footer {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding-top: 14px;
        border-top: 1px solid var(--line);
        margin-top: auto;
        gap: 10px;
    }

    .listing-card__price {
        font-family: var(--serif);
        font-size: 1.05rem;
        color: var(--forest-deep);
    }

    .listing-card__price small {
        display: block;
        font-family: var(--sans);
        font-size: .66rem;
        letter-spacing: .1em;
        text-transform: uppercase;
        color: var(--muted);
    }

    .empty-state {
        text-align: center;
        padding: 60px 24px;
        border: 1px dashed var(--line);
        border-radius: var(--radius-lg);
        background: var(--white);
    }

    .empty-state p { color: var(--muted); }

    @@media (max-width: 700px) {
        .filter-bar { grid-template-columns: 1fr; }

        .filter-bar__actions {
            align-items: stretch;
        }

        .filter-bar__actions > div {
            width: 100%;
        }

        .filter-bar__actions .btn {
            justify-content: center;
        }

        .listing-grid {
            grid-template-columns: 1fr;
        }
    }
</style>
}

<header class="search-hero">
    <div class="container" data-reveal>
        <p class="eyebrow">Explore Pakistan</p>
        <h1>Find your next destination.</h1>
        <p>
            Discover destinations, accommodation, restaurants,
            resorts, transport and travel packages.
        </p>
    </div>
</header>

<section class="container">
    <form method="get"
          action="@Url.Action("Index", "Search")"
          class="filter-bar">

        <label class="field">
            <span>Keyword</span>
            <input type="search"
                   name="keyword"
                   value="@keyword"
                   placeholder="Hunza, Lahore, hotel..." />
        </label>

        <label class="field">
            <span>Category</span>
            <select name="category">
                <option value="all"
                        selected="@(category == "all")">
                    All categories
                </option>
                <option value="destinations"
                        selected="@(category == "destinations")">
                    Tourist spots
                </option>
                <option value="hotels"
                        selected="@(category == "hotels")">
                    Hotels
                </option>
                <option value="restaurants"
                        selected="@(category == "restaurants")">
                    Restaurants
                </option>
                <option value="resorts"
                        selected="@(category == "resorts")">
                    Resorts
                </option>
                <option value="transport"
                        selected="@(category == "transport")">
                    Transportation
                </option>
                <option value="packages"
                        selected="@(category == "packages")">
                    Tour packages
                </option>
            </select>
        </label>

        <label class="field">
            <span>Maximum budget (PKR)</span>
            <input type="number"
                   name="budget"
                   min="0"
                   step="1000"
                   value="@(budget?.ToString())"
                   placeholder="Any budget" />
        </label>

        <div class="filter-bar__actions">
            <span class="results-count">
                @total result(s) found
            </span>

            <div style="display:flex;gap:10px;flex-wrap:wrap;">
                <a class="btn btn--outline"
                   href="@Url.Action("Advanced", "Search")">
                    Advanced discovery
                </a>

                <a class="btn btn--outline"
                   href="@Url.Action("Index", "Search")">
                    Clear filters
                </a>

                <button class="btn" type="submit">
                    Search
                </button>
            </div>
        </div>
    </form>
</section>

<section class="results-section">
    <div class="container">

        @if (total == 0)
        {
            <div class="empty-state">
                <h2>No results found</h2>
                <p>
                    No published listings matched your search.
                    Try another keyword or clear your filters.
                </p>
            </div>
        }
        else
        {
            <div class="results-head">
                <h2>Search results</h2>
                <span class="results-count">
                    @total listing(s)
                </span>
            </div>

            @if (destinations.Any())
            {
                <section class="result-group">
                    <h2>Tourist destinations</h2>
                    <div class="listing-grid">
                        @foreach (var item in destinations)
                        {
                            <article class="listing-card">
                                <div class="media">
                                    @if (!string.IsNullOrWhiteSpace(item.ImageUrl))
                                    {
                                        <img src="@item.ImageUrl"
                                             alt="@item.Name"
                                             loading="lazy" />
                                    }
                                </div>

                                <div class="listing-card__body">
                                    <span class="listing-card__meta">
                                        @item.Region · Destination
                                    </span>
                                    <h3>@item.Name</h3>
                                    <p class="listing-card__desc">
                                        @item.ShortDescription
                                    </p>

                                    <div class="listing-card__footer">
                                        <span class="listing-card__price">
                                            Explore
                                        </span>
                                        <a class="link-arrow"
                                           href="@Url.Action("Index", "Destinations")">
                                            View
                                        </a>
                                    </div>
                                </div>
                            </article>
                        }
                    </div>
                </section>
            }

            @if (hotels.Any())
            {
                <section class="result-group">
                    <h2>Hotels</h2>
                    <div class="listing-grid">
                        @foreach (var item in hotels)
                        {
                            <article class="listing-card">
                                <div class="media">
                                    @if (!string.IsNullOrWhiteSpace(item.ImageUrl))
                                    {
                                        <img src="@item.ImageUrl"
                                             alt="@item.Name"
                                             loading="lazy" />
                                    }
                                </div>

                                <div class="listing-card__body">
                                    <span class="listing-card__meta">
                                        @item.City · Hotel
                                    </span>
                                    <h3>@item.Name</h3>
                                    <p class="listing-card__desc">
                                        @item.ShortDescription
                                    </p>

                                    <div class="listing-card__footer">
                                        <span class="listing-card__price">
                                            @(item.StartingPricePerNight.HasValue
                                                ? $"PKR {item.StartingPricePerNight.Value:N0}"
                                                : "Price on request")
                                            <small>Per night</small>
                                        </span>
                                        <a class="link-arrow"
                                           href="@Url.Action("Index", "Hotels")">
                                            View
                                        </a>
                                    </div>
                                </div>
                            </article>
                        }
                    </div>
                </section>
            }

            @if (restaurants.Any())
            {
                <section class="result-group">
                    <h2>Restaurants</h2>
                    <div class="listing-grid">
                        @foreach (var item in restaurants)
                        {
                            <article class="listing-card">
                                <div class="media">
                                    @if (!string.IsNullOrWhiteSpace(item.ImageUrl))
                                    {
                                        <img src="@item.ImageUrl"
                                             alt="@item.Name"
                                             loading="lazy" />
                                    }
                                </div>

                                <div class="listing-card__body">
                                    <span class="listing-card__meta">
                                        @item.City · Restaurant
                                    </span>
                                    <h3>@item.Name</h3>
                                    <p class="listing-card__desc">
                                        @item.ShortDescription
                                    </p>

                                    <div class="listing-card__footer">
                                        <span class="listing-card__price">
                                            @(item.AverageMealPrice.HasValue
                                                ? $"PKR {item.AverageMealPrice.Value:N0}"
                                                : "Price on request")
                                            <small>Average meal</small>
                                        </span>
                                        <a class="link-arrow"
                                           href="@Url.Action("Index", "Restaurants")">
                                            View
                                        </a>
                                    </div>
                                </div>
                            </article>
                        }
                    </div>
                </section>
            }

            @if (resorts.Any())
            {
                <section class="result-group">
                    <h2>Resorts</h2>
                    <div class="listing-grid">
                        @foreach (var item in resorts)
                        {
                            <article class="listing-card">
                                <div class="media">
                                    @if (!string.IsNullOrWhiteSpace(item.ImageUrl))
                                    {
                                        <img src="@item.ImageUrl"
                                             alt="@item.Name"
                                             loading="lazy" />
                                    }
                                </div>

                                <div class="listing-card__body">
                                    <span class="listing-card__meta">
                                        @item.CityOrRegion · Resort
                                    </span>
                                    <h3>@item.Name</h3>
                                    <p class="listing-card__desc">
                                        @item.ShortDescription
                                    </p>

                                    <div class="listing-card__footer">
                                        <span class="listing-card__price">
                                            @(item.StartingPricePerNight.HasValue
                                                ? $"PKR {item.StartingPricePerNight.Value:N0}"
                                                : "Price on request")
                                            <small>Per night</small>
                                        </span>
                                        <a class="link-arrow"
                                           href="@Url.Action("Index", "Resorts")">
                                            View
                                        </a>
                                    </div>
                                </div>
                            </article>
                        }
                    </div>
                </section>
            }

            @if (transport.Any())
            {
                <section class="result-group">
                    <h2>Transportation</h2>
                    <div class="listing-grid">
                        @foreach (var item in transport)
                        {
                            <article class="listing-card">
                                <div class="media">
                                    @if (!string.IsNullOrWhiteSpace(item.ImageUrl))
                                    {
                                        <img src="@item.ImageUrl"
                                             alt="@item.Name"
                                             loading="lazy" />
                                    }
                                </div>

                                <div class="listing-card__body">
                                    <span class="listing-card__meta">
                                        @item.StartingCity → @item.DestinationCity
                                    </span>
                                    <h3>@item.Name</h3>
                                    <p class="listing-card__desc">
                                        @item.Description
                                    </p>

                                    <div class="listing-card__footer">
                                        <span class="listing-card__price">
                                            @(item.StartingPrice.HasValue
                                                ? $"PKR {item.StartingPrice.Value:N0}"
                                                : "Price on request")
                                            <small>Starting price</small>
                                        </span>
                                        <a class="link-arrow"
                                           href="@Url.Action("Index", "Transport")">
                                            View
                                        </a>
                                    </div>
                                </div>
                            </article>
                        }
                    </div>
                </section>
            }

            @if (packages.Any())
            {
                <section class="result-group">
                    <h2>Tour packages</h2>
                    <div class="listing-grid">
                        @foreach (var item in packages)
                        {
                            <article class="listing-card">
                                <div class="media">
                                    @if (!string.IsNullOrWhiteSpace(item.ImageUrl))
                                    {
                                        <img src="@item.ImageUrl"
                                             alt="@item.Name"
                                             loading="lazy" />
                                    }
                                </div>

                                <div class="listing-card__body">
                                    <span class="listing-card__meta">
                                        @item.DestinationName ·
                                        @item.DurationDays day(s)
                                    </span>
                                    <h3>@item.Name</h3>
                                    <p class="listing-card__desc">
                                        @item.ShortDescription
                                    </p>

                                    <div class="listing-card__footer">
                                        <span class="listing-card__price">
                                            @(item.PricePerAdult.HasValue
                                                ? $"PKR {item.PricePerAdult.Value:N0}"
                                                : "Price on request")
                                            <small>Per adult</small>
                                        </span>
                                        <a class="link-arrow"
                                           href="@Url.Action("Index", "Packages")">
                                            View
                                        </a>
                                    </div>
                                </div>
                            </article>
                        }
                    </div>
                </section>
            }
        }

    </div>
</section>
