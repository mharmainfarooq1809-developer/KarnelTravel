@using KarnelTravel.Models
@{
    ViewData["Title"] = "Explore | Karnel Travel Guide";

    var destinations = ViewBag.Destinations as IEnumerable<Destination> ?? Enumerable.Empty<Destination>();
    var hotels = ViewBag.Hotels as IEnumerable<Hotel> ?? Enumerable.Empty<Hotel>();
    var restaurants = ViewBag.Restaurants as IEnumerable<Restaurant> ?? Enumerable.Empty<Restaurant>();
    var resorts = ViewBag.Resorts as IEnumerable<Resort> ?? Enumerable.Empty<Resort>();
    var transport = ViewBag.Transport as IEnumerable<TransportRoute> ?? Enumerable.Empty<TransportRoute>();
    var packages = ViewBag.Packages as IEnumerable<TourPackage> ?? Enumerable.Empty<TourPackage>();

    int total = ViewBag.TotalResults ?? 0;
    string keyword = ViewBag.Keyword as string ?? "";
    string category = ViewBag.Category as string ?? "all";
    decimal? budget = ViewBag.Budget as decimal?;
    string sort = ViewBag.Sort as string ?? "recommended";

    var destinationList = destinations.ToList();
    var hotelList = hotels.ToList();
    var restaurantList = restaurants.ToList();
    var resortList = resorts.ToList();
    var transportList = transport.ToList();
    var packageList = packages.ToList();

    var featuredDestination = destinationList.FirstOrDefault();
    var moreDestinations = destinationList.Skip(1).ToList();

    var featuredPackage = packageList.FirstOrDefault();
    var morePackages = packageList.Skip(1).ToList();

    string categoryLabel = "All categories";
    if (category == "destinations") { categoryLabel = "Tourist destinations"; }
    else if (category == "hotels") { categoryLabel = "Hotels"; }
    else if (category == "restaurants") { categoryLabel = "Restaurants"; }
    else if (category == "resorts") { categoryLabel = "Resorts"; }
    else if (category == "transport") { categoryLabel = "Transportation"; }
    else if (category == "packages") { categoryLabel = "Tour packages"; }

    string sortLabel = "Recommended";
    if (sort == "price-low") { sortLabel = "Price: Low to High"; }
    else if (sort == "price-high") { sortLabel = "Price: High to Low"; }

    bool hasKeyword = !string.IsNullOrWhiteSpace(keyword);
    bool hasBudget = budget.HasValue;
    bool hasCategory = category != "all";
    bool hasSort = sort != "recommended";
    bool hasFilters = hasKeyword || hasBudget || hasCategory || hasSort;

    var chips = new[]
    {
        new { Key = "all", Label = "All" },
        new { Key = "destinations", Label = "Destinations" },
        new { Key = "hotels", Label = "Hotels" },
        new { Key = "restaurants", Label = "Restaurants" },
        new { Key = "resorts", Label = "Resorts" },
        new { Key = "transport", Label = "Transport" },
        new { Key = "packages", Label = "Packages" }
    };
}

@section Styles {
    <style>
        @@import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;0,800;1,400;1,500;1,600&display=swap');

        :root {
            --ease-out: cubic-bezier(0.16, 1, 0.3, 1);
            --ease-spring: cubic-bezier(0.34, 1.56, 0.64, 1);
            --search-y: clamp(72px, 8.5vw, 124px);
            --card-radius: 20px;
            --card-radius-sm: 14px;
        }

        html { scroll-behavior: smooth; }
        ::selection { background: var(--forest); color: var(--ivory); }
        ::-webkit-scrollbar { width: 10px; }
        ::-webkit-scrollbar-track { background: var(--ivory); }
        ::-webkit-scrollbar-thumb {
            background: var(--moss);
            border-radius: 10px;
            border: 2px solid var(--ivory);
        }
        ::-webkit-scrollbar-thumb:hover { background: var(--forest); }

        .reveal-pending {
            opacity: 0;
            transform: translateY(36px);
            filter: blur(5px);
            transition:
                opacity 0.95s var(--ease-out),
                transform 0.95s var(--ease-out),
                filter 0.95s var(--ease-out);
        }
        .reveal-pending.is-revealed {
            opacity: 1 !important;
            transform: none !important;
            filter: blur(0) !important;
        }

        :focus-visible {
            outline: 2px solid var(--moss);
            outline-offset: 3px;
            border-radius: 4px;
        }

        /* ---------- Shared atoms ---------- */
        .eyebrow {
            display: inline-flex;
            align-items: center;
            gap: 12px;
            margin: 0 0 16px;
            font-family: var(--sans);
            font-size: 0.66rem;
            font-weight: 600;
            letter-spacing: 0.24em;
            text-transform: uppercase;
            color: var(--moss);
        }
        .eyebrow::before {
            content: '';
            width: 28px;
            height: 1px;
            background: currentColor;
            flex: 0 0 auto;
            opacity: 0.85;
        }

        .tag {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            font-size: 0.62rem;
            letter-spacing: 0.16em;
            text-transform: uppercase;
            color: var(--moss);
        }
        .tag::before {
            content: '';
            width: 5px;
            height: 5px;
            border-radius: 50%;
            background: var(--sage);
            flex: 0 0 auto;
        }
        .tag--light { color: var(--sand); }
        .tag--light::before { background: var(--sand); }

        .price {
            font-family: var(--serif);
            font-size: 1.12rem;
            line-height: 1.15;
            color: var(--forest-deep);
            letter-spacing: -0.01em;
        }
        .price small {
            display: block;
            margin-bottom: 3px;
            font-family: var(--sans);
            font-size: 0.58rem;
            font-weight: 400;
            letter-spacing: 0.16em;
            text-transform: uppercase;
            color: var(--muted);
        }
        .price--light { color: var(--ivory); }
        .price--light small { color: rgba(248, 246, 240, 0.62); }

        .media--fallback {
            display: grid;
            place-items: center;
            width: 100%;
            height: 100%;
            padding: 18px;
            border-radius: inherit;
            text-align: center;
            background:
                radial-gradient(ellipse 80% 80% at 20% 10%, rgba(143, 168, 136, 0.35), transparent 60%),
                linear-gradient(140deg, var(--forest) 0%, #1d3629 55%, var(--moss) 130%);
            color: rgba(248, 246, 240, 0.92);
            font-family: var(--serif);
            font-style: italic;
            font-size: 0.95rem;
            line-height: 1.35;
            position: relative;
            overflow: hidden;
        }
        .media--fallback::after {
            content: '';
            position: absolute;
            inset: 9px;
            border: 1px solid rgba(248, 246, 240, 0.14);
            border-radius: inherit;
            pointer-events: none;
        }

        /* ---------- Buttons & links ---------- */
        .btn {
            position: relative;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            min-height: 52px;
            padding: 0 26px;
            overflow: hidden;
            isolation: isolate;
            border: 1px solid transparent;
            border-radius: var(--radius);
            background: var(--forest);
            color: var(--ivory);
            font-family: var(--sans);
            font-size: 0.72rem;
            font-weight: 600;
            letter-spacing: 0.16em;
            text-transform: uppercase;
            text-decoration: none;
            cursor: pointer;
            transition:
                transform 0.5s var(--ease-out),
                box-shadow 0.5s var(--ease-out),
                background 0.4s var(--ease),
                color 0.4s var(--ease),
                border-color 0.4s var(--ease);
        }
        .btn::after {
            content: '';
            position: absolute;
            inset: 0;
            z-index: 1;
            background: linear-gradient(120deg, transparent 20%, rgba(255, 255, 255, 0.35) 50%, transparent 80%);
            transform: translateX(-120%);
            transition: transform 0.85s var(--ease-out);
            pointer-events: none;
        }
        .btn:hover {
            transform: translateY(-3px);
            box-shadow: 0 18px 32px -18px rgba(20, 39, 31, 0.55);
        }
        .btn:hover::after { transform: translateX(120%); }
        .btn:active { transform: translateY(-1px); }

        .btn--ghost-dark {
            background: transparent;
            color: var(--forest);
            border-color: rgba(20, 39, 31, 0.26);
        }
        .btn--ghost-dark:hover { border-color: var(--forest); }

        .link-arrow {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            padding-bottom: 3px;
            border-bottom: 1px solid transparent;
            font-size: 0.64rem;
            font-weight: 600;
            letter-spacing: 0.16em;
            text-transform: uppercase;
            color: var(--forest);
            text-decoration: none;
            transition: color 0.3s var(--ease), border-color 0.3s var(--ease);
        }
        .link-arrow::after {
            content: '\2192';
            font-size: 0.92rem;
            transition: transform 0.4s var(--ease-out);
        }
        .link-arrow:hover { color: var(--forest-deep); border-color: currentColor; }
        .link-arrow:hover::after { transform: translateX(4px); }

        .link-arrow--light { color: var(--sand); }
        .link-arrow--light:hover { color: #fff; border-color: currentColor; }

        /* ---------- Hero ---------- */
        .explore-hero {
            position: relative;
            display: flex;
            align-items: flex-end;
            min-height: clamp(440px, 58vh, 620px);
            padding: calc(var(--header-h) + clamp(48px, 7vw, 90px)) 0 clamp(120px, 13vw, 190px);
            overflow: hidden;
            color: var(--ivory);
            isolation: isolate;
            background: var(--forest-deep);
        }
        .explore-hero__media {
            position: absolute;
            inset: 0;
            z-index: -2;
            overflow: hidden;
        }
        .explore-hero__media img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transform: scale(1.08);
            will-change: transform;
        }
        .explore-hero::after {
            content: '';
            position: absolute;
            inset: 0;
            z-index: -1;
            background:
                linear-gradient(180deg, rgba(20, 39, 31, 0.42) 0%, rgba(20, 39, 31, 0.58) 48%, rgba(20, 39, 31, 0.9) 100%),
                radial-gradient(ellipse 60% 70% at 12% 25%, rgba(20, 39, 31, 0.08), transparent 65%);
        }
        .explore-hero__inner {
            position: relative;
            z-index: 1;
            max-width: 860px;
        }
        .explore-hero .eyebrow { color: var(--sage); }
        .explore-hero h1 {
            max-width: 17ch;
            margin: 0 0 20px;
            color: var(--ivory);
            font-size: clamp(2.5rem, 5.2vw, 4.4rem);
            line-height: 1;
            letter-spacing: -0.025em;
            text-wrap: balance;
        }
        .explore-hero h1 em { font-style: italic; color: var(--sand); }
        .explore-hero p {
            max-width: 54ch;
            margin: 0;
            color: rgba(248, 246, 240, 0.82);
            font-size: clamp(1rem, 1.2vw, 1.1rem);
            line-height: 1.7;
        }
        .explore-hero__context {
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            gap: 10px 22px;
            margin-top: 28px;
            padding-top: 20px;
            border-top: 1px solid rgba(248, 246, 240, 0.18);
            max-width: 620px;
        }
        .explore-hero__context span {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            font-size: 0.62rem;
            letter-spacing: 0.2em;
            text-transform: uppercase;
            color: rgba(248, 246, 240, 0.66);
        }
        .explore-hero__context span::before {
            content: '';
            width: 16px;
            height: 1px;
            background: currentColor;
            opacity: 0.7;
        }
        .explore-hero__cue {
            position: absolute;
            left: 50%;
            bottom: 26px;
            z-index: 2;
            transform: translateX(-50%);
            display: inline-flex;
            align-items: center;
            gap: 10px;
            font-size: 0.6rem;
            letter-spacing: 0.26em;
            text-transform: uppercase;
            color: rgba(248, 246, 240, 0.55);
            text-decoration: none;
            transition: color 0.3s var(--ease);
        }
        .explore-hero__cue::before {
            content: '';
            width: 30px;
            height: 1px;
            background: currentColor;
        }
        .explore-hero__cue:hover { color: var(--ivory); }

        .explore-hero__inner > * {
            opacity: 0;
            transform: translateY(28px);
            filter: blur(8px);
            animation: exploreIn 1.05s var(--ease-out) forwards;
        }
        .explore-hero__inner > *:nth-child(1) { animation-delay: 0.15s; }
        .explore-hero__inner > *:nth-child(2) { animation-delay: 0.33s; }
        .explore-hero__inner > *:nth-child(3) { animation-delay: 0.51s; }
        .explore-hero__inner > *:nth-child(4) { animation-delay: 0.69s; }

        @@keyframes exploreIn {
            to { opacity: 1; transform: none; filter: blur(0); }
        }

        /* ---------- Discovery controls ---------- */
        .controls-band {
            position: relative;
            z-index: 5;
            margin-top: clamp(-140px, -11vw, -84px);
            padding-bottom: clamp(24px, 4vw, 48px);
        }
        .discovery {
            position: relative;
            overflow: hidden;
            background: var(--ivory);
            border: 1px solid var(--line);
            border-radius: var(--radius-lg);
            box-shadow:
                0 50px 100px -44px rgba(20, 39, 31, 0.45),
                0 2px 4px rgba(20, 39, 31, 0.04),
                inset 0 1px 0 rgba(255, 255, 255, 0.85);
        }
        .discovery::before {
            content: '';
            position: absolute;
            top: 0; left: 0; right: 0;
            height: 2px;
            background: linear-gradient(90deg, transparent, var(--sage), var(--moss), var(--sage), transparent);
            pointer-events: none;
        }
        .discovery__head {
            display: flex;
            flex-wrap: wrap;
            align-items: flex-start;
            justify-content: space-between;
            gap: 16px;
            padding: clamp(22px, 3vw, 34px) clamp(22px, 3vw, 38px) 0;
        }
        .discovery__head h2 {
            margin: 0;
            font-size: clamp(1.3rem, 2vw, 1.7rem);
            line-height: 1.12;
            letter-spacing: -0.01em;
        }
        .discovery__hint {
            padding: 6px 13px;
            border-radius: 999px;
            background: var(--sand);
            color: var(--forest-deep);
            font-size: 0.6rem;
            letter-spacing: 0.16em;
            text-transform: uppercase;
            white-space: nowrap;
        }
        .discovery__cats {
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            gap: 12px 16px;
            padding: clamp(18px, 2.4vw, 26px) clamp(22px, 3vw, 38px) 0;
        }
        .discovery__cats-label {
            font-size: 0.62rem;
            letter-spacing: 0.2em;
            text-transform: uppercase;
            color: var(--muted);
        }
        .chip-row { display: flex; flex-wrap: wrap; gap: 8px; }
        .chip {
            display: inline-flex;
            align-items: center;
            min-height: 38px;
            padding: 0 15px;
            border: 1px solid var(--line);
            border-radius: 999px;
            background: var(--white);
            color: var(--muted);
            font-size: 0.62rem;
            font-weight: 600;
            letter-spacing: 0.14em;
            text-transform: uppercase;
            text-decoration: none;
            transition:
                color 0.3s var(--ease),
                border-color 0.3s var(--ease),
                background 0.3s var(--ease),
                transform 0.35s var(--ease-out);
        }
        .chip:hover { color: var(--forest); border-color: var(--moss); transform: translateY(-2px); }
        .chip.is-active { background: var(--forest); border-color: var(--forest); color: var(--ivory); }

        .discovery__fields {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 14px;
            padding: clamp(18px, 2.4vw, 26px) clamp(22px, 3vw, 38px) 0;
        }
        .field { display: flex; flex-direction: column; gap: 6px; }
        .field > span {
            font-size: 0.62rem;
            letter-spacing: 0.18em;
            text-transform: uppercase;
            color: var(--muted);
        }
        .field select,
        .field input {
            height: 52px;
            padding: 0 16px;
            border: 1px solid var(--line);
            border-radius: var(--radius);
            background: var(--white);
            color: var(--charcoal);
            font: inherit;
            font-size: 0.94rem;
            transition:
                border-color 0.3s var(--ease),
                box-shadow 0.3s var(--ease),
                background 0.3s var(--ease);
        }
        .field select:hover,
        .field input:hover { border-color: rgba(83, 107, 80, 0.4); }
        .field select:focus,
        .field input:focus {
            outline: none;
            border-color: var(--moss);
            background: #fff;
            box-shadow: 0 0 0 4px rgba(83, 107, 80, 0.14);
        }

        .discovery__foot {
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            justify-content: space-between;
            gap: 16px;
            margin-top: clamp(18px, 2.4vw, 26px);
            padding: clamp(18px, 2.4vw, 24px) clamp(22px, 3vw, 38px) clamp(22px, 3vw, 30px);
            border-top: 1px solid var(--line);
        }
        .discovery__note {
            max-width: 46ch;
            margin: 0;
            font-size: 0.74rem;
            line-height: 1.6;
            color: var(--muted);
        }
        .discovery__actions { display: flex; flex-wrap: wrap; gap: 10px; }

        /* ---------- Results shell ---------- */
        .results-section { padding: clamp(28px, 4vw, 52px) 0 var(--search-y); }
        .results-head {
            display: grid;
            grid-template-columns: minmax(0, 1fr) auto;
            gap: clamp(20px, 4vw, 56px);
            align-items: end;
            padding-bottom: clamp(20px, 2.6vw, 30px);
            border-bottom: 1px solid var(--line);
            margin-bottom: clamp(24px, 3vw, 36px);
        }
        .results-head__eyebrow {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            margin: 0 0 12px;
            font-size: 0.62rem;
            letter-spacing: 0.24em;
            text-transform: uppercase;
            color: var(--moss);
        }
        .results-head__eyebrow::before { content: ''; width: 24px; height: 1px; background: currentColor; }
        .results-head h2 {
            margin: 0;
            font-size: clamp(1.9rem, 3.4vw, 2.9rem);
            line-height: 1.05;
            letter-spacing: -0.02em;
            text-wrap: balance;
        }
        .results-head__context {
            margin: 12px 0 0;
            max-width: 58ch;
            color: var(--muted);
            font-size: 0.94rem;
            line-height: 1.65;
        }
        .results-count-block {
            display: flex;
            align-items: baseline;
            gap: 10px;
            padding-bottom: 6px;
        }
        .results-count-block strong {
            font-family: var(--serif);
            font-weight: 500;
            font-size: clamp(2rem, 3.6vw, 3rem);
            line-height: 0.9;
            color: var(--forest-deep);
            letter-spacing: -0.02em;
        }
        .results-count-block span {
            font-size: 0.62rem;
            letter-spacing: 0.2em;
            text-transform: uppercase;
            color: var(--muted);
        }

        .active-filters {
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            gap: 10px;
            margin-bottom: clamp(32px, 4vw, 52px);
        }
        .active-filters__label {
            font-size: 0.6rem;
            letter-spacing: 0.2em;
            text-transform: uppercase;
            color: var(--muted);
        }
        .filter-chip {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            padding: 7px 12px 7px 14px;
            border: 1px solid var(--line);
            border-radius: 999px;
            background: var(--white);
            color: var(--forest);
            font-size: 0.62rem;
            letter-spacing: 0.1em;
            text-decoration: none;
            transition: border-color 0.3s var(--ease), color 0.3s var(--ease), background 0.3s var(--ease);
        }
        .filter-chip::after {
            content: '\00D7';
            font-size: 0.9rem;
            line-height: 1;
            color: var(--muted);
            transition: color 0.3s var(--ease);
        }
        .filter-chip:hover { border-color: var(--moss); background: var(--ivory); }
        .filter-chip:hover::after { color: var(--forest); }

        /* ---------- Block headers ---------- */
        .result-block { margin-bottom: clamp(56px, 7vw, 96px); }
        .result-block:last-child { margin-bottom: 0; }
        .block-head {
            display: flex;
            flex-wrap: wrap;
            align-items: baseline;
            justify-content: space-between;
            gap: 14px 24px;
            padding-bottom: 16px;
            border-bottom: 1px solid var(--line);
            margin-bottom: clamp(22px, 3vw, 34px);
        }
        .block-head__title { display: flex; align-items: baseline; gap: 16px; }
        .block-num {
            font-family: var(--serif);
            font-style: italic;
            font-size: 0.95rem;
            letter-spacing: 0.06em;
            color: var(--sage);
        }
        .block-head h2 {
            margin: 0;
            font-size: clamp(1.4rem, 2.2vw, 1.85rem);
            letter-spacing: -0.015em;
            line-height: 1.1;
        }

        /* ============================================================
           A. DESTINATIONS — magazine feature + support stack
        ============================================================ */
        .dest-layout {
            display: grid;
            grid-template-columns: 1.4fr 1fr;
            gap: clamp(16px, 2.2vw, 26px);
            align-items: stretch;
        }
        .dest-feature {
            position: relative;
            grid-row: span 2;
            display: flex;
            align-items: flex-end;
            min-height: clamp(400px, 44vw, 600px);
            overflow: hidden;
            border-radius: var(--card-radius);
            color: var(--ivory);
            isolation: isolate;
            background: var(--forest);
        }
        .dest-layout > .dest-feature:only-child { grid-column: 1 / -1; }
        .dest-feature > img,
        .dest-feature > .media--fallback {
            position: absolute;
            inset: 0;
            z-index: -2;
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 1.1s var(--ease-out);
        }
        .dest-feature::after {
            content: '';
            position: absolute;
            inset: 0;
            z-index: -1;
            background: linear-gradient(180deg,
                rgba(20, 39, 31, 0.05) 0%,
                rgba(20, 39, 31, 0.22) 45%,
                rgba(20, 39, 31, 0.88) 100%);
            pointer-events: none;
        }
        .dest-feature:hover > img { transform: scale(1.05); }
        .dest-feature__body {
            max-width: 540px;
            padding: clamp(24px, 3.6vw, 44px);
        }
        .dest-feature__body h3 {
            margin: 12px 0 10px;
            color: var(--ivory);
            font-size: clamp(1.7rem, 3vw, 2.6rem);
            line-height: 1.04;
            letter-spacing: -0.02em;
        }
        .dest-feature__body p {
            margin: 0 0 18px;
            max-width: 44ch;
            color: rgba(248, 246, 240, 0.82);
            font-size: 0.95rem;
            line-height: 1.65;
        }

        .dest-support {
            position: relative;
            display: flex;
            flex-direction: column;
            overflow: hidden;
            background: var(--white);
            border: 1px solid var(--line);
            border-radius: var(--card-radius);
            transition:
                transform 0.5s var(--ease-out),
                box-shadow 0.5s var(--ease-out),
                border-color 0.4s var(--ease);
        }
        .dest-support:hover {
            transform: translateY(-4px);
            border-color: rgba(83, 107, 80, 0.25);
            box-shadow: 0 28px 54px -32px rgba(20, 39, 31, 0.38);
        }
        .dest-support__media {
            position: relative;
            aspect-ratio: 16 / 9;
            overflow: hidden;
            background: var(--sand);
        }
        .dest-support__media img,
        .dest-support__media .media--fallback {
            display: block;
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.95s var(--ease-out);
        }
        .dest-support:hover .dest-support__media img { transform: scale(1.06); }
        .dest-support__plate {
            position: absolute;
            top: 14px;
            left: 14px;
            padding: 6px 12px;
            border-radius: 999px;
            background: rgba(248, 246, 240, 0.94);
            color: var(--forest-deep);
            font-size: 0.58rem;
            font-weight: 600;
            letter-spacing: 0.16em;
            text-transform: uppercase;
            backdrop-filter: blur(6px);
        }
        .dest-support__body {
            display: flex;
            flex-direction: column;
            gap: 8px;
            flex: 1;
            padding: clamp(18px, 2.2vw, 22px);
        }
        .dest-support__body h3 {
            margin: 0;
            font-size: 1.14rem;
            letter-spacing: -0.01em;
            line-height: 1.2;
        }
        .dest-support__body p {
            margin: 0 0 14px;
            color: var(--muted);
            font-size: 0.87rem;
            line-height: 1.58;
            flex: 1;
        }

        /* ============================================================
           B. HOTELS — image-led rows w/ floating price badge
        ============================================================ */
        .hotel-list { margin: 0; padding: 0; list-style: none; }
        .hotel-row {
            display: grid;
            grid-template-columns: minmax(0, 320px) minmax(0, 1fr);
            gap: clamp(18px, 3vw, 38px);
            align-items: center;
            padding: clamp(20px, 2.8vw, 30px) 0;
            border-bottom: 1px solid var(--line);
        }
        .hotel-row:first-child { padding-top: 0; }
        .hotel-row:last-child { border-bottom: 0; padding-bottom: 0; }
        .hotel-row__media {
            position: relative;
            aspect-ratio: 4 / 3;
            overflow: hidden;
            border-radius: var(--card-radius);
            background: var(--sand);
            box-shadow: 0 20px 40px -30px rgba(20, 39, 31, 0.4);
        }
        .hotel-row__media img,
        .hotel-row__media .media--fallback {
            display: block;
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 1s var(--ease-out);
        }
        .hotel-row:hover .hotel-row__media img { transform: scale(1.05); }
        .hotel-row__badge {
            position: absolute;
            left: 14px;
            bottom: 14px;
            padding: 8px 14px;
            border-radius: 12px;
            background: rgba(20, 39, 31, 0.86);
            backdrop-filter: blur(8px);
            color: var(--ivory);
            font-family: var(--serif);
            font-size: 1rem;
            line-height: 1.1;
            box-shadow: 0 12px 24px -16px rgba(0, 0, 0, 0.5);
        }
        .hotel-row__badge small {
            display: block;
            font-family: var(--sans);
            font-size: 0.52rem;
            letter-spacing: 0.16em;
            text-transform: uppercase;
            color: rgba(248, 246, 240, 0.62);
            margin-bottom: 2px;
        }
        .hotel-row__body h3 {
            margin: 10px 0 8px;
            font-size: clamp(1.24rem, 1.9vw, 1.55rem);
            letter-spacing: -0.015em;
            line-height: 1.15;
        }
        .hotel-row__body p {
            margin: 0 0 16px;
            max-width: 62ch;
            color: var(--muted);
            font-size: 0.92rem;
            line-height: 1.62;
        }
        .amenity-row {
            display: flex;
            flex-wrap: wrap;
            gap: 6px;
            margin-bottom: 16px;
        }
        .amenity-row span {
            padding: 4px 10px;
            border: 1px solid var(--line);
            border-radius: 999px;
            background: var(--ivory);
            color: var(--muted);
            font-size: 0.56rem;
            letter-spacing: 0.12em;
            text-transform: uppercase;
        }
        .row-foot {
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            justify-content: space-between;
            gap: 14px;
            padding-top: 14px;
            border-top: 1px solid var(--line);
        }

        /* ============================================================
           C. RESTAURANTS — dining index cards
        ============================================================ */
        .dining-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 0 clamp(24px, 4vw, 56px);
            margin: 0;
            padding: 0;
            list-style: none;
        }
        .dining-item {
            display: grid;
            grid-template-columns: 96px minmax(0, 1fr);
            gap: clamp(14px, 2vw, 20px);
            padding: clamp(16px, 2.2vw, 22px) 0;
            border-bottom: 1px solid var(--line);
            transition: transform 0.4s var(--ease-out);
        }
        .dining-item:hover { transform: translateX(4px); }
        .dining-item__media {
            position: relative;
            width: 96px;
            height: 96px;
            overflow: hidden;
            border-radius: 50%;
            background: var(--sand);
            box-shadow: 0 12px 26px -18px rgba(20, 39, 31, 0.45);
            border: 2px solid var(--white);
            outline: 1px solid var(--line);
        }
        .dining-item__media img,
        .dining-item__media .media--fallback {
            display: block;
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.9s var(--ease-out);
        }
        .dining-item__media .media--fallback { font-size: 0.68rem; padding: 8px; }
        .dining-item:hover .dining-item__media img { transform: scale(1.1); }
        .dining-item__body h3 {
            margin: 8px 0 5px;
            font-size: 1.06rem;
            letter-spacing: -0.01em;
            line-height: 1.2;
        }
        .dining-item__body p {
            margin: 0 0 10px;
            color: var(--muted);
            font-size: 0.85rem;
            line-height: 1.55;
        }
        .dining-item__foot {
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            justify-content: space-between;
            gap: 10px;
        }
        .dining-item__price {
            display: inline-flex;
            align-items: baseline;
            gap: 6px;
            font-family: var(--serif);
            font-size: 1rem;
            color: var(--forest-deep);
        }
        .dining-item__price small {
            font-family: var(--sans);
            font-size: 0.56rem;
            letter-spacing: 0.14em;
            text-transform: uppercase;
            color: var(--muted);
        }

        /* ============================================================
           D. RESORTS — editorial cards (consistent w/ hotels & packages)
        ============================================================ */
        .resort-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr));
            gap: clamp(16px, 2.2vw, 26px);
        }
        .resort-card {
            position: relative;
            display: flex;
            flex-direction: column;
            overflow: hidden;
            background: var(--white);
            border: 1px solid var(--line);
            border-radius: var(--card-radius);
            transition:
                transform 0.5s var(--ease-out),
                box-shadow 0.5s var(--ease-out),
                border-color 0.4s var(--ease);
        }
        .resort-card:hover {
            transform: translateY(-5px);
            border-color: rgba(83, 107, 80, 0.25);
            box-shadow: 0 30px 60px -34px rgba(20, 39, 31, 0.42);
        }

        .resort-card__media {
            position: relative;
            aspect-ratio: 16 / 11;
            overflow: hidden;
            background: var(--sand);
        }
        .resort-card__media img,
        .resort-card__media .media--fallback {
            display: block;
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.95s var(--ease-out);
        }
        .resort-card:hover .resort-card__media img { transform: scale(1.06); }

        .resort-card__price {
            position: absolute;
            top: 14px;
            right: 14px;
            padding: 8px 13px;
            border-radius: 12px;
            background: rgba(248, 246, 240, 0.96);
            backdrop-filter: blur(8px);
            box-shadow: 0 12px 24px -16px rgba(0, 0, 0, 0.45);
            text-align: right;
            line-height: 1.1;
        }
        .resort-card__price small {
            display: block;
            margin-bottom: 2px;
            font-family: var(--sans);
            font-size: 0.5rem;
            font-weight: 600;
            letter-spacing: 0.16em;
            text-transform: uppercase;
            color: var(--muted);
        }
        .resort-card__price strong {
            font-family: var(--serif);
            font-weight: 500;
            font-size: 0.98rem;
            color: var(--forest-deep);
            letter-spacing: -0.01em;
        }

        .resort-card__body {
            display: flex;
            flex-direction: column;
            gap: 10px;
            flex: 1;
            padding: clamp(16px, 2.2vw, 22px);
        }
        .resort-card__location {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            font-size: 0.58rem;
            font-weight: 600;
            letter-spacing: 0.18em;
            text-transform: uppercase;
            color: var(--moss);
        }
        .resort-card__location::before {
            content: '';
            width: 6px;
            height: 6px;
            border-radius: 50%;
            background: var(--sage);
            box-shadow: 0 0 0 3px rgba(143, 168, 136, 0.2);
            flex: 0 0 auto;
        }
        .resort-card__body h3 {
            margin: 0;
            font-size: 1.14rem;
            letter-spacing: -0.01em;
            line-height: 1.2;
            color: var(--charcoal);
        }
        .resort-card__body p {
            margin: 0;
            color: var(--muted);
            font-size: 0.87rem;
            line-height: 1.58;
            flex: 1;
        }

        .resort-card__foot {
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            margin-top: 6px;
            padding-top: 14px;
            border-top: 1px solid var(--line);
        }

        /* ============================================================
           E. TRANSPORT — route ticket cards
        ============================================================ */
        .route-list { margin: 0; padding: 0; list-style: none; display: grid; gap: clamp(14px, 2vw, 20px); }
        .route-row {
            position: relative;
            display: grid;
            grid-template-columns: 148px minmax(0, 1fr) auto;
            gap: clamp(18px, 3vw, 34px);
            align-items: center;
            padding: clamp(16px, 2.2vw, 22px);
            border: 1px solid var(--line);
            border-radius: var(--card-radius);
            background: var(--white);
            transition:
                border-color 0.4s var(--ease),
                box-shadow 0.5s var(--ease-out),
                transform 0.4s var(--ease-out);
        }
        .route-row:hover {
            border-color: rgba(83, 107, 80, 0.28);
            box-shadow: 0 26px 50px -34px rgba(20, 39, 31, 0.35);
            transform: translateY(-2px);
        }
        .route-row__media {
            aspect-ratio: 4 / 3;
            overflow: hidden;
            border-radius: var(--card-radius-sm);
            background: var(--sand);
        }
        .route-row__media img,
        .route-row__media .media--fallback {
            display: block;
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.9s var(--ease-out);
        }
        .route-row:hover .route-row__media img { transform: scale(1.07); }

        .route-line {
            display: flex;
            align-items: center;
            gap: 12px;
            font-size: 0.62rem;
            letter-spacing: 0.16em;
            text-transform: uppercase;
            color: var(--moss);
        }
        .route-line__track {
            position: relative;
            flex: 1;
            min-width: 40px;
            max-width: 180px;
            height: 1px;
            background: var(--line);
        }
        .route-line__track::before,
        .route-line__track::after {
            content: '';
            position: absolute;
            top: 50%;
            width: 7px;
            height: 7px;
            border-radius: 50%;
            background: var(--sage);
            transform: translateY(-50%);
            box-shadow: 0 0 0 3px var(--white);
        }
        .route-line__track::before { left: -1px; }
        .route-line__track::after { right: -1px; }
        .route-line__track i {
            position: absolute;
            top: -2px;
            left: 0;
            width: 16px;
            height: 5px;
            background: var(--forest);
            border-radius: 3px;
            transition: left 0.7s var(--ease-out);
        }
        .route-row:hover .route-line__track i { left: calc(100% - 16px); }

        .route-row__body h3 {
            margin: 12px 0 8px;
            font-size: clamp(1.1rem, 1.6vw, 1.3rem);
            letter-spacing: -0.01em;
            line-height: 1.2;
        }
        .route-row__body p {
            margin: 0;
            max-width: 64ch;
            color: var(--muted);
            font-size: 0.89rem;
            line-height: 1.6;
        }
        .route-row__aside {
            display: flex;
            flex-direction: column;
            align-items: flex-end;
            gap: 12px;
            text-align: right;
            min-width: 150px;
        }

        /* ============================================================
           F. PACKAGES — feature spread + supporting grid
        ============================================================ */
        .package-feature {
            display: grid;
            grid-template-columns: 1.05fr 0.95fr;
            overflow: hidden;
            background: var(--white);
            border: 1px solid var(--line);
            border-radius: var(--card-radius);
            margin-bottom: clamp(18px, 2.4vw, 28px);
            transition: border-color 0.4s var(--ease), box-shadow 0.5s var(--ease-out);
        }
        .package-feature:hover {
            border-color: rgba(83, 107, 80, 0.25);
            box-shadow: 0 32px 66px -38px rgba(20, 39, 31, 0.42);
        }
        .package-feature__media {
            position: relative;
            min-height: clamp(300px, 34vw, 440px);
            overflow: hidden;
            background: var(--sand);
        }
        .package-feature__media img,
        .package-feature__media .media--fallback {
            display: block;
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 1.1s var(--ease-out);
        }
        .package-feature:hover .package-feature__media img { transform: scale(1.04); }
        .package-feature__media .feature-ribbon {
            position: absolute;
            top: 18px;
            left: 18px;
            padding: 7px 14px;
            border-radius: 999px;
            background: rgba(248, 246, 240, 0.94);
            color: var(--forest-deep);
            font-size: 0.56rem;
            font-weight: 600;
            letter-spacing: 0.18em;
            text-transform: uppercase;
        }
        .package-feature__body {
            display: flex;
            flex-direction: column;
            gap: 14px;
            padding: clamp(24px, 3.4vw, 44px);
        }
        .package-feature__body h3 {
            margin: 0;
            font-size: clamp(1.6rem, 2.6vw, 2.3rem);
            line-height: 1.06;
            letter-spacing: -0.02em;
        }
        .package-feature__body p {
            margin: 0;
            color: var(--muted);
            font-size: 0.94rem;
            line-height: 1.65;
        }
        .meta-row { display: flex; flex-wrap: wrap; gap: 8px; }
        .meta-row span {
            padding: 5px 11px;
            border: 1px solid var(--line);
            border-radius: 999px;
            background: var(--ivory);
            color: var(--muted);
            font-size: 0.6rem;
            letter-spacing: 0.12em;
            text-transform: uppercase;
        }
        .package-feature__foot {
            display: flex;
            flex-wrap: wrap;
            align-items: end;
            justify-content: space-between;
            gap: 16px;
            margin-top: auto;
            padding-top: 18px;
            border-top: 1px solid var(--line);
        }

        .package-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr));
            gap: clamp(16px, 2.2vw, 24px);
        }
        .package-card {
            position: relative;
            display: flex;
            flex-direction: column;
            overflow: hidden;
            background: var(--white);
            border: 1px solid var(--line);
            border-radius: var(--card-radius);
            transition:
                transform 0.5s var(--ease-out),
                box-shadow 0.5s var(--ease-out),
                border-color 0.4s var(--ease);
        }
        .package-card:hover {
            transform: translateY(-5px);
            border-color: rgba(83, 107, 80, 0.25);
            box-shadow: 0 28px 54px -32px rgba(20, 39, 31, 0.38);
        }
        .package-card__media {
            position: relative;
            aspect-ratio: 16 / 10;
            overflow: hidden;
            background: var(--sand);
        }
        .package-card__media img,
        .package-card__media .media--fallback {
            display: block;
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.95s var(--ease-out);
        }
        .package-card:hover .package-card__media img { transform: scale(1.06); }
        .package-card__duration {
            position: absolute;
            top: 12px;
            right: 12px;
            padding: 5px 11px;
            border-radius: 999px;
            background: rgba(20, 39, 31, 0.8);
            backdrop-filter: blur(6px);
            color: var(--ivory);
            font-size: 0.55rem;
            letter-spacing: 0.14em;
            text-transform: uppercase;
        }
        .package-card__body {
            display: flex;
            flex-direction: column;
            gap: 10px;
            flex: 1;
            padding: clamp(18px, 2.2vw, 22px);
        }
        .package-card__body h3 {
            margin: 0;
            font-size: 1.1rem;
            letter-spacing: -0.01em;
            line-height: 1.25;
        }
        .package-card__body p {
            margin: 0;
            color: var(--muted);
            font-size: 0.86rem;
            line-height: 1.58;
            flex: 1;
        }
        .package-card__foot {
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            justify-content: space-between;
            gap: 10px;
            margin-top: 6px;
            padding-top: 14px;
            border-top: 1px solid var(--line);
        }

        /* ---------- Empty state ---------- */
        .empty-state {
            position: relative;
            overflow: hidden;
            padding: clamp(56px, 8vw, 96px) clamp(24px, 4vw, 56px);
            border: 1px solid var(--line);
            border-radius: var(--radius-lg);
            background: var(--white);
            text-align: center;
        }
        .empty-state::before {
            content: '';
            position: absolute;
            inset: 0;
            background:
                radial-gradient(ellipse 60% 60% at 50% 0%, rgba(143, 168, 136, 0.14), transparent 70%),
                radial-gradient(ellipse 50% 50% at 50% 100%, rgba(232, 223, 201, 0.4), transparent 70%);
            pointer-events: none;
        }
        .empty-state > * { position: relative; z-index: 1; }
        .empty-state h2 {
            margin: 0 0 14px;
            font-size: clamp(1.8rem, 3vw, 2.5rem);
            line-height: 1.08;
            letter-spacing: -0.02em;
        }
        .empty-state p {
            max-width: 50ch;
            margin: 0 auto;
            color: var(--muted);
            line-height: 1.7;
        }
        .empty-state__actions {
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
            gap: 12px;
            margin-top: 28px;
        }
        .empty-state__suggestions {
            margin-top: clamp(32px, 4vw, 48px);
            padding-top: 26px;
            border-top: 1px solid var(--line);
        }
        .empty-state__suggestions > span {
            display: block;
            margin-bottom: 14px;
            font-size: 0.6rem;
            letter-spacing: 0.22em;
            text-transform: uppercase;
            color: var(--muted);
        }
        .empty-state__suggestions .chip-row { justify-content: center; }

        /* ---------- Responsive ---------- */
        @@media (max-width: 1024px) {
            .dest-layout { grid-template-columns: 1fr; }
            .dest-feature { grid-row: auto; min-height: clamp(360px, 52vw, 480px); }
            .package-feature { grid-template-columns: 1fr; }
            .package-feature__media { min-height: clamp(260px, 42vw, 340px); }
            .route-row { grid-template-columns: 120px minmax(0, 1fr); }
            .route-row__aside {
                grid-column: 1 / -1;
                flex-direction: row;
                align-items: center;
                justify-content: space-between;
                text-align: left;
                padding-top: 14px;
                border-top: 1px solid var(--line);
            }
        }

        @@media (max-width: 900px) {
            .results-head { grid-template-columns: 1fr; align-items: start; }
            .results-count-block { padding-bottom: 0; }
            .dining-grid { grid-template-columns: 1fr; }
            .hotel-row { grid-template-columns: minmax(0, 260px) minmax(0, 1fr); }
        }

        @@media (max-width: 760px) {
            .discovery__fields { grid-template-columns: 1fr; }
            .discovery__foot { flex-direction: column; align-items: stretch; }
            .discovery__actions .btn { flex: 1; }
            .hotel-row { grid-template-columns: 1fr; }
            .hotel-row__media { aspect-ratio: 16 / 9; max-width: 100%; }
            .route-row { grid-template-columns: 1fr; }
            .route-row__media { aspect-ratio: 16 / 9; }
            .route-row__aside { flex-direction: column; align-items: flex-start; }
            .row-foot { align-items: flex-start; }
            .explore-hero__cue { display: none; }
        }

        @@media (max-width: 600px) {
            .explore-hero { min-height: 0; padding-bottom: clamp(140px, 34vw, 180px); }
            .explore-hero h1 { max-width: none; }
            .controls-band { margin-top: -100px; }
            .dining-item { grid-template-columns: 76px minmax(0, 1fr); }
            .dining-item__media { width: 76px; height: 76px; }
            .resort-grid { grid-template-columns: 1fr; }
            .discovery__actions { flex-direction: column; }
            .discovery__actions .btn { width: 100%; }
            .results-count-block strong { font-size: 2rem; }
            .empty-state__actions { flex-direction: column; }
            .empty-state__actions .btn { width: 100%; }
        }

        @@media (prefers-reduced-motion: reduce) {
            html { scroll-behavior: auto; }
            .explore-hero__inner > * {
                opacity: 1 !important;
                transform: none !important;
                filter: none !important;
                animation: none !important;
            }
            .reveal-pending {
                opacity: 1 !important;
                transform: none !important;
                filter: none !important;
                transition: none !important;
            }
            .btn,
            .chip,
            .dest-feature > img,
            .dest-support,
            .dest-support__media img,
            .hotel-row__media img,
            .dining-item__media img,
            .dining-item,
            .resort-card,
            .resort-card__media img,
            .route-row,
            .route-row__media img,
            .route-line__track i,
            .package-card,
            .package-card__media img,
            .filter-chip {
                transition: none !important;
            }
            .btn:hover,
            .chip:hover,
            .dest-support:hover,
            .resort-card:hover,
            .package-card:hover,
            .route-row:hover,
            .dining-item:hover,
            .filter-chip:hover {
                transform: none !important;
            }
            .route-row:hover .route-line__track i { left: 0; }
        }
    </style>
}

<!-- ==================== SECTION 01 — IMMERSIVE SEARCH INTRODUCTION ==================== -->
<header class="explore-hero">
    <div class="explore-hero__media">
        <img src="https://images.unsplash.com/photo-1506905925346-21bda4d32df4?auto=format&fit=crop&w=1920&q=80"
             alt="Mountain landscape across northern Pakistan"
             fetchpriority="high" decoding="async" />
    </div>

    <div class="container explore-hero__inner">
        <p class="eyebrow">Explore Pakistan</p>
        <h1>Find your next <em>destination.</em></h1>
        <p>
            Discover destinations, accommodation, restaurants, resorts, transport and
            travel packages — gathered into one considered guide.
        </p>
        <div class="explore-hero__context">
            <span>@categoryLabel</span>
            @if (hasKeyword)
            {
                <span>Searching &ldquo;@keyword&rdquo;</span>
            }
            @if (hasBudget)
            {
                <span>Up to PKR @budget.Value.ToString("N0")</span>
            }
            <span>@total listing(s)</span>
        </div>
    </div>

    <a class="explore-hero__cue" href="#discovery">Refine your search</a>
</header>

<!-- ==================== SECTION 02 — ADVANCED DISCOVERY CONTROLS ==================== -->
<section class="controls-band" id="discovery">
    <div class="container">
        <form class="discovery" method="get" action="@Url.Action("Index", "Search")" novalidate>

            <input type="hidden" name="keyword" value="@keyword" />
            <input type="hidden" name="category" value="@category" />

            <div class="discovery__head">
                <div>
                    <p class="eyebrow">Advanced Discovery</p>
                    <h2>Refine your search</h2>
                </div>
                <span class="discovery__hint">@total result(s)</span>
            </div>

            <div class="discovery__cats">
                <span class="discovery__cats-label">Category</span>
                <nav class="chip-row" aria-label="Filter by category">
                    @foreach (var chip in chips)
                    {
                        var isActive = category == chip.Key;
                        <a class="chip @(isActive ? "is-active" : null)"
                           href="@Url.Action("Index", "Search", new { sort = sort, category = chip.Key, budget = budget, keyword = keyword })"
                           aria-current="@(isActive ? "true" : null)">@chip.Label</a>
                    }
                </nav>
            </div>

            <div class="discovery__fields">
                <label class="field">
                    <span>Sort results</span>
                    <select name="sort">
                        <option value="recommended" selected="@(sort == "recommended")">Recommended</option>
                        <option value="price-low" selected="@(sort == "price-low")">Price: Low to High</option>
                        <option value="price-high" selected="@(sort == "price-high")">Price: High to Low</option>
                    </select>
                </label>

                <label class="field">
                    <span>Maximum budget (PKR)</span>
                    <input type="number"
                           name="budget"
                           min="0"
                           step="1000"
                           value="@(budget?.ToString())"
                           placeholder="Any budget" />
                </label>
            </div>

            <div class="discovery__foot">
                <p class="discovery__note">
                    Filters update the same result set — category, budget and sorting are
                    applied together. Prices shown are indicative where provided by the
                    listing.
                </p>
                <div class="discovery__actions">
                    <a class="btn btn--ghost-dark" href="@Url.Action("Index", "Search")">Clear filters</a>
                    <button class="btn" type="submit">Update search</button>
                </div>
            </div>
        </form>
    </div>
</section>

<!-- ==================== SECTION 03 & 04 — RESULTS ==================== -->
<section class="results-section" aria-labelledby="results-title">
    <div class="container">

        @if (total == 0)
        {
            <div class="empty-state" data-reveal>
                <p class="eyebrow" style="justify-content:center;">Nothing here yet</p>
                <h2>No journeys found</h2>
                <p>
                    No published listings matched this combination of filters. Try a broader
                    budget, a different category, or clear your filters to see everything the
                    guide currently holds.
                </p>
                <div class="empty-state__actions">
                    <a class="btn" href="@Url.Action("Index", "Search")">Clear filters</a>
                    <a class="btn btn--ghost-dark" href="@Url.Action("Index", "Destinations")">Explore destinations</a>
                </div>
                <div class="empty-state__suggestions">
                    <span>Or start somewhere else</span>
                    <div class="chip-row">
                        <a class="chip" href="@Url.Action("Index", "Search", new { category = "destinations" })">Destinations</a>
                        <a class="chip" href="@Url.Action("Index", "Search", new { category = "hotels" })">Hotels</a>
                        <a class="chip" href="@Url.Action("Index", "Search", new { category = "restaurants" })">Restaurants</a>
                        <a class="chip" href="@Url.Action("Index", "Search", new { category = "resorts" })">Resorts</a>
                        <a class="chip" href="@Url.Action("Index", "Search", new { category = "transport" })">Transport</a>
                        <a class="chip" href="@Url.Action("Index", "Search", new { category = "packages" })">Packages</a>
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="results-head" data-reveal>
                <div>
                    <p class="results-head__eyebrow">
                        @(hasKeyword ? "Search results" : "Discover")
                    </p>
                    <h2 id="results-title">
                        @if (hasKeyword)
                        {
                            <text>Results for &ldquo;@keyword&rdquo;</text>
                        }
                        else if (hasCategory)
                        {
                            @categoryLabel
                        }
                        else
                        {
                            <text>Every listing, in one place.</text>
                        }
                    </h2>
                    <p class="results-head__context">
                        Across destinations, hotels, restaurants, resorts, transport and
                        packages.
                        @if (hasBudget)
                        {
                            <text> Limited to listings up to PKR @budget.Value.ToString("N0").</text>
                        }
                        @if (hasSort)
                        {
                            <text> Sorted by @sortLabel.ToLowerInvariant().</text>
                        }
                    </p>
                </div>
                <div class="results-count-block">
                    <strong>@total</strong>
                    <span>listing(s)</span>
                </div>
            </div>

            @if (hasFilters)
            {
                <div class="active-filters" data-reveal>
                    <span class="active-filters__label">Active filters</span>

                    @if (hasCategory)
                    {
                        <a class="filter-chip"
                           href="@Url.Action("Index", "Search", new { sort = sort, budget = budget, keyword = keyword })"
                           aria-label="Remove category filter">
                            @categoryLabel
                        </a>
                    }

                    @if (hasBudget)
                    {
                        <a class="filter-chip"
                           href="@Url.Action("Index", "Search", new { sort = sort, category = category, keyword = keyword })"
                           aria-label="Remove budget filter">
                            Up to PKR @budget.Value.ToString("N0")
                        </a>
                    }

                    @if (hasKeyword)
                    {
                        <a class="filter-chip"
                           href="@Url.Action("Index", "Search", new { sort = sort, category = category, budget = budget })"
                           aria-label="Remove keyword filter">
                            &ldquo;@keyword&rdquo;
                        </a>
                    }

                    @if (hasSort)
                    {
                        <a class="filter-chip"
                           href="@Url.Action("Index", "Search", new { sort = "recommended", category = category, budget = budget, keyword = keyword })"
                           aria-label="Reset sorting">
                            @sortLabel
                        </a>
                    }
                </div>
            }

            <div class="results-stack">

                @* ---------- A. TOURIST DESTINATIONS ---------- *@
                @if (destinationList.Any())
                {
                    <section class="result-block" aria-labelledby="block-destinations" data-reveal>
                        <div class="block-head">
                            <div class="block-head__title">
                                <span class="block-num">01</span>
                                <h2 id="block-destinations">Tourist destinations</h2>
                            </div>
                            <a class="link-arrow" href="@Url.Action("Index", "Destinations")">All destinations</a>
                        </div>

                        <div class="dest-layout" data-reveal-group>
                            @if (featuredDestination != null)
                            {
                                <article class="dest-feature">
                                    @if (!string.IsNullOrWhiteSpace(featuredDestination.ImageUrl))
                                    {
                                        <img src="@featuredDestination.ImageUrl"
                                             alt="@featuredDestination.Name"
                                             loading="lazy" decoding="async" />
                                    }
                                    else
                                    {
                                        <div class="media--fallback" aria-hidden="true">
                                            <span>@featuredDestination.Name</span>
                                        </div>
                                    }
                                    <div class="dest-feature__body">
                                        <span class="tag tag--light">@featuredDestination.Region</span>
                                        <h3>@featuredDestination.Name</h3>
                                        <p>@featuredDestination.ShortDescription</p>
                                        <a class="link-arrow link-arrow--light"
                                           href="@Url.Action("Index", "Destinations")">Explore</a>
                                    </div>
                                </article>
                            }

                            @foreach (var item in moreDestinations)
                            {
                                <article class="dest-support">
                                    <div class="dest-support__media">
                                        @if (!string.IsNullOrWhiteSpace(item.ImageUrl))
                                        {
                                            <img src="@item.ImageUrl"
                                                 alt="@item.Name"
                                                 loading="lazy" decoding="async" />
                                        }
                                        else
                                        {
                                            <div class="media--fallback" aria-hidden="true">
                                                <span>@item.Name</span>
                                            </div>
                                        }
                                        <span class="dest-support__plate">@item.Region</span>
                                    </div>
                                    <div class="dest-support__body">
                                        <h3>@item.Name</h3>
                                        <p>@item.ShortDescription</p>
                                        <a class="link-arrow"
                                           href="@Url.Action("Index", "Destinations")">Explore</a>
                                    </div>
                                </article>
                            }
                        </div>
                    </section>
                }

                @* ---------- B. HOTELS ---------- *@
                @if (hotelList.Any())
                {
                    <section class="result-block" aria-labelledby="block-hotels" data-reveal>
                        <div class="block-head">
                            <div class="block-head__title">
                                <span class="block-num">02</span>
                                <h2 id="block-hotels">Hotels</h2>
                            </div>
                            <a class="link-arrow" href="@Url.Action("Index", "Hotels")">All hotels</a>
                        </div>

                        <ul class="hotel-list" data-reveal-group>
                            @foreach (var item in hotelList)
                            {
                                <li class="hotel-row">
                                    <div class="hotel-row__media">
                                        @if (!string.IsNullOrWhiteSpace(item.ImageUrl))
                                        {
                                            <img src="@item.ImageUrl"
                                                 alt="@item.Name"
                                                 loading="lazy" decoding="async" />
                                        }
                                        else
                                        {
                                            <div class="media--fallback" aria-hidden="true">
                                                <span>@item.Name</span>
                                            </div>
                                        }
                                        <span class="hotel-row__badge">
                                            <small>Per night</small>
                                            @(item.StartingPricePerNight.HasValue
                                                ? $"PKR {item.StartingPricePerNight.Value:N0}"
                                                : "On request")
                                        </span>
                                    </div>
                                    <div class="hotel-row__body">
                                        <span class="tag">@item.City · Hotel</span>
                                        <h3>@item.Name</h3>
                                        <p>@item.ShortDescription</p>
                                        <div class="amenity-row">
                                            <span>Free Wi-Fi</span>
                                            <span>Breakfast</span>
                                            <span>City access</span>
                                        </div>
                                        <div class="row-foot">
                                            <span class="price">
                                                <small>Starting from</small>
                                                @(item.StartingPricePerNight.HasValue
                                                    ? $"PKR {item.StartingPricePerNight.Value:N0}"
                                                    : "Price on request")
                                            </span>
                                            <a class="link-arrow"
                                               href="@Url.Action("Index", "Hotels")">View hotel</a>
                                        </div>
                                    </div>
                                </li>
                            }
                        </ul>
                    </section>
                }

                @* ---------- C. RESTAURANTS ---------- *@
                @if (restaurantList.Any())
                {
                    <section class="result-block" aria-labelledby="block-restaurants" data-reveal>
                        <div class="block-head">
                            <div class="block-head__title">
                                <span class="block-num">03</span>
                                <h2 id="block-restaurants">Restaurants</h2>
                            </div>
                            <a class="link-arrow" href="@Url.Action("Index", "Restaurants")">All restaurants</a>
                        </div>

                        <ul class="dining-grid" data-reveal-group>
                            @foreach (var item in restaurantList)
                            {
                                <li class="dining-item">
                                    <div class="dining-item__media">
                                        @if (!string.IsNullOrWhiteSpace(item.ImageUrl))
                                        {
                                            <img src="@item.ImageUrl"
                                                 alt="@item.Name"
                                                 loading="lazy" decoding="async" />
                                        }
                                        else
                                        {
                                            <div class="media--fallback" aria-hidden="true">
                                                <span>@item.City</span>
                                            </div>
                                        }
                                    </div>
                                    <div class="dining-item__body">
                                        <span class="tag">@item.City</span>
                                        <h3>@item.Name</h3>
                                        <p>@item.ShortDescription</p>
                                        <div class="dining-item__foot">
                                            <span class="dining-item__price">
                                                @(item.AverageMealPrice.HasValue
                                                    ? $"PKR {item.AverageMealPrice.Value:N0}"
                                                    : "On request")
                                                <small>Avg. meal</small>
                                            </span>
                                            <a class="link-arrow"
                                               href="@Url.Action("Index", "Restaurants")">View</a>
                                        </div>
                                    </div>
                                </li>
                            }
                        </ul>
                    </section>
                }

                @* ---------- D. RESORTS ---------- *@
                @if (resortList.Any())
                {
                    <section class="result-block" aria-labelledby="block-resorts" data-reveal>
                        <div class="block-head">
                            <div class="block-head__title">
                                <span class="block-num">04</span>
                                <h2 id="block-resorts">Resorts</h2>
                            </div>
                            <a class="link-arrow" href="@Url.Action("Index", "Resorts")">All resorts</a>
                        </div>

                        <div class="resort-grid" data-reveal-group>
                            @foreach (var item in resortList)
                            {
                                <article class="resort-card">
                                    <div class="resort-card__media">
                                        @if (!string.IsNullOrWhiteSpace(item.ImageUrl))
                                        {
                                            <img src="@item.ImageUrl"
                                                 alt="@item.Name"
                                                 loading="lazy" decoding="async" />
                                        }
                                        else
                                        {
                                            <div class="media--fallback" aria-hidden="true">
                                                <span>@item.Name</span>
                                            </div>
                                        }
                                        <div class="resort-card__price">
                                            <small>Per night</small>
                                            <strong>
                                                @(item.StartingPricePerNight.HasValue
                                                    ? $"PKR {item.StartingPricePerNight.Value:N0}"
                                                    : "On request")
                                            </strong>
                                        </div>
                                    </div>

                                    <div class="resort-card__body">
                                        <span class="resort-card__location">@item.CityOrRegion</span>
                                        <h3>@item.Name</h3>
                                        <p>@item.ShortDescription</p>

                                        <div class="resort-card__foot">
                                            <span class="price">
                                                <small>From</small>
                                                @(item.StartingPricePerNight.HasValue
                                                    ? $"PKR {item.StartingPricePerNight.Value:N0}"
                                                    : "Price on request")
                                            </span>
                                            <a class="link-arrow"
                                               href="@Url.Action("Index", "Resorts")">View resort</a>
                                        </div>
                                    </div>
                                </article>
                            }
                        </div>
                    </section>
                }

                @* ---------- E. TRANSPORT ---------- *@
                @if (transportList.Any())
                {
                    <section class="result-block" aria-labelledby="block-transport" data-reveal>
                        <div class="block-head">
                            <div class="block-head__title">
                                <span class="block-num">05</span>
                                <h2 id="block-transport">Transportation</h2>
                            </div>
                            <a class="link-arrow" href="@Url.Action("Index", "Transport")">All transport</a>
                        </div>

                        <ul class="route-list" data-reveal-group>
                            @foreach (var item in transportList)
                            {
                                <li class="route-row">
                                    <div class="route-row__media">
                                        <div class="media--fallback" aria-hidden="true">
                                            <span>@item.Name</span>
                                        </div>
                                    </div>
                                    <div class="route-row__body">
                                        <div class="route-line">
                                            <span>@item.StartingCity</span>
                                            <span class="route-line__track" aria-hidden="true"><i></i></span>
                                            <span>@item.DestinationCity</span>
