                                        <h3>@item.Name</h3>
                                        <p>@item.Description</p>
                                    </div>
                                    <div class="route-row__aside">
                                        <span class="price">
                                            <small>Starting price</small>
                                            PKR @item.StartingPricePKR.ToString("N0")
