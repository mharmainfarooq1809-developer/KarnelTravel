                    </section>
                }

                @* ---------- F. TOUR PACKAGES ---------- *@
                @if (packageList.Any())
                {
                    <section class="result-block" aria-labelledby="block-packages" data-reveal>
                        <div class="block-head">
                            <div class="block-head__title">
                                <span class="block-num">06</span>
                                <h2 id="block-packages">Tour packages</h2>
                            </div>
                            <a class="link-arrow" href="@Url.Action("Index", "Tours")">All packages</a>
                        </div>

                        @if (featuredPackage != null)
                        {
                            <article class="package-feature">
                                <div class="package-feature__media">
                                    @if (!string.IsNullOrWhiteSpace(featuredPackage.ImageUrl))
                                    {
                                        <img src="@featuredPackage.ImageUrl"
                                             alt="@featuredPackage.Name"
                                             loading="lazy" decoding="async" />
                                    }
                                    else
                                    {
                                        <div class="media--fallback" aria-hidden="true">
                                            <span>@featuredPackage.Name</span>
                                        </div>
                                    }
                                    <span class="feature-ribbon">Featured package</span>
                                </div>
                                <div class="package-feature__body">
                                    <span class="tag">Curated journey</span>
                                    <h3>@featuredPackage.Name</h3>
                                    <div class="meta-row">
                                        <span>@featuredPackage.DestinationName</span>
                                        <span>@featuredPackage.DurationDays day(s)</span>
                                    </div>
                                    <p>@featuredPackage.ShortDescription</p>
                                    <div class="package-feature__foot">
                                        <span class="price">
                                            <small>Per adult</small>
                                            @(featuredPackage.PricePerAdult.HasValue
                                                ? $"PKR {featuredPackage.PricePerAdult.Value:N0}"
                                                : "Price on request")
                                        </span>
                                        <a class="link-arrow"
                                           href="@Url.Action("Index", "Tours")">View package</a>
                                    </div>
                                </div>
                            </article>
                        }

                        @if (morePackages.Any())
                        {
                            <div class="package-grid" data-reveal-group>
                                @foreach (var item in morePackages)
                                {
                                    <article class="package-card">
                                        <div class="package-card__media">
                                            @if (!string.IsNullOrWhiteSpace(item.ImageUrl))
                                            {
                                                <img src="@item.ImageUrl"
                                                     alt="@item.Name"
                                                     loading="lazy" decoding="async" />
                                            }
                                            else
                                            {
                                                <div class="media--fallback" aria-hidden="true">
                                                    <span>@item.DestinationName</span>
                                                </div>
                                            }
                                            <span class="package-card__duration">@item.DurationDays day(s)</span>
                                        </div>
                                        <div class="package-card__body">
                                            <span class="tag">@item.DestinationName</span>
                                            <h3>@item.Name</h3>
                                            <p>@item.ShortDescription</p>
                                            <div class="package-card__foot">
                                                <span class="price">
                                                    <small>Per adult</small>
                                                    @(item.PricePerAdult.HasValue
                                                        ? $"PKR {item.PricePerAdult.Value:N0}"
                                                        : "Price on request")
                                                </span>
                                                <a class="link-arrow"
                                                   href="@Url.Action("Index", "Tours")">View</a>
                                            </div>
                                        </div>
                                    </article>
                                }
                            </div>
                        }
                    </section>
                }

            </div>
        }

    </div>
</section>

@section Scripts {
    <script>
        (function () {
            'use strict';

            var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
            if (reduceMotion) return;

            var observer = new IntersectionObserver(function (entries) {
                entries.forEach(function (entry) {
                    if (!entry.isIntersecting) return;
                    var el = entry.target;

                    if (el.hasAttribute('data-reveal-group')) {
                        var children = el.children;
                        for (var i = 0; i < children.length; i++) {
                            children[i].style.transitionDelay = (i * 0.07) + 's';
                            children[i].classList.add('is-revealed');
                        }
                    } else {
                        el.classList.add('is-revealed');
                    }
                    observer.unobserve(el);
                });
            }, { threshold: 0.1, rootMargin: '0px 0px -60px 0px' });

            document.querySelectorAll('[data-reveal]').forEach(function (el) {
                if (el.closest('[data-reveal-group]')) return;
                el.classList.add('reveal-pending');
                observer.observe(el);
            });

            document.querySelectorAll('[data-reveal-group]').forEach(function (el) {
                Array.prototype.forEach.call(el.children, function (child) {
                    child.classList.add('reveal-pending');
                });
                observer.observe(el);
            });

            var heroImg = document.querySelector('.explore-hero__media img');
            if (heroImg) {
                var ticking = false;
                window.addEventListener('scroll', function () {
                    if (ticking) return;
                    ticking = true;
                    requestAnimationFrame(function () {
                        var y = window.scrollY;
                        var vh = window.innerHeight;
                        if (y < vh * 1.4) {
                            heroImg.style.transform =
                                'scale(1.1) translate3d(0, ' + (y * 0.16).toFixed(2) + 'px, 0)';
                        }
                        ticking = false;
                    });
                }, { passive: true });
            }
        })();
    </script>
}