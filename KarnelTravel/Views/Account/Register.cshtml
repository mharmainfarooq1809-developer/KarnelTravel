@* Views/Account/Register.cshtml *@
@model KarnelTravel.Models.RegisterViewModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Create account · Karnel Travel Guide</title>
    <meta name="robots" content="noindex, nofollow" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display&family=DM+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />

    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />

    <style>
        /* ============================================================
           KARNEL EDITORIAL COMMAND ENTRANCE — REGISTER
           Page-specific only. Layered on top of admin.css.
           Mirrors the Login page design system exactly.
        ============================================================ */

        /* ---------- PAGE BASE ---------- */
        .admin-body {
            margin: 0;
            background: #F8F6F0;
            color: #14271F;
            font-family: 'DM Sans', system-ui, -apple-system, 'Segoe UI', sans-serif;
            -webkit-font-smoothing: antialiased;
            -moz-osx-font-smoothing: grayscale;
        }

        /* ---------- SPLIT SHELL (55 / 45) ---------- */
        .admin-body .login-shell {
            display: grid;
            grid-template-columns: minmax(0, 55fr) minmax(0, 45fr);
            align-items: start;
            min-height: 100vh;
            min-height: 100dvh;
            background: #F8F6F0;
        }

        /* ============================================================
           LEFT PANEL — CINEMATIC EDITORIAL
           Replace the photo URLs below with your licensed
           northern Pakistan (Hunza / Skardu / Karakoram) image.
           A second URL is declared as a graceful fallback.
        ============================================================ */
        .admin-body .login-visual {
            position: sticky;
            top: 0;
            align-self: start;
            height: 100vh;
            height: 100dvh;
            isolation: isolate;
            overflow: hidden;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            gap: 48px;
            padding: clamp(28px, 4.2vw, 60px);
            background-color: #14271F;
            color: #F8F6F0;
        }

        .admin-body .login-visual::before {
            content: '';
            position: absolute;
            inset: 0;
            z-index: -2;
            background-color: #14271F;
            background-image:
                url('https://images.unsplash.com/photo-1605649487212-47bdab064df7?auto=format&fit=crop&w=1800&q=80'),
                url('https://images.unsplash.com/photo-1506905925346-21bda4d32df4?auto=format&fit=crop&w=1800&q=80');
            background-repeat: no-repeat, no-repeat;
            background-position: center center, center center;
            background-size: cover, cover;
            transform-origin: center center;
            animation: kImageIn 1.8s cubic-bezier(0.16, 1, 0.3, 1) both;
            will-change: transform;
        }

        .admin-body .login-visual::after {
            content: '';
            position: absolute;
            inset: 0;
            z-index: -1;
            pointer-events: none;
            background:
                linear-gradient(
                    165deg,
                    rgba(20, 39, 31, 0.86) 0%,
                    rgba(20, 39, 31, 0.46) 48%,
                    rgba(20, 39, 31, 0.95) 100%
                ),
                radial-gradient(
                    ellipse 62% 52% at 14% 10%,
                    rgba(143, 168, 136, 0.22),
                    transparent 62%
                );
        }

        /* ---------- BRAND ---------- */
        .admin-body .login-brand {
            position: relative;
            z-index: 1;
            display: flex;
            align-items: center;
            gap: 14px;
            animation: kFadeUp 0.9s cubic-bezier(0.16, 1, 0.3, 1) 0.15s both;
        }

        .admin-body .login-brand .brand-mark {
            display: inline-grid;
            place-items: center;
            width: 44px;
            height: 44px;
            flex: 0 0 auto;
            border-radius: 50%;
            border: 1px solid rgba(248, 246, 240, 0.42);
            background: rgba(248, 246, 240, 0.08);
            color: #F8F6F0;
            font-family: 'DM Serif Display', Georgia, serif;
            font-size: 1.28rem;
            line-height: 1;
            backdrop-filter: blur(3px);
        }

        .admin-body .login-brand strong {
            display: block;
            font-family: 'DM Sans', system-ui, sans-serif;
            font-size: 0.8rem;
            font-weight: 600;
            letter-spacing: 0.26em;
            text-transform: uppercase;
            line-height: 1.2;
            color: #F8F6F0;
        }

        .admin-body .login-brand small {
            display: block;
            margin-top: 4px;
            font-size: 0.58rem;
            font-weight: 500;
            letter-spacing: 0.22em;
            text-transform: uppercase;
            color: rgba(248, 246, 240, 0.62);
        }

        /* ---------- EDITORIAL QUOTE ---------- */
        .admin-body .login-visual-foot {
            position: relative;
            z-index: 1;
            display: flex;
            flex-direction: column;
            gap: 34px;
            max-width: 560px;
        }

        .admin-body .login-quote {
            animation: kFadeUp 1s cubic-bezier(0.16, 1, 0.3, 1) 0.35s both;
        }

        .admin-body .login-quote .eyebrow {
            display: inline-flex;
            align-items: center;
            gap: 12px;
            margin: 0 0 20px;
            font-size: 0.62rem;
            font-weight: 600;
            letter-spacing: 0.26em;
            text-transform: uppercase;
            color: #8FA888;
        }

        .admin-body .login-quote .eyebrow::before {
            content: '';
            width: 26px;
            height: 1px;
            flex: 0 0 auto;
            background: currentColor;
            opacity: 0.85;
        }

        .admin-body .login-quote h2 {
            margin: 0 0 18px;
            font-family: 'DM Serif Display', Georgia, serif;
            font-weight: 400;
            font-size: clamp(1.7rem, 2.9vw, 2.65rem);
            line-height: 1.06;
            letter-spacing: -0.014em;
            color: #F8F6F0;
            text-wrap: balance;
        }

        .admin-body .login-quote p {
            margin: 0;
            max-width: 44ch;
            font-size: 0.94rem;
            line-height: 1.72;
            color: rgba(248, 246, 240, 0.78);
        }

        .admin-body .login-signature {
            margin: 0;
            padding-top: 22px;
            border-top: 1px solid rgba(248, 246, 240, 0.18);
            font-size: 0.6rem;
            font-weight: 600;
            letter-spacing: 0.24em;
            text-transform: uppercase;
            color: rgba(248, 246, 240, 0.66);
            animation: kFadeUp 1s cubic-bezier(0.16, 1, 0.3, 1) 0.5s both;
        }

        /* ============================================================
           RIGHT PANEL — FORM
        ============================================================ */
        .admin-body .login-form-wrap {
            display: flex;
            align-items: flex-start;
            justify-content: center;
            min-height: 100vh;
            min-height: 100dvh;
            padding: clamp(34px, 4.6vw, 68px) clamp(24px, 4vw, 64px);
            background: #F8F6F0;
            animation: kFormIn 0.95s cubic-bezier(0.16, 1, 0.3, 1) 0.2s both;
        }

        .admin-body .login-form {
            width: 100%;
            max-width: 440px;
            margin: auto 0; /* safe vertical centering: never clips on overflow */
        }

        .admin-body .login-form .eyebrow {
            display: inline-flex;
            align-items: center;
            gap: 12px;
            margin: 0 0 18px;
            font-size: 0.6rem;
            font-weight: 600;
            letter-spacing: 0.26em;
            text-transform: uppercase;
            color: #8FA888;
        }

        .admin-body .login-form .eyebrow::before {
            content: '';
            width: 26px;
            height: 1px;
            flex: 0 0 auto;
            background: currentColor;
            opacity: 0.85;
        }

        .admin-body .login-form h1 {
            margin: 0 0 12px;
            font-family: 'DM Serif Display', Georgia, serif;
            font-weight: 400;
            font-size: clamp(2rem, 3.2vw, 2.7rem);
            line-height: 1.03;
            letter-spacing: -0.022em;
            color: #14271F;
            text-wrap: balance;
        }

        .admin-body .login-form .login-lede {
            margin: 0 0 28px;
            font-size: 0.94rem;
            line-height: 1.65;
            color: #69766D;
        }

        .admin-body .login-form .login-link {
            color: #14271F;
            font-weight: 600;
            text-decoration: underline;
            text-decoration-thickness: 1px;
            text-decoration-color: rgba(143, 168, 136, 0.65);
            text-underline-offset: 3px;
            transition: text-decoration-color 0.3s ease, color 0.3s ease;
        }

        .admin-body .login-form .login-link:hover {
            color: #14271F;
            text-decoration-color: #8FA888;
        }

        /* ---------- ERROR SUMMARY ---------- */
        .admin-body .login-form .login-error {
            display: flex;
            align-items: flex-start;
            gap: 12px;
            margin: 0 0 26px;
            padding: 14px 16px;
            border: 1px solid rgba(178, 59, 46, 0.26);
            border-left: 3px solid #B23B2E;
            border-radius: 8px;
            background: rgba(178, 59, 46, 0.055);
            color: #6b2018;
            font-size: 0.86rem;
            line-height: 1.55;
        }

        .admin-body .login-form .login-error svg {
            flex: 0 0 auto;
            margin-top: 1px;
            color: #B23B2E;
        }

        .admin-body .login-form .login-error > div > div + div {
            margin-top: 4px;
        }

        /* ---------- FIELDS ---------- */
        .admin-body .login-form .login-field {
            display: flex;
            flex-direction: column;
            gap: 8px;
            margin-bottom: 18px;
        }

        .admin-body .login-form .login-field label {
            font-size: 0.6rem;
            font-weight: 600;
            letter-spacing: 0.2em;
            text-transform: uppercase;
            color: rgba(20, 39, 31, 0.62);
        }

        .admin-body .login-form .input {
            width: 100%;
            height: 54px;
            padding: 0 16px;
            border: 1px solid rgba(20, 39, 31, 0.14);
            border-radius: 8px;
            background: #FFFFFF;
            color: #14271F;
            font: inherit;
            font-size: 0.95rem;
            transition: border-color 0.28s ease, box-shadow 0.28s ease, background 0.28s ease;
        }

        .admin-body .login-form .input::placeholder {
            color: rgba(20, 39, 31, 0.32);
        }

        .admin-body .login-form .input:hover {
            border-color: rgba(20, 39, 31, 0.26);
        }

        .admin-body .login-form .input:focus {
            outline: none;
            border-color: #14271F;
            background: #FFFFFF;
            box-shadow: 0 0 0 3px rgba(20, 39, 31, 0.09);
        }

        /* Validation styling emitted by ASP.NET Core tag helpers */
        .admin-body .login-form .input.input-validation-error {
            border-color: rgba(178, 59, 46, 0.5);
            background: #FFFDFC;
        }

        .admin-body .login-form .input.input-validation-error:focus {
            border-color: #B23B2E;
            box-shadow: 0 0 0 3px rgba(178, 59, 46, 0.1);
        }

        /* ---------- FIELD VALIDATION MESSAGES ---------- */
        .admin-body .login-form .field-error {
            display: block;
            font-size: 0.74rem;
            line-height: 1.5;
            color: #B23B2E;
        }

        .admin-body .login-form .field-error:empty {
            display: none;
        }

        /* ---------- PASSWORD TOGGLE ---------- */
        .admin-body .login-password-wrap {
            position: relative;
        }

        .admin-body .login-password-wrap .input {
            padding-right: 54px;
        }

        .admin-body .login-password-toggle {
            position: absolute;
            top: 50%;
            right: 7px;
            transform: translateY(-50%);
            display: grid;
            place-items: center;
            width: 40px;
            height: 40px;
            border: 0;
            border-radius: 6px;
            background: transparent;
            color: rgba(20, 39, 31, 0.48);
            cursor: pointer;
            transition: color 0.25s ease, background 0.25s ease;
        }

        .admin-body .login-password-toggle:hover {
            color: #14271F;
            background: rgba(20, 39, 31, 0.06);
        }

        .admin-body .login-password-toggle:focus-visible {
            outline: 2px solid #8FA888;
            outline-offset: 1px;
        }

        /* ---------- TERMS ---------- */
        .admin-body .login-form .login-terms {
            display: flex;
            align-items: flex-start;
            gap: 11px;
            margin: 8px 0 4px;
            font-size: 0.82rem;
            line-height: 1.6;
            color: rgba(20, 39, 31, 0.76);
            cursor: pointer;
            user-select: none;
        }

        .admin-body .login-form .login-terms input[type="checkbox"] {
            appearance: none;
            -webkit-appearance: none;
            flex: 0 0 auto;
            width: 18px;
            height: 18px;
            margin: 3px 0 0;
            border: 1px solid rgba(20, 39, 31, 0.3);
            border-radius: 3px;
            background: #FFFFFF;
            cursor: pointer;
            position: relative;
            transition: border-color 0.25s ease, background 0.25s ease;
        }

        .admin-body .login-form .login-terms input[type="checkbox"]:hover {
            border-color: #14271F;
        }

        .admin-body .login-form .login-terms input[type="checkbox"]:checked {
            background: #14271F;
            border-color: #14271F;
        }

        .admin-body .login-form .login-terms input[type="checkbox"]:checked::after {
            content: '';
            position: absolute;
            top: 2px;
            left: 5px;
            width: 5px;
            height: 9px;
            border: solid #FFFFFF;
            border-width: 0 2px 2px 0;
            transform: rotate(45deg);
        }

        .admin-body .login-form .login-terms input[type="checkbox"]:focus-visible {
            outline: 2px solid #8FA888;
            outline-offset: 2px;
        }

        .admin-body .login-form .login-terms a {
            color: #14271F;
            font-weight: 600;
            text-decoration: underline;
            text-decoration-thickness: 1px;
            text-decoration-color: rgba(143, 168, 136, 0.55);
            text-underline-offset: 3px;
        }

        .admin-body .login-form .login-terms a:hover {
            text-decoration-color: #8FA888;
        }

        /* ---------- SUBMIT ---------- */
        .admin-body .login-form .login-submit {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            width: 100%;
            height: 54px;
            margin-top: 22px;
            padding: 0 26px;
            border: 0;
            border-radius: 8px;
            background: #14271F;
            color: #F8F6F0;
            font-family: 'DM Sans', system-ui, sans-serif;
            font-size: 0.72rem;
            font-weight: 600;
            letter-spacing: 0.18em;
            text-transform: uppercase;
            cursor: pointer;
            transition:
                transform 0.35s cubic-bezier(0.16, 1, 0.3, 1),
                background 0.3s ease,
                box-shadow 0.35s cubic-bezier(0.16, 1, 0.3, 1);
        }

        .admin-body .login-form .login-submit:hover {
            background: #1B3329;
            transform: translateY(-2px);
            box-shadow: 0 14px 26px -18px rgba(20, 39, 31, 0.6);
        }

        .admin-body .login-form .login-submit:active {
            transform: translateY(0);
        }

        .admin-body .login-form .login-submit:focus-visible {
            outline: 2px solid #8FA888;
            outline-offset: 3px;
        }

        .admin-body .login-form .login-submit:disabled {
            opacity: 0.55;
            cursor: not-allowed;
            transform: none;
            box-shadow: none;
        }

        .admin-body .login-form .login-submit-arrow {
            display: inline-block;
            transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
        }

        .admin-body .login-form .login-submit:hover .login-submit-arrow {
            transform: translateX(3px);
        }

        /* ---------- FOOTER ---------- */
        .admin-body .login-form .login-foot {
            margin: 24px 0 0;
            padding-top: 20px;
            border-top: 1px solid rgba(20, 39, 31, 0.1);
            font-size: 0.72rem;
            line-height: 1.65;
            color: rgba(20, 39, 31, 0.5);
        }

        .admin-body .login-form .login-foot-link {
            margin-top: 10px;
            padding-top: 0;
            border-top: 0;
        }

        /* ---------- ANIMATIONS ---------- */
        @@keyframes kImageIn {
            from {
                opacity: 0;
                transform: scale(1.07);
            }
            to {
                opacity: 1;
                transform: scale(1);
            }
        }

        @@keyframes kFadeUp {
            from {
                opacity: 0;
                transform: translateY(16px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        @@keyframes kFormIn {
            from {
                opacity: 0;
                transform: translateY(14px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        /* ---------- RESPONSIVE ---------- */
        @@media (max-width: 1180px) {
            .admin-body .login-shell {
                grid-template-columns: minmax(0, 52fr) minmax(0, 48fr);
            }
            .admin-body .login-visual {
                padding: clamp(26px, 3.6vw, 44px);
            }
        }

        @@media (max-width: 980px) {
            .admin-body .login-shell {
                grid-template-columns: minmax(0, 50fr) minmax(0, 50fr);
            }
            .admin-body .login-quote h2 {
                font-size: clamp(1.5rem, 3.4vw, 2rem);
            }
            .admin-body .login-quote p {
                font-size: 0.88rem;
            }
            .admin-body .login-form h1 {
                font-size: clamp(1.75rem, 4vw, 2.2rem);
            }
        }

        @@media (max-width: 860px) {
            .admin-body .login-shell {
                grid-template-columns: minmax(0, 1fr);
            }
            .admin-body .login-visual {
                position: relative;
                height: auto;
                min-height: 300px;
                padding: 26px 24px 32px;
                gap: 28px;
            }
            .admin-body .login-visual-foot {
                gap: 20px;
            }
            .admin-body .login-quote .eyebrow {
                margin-bottom: 14px;
                font-size: 0.56rem;
            }
            .admin-body .login-quote h2 {
                font-size: clamp(1.4rem, 5.4vw, 1.95rem);
                margin-bottom: 12px;
            }
            .admin-body .login-quote p {
                font-size: 0.86rem;
                line-height: 1.6;
            }
            .admin-body .login-signature {
                padding-top: 16px;
                font-size: 0.54rem;
                letter-spacing: 0.2em;
            }
            .admin-body .login-form-wrap {
                min-height: 0;
                padding: 38px 22px 48px;
            }
            .admin-body .login-form {
                max-width: 100%;
                margin: 0 auto;
            }
        }

        @@media (max-width: 420px) {
            .admin-body .login-visual {
                min-height: 260px;
                padding: 22px 20px 26px;
            }
            .admin-body .login-form h1 {
                font-size: 1.85rem;
            }
        }

        /* ---------- REDUCED MOTION ---------- */
        @@media (prefers-reduced-motion: reduce) {
            .admin-body .login-visual::before,
            .admin-body .login-brand,
            .admin-body .login-quote,
            .admin-body .login-quote .eyebrow,
            .admin-body .login-signature,
            .admin-body .login-form-wrap,
            .admin-body .login-form .login-submit,
            .admin-body .login-form .login-submit-arrow,
            .admin-body .login-form .input,
            .admin-body .login-password-toggle {
                animation: none !important;
                transition: none !important;
            }
            .admin-body .login-form .login-submit:hover,
            .admin-body .login-form .login-submit:hover .login-submit-arrow {
                transform: none !important;
            }
        }
    </style>
</head>
<body class="admin-body">

    <div class="login-shell">

        <!-- ============ VISUAL SIDE ============ -->
        <aside class="login-visual">
            <div class="login-brand">
                <span class="brand-mark" aria-hidden="true">K</span>
                <span>
                    <strong>Karnel</strong>
                    <small>Travel Guide</small>
                </span>
            </div>

            <div class="login-visual-foot">
                <div class="login-quote">
                    <p class="eyebrow">Join the journey</p>
                    <h2>The world is waiting. Start planning your next great story.</h2>
                    <p>
                        Create an account to save your favourite destinations, manage
                        bookings, and receive tailored travel inspiration.
                    </p>
                </div>
                <p class="login-signature">Handpicked stays · Expert guides · Seamless booking</p>
            </div>
        </aside>

        <!-- ============ FORM SIDE ============ -->
        <section class="login-form-wrap">
            <form class="login-form"
                  method="post"
                  asp-controller="Account"
                  asp-action="Register">
                @Html.AntiForgeryToken()

                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="login-error" role="alert">
                        @foreach (var error in ViewData.ModelState.Values.SelectMany(value => value.Errors))
                        {
                            <div>@error.ErrorMessage</div>
                        }
                    </div>
                }

                <p class="eyebrow">Karnel / Create account</p>
                <h1>Start your journey.</h1>
                <p class="login-lede">
                    Already have an account?
                    <a class="login-link" asp-controller="Account" asp-action="Login">Sign in here</a>.
                </p>

                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="login-error" role="alert">
                        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor"
                             stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <circle cx="12" cy="12" r="9" />
                            <path d="M12 8v5" />
                            <path d="M12 16h.01" />
                        </svg>
                        <div>
                            @foreach (var err in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                            {
                                <div>@err.ErrorMessage</div>
                            }
                        </div>
                    </div>
                }

                <div class="login-field">
                    <label asp-for="DisplayName">Full name</label>
                    <input class="input"
                           asp-for="DisplayName"
                           placeholder="e.g. Jane Doe"
                           autocomplete="name"
                           aria-describedby="DisplayName-error" />
                    <span class="field-error" id="DisplayName-error" asp-validation-for="DisplayName"></span>
                </div>

                <div class="login-field">
                    <label asp-for="Email">Email address</label>
                    <input class="input"
                           asp-for="Email"
                           type="email"
                           placeholder="you@example.com"
                           autocomplete="username"
                           aria-describedby="Email-error" />
                    <span class="field-error" id="Email-error" asp-validation-for="Email"></span>
                </div>

                <div class="login-field">
                    <label asp-for="PhoneNumber">Phone number</label>
                    <input class="input"
                           asp-for="PhoneNumber"
                           placeholder="e.g. +92 300 1234567"
                           autocomplete="tel"
                           aria-describedby="PhoneNumber-error" />
                    <span class="field-error" id="PhoneNumber-error" asp-validation-for="PhoneNumber"></span>
                </div>

                <div class="login-field">
                    <label asp-for="Password">Password</label>
                    <div class="login-password-wrap">
                        <input class="input"
                               asp-for="Password"
                               type="password"
                               placeholder="Create a strong password"
                               autocomplete="new-password"
                               aria-describedby="Password-error" />
                        <button type="button"
                                class="login-password-toggle"
                                aria-label="Show password"
                                aria-pressed="false"
                                data-password-toggle>
                            <svg viewBox="0 0 24 24" width="17" height="17" fill="none"
                                 stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"
                                 aria-hidden="true">
                                <path d="M2 12s3.6-6.5 10-6.5S22 12 22 12s-3.6 6.5-10 6.5S2 12 2 12Z" />
                                <circle cx="12" cy="12" r="2.6" />
                            </svg>
                        </button>
                    </div>
                    <span class="field-error" id="Password-error" asp-validation-for="Password"></span>
                </div>

                <div class="login-field">
                    <label asp-for="ConfirmPassword">Confirm password</label>
                    <div class="login-password-wrap">
                        <input class="input"
                               asp-for="ConfirmPassword"
                               type="password"
                               placeholder="Repeat password"
                               autocomplete="new-password"
                               aria-describedby="ConfirmPassword-error" />
                    </div>
                    <span class="field-error" id="ConfirmPassword-error" asp-validation-for="ConfirmPassword"></span>
                </div>

                <label class="login-terms" for="AcceptTerms">
                    <input asp-for="AcceptTerms" />
                    <span>
                        I accept the <a href="#" data-prototype="Terms of Service is design-only until legal copy is published.">Terms of Service</a>
                        and <a href="#" data-prototype="Privacy Policy is design-only until legal copy is published.">Privacy Policy</a>.
                    </span>
                </label>
                <span class="field-error" id="AcceptTerms-error" asp-validation-for="AcceptTerms"></span>

                <button type="submit" class="btn btn-primary login-submit">
                    Create account
                    <span class="login-submit-arrow" aria-hidden="true">→</span>
                </button>

                <p class="login-foot">
                    By creating an account, you agree to our Terms of Service and Privacy Policy.<br />
                    &copy; @DateTime.UtcNow.Year Karnel Travel Guide
                </p>

                <p class="login-foot login-foot-link">
                    Already registered?
                    <a class="login-link" asp-controller="Account" asp-action="Login">Sign in</a>
                </p>
            </form>
        </section>

    </div>

    <script>
        /* ============================================================
           PASSWORD VISIBILITY TOGGLE + PROTOTYPE LINK GUARD
           Preserves the original data-password-toggle behaviour and
           adds aria-pressed + wrap-safe lookup.
        ============================================================ */
        (function () {
            'use strict';

            document.querySelectorAll('[data-password-toggle]').forEach(function (btn) {
                btn.addEventListener('click', function (event) {
                    event.preventDefault();

                    var wrap = btn.closest('.login-password-wrap');
                    var input = wrap ? wrap.querySelector('input') : null;
                    if (!input) return;

                    var show = input.type === 'password';
                    input.type = show ? 'text' : 'password';
                    btn.setAttribute('aria-label', show ? 'Hide password' : 'Show password');
                    btn.setAttribute('aria-pressed', show ? 'true' : 'false');
                    input.focus();
                });
            });

            /* Prototype links must not pretend to work */
            document.querySelectorAll('a[data-prototype]').forEach(function (link) {
                link.addEventListener('click', function (event) {
                    event.preventDefault();
                });
            });
        })();
    </script>

</body>
</html>