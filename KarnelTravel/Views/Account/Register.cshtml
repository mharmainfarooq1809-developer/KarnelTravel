@* Views/Account/Register.cshtml *@
@model KarnelTravel.Models.RegisterViewModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Create account · Karnel Travel Guide</title>
    <meta name="robots" content="noindex, nofollow" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,300;9..144,400;9..144,500;9..144,600&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />

    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />

    <style>
            /* ============================================================
                       KARNEL — EDITORIAL REGISTRATION (v2)
                       Registration-appropriate validation:
                         • Name: required, 2–80 chars, no leading/trailing space
                         • Email: required, valid format, ≤254
                         • Phone: optional but validated if provided
                         • Password: 8–128, mixed case + digit required
                         • Confirm: must match exactly
                         • Terms: must be accepted
                       Real-time strength meter + live inline errors.
                    ============================================================ */

            :root {
                --k-ink: #0F1F17;
                --k-ink-2: #1B3329;
                --k-forest: #14271F;
                --k-sage: #8FA888;
                --k-parchment: #F6F2E9;
                --k-cream: #FBF8F1;
                --k-muted: #6B7A6E;
                --k-line: rgba(20, 39, 31, 0.12);
                --k-line-strong: rgba(20, 39, 31, 0.22);
                --k-danger: #B23B2E;
                --k-danger-soft: rgba(178, 59, 46, 0.06);
                --k-danger-line: rgba(178, 59, 46, 0.32);
                --k-warn: #C98A2E;
                --k-success: #3D7A4F;
                --k-radius: 10px;
            }

            html, body {
                height: 100%;
            }

            .admin-body {
                margin: 0;
                background: var(--k-parchment);
                color: var(--k-forest);
                font-family: 'Inter', system-ui, -apple-system, 'Segoe UI', sans-serif;
                -webkit-font-smoothing: antialiased;
                -moz-osx-font-smoothing: grayscale;
                text-rendering: optimizeLegibility;
            }

                .admin-body::before {
                    content: '';
                    position: fixed;
                    inset: 0;
                    pointer-events: none;
                    z-index: 0;
                    opacity: 0.35;
                    background-image: radial-gradient(rgba(20, 39, 31, 0.035) 1px, transparent 1px);
                    background-size: 3px 3px;
                }

                /* ---------- SPLIT SHELL ---------- */
                .admin-body .login-shell {
                    position: relative;
                    z-index: 1;
                    display: grid;
                    grid-template-columns: minmax(0, 55fr) minmax(0, 45fr);
                    align-items: start;
                    min-height: 100vh;
                    min-height: 100dvh;
                }

                /* ---------- LEFT VISUAL ---------- */
                .admin-body .login-visual {
                    position: sticky;
                    top: 0;
                    align-self: start;
                    height: 100vh;
                    height: 100dvh;
                    isolation: isolate;
                    overflow: hidden;
                    display: flex;
                    flex-direction: column;
                    justify-content: space-between;
                    gap: 48px;
                    padding: clamp(28px, 4.2vw, 64px);
                    background-color: var(--k-forest);
                    color: var(--k-cream);
                }

                    .admin-body .login-visual::before {
                        content: '';
                        position: absolute;
                        inset: 0;
                        z-index: -2;
                        background-color: var(--k-forest);
                        background-image: url('https://images.unsplash.com/photo-1605649487212-47bdab064df7?auto=format&fit=crop&w=1800&q=80'), url('https://images.unsplash.com/photo-1506905925346-21bda4d32df4?auto=format&fit=crop&w=1800&q=80');
                        background-repeat: no-repeat, no-repeat;
                        background-position: center center, center center;
                        background-size: cover, cover;
                        animation: kImageIn 1.8s cubic-bezier(0.16, 1, 0.3, 1) both;
                        will-change: transform;
                    }

                    .admin-body .login-visual::after {
                        content: '';
                        position: absolute;
                        inset: 0;
                        z-index: -1;
                        pointer-events: none;
                        background: linear-gradient(165deg, rgba(15,31,23,0.88) 0%, rgba(15,31,23,0.42) 46%, rgba(15,31,23,0.96) 100%), radial-gradient(ellipse 62% 52% at 14% 10%, rgba(143,168,136,0.22), transparent 62%);
                    }

                .admin-body .login-brand {
                    position: relative;
                    z-index: 1;
                    display: flex;
                    align-items: center;
                    gap: 14px;
                    animation: kFadeUp 0.9s cubic-bezier(0.16, 1, 0.3, 1) 0.15s both;
                }

                    .admin-body .login-brand .brand-mark {
                        display: inline-grid;
                        place-items: center;
                        width: 46px;
                        height: 46px;
                        flex: 0 0 auto;
                        border-radius: 50%;
                        border: 1px solid rgba(251, 248, 241, 0.42);
                        background: rgba(251, 248, 241, 0.07);
                        color: var(--k-cream);
                        font-family: 'Fraunces', Georgia, serif;
                        font-weight: 500;
                        font-size: 1.35rem;
                        line-height: 1;
                        backdrop-filter: blur(4px);
                    }

                    .admin-body .login-brand strong {
                        display: block;
                        font-size: 0.78rem;
                        font-weight: 600;
                        letter-spacing: 0.28em;
                        text-transform: uppercase;
                        line-height: 1.2;
                        color: var(--k-cream);
                    }

                    .admin-body .login-brand small {
                        display: block;
                        margin-top: 5px;
                        font-size: 0.58rem;
                        font-weight: 500;
                        letter-spacing: 0.24em;
                        text-transform: uppercase;
                        color: rgba(251, 248, 241, 0.6);
                    }

                .admin-body .login-visual-foot {
                    position: relative;
                    z-index: 1;
                    display: flex;
                    flex-direction: column;
                    gap: 34px;
                    max-width: 580px;
                }

                .admin-body .login-quote {
                    animation: kFadeUp 1s cubic-bezier(0.16, 1, 0.3, 1) 0.35s both;
                }

                    .admin-body .login-quote .eyebrow {
                        display: inline-flex;
                        align-items: center;
                        gap: 12px;
                        margin: 0 0 20px;
                        font-size: 0.62rem;
                        font-weight: 600;
                        letter-spacing: 0.26em;
                        text-transform: uppercase;
                        color: var(--k-sage);
                    }

                        .admin-body .login-quote .eyebrow::before {
                            content: '';
                            width: 26px;
                            height: 1px;
                            flex: 0 0 auto;
                            background: currentColor;
                            opacity: 0.85;
                        }

                    .admin-body .login-quote h2 {
                        margin: 0 0 18px;
                        font-family: 'Fraunces', Georgia, serif;
                        font-weight: 400;
                        font-size: clamp(1.75rem, 3vw, 2.8rem);
                        line-height: 1.06;
                        letter-spacing: -0.018em;
                        color: var(--k-cream);
                        text-wrap: balance;
                    }

                        .admin-body .login-quote h2 em {
                            font-style: italic;
                            color: rgba(143, 168, 136, 0.95);
                        }

                    .admin-body .login-quote p {
                        margin: 0;
                        max-width: 46ch;
                        font-size: 0.95rem;
                        line-height: 1.75;
                        color: rgba(251, 248, 241, 0.78);
                    }

                .admin-body .login-perks {
                    list-style: none;
                    margin: 4px 0 0;
                    padding: 0;
                    display: flex;
                    flex-direction: column;
                    gap: 10px;
                }

                    .admin-body .login-perks li {
                        display: flex;
                        align-items: flex-start;
                        gap: 10px;
                        font-size: 0.86rem;
                        line-height: 1.55;
                        color: rgba(251, 248, 241, 0.8);
                    }

                        .admin-body .login-perks li::before {
                            content: '';
                            flex: 0 0 auto;
                            width: 16px;
                            height: 16px;
                            margin-top: 3px;
                            border-radius: 50%;
                            background: radial-gradient(circle at center, var(--k-sage) 0 30%, transparent 32%), rgba(143, 168, 136, 0.18);
                            border: 1px solid rgba(143, 168, 136, 0.55);
                        }

                .admin-body .login-signature {
                    display: flex;
                    align-items: center;
                    gap: 14px;
                    margin: 0;
                    padding-top: 22px;
                    border-top: 1px solid rgba(251, 248, 241, 0.16);
                    font-size: 0.6rem;
                    font-weight: 600;
                    letter-spacing: 0.24em;
                    text-transform: uppercase;
                    color: rgba(251, 248, 241, 0.62);
                    animation: kFadeUp 1s cubic-bezier(0.16, 1, 0.3, 1) 0.5s both;
                }

                    .admin-body .login-signature::before {
                        content: '';
                        width: 26px;
                        height: 1px;
                        background: rgba(143, 168, 136, 0.8);
                    }

                /* ---------- RIGHT FORM ---------- */
                .admin-body .login-form-wrap {
                    display: flex;
                    align-items: flex-start;
                    justify-content: center;
                    min-height: 100vh;
                    min-height: 100dvh;
                    padding: clamp(34px, 4.6vw, 72px) clamp(24px, 4.4vw, 72px);
                    background: var(--k-parchment);
                    animation: kFormIn 0.95s cubic-bezier(0.16, 1, 0.3, 1) 0.2s both;
                }

                .admin-body .login-form {
                    width: 100%;
                    max-width: 460px;
                    margin: auto 0;
                }

                    .admin-body .login-form .eyebrow {
                        display: inline-flex;
                        align-items: center;
                        gap: 12px;
                        margin: 0 0 18px;
                        font-size: 0.6rem;
                        font-weight: 600;
                        letter-spacing: 0.28em;
                        text-transform: uppercase;
                        color: var(--k-sage);
                    }

                        .admin-body .login-form .eyebrow::before {
                            content: '';
                            width: 26px;
                            height: 1px;
                            flex: 0 0 auto;
                            background: currentColor;
                            opacity: 0.9;
                        }

                    .admin-body .login-form h1 {
                        margin: 0 0 12px;
                        font-family: 'Fraunces', Georgia, serif;
                        font-weight: 400;
                        font-size: clamp(2.1rem, 3.4vw, 2.85rem);
                        line-height: 1.02;
                        letter-spacing: -0.026em;
                        color: var(--k-ink);
                        text-wrap: balance;
                    }

                    .admin-body .login-form .login-lede {
                        margin: 0 0 28px;
                        font-size: 0.94rem;
                        line-height: 1.65;
                        color: var(--k-muted);
                    }

                    .admin-body .login-form .login-link {
                        color: var(--k-ink);
                        font-weight: 600;
                        text-decoration: underline;
                        text-decoration-thickness: 1px;
                        text-decoration-color: rgba(143, 168, 136, 0.65);
                        text-underline-offset: 3px;
                        transition: text-decoration-color 0.3s ease;
                    }

                        .admin-body .login-form .login-link:hover {
                            text-decoration-color: var(--k-sage);
                        }

                    /* ---------- SERVER ERROR BANNER ---------- */
                    .admin-body .login-form .login-error {
                        display: flex;
                        align-items: flex-start;
                        gap: 12px;
                        margin: 0 0 26px;
                        padding: 14px 16px;
                        border: 1px solid var(--k-danger-line);
                        border-left: 3px solid var(--k-danger);
                        border-radius: var(--k-radius);
                        background: var(--k-danger-soft);
                        color: #6b2018;
                        font-size: 0.86rem;
                        line-height: 1.55;
                        animation: kShake 0.55s cubic-bezier(0.36, 0.07, 0.19, 0.97) both;
                    }

                        .admin-body .login-form .login-error svg {
                            flex: 0 0 auto;
                            margin-top: 1px;
                            color: var(--k-danger);
                        }

                        .admin-body .login-form .login-error > div > div + div {
                            margin-top: 4px;
                        }

                    /* ---------- FIELDS ---------- */
                    .admin-body .login-form .login-field {
                        display: flex;
                        flex-direction: column;
                        gap: 8px;
                        margin-bottom: 18px;
                    }

                        .admin-body .login-form .login-field label {
                            display: flex;
                            align-items: center;
                            justify-content: space-between;
                            font-size: 0.6rem;
                            font-weight: 600;
                            letter-spacing: 0.2em;
                            text-transform: uppercase;
                            color: rgba(15, 31, 23, 0.62);
                        }

                        .admin-body .login-form .login-field .field-hint {
                            font-size: 0.68rem;
                            font-weight: 500;
                            letter-spacing: 0.02em;
                            text-transform: none;
                            color: rgba(15, 31, 23, 0.4);
                        }

                    .admin-body .login-form .input {
                        width: 100%;
                        height: 56px;
                        padding: 0 16px;
                        border: 1px solid var(--k-line);
                        border-radius: var(--k-radius);
                        background: var(--k-cream);
                        color: var(--k-ink);
                        font: inherit;
                        font-size: 0.95rem;
                        box-shadow: 0 1px 0 rgba(255,255,255,0.9) inset, 0 1px 2px rgba(20,39,31,0.04);
                        transition: border-color 0.24s ease, box-shadow 0.24s ease, background 0.24s ease;
                    }

                        .admin-body .login-form .input::placeholder {
                            color: rgba(15, 31, 23, 0.32);
                        }

                        .admin-body .login-form .input:hover {
                            border-color: var(--k-line-strong);
                        }

                        .admin-body .login-form .input:focus {
                            outline: none;
                            border-color: var(--k-ink);
                            background: #FFFFFF;
                            box-shadow: 0 0 0 3px rgba(143, 168, 136, 0.28);
                        }

                        /* ASP.NET Core tag-helper validation state */
                        .admin-body .login-form .input.input-validation-error {
                            border-color: var(--k-danger);
                            background: #FFF9F8;
                            box-shadow: 0 0 0 3px rgba(178, 59, 46, 0.1);
                        }

                            .admin-body .login-form .input.input-validation-error:focus {
                                box-shadow: 0 0 0 3px rgba(178, 59, 46, 0.16);
                            }

                    /* JS custom validation state */
                    .admin-body .login-form .login-field.is-invalid .input {
                        border-color: var(--k-danger);
                        background: #FFF9F8;
                        box-shadow: 0 0 0 3px rgba(178, 59, 46, 0.1);
                    }

                        .admin-body .login-form .login-field.is-invalid .input:focus {
                            box-shadow: 0 0 0 3px rgba(178, 59, 46, 0.16);
                        }

                    .admin-body .login-form .login-field.is-valid .input {
                        border-color: rgba(61, 122, 79, 0.55);
                    }

                        .admin-body .login-form .login-field.is-valid .input:focus {
                            border-color: var(--k-success);
                            box-shadow: 0 0 0 3px rgba(61, 122, 79, 0.14);
                        }

                    /* ---------- INLINE FIELD ERRORS ---------- */
                    .admin-body .login-form .field-error {
                        display: none;
                        align-items: flex-start;
                        gap: 6px;
                        margin-top: 2px;
                        font-size: 0.78rem;
                        font-weight: 500;
                        line-height: 1.45;
                        color: var(--k-danger);
                    }

                        .admin-body .login-form .field-error::before {
                            content: '⚠';
                            font-size: 0.78rem;
                            line-height: 1.4;
                        }

                        .admin-body .login-form .field-error:not(:empty),
                        .admin-body .login-form .login-field.is-invalid .field-error,
                        .admin-body .login-form .field-error.is-visible {
                            display: flex;
                            animation: kErrorIn 0.35s cubic-bezier(0.16, 1, 0.3, 1) both;
                        }

                    .admin-body .login-form .field-success {
                        display: none;
                        align-items: center;
                        gap: 6px;
                        margin-top: 2px;
                        font-size: 0.78rem;
                        font-weight: 500;
                        color: var(--k-success);
                    }

                    .admin-body .login-form .login-field.is-valid .field-success {
                        display: flex;
                        animation: kErrorIn 0.35s cubic-bezier(0.16, 1, 0.3, 1) both;
                    }

                /* ---------- PASSWORD TOGGLE ---------- */
                .admin-body .login-password-wrap {
                    position: relative;
                }

                    .admin-body .login-password-wrap .input {
                        padding-right: 54px;
                    }

                .admin-body .login-password-toggle {
                    position: absolute;
                    top: 50%;
                    right: 7px;
                    transform: translateY(-50%);
                    display: grid;
                    place-items: center;
                    width: 42px;
                    height: 42px;
                    border: 0;
                    border-radius: 8px;
                    background: transparent;
                    color: rgba(15, 31, 23, 0.48);
                    cursor: pointer;
                    transition: color 0.24s ease, background 0.24s ease;
                }

                    .admin-body .login-password-toggle:hover {
                        color: var(--k-ink);
                        background: rgba(15, 31, 23, 0.06);
                    }

                    .admin-body .login-password-toggle:focus-visible {
                        outline: 2px solid var(--k-sage);
                        outline-offset: 1px;
                    }

                    .admin-body .login-password-toggle .icon-eye-off {
                        display: none;
                    }

                    .admin-body .login-password-toggle[aria-pressed="true"] .icon-eye {
                        display: none;
                    }

                    .admin-body .login-password-toggle[aria-pressed="true"] .icon-eye-off {
                        display: block;
                    }

                /* ---------- PASSWORD STRENGTH ---------- */
                .admin-body .password-strength {
                    display: none;
                    flex-direction: column;
                    gap: 10px;
                    margin-top: 6px;
                }

                    .admin-body .password-strength.is-visible {
                        display: flex;
                        animation: kErrorIn 0.35s cubic-bezier(0.16, 1, 0.3, 1) both;
                    }

                .admin-body .password-strength-track {
                    display: flex;
                    gap: 4px;
                }

                .admin-body .password-strength-seg {
                    height: 4px;
                    flex: 1 1 0;
                    border-radius: 2px;
                    background: rgba(15, 31, 23, 0.1);
                    transition: background 0.3s ease;
                }

                    .admin-body .password-strength-seg.is-on.lvl-1 {
                        background: #B23B2E;
                    }

                    .admin-body .password-strength-seg.is-on.lvl-2 {
                        background: #C98A2E;
                    }

                    .admin-body .password-strength-seg.is-on.lvl-3 {
                        background: #7E9E55;
                    }

                    .admin-body .password-strength-seg.is-on.lvl-4 {
                        background: var(--k-success);
                    }

                .admin-body .password-strength-meta {
                    display: flex;
                    align-items: center;
                    justify-content: space-between;
                    gap: 12px;
                    font-size: 0.72rem;
                    color: var(--k-muted);
                }

                    .admin-body .password-strength-meta strong {
                        font-weight: 600;
                        color: var(--k-ink);
                    }

                /* ---------- PASSWORD RULES LIST ---------- */
                .admin-body .password-rules {
                    display: none;
                    list-style: none;
                    margin: 4px 0 0;
                    padding: 0;
                    grid-template-columns: repeat(2, minmax(0, 1fr));
                    gap: 6px 14px;
                    font-size: 0.74rem;
                    color: var(--k-muted);
                }

                    .admin-body .password-rules.is-visible {
                        display: grid;
                        animation: kErrorIn 0.35s cubic-bezier(0.16, 1, 0.3, 1) both;
                    }

                    .admin-body .password-rules li {
                        display: flex;
                        align-items: center;
                        gap: 6px;
                        line-height: 1.4;
                        transition: color 0.24s ease;
                    }

                        .admin-body .password-rules li::before {
                            content: '○';
                            font-size: 0.7rem;
                            color: rgba(15, 31, 23, 0.32);
                            transition: color 0.24s ease, content 0.24s ease;
                        }

                        .admin-body .password-rules li.is-met {
                            color: var(--k-success);
                        }

                            .admin-body .password-rules li.is-met::before {
                                content: '✓';
                                color: var(--k-success);
                                font-weight: 700;
                            }

                /* ---------- TERMS ---------- */
                .admin-body .login-form .login-terms {
                    display: flex;
                    align-items: flex-start;
                    gap: 11px;
                    margin: 8px 0 4px;
                    font-size: 0.82rem;
                    line-height: 1.6;
                    color: rgba(15, 31, 23, 0.76);
                    cursor: pointer;
                    user-select: none;
                }

                    .admin-body .login-form .login-terms input[type="checkbox"] {
                        appearance: none;
                        -webkit-appearance: none;
                        flex: 0 0 auto;
                        width: 18px;
                        height: 18px;
                        margin: 3px 0 0;
                        border: 1px solid var(--k-line-strong);
                        border-radius: 4px;
                        background: var(--k-cream);
                        cursor: pointer;
                        position: relative;
                        transition: border-color 0.24s ease, background 0.24s ease;
                    }

                        .admin-body .login-form .login-terms input[type="checkbox"]:hover {
                            border-color: var(--k-ink);
                        }

                        .admin-body .login-form .login-terms input[type="checkbox"]:checked {
                            background: var(--k-ink);
                            border-color: var(--k-ink);
                        }

                            .admin-body .login-form .login-terms input[type="checkbox"]:checked::after {
                                content: '';
                                position: absolute;
                                top: 2px;
                                left: 5px;
                                width: 5px;
                                height: 9px;
                                border: solid var(--k-cream);
                                border-width: 0 2px 2px 0;
                                transform: rotate(45deg);
                            }

                        .admin-body .login-form .login-terms input[type="checkbox"]:focus-visible {
                            outline: 2px solid var(--k-sage);
                            outline-offset: 2px;
                        }

                    /* Terms invalid state */
                    .admin-body .login-form .login-terms.is-invalid input[type="checkbox"] {
                        border-color: var(--k-danger);
                        box-shadow: 0 0 0 3px rgba(178, 59, 46, 0.1);
                    }

                    .admin-body .login-form .login-terms a {
                        color: var(--k-ink);
                        font-weight: 600;
                        text-decoration: underline;
                        text-decoration-thickness: 1px;
                        text-decoration-color: rgba(143, 168, 136, 0.55);
                        text-underline-offset: 3px;
                    }

                        .admin-body .login-form .login-terms a:hover {
                            text-decoration-color: var(--k-sage);
                        }

                /* ---------- SUBMIT ---------- */
                .admin-body .login-form .login-submit {
                    position: relative;
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    gap: 10px;
                    width: 100%;
                    height: 56px;
                    margin-top: 22px;
                    padding: 0 26px;
                    border: 0;
                    border-radius: var(--k-radius);
                    background: var(--k-ink);
                    color: var(--k-cream);
                    font-family: 'Inter', system-ui, sans-serif;
                    font-size: 0.72rem;
                    font-weight: 600;
                    letter-spacing: 0.2em;
                    text-transform: uppercase;
                    cursor: pointer;
                    overflow: hidden;
                    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1), background 0.3s ease, box-shadow 0.35s cubic-bezier(0.16, 1, 0.3, 1);
                }

                    .admin-body .login-form .login-submit::before {
                        content: '';
                        position: absolute;
                        inset: 0;
                        background: linear-gradient(120deg, transparent 30%, rgba(143,168,136,0.2) 50%, transparent 70%);
                        transform: translateX(-100%);
                        transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
                    }

                    .admin-body .login-form .login-submit:hover::before {
                        transform: translateX(100%);
                    }

                    .admin-body .login-form .login-submit:hover {
                        background: var(--k-ink-2);
                        transform: translateY(-2px);
                        box-shadow: 0 16px 30px -18px rgba(15, 31, 23, 0.7);
                    }

                    .admin-body .login-form .login-submit:active {
                        transform: translateY(0);
                    }

                    .admin-body .login-form .login-submit:focus-visible {
                        outline: 2px solid var(--k-sage);
                        outline-offset: 3px;
                    }

                    .admin-body .login-form .login-submit:disabled {
                        opacity: 0.6;
                        cursor: not-allowed;
                        transform: none;
                        box-shadow: none;
                    }

                    .admin-body .login-form .login-submit .label,
                    .admin-body .login-form .login-submit .spinner,
                    .admin-body .login-form .login-submit .login-submit-arrow {
                        position: relative;
                        z-index: 1;
                    }

                    .admin-body .login-form .login-submit .spinner {
                        display: none;
                        width: 16px;
                        height: 16px;
                        border: 2px solid rgba(251, 248, 241, 0.35);
                        border-top-color: var(--k-cream);
                        border-radius: 50%;
                        animation: kSpin 0.7s linear infinite;
                    }

                    .admin-body .login-form .login-submit.is-loading .spinner {
                        display: block;
                    }

                    .admin-body .login-form .login-submit.is-loading .login-submit-arrow {
                        display: none;
                    }

                .admin-body .login-form .login-submit-arrow {
                    display: inline-block;
                    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
                }

                .admin-body .login-form .login-submit:hover .login-submit-arrow {
                    transform: translateX(3px);
                }

                /* ---------- FOOTER ---------- */
                .admin-body .login-form .login-foot {
                    margin: 24px 0 0;
                    padding-top: 20px;
                    border-top: 1px solid var(--k-line);
                    font-size: 0.72rem;
                    line-height: 1.65;
                    color: rgba(15, 31, 23, 0.5);
                }

                .admin-body .login-form .login-foot-link {
                    margin-top: 14px;
                    padding-top: 0;
                    border-top: 0;
                }

            /* ---------- ANIMATIONS ---------- */
            @@keyframes kImageIn {
                from {
                    opacity: 0;
                    transform: scale(1.08);
                }

                to {
                    opacity: 1;
                    transform: scale(1);
                }
            }

            @@keyframes kFadeUp {
                from {
                    opacity: 0;
                    transform: translateY(16px);
                }

                to {
                    opacity: 1;
                    transform: translateY(0);
                }
            }

            @@keyframes kFormIn {
                from {
                    opacity: 0;
                    transform: translateY(14px);
                }

                to {
                    opacity: 1;
                    transform: translateY(0);
                }
            }

            @@keyframes kErrorIn {
                from {
                    opacity: 0;
                    transform: translateY(-3px);
                }

                to {
                    opacity: 1;
                    transform: translateY(0);
                }
            }

            @@keyframes kShake {
                0%, 100% {
                    transform: translateX(0);
                }

                15%, 55%, 85% {
                    transform: translateX(-3px);
                }

                35%, 75% {
                    transform: translateX(3px);
                }
            }

            @@keyframes kSpin {
                to {
                    transform: rotate(360deg);
                }
            }

            /* ---------- RESPONSIVE ---------- */
            @@media (max-width: 1180px) {
                .admin-body .login-shell {
                    grid-template-columns: minmax(0, 52fr) minmax(0, 48fr);
                }

                .admin-body .login-visual {
                    padding: clamp(26px, 3.6vw, 46px);
                }
            }

            @@media (max-width: 980px) {
                .admin-body .login-shell {
                    grid-template-columns: minmax(0, 50fr) minmax(0, 50fr);
                }

                .admin-body .login-quote h2 {
                    font-size: clamp(1.5rem, 3.4vw, 2.05rem);
                }

                .admin-body .login-quote p {
                    font-size: 0.9rem;
                }

                .admin-body .login-form h1 {
                    font-size: clamp(1.8rem, 4vw, 2.3rem);
                }
            }

            @@media (max-width: 860px) {
                .admin-body .login-shell {
                    grid-template-columns: minmax(0, 1fr);
                }

                .admin-body .login-visual {
                    position: relative;
                    height: auto;
                    min-height: 300px;
                    padding: 26px 24px 32px;
                    gap: 28px;
                }

                .admin-body .login-visual-foot {
                    gap: 20px;
                }

                .admin-body .login-quote .eyebrow {
                    margin-bottom: 14px;
                    font-size: 0.56rem;
                }

                .admin-body .login-quote h2 {
                    font-size: clamp(1.4rem, 5.4vw, 1.95rem);
                    margin-bottom: 12px;
                }

                .admin-body .login-quote p {
                    font-size: 0.88rem;
                    line-height: 1.6;
                }

                .admin-body .login-signature {
                    padding-top: 16px;
                    font-size: 0.54rem;
                    letter-spacing: 0.2em;
                }

                .admin-body .login-form-wrap {
                    min-height: 0;
                    padding: 38px 22px 48px;
                }

                .admin-body .login-form {
                    max-width: 100%;
                    margin: 0 auto;
                }
            }

            @@media (max-width: 420px) {
                .admin-body .login-visual {
                    min-height: 260px;
                    padding: 22px 20px 26px;
                }

                .admin-body .login-form h1 {
                    font-size: 1.85rem;
                }

                .admin-body .password-rules {
                    grid-template-columns: 1fr;
                }
            }

            /* ---------- REDUCED MOTION ---------- */
            @@media (prefers-reduced-motion: reduce) {
                .admin-body .login-visual::before,
                .admin-body .login-brand,
                .admin-body .login-quote,
                .admin-body .login-quote .eyebrow,
                .admin-body .login-signature,
                .admin-body .login-form-wrap,
                .admin-body .login-form .login-submit,
                .admin-body .login-form .login-submit-arrow,
                .admin-body .login-form .input,
                .admin-body .login-password-toggle,
                .admin-body .login-form .login-error,
                .admin-body .login-form .field-error,
                .admin-body .password-strength,
                .admin-body .password-rules {
                    animation: none !important;
                    transition: none !important;
                }

                    .admin-body .login-form .login-submit:hover,
                    .admin-body .login-form .login-submit:hover .login-submit-arrow,
                    .admin-body .login-form .login-submit:hover::before {
                        transform: none !important;
                    }
            }
    </style>
</head>
<body class="admin-body">

    <div class="login-shell">

        <!-- ============ VISUAL SIDE ============ -->
        <aside class="login-visual">
            <div class="login-brand">
                <span class="brand-mark" aria-hidden="true">K</span>
                <span>
                    <strong>Karnel</strong>
                    <small>Travel Guide</small>
                </span>
            </div>

            <div class="login-visual-foot">
                <div class="login-quote">
                    <p class="eyebrow">Join the journey</p>
                    <h2>The world is waiting. Start planning your <em>next great story</em>.</h2>
                    <p>
                        Create an account to save favourite destinations, manage
                        bookings, and receive tailored travel inspiration.
                    </p>
                    <ul class="login-perks">
                        <li>Save and sync itineraries across devices</li>
                        <li>Exclusive member rates on stays &amp; experiences</li>
                        <li>Handpicked guides from local experts</li>
                    </ul>
                </div>
                <p class="login-signature">Handpicked stays · Expert guides · Seamless booking</p>
            </div>
        </aside>

        <!-- ============ FORM SIDE ============ -->
        <section class="login-form-wrap">
            <form class="login-form"
                  id="registerForm"
                  method="post"
                  asp-controller="Account"
                  asp-action="Register"
                  novalidate>
                @Html.AntiForgeryToken()

                <p class="eyebrow">Karnel / Create account</p>
                <h1>Start your journey.</h1>
                <p class="login-lede">
                    Already have an account?
                    <a class="login-link" asp-controller="Account" asp-action="Login">Sign in here</a>.
                </p>

                @* ---- Server-side summary error banner ---- *@
                @{
                    var fieldKeys = new[] { "DisplayName", "Email", "PhoneNumber", "Password", "ConfirmPassword", "AcceptTerms" };
                    var generalErrors = ViewData.ModelState
                        .Where(kv => !fieldKeys.Contains(kv.Key, StringComparer.OrdinalIgnoreCase))
                        .SelectMany(kv => kv.Value.Errors)
                        .Select(e => e.ErrorMessage)
                        .Where(m => !string.IsNullOrWhiteSpace(m))
                        .ToList();
                }
                @if (generalErrors.Any())
                {
                    <div class="login-error" role="alert" id="serverError">
                        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor"
                             stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <circle cx="12" cy="12" r="9" />
                            <path d="M12 8v5" />
                            <path d="M12 16h.01" />
                        </svg>
                        <div>
                            @foreach (var msg in generalErrors)
                            {
                                <div>@msg</div>
                            }
                        </div>
                    </div>
                }

                <!-- ===== FULL NAME ===== -->
                <div class="login-field" id="DisplayNameField">
                    <label asp-for="DisplayName">
                        <span>Full name</span>
                        <span class="field-hint">As it should appear</span>
                    </label>
                    <input class="input"
                           asp-for="DisplayName"
                           id="DisplayName"
                           type="text"
                           placeholder="e.g. Jane Doe"
                           autocomplete="name"
                           autocapitalize="words"
                           spellcheck="false"
                           aria-describedby="DisplayName-error" />
                    <span class="field-error" id="DisplayName-error" asp-validation-for="DisplayName"></span>
                    @if (ViewData.ModelState.TryGetValue("DisplayName", out var dnState) && dnState.Errors.Any())
                    {
                        <span class="field-error is-visible">@dnState.Errors.First().ErrorMessage</span>
                    }
                </div>

                <!-- ===== EMAIL ===== -->
                <div class="login-field" id="EmailField">
                    <label asp-for="Email">
                        <span>Email address</span>
                        <span class="field-hint">We never share it</span>
                    </label>
                    <input class="input"
                           asp-for="Email"
                           id="Email"
                           type="email"
                           placeholder="you@example.com"
                           autocomplete="username"
                           inputmode="email"
                           spellcheck="false"
                           autocapitalize="off"
                           aria-describedby="Email-error" />
                    <span class="field-error" id="Email-error" asp-validation-for="Email"></span>
                    @if (ViewData.ModelState.TryGetValue("Email", out var emailState) && emailState.Errors.Any())
                    {
                        <span class="field-error is-visible">@emailState.Errors.First().ErrorMessage</span>
                    }
                </div>

                <!-- ===== PHONE ===== -->
                <div class="login-field" id="PhoneNumberField">
                    <label asp-for="PhoneNumber">
                        <span>Phone number</span>
                        <span class="field-hint">Optional</span>
                    </label>
                    <input class="input"
                           asp-for="PhoneNumber"
                           id="PhoneNumber"
                           type="tel"
                           placeholder="e.g. +92 300 1234567"
                           autocomplete="tel"
                           inputmode="tel"
                           aria-describedby="PhoneNumber-error" />
                    <span class="field-error" id="PhoneNumber-error" asp-validation-for="PhoneNumber"></span>
                    @if (ViewData.ModelState.TryGetValue("PhoneNumber", out var phState) && phState.Errors.Any())
                    {
                        <span class="field-error is-visible">@phState.Errors.First().ErrorMessage</span>
                    }
                </div>

                <!-- ===== PASSWORD ===== -->
                <div class="login-field" id="PasswordField">
                    <label asp-for="Password">
                        <span>Password</span>
                        <span class="field-hint">8+ characters</span>
                    </label>
                    <div class="login-password-wrap">
                        <input class="input"
                               asp-for="Password"
                               id="Password"
                               type="password"
                               placeholder="Create a strong password"
                               autocomplete="new-password"
                               minlength="8"
                               maxlength="128"
                               aria-describedby="Password-error" />
                        <button type="button"
                                class="login-password-toggle"
                                aria-label="Show password"
                                aria-pressed="false"
                                data-password-toggle>
                            <svg class="icon-eye" viewBox="0 0 24 24" width="17" height="17" fill="none"
                                 stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"
                                 aria-hidden="true">
                                <path d="M2 12s3.6-6.5 10-6.5S22 12 22 12s-3.6 6.5-10 6.5S2 12 2 12Z" />
                                <circle cx="12" cy="12" r="2.6" />
                            </svg>
                            <svg class="icon-eye-off" viewBox="0 0 24 24" width="17" height="17" fill="none"
                                 stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"
                                 aria-hidden="true">
                                <path d="M3 3l18 18" />
                                <path d="M10.6 5.6A9.7 9.7 0 0 1 12 5.5c6.4 0 10 6.5 10 6.5a17.2 17.2 0 0 1-3.1 4" />
                                <path d="M6.5 6.9A17.2 17.2 0 0 0 2 12s3.6 6.5 10 6.5a9.6 9.6 0 0 0 4.3-1" />
                                <path d="M9.9 9.9a3 3 0 0 0 4.2 4.2" />
                            </svg>
                        </button>
                    </div>
                    <span class="field-error" id="Password-error" asp-validation-for="Password"></span>
                    @if (ViewData.ModelState.TryGetValue("Password", out var pwdState) && pwdState.Errors.Any())
                    {
                        <span class="field-error is-visible">@pwdState.Errors.First().ErrorMessage</span>
                    }

                    <!-- Live strength meter -->
                    <div class="password-strength" id="passwordStrength">
                        <div class="password-strength-track">
                            <span class="password-strength-seg" data-seg="1"></span>
                            <span class="password-strength-seg" data-seg="2"></span>
                            <span class="password-strength-seg" data-seg="3"></span>
                            <span class="password-strength-seg" data-seg="4"></span>
                        </div>
                        <div class="password-strength-meta">
                            <span>Strength: <strong id="strengthLabel">—</strong></span>
                            <span id="strengthHint">Aim for strong</span>
                        </div>
                    </div>

                    <!-- Live rules checklist -->
                    <ul class="password-rules" id="passwordRules" aria-live="polite">
                        <li data-rule="len">At least 8 characters</li>
                        <li data-rule="lower">One lowercase letter</li>
                        <li data-rule="upper">One uppercase letter</li>
                        <li data-rule="digit">One number</li>
                    </ul>
                </div>

                <!-- ===== CONFIRM PASSWORD ===== -->
                <div class="login-field" id="ConfirmPasswordField">
                    <label asp-for="ConfirmPassword">
                        <span>Confirm password</span>
                        <span class="field-hint">Type it again</span>
                    </label>
                    <div class="login-password-wrap">
                        <input class="input"
                               asp-for="ConfirmPassword"
                               id="ConfirmPassword"
                               type="password"
                               placeholder="Repeat password"
                               autocomplete="new-password"
                               aria-describedby="ConfirmPassword-error" />
                        <button type="button"
                                class="login-password-toggle"
                                aria-label="Show password"
                                aria-pressed="false"
                                data-password-toggle>
                            <svg class="icon-eye" viewBox="0 0 24 24" width="17" height="17" fill="none"
                                 stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"
                                 aria-hidden="true">
                                <path d="M2 12s3.6-6.5 10-6.5S22 12 22 12s-3.6 6.5-10 6.5S2 12 2 12Z" />
                                <circle cx="12" cy="12" r="2.6" />
                            </svg>
                            <svg class="icon-eye-off" viewBox="0 0 24 24" width="17" height="17" fill="none"
                                 stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"
                                 aria-hidden="true">
                                <path d="M3 3l18 18" />
                                <path d="M10.6 5.6A9.7 9.7 0 0 1 12 5.5c6.4 0 10 6.5 10 6.5a17.2 17.2 0 0 1-3.1 4" />
                                <path d="M6.5 6.9A17.2 17.2 0 0 0 2 12s3.6 6.5 10 6.5a9.6 9.6 0 0 0 4.3-1" />
                                <path d="M9.9 9.9a3 3 0 0 0 4.2 4.2" />
                            </svg>
                        </button>
                    </div>
                    <span class="field-error" id="ConfirmPassword-error" asp-validation-for="ConfirmPassword"></span>
                    @if (ViewData.ModelState.TryGetValue("ConfirmPassword", out var cpState) && cpState.Errors.Any())
                    {
                        <span class="field-error is-visible">@cpState.Errors.First().ErrorMessage</span>
                    }
                </div>

                <!-- ===== TERMS ===== -->
                <label class="login-terms" id="AcceptTermsWrap" for="AcceptTerms">
                    <input asp-for="AcceptTerms" id="AcceptTerms" />
                    <span>
                        I accept the <a href="#" data-prototype="Terms of Service is design-only until legal copy is published.">Terms of Service</a>
                        and <a href="#" data-prototype="Privacy Policy is design-only until legal copy is published.">Privacy Policy</a>.
                    </span>
                </label>
                <span class="field-error" id="AcceptTerms-error" asp-validation-for="AcceptTerms"></span>
                @if (ViewData.ModelState.TryGetValue("AcceptTerms", out var termsState) && termsState.Errors.Any())
                {
                    <span class="field-error is-visible">@termsState.Errors.First().ErrorMessage</span>
                }

                <button type="submit" class="login-submit" id="registerSubmit">
                    <span class="spinner" aria-hidden="true"></span>
                    <span class="label">Create account</span>
                    <span class="login-submit-arrow" aria-hidden="true">→</span>
                </button>

                <p class="login-foot">
                    By creating an account, you agree to our Terms of Service and Privacy Policy.<br />
                    &copy; @DateTime.UtcNow.Year Karnel Travel Guide
                </p>

                <p class="login-foot login-foot-link">
                    Already registered?
                    <a class="login-link" asp-controller="Account" asp-action="Login">Sign in</a>
                </p>
            </form>
        </section>

    </div>

    <script>
            /* ============================================================
               KARNEL REGISTRATION — VALIDATION ENGINE
               Registration rules:
                 • DisplayName: 2–80 chars, non-whitespace
                 • Email: required + valid format, ≤254
                 • PhoneNumber: optional; if provided, 7–20 digits/+ chars
                 • Password: 8–128, mixed case + digit
                 • ConfirmPassword: must match Password
                 • AcceptTerms: must be checked
            ============================================================ */
            (function () {
                'use strict';

                var form = document.getElementById('registerForm');
                if (!form) return;

                var nameInput = document.getElementById('DisplayName');
                var emailInput = document.getElementById('Email');
                var phoneInput = document.getElementById('PhoneNumber');
                var pwdInput = document.getElementById('Password');
                var confirmIn = document.getElementById('ConfirmPassword');
                var termsInput = document.getElementById('AcceptTerms');

                var nameField = document.getElementById('DisplayNameField');
                var emailField = document.getElementById('EmailField');
                var phoneField = document.getElementById('PhoneNumberField');
                var pwdField = document.getElementById('PasswordField');
                var confirmField = document.getElementById('ConfirmPasswordField');
                var termsWrap = document.getElementById('AcceptTermsWrap');

                var nameErr = document.getElementById('DisplayName-error');
                var emailErr = document.getElementById('Email-error');
                var phoneErr = document.getElementById('PhoneNumber-error');
                var pwdErr = document.getElementById('Password-error');
                var confirmErr = document.getElementById('ConfirmPassword-error');
                var termsErr = document.getElementById('AcceptTerms-error');

                var strengthWrap = document.getElementById('passwordStrength');
                var strengthSegs = strengthWrap ? strengthWrap.querySelectorAll('[data-seg]') : [];
                var strengthLabel = document.getElementById('strengthLabel');
                var strengthHint = document.getElementById('strengthHint');
                var rulesWrap = document.getElementById('passwordRules');
                var rules = rulesWrap ? {
                    len: rulesWrap.querySelector('[data-rule="len"]'),
                    lower: rulesWrap.querySelector('[data-rule="lower"]'),
                    upper: rulesWrap.querySelector('[data-rule="upper"]'),
                    digit: rulesWrap.querySelector('[data-rule="digit"]')
                } : {};

                var submitBtn = document.getElementById('registerSubmit');
                var touched = { name: false, email: false, phone: false, pwd: false, confirm: false, terms: false };

                /* ---------- HELPERS ---------- */
                function setState(field, state) {
                    field.classList.remove('is-invalid', 'is-valid');
                    if (state) field.classList.add(state);
                }

                function clearFieldError(el) {
                    if (!el) return;
                    // Preserve server-rendered message if it's the only content
                    if (el.dataset.serverShown === '1') return;
                    el.textContent = '';
                }

                /* ---------- VALIDATORS ---------- */
                function vName(v) {
                    var s = (v || '').trim();
                    if (!s) return { ok: false, msg: 'Please enter your full name.' };
                    if (s.length < 2) return { ok: false, msg: 'Name must be at least 2 characters.' };
                    if (s.length > 80) return { ok: false, msg: 'Name must be 80 characters or fewer.' };
                    if (!/^[\p{L}\p{M}][\p{L}\p{M}\s'.\-]*$/u.test(s)) {
                        return { ok: false, msg: 'Name contains invalid characters.' };
                    }
                    return { ok: true, msg: '' };
                }

                function vEmail(v) {
                    var s = (v || '').trim();
                    if (!s) return { ok: false, msg: 'Please enter your email address.' };
                    if (s.length > 254) return { ok: false, msg: 'Email address is too long.' };
                    if (/\s/.test(s)) return { ok: false, msg: 'Email cannot contain spaces.' };
                    if (!/^[^\s@@]+@@[^\s@@]+\.[^\s@@]{2,}$/.test(s)) {
                        return { ok: false, msg: 'Please enter a valid email address.' };
                    }
                    return { ok: true, msg: '' };
                }

                function vPhone(v) {
                    var s = (v || '').trim();
                    if (!s) return { ok: true, msg: '' }; // optional
                    var digits = s.replace(/\D/g, '');
                    if (digits.length < 7) return { ok: false, msg: 'Phone number looks too short.' };
                    if (digits.length > 15) return { ok: false, msg: 'Phone number looks too long.' };
                    if (!/^[+\d\s().\-]+$/.test(s)) return { ok: false, msg: 'Phone contains invalid characters.' };
                    return { ok: true, msg: '' };
                }

                function vPassword(v) {
                    var s = v || '';
                    if (!s) return { ok: false, msg: 'Please create a password.' };
                    if (s.length < 8) return { ok: false, msg: 'Password must be at least 8 characters.' };
                    if (s.length > 128) return { ok: false, msg: 'Password is too long.' };
                    if (!/[a-z]/.test(s)) return { ok: false, msg: 'Add at least one lowercase letter.' };
                    if (!/[A-Z]/.test(s)) return { ok: false, msg: 'Add at least one uppercase letter.' };
                    if (!/\d/.test(s)) return { ok: false, msg: 'Add at least one number.' };
                    return { ok: true, msg: '' };
                }

                function vConfirm(v) {
                    if (!v) return { ok: false, msg: 'Please confirm your password.' };
                    if (v !== pwdInput.value) return { ok: false, msg: 'Passwords do not match.' };
                    return { ok: true, msg: '' };
                }

                function vTerms() {
                    return termsInput.checked
                        ? { ok: true, msg: '' }
                        : { ok: false, msg: 'Please accept the Terms and Privacy Policy.' };
                }

                /* ---------- RENDER ---------- */
                function render(field, errEl, result, show, optionalOkMsg) {
                    if (!show) {
                        setState(field, '');
                        clearFieldError(errEl);
                        return;
                    }
                    if (result.ok) {
                        setState(field, 'valid');
                        errEl.textContent = '';
                    } else {
                        setState(field, 'invalid');
                        errEl.textContent = result.msg;
                        errEl.classList.add('is-visible');
                    }
                }

                /* ---------- STRENGTH + RULES ---------- */
                function scorePassword(v) {
                    var score = 0;
                    if (!v) return 0;
                    if (v.length >= 8) score++;
                    if (v.length >= 12) score++;
                    if (/[a-z]/.test(v) && /[A-Z]/.test(v)) score++;
                    if (/\d/.test(v)) score++;
                    if (/[^A-Za-z0-9]/.test(v)) score++;
                    return Math.min(4, score);
                }

                function updatePasswordUI() {
                    var v = pwdInput.value;

                    if (!v) {
                        strengthWrap.classList.remove('is-visible');
                        rulesWrap.classList.remove('is-visible');
                        return;
                    }
                    strengthWrap.classList.add('is-visible');
                    rulesWrap.classList.add('is-visible');

                    var score = scorePassword(v);
                    var labels = ['Very weak', 'Weak', 'Fair', 'Good', 'Strong'];
                    strengthSegs.forEach(function (seg, idx) {
                        seg.className = 'password-strength-seg';
                        if (idx < score) seg.classList.add('is-on', 'lvl-' + Math.max(1, score));
                    });
                    strengthLabel.textContent = labels[score] || '—';
                    strengthHint.textContent = score >= 3
                        ? 'Nice — this is secure.'
                        : 'Add length, case-mix & numbers.';

                    var checks = {
                        len: v.length >= 8,
                        lower: /[a-z]/.test(v),
                        upper: /[A-Z]/.test(v),
                        digit: /\d/.test(v)
                    };
                    Object.keys(checks).forEach(function (k) {
                        if (rules[k]) rules[k].classList.toggle('is-met', checks[k]);
                    });
                }

                /* ---------- INPUT WIRING ---------- */
                nameInput.addEventListener('blur', function () {
                    touched.name = true;
                    render(nameField, nameErr, vName(nameInput.value), true);
                });
                nameInput.addEventListener('input', function () {
                    if (touched.name) render(nameField, nameErr, vName(nameInput.value), true);
                });

                emailInput.addEventListener('blur', function () {
                    touched.email = true;
                    render(emailField, emailErr, vEmail(emailInput.value), true);
                });
                emailInput.addEventListener('input', function () {
                    if (touched.email) render(emailField, emailErr, vEmail(emailInput.value), true);
                });

                phoneInput.addEventListener('blur', function () {
                    touched.phone = true;
                    render(phoneField, phoneErr, vPhone(phoneInput.value), true);
                });
                phoneInput.addEventListener('input', function () {
                    if (touched.phone) render(phoneField, phoneErr, vPhone(phoneInput.value), true);
                });

                pwdInput.addEventListener('input', function () {
                    updatePasswordUI();
                    if (touched.pwd) render(pwdField, pwdErr, vPassword(pwdInput.value), true);
                    // Live re-check confirm when password changes
                    if (touched.confirm && confirmIn.value) {
                        render(confirmField, confirmErr, vConfirm(confirmIn.value), true);
                    }
                });
                pwdInput.addEventListener('blur', function () {
                    touched.pwd = true;
                    updatePasswordUI();
                    render(pwdField, pwdErr, vPassword(pwdInput.value), true);
                });

                confirmIn.addEventListener('input', function () {
                    if (touched.confirm) render(confirmField, confirmErr, vConfirm(confirmIn.value), true);
                });
                confirmIn.addEventListener('blur', function () {
                    touched.confirm = true;
                    render(confirmField, confirmErr, vConfirm(confirmIn.value), true);
                });

                termsInput.addEventListener('change', function () {
                    touched.terms = true;
                    var r = vTerms();
                    termsWrap.classList.toggle('is-invalid', !r.ok);
                    if (!r.ok) {
                        termsErr.textContent = r.msg;
                        termsErr.classList.add('is-visible');
                    } else {
                        termsErr.textContent = '';
                        termsErr.classList.remove('is-visible');
                    }
                });

                /* ---------- PASSWORD TOGGLES ---------- */
                document.querySelectorAll('[data-password-toggle]').forEach(function (btn) {
                    btn.addEventListener('click', function (e) {
                        e.preventDefault();
                        var wrap = btn.closest('.login-password-wrap');
                        var input = wrap ? wrap.querySelector('input') : null;
                        if (!input) return;
                        var show = input.type === 'password';
                        input.type = show ? 'text' : 'password';
                        btn.setAttribute('aria-label', show ? 'Hide password' : 'Show password');
                        btn.setAttribute('aria-pressed', show ? 'true' : 'false');
                        input.focus();
                    });
                });

                /* ---------- SUBMIT ---------- */
                form.addEventListener('submit', function (e) {
                    touched = { name: true, email: true, phone: true, pwd: true, confirm: true, terms: true };

                    var rName = vName(nameInput.value);
                    var rEmail = vEmail(emailInput.value);
                    var rPhone = vPhone(phoneInput.value);
                    var rPwd = vPassword(pwdInput.value);
                    var rConfirm = vConfirm(confirmIn.value);
                    var rTerms = vTerms();

                    render(nameField, nameErr, rName, true);
                    render(emailField, emailErr, rEmail, true);
                    render(phoneField, phoneErr, rPhone, true);
                    render(pwdField, pwdErr, rPwd, true);
                    render(confirmField, confirmErr, rConfirm, true);
                    updatePasswordUI();

                    termsWrap.classList.toggle('is-invalid', !rTerms.ok);
                    if (!rTerms.ok) {
                        termsErr.textContent = rTerms.msg;
                        termsErr.classList.add('is-visible');
                    } else {
                        termsErr.textContent = '';
                        termsErr.classList.remove('is-visible');
                    }

                    var firstInvalid =
                        !rName.ok ? nameInput :
                            !rEmail.ok ? emailInput :
                                !rPhone.ok ? phoneInput :
                                    !rPwd.ok ? pwdInput :
                                        !rConfirm.ok ? confirmIn :
                                            !rTerms.ok ? termsInput : null;

                    if (firstInvalid) {
                        e.preventDefault();
                        // Shake + focus first invalid
                        var fieldToShake = firstInvalid.closest('.login-field') || termsWrap;
                        fieldToShake.classList.remove('is-invalid');
                        void fieldToShake.offsetWidth;
                        fieldToShake.classList.add('is-invalid');
                        firstInvalid.focus();
                        try { firstInvalid.scrollIntoView({ behavior: 'smooth', block: 'center' }); } catch (_) { }
                        return false;
                    }

                    // Valid — loading state
                    submitBtn.classList.add('is-loading');
                    submitBtn.disabled = true;
                    submitBtn.querySelector('.label').textContent = 'Creating account…';
                });

                /* ---------- PROTOTYPE GUARD ---------- */
                document.querySelectorAll('a[data-prototype]').forEach(function (link) {
                    link.addEventListener('click', function (e) { e.preventDefault(); });
                });

                /* ---------- SERVER ERROR FADE ---------- */
                var serverError = document.getElementById('serverError');
                if (serverError) {
                    setTimeout(function () {
                        serverError.style.transition = 'opacity 0.5s ease, transform 0.5s ease';
                        serverError.style.opacity = '0';
                        serverError.style.transform = 'translateY(-6px)';
                        setTimeout(function () { serverError.remove(); }, 520);
                    }, 8000);
                }
            })();
    </script>

</body>
</html>