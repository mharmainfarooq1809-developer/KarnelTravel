@* Views/Account/Login.cshtml *@
@model KarnelTravel.ViewModels.CustomerLoginViewModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Sign in · Karnel Travel Guide</title>
    <meta name="robots" content="noindex, nofollow" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,300;9..144,400;9..144,500;9..144,600&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />

    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />

    <style>
            /* ============================================================
                       KARNEL — EDITORIAL SIGN-IN (login-only, v3)
                       No strength meter. No password rules. Just presence +
                       email format. Server owns credential correctness.
                    ============================================================ */

            :root {
                --k-ink: #0F1F17;
                --k-ink-2: #1B3329;
                --k-forest: #14271F;
                --k-sage: #8FA888;
                --k-parchment: #F6F2E9;
                --k-cream: #FBF8F1;
                --k-muted: #6B7A6E;
                --k-line: rgba(20, 39, 31, 0.12);
                --k-line-strong: rgba(20, 39, 31, 0.22);
                --k-danger: #B23B2E;
                --k-danger-soft: rgba(178, 59, 46, 0.06);
                --k-danger-line: rgba(178, 59, 46, 0.32);
                --k-radius: 10px;
            }

            html, body {
                height: 100%;
            }

            .admin-body {
                margin: 0;
                background: var(--k-parchment);
                color: var(--k-forest);
                font-family: 'Inter', system-ui, -apple-system, 'Segoe UI', sans-serif;
                -webkit-font-smoothing: antialiased;
                -moz-osx-font-smoothing: grayscale;
                text-rendering: optimizeLegibility;
            }

                .admin-body::before {
                    content: '';
                    position: fixed;
                    inset: 0;
                    pointer-events: none;
                    z-index: 0;
                    opacity: 0.35;
                    background-image: radial-gradient(rgba(20, 39, 31, 0.035) 1px, transparent 1px);
                    background-size: 3px 3px;
                }

                .admin-body .login-shell {
                    position: relative;
                    z-index: 1;
                    display: grid;
                    grid-template-columns: minmax(0, 54fr) minmax(0, 46fr);
                    min-height: 100vh;
                    min-height: 100dvh;
                }

                /* ---------- LEFT VISUAL ---------- */
                .admin-body .login-visual {
                    position: relative;
                    isolation: isolate;
                    overflow: hidden;
                    display: flex;
                    flex-direction: column;
                    justify-content: space-between;
                    gap: 48px;
                    padding: clamp(28px, 4.2vw, 64px);
                    background-color: var(--k-forest);
                    color: var(--k-cream);
                }

                    .admin-body .login-visual::before {
                        content: '';
                        position: absolute;
                        inset: 0;
                        z-index: -2;
                        background-color: var(--k-forest);
                        background-image: url('https://images.unsplash.com/photo-1605649487212-47bdab064df7?auto=format&fit=crop&w=1800&q=80'), url('https://images.unsplash.com/photo-1506905925346-21bda4d32df4?auto=format&fit=crop&w=1800&q=80');
                        background-repeat: no-repeat, no-repeat;
                        background-position: center center, center center;
                        background-size: cover, cover;
                        animation: kImageIn 1.8s cubic-bezier(0.16, 1, 0.3, 1) both;
                        will-change: transform;
                    }

                    .admin-body .login-visual::after {
                        content: '';
                        position: absolute;
                        inset: 0;
                        z-index: -1;
                        pointer-events: none;
                        background: linear-gradient(165deg, rgba(15,31,23,0.88) 0%, rgba(15,31,23,0.42) 46%, rgba(15,31,23,0.96) 100%), radial-gradient(ellipse 62% 52% at 14% 10%, rgba(143,168,136,0.22), transparent 62%);
                    }

                .admin-body .login-brand {
                    position: relative;
                    z-index: 1;
                    display: flex;
                    align-items: center;
                    gap: 14px;
                    animation: kFadeUp 0.9s cubic-bezier(0.16, 1, 0.3, 1) 0.15s both;
                }

                    .admin-body .login-brand .brand-mark {
                        display: inline-grid;
                        place-items: center;
                        width: 46px;
                        height: 46px;
                        flex: 0 0 auto;
                        border-radius: 50%;
                        border: 1px solid rgba(251, 248, 241, 0.42);
                        background: rgba(251, 248, 241, 0.07);
                        color: var(--k-cream);
                        font-family: 'Fraunces', Georgia, serif;
                        font-weight: 500;
                        font-size: 1.35rem;
                        line-height: 1;
                        backdrop-filter: blur(4px);
                    }

                    .admin-body .login-brand strong {
                        display: block;
                        font-size: 0.78rem;
                        font-weight: 600;
                        letter-spacing: 0.28em;
                        text-transform: uppercase;
                        line-height: 1.2;
                        color: var(--k-cream);
                    }

                    .admin-body .login-brand small {
                        display: block;
                        margin-top: 5px;
                        font-size: 0.58rem;
                        font-weight: 500;
                        letter-spacing: 0.24em;
                        text-transform: uppercase;
                        color: rgba(251, 248, 241, 0.6);
                    }

                .admin-body .login-visual-foot {
                    position: relative;
                    z-index: 1;
                    display: flex;
                    flex-direction: column;
                    gap: 34px;
                    max-width: 580px;
                }

                .admin-body .login-quote {
                    animation: kFadeUp 1s cubic-bezier(0.16, 1, 0.3, 1) 0.35s both;
                }

                    .admin-body .login-quote h2 {
                        margin: 0 0 18px;
                        font-family: 'Fraunces', Georgia, serif;
                        font-weight: 400;
                        font-size: clamp(1.75rem, 3vw, 2.8rem);
                        line-height: 1.06;
                        letter-spacing: -0.018em;
                        color: var(--k-cream);
                        text-wrap: balance;
                    }

                        .admin-body .login-quote h2 em {
                            font-style: italic;
                            color: rgba(143, 168, 136, 0.95);
                        }

                    .admin-body .login-quote p {
                        margin: 0;
                        max-width: 46ch;
                        font-size: 0.95rem;
                        line-height: 1.75;
                        color: rgba(251, 248, 241, 0.78);
                    }

                .admin-body .login-signature {
                    display: flex;
                    align-items: center;
                    gap: 14px;
                    margin: 0;
                    padding-top: 22px;
                    border-top: 1px solid rgba(251, 248, 241, 0.16);
                    font-size: 0.6rem;
                    font-weight: 600;
                    letter-spacing: 0.26em;
                    text-transform: uppercase;
                    color: rgba(251, 248, 241, 0.62);
                    animation: kFadeUp 1s cubic-bezier(0.16, 1, 0.3, 1) 0.5s both;
                }

                    .admin-body .login-signature::before {
                        content: '';
                        width: 26px;
                        height: 1px;
                        background: rgba(143, 168, 136, 0.8);
                    }

                /* ---------- RIGHT FORM ---------- */
                .admin-body .login-form-wrap {
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    padding: clamp(34px, 5vw, 80px) clamp(24px, 4.4vw, 72px);
                    background: var(--k-parchment);
                    animation: kFormIn 0.95s cubic-bezier(0.16, 1, 0.3, 1) 0.2s both;
                }

                .admin-body .login-form {
                    width: 100%;
                    max-width: 448px;
                }

                    .admin-body .login-form .eyebrow {
                        display: inline-flex;
                        align-items: center;
                        gap: 12px;
                        margin: 0 0 18px;
                        font-size: 0.6rem;
                        font-weight: 600;
                        letter-spacing: 0.28em;
                        text-transform: uppercase;
                        color: var(--k-sage);
                    }

                        .admin-body .login-form .eyebrow::before {
                            content: '';
                            width: 26px;
                            height: 1px;
                            flex: 0 0 auto;
                            background: currentColor;
                            opacity: 0.9;
                        }

                    .admin-body .login-form h1 {
                        margin: 0 0 12px;
                        font-family: 'Fraunces', Georgia, serif;
                        font-weight: 400;
                        font-size: clamp(2.1rem, 3.4vw, 2.85rem);
                        line-height: 1.02;
                        letter-spacing: -0.026em;
                        color: var(--k-ink);
                        text-wrap: balance;
                    }

                    .admin-body .login-form .login-lede {
                        margin: 0 0 30px;
                        font-size: 0.94rem;
                        line-height: 1.65;
                        color: var(--k-muted);
                    }

                    .admin-body .login-form .login-link {
                        color: var(--k-ink);
                        font-weight: 600;
                        text-decoration: underline;
                        text-decoration-thickness: 1px;
                        text-decoration-color: rgba(143, 168, 136, 0.65);
                        text-underline-offset: 3px;
                        transition: text-decoration-color 0.3s ease;
                    }

                        .admin-body .login-form .login-link:hover {
                            text-decoration-color: var(--k-sage);
                        }

                    /* ---------- TOP-LEVEL ERROR BANNER ---------- */
                    .admin-body .login-form .login-error {
                        display: flex;
                        align-items: flex-start;
                        gap: 12px;
                        margin: 0 0 26px;
                        padding: 14px 16px;
                        border: 1px solid var(--k-danger-line);
                        border-left: 3px solid var(--k-danger);
                        border-radius: var(--k-radius);
                        background: var(--k-danger-soft);
                        color: #6b2018;
                        font-size: 0.86rem;
                        line-height: 1.55;
                        animation: kShake 0.55s cubic-bezier(0.36, 0.07, 0.19, 0.97) both;
                    }

                        .admin-body .login-form .login-error svg {
                            flex: 0 0 auto;
                            margin-top: 1px;
                            color: var(--k-danger);
                        }

                        .admin-body .login-form .login-error > div > div + div {
                            margin-top: 4px;
                        }

                    /* ---------- FIELDS ---------- */
                    .admin-body .login-form .login-field {
                        display: flex;
                        flex-direction: column;
                        gap: 8px;
                        margin-bottom: 20px;
                    }

                        .admin-body .login-form .login-field label {
                            font-size: 0.6rem;
                            font-weight: 600;
                            letter-spacing: 0.2em;
                            text-transform: uppercase;
                            color: rgba(15, 31, 23, 0.62);
                        }

                    .admin-body .login-form .input {
                        width: 100%;
                        height: 56px;
                        padding: 0 16px;
                        border: 1px solid var(--k-line);
                        border-radius: var(--k-radius);
                        background: var(--k-cream);
                        color: var(--k-ink);
                        font: inherit;
                        font-size: 0.95rem;
                        box-shadow: 0 1px 0 rgba(255,255,255,0.9) inset, 0 1px 2px rgba(20,39,31,0.04);
                        transition: border-color 0.24s ease, box-shadow 0.24s ease, background 0.24s ease;
                    }

                        .admin-body .login-form .input::placeholder {
                            color: rgba(15, 31, 23, 0.32);
                        }

                        .admin-body .login-form .input:hover {
                            border-color: var(--k-line-strong);
                        }

                        .admin-body .login-form .input:focus {
                            outline: none;
                            border-color: var(--k-ink);
                            background: #FFFFFF;
                            box-shadow: 0 0 0 3px rgba(143, 168, 136, 0.28);
                        }

                    .admin-body .login-form .login-field.is-invalid .input {
                        border-color: var(--k-danger);
                        background: #FFF9F8;
                        box-shadow: 0 0 0 3px rgba(178, 59, 46, 0.1);
                    }

                        .admin-body .login-form .login-field.is-invalid .input:focus {
                            box-shadow: 0 0 0 3px rgba(178, 59, 46, 0.16);
                        }

                    /* ---------- INLINE FIELD ERROR ---------- */
                    .admin-body .login-form .field-error {
                        display: none;
                        align-items: flex-start;
                        gap: 6px;
                        margin-top: 2px;
                        font-size: 0.78rem;
                        font-weight: 500;
                        line-height: 1.45;
                        color: var(--k-danger);
                    }

                        .admin-body .login-form .field-error::before {
                            content: '⚠';
                            font-size: 0.78rem;
                            line-height: 1.4;
                        }

                        .admin-body .login-form .login-field.is-invalid .field-error,
                        .admin-body .login-form .field-error.is-visible {
                            display: flex;
                            animation: kErrorIn 0.35s cubic-bezier(0.16, 1, 0.3, 1) both;
                        }

                /* ---------- PASSWORD TOGGLE ---------- */
                .admin-body .login-password-wrap {
                    position: relative;
                }

                    .admin-body .login-password-wrap .input {
                        padding-right: 54px;
                    }

                .admin-body .login-password-toggle {
                    position: absolute;
                    top: 50%;
                    right: 7px;
                    transform: translateY(-50%);
                    display: grid;
                    place-items: center;
                    width: 42px;
                    height: 42px;
                    border: 0;
                    border-radius: 8px;
                    background: transparent;
                    color: rgba(15, 31, 23, 0.48);
                    cursor: pointer;
                    transition: color 0.24s ease, background 0.24s ease;
                }

                    .admin-body .login-password-toggle:hover {
                        color: var(--k-ink);
                        background: rgba(15, 31, 23, 0.06);
                    }

                    .admin-body .login-password-toggle:focus-visible {
                        outline: 2px solid var(--k-sage);
                        outline-offset: 1px;
                    }

                    .admin-body .login-password-toggle .icon-eye-off {
                        display: none;
                    }

                    .admin-body .login-password-toggle[aria-pressed="true"] .icon-eye {
                        display: none;
                    }

                    .admin-body .login-password-toggle[aria-pressed="true"] .icon-eye-off {
                        display: block;
                    }

                /* ---------- REMEMBER / FORGOT ---------- */
                .admin-body .login-form .login-row {
                    display: flex;
                    flex-wrap: wrap;
                    align-items: center;
                    justify-content: space-between;
                    gap: 12px;
                    margin: 6px 0 28px;
                }

                .admin-body .login-form .login-check {
                    display: inline-flex;
                    align-items: center;
                    gap: 10px;
                    font-size: 0.82rem;
                    color: rgba(15, 31, 23, 0.76);
                    cursor: pointer;
                    user-select: none;
                }

                    .admin-body .login-form .login-check input[type="checkbox"] {
                        appearance: none;
                        -webkit-appearance: none;
                        width: 18px;
                        height: 18px;
                        margin: 0;
                        border: 1px solid var(--k-line-strong);
                        border-radius: 4px;
                        background: var(--k-cream);
                        cursor: pointer;
                        position: relative;
                        transition: border-color 0.24s ease, background 0.24s ease;
                    }

                        .admin-body .login-form .login-check input[type="checkbox"]:hover {
                            border-color: var(--k-ink);
                        }

                        .admin-body .login-form .login-check input[type="checkbox"]:checked {
                            background: var(--k-ink);
                            border-color: var(--k-ink);
                        }

                            .admin-body .login-form .login-check input[type="checkbox"]:checked::after {
                                content: '';
                                position: absolute;
                                top: 2px;
                                left: 5px;
                                width: 5px;
                                height: 9px;
                                border: solid var(--k-cream);
                                border-width: 0 2px 2px 0;
                                transform: rotate(45deg);
                            }

                        .admin-body .login-form .login-check input[type="checkbox"]:focus-visible {
                            outline: 2px solid var(--k-sage);
                            outline-offset: 2px;
                        }

                .admin-body .login-form .login-row > a {
                    font-size: 0.82rem;
                    color: rgba(15, 31, 23, 0.76);
                    text-decoration: underline;
                    text-decoration-thickness: 1px;
                    text-decoration-color: rgba(143, 168, 136, 0.55);
                    text-underline-offset: 3px;
                    transition: text-decoration-color 0.3s ease;
                }

                    .admin-body .login-form .login-row > a:hover {
                        text-decoration-color: var(--k-sage);
                    }

                /* ---------- SUBMIT ---------- */
                .admin-body .login-form .login-submit {
                    position: relative;
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    gap: 10px;
                    width: 100%;
                    height: 56px;
                    padding: 0 26px;
                    border: 0;
                    border-radius: var(--k-radius);
                    background: var(--k-ink);
                    color: var(--k-cream);
                    font-family: 'Inter', system-ui, sans-serif;
                    font-size: 0.72rem;
                    font-weight: 600;
                    letter-spacing: 0.2em;
                    text-transform: uppercase;
                    cursor: pointer;
                    overflow: hidden;
                    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1), background 0.3s ease, box-shadow 0.35s cubic-bezier(0.16, 1, 0.3, 1);
                }

                    .admin-body .login-form .login-submit::before {
                        content: '';
                        position: absolute;
                        inset: 0;
                        background: linear-gradient(120deg, transparent 30%, rgba(143,168,136,0.2) 50%, transparent 70%);
                        transform: translateX(-100%);
                        transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
                    }

                    .admin-body .login-form .login-submit:hover::before {
                        transform: translateX(100%);
                    }

                    .admin-body .login-form .login-submit:hover {
                        background: var(--k-ink-2);
                        transform: translateY(-2px);
                        box-shadow: 0 16px 30px -18px rgba(15, 31, 23, 0.7);
                    }

                    .admin-body .login-form .login-submit:active {
                        transform: translateY(0);
                    }

                    .admin-body .login-form .login-submit:focus-visible {
                        outline: 2px solid var(--k-sage);
                        outline-offset: 3px;
                    }

                    .admin-body .login-form .login-submit:disabled {
                        opacity: 0.6;
                        cursor: not-allowed;
                        transform: none;
                        box-shadow: none;
                    }

                    .admin-body .login-form .login-submit .label,
                    .admin-body .login-form .login-submit .spinner,
                    .admin-body .login-form .login-submit .login-submit-arrow {
                        position: relative;
                        z-index: 1;
                    }

                    .admin-body .login-form .login-submit .spinner {
                        display: none;
                        width: 16px;
                        height: 16px;
                        border: 2px solid rgba(251, 248, 241, 0.35);
                        border-top-color: var(--k-cream);
                        border-radius: 50%;
                        animation: kSpin 0.7s linear infinite;
                    }

                    .admin-body .login-form .login-submit.is-loading .spinner {
                        display: block;
                    }

                    .admin-body .login-form .login-submit.is-loading .login-submit-arrow {
                        display: none;
                    }

                .admin-body .login-form .login-submit-arrow {
                    display: inline-block;
                    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
                }

                .admin-body .login-form .login-submit:hover .login-submit-arrow {
                    transform: translateX(3px);
                }

                /* ---------- RESTRICTED NOTE ---------- */
                .admin-body .login-restricted {
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    gap: 10px;
                    margin: 18px 0 0;
                    font-size: 0.6rem;
                    font-weight: 600;
                    letter-spacing: 0.22em;
                    text-transform: uppercase;
                    color: rgba(15, 31, 23, 0.42);
                }

                    .admin-body .login-restricted::before,
                    .admin-body .login-restricted::after {
                        content: '';
                        height: 1px;
                        flex: 1 1 auto;
                        max-width: 46px;
                        background: var(--k-line);
                    }

                /* ---------- FOOTER ---------- */
                .admin-body .login-form .login-foot {
                    margin: 26px 0 0;
                    padding-top: 20px;
                    border-top: 1px solid var(--k-line);
                    font-size: 0.72rem;
                    line-height: 1.65;
                    color: rgba(15, 31, 23, 0.5);
                }

                .admin-body .login-form .login-foot-link {
                    margin-top: 14px;
                    padding-top: 0;
                    border-top: 0;
                }

            /* ---------- ANIMATIONS ---------- */
            @@keyframes kImageIn {
                from {
                    opacity: 0;
                    transform: scale(1.08);
                }

                to {
                    opacity: 1;
                    transform: scale(1);
                }
            }

            @@keyframes kFadeUp {
                from {
                    opacity: 0;
                    transform: translateY(16px);
                }

                to {
                    opacity: 1;
                    transform: translateY(0);
                }
            }

            @@keyframes kFormIn {
                from {
                    opacity: 0;
                    transform: translateY(14px);
                }

                to {
                    opacity: 1;
                    transform: translateY(0);
                }
            }

            @@keyframes kErrorIn {
                from {
                    opacity: 0;
                    transform: translateY(-3px);
                }

                to {
                    opacity: 1;
                    transform: translateY(0);
                }
            }

            @@keyframes kShake {
                0%, 100% {
                    transform: translateX(0);
                }

                15%, 55%, 85% {
                    transform: translateX(-3px);
                }

                35%, 75% {
                    transform: translateX(3px);
                }
            }

            @@keyframes kSpin {
                to {
                    transform: rotate(360deg);
                }
            }

            /* ---------- RESPONSIVE ---------- */
            @@media (max-width: 1180px) {
                .admin-body .login-shell {
                    grid-template-columns: minmax(0, 52fr) minmax(0, 48fr);
                }

                .admin-body .login-visual {
                    padding: clamp(26px, 3.6vw, 46px);
                }
            }

            @@media (max-width: 980px) {
                .admin-body .login-shell {
                    grid-template-columns: minmax(0, 50fr) minmax(0, 50fr);
                }

                .admin-body .login-quote h2 {
                    font-size: clamp(1.5rem, 3.4vw, 2.05rem);
                }

                .admin-body .login-quote p {
                    font-size: 0.9rem;
                }

                .admin-body .login-form h1 {
                    font-size: clamp(1.8rem, 4vw, 2.3rem);
                }
            }

            @@media (max-width: 860px) {
                .admin-body .login-shell {
                    grid-template-columns: minmax(0, 1fr);
                }

                .admin-body .login-visual {
                    min-height: 320px;
                    padding: 26px 24px 32px;
                    gap: 28px;
                }

                .admin-body .login-visual-foot {
                    gap: 20px;
                }

                .admin-body .login-quote h2 {
                    font-size: clamp(1.4rem, 5.4vw, 1.95rem);
                    margin-bottom: 12px;
                }

                .admin-body .login-quote p {
                    font-size: 0.88rem;
                    line-height: 1.6;
                }

                .admin-body .login-signature {
                    padding-top: 16px;
                    font-size: 0.54rem;
                    letter-spacing: 0.22em;
                }

                .admin-body .login-form-wrap {
                    align-items: flex-start;
                    padding: 38px 22px 48px;
                }

                .admin-body .login-form {
                    max-width: 100%;
                }
            }

            @@media (max-width: 420px) {
                .admin-body .login-visual {
                    min-height: 280px;
                    padding: 22px 20px 26px;
                }

                .admin-body .login-form .login-row {
                    margin-bottom: 24px;
                }

                .admin-body .login-form h1 {
                    font-size: 1.85rem;
                }
            }

            @@media (prefers-reduced-motion: reduce) {
                .admin-body .login-visual::before,
                .admin-body .login-brand,
                .admin-body .login-quote,
                .admin-body .login-signature,
                .admin-body .login-form-wrap,
                .admin-body .login-form .login-submit,
                .admin-body .login-form .login-submit-arrow,
                .admin-body .login-form .input,
                .admin-body .login-password-toggle,
                .admin-body .login-form .login-error,
                .admin-body .login-form .field-error {
                    animation: none !important;
                    transition: none !important;
                }
            }
    </style>
</head>
<body class="admin-body">

    <div class="login-shell">

        <!-- ============ VISUAL SIDE ============ -->
        <aside class="login-visual">
            <div class="login-brand">
                <span class="brand-mark" aria-hidden="true">K</span>
                <span>
                    <strong>Karnel</strong>
                    <small>Travel Guide</small>
                </span>
            </div>

            <div class="login-visual-foot">
                <div class="login-quote">
                    <h2>Every journey deserves a <em>well-kept</em> plan.</h2>
                    <p>
                        A connected platform for managing destinations, stays,
                        transport and experiences — built for the discerning traveller.
                    </p>
                </div>
                <p class="login-signature">Destinations · Stays · Experiences</p>
            </div>
        </aside>

        <!-- ============ FORM SIDE ============ -->
        <section class="login-form-wrap">
            <form class="login-form"
                  id="loginForm"
                  method="post"
                  asp-controller="Account"
                  asp-action="Login"
                  novalidate>

                @Html.AntiForgeryToken()
                <input asp-for="ReturnUrl" type="hidden" />

                <p class="eyebrow">Karnel / Account access</p>
                <h1>Welcome back.</h1>
                <p class="login-lede">
                    Your travel plans, all in one place. Sign in to continue.
                </p>

                @* ---- Server-side error banner (bad credentials, lockout, etc.) ---- *@
                @{
                    var serverErrors = ViewData.ModelState.Values
                        .SelectMany(v => v.Errors)
                        .Select(e => e.ErrorMessage)
                        .Where(m => !string.IsNullOrWhiteSpace(m))
                        .ToList();
                    var fieldKeys = new[] { "Email", "Password" };
                    var generalErrors = ViewData.ModelState
                        .Where(kv => !fieldKeys.Contains(kv.Key, StringComparer.OrdinalIgnoreCase))
                        .SelectMany(kv => kv.Value.Errors)
                        .Select(e => e.ErrorMessage)
                        .Where(m => !string.IsNullOrWhiteSpace(m))
                        .ToList();
                }
                @if (generalErrors.Any())
                {
                    <div class="login-error" role="alert" id="serverError">
                        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor"
                             stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <circle cx="12" cy="12" r="9" />
                            <path d="M12 8v5" />
                            <path d="M12 16h.01" />
                        </svg>
                        <div>
                            @foreach (var msg in generalErrors)
                            {
                                <div>@msg</div>
                            }
                        </div>
                    </div>
                }

                <!-- ===== EMAIL ===== -->
                <div class="login-field" id="emailField">
                    <label for="email">Email address</label>
                    <input class="input"
                           id="email"
                           asp-for="Email"
                           type="email"
                           name="Email"
                           placeholder="you@karneltravel.co.za"
                           autocomplete="username"
                           inputmode="email"
                           spellcheck="false"
                           autocapitalize="off"
                           autofocus />
                    <span class="field-error" id="emailError" role="alert" aria-live="polite"></span>
                    @if (ViewData.ModelState.TryGetValue("Email", out var emailState) && emailState.Errors.Any())
                    {
                        <span class="field-error is-visible">@emailState.Errors.First().ErrorMessage</span>
                    }
                </div>

                <!-- ===== PASSWORD ===== -->
                <div class="login-field" id="passwordField">
                    <label for="password">Password</label>
                    <div class="login-password-wrap">
                        <input class="input"
                               id="password"
                               asp-for="Password"
                               type="password"
                               name="Password"
                               placeholder="Enter your password"
                               autocomplete="current-password" />
                        <button type="button"
                                class="login-password-toggle"
                                aria-label="Show password"
                                aria-pressed="false"
                                data-password-toggle>
                            <svg class="icon-eye" viewBox="0 0 24 24" width="17" height="17" fill="none"
                                 stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"
                                 aria-hidden="true">
                                <path d="M2 12s3.6-6.5 10-6.5S22 12 22 12s-3.6 6.5-10 6.5S2 12 2 12Z" />
                                <circle cx="12" cy="12" r="2.6" />
                            </svg>
                            <svg class="icon-eye-off" viewBox="0 0 24 24" width="17" height="17" fill="none"
                                 stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"
                                 aria-hidden="true">
                                <path d="M3 3l18 18" />
                                <path d="M10.6 5.6A9.7 9.7 0 0 1 12 5.5c6.4 0 10 6.5 10 6.5a17.2 17.2 0 0 1-3.1 4" />
                                <path d="M6.5 6.9A17.2 17.2 0 0 0 2 12s3.6 6.5 10 6.5a9.6 9.6 0 0 0 4.3-1" />
                                <path d="M9.9 9.9a3 3 0 0 0 4.2 4.2" />
                            </svg>
                        </button>
                    </div>
                    <span class="field-error" id="passwordError" role="alert" aria-live="polite"></span>
                    @if (ViewData.ModelState.TryGetValue("Password", out var pwdState) && pwdState.Errors.Any())
                    {
                        <span class="field-error is-visible">@pwdState.Errors.First().ErrorMessage</span>
                    }
                </div>

                <div class="login-row">
                    <label class="login-check">
                        <input type="checkbox" asp-for="RememberMe" name="RememberMe" value="true" />
                        Remember me for 14 days
                    </label>
                    <a asp-controller="Account" asp-action="ForgotPassword">Forgot password?</a>
                </div>

                <button type="submit" class="login-submit" id="loginSubmit">
                    <span class="spinner" aria-hidden="true"></span>
                    <span class="label">Sign in to Karnel</span>
                    <span class="login-submit-arrow" aria-hidden="true">→</span>
                </button>

                <p class="login-restricted">Secure account access</p>

                <p class="login-foot">
                    Protected area. Access is logged and monitored.<br />
                    &copy; @DateTime.UtcNow.Year Karnel Travel Guide
                </p>

                <p class="login-foot login-foot-link">
                    Need an account?
                    <a class="login-link" asp-controller="Account" asp-action="Register">Sign up</a>
                </p>
            </form>
        </section>

    </div>

    <script>
            /* ============================================================
               KARNEL LOGIN — VALIDATION
               LOGIN-ONLY rules:
                 • Email: required + valid format
                 • Password: required (no length/complexity — that's
                   registration, and telling a returning user their
                   existing password is "too short" is bad UX + leaks
                   policy)
                 • Credential correctness = server's job (generalErrors)
            ============================================================ */
            (function () {
                'use strict';

                var form = document.getElementById('loginForm');
                if (!form) return;

                var emailInput = document.getElementById('email');
                var passwordInput = document.getElementById('password');
                var emailField = document.getElementById('emailField');
                var passwordField = document.getElementById('passwordField');
                var emailError = document.getElementById('emailError');
                var passwordError = document.getElementById('passwordError');
                var submitBtn = document.getElementById('loginSubmit');
                var touched = { email: false, password: false };

                function setFieldState(field, state) {
                    field.classList.remove('is-invalid');
                    if (state === 'invalid') field.classList.add('is-invalid');
                }

                function validateEmail(value) {
                    var v = (value || '').trim();
                    if (!v) return { valid: false, message: 'Please enter your email address.' };
                    if (v.length > 254) return { valid: false, message: 'That email address is too long.' };
                    if (/\s/.test(v)) return { valid: false, message: 'Email address cannot contain spaces.' };
                    var re = /^[^\s@@]+@@[^\s@@]+\.[^\s@@]{2,}$/;
                    if (!re.test(v)) return { valid: false, message: 'Please enter a valid email address.' };
                    return { valid: true, message: '' };
                }

                function validatePassword(value) {
                    if (!value) return { valid: false, message: 'Please enter your password.' };
                    return { valid: true, message: '' };
                }

                function showEmailResult(force) {
                    var result = validateEmail(emailInput.value);
                    var shouldShow = force || touched.email;
                    if (shouldShow) {
                        setFieldState(emailField, result.valid ? '' : 'invalid');
                        emailError.textContent = result.message;
                    } else {
                        setFieldState(emailField, '');
                        emailError.textContent = '';
                    }
                    return result.valid;
                }

                function showPasswordResult(force) {
                    var result = validatePassword(passwordInput.value);
                    var shouldShow = force || touched.password;
                    if (shouldShow) {
                        setFieldState(passwordField, result.valid ? '' : 'invalid');
                        passwordError.textContent = result.message;
                    } else {
                        setFieldState(passwordField, '');
                        passwordError.textContent = '';
                    }
                    return result.valid;
                }

                emailInput.addEventListener('blur', function () {
                    touched.email = true;
                    showEmailResult(true);
                });
                emailInput.addEventListener('input', function () {
                    if (touched.email) showEmailResult(false);
                });

                passwordInput.addEventListener('blur', function () {
                    touched.password = true;
                    showPasswordResult(true);
                });
                passwordInput.addEventListener('input', function () {
                    if (touched.password) showPasswordResult(false);
                });

                /* Password visibility */
                document.querySelectorAll('[data-password-toggle]').forEach(function (btn) {
                    btn.addEventListener('click', function (e) {
                        e.preventDefault();
                        var wrap = btn.closest('.login-password-wrap');
                        var input = wrap ? wrap.querySelector('input') : null;
                        if (!input) return;
                        var show = input.type === 'password';
                        input.type = show ? 'text' : 'password';
                        btn.setAttribute('aria-label', show ? 'Hide password' : 'Show password');
                        btn.setAttribute('aria-pressed', show ? 'true' : 'false');
                        input.focus();
                    });
                });

                form.addEventListener('submit', function (e) {
                    touched.email = true;
                    touched.password = true;

                    var emailOk = showEmailResult(true);
                    var pwdOk = showPasswordResult(true);

                    if (!emailOk || !pwdOk) {
                        e.preventDefault();
                        if (!emailOk) {
                            emailField.classList.remove('is-invalid');
                            void emailField.offsetWidth;
                            emailField.classList.add('is-invalid');
                            emailInput.focus();
                        } else {
                            passwordField.classList.remove('is-invalid');
                            void passwordField.offsetWidth;
                            passwordField.classList.add('is-invalid');
                            passwordInput.focus();
                        }
                        return false;
                    }

                    submitBtn.classList.add('is-loading');
                    submitBtn.disabled = true;
                    submitBtn.querySelector('.label').textContent = 'Signing in…';
                });

                /* Prototype link guard */
                document.querySelectorAll('a[data-prototype]').forEach(function (link) {
                    link.addEventListener('click', function (e) { e.preventDefault(); });
                });

                /* Fade server error banner after a while */
                var serverError = document.getElementById('serverError');
                if (serverError) {
                    setTimeout(function () {
                        serverError.style.transition = 'opacity 0.5s ease, transform 0.5s ease';
                        serverError.style.opacity = '0';
                        serverError.style.transform = 'translateY(-6px)';
                        setTimeout(function () { serverError.remove(); }, 520);
                    }, 8000);
                }
            })();
    </script>

</body>
</html>