@* Views/Account/Login.cshtml *@
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Sign in · Karnel Travel Guide Admin</title>
    <meta name="robots" content="noindex, nofollow" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display&family=DM+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />

    <link rel="stylesheet" href="~/css/admin/admin.css" asp-append-version="true" />
</head>
<body class="admin-body">

    <div class="login-shell">

        <!-- ============ VISUAL SIDE ============ -->
        <aside class="login-visual">
            <div class="login-brand">
                <span class="brand-mark">K</span>
                <span>
                    <strong>Karnel</strong>
                    <small>Travel Guide</small>
                </span>
            </div>

            <div class="login-quote">
                <p class="eyebrow">Operations · Admin</p>
                <h2>Every journey begins with a quiet room and a well-kept plan.</h2>
                <p>Sign in to manage destinations, stays, experiences, and the travellers who bring them to life.</p>
                <div class="login-quote-meta">
                    <span>24 regions</span>
                    <span>104 listings</span>
                    <span>1,284 bookings</span>
                </div>
            </div>
        </aside>

        <!-- ============ FORM SIDE ============ -->
        <section class="login-form-wrap">
            <form class="login-form"
                  method="post"
                  asp-controller="Account"
                  asp-action="Login"
                  novalidate>

                @Html.AntiForgeryToken()
                <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />

                <p class="eyebrow">Welcome back</p>
                <h1>Sign in to Karnel.</h1>
                <p>Use your admin credentials to continue to the operations workspace.</p>

                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="login-error" role="alert">
                        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor"
                             stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <circle cx="12" cy="12" r="9" />
                            <path d="M12 8v5" />
                            <path d="M12 16h.01" />
                        </svg>
                        <div>
                            @foreach (var err in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                            {
                                <div>@err.ErrorMessage</div>
                            }
                        </div>
                    </div>
                }

                <div class="login-field">
                    <label for="email">Email</label>
                    <input class="input"
                           id="email"
                           name="email"
                           type="email"
                           value="@ViewData["Email"]"
                           placeholder="you@karneltravel.co.za"
                           autocomplete="username"
                           required
                           autofocus />
                </div>

                <div class="login-field">
                    <label for="password">Password</label>
                    <div class="login-password-wrap">
                        <input class="input"
                               id="password"
                               name="password"
                               type="password"
                               placeholder="Enter your password"
                               autocomplete="current-password"
                               required />
                        <button type="button"
                                class="login-password-toggle"
                                aria-label="Show password"
                                data-password-toggle>
                            <svg viewBox="0 0 24 24" width="17" height="17" fill="none"
                                 stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M2 12s3.6-6.5 10-6.5S22 12 22 12s-3.6 6.5-10 6.5S2 12 2 12Z" />
                                <circle cx="12" cy="12" r="2.6" />
                            </svg>
                        </button>
                    </div>
                </div>

                <div class="login-row">
                    <label class="login-check">
                        <input type="checkbox"
                               name="rememberMe"
                               value="true"
                               @(ViewData["RememberMe"] is true ? "checked" : "") />
                        Remember me for 14 days
                    </label>
                    <a href="#" data-prototype="Password reset is design-only until email delivery is configured.">
                        Forgot password?
                    </a>
                </div>

                <button type="submit" class="btn btn-primary login-submit">
                    Sign in
                </button>

                <div class="login-demo">
                    <strong>Demo credentials</strong>
                    <p>amara@karneltravel.co.za</p>
                    <p>Karnel!2025</p>
                </div>

                <p class="login-foot">
                    Protected area. Access is logged and monitored.<br />
                    &copy; @DateTime.UtcNow.Year Karnel Travel Guide
                </p>
            </form>
        </section>

    </div>

    <script>
        document.querySelectorAll('[data-password-toggle]').forEach(function (btn) {
            btn.addEventListener('click', function () {
                var input = btn.parentElement.querySelector('input');
                var show = input.type === 'password';
                input.type = show ? 'text' : 'password';
                btn.setAttribute('aria-label', show ? 'Hide password' : 'Show password');
            });
        });
    </script>

</body>
</html>