@model KarnelTravel.ViewModels.ForgotPasswordViewModel
@{ Layout = "_Layout"; ViewData["Title"] = "Forgot password"; }
<section class="page-section"><div class="container"><h1>Reset your password</h1><p>Enter your email and we will send a six-digit reset code if an account exists.</p><form method="post" asp-controller="Account" asp-action="ForgotPassword">@Html.AntiForgeryToken() <div asp-validation-summary="ModelOnly"></div><label asp-for="Email"></label><input asp-for="Email" type="email" autocomplete="email" /><span asp-validation-for="Email"></span><button type="submit">Send reset code</button></form></div></section>
