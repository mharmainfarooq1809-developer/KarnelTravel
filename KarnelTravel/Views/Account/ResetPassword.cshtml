@* Views/Account/ResetPassword.cshtml *@
@model KarnelTravel.ViewModels.ResetPasswordViewModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Reset password · Karnel Travel Guide</title>
    <meta name="robots" content="noindex, nofollow" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,300;9..144,400;9..144,500;9..144,600&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />

    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />

    <style>
            /* ============================================================
                       KARNEL — EDITORIAL PASSWORD RESET (v1)
                       Hybrid validation:
                         • Email:    required + valid format (same email that
                                     received the code)
                         • Code:     6 numeric digits
                         • Password: registration-grade rules (8–128, mixed case,
                                     digit) + live strength meter + rule checklist
                         • Confirm:  must match Password
                       Server owns: is code still valid / has it expired?
                    ============================================================ */

            :root {
                --k-ink: #0F1F17;
                --k-ink-2: #1B3329;
                --k-forest: #14271F;
                --k-sage: #8FA888;
                --k-parchment: #F6F2E9;
                --k-cream: #FBF8F1;
                --k-muted: #6B7A6E;
                --k-line: rgba(20, 39, 31, 0.12);
                --k-line-strong: rgba(20, 39, 31, 0.22);
                --k-danger: #B23B2E;
                --k-danger-soft: rgba(178, 59, 46, 0.06);
                --k-danger-line: rgba(178, 59, 46, 0.32);
                --k-success: #3D7A4F;
                --k-success-soft: rgba(61, 122, 79, 0.08);
                --k-success-line: rgba(61, 122, 79, 0.28);
                --k-radius: 10px;
            }

            html, body {
                height: 100%;
            }

            .admin-body {
                margin: 0;
                background: var(--k-parchment);
                color: var(--k-forest);
                font-family: 'Inter', system-ui, -apple-system, 'Segoe UI', sans-serif;
                -webkit-font-smoothing: antialiased;
                -moz-osx-font-smoothing: grayscale;
                text-rendering: optimizeLegibility;
            }

                .admin-body::before {
                    content: '';
                    position: fixed;
                    inset: 0;
                    pointer-events: none;
                    z-index: 0;
                    opacity: 0.35;
                    background-image: radial-gradient(rgba(20, 39, 31, 0.035) 1px, transparent 1px);
                    background-size: 3px 3px;
                }

                /* ---------- SPLIT SHELL ---------- */
                .admin-body .login-shell {
                    position: relative;
                    z-index: 1;
                    display: grid;
                    grid-template-columns: minmax(0, 54fr) minmax(0, 46fr);
                    align-items: start;
                    min-height: 100vh;
                    min-height: 100dvh;
                }

                /* ---------- LEFT VISUAL ---------- */
                .admin-body .login-visual {
                    position: sticky;
                    top: 0;
                    align-self: start;
                    height: 100vh;
                    height: 100dvh;
                    isolation: isolate;
                    overflow: hidden;
                    display: flex;
                    flex-direction: column;
                    justify-content: space-between;
                    gap: 48px;
                    padding: clamp(28px, 4.2vw, 64px);
                    background-color: var(--k-forest);
                    color: var(--k-cream);
                }

                    .admin-body .login-visual::before {
                        content: '';
                        position: absolute;
                        inset: 0;
                        z-index: -2;
                        background-color: var(--k-forest);
                        background-image: url('https://images.unsplash.com/photo-1605649487212-47bdab064df7?auto=format&fit=crop&w=1800&q=80'), url('https://images.unsplash.com/photo-1506905925346-21bda4d32df4?auto=format&fit=crop&w=1800&q=80');
                        background-repeat: no-repeat, no-repeat;
                        background-position: center center, center center;
                        background-size: cover, cover;
                        animation: kImageIn 1.8s cubic-bezier(0.16, 1, 0.3, 1) both;
                        will-change: transform;
                    }

                    .admin-body .login-visual::after {
                        content: '';
                        position: absolute;
                        inset: 0;
                        z-index: -1;
                        pointer-events: none;
                        background: linear-gradient(165deg, rgba(15,31,23,0.88) 0%, rgba(15,31,23,0.42) 46%, rgba(15,31,23,0.96) 100%), radial-gradient(ellipse 62% 52% at 14% 10%, rgba(143,168,136,0.22), transparent 62%);
                    }

                .admin-body .login-brand {
                    position: relative;
                    z-index: 1;
                    display: flex;
                    align-items: center;
                    gap: 14px;
                    animation: kFadeUp 0.9s cubic-bezier(0.16, 1, 0.3, 1) 0.15s both;
                }

                    .admin-body .login-brand .brand-mark {
                        display: inline-grid;
                        place-items: center;
                        width: 46px;
                        height: 46px;
                        flex: 0 0 auto;
                        border-radius: 50%;
                        border: 1px solid rgba(251, 248, 241, 0.42);
                        background: rgba(251, 248, 241, 0.07);
                        color: var(--k-cream);
                        font-family: 'Fraunces', Georgia, serif;
                        font-weight: 500;
                        font-size: 1.35rem;
                        line-height: 1;
                        backdrop-filter: blur(4px);
                    }

                    .admin-body .login-brand strong {
                        display: block;
                        font-size: 0.78rem;
                        font-weight: 600;
                        letter-spacing: 0.28em;
                        text-transform: uppercase;
                        line-height: 1.2;
                        color: var(--k-cream);
                    }

                    .admin-body .login-brand small {
                        display: block;
                        margin-top: 5px;
                        font-size: 0.58rem;
                        font-weight: 500;
                        letter-spacing: 0.24em;
                        text-transform: uppercase;
                        color: rgba(251, 248, 241, 0.6);
                    }

                .admin-body .login-visual-foot {
                    position: relative;
                    z-index: 1;
                    display: flex;
                    flex-direction: column;
                    gap: 34px;
                    max-width: 580px;
                }

                .admin-body .login-quote {
                    animation: kFadeUp 1s cubic-bezier(0.16, 1, 0.3, 1) 0.35s both;
                }

                    .admin-body .login-quote h2 {
                        margin: 0 0 18px;
                        font-family: 'Fraunces', Georgia, serif;
                        font-weight: 400;
                        font-size: clamp(1.75rem, 3vw, 2.8rem);
                        line-height: 1.06;
                        letter-spacing: -0.018em;
                        color: var(--k-cream);
                        text-wrap: balance;
                    }

                        .admin-body .login-quote h2 em {
                            font-style: italic;
                            color: rgba(143, 168, 136, 0.95);
                        }

                    .admin-body .login-quote p {
                        margin: 0;
                        max-width: 46ch;
                        font-size: 0.95rem;
                        line-height: 1.75;
                        color: rgba(251, 248, 241, 0.78);
                    }

                .admin-body .login-signature {
                    display: flex;
                    align-items: center;
                    gap: 14px;
                    margin: 0;
                    padding-top: 22px;
                    border-top: 1px solid rgba(251, 248, 241, 0.16);
                    font-size: 0.6rem;
                    font-weight: 600;
                    letter-spacing: 0.26em;
                    text-transform: uppercase;
                    color: rgba(251, 248, 241, 0.62);
                    animation: kFadeUp 1s cubic-bezier(0.16, 1, 0.3, 1) 0.5s both;
                }

                    .admin-body .login-signature::before {
                        content: '';
                        width: 26px;
                        height: 1px;
                        background: rgba(143, 168, 136, 0.8);
                    }

                /* ---------- RIGHT FORM ---------- */
                .admin-body .login-form-wrap {
                    display: flex;
                    align-items: flex-start;
                    justify-content: center;
                    min-height: 100vh;
                    min-height: 100dvh;
                    padding: clamp(34px, 4.6vw, 72px) clamp(24px, 4.4vw, 72px);
                    background: var(--k-parchment);
                    animation: kFormIn 0.95s cubic-bezier(0.16, 1, 0.3, 1) 0.2s both;
                }

                .admin-body .login-form {
                    width: 100%;
                    max-width: 460px;
                    margin: auto 0;
                }

                /* ---------- BACK LINK ---------- */
                .admin-body .back-link {
                    display: inline-flex;
                    align-items: center;
                    gap: 8px;
                    margin: 0 0 28px;
                    font-size: 0.76rem;
                    font-weight: 600;
                    letter-spacing: 0.06em;
                    color: rgba(15, 31, 23, 0.62);
                    text-decoration: none;
                    transition: color 0.24s ease, gap 0.24s ease;
                }

                    .admin-body .back-link:hover {
                        color: var(--k-ink);
                        gap: 12px;
                    }

                        .admin-body .back-link:hover svg {
                            transform: translateX(-2px);
                        }

                .admin-body .login-form .eyebrow {
                    display: inline-flex;
                    align-items: center;
                    gap: 12px;
                    margin: 0 0 18px;
                    font-size: 0.6rem;
                    font-weight: 600;
                    letter-spacing: 0.28em;
                    text-transform: uppercase;
                    color: var(--k-sage);
                }

                    .admin-body .login-form .eyebrow::before {
                        content: '';
                        width: 26px;
                        height: 1px;
                        flex: 0 0 auto;
                        background: currentColor;
                        opacity: 0.9;
                    }

                .admin-body .login-form h1 {
                    margin: 0 0 12px;
                    font-family: 'Fraunces', Georgia, serif;
                    font-weight: 400;
                    font-size: clamp(2rem, 3.4vw, 2.7rem);
                    line-height: 1.02;
                    letter-spacing: -0.026em;
                    color: var(--k-ink);
                    text-wrap: balance;
                }

                .admin-body .login-form .login-lede {
                    margin: 0 0 26px;
                    font-size: 0.94rem;
                    line-height: 1.65;
                    color: var(--k-muted);
                }

                .admin-body .login-form .login-link {
                    color: var(--k-ink);
                    font-weight: 600;
                    text-decoration: underline;
                    text-decoration-thickness: 1px;
                    text-decoration-color: rgba(143, 168, 136, 0.65);
                    text-underline-offset: 3px;
                    transition: text-decoration-color 0.3s ease;
                }

                    .admin-body .login-form .login-link:hover {
                        text-decoration-color: var(--k-sage);
                    }

                /* ---------- ERROR / SUCCESS BANNERS ---------- */
                .admin-body .login-form .login-error {
                    display: flex;
                    align-items: flex-start;
                    gap: 12px;
                    margin: 0 0 26px;
                    padding: 14px 16px;
                    border: 1px solid var(--k-danger-line);
                    border-left: 3px solid var(--k-danger);
                    border-radius: var(--k-radius);
                    background: var(--k-danger-soft);
                    color: #6b2018;
                    font-size: 0.86rem;
                    line-height: 1.55;
                    animation: kShake 0.55s cubic-bezier(0.36, 0.07, 0.19, 0.97) both;
                }

                    .admin-body .login-form .login-error svg {
                        flex: 0 0 auto;
                        margin-top: 1px;
                        color: var(--k-danger);
                    }

                    .admin-body .login-form .login-error > div > div + div {
                        margin-top: 4px;
                    }

                .admin-body .login-form .login-success {
                    display: flex;
                    align-items: flex-start;
                    gap: 12px;
                    margin: 0 0 26px;
                    padding: 16px 18px;
                    border: 1px solid var(--k-success-line);
                    border-left: 3px solid var(--k-success);
                    border-radius: var(--k-radius);
                    background: var(--k-success-soft);
                    color: #1e4329;
                    font-size: 0.88rem;
                    line-height: 1.6;
                    animation: kSuccessIn 0.6s cubic-bezier(0.16, 1, 0.3, 1) both;
                }

                    .admin-body .login-form .login-success svg {
                        flex: 0 0 auto;
                        margin-top: 1px;
                        color: var(--k-success);
                    }

                    .admin-body .login-form .login-success strong {
                        display: block;
                        margin-bottom: 4px;
                        font-weight: 600;
                    }

                /* ---------- FIELDS ---------- */
                .admin-body .login-form .login-field {
                    display: flex;
                    flex-direction: column;
                    gap: 8px;
                    margin-bottom: 18px;
                }

                    .admin-body .login-form .login-field label {
                        display: flex;
                        align-items: center;
                        justify-content: space-between;
                        font-size: 0.6rem;
                        font-weight: 600;
                        letter-spacing: 0.2em;
                        text-transform: uppercase;
                        color: rgba(15, 31, 23, 0.62);
                    }

                    .admin-body .login-form .login-field .field-hint {
                        font-size: 0.68rem;
                        font-weight: 500;
                        letter-spacing: 0.02em;
                        text-transform: none;
                        color: rgba(15, 31, 23, 0.4);
                    }

                .admin-body .login-form .input {
                    width: 100%;
                    height: 56px;
                    padding: 0 16px;
                    border: 1px solid var(--k-line);
                    border-radius: var(--k-radius);
                    background: var(--k-cream);
                    color: var(--k-ink);
                    font: inherit;
                    font-size: 0.95rem;
                    box-shadow: 0 1px 0 rgba(255,255,255,0.9) inset, 0 1px 2px rgba(20,39,31,0.04);
                    transition: border-color 0.24s ease, box-shadow 0.24s ease, background 0.24s ease;
                }

                    .admin-body .login-form .input::placeholder {
                        color: rgba(15, 31, 23, 0.32);
                    }

                    .admin-body .login-form .input:hover {
                        border-color: var(--k-line-strong);
                    }

                    .admin-body .login-form .input:focus {
                        outline: none;
                        border-color: var(--k-ink);
                        background: #FFFFFF;
                        box-shadow: 0 0 0 3px rgba(143, 168, 136, 0.28);
                    }

                    .admin-body .login-form .input.input-validation-error {
                        border-color: var(--k-danger);
                        background: #FFF9F8;
                        box-shadow: 0 0 0 3px rgba(178, 59, 46, 0.1);
                    }

                .admin-body .login-form .login-field.is-invalid .input {
                    border-color: var(--k-danger);
                    background: #FFF9F8;
                    box-shadow: 0 0 0 3px rgba(178, 59, 46, 0.1);
                }

                    .admin-body .login-form .login-field.is-invalid .input:focus {
                        box-shadow: 0 0 0 3px rgba(178, 59, 46, 0.16);
                    }

                .admin-body .login-form .login-field.is-valid .input {
                    border-color: rgba(61, 122, 79, 0.55);
                }

                    .admin-body .login-form .login-field.is-valid .input:focus {
                        border-color: var(--k-success);
                        box-shadow: 0 0 0 3px rgba(61, 122, 79, 0.14);
                    }

                /* ---------- CODE INPUT ---------- */
                .admin-body .login-form .code-input {
                    font-family: 'Inter', monospace;
                    font-size: 1.35rem;
                    font-weight: 600;
                    letter-spacing: 0.42em;
                    text-align: center;
                    font-variant-numeric: tabular-nums;
                }

                    .admin-body .login-form .code-input::placeholder {
                        font-size: 0.95rem;
                        font-weight: 400;
                        letter-spacing: 0.02em;
                        text-align: left;
                    }

                /* ---------- INLINE FIELD ERROR ---------- */
                .admin-body .login-form .field-error {
                    display: none;
                    align-items: flex-start;
                    gap: 6px;
                    margin-top: 2px;
                    font-size: 0.78rem;
                    font-weight: 500;
                    line-height: 1.45;
                    color: var(--k-danger);
                }

                    .admin-body .login-form .field-error::before {
                        content: '⚠';
                        font-size: 0.78rem;
                        line-height: 1.4;
                    }

                    .admin-body .login-form .field-error:not(:empty),
                    .admin-body .login-form .login-field.is-invalid .field-error,
                    .admin-body .login-form .field-error.is-visible {
                        display: flex;
                        animation: kErrorIn 0.35s cubic-bezier(0.16, 1, 0.3, 1) both;
                    }

                /* ---------- PASSWORD TOGGLE ---------- */
                .admin-body .login-password-wrap {
                    position: relative;
                }

                    .admin-body .login-password-wrap .input {
                        padding-right: 54px;
                    }

                .admin-body .login-password-toggle {
                    position: absolute;
                    top: 50%;
                    right: 7px;
                    transform: translateY(-50%);
                    display: grid;
                    place-items: center;
                    width: 42px;
                    height: 42px;
                    border: 0;
                    border-radius: 8px;
                    background: transparent;
                    color: rgba(15, 31, 23, 0.48);
                    cursor: pointer;
                    transition: color 0.24s ease, background 0.24s ease;
                }

                    .admin-body .login-password-toggle:hover {
                        color: var(--k-ink);
                        background: rgba(15, 31, 23, 0.06);
                    }

                    .admin-body .login-password-toggle:focus-visible {
                        outline: 2px solid var(--k-sage);
                        outline-offset: 1px;
                    }

                    .admin-body .login-password-toggle .icon-eye-off {
                        display: none;
                    }

                    .admin-body .login-password-toggle[aria-pressed="true"] .icon-eye {
                        display: none;
                    }

                    .admin-body .login-password-toggle[aria-pressed="true"] .icon-eye-off {
                        display: block;
                    }

                /* ---------- PASSWORD STRENGTH ---------- */
                .admin-body .password-strength {
                    display: none;
                    flex-direction: column;
                    gap: 10px;
                    margin-top: 6px;
                }

                    .admin-body .password-strength.is-visible {
                        display: flex;
                        animation: kErrorIn 0.35s cubic-bezier(0.16, 1, 0.3, 1) both;
                    }

                .admin-body .password-strength-track {
                    display: flex;
                    gap: 4px;
                }

                .admin-body .password-strength-seg {
                    height: 4px;
                    flex: 1 1 0;
                    border-radius: 2px;
                    background: rgba(15, 31, 23, 0.1);
                    transition: background 0.3s ease;
                }

                    .admin-body .password-strength-seg.is-on.lvl-1 {
                        background: var(--k-danger);
                    }

                    .admin-body .password-strength-seg.is-on.lvl-2 {
                        background: #C98A2E;
                    }

                    .admin-body .password-strength-seg.is-on.lvl-3 {
                        background: #7E9E55;
                    }

                    .admin-body .password-strength-seg.is-on.lvl-4 {
                        background: var(--k-success);
                    }

                .admin-body .password-strength-meta {
                    display: flex;
                    align-items: center;
                    justify-content: space-between;
                    gap: 12px;
                    font-size: 0.72rem;
                    color: var(--k-muted);
                }

                    .admin-body .password-strength-meta strong {
                        font-weight: 600;
                        color: var(--k-ink);
                    }

                /* ---------- PASSWORD RULES ---------- */
                .admin-body .password-rules {
                    display: none;
                    list-style: none;
                    margin: 4px 0 0;
                    padding: 0;
                    grid-template-columns: repeat(2, minmax(0, 1fr));
                    gap: 6px 14px;
                    font-size: 0.74rem;
                    color: var(--k-muted);
                }

                    .admin-body .password-rules.is-visible {
                        display: grid;
                        animation: kErrorIn 0.35s cubic-bezier(0.16, 1, 0.3, 1) both;
                    }

                    .admin-body .password-rules li {
                        display: flex;
                        align-items: center;
                        gap: 6px;
                        line-height: 1.4;
                        transition: color 0.24s ease;
                    }

                        .admin-body .password-rules li::before {
                            content: '○';
                            font-size: 0.7rem;
                            color: rgba(15, 31, 23, 0.32);
                            transition: color 0.24s ease, content 0.24s ease;
                        }

                        .admin-body .password-rules li.is-met {
                            color: var(--k-success);
                        }

                            .admin-body .password-rules li.is-met::before {
                                content: '✓';
                                color: var(--k-success);
                                font-weight: 700;
                            }

                /* ---------- SUBMIT ---------- */
                .admin-body .login-form .login-submit {
                    position: relative;
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    gap: 10px;
                    width: 100%;
                    height: 56px;
                    margin-top: 10px;
                    padding: 0 26px;
                    border: 0;
                    border-radius: var(--k-radius);
                    background: var(--k-ink);
                    color: var(--k-cream);
                    font-family: 'Inter', system-ui, sans-serif;
                    font-size: 0.72rem;
                    font-weight: 600;
                    letter-spacing: 0.2em;
                    text-transform: uppercase;
                    cursor: pointer;
                    overflow: hidden;
                    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1), background 0.3s ease, box-shadow 0.35s cubic-bezier(0.16, 1, 0.3, 1);
                }

                    .admin-body .login-form .login-submit::before {
                        content: '';
                        position: absolute;
                        inset: 0;
                        background: linear-gradient(120deg, transparent 30%, rgba(143,168,136,0.2) 50%, transparent 70%);
                        transform: translateX(-100%);
                        transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
                    }

                    .admin-body .login-form .login-submit:hover::before {
                        transform: translateX(100%);
                    }

                    .admin-body .login-form .login-submit:hover {
                        background: var(--k-ink-2);
                        transform: translateY(-2px);
                        box-shadow: 0 16px 30px -18px rgba(15, 31, 23, 0.7);
                    }

                    .admin-body .login-form .login-submit:active {
                        transform: translateY(0);
                    }

                    .admin-body .login-form .login-submit:focus-visible {
                        outline: 2px solid var(--k-sage);
                        outline-offset: 3px;
                    }

                    .admin-body .login-form .login-submit:disabled {
                        opacity: 0.6;
                        cursor: not-allowed;
                        transform: none;
                        box-shadow: none;
                    }

                    .admin-body .login-form .login-submit .label,
                    .admin-body .login-form .login-submit .spinner,
                    .admin-body .login-form .login-submit .login-submit-arrow {
                        position: relative;
                        z-index: 1;
                    }

                    .admin-body .login-form .login-submit .spinner {
                        display: none;
                        width: 16px;
                        height: 16px;
                        border: 2px solid rgba(251, 248, 241, 0.35);
                        border-top-color: var(--k-cream);
                        border-radius: 50%;
                        animation: kSpin 0.7s linear infinite;
                    }

                    .admin-body .login-form .login-submit.is-loading .spinner {
                        display: block;
                    }

                    .admin-body .login-form .login-submit.is-loading .login-submit-arrow {
                        display: none;
                    }

                .admin-body .login-form .login-submit-arrow {
                    display: inline-block;
                    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
                }

                .admin-body .login-form .login-submit:hover .login-submit-arrow {
                    transform: translateX(3px);
                }

                /* ---------- FOOTER ---------- */
                .admin-body .login-form .login-foot {
                    margin: 26px 0 0;
                    padding-top: 20px;
                    border-top: 1px solid var(--k-line);
                    font-size: 0.72rem;
                    line-height: 1.65;
                    color: rgba(15, 31, 23, 0.5);
                }

                .admin-body .login-form .login-foot-link {
                    margin-top: 14px;
                    padding-top: 0;
                    border-top: 0;
                }

                .admin-body .login-form .login-foot a {
                    color: rgba(15, 31, 23, 0.76);
                    text-decoration: underline;
                    text-decoration-thickness: 1px;
                    text-decoration-color: rgba(143, 168, 136, 0.55);
                    text-underline-offset: 3px;
                }

                    .admin-body .login-form .login-foot a:hover {
                        text-decoration-color: var(--k-sage);
                    }

            /* ---------- ANIMATIONS ---------- */
            @@keyframes kImageIn {
                from {
                    opacity: 0;
                    transform: scale(1.08);
                }

                to {
                    opacity: 1;
                    transform: scale(1);
                }
            }

            @@keyframes kFadeUp {
                from {
                    opacity: 0;
                    transform: translateY(16px);
                }

                to {
                    opacity: 1;
                    transform: translateY(0);
                }
            }

            @@keyframes kFormIn {
                from {
                    opacity: 0;
                    transform: translateY(14px);
                }

                to {
                    opacity: 1;
                    transform: translateY(0);
                }
            }

            @@keyframes kErrorIn {
                from {
                    opacity: 0;
                    transform: translateY(-3px);
                }

                to {
                    opacity: 1;
                    transform: translateY(0);
                }
            }

            @@keyframes kSuccessIn {
                from {
                    opacity: 0;
                    transform: scale(0.97) translateY(4px);
                }

                to {
                    opacity: 1;
                    transform: scale(1) translateY(0);
                }
            }

            @@keyframes kShake {
                0%, 100% {
                    transform: translateX(0);
                }

                15%, 55%, 85% {
                    transform: translateX(-3px);
                }

                35%, 75% {
                    transform: translateX(3px);
                }
            }

            @@keyframes kSpin {
                to {
                    transform: rotate(360deg);
                }
            }

            /* ---------- RESPONSIVE ---------- */
            @@media (max-width: 1180px) {
                .admin-body .login-shell {
                    grid-template-columns: minmax(0, 52fr) minmax(0, 48fr);
                }

                .admin-body .login-visual {
                    padding: clamp(26px, 3.6vw, 46px);
                }
            }

            @@media (max-width: 980px) {
                .admin-body .login-shell {
                    grid-template-columns: minmax(0, 50fr) minmax(0, 50fr);
                }

                .admin-body .login-quote h2 {
                    font-size: clamp(1.5rem, 3.4vw, 2.05rem);
                }

                .admin-body .login-quote p {
                    font-size: 0.9rem;
                }

                .admin-body .login-form h1 {
                    font-size: clamp(1.8rem, 4vw, 2.3rem);
                }
            }

            @@media (max-width: 860px) {
                .admin-body .login-shell {
                    grid-template-columns: minmax(0, 1fr);
                }

                .admin-body .login-visual {
                    position: relative;
                    height: auto;
                    min-height: 300px;
                    padding: 26px 24px 32px;
                    gap: 28px;
                }

                .admin-body .login-visual-foot {
                    gap: 20px;
                }

                .admin-body .login-quote h2 {
                    font-size: clamp(1.4rem, 5.4vw, 1.95rem);
                    margin-bottom: 12px;
                }

                .admin-body .login-quote p {
                    font-size: 0.88rem;
                    line-height: 1.6;
                }

                .admin-body .login-signature {
                    padding-top: 16px;
                    font-size: 0.54rem;
                    letter-spacing: 0.22em;
                }

                .admin-body .login-form-wrap {
                    min-height: 0;
                    padding: 38px 22px 48px;
                }

                .admin-body .login-form {
                    max-width: 100%;
                    margin: 0 auto;
                }
            }

            @@media (max-width: 420px) {
                .admin-body .login-visual {
                    min-height: 280px;
                    padding: 22px 20px 26px;
                }

                .admin-body .login-form h1 {
                    font-size: 1.85rem;
                }

                .admin-body .password-rules {
                    grid-template-columns: 1fr;
                }

                .admin-body .login-form .code-input {
                    font-size: 1.15rem;
                    letter-spacing: 0.32em;
                }
            }

            /* ---------- REDUCED MOTION ---------- */
            @@media (prefers-reduced-motion: reduce) {
                .admin-body .login-visual::before,
                .admin-body .login-brand,
                .admin-body .login-quote,
                .admin-body .login-signature,
                .admin-body .login-form-wrap,
                .admin-body .login-form .login-submit,
                .admin-body .login-form .login-submit-arrow,
                .admin-body .login-form .input,
                .admin-body .login-password-toggle,
                .admin-body .login-form .login-error,
                .admin-body .login-form .login-success,
                .admin-body .login-form .field-error,
                .admin-body .password-strength,
                .admin-body .password-rules {
                    animation: none !important;
                    transition: none !important;
                }

                    .admin-body .login-form .login-submit:hover,
                    .admin-body .login-form .login-submit:hover .login-submit-arrow,
                    .admin-body .login-form .login-submit:hover::before {
                        transform: none !important;
                    }
            }
    </style>
</head>
<body class="admin-body">

    <div class="login-shell">

        <!-- ============ VISUAL SIDE ============ -->
        <aside class="login-visual">
            <div class="login-brand">
                <span class="brand-mark" aria-hidden="true">K</span>
                <span>
                    <strong>Karnel</strong>
                    <small>Travel Guide</small>
                </span>
            </div>

            <div class="login-visual-foot">
                <div class="login-quote">
                    <h2>Back on the map with a <em>fresh key</em>.</h2>
                    <p>
                        Enter the six-digit code from your inbox, then choose
                        a new password. Your journeys stay right where you left them.
                    </p>
                </div>
                <p class="login-signature">Destinations · Stays · Experiences</p>
            </div>
        </aside>

        <!-- ============ FORM SIDE ============ -->
        <section class="login-form-wrap">
            <form class="login-form"
                  id="resetForm"
                  method="post"
                  asp-controller="Account"
                  asp-action="ResetPassword"
                  novalidate>
                @Html.AntiForgeryToken()

                <a class="back-link" asp-controller="Account" asp-action="ForgotPassword">
                    <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor"
                         stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M15 18l-6-6 6-6" />
                    </svg>
                    Request a new code
                </a>

                <p class="eyebrow">Karnel / New password</p>
                <h1>Choose a new password.</h1>
                <p class="login-lede">
                    Paste the six-digit code we sent you, then set a new password
                    for your Karnel account.
                </p>

                @* ---- Success banner (post-reset, if controller sets TempData/ViewData) ---- *@
                @if (TempData["ResetPasswordSuccess"] != null || ViewData["ResetPasswordSuccess"] is true)
                {
                    <div class="login-success" role="status">
                        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor"
                             stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <circle cx="12" cy="12" r="9" />
                            <path d="M8.5 12.5l2.5 2.5 4.5-5" />
                        </svg>
                        <div>
                            <strong>Password updated</strong>
                            You can now sign in with your new password.
                        </div>
                    </div>
                }

                @* ---- General errors (invalid/expired code, rate-limit, etc.) ---- *@
                @{
                    var fieldKeys = new[] { "Email", "Code", "Password", "ConfirmPassword" };
                    var generalErrors = ViewData.ModelState
                        .Where(kv => !fieldKeys.Contains(kv.Key, StringComparer.OrdinalIgnoreCase))
                        .SelectMany(kv => kv.Value.Errors)
                        .Select(e => e.ErrorMessage)
                        .Where(m => !string.IsNullOrWhiteSpace(m))
                        .ToList();
                }
                @if (generalErrors.Any())
                {
                    <div class="login-error" role="alert" id="serverError">
                        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor"
                             stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <circle cx="12" cy="12" r="9" />
                            <path d="M12 8v5" />
                            <path d="M12 16h.01" />
                        </svg>
                        <div>
                            @foreach (var msg in generalErrors)
                            {
                                <div>@msg</div>
                            }
                        </div>
                    </div>
                }

                <!-- ===== EMAIL ===== -->
                <div class="login-field" id="EmailField">
                    <label asp-for="Email">
                        <span>Email address</span>
                        <span class="field-hint">The one that received the code</span>
                    </label>
                    <input class="input"
                           asp-for="Email"
                           id="Email"
                           type="email"
                           placeholder="you@karneltravel.co.za"
                           autocomplete="email"
                           inputmode="email"
                           spellcheck="false"
                           autocapitalize="off"
                           autofocus
                           aria-describedby="Email-error" />
                    <span class="field-error" id="Email-error" asp-validation-for="Email"></span>
                    @if (ViewData.ModelState.TryGetValue("Email", out var emailState) && emailState.Errors.Any())
                    {
                        <span class="field-error is-visible">@emailState.Errors.First().ErrorMessage</span>
                    }
                </div>

                <!-- ===== CODE ===== -->
                <div class="login-field" id="CodeField">
                    <label asp-for="Code">
                        <span>Reset code</span>
                        <span class="field-hint">6 digits from your email</span>
                    </label>
                    <input class="input code-input"
                           asp-for="Code"
                           id="Code"
                           type="text"
                           placeholder="000000"
                           inputmode="numeric"
                           autocomplete="one-time-code"
                           maxlength="6"
                           pattern="[0-9]{6}"
                           aria-describedby="Code-error" />
                    <span class="field-error" id="Code-error" asp-validation-for="Code"></span>
                    @if (ViewData.ModelState.TryGetValue("Code", out var codeState) && codeState.Errors.Any())
                    {
                        <span class="field-error is-visible">@codeState.Errors.First().ErrorMessage</span>
                    }
                </div>

                <!-- ===== PASSWORD ===== -->
                <div class="login-field" id="PasswordField">
                    <label asp-for="Password">
                        <span>New password</span>
                        <span class="field-hint">8+ characters</span>
                    </label>
                    <div class="login-password-wrap">
                        <input class="input"
                               asp-for="Password"
                               id="Password"
                               type="password"
                               placeholder="Create a strong password"
                               autocomplete="new-password"
                               minlength="8"
                               maxlength="128"
                               aria-describedby="Password-error" />
                        <button type="button"
                                class="login-password-toggle"
                                aria-label="Show password"
                                aria-pressed="false"
                                data-password-toggle>
                            <svg class="icon-eye" viewBox="0 0 24 24" width="17" height="17" fill="none"
                                 stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"
                                 aria-hidden="true">
                                <path d="M2 12s3.6-6.5 10-6.5S22 12 22 12s-3.6 6.5-10 6.5S2 12 2 12Z" />
                                <circle cx="12" cy="12" r="2.6" />
                            </svg>
                            <svg class="icon-eye-off" viewBox="0 0 24 24" width="17" height="17" fill="none"
                                 stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"
                                 aria-hidden="true">
                                <path d="M3 3l18 18" />
                                <path d="M10.6 5.6A9.7 9.7 0 0 1 12 5.5c6.4 0 10 6.5 10 6.5a17.2 17.2 0 0 1-3.1 4" />
                                <path d="M6.5 6.9A17.2 17.2 0 0 0 2 12s3.6 6.5 10 6.5a9.6 9.6 0 0 0 4.3-1" />
                                <path d="M9.9 9.9a3 3 0 0 0 4.2 4.2" />
                            </svg>
                        </button>
                    </div>
                    <span class="field-error" id="Password-error" asp-validation-for="Password"></span>
                    @if (ViewData.ModelState.TryGetValue("Password", out var pwdState) && pwdState.Errors.Any())
                    {
                        <span class="field-error is-visible">@pwdState.Errors.First().ErrorMessage</span>
                    }

                    <!-- Strength meter -->
                    <div class="password-strength" id="passwordStrength">
                        <div class="password-strength-track">
                            <span class="password-strength-seg" data-seg="1"></span>
                            <span class="password-strength-seg" data-seg="2"></span>
                            <span class="password-strength-seg" data-seg="3"></span>
                            <span class="password-strength-seg" data-seg="4"></span>
                        </div>
                        <div class="password-strength-meta">
                            <span>Strength: <strong id="strengthLabel">—</strong></span>
                            <span id="strengthHint">Aim for strong</span>
                        </div>
                    </div>

                    <!-- Rules checklist -->
                    <ul class="password-rules" id="passwordRules" aria-live="polite">
                        <li data-rule="len">At least 8 characters</li>
                        <li data-rule="lower">One lowercase letter</li>
                        <li data-rule="upper">One uppercase letter</li>
                        <li data-rule="digit">One number</li>
                    </ul>
                </div>

                <!-- ===== CONFIRM PASSWORD ===== -->
                <div class="login-field" id="ConfirmPasswordField">
                    <label asp-for="ConfirmPassword">
                        <span>Confirm new password</span>
                        <span class="field-hint">Type it again</span>
                    </label>
                    <div class="login-password-wrap">
                        <input class="input"
                               asp-for="ConfirmPassword"
                               id="ConfirmPassword"
                               type="password"
                               placeholder="Repeat new password"
                               autocomplete="new-password"
                               aria-describedby="ConfirmPassword-error" />
                        <button type="button"
                                class="login-password-toggle"
                                aria-label="Show password"
                                aria-pressed="false"
                                data-password-toggle>
                            <svg class="icon-eye" viewBox="0 0 24 24" width="17" height="17" fill="none"
                                 stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"
                                 aria-hidden="true">
                                <path d="M2 12s3.6-6.5 10-6.5S22 12 22 12s-3.6 6.5-10 6.5S2 12 2 12Z" />
                                <circle cx="12" cy="12" r="2.6" />
                            </svg>
                            <svg class="icon-eye-off" viewBox="0 0 24 24" width="17" height="17" fill="none"
                                 stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"
                                 aria-hidden="true">
                                <path d="M3 3l18 18" />
                                <path d="M10.6 5.6A9.7 9.7 0 0 1 12 5.5c6.4 0 10 6.5 10 6.5a17.2 17.2 0 0 1-3.1 4" />
                                <path d="M6.5 6.9A17.2 17.2 0 0 0 2 12s3.6 6.5 10 6.5a9.6 9.6 0 0 0 4.3-1" />
                                <path d="M9.9 9.9a3 3 0 0 0 4.2 4.2" />
                            </svg>
                        </button>
                    </div>
                    <span class="field-error" id="ConfirmPassword-error" asp-validation-for="ConfirmPassword"></span>
                    @if (ViewData.ModelState.TryGetValue("ConfirmPassword", out var cpState) && cpState.Errors.Any())
                    {
                        <span class="field-error is-visible">@cpState.Errors.First().ErrorMessage</span>
                    }
                </div>

                <button type="submit" class="login-submit" id="resetSubmit">
                    <span class="spinner" aria-hidden="true"></span>
                    <span class="label">Update password</span>
                    <span class="login-submit-arrow" aria-hidden="true">→</span>
                </button>

                <p class="login-foot">
                    The reset code expires after 15&nbsp;minutes and can only be
                    used once. Setting a new password signs you out of other devices.
                </p>

                <p class="login-foot login-foot-link">
                    Didn't get a code?
                    <a asp-controller="Account" asp-action="ForgotPassword">Send another</a>
                    &nbsp;·&nbsp;
                    <a asp-controller="Account" asp-action="Login">Sign in</a>
                </p>
            </form>
        </section>

    </div>

    <script>
            /* ============================================================
               KARNEL RESET PASSWORD — VALIDATION
               Hybrid rules:
                 • Email:    required + valid format
                 • Code:     exactly 6 numeric digits
                 • Password: 8–128, mixed case + digit
                 • Confirm:  must match Password
               Code validity / expiry is the server's job.
            ============================================================ */
            (function () {
                'use strict';

                var form = document.getElementById('resetForm');
                if (!form) return;

                var emailInput = document.getElementById('Email');
                var codeInput = document.getElementById('Code');
                var pwdInput = document.getElementById('Password');
                var confirmIn = document.getElementById('ConfirmPassword');

                var emailField = document.getElementById('EmailField');
                var codeField = document.getElementById('CodeField');
                var pwdField = document.getElementById('PasswordField');
                var confirmField = document.getElementById('ConfirmPasswordField');

                var emailErr = document.getElementById('Email-error');
                var codeErr = document.getElementById('Code-error');
                var pwdErr = document.getElementById('Password-error');
                var confirmErr = document.getElementById('ConfirmPassword-error');

                var strengthWrap = document.getElementById('passwordStrength');
                var strengthSegs = strengthWrap ? strengthWrap.querySelectorAll('[data-seg]') : [];
                var strengthLabel = document.getElementById('strengthLabel');
                var strengthHint = document.getElementById('strengthHint');
                var rulesWrap = document.getElementById('passwordRules');
                var rules = rulesWrap ? {
                    len: rulesWrap.querySelector('[data-rule="len"]'),
                    lower: rulesWrap.querySelector('[data-rule="lower"]'),
                    upper: rulesWrap.querySelector('[data-rule="upper"]'),
                    digit: rulesWrap.querySelector('[data-rule="digit"]')
                } : {};

                var submitBtn = document.getElementById('resetSubmit');
                var touched = { email: false, code: false, pwd: false, confirm: false };

                /* ---------- HELPERS ---------- */
                function setState(field, state) {
                    field.classList.remove('is-invalid', 'is-valid');
                    if (state) field.classList.add(state);
                }

                function render(field, errEl, result, show) {
                    if (!show) { setState(field, ''); errEl.textContent = ''; return; }
                    if (result.ok) {
                        setState(field, 'valid');
                        errEl.textContent = '';
                    } else {
                        setState(field, 'invalid');
                        errEl.textContent = result.msg;
                        errEl.classList.add('is-visible');
                    }
                }

                /* ---------- VALIDATORS ---------- */
                function vEmail(v) {
                    var s = (v || '').trim();
                    if (!s) return { ok: false, msg: 'Please enter your email address.' };
                    if (s.length > 254) return { ok: false, msg: 'That email address is too long.' };
                    if (/\s/.test(s)) return { ok: false, msg: 'Email address cannot contain spaces.' };
                    if (!/^[^\s@@]+@@[^\s@@]+\.[^\s@@]{2,}$/.test(s)) {
                        return { ok: false, msg: 'Please enter a valid email address.' };
                    }
                    return { ok: true, msg: '' };
                }

                function vCode(v) {
                    var s = (v || '').trim();
                    if (!s) return { ok: false, msg: 'Please enter the six-digit code from your email.' };
                    if (!/^\d{6}$/.test(s)) return { ok: false, msg: 'The code should be exactly 6 digits.' };
                    return { ok: true, msg: '' };
                }

                function vPassword(v) {
                    var s = v || '';
                    if (!s) return { ok: false, msg: 'Please choose a new password.' };
                    if (s.length < 8) return { ok: false, msg: 'Password must be at least 8 characters.' };
                    if (s.length > 128) return { ok: false, msg: 'Password is too long.' };
                    if (!/[a-z]/.test(s)) return { ok: false, msg: 'Add at least one lowercase letter.' };
                    if (!/[A-Z]/.test(s)) return { ok: false, msg: 'Add at least one uppercase letter.' };
                    if (!/\d/.test(s)) return { ok: false, msg: 'Add at least one number.' };
                    return { ok: true, msg: '' };
                }

                function vConfirm(v) {
                    if (!v) return { ok: false, msg: 'Please confirm your new password.' };
                    if (v !== pwdInput.value) return { ok: false, msg: 'Passwords do not match.' };
                    return { ok: true, msg: '' };
                }

                /* ---------- STRENGTH + RULES ---------- */
                function scorePassword(v) {
                    var score = 0;
                    if (!v) return 0;
                    if (v.length >= 8) score++;
                    if (v.length >= 12) score++;
                    if (/[a-z]/.test(v) && /[A-Z]/.test(v)) score++;
                    if (/\d/.test(v)) score++;
                    if (/[^A-Za-z0-9]/.test(v)) score++;
                    return Math.min(4, score);
                }

                function updatePasswordUI() {
                    var v = pwdInput.value;
                    if (!v) {
                        strengthWrap.classList.remove('is-visible');
                        rulesWrap.classList.remove('is-visible');
                        return;
                    }
                    strengthWrap.classList.add('is-visible');
                    rulesWrap.classList.add('is-visible');

                    var score = scorePassword(v);
                    var labels = ['Very weak', 'Weak', 'Fair', 'Good', 'Strong'];
                    strengthSegs.forEach(function (seg, idx) {
                        seg.className = 'password-strength-seg';
                        if (idx < score) seg.classList.add('is-on', 'lvl-' + Math.max(1, score));
                    });
                    strengthLabel.textContent = labels[score] || '—';
                    strengthHint.textContent = score >= 3
                        ? 'Nice — this is secure.'
                        : 'Add length, case-mix & numbers.';

                    var checks = {
                        len: v.length >= 8,
                        lower: /[a-z]/.test(v),
                        upper: /[A-Z]/.test(v),
                        digit: /\d/.test(v)
                    };
                    Object.keys(checks).forEach(function (k) {
                        if (rules[k]) rules[k].classList.toggle('is-met', checks[k]);
                    });
                }

                /* ---------- INPUT WIRING ---------- */
                emailInput.addEventListener('blur', function () {
                    touched.email = true;
                    render(emailField, emailErr, vEmail(emailInput.value), true);
                });
                emailInput.addEventListener('input', function () {
                    if (touched.email) render(emailField, emailErr, vEmail(emailInput.value), true);
                });

                /* Code input: strip non-digits live + auto-advance feel */
                codeInput.addEventListener('input', function () {
                    var digits = codeInput.value.replace(/\D/g, '').slice(0, 6);
                    if (digits !== codeInput.value) codeInput.value = digits;
                    if (touched.code) render(codeField, codeErr, vCode(codeInput.value), true);
                });
                codeInput.addEventListener('blur', function () {
                    touched.code = true;
                    render(codeField, codeErr, vCode(codeInput.value), true);
                });

                pwdInput.addEventListener('input', function () {
                    updatePasswordUI();
                    if (touched.pwd) render(pwdField, pwdErr, vPassword(pwdInput.value), true);
                    if (touched.confirm && confirmIn.value) {
                        render(confirmField, confirmErr, vConfirm(confirmIn.value), true);
                    }
                });
                pwdInput.addEventListener('blur', function () {
                    touched.pwd = true;
                    updatePasswordUI();
                    render(pwdField, pwdErr, vPassword(pwdInput.value), true);
                });

                confirmIn.addEventListener('input', function () {
                    if (touched.confirm) render(confirmField, confirmErr, vConfirm(confirmIn.value), true);
                });
                confirmIn.addEventListener('blur', function () {
                    touched.confirm = true;
                    render(confirmField, confirmErr, vConfirm(confirmIn.value), true);
                });

                /* ---------- PASSWORD TOGGLES ---------- */
                document.querySelectorAll('[data-password-toggle]').forEach(function (btn) {
                    btn.addEventListener('click', function (e) {
                        e.preventDefault();
                        var wrap = btn.closest('.login-password-wrap');
                        var input = wrap ? wrap.querySelector('input') : null;
                        if (!input) return;
                        var show = input.type === 'password';
                        input.type = show ? 'text' : 'password';
                        btn.setAttribute('aria-label', show ? 'Hide password' : 'Show password');
                        btn.setAttribute('aria-pressed', show ? 'true' : 'false');
                        input.focus();
                    });
                });

                /* ---------- SUBMIT ---------- */
                form.addEventListener('submit', function (e) {
                    touched = { email: true, code: true, pwd: true, confirm: true };

                    var rEmail = vEmail(emailInput.value);
                    var rCode = vCode(codeInput.value);
                    var rPwd = vPassword(pwdInput.value);
                    var rConfirm = vConfirm(confirmIn.value);

                    render(emailField, emailErr, rEmail, true);
                    render(codeField, codeErr, rCode, true);
                    render(pwdField, pwdErr, rPwd, true);
                    render(confirmField, confirmErr, rConfirm, true);
                    updatePasswordUI();

                    var firstInvalid =
                        !rEmail.ok ? emailInput :
                            !rCode.ok ? codeInput :
                                !rPwd.ok ? pwdInput :
                                    !rConfirm.ok ? confirmIn : null;

                    if (firstInvalid) {
                        e.preventDefault();
                        var fieldToShake = firstInvalid.closest('.login-field');
                        if (fieldToShake) {
                            fieldToShake.classList.remove('is-invalid');
                            void fieldToShake.offsetWidth;
                            fieldToShake.classList.add('is-invalid');
                        }
                        firstInvalid.focus();
                        try { firstInvalid.scrollIntoView({ behavior: 'smooth', block: 'center' }); } catch (_) { }
                        return false;
                    }

                    submitBtn.classList.add('is-loading');
                    submitBtn.disabled = true;
                    submitBtn.querySelector('.label').textContent = 'Updating…';
                });

                /* ---------- PROTOTYPE GUARD ---------- */
                document.querySelectorAll('a[data-prototype]').forEach(function (link) {
                    link.addEventListener('click', function (e) { e.preventDefault(); });
                });

                /* ---------- SERVER ERROR FADE ---------- */
                var serverError = document.getElementById('serverError');
                if (serverError) {
                    setTimeout(function () {
                        serverError.style.transition = 'opacity 0.5s ease, transform 0.5s ease';
                        serverError.style.opacity = '0';
                        serverError.style.transform = 'translateY(-6px)';
                        setTimeout(function () { serverError.remove(); }, 520);
                    }, 8000);
                }
            })();
    </script>

</body>
</html>