@model KarnelTravel.ViewModels.ResetPasswordViewModel
@{ Layout = "_Layout"; ViewData["Title"] = "Reset password"; }
<section class="page-section"><div class="container"><h1>Choose a new password</h1><form method="post">@Html.AntiForgeryToken() <div asp-validation-summary="ModelOnly"></div><input asp-for="Token" type="hidden" /><label asp-for="Password"></label><input asp-for="Password" autocomplete="new-password" /><span asp-validation-for="Password"></span><label asp-for="ConfirmPassword"></label><input asp-for="ConfirmPassword" autocomplete="new-password" /><span asp-validation-for="ConfirmPassword"></span><button type="submit">Update password</button></form></div></section>
