@model KarnelTravel.ViewModels.ResetPasswordViewModel
@{ Layout = "_Layout"; ViewData["Title"] = "Reset password"; }
<section class="page-section"><div class="container"><h1>Choose a new password</h1><form method="post" asp-controller="Account" asp-action="ResetPassword">@Html.AntiForgeryToken() <div asp-validation-summary="ModelOnly"></div><label asp-for="Email"></label><input asp-for="Email" type="email" autocomplete="email" /><span asp-validation-for="Email"></span><label asp-for="Code">Reset code</label><input asp-for="Code" inputmode="numeric" autocomplete="one-time-code" maxlength="6" /><span asp-validation-for="Code"></span><label asp-for="Password"></label><input asp-for="Password" autocomplete="new-password" /><span asp-validation-for="Password"></span><label asp-for="ConfirmPassword"></label><input asp-for="ConfirmPassword" autocomplete="new-password" /><span asp-validation-for="ConfirmPassword"></span><button type="submit">Update password</button></form></div></section>
