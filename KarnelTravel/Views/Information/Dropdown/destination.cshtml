
@model IEnumerable<KarnelTravel.Models.Destination>

@{
    ViewData["Title"] = "Discover Pakistan — Tourist Spots | Karnel Travel Guide";
    ViewData["Description"] = "Discover tourist spots across Pakistan — mountains, valleys, beaches and historical places.";
}

@section Styles {
    <style>
        .page-hero { padding: calc(var(--header-h) + 60px) 0 60px; background: var(--sand); }
        .page-hero h1 { max-width: 14ch; }
        .page-hero p { color: var(--muted); font-size: 1.05rem; max-width: 62ch; }

        .listing-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
            gap: 28px;
        }

        .listing-card {
            display: flex;
            flex-direction: column;
            background: var(--white);
            border: 1px solid var(--line);
            border-radius: var(--radius-lg);
            overflow: hidden;
            transition: transform .4s var(--ease), box-shadow .4s var(--ease);
        }

        .listing-card:hover {
            transform: translateY(-4px);
            box-shadow: var(--shadow-md);
        }

        .listing-card .media {
            aspect-ratio: 4 / 3;
            overflow: hidden;
            background: var(--sand);
        }

        .listing-card .media img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform .4s var(--ease);
        }

        .listing-card:hover .media img { transform: scale(1.05); }

        .listing-card__body {
            padding: 22px;
            display: flex;
            flex-direction: column;
            gap: 10px;
            flex: 1;
        }

        .listing-card__meta {
            font-size: .68rem;
            letter-spacing: .16em;
            text-transform: uppercase;
            color: var(--muted);
        }

        .listing-card h3 { margin: 0; font-size: 1.25rem; }

        .listing-card__desc {
            color: var(--muted);
            font-size: .92rem;
            margin: 0;
            flex: 1;
        }

        .listing-card__footer {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 12px;
            padding-top: 14px;
            border-top: 1px solid var(--line);
            margin-top: auto;
        }

        .listing-card__footer > span {
            font-size: .8rem;
            color: var(--muted);
        }

        .empty-destinations {
            grid-column: 1 / -1;
            text-align: center;
            padding: 50px 20px;
            color: var(--muted);
        }

        .cta-band {
            background: var(--forest-deep);
            color: var(--ivory);
            padding: clamp(56px, 8vw, 100px) 0;
            text-align: center;
        }

        .cta-band h2 { color: var(--ivory); }

        .cta-band p {
            color: rgba(248, 246, 240, .78);
            max-width: 56ch;
            margin: 0 auto 28px;
        }
    </style>
}

<header class="page-hero">
    <div class="container" data-reveal>
        <p class="eyebrow">Discover More · Tourist Spots</p>
        <h1>Discover Pakistan.</h1>
        <p>
            From mountain valleys and alpine lakes to historic cities
            and coastal escapes, discover places worth exploring across Pakistan.
        </p>
    </div>
</header>

<section class="section section--ivory">
    <div class="container">
        <div class="listing-grid" data-reveal-group>

            @if (Model != null && Model.Any())
            {
                @foreach (var destination in Model)
                {
                    <article class="listing-card" data-reveal>
                        <div class="media" data-fallback-label="@destination.Name">
                            @if (!string.IsNullOrWhiteSpace(destination.ImageUrl))
                            {
                                <img src="@destination.ImageUrl"
                                     alt="@destination.Name"
                                     loading="lazy" />
                            }
                        </div>

                        <div class="listing-card__body">
                            <span class="listing-card__meta">
                                @(string.IsNullOrWhiteSpace(destination.Region)
                                    ? "Pakistan"
                                    : destination.Region)
                            </span>

                            <h3>@destination.Name</h3>

                            <p class="listing-card__desc">
                                @(string.IsNullOrWhiteSpace(destination.ShortDescription)
                                    ? "Discover this destination with Karnel Travel Guide."
                                    : destination.ShortDescription)
                            </p>

                            <div class="listing-card__footer">
                                <span>Tourist destination</span>

                                <a class="btn btn--light"
                                   href="@Url.Action("Details", "Destinations", new { slug = destination.Slug })">
                                    View
                                </a>
                            </div>
                        </div>
                    </article>
                }
            }
            else
            {
                <div class="empty-destinations">
                    <h3>No destinations available yet</h3>
                    <p>Please check back soon for destinations to explore.</p>
                </div>
            }

        </div>
    </div>
</section>

<section class="cta-band">
    <div class="container" data-reveal>
        <h2>Want to combine several destinations?</h2>
        <p>Send an inquiry through Get in Touch and we'll help you arrange a route.</p>
        <a class="btn btn--light" href="@Url.Action("Index", "Contact")">
            Get in Touch
        </a>
    </div>
</section>
