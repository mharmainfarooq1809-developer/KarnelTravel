@model IEnumerable<KarnelTravel.Models.Destination>

@{
    ViewData["Title"] = "Discover Pakistan — Tourist Spots | Karnel Travel Guide";
    ViewData["Description"] = "Discover tourist spots across Pakistan — mountains, valleys, beaches and historical places.";

    var hasDestinations = Model != null && Model.Any();
    var totalDestinations = hasDestinations ? Model.Count() : 0;
    var index = 0;
}

@section Styles {
    <style>
        /* ==========================================================================
           KARNEL TRAVEL GUIDE — DESTINATIONS
           Editorial destination gallery. Scoped with .kd- prefix.
           ========================================================================== */

        .kd-page {
            --kd-forest: var(--forest-deep, #14271F);
            --kd-ivory: var(--ivory, #F8F6F0);
            --kd-sage: var(--sage, #8FA888);
            --kd-sand: var(--sand, #E8DFC9);
            --kd-white: #FFFFFF;
            --kd-muted: var(--muted, #5A6B60);
            --kd-serif: var(--serif, "Playfair Display", Georgia, "Times New Roman", serif);
            --kd-sans: var(--sans, "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif);
            --kd-ease: var(--ease, cubic-bezier(.22, .61, .36, 1));
            --kd-ease-out: cubic-bezier(.16, 1, .3, 1);
            --kd-card-radius: 20px;
            --kd-card-radius-sm: 14px;

            background: var(--kd-ivory);
            color: var(--kd-forest);
            font-family: var(--kd-sans);
            -webkit-font-smoothing: antialiased;
        }

        /* -------------------------------------------------- shared atoms ---- */
        .kd-eyebrow {
            display: inline-flex;
            align-items: center;
            gap: 14px;
            margin: 0 0 18px;
            font-size: .7rem;
            font-weight: 600;
            letter-spacing: .32em;
            text-transform: uppercase;
            color: var(--kd-sage);
        }
        .kd-eyebrow::before {
            content: "";
            width: 34px;
            height: 1px;
            background: currentColor;
            opacity: .7;
        }
        .kd-eyebrow--light { color: var(--kd-sand); }

        .kd-reveal {
            opacity: 0;
            transform: translateY(26px);
            transition:
                opacity .9s var(--kd-ease),
                transform .9s var(--kd-ease);
            transition-delay: var(--kd-delay, 0ms);
        }
        .kd-reveal.is-in {
            opacity: 1;
            transform: none;
        }

        /* ------------------------------------------------------ 01 — HERO ---- */
        .kd-hero {
            position: relative;
            padding: calc(var(--header-h, 80px) + 64px) 0 clamp(52px, 7vw, 88px);
            background: var(--kd-ivory);
        }
        .kd-hero__grid {
            display: grid;
            grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
            align-items: center;
            gap: clamp(32px, 6vw, 84px);
        }
        .kd-hero h1 {
            margin: 0 0 24px;
            max-width: 14ch;
            font-family: var(--kd-serif);
            font-weight: 500;
            font-size: clamp(2.4rem, 5vw, 4.2rem);
            line-height: 1.03;
            letter-spacing: -.02em;
            color: var(--kd-forest);
        }
        .kd-hero h1 em { font-style: italic; color: inherit; }
        .kd-hero__lede {
            margin: 0;
            max-width: 46ch;
            font-size: clamp(1rem, 1.1vw, 1.08rem);
            line-height: 1.75;
            color: var(--kd-muted);
        }
        .kd-hero__media { position: relative; }
        .kd-hero__frame {
            margin: 0;
            height: clamp(320px, 44vw, 520px);
            overflow: hidden;
            border-radius: var(--kd-card-radius);
            background: var(--kd-forest);
            box-shadow: 0 40px 80px -50px rgba(20, 39, 31, .45);
        }
        .kd-hero__frame img {
            display: block;
            width: 100%;
            height: 100%;
            object-fit: cover;
            transform: scale(1.06);
            transition: transform 1.6s var(--kd-ease);
        }
        .kd-hero__media.is-in .kd-hero__frame img { transform: scale(1); }

        /* floating caption plate */
        .kd-hero__caption {
            position: absolute;
            left: clamp(16px, 3vw, 28px);
            bottom: clamp(16px, 3vw, 28px);
            display: inline-flex;
            align-items: center;
            gap: 12px;
            padding: 10px 16px;
            border-radius: 12px;
            background: rgba(248, 246, 240, .94);
            backdrop-filter: blur(10px);
            box-shadow: 0 18px 36px -22px rgba(0, 0, 0, .45);
            font-size: .62rem;
            font-weight: 600;
            letter-spacing: .18em;
            text-transform: uppercase;
            color: var(--kd-forest);
        }
        .kd-hero__caption::before {
            content: "";
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background: var(--kd-sage);
            box-shadow: 0 0 0 4px rgba(143, 168, 136, .25);
        }

        /* ------------------------------------------------ 02 — INTRODUCTION ---- */
        .kd-intro {
            padding: clamp(40px, 5vw, 64px) 0 clamp(28px, 3.5vw, 44px);
            background: var(--kd-ivory);
        }
        .kd-intro__inner {
            display: flex;
            flex-wrap: wrap;
            align-items: flex-end;
            justify-content: space-between;
            gap: 18px 48px;
            padding-bottom: clamp(18px, 2.4vw, 28px);
            border-bottom: 1px solid rgba(20, 39, 31, .12);
        }
        .kd-intro h2 {
            margin: 0;
            font-family: var(--kd-serif);
            font-weight: 500;
            font-size: clamp(1.8rem, 3.2vw, 2.7rem);
            line-height: 1.1;
            letter-spacing: -.015em;
            color: var(--kd-forest);
        }
        .kd-intro__meta {
            display: flex;
            flex-wrap: wrap;
            align-items: baseline;
            gap: 12px 24px;
        }
        .kd-intro__desc {
            margin: 0;
            max-width: 44ch;
            font-size: .95rem;
            line-height: 1.7;
            color: var(--kd-muted);
        }
        .kd-intro__count {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            margin: 0;
            padding: 8px 14px;
            border-radius: 999px;
            background: var(--kd-sand);
            font-size: .62rem;
            font-weight: 600;
            letter-spacing: .18em;
            text-transform: uppercase;
            color: var(--kd-forest);
        }
        .kd-intro__count strong {
            font-family: var(--kd-serif);
            font-size: 1.05rem;
            font-weight: 500;
            letter-spacing: 0;
        }

        /* -------------------------------------------------- 03 — GALLERY ---- */
        .kd-gallery-section {
            padding: 0 0 clamp(64px, 8vw, 112px);
            background: var(--kd-ivory);
        }
        .kd-gallery {
            display: grid;
            grid-template-columns: repeat(12, minmax(0, 1fr));
            gap: clamp(16px, 2vw, 28px);
            align-items: start;
        }

        /* --- base destination card --- */
        .kd-dest {
            display: block;
            position: relative;
            overflow: hidden;
            border-radius: var(--kd-card-radius);
            background: var(--kd-white);
            border: 1px solid rgba(20, 39, 31, .08);
            color: inherit;
            text-decoration: none;
            transition:
                transform .5s var(--kd-ease-out),
                box-shadow .5s var(--kd-ease-out),
                border-color .4s var(--kd-ease);
        }
        .kd-dest:hover {
            transform: translateY(-5px);
            border-color: rgba(83, 107, 80, .22);
            box-shadow: 0 30px 60px -34px rgba(20, 39, 31, .42);
        }
        .kd-dest:focus-visible {
            outline: 2px solid var(--kd-sand);
            outline-offset: 3px;
        }

        .kd-dest__media {
            position: relative;
            overflow: hidden;
            background: var(--kd-sand);
            border-radius: var(--kd-card-radius) var(--kd-card-radius) 0 0;
        }
        .kd-dest__media img {
            display: block;
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 1.1s var(--kd-ease-out);
        }
        .kd-dest:hover .kd-dest__media img { transform: scale(1.06); }

        /* floating index chip */
        .kd-dest__index {
            position: absolute;
            top: 14px;
            left: 14px;
            z-index: 2;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-width: 34px;
            height: 26px;
            padding: 0 10px;
            border-radius: 999px;
            background: rgba(248, 246, 240, .94);
            backdrop-filter: blur(8px);
            font-family: var(--kd-serif);
            font-style: italic;
            font-size: .72rem;
            font-weight: 500;
            letter-spacing: .06em;
            color: var(--kd-forest);
            box-shadow: 0 10px 20px -14px rgba(0, 0, 0, .4);
        }

        /* hover overlay plate */
        .kd-dest__overlay {
            position: absolute;
            inset: 0;
            z-index: 3;
            display: flex;
            align-items: flex-end;
            padding: 16px;
            background: linear-gradient(to top,
                rgba(20, 39, 31, .82) 0%,
                rgba(20, 39, 31, .3) 42%,
                transparent 70%);
            opacity: 0;
            transition: opacity .5s var(--kd-ease);
        }
        .kd-dest:hover .kd-dest__overlay,
        .kd-dest:focus-visible .kd-dest__overlay {
            opacity: 1;
        }
        .kd-dest__overlay span {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            padding: 8px 14px;
            border-radius: 999px;
            background: rgba(248, 246, 240, .95);
            color: var(--kd-forest);
            font-size: .6rem;
            font-weight: 600;
            letter-spacing: .18em;
            text-transform: uppercase;
            transform: translateY(8px);
            transition: transform .5s var(--kd-ease-out);
        }
        .kd-dest:hover .kd-dest__overlay span,
        .kd-dest:focus-visible .kd-dest__overlay span {
            transform: translateY(0);
        }
        .kd-dest__overlay svg {
            flex: none;
            transition: transform .4s var(--kd-ease-out);
        }
        .kd-dest:hover .kd-dest__overlay svg { transform: translateX(4px); }

        .kd-dest__body {
            padding: clamp(18px, 2.2vw, 22px) clamp(20px, 2.4vw, 26px) clamp(20px, 2.6vw, 26px);
        }
        .kd-dest__region {
            display: block;
            margin-bottom: 8px;
            font-size: .62rem;
            font-weight: 600;
            letter-spacing: .2em;
            text-transform: uppercase;
            color: var(--kd-muted);
        }
        .kd-dest__title {
            margin: 0 0 8px;
            font-family: var(--kd-serif);
            font-weight: 500;
            font-size: clamp(1.25rem, 1.8vw, 1.7rem);
            line-height: 1.2;
            letter-spacing: -.005em;
            color: var(--kd-forest);
        }
        .kd-dest--span7 .kd-dest__title { font-size: clamp(1.5rem, 2.2vw, 2rem); }
        .kd-dest__desc {
            margin: 0 0 14px;
            font-size: .9rem;
            line-height: 1.65;
            color: var(--kd-muted);
            display: -webkit-box;
            -webkit-line-clamp: 3;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }
        .kd-dest__link {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            font-size: .66rem;
            font-weight: 600;
            letter-spacing: .2em;
            text-transform: uppercase;
            color: var(--kd-forest);
        }
        .kd-dest__link .kd-rule {
            width: 22px;
            height: 1px;
            background: currentColor;
            opacity: .5;
            transition: width .4s var(--kd-ease), opacity .4s var(--kd-ease);
        }
        .kd-dest:hover .kd-dest__link .kd-rule { width: 46px; opacity: 1; }
        .kd-dest__link svg {
            flex: none;
            transition: transform .4s var(--kd-ease-out);
        }
        .kd-dest:hover .kd-dest__link svg { transform: translateX(5px); }

        /* --- feature destination --- */
        .kd-dest--feature {
            grid-column: 1 / -1;
            display: flex;
            align-items: flex-end;
            min-height: clamp(400px, 44vw, 540px);
            padding: clamp(24px, 4vw, 48px);
            color: var(--kd-ivory);
            background: var(--kd-forest);
            overflow: hidden;
            isolation: isolate;
            border: 0;
        }
        .kd-dest--feature:hover { transform: translateY(-3px); }
        .kd-dest--feature .kd-dest__media {
            position: absolute;
            inset: 0;
            z-index: 0;
            border-radius: inherit;
        }
        .kd-dest--feature .kd-dest__media img { transform: scale(1.02); }
        .kd-dest--feature:hover .kd-dest__media img { transform: scale(1.06); }

        .kd-dest__scrim {
            position: absolute;
            inset: 0;
            z-index: 1;
            pointer-events: none;
            background:
                linear-gradient(to top,
                    rgba(10, 22, 17, .94) 0%,
                    rgba(10, 22, 17, .66) 38%,
                    rgba(10, 22, 17, .12) 72%,
                    rgba(10, 22, 17, .28) 100%);
        }
        .kd-dest--feature .kd-dest__body {
            position: relative;
            z-index: 2;
            max-width: 640px;
            padding: 0;
        }
        .kd-dest--feature .kd-dest__region { color: var(--kd-sand); }
        .kd-dest--feature .kd-dest__title {
            font-size: clamp(2rem, 4vw, 3.2rem);
            color: var(--kd-ivory);
        }
        .kd-dest--feature .kd-dest__desc {
            color: rgba(248, 246, 240, .84);
            -webkit-line-clamp: 4;
        }

        /* feature meta bar */
        .kd-dest__meta-bar {
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            justify-content: space-between;
            gap: 14px;
            margin-top: 20px;
            padding-top: 18px;
            border-top: 1px solid rgba(248, 246, 240, .18);
        }
        .kd-dest__meta-bar .kd-dest__link {
            color: var(--kd-ivory);
            padding: 12px 18px;
            border: 1px solid rgba(248, 246, 240, .35);
            border-radius: 999px;
            letter-spacing: .2em;
            transition:
                background .4s var(--kd-ease),
                border-color .4s var(--kd-ease),
                transform .4s var(--kd-ease-out);
        }
        .kd-dest--feature:hover .kd-dest__meta-bar .kd-dest__link {
            background: rgba(248, 246, 240, .14);
            border-color: rgba(248, 246, 240, .65);
        }
        .kd-dest__meta-bar .kd-dest__link .kd-rule { display: none; }

        .kd-dest__index--feature {
            position: absolute;
            top: clamp(20px, 3vw, 28px);
            right: clamp(20px, 3vw, 28px);
            z-index: 2;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-width: 44px;
            height: 34px;
            padding: 0 12px;
            border-radius: 999px;
            background: rgba(248, 246, 240, .94);
            backdrop-filter: blur(8px);
            font-family: var(--kd-serif);
            font-style: italic;
            font-size: .82rem;
            font-weight: 500;
            letter-spacing: .08em;
            color: var(--kd-forest);
            box-shadow: 0 14px 28px -18px rgba(0, 0, 0, .5);
        }

        /* --- span variants --- */
        .kd-dest--span7 { grid-column: span 7; }
        .kd-dest--span5 { grid-column: span 5; }
        .kd-dest--span4 { grid-column: span 4; }
        .kd-dest--span6 { grid-column: span 6; }

        /* --- aspect ratios for vertical cards --- */
        .kd-dest--span7 .kd-dest__media { aspect-ratio: 16 / 10; }
        .kd-dest--span5 .kd-dest__media { aspect-ratio: 4 / 5; }
        .kd-dest--span4 .kd-dest__media { aspect-ratio: 1 / 1; }

        /* --- horizontal card variant --- */
        .kd-dest--horizontal {
            display: flex;
            flex-direction: row;
            align-items: stretch;
            min-height: 280px;
            background: var(--kd-white);
        }
        .kd-dest--horizontal .kd-dest__media {
            width: 48%;
            flex: none;
            aspect-ratio: auto;
            min-height: 100%;
            border-radius: var(--kd-card-radius) 0 0 var(--kd-card-radius);
        }
        .kd-dest--horizontal .kd-dest__media img {
            position: absolute;
            inset: 0;
            width: 100%;
            height: 100%;
        }
        .kd-dest--horizontal .kd-dest__body {
            width: 52%;
            padding: clamp(22px, 2.6vw, 32px);
            display: flex;
            flex-direction: column;
            justify-content: center;
            border-left: 1px solid rgba(20, 39, 31, .06);
        }
        .kd-dest--horizontal .kd-dest__desc { -webkit-line-clamp: 3; }

        /* --- staggered entrance --- */
        .kd-gallery > .kd-dest:nth-child(1) { --kd-delay: 0ms; }
        .kd-gallery > .kd-dest:nth-child(2) { --kd-delay: 70ms; }
        .kd-gallery > .kd-dest:nth-child(3) { --kd-delay: 130ms; }
        .kd-gallery > .kd-dest:nth-child(4) { --kd-delay: 190ms; }
        .kd-gallery > .kd-dest:nth-child(5) { --kd-delay: 250ms; }
        .kd-gallery > .kd-dest:nth-child(6) { --kd-delay: 310ms; }
        .kd-gallery > .kd-dest:nth-child(7) { --kd-delay: 370ms; }
        .kd-gallery > .kd-dest:nth-child(8) { --kd-delay: 430ms; }
        .kd-gallery > .kd-dest:nth-child(9) { --kd-delay: 490ms; }
        .kd-gallery > .kd-dest:nth-child(10) { --kd-delay: 550ms; }

        /* ---------------------------------------------------- 04 — EMPTY ---- */
        .kd-empty {
            position: relative;
            grid-column: 1 / -1;
            overflow: hidden;
            text-align: center;
            padding: clamp(48px, 8vw, 96px) 24px;
            background: var(--kd-white);
            border: 1px solid rgba(20, 39, 31, .1);
            border-radius: var(--kd-card-radius);
        }
        .kd-empty::before {
            content: "";
            position: absolute;
            inset: 0;
            background:
                radial-gradient(ellipse 60% 60% at 50% 0%, rgba(143, 168, 136, .14), transparent 70%),
                radial-gradient(ellipse 50% 50% at 50% 100%, rgba(232, 223, 201, .4), transparent 70%);
            pointer-events: none;
        }
        .kd-empty > * { position: relative; z-index: 1; }
        .kd-empty h2 {
            margin: 0 0 12px;
            font-family: var(--kd-serif);
            font-weight: 500;
            font-size: clamp(1.8rem, 3vw, 2.4rem);
            color: var(--kd-forest);
        }
        .kd-empty p {
            margin: 0 auto 26px;
            max-width: 48ch;
            font-size: .98rem;
            line-height: 1.7;
            color: var(--kd-muted);
        }

        /* ------------------------------------------------------- 05 — CTA ---- */
        .kd-cta {
            position: relative;
            overflow: hidden;
            padding: clamp(68px, 9vw, 120px) 0;
            background: var(--kd-forest);
            color: var(--kd-ivory);
            border-top: 1px solid rgba(232, 223, 201, .16);
            isolation: isolate;
        }
        .kd-cta__bg {
            position: absolute;
            inset: 0;
            z-index: 0;
        }
        .kd-cta__bg img {
            display: block;
            width: 100%;
            height: 100%;
            object-fit: cover;
            opacity: .24;
        }
        .kd-cta::before {
            content: "";
            position: absolute;
            inset: 0;
            z-index: 1;
            pointer-events: none;
            background:
                linear-gradient(180deg,
                    rgba(20, 39, 31, .9) 0%,
                    rgba(20, 39, 31, .55) 46%,
                    rgba(20, 39, 31, .95) 100%);
        }
        .kd-cta__inner {
            position: relative;
            z-index: 2;
            max-width: 760px;
            margin: 0 auto;
            text-align: center;
        }
        .kd-cta__inner .kd-eyebrow { justify-content: center; margin-bottom: 22px; }
        .kd-cta h2 {
            margin: 0 0 20px;
            font-family: var(--kd-serif);
            font-weight: 500;
            font-size: clamp(2rem, 4.2vw, 3.4rem);
            line-height: 1.08;
            letter-spacing: -.02em;
            color: var(--kd-ivory);
        }
        .kd-cta__lede {
            margin: 0 auto 36px;
            max-width: 52ch;
            font-size: clamp(.98rem, 1.1vw, 1.06rem);
            line-height: 1.75;
            color: rgba(248, 246, 240, .78);
        }

        .kd-btn {
            display: inline-flex;
            align-items: center;
            gap: 14px;
            padding: 18px 34px;
            border: 1px solid transparent;
            border-radius: 999px;
            background: var(--kd-ivory);
            color: var(--kd-forest);
            font-size: .72rem;
            font-weight: 600;
            letter-spacing: .22em;
            text-transform: uppercase;
            text-decoration: none;
            transition:
                background .4s var(--kd-ease),
                color .4s var(--kd-ease),
                transform .4s var(--kd-ease-out),
                box-shadow .4s var(--kd-ease-out);
        }
        .kd-btn svg {
            flex: none;
            transition: transform .4s var(--kd-ease-out);
        }
        .kd-btn:hover {
            background: var(--kd-sand);
            transform: translateY(-2px);
            box-shadow: 0 18px 32px -18px rgba(0, 0, 0, .45);
        }
        .kd-btn:hover svg { transform: translateX(5px); }
        .kd-btn:focus-visible {
            outline: 2px solid var(--kd-sand);
            outline-offset: 4px;
        }

        /* --- empty-state CTA --- */
        .kd-empty__actions {
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
            gap: 12px;
        }
        .kd-empty__btn {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            padding: 14px 24px;
            border-radius: 999px;
            background: var(--kd-forest);
            color: var(--kd-ivory);
            font-size: .68rem;
            font-weight: 600;
            letter-spacing: .18em;
            text-transform: uppercase;
            text-decoration: none;
            transition:
                transform .4s var(--kd-ease-out),
                box-shadow .4s var(--kd-ease-out),
                background .3s var(--kd-ease);
        }
        .kd-empty__btn:hover {
            background: var(--kd-forest);
            transform: translateY(-2px);
            box-shadow: 0 16px 30px -18px rgba(20, 39, 31, .5);
        }
        .kd-empty__btn--ghost {
            background: transparent;
            color: var(--kd-forest);
            border: 1px solid rgba(20, 39, 31, .22);
        }
        .kd-empty__btn--ghost:hover {
            background: var(--kd-white);
            border-color: var(--kd-forest);
        }

        /* --------------------------------------------------- RESPONSIVE ---- */
        @@media (max-width: 1024px) {
            .kd-hero { padding: calc(var(--header-h, 80px) + 44px) 0 clamp(44px, 6vw, 68px); }
            .kd-hero__grid {
                grid-template-columns: minmax(0, 1fr);
                gap: clamp(26px, 5vw, 40px);
            }
            .kd-hero h1 { max-width: 18ch; }
            .kd-hero__frame { height: clamp(280px, 48vw, 420px); }

            .kd-gallery { grid-template-columns: repeat(2, minmax(0, 1fr)); }
            .kd-dest--feature { grid-column: 1 / -1; }
            .kd-dest:not(.kd-dest--feature) { grid-column: span 1; }

            .kd-dest--horizontal { display: block; min-height: 0; }
            .kd-dest--horizontal .kd-dest__media {
                width: 100%;
                aspect-ratio: 4 / 3;
                min-height: 0;
                border-radius: var(--kd-card-radius) var(--kd-card-radius) 0 0;
            }
            .kd-dest--horizontal .kd-dest__media img {
                position: static;
                width: 100%;
                height: 100%;
            }
            .kd-dest--horizontal .kd-dest__body {
                width: 100%;
                padding: clamp(18px, 2.2vw, 22px) clamp(20px, 2.4vw, 26px) clamp(20px, 2.6vw, 26px);
                display: block;
                border-left: 0;
            }
            .kd-dest--span7 .kd-dest__media,
            .kd-dest--span5 .kd-dest__media,
            .kd-dest--span4 .kd-dest__media,
            .kd-dest--span6 .kd-dest__media { aspect-ratio: 4 / 3; }
        }

        @@media (max-width: 640px) {
            .kd-hero { padding-top: calc(var(--header-h, 80px) + 32px); }
            .kd-hero h1 { margin-bottom: 18px; }
            .kd-eyebrow { letter-spacing: .24em; font-size: .66rem; }

            .kd-intro__inner {
                flex-direction: column;
                align-items: flex-start;
                gap: 14px;
            }
            .kd-intro__meta {
                flex-direction: column;
                align-items: flex-start;
                gap: 8px;
            }

            .kd-gallery { grid-template-columns: 1fr; }
            .kd-dest--feature {
                grid-column: 1 / -1;
                min-height: 380px;
                padding: 24px;
            }
            .kd-dest:not(.kd-dest--feature) { grid-column: 1 / -1; }
            .kd-dest--feature .kd-dest__title { font-size: 1.9rem; }

            .kd-dest__media,
            .kd-dest--span7 .kd-dest__media,
            .kd-dest--span5 .kd-dest__media,
            .kd-dest--span4 .kd-dest__media,
            .kd-dest--span6 .kd-dest__media,
            .kd-dest--horizontal .kd-dest__media { aspect-ratio: 4 / 3; }

            .kd-cta__inner { text-align: left; }
            .kd-cta__inner .kd-eyebrow { justify-content: flex-start; }
            .kd-cta__lede { margin-left: 0; margin-right: 0; }
            .kd-btn { width: 100%; justify-content: center; padding: 18px 24px; }
            .kd-empty__actions { flex-direction: column; }
            .kd-empty__btn { width: 100%; justify-content: center; }
        }

        /* --------------------------------------------- REDUCED MOTION ---- */
        @@media (prefers-reduced-motion: reduce) {
            .kd-reveal {
                opacity: 1 !important;
                transform: none !important;
                transition: none !important;
            }
            .kd-hero__frame img,
            .kd-dest__media img,
            .kd-dest__link .kd-rule,
            .kd-dest__link svg,
            .kd-dest__overlay,
            .kd-dest__overlay span,
            .kd-dest__overlay svg,
            .kd-btn,
            .kd-btn svg,
            .kd-empty__btn {
                transition: none !important;
            }
            .kd-hero__frame img,
            .kd-dest__media img,
            .kd-dest:hover .kd-dest__media img,
            .kd-dest--feature:hover .kd-dest__media img {
                transform: none !important;
            }
            .kd-dest:hover { transform: none !important; }
            .kd-dest:hover .kd-dest__link .kd-rule {
                width: 22px !important;
                opacity: .5 !important;
            }
            .kd-dest:hover .kd-dest__link svg,
            .kd-btn:hover svg { transform: none !important; }
            .kd-btn:hover { transform: none; }
            .kd-dest__overlay { opacity: 1; background: none; }
            .kd-dest__overlay span { transform: none; }
        }
    </style>
}

<div class="kd-page">

    <noscript>
        <style>
            .kd-reveal { opacity: 1 !important; transform: none !important; }
            .kd-hero__frame img { transform: none !important; }
        </style>
    </noscript>

    <!-- =====================================================================
         SECTION 01 — CINEMATIC HERO
         ===================================================================== -->
    <header class="kd-hero">
        <div class="container kd-hero__grid">

            <div class="kd-hero__text kd-reveal">
                <p class="kd-eyebrow">Discover More / Tourist Spots</p>
                <h1>Discover the <em>extraordinary</em>.</h1>
                <p class="kd-hero__lede">
                    From the dramatic peaks of the north to historic cities and coastal escapes,
                    explore the places that make Pakistan unforgettable.
                </p>
            </div>

            <div class="kd-hero__media kd-reveal" style="--kd-delay:140ms">
                <figure class="kd-hero__frame media"
                        data-fallback-label="Mountain landscape in northern Pakistan">
                    <img src="https://images.unsplash.com/photo-1506905925346-21bda4d32df4?auto=format&fit=crop&w=1200&q=75"
                         alt="Snow-capped mountain peaks rising above a valley in northern Pakistan"
                         loading="eager" fetchpriority="high" />
                </figure>
                <span class="kd-hero__caption">Northern Pakistan</span>
            </div>

        </div>
    </header>

    <!-- =====================================================================
         SECTION 02 — DESTINATION COLLECTION INTRODUCTION
         ===================================================================== -->
    <section class="kd-intro" aria-labelledby="kd-intro-heading">
        <div class="container">
            <div class="kd-intro__inner kd-reveal">

                <div>
                    <p class="kd-eyebrow">The Collection</p>
                    <h2 id="kd-intro-heading">Places worth the journey.</h2>
                </div>

                <div class="kd-intro__meta">
                    <p class="kd-intro__desc">
                        Explore destinations across Pakistan, each with its own landscape,
                        character and story.
                    </p>

                    @if (hasDestinations)
                    {
                        <p class="kd-intro__count">
                            <strong>@totalDestinations</strong>
                            @(totalDestinations == 1 ? "destination" : "destinations")
                        </p>
                    }
                </div>

            </div>
        </div>
    </section>

    <!-- =====================================================================
         SECTION 03 — EDITORIAL DESTINATION GALLERY
         ===================================================================== -->
    <section class="kd-gallery-section" aria-label="Tourist destinations">
        <div class="container">

            @if (hasDestinations)
            {
                <div class="kd-gallery">

                    @foreach (var destination in Model)
                    {
                        var isFirst = index == 0;
                        string layoutClass;

                        if (isFirst)
                        {
                            layoutClass = "kd-dest--feature";
                        }
                        else
                        {
                            var pattern = (index - 1) % 7;
                            switch (pattern)
                            {
                                case 0: layoutClass = "kd-dest--span7"; break;
                                case 1: layoutClass = "kd-dest--span5"; break;
                                case 2: layoutClass = "kd-dest--span4"; break;
                                case 3: layoutClass = "kd-dest--span4"; break;
                                case 4: layoutClass = "kd-dest--span4"; break;
                                case 5: layoutClass = "kd-dest--span6 kd-dest--horizontal"; break;
                                case 6: layoutClass = "kd-dest--span6 kd-dest--horizontal"; break;
                                default: layoutClass = "kd-dest--span4"; break;
                            }
                        }

                        <a class="kd-dest @layoutClass kd-reveal"
                           href="@Url.Action("Details", "Destinations", new { slug = destination.Slug })"
                           style="--kd-delay:@(index * 80)ms"
                           aria-label="@(isFirst ? "Featured destination" : "Destination") — @destination.Name">

                            <div class="kd-dest__media media"
                                 data-fallback-label="@destination.Name">
                                @if (!string.IsNullOrWhiteSpace(destination.ImageUrl))
                                {
                                    <img src="@destination.ImageUrl"
                                         alt="@destination.Name"
                                         loading="lazy" />
                                }
                            </div>

                            @if (!isFirst)
                            {
                                <span class="kd-dest__index" aria-hidden="true">
                                    @((index + 1).ToString("00"))
                                </span>
                                <div class="kd-dest__overlay" aria-hidden="true">
                                    <span>
                                        Explore
                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none"
                                             stroke="currentColor" stroke-width="1.8"
                                             stroke-linecap="round" stroke-linejoin="round"
                                             focusable="false">
                                            <path d="M5 12h14M13 6l6 6-6 6" />
                                        </svg>
                                    </span>
                                </div>
                            }

                            @if (isFirst)
                            {
                                <span class="kd-dest__scrim" aria-hidden="true"></span>
                                <span class="kd-dest__index--feature" aria-hidden="true">01</span>
                            }

                            <div class="kd-dest__body">
                                <span class="kd-dest__region">
                                    @(string.IsNullOrWhiteSpace(destination.Region)
                                        ? "Pakistan"
                                        : destination.Region)
                                </span>

                                <h2 class="kd-dest__title">@destination.Name</h2>

                                <p class="kd-dest__desc">
                                    @(string.IsNullOrWhiteSpace(destination.ShortDescription)
                                        ? "Discover this destination with Karnel Travel Guide."
                                        : destination.ShortDescription)
                                </p>

                                @if (isFirst)
                                {
                                    <div class="kd-dest__meta-bar">
                                        <span class="kd-dest__link">
                                            Explore destination
                                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none"
                                                 stroke="currentColor" stroke-width="1.6"
                                                 stroke-linecap="round" stroke-linejoin="round"
                                                 aria-hidden="true" focusable="false">
                                                <path d="M5 12h14M13 6l6 6-6 6" />
                                            </svg>
                                        </span>
                                    </div>
                                }
                                else
                                {
                                    <span class="kd-dest__link">
                                        <span class="kd-rule" aria-hidden="true"></span>
                                        Explore destination
                                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none"
                                             stroke="currentColor" stroke-width="1.6"
                                             stroke-linecap="round" stroke-linejoin="round"
                                             aria-hidden="true" focusable="false">
                                            <path d="M5 12h14M13 6l6 6-6 6" />
                                        </svg>
                                    </span>
                                }
                            </div>

                        </a>

                        index++;
                    }

                </div>
            }
            else
            {
                <div class="kd-empty kd-reveal">
                    <h2>New places are on the way.</h2>
                    <p>
                        Our destination collection is being prepared. Check back soon — or
                        explore what else the guide has to offer.
                    </p>
                    <div class="kd-empty__actions">
                        <a class="kd-empty__btn" href="@Url.Action("Index", "Search")">
                            Browse all listings
                        </a>
                        <a class="kd-empty__btn kd-empty__btn--ghost" href="@Url.Action("Index", "Contact")">
                            Plan with us
                        </a>
                    </div>
                </div>
            }

        </div>
    </section>

    <!-- =====================================================================
         SECTION 05 — JOURNEY PLANNING CTA
         ===================================================================== -->
    <section class="kd-cta" aria-labelledby="kd-cta-heading">

        <div class="kd-cta__bg media" data-fallback-label="Cinematic travel landscape" aria-hidden="true">
            <img src="https://images.unsplash.com/photo-1500530855697-b586d89ba3ee?auto=format&fit=crop&w=1600&q=70"
                 alt="" loading="lazy" />
        </div>

        <div class="container kd-cta__inner kd-reveal">
            <p class="kd-eyebrow kd-eyebrow--light">Plan Ahead</p>
            <h2 id="kd-cta-heading">Your next journey deserves a plan.</h2>
            <p class="kd-cta__lede">
                Tell us where you want to go, when you plan to travel and how many people are travelling.
            </p>
            <a class="kd-btn" href="@Url.Action("Index", "Contact")">
                Plan your journey
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="1.6"
                     stroke-linecap="round" stroke-linejoin="round"
                     aria-hidden="true" focusable="false">
                    <path d="M5 12h14M13 6l6 6-6 6" />
                </svg>
            </a>
        </div>

    </section>

</div>

@section Scripts {
    <script>
        (function () {
            var items = document.querySelectorAll('.kd-reveal');
            if (!items.length) { return; }

            var prefersReduced = window.matchMedia
                && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

            function showAll() {
                for (var i = 0; i < items.length; i++) {
                    items[i].classList.add('is-in');
                }
            }

            if (prefersReduced || !('IntersectionObserver' in window)) {
                showAll();
                return;
            }

            var observer = new IntersectionObserver(function (entries) {
                for (var i = 0; i < entries.length; i++) {
                    if (entries[i].isIntersecting) {
                        entries[i].target.classList.add('is-in');
                        observer.unobserve(entries[i].target);
                    }
                }
            }, {
                root: null,
                rootMargin: '0px 0px -8% 0px',
                threshold: 0.12
            });

            for (var j = 0; j < items.length; j++) {
                observer.observe(items[j]);
            }
        })();
    </script>
}