@model IEnumerable<KarnelTravel.Models.TransportRoute>

@{
    Layout = "_Layout";
    ViewData["Title"] = "Transport Routes | Karnel Travel Guide";
    ViewData["Description"] = "Compare transport routes across Pakistan — cities, starting prices, and vehicle options.";

    var routes = Model?.ToList() ?? new List<KarnelTravel.Models.TransportRoute>();
    var hasRoutes = routes.Any();
    var totalRoutes = routes.Count;
}

@section Styles {
    <style>
        /* ============================================================
           KARNEL — TRANSPORT ROUTES LISTING
           Page-scoped styles. All rules prefixed with .rt-page.
           ============================================================ */

        .rt-page {
            --rt-forest: var(--forest-deep, #14271F);
            --rt-forest-2: var(--forest, #1B3428);
            --rt-ivory: var(--ivory, #F8F6F0);
            --rt-sand: var(--sand, #E8DFC9);
            --rt-sage: var(--sage, #8FA888);
            --rt-moss: var(--moss, #536B50);
            --rt-white: #FFFFFF;
            --rt-ink: #1B2922;
            --rt-muted: var(--muted, #6B7A70);
            --rt-line: rgba(20, 39, 31, .10);
            --rt-line-strong: rgba(20, 39, 31, .18);
            --rt-serif: var(--serif, "Playfair Display", 'DM Serif Display', Georgia, serif);
            --rt-sans: var(--sans, "Inter", 'DM Sans', system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif);
            --rt-ease: cubic-bezier(.22, .72, .24, 1);
            --rt-ease-out: cubic-bezier(.16, 1, .3, 1);
            --rt-dur: .24s;
            --rt-card-radius: 20px;
            --rt-card-radius-sm: 14px;

            margin: 0;
            padding: 0;
            background: var(--rt-ivory);
            color: var(--rt-forest);
            overflow-x: hidden; /* Prevent horizontal scroll from rogue elements */
        }

        /* Force a proper max-width and safe padding for all inner content */
        .rt-page .container {
            width: 100%;
            max-width: 1200px;
            margin: 0 auto;
            padding-left: clamp(20px, 5vw, 48px);
            padding-right: clamp(20px, 5vw, 48px);
        }

        /* ---------- Shared atoms ---------- */
        .rt-page .rt-eyebrow {
            display: inline-flex;
            align-items: center;
            gap: 12px;
            margin: 0 0 18px;
            font-family: var(--rt-sans);
            font-size: .66rem;
            font-weight: 600;
            letter-spacing: .24em;
            text-transform: uppercase;
            color: var(--rt-moss);
        }
        .rt-page .rt-eyebrow::before {
            content: '';
            width: 28px;
            height: 1px;
            background: currentColor;
            opacity: .85;
        }
        .rt-page .rt-eyebrow--light { color: var(--rt-sand); }

        /* Reveal */
        .rt-page .kd-reveal {
            opacity: 0;
            transform: translateY(26px);
            transition:
                opacity .9s var(--rt-ease),
                transform .9s var(--rt-ease);
            transition-delay: var(--kd-delay, 0ms);
        }
        .rt-page .kd-reveal.is-in {
            opacity: 1;
            transform: none;
        }

        /* ============================================================
           HERO
           ============================================================ */
        .rt-page .rt-hero {
            position: relative;
            padding: clamp(56px, 7.5vw, 104px) 0 clamp(56px, 7.5vw, 104px);
            background: var(--rt-ivory);
            overflow: hidden;
        }
        .rt-page .rt-hero__grid {
            display: grid;
            grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
            gap: clamp(36px, 5vw, 76px);
            align-items: start;
        }
        .rt-page .rt-hero__text {
            max-width: 540px;
            min-width: 0;
            padding-top: clamp(0px, 1.4vw, 16px);
        }
        .rt-page .rt-hero__text h1 {
            margin: 16px 0 22px;
            font-family: var(--rt-serif);
            font-weight: 500;
            font-size: clamp(2.4rem, 5.2vw, 4.4rem);
            line-height: 1.02;
            letter-spacing: -.024em;
            color: var(--rt-forest);
            text-wrap: balance;
        }
        .rt-page .rt-hero__text h1 em {
            font-style: italic;
            color: var(--rt-moss);
            font-weight: 500;
        }
        .rt-page .rt-hero__lede {
            margin: 0;
            max-width: 52ch;
            font-family: var(--rt-sans);
            font-size: clamp(.96rem, 1.2vw, 1.06rem);
            line-height: 1.72;
            color: var(--rt-muted);
        }
        .rt-page .rt-hero__media { position: relative; min-width: 0; }
        .rt-page .rt-hero__frame {
            position: relative;
            margin: 0;
            overflow: hidden;
            border-radius: var(--rt-card-radius);
            aspect-ratio: 4 / 5;
            max-height: 640px;
            background: var(--rt-forest);
            box-shadow: 0 46px 90px -54px rgba(20, 39, 31, .50);
        }
        .rt-page .rt-hero__frame img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            display: block;
            transform: scale(1.04);
            transition: transform 1.4s var(--rt-ease-out);
        }
        .rt-page .rt-hero:hover .rt-hero__frame img { transform: scale(1.06); }

        .rt-page .rt-hero__caption {
            position: absolute;
            left: clamp(16px, 3vw, 28px);
            bottom: clamp(16px, 3vw, 28px);
            display: inline-flex;
            align-items: center;
            gap: 12px;
            padding: 10px 16px;
            border-radius: 12px;
            background: rgba(248, 246, 240, .94);
            backdrop-filter: blur(10px);
            box-shadow: 0 18px 36px -22px rgba(0, 0, 0, .45);
            font-family: var(--rt-sans);
            font-size: .62rem;
            font-weight: 600;
            letter-spacing: .18em;
            text-transform: uppercase;
            color: var(--rt-forest);
        }
        .rt-page .rt-hero__caption::before {
            content: "";
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background: var(--rt-sage);
            box-shadow: 0 0 0 4px rgba(143, 168, 136, .25);
        }

        /* ============================================================
           INTRODUCTION
           ============================================================ */
        .rt-page .rt-intro {
            padding: clamp(40px, 5vw, 64px) 0 clamp(28px, 3.5vw, 44px);
            background: var(--rt-ivory);
        }
        .rt-page .rt-intro__inner {
            display: flex;
            flex-wrap: wrap;
            align-items: flex-end;
            justify-content: space-between;
            gap: 18px 48px;
            padding-bottom: clamp(18px, 2.4vw, 28px);
            border-bottom: 1px solid var(--rt-line);
        }
        .rt-page .rt-intro__inner h2 {
            margin: 0;
            font-family: var(--rt-serif);
            font-weight: 500;
            font-size: clamp(1.9rem, 3.2vw, 2.7rem);
            line-height: 1.08;
            letter-spacing: -.015em;
            color: var(--rt-forest);
        }
        .rt-page .rt-intro__meta {
            display: flex;
            flex-wrap: wrap;
            align-items: baseline;
            gap: 12px 24px;
        }
        .rt-page .rt-intro__desc {
            margin: 0;
            max-width: 44ch;
            font-family: var(--rt-sans);
            font-size: .95rem;
            line-height: 1.7;
            color: var(--rt-muted);
        }
        .rt-page .rt-intro__count {
            display: inline-flex;
            align-items: baseline;
            gap: 8px;
            margin: 0;
            padding: 8px 14px;
            border-radius: 999px;
            background: var(--rt-sand);
            font-family: var(--rt-sans);
            font-size: .62rem;
            font-weight: 600;
            letter-spacing: .18em;
            text-transform: uppercase;
            color: var(--rt-forest);
        }
        .rt-page .rt-intro__count strong {
            font-family: var(--rt-serif);
            font-size: 1.05rem;
            font-weight: 500;
            letter-spacing: 0;
        }

        /* ============================================================
           GALLERY
           ============================================================ */
        .rt-page .rt-gallery {
            padding: 0 0 clamp(72px, 8vw, 120px);
            background: var(--rt-ivory);
        }
        .rt-page .rt-grid {
            display: grid;
            grid-template-columns: 1fr;
            gap: 24px;
            align-items: stretch;
        }

        /* ---------- Card ---------- */
        .rt-page .rt-card {
            position: relative;
            display: flex;
            background: var(--rt-white);
            border: 1px solid var(--rt-line);
            border-radius: var(--rt-card-radius);
            overflow: hidden;
            transition:
                border-color var(--rt-dur) var(--rt-ease),
                box-shadow var(--rt-dur) var(--rt-ease),
                transform var(--rt-dur) var(--rt-ease);
        }
        .rt-page .rt-card:hover {
            border-color: var(--rt-line-strong);
            box-shadow: 0 30px 60px -34px rgba(20, 39, 31, .32);
            transform: translateY(-3px);
        }

        .rt-page .rt-card__accent {
            position: absolute;
            top: 0;
            left: 28px;
            width: 36px;
            height: 2px;
            background: var(--rt-sage);
            opacity: .65;
            transition: width .34s var(--rt-ease), opacity .34s var(--rt-ease);
            z-index: 1;
        }
        .rt-page .rt-card:hover .rt-card__accent {
            width: 76px;
            opacity: 1;
        }

        .rt-page .rt-card__plate {
            position: absolute;
            top: 16px;
            right: 16px;
            z-index: 2;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 6px 12px;
            border-radius: 999px;
            background: rgba(248, 246, 240, .96);
            backdrop-filter: blur(8px);
            box-shadow: 0 10px 20px -14px rgba(0, 0, 0, .3);
            font-family: var(--rt-sans);
            font-size: .56rem;
            font-weight: 600;
            letter-spacing: .16em;
            text-transform: uppercase;
            color: var(--rt-forest);
        }
        .rt-page .rt-card__plate::before {
            content: "";
            width: 6px;
            height: 6px;
            border-radius: 50%;
            background: var(--rt-sage);
        }
        .rt-page .rt-card__plate span { opacity: .55; margin: 0 2px; }

        .rt-page .rt-card__link {
            display: flex;
            flex-direction: column;
            width: 100%;
            height: 100%;
            padding: 34px 32px 28px;
            color: inherit;
            text-decoration: none;
        }
        .rt-page .rt-card__link:focus-visible {
            outline: 2px solid var(--rt-sage);
            outline-offset: -4px;
            border-radius: var(--rt-card-radius-sm);
        }

        .rt-page .rt-journey {
            display: grid;
            grid-template-columns: minmax(0, auto) 1fr minmax(0, auto);
            align-items: center;
            gap: 14px;
            padding-bottom: 22px;
            margin-bottom: 22px;
            border-bottom: 1px solid var(--rt-line);
        }
        .rt-page .rt-city { min-width: 0; }
        .rt-page .rt-city-to { text-align: right; }
        .rt-page .rt-city-role {
            display: block;
            margin-bottom: 5px;
            font-family: var(--rt-sans);
            font-size: 9px;
            font-weight: 700;
            letter-spacing: .20em;
            text-transform: uppercase;
            color: var(--rt-muted);
            line-height: 1.2;
        }
        .rt-page .rt-city-name {
            display: block;
            font-family: var(--rt-sans);
            font-size: 14px;
            font-weight: 600;
            line-height: 1.25;
            color: var(--rt-forest);
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            max-width: 16ch;
            transition: color var(--rt-dur) var(--rt-ease);
        }
        .rt-page .rt-card:hover .rt-city-name { color: var(--rt-forest-2); }

        .rt-page .rt-path { color: var(--rt-sage); min-width: 40px; height: 24px; }
        .rt-page .rt-path-svg {
            display: block;
            width: 100%;
            height: 100%;
            overflow: visible;
        }
        .rt-page .rt-path-line {
            transition: stroke-dashoffset .5s var(--rt-ease);
        }
        .rt-page .rt-card:hover .rt-path-line {
            animation: rt-flow 2s linear infinite;
        }
        @@keyframes rt-flow {
            from { stroke-dashoffset: 0; }
            to   { stroke-dashoffset: -12; }
        }

        .rt-page .rt-body { flex: 1 1 auto; min-width: 0; }
        .rt-page .rt-name {
            margin: 0 0 12px;
            font-family: var(--rt-serif);
            font-weight: 500;
            font-size: clamp(1.4rem, 2.2vw, 1.85rem);
            line-height: 1.16;
            letter-spacing: -.014em;
            color: var(--rt-forest);
            overflow-wrap: break-word;
        }
        .rt-page .rt-desc {
            margin: 0 0 22px;
            font-family: var(--rt-sans);
            font-size: .92rem;
            line-height: 1.65;
            color: var(--rt-muted);
            display: -webkit-box;
            -webkit-line-clamp: 3;
            line-clamp: 3;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }

        .rt-page .rt-foot {
            display: flex;
            align-items: flex-end;
            justify-content: space-between;
            gap: 16px;
            margin-top: auto;
            padding-top: 20px;
            border-top: 1px solid var(--rt-line);
        }
        .rt-page .rt-price { min-width: 0; }
        .rt-page .rt-price-label {
            display: block;
            margin-bottom: 4px;
            font-family: var(--rt-sans);
            font-size: 9px;
            font-weight: 700;
            letter-spacing: .20em;
            text-transform: uppercase;
            color: var(--rt-muted);
            line-height: 1.2;
        }
        .rt-page .rt-price-value {
            display: inline-flex;
            align-items: baseline;
            gap: 6px;
            white-space: nowrap;
        }
        .rt-page .rt-price-currency {
            font-family: var(--rt-sans);
            font-size: 10.5px;
            font-weight: 700;
            letter-spacing: .10em;
            text-transform: uppercase;
            color: var(--rt-muted);
        }
        .rt-page .rt-price-amount {
            font-family: var(--rt-serif);
            font-weight: 500;
            font-size: 1.6rem;
            line-height: 1;
            letter-spacing: -.012em;
            color: var(--rt-forest);
            font-variant-numeric: tabular-nums;
        }

        .rt-page .rt-cta {
            display: inline-flex;
            align-items: center;
            gap: 7px;
            flex-shrink: 0;
            padding: 10px 16px;
            border-radius: 999px;
            background: rgba(20, 39, 31, .04);
            font-family: var(--rt-sans);
            font-size: .72rem;
            font-weight: 600;
            letter-spacing: .12em;
            text-transform: uppercase;
            color: var(--rt-forest);
            white-space: nowrap;
            transition:
                background var(--rt-dur) var(--rt-ease),
                color var(--rt-dur) var(--rt-ease),
                transform var(--rt-dur) var(--rt-ease-out);
        }
        .rt-page .rt-card:hover .rt-cta {
            background: var(--rt-forest);
            color: var(--rt-ivory);
            transform: translateY(-1px);
        }
        .rt-page .rt-cta-arrow {
            transition: transform var(--rt-dur) var(--rt-ease-out);
        }
        .rt-page .rt-card:hover .rt-cta-arrow {
            transform: translateX(3px);
        }

        /* ---------- Empty state ---------- */
        .rt-page .rt-empty {
            position: relative;
            overflow: hidden;
            max-width: 620px;
            margin: 0 auto;
            padding: clamp(52px, 7vw, 88px) clamp(28px, 4vw, 48px) clamp(48px, 6vw, 72px);
            text-align: center;
            background: var(--rt-white);
            border: 1px solid var(--rt-line);
            border-radius: var(--rt-card-radius);
        }
        .rt-page .rt-empty::before {
            content: "";
            position: absolute;
            inset: 0;
            background:
                radial-gradient(ellipse 60% 60% at 50% 0%, rgba(143, 168, 136, .14), transparent 70%),
                radial-gradient(ellipse 50% 50% at 50% 100%, rgba(232, 223, 201, .40), transparent 70%);
            pointer-events: none;
        }
        .rt-page .rt-empty > * { position: relative; z-index: 1; }
        .rt-page .rt-empty__icon {
            display: inline-grid;
            place-items: center;
            width: 68px;
            height: 68px;
            margin-bottom: 22px;
            border-radius: 18px;
            background: rgba(143, 168, 136, .18);
            color: var(--rt-forest);
        }
        .rt-page .rt-empty__title {
            margin: 0 0 12px;
            font-family: var(--rt-serif);
            font-weight: 500;
            font-size: clamp(1.7rem, 3vw, 2.3rem);
            line-height: 1.15;
            letter-spacing: -.015em;
            color: var(--rt-forest);
        }
        .rt-page .rt-empty__desc {
            margin: 0 auto 28px;
            max-width: 46ch;
            font-family: var(--rt-sans);
            font-size: .94rem;
            line-height: 1.65;
            color: var(--rt-muted);
        }
        .rt-page .rt-empty__actions {
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
            gap: 12px;
        }
        .rt-page .rt-empty__cta {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 13px 24px;
            border-radius: 999px;
            background: var(--rt-forest);
            color: var(--rt-ivory);
            font-family: var(--rt-sans);
            font-size: .68rem;
            font-weight: 600;
            letter-spacing: .16em;
            text-transform: uppercase;
            text-decoration: none;
            transition:
                background var(--rt-dur) var(--rt-ease),
                transform var(--rt-dur) var(--rt-ease-out),
                box-shadow var(--rt-dur) var(--rt-ease-out);
        }
        .rt-page .rt-empty__cta:hover {
            background: var(--rt-forest-2);
            transform: translateY(-2px);
            box-shadow: 0 16px 30px -18px rgba(20, 39, 31, .5);
        }
        .rt-page .rt-empty__cta--ghost {
            background: transparent;
            color: var(--rt-forest);
            border: 1px solid rgba(20, 39, 31, .22);
        }
        .rt-page .rt-empty__cta--ghost:hover {
            background: var(--rt-white);
            border-color: var(--rt-forest);
        }
        .rt-page .rt-empty__cta svg {
            transition: transform var(--rt-dur) var(--rt-ease-out);
        }
        .rt-page .rt-empty__cta:hover svg { transform: translateX(3px); }

        /* ============================================================
           CLOSING CTA — fixed layout
           ============================================================ */
        .rt-page .rt-cta-section {
            position: relative;
            overflow: hidden;
            /* This needs no padding itself — the inner container has it */
            background: var(--rt-forest);
            color: var(--rt-ivory);
            border-top: 1px solid rgba(232, 223, 201, .16);
            isolation: isolate;
            border-radius: 48px 48px 0 0; /* The top curve from your screenshot */
            margin-top: 40px;
        }
        .rt-page .rt-cta-section::before {
            content: "";
            position: absolute;
            top: -20%;
            right: -10%;
            width: 55%;
            height: 140%;
            background: radial-gradient(circle at center, rgba(143, 168, 136, .14), transparent 65%);
            pointer-events: none;
            z-index: 0;
        }
        
        .rt-page .rt-cta__inner {
            position: relative;
            z-index: 2;
            display: grid;
            grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
            gap: clamp(28px, 5vw, 72px);
            align-items: start;
            /* Give it heavy vertical padding inside the container */
            padding-top: clamp(68px, 9vw, 112px);
            padding-bottom: clamp(68px, 9vw, 112px);
        }
        
        .rt-page .rt-cta__heading h2 {
            margin: 12px 0 0;
            font-family: var(--rt-serif);
            font-weight: 500;
            font-size: clamp(2rem, 4vw, 3.4rem);
            line-height: 1.08;
            letter-spacing: -.02em;
            color: var(--rt-ivory);
        }
        .rt-page .rt-cta__aside {
            padding-top: clamp(0px, 1.2vw, 12px);
        }
        .rt-page .rt-cta__lede {
            margin: 0 0 22px;
            font-family: var(--rt-sans);
            font-size: .96rem;
            line-height: 1.72;
            color: rgba(248, 246, 240, .8);
        }
        .rt-page .rt-btn-outline {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            padding: 14px 26px;
            border-radius: 999px;
            border: 1px solid rgba(232, 223, 201, .4);
            background: transparent;
            color: var(--rt-ivory);
            font-family: var(--rt-sans);
            font-size: .7rem;
            font-weight: 600;
            letter-spacing: .18em;
            text-transform: uppercase;
            text-decoration: none;
            transition:
                background var(--rt-dur) var(--rt-ease),
                border-color var(--rt-dur) var(--rt-ease),
                color var(--rt-dur) var(--rt-ease),
                transform var(--rt-dur) var(--rt-ease-out),
                box-shadow var(--rt-dur) var(--rt-ease-out);
        }
        .rt-page .rt-btn-outline:hover {
            background: var(--rt-sand);
            border-color: var(--rt-sand);
            color: var(--rt-forest);
            transform: translateY(-2px);
            box-shadow: 0 18px 32px -18px rgba(0, 0, 0, .45);
        }
        .rt-page .rt-btn-outline svg {
            transition: transform var(--rt-dur) var(--rt-ease-out);
        }
        .rt-page .rt-btn-outline:hover svg { transform: translateX(4px); }

        /* ============================================================
           RESPONSIVE
           ============================================================ */
        @@media (min-width: 768px) {
            .rt-page .rt-grid {
                grid-template-columns: repeat(2, minmax(0, 1fr));
            }
        }

        @@media (max-width: 1024px) {
            /* Fix overlapping text in CTA on tablets */
            .rt-page .rt-cta__inner {
                grid-template-columns: 1fr;
                gap: 32px;
            }
            .rt-page .rt-cta__aside {
                padding-top: 0;
                border-top: 1px solid rgba(232, 223, 201, .2);
                padding-top: 32px;
            }
        }

        @@media (max-width: 900px) {
            .rt-page .rt-hero__grid {
                grid-template-columns: 1fr;
                gap: 40px;
            }
            .rt-page .rt-hero__text {
                max-width: none;
                padding-top: 0;
            }
            .rt-page .rt-hero__frame {
                aspect-ratio: 4 / 3;
                max-height: 520px;
            }
        }

        @@media (max-width: 640px) {
            .rt-page .rt-hero {
                padding-top: 40px;
                padding-bottom: 48px;
            }
            .rt-page .rt-hero__frame {
                aspect-ratio: 16 / 11;
                max-height: 380px;
                border-radius: 18px;
            }
            .rt-page .rt-gallery { padding-bottom: 64px; }
            .rt-page .rt-grid { gap: 16px; }
            .rt-page .rt-card__link { padding: 28px 22px 22px; }
            .rt-page .rt-card__accent { left: 22px; }
            .rt-page .rt-card__plate {
                top: 14px;
                right: 14px;
                font-size: .52rem;
                padding: 5px 10px;
            }
            .rt-page .rt-journey {
                padding-bottom: 18px;
                margin-bottom: 18px;
                gap: 10px;
            }
            .rt-page .rt-city-name {
                font-size: 13px;
                max-width: 12ch;
            }
            .rt-page .rt-name {
                font-size: 1.35rem;
                margin-bottom: 10px;
            }
            .rt-page .rt-desc {
                font-size: .87rem;
                -webkit-line-clamp: 4;
                line-clamp: 4;
                margin-bottom: 18px;
            }
            .rt-page .rt-foot {
                padding-top: 16px;
                gap: 12px;
            }
            .rt-page .rt-price-amount { font-size: 1.3rem; }
            .rt-page .rt-cta {
                font-size: .66rem;
                padding: 8px 12px;
            }
            .rt-page .rt-empty {
                padding: 48px 24px 42px;
                border-radius: 16px;
            }
            .rt-page .rt-empty__actions { flex-direction: column; }
            .rt-page .rt-empty__cta { width: 100%; justify-content: center; }
            .rt-page .rt-btn-outline { width: 100%; justify-content: center; }
            
            .rt-page .rt-cta-section {
                border-radius: 32px 32px 0 0;
            }
        }

        /* ============================================================
           REDUCED MOTION
           ============================================================ */
        @@media (prefers-reduced-motion: reduce) {
            .rt-page .kd-reveal {
                opacity: 1 !important;
                transform: none !important;
                transition: none !important;
            }
            .rt-page .rt-card,
            .rt-page .rt-card__accent,
            .rt-page .rt-city-name,
            .rt-page .rt-cta,
            .rt-page .rt-cta-arrow,
            .rt-page .rt-empty__cta,
            .rt-page .rt-empty__cta svg,
            .rt-page .rt-btn-outline,
            .rt-page .rt-btn-outline svg,
            .rt-page .rt-hero__frame img {
                transition: none !important;
            }
            .rt-page .rt-card:hover { transform: none !important; }
            .rt-page .rt-card:hover .rt-path-line { animation: none !important; }
            .rt-page .rt-hero:hover .rt-hero__frame img { transform: none !important; }
        }
    </style>
}

<div class="kd-page rt-page">

    <noscript>
        <style>
            .rt-page .kd-reveal { opacity: 1 !important; transform: none !important; }
            .rt-page .rt-hero__frame img { transform: none !important; }
        </style>
    </noscript>

    <!-- ==================== HERO ==================== -->
    <header class="rt-hero">
        <div class="container rt-hero__grid">

            <div class="rt-hero__text kd-reveal">
                <p class="rt-eyebrow">Discover More / Travel Information</p>
                <h1>Every journey has a <em>way</em>.</h1>
                <p class="rt-hero__lede">
                    Explore transport options for travelling across Pakistan.
                    Compare available routes, understand starting prices and
                    discover the vehicles available for your journey.
                </p>
            </div>

            <div class="rt-hero__media kd-reveal" style="--kd-delay:140ms">
                <figure class="rt-hero__frame media"
                        data-fallback-label="Mountain road journey">
                    <img src="https://images.unsplash.com/photo-1469854523086-cc02fe5d8800?auto=format&fit=crop&w=1400&q=80"
                         alt="A winding road through a mountain landscape"
                         loading="eager" fetchpriority="high" />
                </figure>
                <span class="rt-hero__caption">Mountain Roads</span>
            </div>

        </div>
    </header>

    <!-- ==================== INTRODUCTION ==================== -->
    <section class="rt-intro" aria-labelledby="rt-intro-heading">
        <div class="container">
            <div class="rt-intro__inner kd-reveal">

                <div>
                    <p class="rt-eyebrow">The Collection</p>
                    <h2 id="rt-intro-heading">Choose how you travel.</h2>
                </div>

                <div class="rt-intro__meta">
                    <p class="rt-intro__desc">
                        Discover available transport routes and find a journey
                        that suits your travel requirements.
                    </p>

                    @if (hasRoutes)
                    {
                        <p class="rt-intro__count">
                            <strong>@totalRoutes</strong>
                            @(totalRoutes == 1 ? "route" : "routes")
                        </p>
                    }
                </div>

            </div>
        </div>
    </section>

    <!-- ==================== ROUTE TICKET CARDS ==================== -->
    <section class="rt-gallery" aria-label="Transport routes">
        <div class="container">

            @if (hasRoutes)
            {
                <div class="rt-grid">
                    @for (var i = 0; i < routes.Count; i++)
                    {
                        var route = routes[i];
                        var delay = Math.Min(i * 60, 480);
                        var hasDescription = !string.IsNullOrWhiteSpace(route.Description);

                        <article class="rt-card kd-reveal" style="--kd-delay:@(delay)ms;">
                            <span class="rt-card__accent" aria-hidden="true"></span>

                            <a class="rt-card__link"
                               href="@Url.Action("Details", "Transport", new { id = route.Id })"
                               aria-label="Explore transport route: @route.Name — from @route.StartingCity to @route.DestinationCity">

                                <span class="rt-card__plate" aria-hidden="true">
                                    @route.StartingCity <span>→</span> @route.DestinationCity
                                </span>

                                <header class="rt-journey">
                                    <div class="rt-city">
                                        <span class="rt-city-role">From</span>
                                        <strong class="rt-city-name" title="@route.StartingCity">@route.StartingCity</strong>
                                    </div>

                                    <div class="rt-path" aria-hidden="true">
                                        <svg class="rt-path-svg" viewBox="0 0 100 24"
                                             preserveAspectRatio="none" fill="none">
                                            <path class="rt-path-line"
                                                  d="M 4 15 Q 50 5 96 15"
                                                  stroke="currentColor"
                                                  stroke-width="1"
                                                  stroke-linecap="round"
                                                  stroke-dasharray="3 3" />
                                            <circle cx="4" cy="15" r="2.4" fill="currentColor" />
                                            <circle cx="96" cy="15" r="2.4" fill="currentColor" />
                                        </svg>
                                    </div>

                                    <div class="rt-city rt-city-to">
                                        <span class="rt-city-role">To</span>
                                        <strong class="rt-city-name" title="@route.DestinationCity">@route.DestinationCity</strong>
                                    </div>
                                </header>

                                <div class="rt-body">
                                    <h3 class="rt-name">@route.Name</h3>
                                    @if (hasDescription)
                                    {
                                        <p class="rt-desc">@route.Description</p>
                                    }
                                </div>

                                <footer class="rt-foot">
                                    <div class="rt-price">
                                        <span class="rt-price-label">From</span>
                                        <span class="rt-price-value">
                                            <small class="rt-price-currency">PKR</small>
                                            <span class="rt-price-amount">@route.StartingPricePKR.ToString("N0")</span>
                                        </span>
                                    </div>

                                    <span class="rt-cta">
                                        Explore
                                        <svg class="rt-cta-arrow" width="14" height="14" viewBox="0 0 24 24"
                                             fill="none" stroke="currentColor" stroke-width="2"
                                             stroke-linecap="round" stroke-linejoin="round"
                                             aria-hidden="true">
                                            <path d="M5 12h14" />
                                            <path d="m13 6 6 6-6 6" />
                                        </svg>
                                    </span>
                                </footer>
                            </a>
                        </article>
                    }
                </div>
            }
            else
            {
                <div class="rt-empty kd-reveal">
                    <span class="rt-empty__icon" aria-hidden="true">
                        <svg width="30" height="30" viewBox="0 0 24 24" fill="none"
                             stroke="currentColor" stroke-width="1.5"
                             stroke-linecap="round" stroke-linejoin="round">
                            <path d="M3 6l6-3 6 3 6-3v15l-6 3-6-3-6 3z" />
                            <path d="M9 3v15" />
                            <path d="M15 6v15" />
                        </svg>
                    </span>
                    <h2 class="rt-empty__title">No journeys listed just yet.</h2>
                    <p class="rt-empty__desc">
                        Our team can help you explore transport options for your travel plans.
                    </p>
                    <div class="rt-empty__actions">
                        <a class="rt-empty__cta" href="@Url.Action("Index", "Contact")">
                            Talk to our team
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none"
                                 stroke="currentColor" stroke-width="2"
                                 stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <path d="M5 12h14" />
                                <path d="m13 6 6 6-6 6" />
                            </svg>
                        </a>
                        <a class="rt-empty__cta rt-empty__cta--ghost" href="@Url.Action("Index", "Search")">
                            Browse experiences
                        </a>
                    </div>
                </div>
            }

        </div>
    </section>

    <!-- ==================== CLOSING CTA ==================== -->
    <section class="rt-cta-section" aria-labelledby="rt-cta-heading">
        <div class="container rt-cta__inner">

            <div class="rt-cta__heading kd-reveal">
                <p class="rt-eyebrow rt-eyebrow--light">Plan With Us</p>
                <h2 id="rt-cta-heading">Not sure which route to choose?</h2>
            </div>

            <div class="rt-cta__aside kd-reveal" style="--kd-delay:140ms">
                <p class="rt-cta__lede">
                    Tell us where you want to go, when you plan to travel and how many
                    people are travelling. Our team can help you explore suitable
                    transport options.
                </p>
                <a class="rt-btn-outline" href="@Url.Action("Index", "Contact")">
                    Get in touch
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none"
                         stroke="currentColor" stroke-width="1.6"
                         stroke-linecap="round" stroke-linejoin="round"
                         aria-hidden="true" focusable="false">
                        <path d="M5 12h14M13 6l6 6-6 6" />
                    </svg>
                </a>
            </div>

        </div>
    </section>

</div>

@section Scripts {
    <script>
        (function () {
            var items = document.querySelectorAll('.rt-page .kd-reveal');
            if (!items.length) { return; }

            var prefersReduced = window.matchMedia
                && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

            function showAll() {
                for (var i = 0; i < items.length; i++) {
                    items[i].classList.add('is-in');
                }
            }

            if (prefersReduced || !('IntersectionObserver' in window)) {
                showAll();
                return;
            }

            var observer = new IntersectionObserver(function (entries) {
                for (var i = 0; i < entries.length; i++) {
                    if (entries[i].isIntersecting) {
                        entries[i].target.classList.add('is-in');
                        observer.unobserve(entries[i].target);
                    }
                }
            }, {
                root: null,
                rootMargin: '0px 0px -8% 0px',
                threshold: 0.12
            });

            for (var j = 0; j < items.length; j++) {
                observer.observe(items[j]);
            }
        })();
    </script>
}