@model IEnumerable<KarnelTravel.Models.TransportService>

@{
    ViewData["Title"] = "Transport Services | Karnel Travel Guide";
    ViewData["Description"] = "Explore transport services and vehicle options for travelling across Pakistan.";
}

@section Styles {
    <style>
        .page-hero {
            padding: calc(var(--header-h) + 60px) 0 60px;
            background: var(--forest-deep);
            color: var(--ivory);
        }

            .page-hero h1 {
                color: var(--ivory);
                max-width: 14ch;
            }

            .page-hero p {
                color: rgba(248, 246, 240, .82);
                font-size: 1.05rem;
                max-width: 62ch;
            }

            .page-hero .eyebrow {
                color: var(--sage);
            }

        .transport-card {
            display: grid;
            grid-template-columns: 1fr 2fr;
            gap: 0;
            border: 1px solid var(--line);
            border-radius: var(--radius-lg);
            overflow: hidden;
            background: var(--white);
            margin-bottom: 24px;
            transition: box-shadow .4s var(--ease);
        }

            .transport-card:hover {
                box-shadow: var(--shadow-md);
            }

            .transport-card .media {
                aspect-ratio: auto;
                min-height: 220px;
                border-radius: 0;
                overflow: hidden;
            }

                .transport-card .media img {
                    width: 100%;
                    height: 100%;
                    object-fit: cover;
                }

        .transport-card__body {
            padding: 26px 28px;
            display: flex;
            flex-direction: column;
            gap: 12px;
        }

        .transport-card__meta {
            font-size: .68rem;
            letter-spacing: .16em;
            text-transform: uppercase;
            color: var(--muted);
        }

        .transport-card h3 {
            margin: 0;
            font-size: 1.35rem;
        }

        .transport-card p {
            color: var(--muted);
            font-size: .92rem;
            margin: 0;
        }

        .transport-card__info {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
            gap: 12px;
            padding-top: 14px;
            border-top: 1px solid var(--line);
        }

            .transport-card__info div span {
                display: block;
                font-size: .66rem;
                letter-spacing: .14em;
                text-transform: uppercase;
                color: var(--muted);
                margin-bottom: 3px;
            }

            .transport-card__info div strong {
                font-family: var(--serif);
                font-size: 1rem;
                font-weight: 400;
                color: var(--forest-deep);
            }

        .transport-card__actions {
            display: flex;
            align-items: center;
            gap: 16px;
            flex-wrap: wrap;
            margin-top: auto;
            padding-top: 10px;
        }

            .transport-card__actions .btn {
                display: inline-flex;
                align-items: center;
                justify-content: center;
            }

        .empty-state {
            text-align: center;
            padding: 70px 24px;
            border: 1px solid var(--line);
            border-radius: var(--radius-lg);
            background: var(--white);
        }

            .empty-state h2 {
                margin-bottom: 12px;
            }

            .empty-state p {
                color: var(--muted);
                max-width: 52ch;
                margin: 0 auto;
            }

        .cta-band {
            background: var(--sand);
            padding: clamp(56px, 8vw, 100px) 0;
            text-align: center;
        }

            .cta-band p {
                color: var(--muted);
                max-width: 56ch;
                margin: 0 auto 28px;
            }

        @@media (max-width: 780px) {
            .transport-card {
                grid-template-columns: 1fr;
            }

                .transport-card .media {
                    aspect-ratio: 16 / 10;
                    min-height: 0;
                }
        }
    </style>
}

<header class="page-hero">
    <div class="container" data-reveal>
        <p class="eyebrow">Discover More · Travel Information</p>
        <h1>Ways to Wander.</h1>
        <p>
            Discover transport options for your journey across Pakistan.
            Explore available vehicles, routes and starting prices,
            then send us a request to plan your travel.
        </p>
    </div>
</header>

<section class="section section--ivory">
    <div class="container">

        @if (Model != null && Model.Any())
        {
            foreach (var transport in Model)
            {
                var route = !string.IsNullOrWhiteSpace(transport.StartingCity)
                    ? transport.StartingCity
                    : "Location to be confirmed";

                var destination = !string.IsNullOrWhiteSpace(transport.DestinationCity)
                    ? transport.DestinationCity
                    : "Destination to be confirmed";

                <article class="transport-card" data-reveal>

                    <div class="media"
                         data-fallback-label="@transport.Name">

                        @if (!string.IsNullOrWhiteSpace(transport.ImageUrl))
                        {
                            <img src="@transport.ImageUrl"
                                 alt="@transport.Name"
                                 loading="lazy"
                                 onerror="this.style.display='none';" />
                        }
                    </div>

                    <div class="transport-card__body">

                        <span class="transport-card__meta">
                            @(string.IsNullOrWhiteSpace(transport.VehicleType)
                                ? "Transport Service"
                                : transport.VehicleType)
                            · @(transport.IsFeatured ? "Featured Service" : "Travel Service")
                        </span>

                        <h3>@transport.Name</h3>

                        <p>
                            @(string.IsNullOrWhiteSpace(transport.Description)
                                ? "Contact us for more information about this transport service."
                                : transport.Description)
                        </p>

                        <div class="transport-card__info">

                            <div>
                                <span>Departure</span>
                                <strong>@route</strong>
                            </div>

                            <div>
                                <span>Destination</span>
                                <strong>@destination</strong>
                            </div>

                            <div>
                                <span>Passenger Capacity</span>
                                <strong>
                                    @(transport.PassengerCapacity.HasValue
                                        ? transport.PassengerCapacity.Value + " passengers"
                                        : "To be confirmed")
                                </strong>
                            </div>

                            <div>
                                <span>Starting Price</span>
                                <strong>
                                    @(transport.StartingPrice.HasValue
                                        ? "PKR " + transport.StartingPrice.Value.ToString("N0")
                                        : "On request")
                                </strong>
                            </div>

                        </div>

                        <div class="transport-card__actions">
                            <a class="btn"
                               href="@Url.Action("Create", "Bookings", new
                               {
                                   serviceType = "Transport",
                                   serviceId = transport.Id
                               })">
                                Inquire About Transport
                            </a>
                        </div>

                    </div>
                </article>
            }
        }
        else
        {
            <div class="empty-state" data-reveal>
                <h2>Every journey begins somewhere.</h2>
                <p>
                    Our transport listings are being prepared.
                    Please contact our team for help arranging your journey.
                </p>
            </div>
        }

    </div>
</section>

<section class="cta-band">
    <div class="container" data-reveal>
        <h2>Need help choosing a route?</h2>
        <p>
            Tell us where you want to go, when you plan to travel
            and how many people are travelling. Our team can help
            you explore suitable transport options.
        </p>
        <a class="btn" href="@Url.Action("Index", "Contact")">
            Get in Touch
        </a>
    </div>
</section>
