@model IEnumerable<KarnelTravel.Models.TransportRoute>

@{
    Layout = "_Layout";
    ViewData["Title"] = "Transport Routes | Karnel Travel Guide";

    var routes = Model?.ToList() ?? new List<KarnelTravel.Models.TransportRoute>();
}

<div class="kd-page rt-page">

    <!-- =====================================================================
         SECTION 01 — CINEMATIC HERO
         ===================================================================== -->
    <header class="kd-hero rt-hero">
        <div class="container kd-hero__grid rt-hero__grid">

            <div class="kd-hero__text rt-hero__text kd-reveal">
                <p class="kd-eyebrow kd-eyebrow--light">Discover More / Travel Information</p>
                <h1>Every journey has a <em>way</em>.</h1>
                <p class="kd-hero__lede rt-hero__lede">
                    Explore transport options for travelling across Pakistan.
                    Compare available routes, understand starting prices and
                    discover the vehicles available for your journey.
                </p>
            </div>

            <div class="kd-hero__media rt-hero__media kd-reveal" style="--kd-delay:140ms">
                <figure class="kd-hero__frame media rt-hero__frame"
                        data-fallback-label="Mountain road journey">
                    <img src="https://images.unsplash.com/photo-1469854523086-cc02fe5d8800?auto=format&fit=crop&w=1400&q=80"
                         alt="A winding road through a mountain landscape"
                         loading="eager" fetchpriority="high" />
                </figure>
            </div>

        </div>
    </header>

    <!-- =====================================================================
         SECTION 02 — EDITORIAL INTRODUCTION
         ===================================================================== -->
    <section class="kd-intro rt-intro" aria-labelledby="kd-intro-heading">
        <div class="container">
            <div class="kd-intro__inner rt-intro__inner kd-reveal">
                <p class="kd-eyebrow">The Collection</p>
                <h2 id="kd-intro-heading">Choose how you travel.</h2>
                <p class="kd-intro__desc rt-intro__desc">
                    Discover available transport routes and find a journey
                    that suits your travel requirements.
                </p>

                @if (routes.Any())
                {
                    <p class="rt-intro__count">
                        <strong>@routes.Count</strong>
                        @(routes.Count == 1 ? "route" : "routes")
                    </p>
                }
            </div>
        </div>
    </section>

    <!-- =====================================================================
         SECTION 03 — JOURNEY COLLECTION GALLERY
         ===================================================================== -->
    <section class="rt-gallery" aria-label="Transport routes">
        <div class="container">

            @if (routes.Any())
            {
                <div class="rt-grid">
                    @for (var i = 0; i < routes.Count; i++)
                    {
                        var route = routes[i];
                        var delay = Math.Min(i * 60, 480);
                        var hasDescription = !string.IsNullOrWhiteSpace(route.Description);

                        <article class="rt-card kd-reveal" style="--kd-delay:@(delay)ms;">
                            <span class="rt-card__accent" aria-hidden="true"></span>

                            <a class="rt-card__link"
                               href="@Url.Action("Details", "Transport", new { id = route.Id })"
                               aria-label="Explore transport route: @route.Name">

                                <header class="rt-journey">
                                    <div class="rt-city">
                                        <span class="rt-city-role">From</span>
                                        <strong class="rt-city-name" title="@route.StartingCity">@route.StartingCity</strong>
                                    </div>

                                    <div class="rt-path" aria-hidden="true">
                                        <svg class="rt-path-svg" viewBox="0 0 100 24"
                                             preserveAspectRatio="none" fill="none">
                                            <path class="rt-path-line"
                                                  d="M 4 15 Q 50 5 96 15"
                                                  stroke="currentColor"
                                                  stroke-width="1"
                                                  stroke-linecap="round"
                                                  stroke-dasharray="3 3" />
                                            <circle cx="4" cy="15" r="2.4" fill="currentColor" />
                                            <circle cx="96" cy="15" r="2.4" fill="currentColor" />
                                        </svg>
                                    </div>

                                    <div class="rt-city rt-city-to">
                                        <span class="rt-city-role">To</span>
                                        <strong class="rt-city-name" title="@route.DestinationCity">@route.DestinationCity</strong>
                                    </div>
                                </header>

                                <div class="rt-body">
                                    <h3 class="rt-name">@route.Name</h3>
                                    @if (hasDescription)
                                    {
                                        <p class="rt-desc">@route.Description</p>
                                    }
                                </div>

                                <footer class="rt-foot">
                                    <div class="rt-price">
                                        <span class="rt-price-label">From</span>
                                        <span class="rt-price-value">
                                            <small class="rt-price-currency">PKR</small>
                                            <span class="rt-price-amount">@route.StartingPricePKR.ToString("N0")</span>
                                        </span>
                                    </div>

                                    <span class="rt-cta">
                                        Explore Route
                                        <svg class="rt-cta-arrow" width="14" height="14" viewBox="0 0 24 24"
                                             fill="none" stroke="currentColor" stroke-width="2"
                                             stroke-linecap="round" stroke-linejoin="round"
                                             aria-hidden="true">
                                            <path d="M5 12h14" />
                                            <path d="m13 6 6 6-6 6" />
                                        </svg>
                                    </span>
                                </footer>
                            </a>
                        </article>
                    }
                </div>
            }
            else
            {
                <div class="rt-empty kd-reveal">
                    <span class="rt-empty__icon" aria-hidden="true">
                        <svg width="28" height="28" viewBox="0 0 24 24" fill="none"
                             stroke="currentColor" stroke-width="1.5"
                             stroke-linecap="round" stroke-linejoin="round">
                            <path d="M3 6l6-3 6 3 6-3v15l-6 3-6-3-6 3z" />
                            <path d="M9 3v15" />
                            <path d="M15 6v15" />
                        </svg>
                    </span>
                    <h2 class="rt-empty__title">No journeys listed just yet.</h2>
                    <p class="rt-empty__desc">
                        Our team can help you explore transport options for your travel plans.
                    </p>
                    <a class="rt-empty__cta" href="@Url.Action("Index", "Contact")">
                        Talk to Our Team
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none"
                             stroke="currentColor" stroke-width="2"
                             stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M5 12h14" />
                            <path d="m13 6 6 6-6 6" />
                        </svg>
                    </a>
                </div>
            }

        </div>
    </section>

    <!-- =====================================================================
         SECTION 04 — CLOSING CTA
         ===================================================================== -->
    <section class="kd-cta rt-cta" aria-labelledby="kd-cta-heading">
        <div class="container kd-cta__inner rt-cta__inner">

            <div class="kd-cta__heading rt-cta__heading kd-reveal">
                <p class="kd-eyebrow kd-eyebrow--light">Plan With Us</p>
                <h2 id="kd-cta-heading">Not sure which route to choose?</h2>
            </div>

            <div class="kd-cta__aside rt-cta__aside kd-reveal" style="--kd-delay:140ms">
                <p class="kd-cta__lede rt-cta__lede">
                    Tell us where you want to go, when you plan to travel and how many
                    people are travelling. Our team can help you explore suitable
                    transport options.
                </p>
                <a class="kd-btn-outline rt-btn-outline" href="@Url.Action("Index", "Contact")">
                    Get in Touch
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none"
                         stroke="currentColor" stroke-width="1.6"
                         stroke-linecap="round" stroke-linejoin="round"
                         aria-hidden="true" focusable="false">
                        <path d="M5 12h14M13 6l6 6-6 6" />
                    </svg>
                </a>
            </div>

        </div>
    </section>

</div>

<style>
    /* ============================================================
       KARNEL — TRANSPORT ROUTES LISTING
       Page-scoped styles. All rules are prefixed with .rt-page
       so shared _Layout styles remain untouched elsewhere.
       ============================================================ */

    .rt-page {
        --rt-forest: #14271F;
        --rt-forest-2: #1B3428;
        --rt-ivory: #F8F6F0;
        --rt-sand: #E8DFC9;
        --rt-sage: #8FA888;
        --rt-white: #FFFFFF;
        --rt-ink: #1B2922;
        --rt-muted: #6B7A70;
        --rt-line: rgba(20, 39, 31, .10);
        --rt-line-strong: rgba(20, 39, 31, .18);
        --rt-serif: 'DM Serif Display', 'Iowan Old Style', 'Palatino Linotype', Georgia, serif;
        --rt-sans: 'DM Sans', system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        --rt-ease: cubic-bezier(.22, .72, .24, 1);
        --rt-ease-out: cubic-bezier(.16, 1, .3, 1);
        --rt-dur: .24s;
    }

    /* ============================================================
       HERO
       ============================================================ */
    .rt-page .rt-hero {
        position: relative;
        padding-top: clamp(56px, 7.5vw, 104px);
        padding-bottom: clamp(56px, 7.5vw, 104px);
        background: var(--rt-ivory);
        overflow: hidden;
    }

    .rt-page .rt-hero::before {
        content: "";
        position: absolute;
        top: 0;
        left: 50%;
        transform: translateX(-50%);
        width: min(92%, 1320px);
        height: 1px;
        background: linear-gradient(90deg, transparent, var(--rt-sage), transparent);
        opacity: .35;
        pointer-events: none;
    }

    .rt-page .rt-hero__grid {
        display: grid;
        grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
        gap: clamp(36px, 5vw, 76px);
        align-items: center;
    }

    .rt-page .rt-hero__text {
        max-width: 540px;
        min-width: 0;
    }

    .rt-page .rt-hero__text h1 {
        margin: 16px 0 22px;
        font-family: var(--rt-serif);
        font-weight: 400;
        font-size: clamp(40px, 5.4vw, 78px);
        line-height: 1.02;
        letter-spacing: -.024em;
        color: var(--rt-forest);
    }

    .rt-page .rt-hero__text h1 em {
        font-style: italic;
        color: var(--rt-sage);
        font-weight: 400;
    }

    .rt-page .rt-hero__lede {
        margin: 0;
        max-width: 52ch;
        font-family: var(--rt-sans);
        font-size: clamp(15px, 1.35vw, 17px);
        line-height: 1.72;
        color: var(--rt-muted);
    }

    .rt-page .rt-hero__media {
        position: relative;
        min-width: 0;
    }

    .rt-page .rt-hero__frame {
        position: relative;
        margin: 0;
        overflow: hidden;
        border-radius: 22px;
        aspect-ratio: 4 / 5;
        max-height: 640px;
        box-shadow: 0 46px 90px -54px rgba(20, 39, 31, .50);
    }

    .rt-page .rt-hero__frame img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
        transition: transform 1.4s var(--rt-ease-out);
    }

    .rt-page .rt-hero:hover .rt-hero__frame img {
        transform: scale(1.03);
    }

    /* ============================================================
       INTRODUCTION
       ============================================================ */
    .rt-page .rt-intro__inner {
        max-width: 640px;
    }

    .rt-page .rt-intro__inner h2 {
        margin: 12px 0 16px;
        font-family: var(--rt-serif);
        font-weight: 400;
        font-size: clamp(32px, 3.8vw, 52px);
        line-height: 1.06;
        letter-spacing: -.02em;
        color: var(--rt-forest);
    }

    .rt-page .rt-intro__desc {
        margin: 0;
        max-width: 56ch;
        font-family: var(--rt-sans);
        font-size: 15.5px;
        line-height: 1.72;
        color: var(--rt-muted);
    }

    .rt-page .rt-intro__count {
        display: inline-flex;
        align-items: baseline;
        gap: 8px;
        margin: 24px 0 0;
        padding: 8px 16px;
        border-radius: 999px;
        border: 1px solid var(--rt-line);
        background: var(--rt-white);
        font-family: var(--rt-sans);
        font-size: 13px;
        color: var(--rt-muted);
        letter-spacing: .01em;
    }

    .rt-page .rt-intro__count strong {
        font-family: var(--rt-serif);
        font-weight: 400;
        font-size: 22px;
        line-height: 1;
        letter-spacing: -.01em;
        color: var(--rt-forest);
        font-variant-numeric: tabular-nums;
    }

    /* ============================================================
       GALLERY
       ============================================================ */
    .rt-page .rt-gallery {
        padding: 4px 0 clamp(72px, 8vw, 120px);
        background: var(--rt-ivory);
    }

    .rt-page .rt-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: 22px;
    }

    /* ---------- Card ---------- */
    .rt-page .rt-card {
        position: relative;
        display: flex;
        background: var(--rt-white);
        border: 1px solid var(--rt-line);
        border-radius: 16px;
        overflow: hidden;
        transition: border-color var(--rt-dur) var(--rt-ease),
                    box-shadow var(--rt-dur) var(--rt-ease),
                    transform var(--rt-dur) var(--rt-ease);
    }

    .rt-page .rt-card:hover {
        border-color: var(--rt-line-strong);
        box-shadow: 0 28px 56px -32px rgba(20, 39, 31, .28);
        transform: translateY(-2px);
    }

    .rt-page .rt-card__accent {
        position: absolute;
        top: 0;
        left: 28px;
        width: 36px;
        height: 2px;
        background: var(--rt-sage);
        opacity: .65;
        transition: width .34s var(--rt-ease), opacity .34s var(--rt-ease);
        z-index: 1;
    }

    .rt-page .rt-card:hover .rt-card__accent {
        width: 76px;
        opacity: 1;
    }

    .rt-page .rt-card__link {
        display: flex;
        flex-direction: column;
        width: 100%;
        height: 100%;
        padding: 34px 32px 28px;
        color: inherit;
        text-decoration: none;
    }

    .rt-page .rt-card__link:focus-visible {
        outline: 2px solid var(--rt-sage);
        outline-offset: -4px;
        border-radius: 14px;
    }

    /* ---------- Journey ---------- */
    .rt-page .rt-journey {
        display: grid;
        grid-template-columns: minmax(0, auto) 1fr minmax(0, auto);
        align-items: center;
        gap: 14px;
        padding-bottom: 22px;
        margin-bottom: 22px;
        border-bottom: 1px solid var(--rt-line);
    }

    .rt-page .rt-city {
        min-width: 0;
    }

    .rt-page .rt-city-to {
        text-align: right;
    }

    .rt-page .rt-city-role {
        display: block;
        margin-bottom: 5px;
        font-family: var(--rt-sans);
        font-size: 9px;
        font-weight: 700;
        letter-spacing: .20em;
        text-transform: uppercase;
        color: var(--rt-muted);
        line-height: 1.2;
    }

    .rt-page .rt-city-name {
        display: block;
        font-family: var(--rt-sans);
        font-size: 14px;
        font-weight: 600;
        line-height: 1.25;
        color: var(--rt-forest);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        max-width: 16ch;
        transition: color var(--rt-dur) var(--rt-ease);
    }

    .rt-page .rt-card:hover .rt-city-name {
        color: var(--rt-forest-2);
    }

    /* Route path */
    .rt-page .rt-path {
        color: var(--rt-sage);
        min-width: 40px;
        height: 24px;
    }

    .rt-page .rt-path-svg {
        display: block;
        width: 100%;
        height: 100%;
        overflow: visible;
    }

    .rt-page .rt-path-line {
        transition: stroke-dashoffset .5s var(--rt-ease);
    }

    .rt-page .rt-card:hover .rt-path-line {
        animation: rt-flow 2s linear infinite;
    }

    @@keyframes rt-flow {
        from { stroke-dashoffset: 0; }
        to   { stroke-dashoffset: -12; }
    }

    /* ---------- Body ---------- */
    .rt-page .rt-body {
        flex: 1 1 auto;
        min-width: 0;
    }

    .rt-page .rt-name {
        margin: 0 0 12px;
        font-family: var(--rt-serif);
        font-weight: 400;
        font-size: clamp(24px, 2.4vw, 30px);
        line-height: 1.16;
        letter-spacing: -.014em;
        color: var(--rt-forest);
        overflow-wrap: break-word;
    }

    .rt-page .rt-desc {
        margin: 0 0 22px;
        font-family: var(--rt-sans);
        font-size: 14px;
        line-height: 1.65;
        color: var(--rt-muted);
        display: -webkit-box;
        -webkit-line-clamp: 3;
        line-clamp: 3;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    /* ---------- Footer ---------- */
    .rt-page .rt-foot {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 16px;
        margin-top: auto;
        padding-top: 20px;
        border-top: 1px solid var(--rt-line);
    }

    .rt-page .rt-price {
        min-width: 0;
    }

    .rt-page .rt-price-label {
        display: block;
        margin-bottom: 4px;
        font-family: var(--rt-sans);
        font-size: 9px;
        font-weight: 700;
        letter-spacing: .20em;
        text-transform: uppercase;
        color: var(--rt-muted);
        line-height: 1.2;
    }

    .rt-page .rt-price-value {
        display: inline-flex;
        align-items: baseline;
        gap: 6px;
        white-space: nowrap;
    }

    .rt-page .rt-price-currency {
        font-family: var(--rt-sans);
        font-size: 10.5px;
        font-weight: 700;
        letter-spacing: .10em;
        text-transform: uppercase;
        color: var(--rt-muted);
    }

    .rt-page .rt-price-amount {
        font-family: var(--rt-serif);
        font-weight: 400;
        font-size: 26px;
        line-height: 1;
        letter-spacing: -.012em;
        color: var(--rt-forest);
        font-variant-numeric: tabular-nums;
    }

    /* CTA pill */
    .rt-page .rt-cta {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        flex-shrink: 0;
        padding: 9px 14px;
        border-radius: 999px;
        background: rgba(20, 39, 31, .04);
        font-family: var(--rt-sans);
        font-size: 12.5px;
        font-weight: 700;
        letter-spacing: .01em;
        color: var(--rt-forest);
        white-space: nowrap;
        transition: background var(--rt-dur) var(--rt-ease),
                    color var(--rt-dur) var(--rt-ease);
    }

    .rt-page .rt-card:hover .rt-cta {
        background: var(--rt-forest);
        color: var(--rt-ivory);
    }

    .rt-page .rt-cta-arrow {
        transition: transform var(--rt-dur) var(--rt-ease);
    }

    .rt-page .rt-card:hover .rt-cta-arrow {
        transform: translateX(3px);
    }

    /* ---------- Empty state ---------- */
    .rt-page .rt-empty {
        max-width: 560px;
        margin: 0 auto;
        padding: 68px 36px 60px;
        text-align: center;
        background: var(--rt-white);
        border: 1px solid var(--rt-line);
        border-radius: 20px;
    }

    .rt-page .rt-empty__icon {
        display: inline-grid;
        place-items: center;
        width: 68px;
        height: 68px;
        margin-bottom: 22px;
        border-radius: 18px;
        background: rgba(143, 168, 136, .14);
        color: var(--rt-forest);
    }

    .rt-page .rt-empty__title {
        margin: 0 0 12px;
        font-family: var(--rt-serif);
        font-weight: 400;
        font-size: clamp(24px, 2.8vw, 32px);
        line-height: 1.2;
        letter-spacing: -.012em;
        color: var(--rt-forest);
    }

    .rt-page .rt-empty__desc {
        margin: 0 auto 26px;
        max-width: 38ch;
        font-family: var(--rt-sans);
        font-size: 14.5px;
        line-height: 1.65;
        color: var(--rt-muted);
    }

    .rt-page .rt-empty__cta {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 13px 24px;
        border-radius: 999px;
        background: var(--rt-forest);
        color: var(--rt-ivory);
        font-family: var(--rt-sans);
        font-size: 13.5px;
        font-weight: 700;
        letter-spacing: .01em;
        text-decoration: none;
        transition: background var(--rt-dur) var(--rt-ease),
                    transform var(--rt-dur) var(--rt-ease);
    }

    .rt-page .rt-empty__cta:hover {
        background: var(--rt-forest-2);
        color: var(--rt-ivory);
        transform: translateY(-1px);
    }

    .rt-page .rt-empty__cta svg {
        transition: transform var(--rt-dur) var(--rt-ease);
    }

    .rt-page .rt-empty__cta:hover svg {
        transform: translateX(3px);
    }

    /* ============================================================
       CTA — polish the shared dark section typography
       ============================================================ */
    .rt-page .rt-cta__heading h2 {
        margin: 12px 0 0;
        font-family: var(--rt-serif);
        font-weight: 400;
        font-size: clamp(30px, 3.4vw, 46px);
        line-height: 1.08;
        letter-spacing: -.018em;
        color: var(--rt-ivory);
    }

    .rt-page .rt-cta__lede {
        margin: 0 0 22px;
        font-family: var(--rt-sans);
        font-size: 15px;
        line-height: 1.72;
        color: rgba(248, 246, 240, .80);
    }

    .rt-page .rt-btn-outline {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 13px 24px;
        border-radius: 999px;
        border: 1px solid rgba(232, 223, 201, .38);
        background: transparent;
        color: var(--rt-ivory);
        font-family: var(--rt-sans);
        font-size: 13.5px;
        font-weight: 700;
        letter-spacing: .01em;
        text-decoration: none;
        transition: background var(--rt-dur) var(--rt-ease),
                    border-color var(--rt-dur) var(--rt-ease),
                    color var(--rt-dur) var(--rt-ease),
                    transform var(--rt-dur) var(--rt-ease);
    }

    .rt-page .rt-btn-outline:hover {
        background: var(--rt-sand);
        border-color: var(--rt-sand);
        color: var(--rt-forest);
        transform: translateY(-1px);
    }

    /* ============================================================
       RESPONSIVE
       ============================================================ */
    @@media (min-width: 768px) {
        .rt-page .rt-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @@media (max-width: 900px) {
        .rt-page .rt-hero__grid {
            grid-template-columns: 1fr;
            gap: 40px;
        }

        .rt-page .rt-hero__text {
            max-width: none;
        }

        .rt-page .rt-hero__frame {
            aspect-ratio: 4 / 3;
            max-height: 520px;
        }
    }

    @@media (max-width: 640px) {
        .rt-page .rt-hero {
            padding-top: 40px;
            padding-bottom: 48px;
        }

        .rt-page .rt-hero__frame {
            aspect-ratio: 16 / 11;
            max-height: 380px;
            border-radius: 18px;
        }

