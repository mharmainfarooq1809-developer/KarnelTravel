
@model IEnumerable<KarnelTravel.Models.Restaurant>

@{
    ViewData["Title"] = "Taste Trails — Restaurant Information | Karnel Travel Guide";
    ViewData["Description"] = "Discover restaurants across Pakistan, explore regional cuisine and plan your dining experience.";
}

@section Styles {
    <style>
        .page-hero {
            padding: calc(var(--header-h) + 60px) 0 60px;
            background: var(--sand);
        }

        .page-hero h1 { max-width: 14ch; }

        .page-hero p {
            color: var(--muted);
            font-size: 1.05rem;
            max-width: 62ch;
        }

        .listing-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
            gap: 28px;
        }

        .listing-card {
            display: flex;
            flex-direction: column;
            background: var(--white);
            border: 1px solid var(--line);
            border-radius: var(--radius-lg);
            overflow: hidden;
            transition: transform .4s var(--ease), box-shadow .4s var(--ease);
        }

        .listing-card:hover {
            transform: translateY(-4px);
            box-shadow: var(--shadow-md);
        }

        .listing-card .media { aspect-ratio: 4 / 3; }

        .listing-card .media img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform .4s var(--ease);
        }

        .listing-card:hover .media img { transform: scale(1.05); }

        .listing-card__body {
            padding: 22px;
            display: flex;
            flex-direction: column;
            gap: 10px;
            flex: 1;
        }

        .listing-card__meta {
            font-size: .68rem;
            letter-spacing: .16em;
            text-transform: uppercase;
            color: var(--muted);
        }

        .listing-card h3 {
            margin: 0;
            font-size: 1.25rem;
        }

        .listing-card__desc {
            color: var(--muted);
            font-size: .92rem;
            margin: 0;
            flex: 1;
        }

        .listing-card__tags {
            display: flex;
            flex-wrap: wrap;
            gap: 6px;
        }

        .listing-card__tags span {
            font-size: .68rem;
            padding: 3px 10px;
            background: var(--ivory);
            border: 1px solid var(--line);
            border-radius: 999px;
            color: var(--forest);
        }

        .listing-card__footer {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding-top: 14px;
            border-top: 1px solid var(--line);
            margin-top: auto;
            gap: 10px;
        }

        .listing-card__price {
            font-family: var(--serif);
            font-size: 1.1rem;
            color: var(--forest-deep);
        }

        .listing-card__price small {
            display: block;
            font-family: var(--sans);
            font-size: .66rem;
            letter-spacing: .12em;
            text-transform: uppercase;
            color: var(--muted);
            font-weight: 400;
        }

        .cta-band {
            background: var(--forest-deep);
            color: var(--ivory);
            padding: clamp(56px, 8vw, 100px) 0;
            text-align: center;
        }

        .cta-band h2 { color: var(--ivory); }

        .cta-band p {
            color: rgba(248, 246, 240, .78);
            max-width: 56ch;
            margin: 0 auto 28px;
        }

        .empty-state {
            text-align: center;
            padding: 75px 20px;
            background: var(--white);
            border: 1px solid var(--line);
            border-radius: var(--radius-lg);
        }

        .empty-state h2 { margin-bottom: 12px; }

        .empty-state p {
            color: var(--muted);
            max-width: 50ch;
            margin: 0 auto;
        }
    </style>
}

<header class="page-hero">
    <div class="container" data-reveal>
        <p class="eyebrow">Discover More · Restaurant Information</p>
        <h1>Taste Trails.</h1>
        <p>
            Explore restaurants, regional dishes and dining experiences
            across Pakistan, organised by destination.
        </p>
    </div>
</header>

<section class="section section--ivory">
    <div class="container">

        @if (Model != null && Model.Any())
        {
            <div class="listing-grid" data-reveal-group>

                @foreach (var restaurant in Model)
                {
                    var imageUrl = !string.IsNullOrWhiteSpace(restaurant.ImageUrl)
                        ? restaurant.ImageUrl
                        : "https://images.unsplash.com/photo-1517248135467-4c7edcad34c4?auto=format&fit=crop&w=900&q=70";

                    <article class="listing-card" data-reveal>

                        <div class="media" data-fallback-label="@restaurant.Name">
                            <img src="@imageUrl"
                                 alt="@restaurant.Name"
                                 loading="lazy"
                                 onerror="this.onerror=null;this.src='https://images.unsplash.com/photo-1517248135467-4c7edcad34c4?auto=format&fit=crop&w=900&q=70';" />
                        </div>

                        <div class="listing-card__body">

                            <span class="listing-card__meta">
                                @(string.IsNullOrWhiteSpace(restaurant.City)
                                    ? "Pakistan"
                                    : restaurant.City)
                                · Restaurant
                            </span>

                            <h3>@restaurant.Name</h3>

                            <p class="listing-card__desc">
                                @(string.IsNullOrWhiteSpace(restaurant.ShortDescription)
                                    ? "Discover this restaurant and its dining experience."
                                    : restaurant.ShortDescription)
                            </p>

                            <div class="listing-card__tags">
                                @if (!string.IsNullOrWhiteSpace(restaurant.CuisineType))
                                {
                                    <span>@restaurant.CuisineType</span>
                                }

                                @if (restaurant.IsFeatured)
                                {
                                    <span>Featured</span>
                                }
                            </div>

                            <div class="listing-card__footer">

                                <div class="listing-card__price">
                                    @if (restaurant.AverageMealPrice.HasValue &&
                                         restaurant.AverageMealPrice.Value > 0)
                                    {
                                        <small>Average / person</small>
                                        @:PKR @restaurant.AverageMealPrice.Value.ToString("N0")
                                    }
                                    else
                                    {
                                        <small>Pricing</small>
                                        @:Contact for details
                                    }
                                </div>

                                <a class="link-arrow"
                                   href="@Url.Action("Details", "Restaurants", new { id = restaurant.Id })">
                                    View Details
                                </a>

                            </div>
                        </div>
                    </article>
                }

            </div>
        }
        else
        {
            <div class="empty-state">
                <h2>No Restaurants Available Yet.</h2>
                <p>
                    Restaurant information is currently being updated.
                    Please check back soon for new dining destinations.
                </p>
            </div>
        }

    </div>
</section>

<section class="cta-band">
    <div class="container" data-reveal>
        <h2>Looking for Something Specific?</h2>
        <p>
            Tell us your destination and cuisine preference.
            We'll help you explore dining options during your journey.
        </p>
        <a class="btn btn--light" href="@Url.Action("Index", "Contact")">
            Get in Touch
        </a>
    </div>
</section>
