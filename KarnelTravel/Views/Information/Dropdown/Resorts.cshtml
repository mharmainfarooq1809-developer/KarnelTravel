@{
    ViewData["Title"] = "Resorts Information";
    ViewData["Description"] = "Resorts and leisure properties across Pakistan.";
}

<section class="section section--ivory">
    <div class="container">
        <h1>Resort Escapes</h1>
        <p class="muted">Sample resort listings and details. This page uses demo data for illustration.</p>

        <div class="grid" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:20px;margin-top:24px;">
            <article class="card">
                <img src="https://images.unsplash.com/photo-1501117716987-c8e29b9a5d0a?auto=format&fit=crop&w=900&q=70" alt="Resort by the lake" style="width:100%;height:160px;object-fit:cover;border-radius:8px;" />
                <h3 style="margin-top:12px;">Lakeview Resort, Swat</h3>
                <p class="muted">Comfortable rooms, lake activities and family-friendly facilities. Sample price range shown for guidance.</p>
                <a class="link-arrow" href="@Url.Action("Index","Resorts")">View</a>
            </article>

            <article class="card">
                <img src="https://images.unsplash.com/photo-1501785888041-af3ef285b470?auto=format&fit=crop&w=900&q=70" alt="Mountain resort" style="width:100%;height:160px;object-fit:cover;border-radius:8px;" />
                <h3 style="margin-top:12px;">Pine Ridge Retreat, Murree</h3>
                <p class="muted">A peaceful hillside resort with nature trails, sample rates and facilities listed for reference.</p>
                <a class="link-arrow" href="@Url.Action("Index","Resorts")">View</a>
            </article>
        </div>
    </div>
</section>
