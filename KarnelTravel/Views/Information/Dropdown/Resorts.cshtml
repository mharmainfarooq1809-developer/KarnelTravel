@model IEnumerable<KarnelTravel.Models.Resort>

@{
    ViewData["Title"] = "Resorts Information";
    ViewData["Description"] = "Resorts and leisure properties across Pakistan.";

    var hasResorts = Model != null && Model.Any();
    var totalResorts = hasResorts ? Model.Count() : 0;
    var index = 0;
}

@section Styles {
    <style>
        /* ==========================================================================
           KARNEL TRAVEL GUIDE — RESORTS
           Editorial nature-retreat showcase. Scoped with .kd- prefix.
           ========================================================================== */

        .kd-page {
            --kd-forest: var(--forest-deep, #14271F);
            --kd-ivory: var(--ivory, #F8F6F0);
            --kd-sage: var(--sage, #8FA888);
            --kd-sand: var(--sand, #E8DFC9);
            --kd-white: #FFFFFF;
            --kd-muted: var(--muted, #5A6B60);
            --kd-serif: var(--serif, "Playfair Display", Georgia, "Times New Roman", serif);
            --kd-sans: var(--sans, "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif);
            --kd-ease: var(--ease, cubic-bezier(.22, .61, .36, 1));

            background: var(--kd-ivory);
            color: var(--kd-forest);
            font-family: var(--kd-sans);
            -webkit-font-smoothing: antialiased;
        }

        /* -------------------------------------------------- shared atoms ---- */
        .kd-eyebrow {
            display: inline-flex;
            align-items: center;
            gap: 14px;
            margin: 0 0 18px;
            font-size: .7rem;
            font-weight: 600;
            letter-spacing: .32em;
            text-transform: uppercase;
            color: var(--kd-sage);
        }

        .kd-eyebrow::before {
            content: "";
            width: 34px;
            height: 1px;
            background: currentColor;
            opacity: .7;
        }

        .kd-eyebrow--light { color: var(--kd-sand); }

        .kd-reveal {
            opacity: 0;
            transform: translateY(26px);
            transition:
                opacity .9s var(--kd-ease),
                transform .9s var(--kd-ease);
            transition-delay: var(--kd-delay, 0ms);
        }

        .kd-reveal.is-in {
            opacity: 1;
            transform: none;
        }

        /* ------------------------------------------------------ 01 — HERO ---- */
        .kd-hero {
            position: relative;
            padding: calc(var(--header-h, 80px) + 64px) 0 clamp(52px, 7vw, 88px);
            background: var(--kd-ivory);
        }

        .kd-hero__grid {
            display: grid;
            grid-template-columns: minmax(0, 1fr) minmax(0, 1.08fr);
            align-items: center;
            gap: clamp(32px, 6vw, 84px);
        }

        .kd-hero h1 {
            margin: 0 0 24px;
            max-width: 15ch;
            font-family: var(--kd-serif);
            font-weight: 500;
            font-size: clamp(2.4rem, 5vw, 4.2rem);
            line-height: 1.03;
            letter-spacing: -.02em;
            color: var(--kd-forest);
        }

        .kd-hero h1 em {
            font-style: italic;
            color: inherit;
        }

        .kd-hero__lede {
            margin: 0;
            max-width: 46ch;
            font-size: clamp(1rem, 1.1vw, 1.08rem);
            line-height: 1.75;
            color: var(--kd-muted);
        }

        .kd-hero__media {
            position: relative;
        }

        .kd-hero__frame {
            margin: 0;
            height: clamp(320px, 44vw, 520px);
            overflow: hidden;
            border-radius: 3px;
            background: var(--kd-forest);
        }

        .kd-hero__frame img {
            display: block;
            width: 100%;
            height: 100%;
            object-fit: cover;
            transform: scale(1.06);
            transition: transform 1.6s var(--kd-ease);
        }

        .kd-hero__media.is-in .kd-hero__frame img {
            transform: scale(1);
        }

        /* ------------------------------------------------ 02 — INTRODUCTION ---- */
        .kd-intro {
            padding: clamp(48px, 6vw, 80px) 0 clamp(32px, 4vw, 52px);
            background: var(--kd-ivory);
            text-align: center;
        }

        .kd-intro__inner {
            max-width: 720px;
            margin: 0 auto;
        }

        .kd-intro__inner .kd-eyebrow {
            justify-content: center;
            margin-bottom: 20px;
        }

        .kd-intro h2 {
            margin: 0 0 20px;
            font-family: var(--kd-serif);
            font-weight: 500;
            font-size: clamp(2rem, 3.8vw, 3.1rem);
            line-height: 1.1;
            letter-spacing: -.015em;
            color: var(--kd-forest);
        }

        .kd-intro__desc {
            margin: 0 auto;
            max-width: 52ch;
            font-size: clamp(.98rem, 1.1vw, 1.05rem);
            line-height: 1.75;
            color: var(--kd-muted);
        }

        .kd-intro__count {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            margin: 24px auto 0;
            padding: 8px 18px;
            border: 1px solid rgba(20, 39, 31, .14);
            border-radius: 999px;
            font-size: .68rem;
            font-weight: 600;
            letter-spacing: .22em;
            text-transform: uppercase;
            color: var(--kd-sage);
            background: var(--kd-white);
        }

        .kd-intro__count strong {
            font-family: var(--kd-serif);
            font-size: 1rem;
            font-weight: 500;
            letter-spacing: 0;
            color: var(--kd-forest);
        }

        /* -------------------------------------------------- 03 — GALLERY ---- */
        .kd-gallery-section {
            padding: 0 0 clamp(64px, 8vw, 112px);
            background: var(--kd-ivory);
        }

        .kd-gallery {
            display: grid;
            grid-template-columns: repeat(12, minmax(0, 1fr));
            gap: clamp(20px, 2.4vw, 36px);
            align-items: start;
        }

        /* --- base resort card --- */
        .kd-resort {
            display: block;
            position: relative;
            color: inherit;
            text-decoration: none;
            border-radius: 2px;
            transition: transform .45s var(--kd-ease);
        }

        .kd-resort:hover { transform: translateY(-3px); }

        .kd-resort:focus-visible {
            outline: 2px solid var(--kd-sand);
            outline-offset: 3px;
        }

        .kd-resort__media {
            position: relative;
            overflow: hidden;
            background: var(--kd-sand);
            border-radius: 2px;
        }

        .kd-resort__media img {
            display: block;
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 1.15s var(--kd-ease);
        }

        .kd-resort:hover .kd-resort__media img {
            transform: scale(1.05);
        }

        .kd-resort__body {
            padding: 20px 0 0;
        }

        .kd-resort__meta {
            display: flex;
            align-items: center;
            gap: 10px;
            margin-bottom: 10px;
        }

        .kd-resort__meta .kd-rule {
            width: 22px;
            height: 1px;
            background: var(--kd-sage);
            flex: none;
        }

        .kd-resort__location {
            margin: 0;
            font-family: var(--kd-serif);
            font-style: italic;
            font-size: .95rem;
            color: var(--kd-sage);
            letter-spacing: .02em;
        }

        .kd-resort__title {
            margin: 0 0 10px;
            font-family: var(--kd-serif);
            font-weight: 500;
            font-size: clamp(1.3rem, 1.9vw, 1.75rem);
            line-height: 1.2;
            letter-spacing: -.005em;
            color: var(--kd-forest);
        }

        .kd-resort--span7 .kd-resort__title {
            font-size: clamp(1.6rem, 2.4vw, 2.15rem);
        }

        .kd-resort__desc {
            margin: 0 0 16px;
            font-size: .93rem;
            line-height: 1.65;
            color: var(--kd-muted);
            display: -webkit-box;
            -webkit-line-clamp: 3;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }

        .kd-resort__footer {
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            padding-top: 14px;
            margin-top: auto;
            border-top: 1px solid rgba(20, 39, 31, .12);
        }

        .kd-resort__price {
            display: flex;
            flex-direction: column;
            gap: 2px;
            line-height: 1.2;
        }

        .kd-resort__price small {
            font-size: .62rem;
            font-weight: 600;
            letter-spacing: .2em;
            text-transform: uppercase;
            color: var(--kd-muted);
        }

        .kd-resort__price strong {
            font-family: var(--kd-serif);
            font-size: 1.12rem;
            font-weight: 500;
            color: var(--kd-forest);
        }

        .kd-resort__link {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            font-size: .7rem;
            font-weight: 600;
            letter-spacing: .2em;
            text-transform: uppercase;
            color: var(--kd-forest);
            white-space: nowrap;
            transition: color .35s var(--kd-ease);
        }

        .kd-resort:hover .kd-resort__link {
            color: var(--kd-sage);
        }

        .kd-resort__link .kd-rule {
            width: 22px;
            height: 1px;
            background: currentColor;
            opacity: .55;
            transition: width .4s var(--kd-ease), opacity .4s var(--kd-ease);
        }

        .kd-resort:hover .kd-resort__link .kd-rule {
            width: 46px;
            opacity: 1;
        }

        .kd-resort__link svg {
            flex: none;
            transition: transform .4s var(--kd-ease);
        }

        .kd-resort:hover .kd-resort__link svg {
            transform: translateX(5px);
        }

        /* --- 01 — FEATURE SPLIT PANEL --- */
        .kd-resort--feature {
            grid-column: 1 / -1;
            display: grid;
            grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
            min-height: clamp(440px, 48vw, 580px);
            background: var(--kd-sand);
            overflow: hidden;
            border-radius: 3px;
        }

        .kd-resort--feature:hover { transform: none; }

        .kd-resort--feature .kd-resort__media {
            border-radius: 0;
            background: var(--kd-forest);
        }

        .kd-resort--feature .kd-resort__media img {
            transform: scale(1.01);
        }

        .kd-resort--feature:hover .kd-resort__media img {
            transform: scale(1.05);
        }

        .kd-resort--feature .kd-resort__body {
            padding: clamp(32px, 5vw, 64px);
            display: flex;
            flex-direction: column;
            justify-content: center;
            background: var(--kd-sand);
            position: relative;
        }

        .kd-resort__num {
            display: block;
            margin-bottom: 20px;
            font-family: var(--kd-serif);
            font-weight: 500;
            font-size: 1rem;
            letter-spacing: .3em;
            color: var(--kd-sage);
        }

        .kd-resort--feature .kd-resort__meta .kd-rule {
            width: 32px;
            background: var(--kd-forest);
            opacity: .65;
        }

        .kd-resort--feature .kd-resort__location {
            color: var(--kd-forest);
            opacity: .82;
        }

        .kd-resort--feature .kd-resort__title {
            font-size: clamp(1.9rem, 3.4vw, 2.85rem);
            margin-bottom: 16px;
            color: var(--kd-forest);
        }

        .kd-resort--feature .kd-resort__desc {
            color: rgba(20, 39, 31, .78);
            -webkit-line-clamp: 4;
            margin-bottom: 22px;
        }

        .kd-resort--feature .kd-resort__footer {
            border-top-color: rgba(20, 39, 31, .18);
        }

        .kd-resort--feature .kd-resort__price small {
            color: rgba(20, 39, 31, .65);
        }

        /* --- span variants --- */
        .kd-resort--span7 { grid-column: span 7; }
        .kd-resort--span5 { grid-column: span 5; }
        .kd-resort--span4 { grid-column: span 4; }
        .kd-resort--span6 { grid-column: span 6; }

        /* --- differentiated aspect ratios (taller than hotels) --- */
        .kd-resort--span7 .kd-resort__media { aspect-ratio: 5 / 4; }
        .kd-resort--span5 .kd-resort__media { aspect-ratio: 3 / 4; }
        .kd-resort--span4 .kd-resort__media { aspect-ratio: 4 / 5; }

        /* --- horizontal card variant --- */
        .kd-resort--horizontal {
            display: flex;
            flex-direction: row;
            align-items: stretch;
            min-height: 300px;
            background: var(--kd-white);
            border: 1px solid rgba(20, 39, 31, .1);
            overflow: hidden;
        }

        .kd-resort--horizontal .kd-resort__media {
            position: relative;
            width: 50%;
            flex: none;
            aspect-ratio: auto;
            min-height: 100%;
            border-radius: 0;
        }

        .kd-resort--horizontal .kd-resort__media img {
            position: absolute;
            inset: 0;
            width: 100%;
            height: 100%;
        }

        .kd-resort--horizontal .kd-resort__body {
            width: 50%;
            padding: clamp(22px, 2.8vw, 34px);
            display: flex;
            flex-direction: column;
            justify-content: center;
        }

        .kd-resort--horizontal .kd-resort__desc {
            -webkit-line-clamp: 3;
        }

        .kd-resort--horizontal-reverse {
            flex-direction: row-reverse;
        }

        /* --- staggered entrance --- */
        .kd-gallery > .kd-resort:nth-child(1) { --kd-delay: 0ms; }
        .kd-gallery > .kd-resort:nth-child(2) { --kd-delay: 70ms; }
        .kd-gallery > .kd-resort:nth-child(3) { --kd-delay: 130ms; }
        .kd-gallery > .kd-resort:nth-child(4) { --kd-delay: 190ms; }
        .kd-gallery > .kd-resort:nth-child(5) { --kd-delay: 250ms; }
        .kd-gallery > .kd-resort:nth-child(6) { --kd-delay: 310ms; }
        .kd-gallery > .kd-resort:nth-child(7) { --kd-delay: 370ms; }
        .kd-gallery > .kd-resort:nth-child(8) { --kd-delay: 430ms; }
        .kd-gallery > .kd-resort:nth-child(9) { --kd-delay: 490ms; }
        .kd-gallery > .kd-resort:nth-child(10) { --kd-delay: 550ms; }

        /* ---------------------------------------------------- 04 — EMPTY ---- */
        .kd-empty {
            grid-column: 1 / -1;
            text-align: center;
            padding: clamp(52px, 8vw, 100px) 24px;
            background: var(--kd-white);
            border: 1px solid rgba(20, 39, 31, .1);
            border-radius: 3px;
        }

        .kd-empty .kd-eyebrow {
            justify-content: center;
            margin-bottom: 18px;
        }

        .kd-empty h2 {
            margin: 0 0 14px;
            font-family: var(--kd-serif);
            font-weight: 500;
            font-size: clamp(1.9rem, 3.2vw, 2.5rem);
            color: var(--kd-forest);
        }

        .kd-empty p {
            margin: 0 auto;
            max-width: 48ch;
            font-size: .98rem;
            line-height: 1.7;
            color: var(--kd-muted);
        }

        /* ------------------------------------------------------- 05 — CTA ---- */
        .kd-cta {
            position: relative;
            overflow: hidden;
            padding: clamp(72px, 9vw, 128px) 0;
            background: var(--kd-forest);
            color: var(--kd-ivory);
            border-top: 1px solid rgba(232, 223, 201, .16);
            isolation: isolate;
        }

        .kd-cta::before {
            content: "";
            position: absolute;
            top: -20%;
            right: -10%;
            width: 55%;
            height: 140%;
            background: radial-gradient(circle at center, rgba(143, 168, 136, .14), transparent 65%);
            pointer-events: none;
            z-index: 0;
        }

        .kd-cta__inner {
            position: relative;
            z-index: 2;
            display: grid;
            grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
            align-items: center;
            gap: clamp(32px, 6vw, 88px);
        }

        .kd-cta__heading .kd-eyebrow {
            margin-bottom: 20px;
        }

        .kd-cta h2 {
            margin: 0;
            font-family: var(--kd-serif);
            font-weight: 500;
            font-size: clamp(2.1rem, 4.2vw, 3.5rem);
            line-height: 1.08;
            letter-spacing: -.02em;
            color: var(--kd-ivory);
        }

        .kd-cta__aside {
            padding-left: clamp(0px, 2vw, 32px);
            border-left: 1px solid rgba(232, 223, 201, .2);
        }

        .kd-cta__lede {
            margin: 0 0 30px;
            max-width: 42ch;
            font-size: clamp(.98rem, 1.1vw, 1.05rem);
            line-height: 1.75;
            color: rgba(248, 246, 240, .8);
        }

        .kd-btn {
            display: inline-flex;
            align-items: center;
            gap: 14px;
            padding: 18px 32px;
            border: 1px solid rgba(232, 223, 201, .55);
            border-radius: 2px;
            background: transparent;
            color: var(--kd-ivory);
            font-size: .74rem;
            font-weight: 600;
            letter-spacing: .22em;
            text-transform: uppercase;
            text-decoration: none;
            transition:
                background .4s var(--kd-ease),
                border-color .4s var(--kd-ease),
                color .4s var(--kd-ease),
                transform .4s var(--kd-ease);
        }

        .kd-btn svg {
            flex: none;
            transition: transform .4s var(--kd-ease);
        }

        .kd-btn:hover {
            background: var(--kd-ivory);
            border-color: var(--kd-ivory);
            color: var(--kd-forest);
            transform: translateY(-2px);
        }

        .kd-btn:hover svg {
            transform: translateX(5px);
        }

        .kd-btn:focus-visible {
            outline: 2px solid var(--kd-sand);
            outline-offset: 4px;
        }

        /* --------------------------------------------------- RESPONSIVE ---- */
        @@media (max-width: 1024px) {
            .kd-hero {
                padding: calc(var(--header-h, 80px) + 44px) 0 clamp(44px, 6vw, 68px);
            }

            .kd-hero__grid {
                grid-template-columns: minmax(0, 1fr);
                gap: clamp(26px, 5vw, 40px);
            }

            .kd-hero h1 { max-width: 18ch; }
            .kd-hero__frame { height: clamp(280px, 48vw, 420px); }

            .kd-gallery {
                grid-template-columns: repeat(2, minmax(0, 1fr));
            }

            .kd-resort--feature {
                grid-column: 1 / -1;
                grid-template-columns: minmax(0, 1fr);
                min-height: 0;
            }

            .kd-resort--feature .kd-resort__media {
                aspect-ratio: 16 / 10;
                min-height: 340px;
            }

            .kd-resort:not(.kd-resort--feature) {
                grid-column: span 1;
            }

            /* neutralise horizontal layouts on tablet */
            .kd-resort--horizontal,
            .kd-resort--horizontal-reverse {
                display: block;
                min-height: 0;
            }

            .kd-resort--horizontal .kd-resort__media,
            .kd-resort--horizontal-reverse .kd-resort__media {
                width: 100%;
                aspect-ratio: 4 / 3;
                min-height: 0;
            }

            .kd-resort--horizontal .kd-resort__media img,
            .kd-resort--horizontal-reverse .kd-resort__media img {
                position: static;
                width: 100%;
                height: 100%;
            }

            .kd-resort--horizontal .kd-resort__body,
            .kd-resort--horizontal-reverse .kd-resort__body {
                width: 100%;
                padding: 20px 0 0;
                display: block;
            }

            .kd-resort--span7 .kd-resort__media,
            .kd-resort--span5 .kd-resort__media,
            .kd-resort--span4 .kd-resort__media,
            .kd-resort--span6 .kd-resort__media {
                aspect-ratio: 4 / 3;
            }

            .kd-cta__inner {
                grid-template-columns: minmax(0, 1fr);
                gap: clamp(24px, 4vw, 36px);
            }

            .kd-cta__aside {
                padding-left: 0;
                border-left: 0;
                border-top: 1px solid rgba(232, 223, 201, .2);
                padding-top: 28px;
            }
        }

        @@media (max-width: 640px) {
            .kd-hero { padding-top: calc(var(--header-h, 80px) + 32px); }
            .kd-hero h1 { margin-bottom: 18px; }

            .kd-eyebrow {
                letter-spacing: .24em;
                font-size: .66rem;
            }

            .kd-intro {
                padding: clamp(36px, 5vw, 56px) 0 clamp(24px, 3vw, 36px);
                text-align: left;
            }

            .kd-intro__inner { max-width: none; }

            .kd-intro__inner .kd-eyebrow {
                justify-content: flex-start;
            }

            .kd-gallery {
                grid-template-columns: 1fr;
                gap: 24px;
            }

            .kd-resort--feature {
                grid-column: 1 / -1;
            }

            .kd-resort--feature .kd-resort__media {
                min-height: 260px;
                aspect-ratio: 4 / 3;
            }

            .kd-resort--feature .kd-resort__body {
                padding: 24px;
            }

            .kd-resort--feature .kd-resort__title { font-size: 1.75rem; }

            .kd-resort:not(.kd-resort--feature) {
                grid-column: 1 / -1;
            }

            .kd-resort__media,
            .kd-resort--span7 .kd-resort__media,
            .kd-resort--span5 .kd-resort__media,
            .kd-resort--span4 .kd-resort__media,
            .kd-resort--span6 .kd-resort__media,
            .kd-resort--horizontal .kd-resort__media,
            .kd-resort--horizontal-reverse .kd-resort__media {
                aspect-ratio: 4 / 3;
            }

            .kd-resort__footer {
                flex-direction: column;
                align-items: flex-start;
                gap: 14px;
            }

            .kd-btn {
                width: 100%;
                justify-content: center;
                padding: 18px 24px;
            }
        }

        /* --------------------------------------------- REDUCED MOTION ---- */
        @@media (prefers-reduced-motion: reduce) {
            .kd-reveal {
                opacity: 1 !important;
                transform: none !important;
                transition: none !important;
            }

            .kd-hero__frame img,
            .kd-resort__media img,
            .kd-resort__link .kd-rule,
            .kd-resort__link svg,
            .kd-btn,
            .kd-btn svg {
                transition: none !important;
            }

            .kd-hero__frame img,
            .kd-resort__media img,
            .kd-resort:hover .kd-resort__media img,
            .kd-resort--feature:hover .kd-resort__media img {
                transform: none !important;
            }

            .kd-resort:hover {
                transform: none !important;
            }

            .kd-resort:hover .kd-resort__link {
                color: var(--kd-forest) !important;
            }

            .kd-resort:hover .kd-resort__link .kd-rule {
                width: 22px !important;
                opacity: .55 !important;
            }

            .kd-resort:hover .kd-resort__link svg,
            .kd-btn:hover svg {
                transform: none !important;
            }

            .kd-btn:hover { transform: none; }
        }
    </style>
}

<div class="kd-page">

    <noscript>
        <style>
            .kd-reveal { opacity: 1 !important; transform: none !important; }
            .kd-hero__frame img { transform: none !important; }
        </style>
    </noscript>

    <!-- =====================================================================
         SECTION 01 — CINEMATIC RESORT HERO
         ===================================================================== -->
    <header class="kd-hero">
        <div class="container kd-hero__grid">

            <div class="kd-hero__text kd-reveal">
                <p class="kd-eyebrow">Discover More / Resort Collection</p>
                <h1>Escape into somewhere <em>extraordinary</em>.</h1>
                <p class="kd-hero__lede">
                    Discover peaceful retreats and leisure properties across Pakistan,
                    where scenic surroundings and comfortable stays become part of the journey.
                </p>
            </div>

            <div class="kd-hero__media kd-reveal" style="--kd-delay:140ms">
                <figure class="kd-hero__frame media"
                        data-fallback-label="Scenic resort landscape">
                    <img src="https://images.unsplash.com/photo-1571003123894-1f0594d2b5d9?auto=format&fit=crop&w=1200&q=75"
                         alt="A tranquil resort pool overlooking a mountain lake at dusk"
                         loading="eager" fetchpriority="high" />
                </figure>
            </div>

        </div>
    </header>

    <!-- =====================================================================
         SECTION 02 — RESORT COLLECTION INTRODUCTION
         ===================================================================== -->
    <section class="kd-intro" aria-labelledby="kd-intro-heading">
        <div class="container">
            <div class="kd-intro__inner kd-reveal">
                <p class="kd-eyebrow">The Retreats</p>
                <h2 id="kd-intro-heading">Room to slow down.</h2>
                <p class="kd-intro__desc">
                    Explore resort properties across Pakistan and discover places
                    designed for a different kind of stay.
                </p>

                @if (hasResorts)
                {
                    <p class="kd-intro__count">
                        <strong>@totalResorts</strong>
                        @(totalResorts == 1 ? "retreat" : "retreats")
                    </p>
                }
            </div>
        </div>
    </section>

    <!-- =====================================================================
         SECTION 03 — EDITORIAL RESORT GALLERY
         ===================================================================== -->
    <section class="kd-gallery-section" aria-label="Resort listings">
        <div class="container">

            @if (hasResorts)
            {
                <div class="kd-gallery">

                    @foreach (var resort in Model)
                    {
                        var isFirst = index == 0;
                        string layoutClass;

                        if (isFirst)
                        {
                            layoutClass = "kd-resort--feature";
                        }
                        else
                        {
                            var pattern = (index - 1) % 7;
                            switch (pattern)
                            {
                                case 0:
                                    layoutClass = "kd-resort--span7";
                                    break;
                                case 1:
                                    layoutClass = "kd-resort--span5";
                                    break;
                                case 2:
                                    layoutClass = "kd-resort--span4";
                                    break;
                                case 3:
                                    layoutClass = "kd-resort--span4";
                                    break;
                                case 4:
                                    layoutClass = "kd-resort--span4";
                                    break;
                                case 5:
                                    layoutClass = "kd-resort--span6 kd-resort--horizontal";
                                    break;
                                case 6:
                                    layoutClass = "kd-resort--span6 kd-resort--horizontal kd-resort--horizontal-reverse";
                                    break;
                                default:
                                    layoutClass = "kd-resort--span4";
                                    break;
                            }
                        }

                        var hasLocation = !string.IsNullOrWhiteSpace(resort.CityOrRegion);
                        var hasPrice = resort.StartingPricePerNight.HasValue
                                       && resort.StartingPricePerNight.Value > 0;
                        var description = string.IsNullOrWhiteSpace(resort.ShortDescription)
                            ? "Explore this resort and discover its facilities."
                            : resort.ShortDescription;

                        <a class="kd-resort @layoutClass kd-reveal"
                           href="@Url.Action("Details", "Resorts", new { id = resort.Id })"
                           style="--kd-delay:@(index * 80)ms">

                            <div class="kd-resort__media media"
                                 data-fallback-label="@resort.Name">
                                @if (!string.IsNullOrWhiteSpace(resort.ImageUrl))
                                {
                                    <img src="@resort.ImageUrl"
                                         alt="@resort.Name"
                                         loading="lazy" />
                                }
                            </div>

                            <div class="kd-resort__body">

                                @if (isFirst)
                                {
                                    <span class="kd-resort__num">01</span>
                                }

                                @if (hasLocation)
                                {
                                    <div class="kd-resort__meta">
                                        <span class="kd-rule" aria-hidden="true"></span>
                                        <p class="kd-resort__location">@resort.CityOrRegion</p>
                                    </div>
                                }

                                <h2 class="kd-resort__title">@resort.Name</h2>

                                <p class="kd-resort__desc">@description</p>

                                <div class="kd-resort__footer">

                                    <div class="kd-resort__price">
                                        <small>
                                            @(hasPrice ? "Starting from" : "Rate")
                                        </small>
                                        <strong>
                                            @if (hasPrice)
                                            {
                                                @:PKR @resort.StartingPricePerNight.Value.ToString("N0")
                                                <text> / night</text>
                                            }
                                            else
                                            {
                                                @:Price on request
                                            }
                                        </strong>
                                    </div>

                                    <span class="kd-resort__link">
                                        <span class="kd-rule" aria-hidden="true"></span>
                                        View resort
                                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none"
                                             stroke="currentColor" stroke-width="1.6"
                                             stroke-linecap="round" stroke-linejoin="round"
                                             aria-hidden="true" focusable="false">
                                            <path d="M5 12h14M13 6l6 6-6 6" />
                                        </svg>
                                    </span>

                                </div>

                            </div>

                        </a>

                        index++;
                    }

                </div>
            }
            else
            {
                <!-- =============================================================
                     SECTION 04 — ELEGANT EMPTY STATE
                     ============================================================= -->
                <div class="kd-empty kd-reveal">
                    <p class="kd-eyebrow">Coming Soon</p>
                    <h2>Your next escape is taking shape.</h2>
                    <p>
                        Resort listings will appear here as new leisure properties
                        are added to Karnel Travel Guide.
                    </p>
                </div>
            }

        </div>
    </section>

    <!-- =====================================================================
         SECTION 05 — CLOSING CTA
         ===================================================================== -->
    <section class="kd-cta" aria-labelledby="kd-cta-heading">
        <div class="container kd-cta__inner">

            <div class="kd-cta__heading kd-reveal">
                <p class="kd-eyebrow kd-eyebrow--light">Continue Exploring</p>
                <h2 id="kd-cta-heading">Make room for a different kind of journey.</h2>
            </div>

            <div class="kd-cta__aside kd-reveal" style="--kd-delay:140ms">
                <p class="kd-cta__lede">
                    Explore places to stay, discover destinations and start planning
                    your next experience.
                </p>
                <a class="kd-btn" href="@Url.Action("Index", "Search")">
                    Start exploring
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none"
                         stroke="currentColor" stroke-width="1.6"
                         stroke-linecap="round" stroke-linejoin="round"
                         aria-hidden="true" focusable="false">
                        <path d="M5 12h14M13 6l6 6-6 6" />
                    </svg>
                </a>
            </div>

        </div>
    </section>

</div>

@section Scripts {
    <script>
        (function () {
            var items = document.querySelectorAll('.kd-reveal');
            if (!items.length) { return; }

            var prefersReduced = window.matchMedia
                && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

            function showAll() {
                for (var i = 0; i < items.length; i++) {
                    items[i].classList.add('is-in');
                }
            }

            if (prefersReduced || !('IntersectionObserver' in window)) {
                showAll();
                return;
            }

            var observer = new IntersectionObserver(function (entries) {
                for (var i = 0; i < entries.length; i++) {
                    if (entries[i].isIntersecting) {
                        entries[i].target.classList.add('is-in');
                        observer.unobserve(entries[i].target);
                    }
                }
            }, {
                root: null,
                rootMargin: '0px 0px -8% 0px',
                threshold: 0.12
            });

            for (var j = 0; j < items.length; j++) {
                observer.observe(items[j]);
            }
        })();
    </script>
}