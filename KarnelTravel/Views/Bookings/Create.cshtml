
@model KarnelTravel.ViewModels.BookingRequestViewModel

@{
    ViewData["Title"] = "Request a Booking";

    var serviceName = ViewBag.ServiceName as string ?? "Selected service";

    var isTransport = string.Equals(
        Model.ServiceType,
        "Transport",
        StringComparison.OrdinalIgnoreCase
    );

    var isRestaurant = string.Equals(
        Model.ServiceType,
        "Restaurant",
        StringComparison.OrdinalIgnoreCase
    );

    var isTour = string.Equals(
        Model.ServiceType,
        "Tour",
        StringComparison.OrdinalIgnoreCase
    );

    var isScheduledTour =
        isTour && Model.TourBookingType == "Scheduled";

    var transportRoute = ViewBag.TransportRoute as KarnelTravel.Models.TransportRoute;
    var transportVehicles = ViewBag.TransportVehicles as IEnumerable<KarnelTravel.Models.TransportService>
        ?? Enumerable.Empty<KarnelTravel.Models.TransportService>();

    var tourDepartures =
        ViewBag.TourDepartures as IEnumerable<KarnelTravel.Models.TourDeparture>
        ?? Enumerable.Empty<KarnelTravel.Models.TourDeparture>();

}

<style>
    .booking-wrap {
        max-width: 850px;
        margin: 50px auto;
        padding: 0 20px;
        color: #18352c;
    }

    .booking-panel {
        background: #fff;
        border: 1px solid #e2e9e4;
        border-radius: 18px;
        padding: 30px;
        box-shadow: 0 12px 35px rgba(20,50,35,.07);
    }

    .booking-wrap h1 {
        font-size: clamp(28px, 5vw, 42px);
        margin-bottom: 10px;
    }

    .booking-intro {
        color: #66766d;
        line-height: 1.7;
    }

    .booking-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 18px;
        margin-top: 25px;
    }

    .booking-field {
        display: flex;
        flex-direction: column;
        gap: 7px;
        min-width: 0;
    }

    .booking-field.full {
        grid-column: 1 / -1;
    }

    .booking-field label {
        font-weight: 600;
        font-size: 14px;
    }

    .booking-field input,
    .booking-field select,
    .booking-field textarea {
        width: 100%;
        padding: 12px;
        border: 1px solid #d6e0d9;
        border-radius: 9px;
        background: #fff;
        color: #18352c;
        font: inherit;
        box-sizing: border-box;
    }

    .booking-field input:focus,
    .booking-field select:focus,
    .booking-field textarea:focus {
        outline: 2px solid #9bc4aa;
        border-color: #4b8562;
    }

    .booking-submit {
        display: inline-block;
        border: 0;
        border-radius: 9px;
        background: #214c39;
        color: #fff;
        padding: 14px 22px;
        font-weight: 700;
        cursor: pointer;
        margin-top: 24px;
    }

    .booking-submit:hover {
        background: #163828;
    }

    .booking-validation {
        color: #b42318;
        font-size: 13px;
    }

    .booking-notice {
        background: #f1f6f2;
        border-radius: 10px;
        padding: 14px;
        margin-top: 20px;
        font-size: 14px;
        line-height: 1.6;
    }

    .fare-panel {
        grid-column: 1 / -1;
        background: #f5f8f5;
        border: 1px solid #dce8de;
        border-radius: 12px;
        padding: 18px;
        margin-top: 5px;
    }

    .fare-panel h3 {
        margin: 0 0 12px;
        font-size: 17px;
    }

    .fare-row {
        display: flex;
        justify-content: space-between;
        gap: 15px;
        padding: 7px 0;
        color: #52645a;
        font-size: 14px;
    }

    .fare-total {
        border-top: 1px solid #d6e0d9;
        margin-top: 8px;
        padding-top: 12px;
        color: #18352c;
        font-weight: 700;
        font-size: 17px;
    }

    .fare-message {
        color: #66766d;
        font-size: 13px;
        line-height: 1.6;
        margin: 10px 0 0;
    }

    .route-warning {
        color: #b42318;
        font-size: 13px;
    }

    .tour-choice {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 12px;
        grid-column: 1 / -1;
    }

    .tour-choice-option {
        border: 1px solid #d6e0d9;
        border-radius: 12px;
        padding: 16px;
        cursor: pointer;
        background: #fff;
        transition: border-color .2s, background .2s;
    }

    .tour-choice-option:has(input:checked) {
        border-color: #4b8562;
        background: #f1f6f2;
    }

    .tour-choice-option input {
        accent-color: #214c39;
        margin-right: 7px;
    }

    .tour-choice-option strong {
        display: block;
        margin-top: 8px;
        color: #18352c;
    }

    .tour-choice-option small {
        display: block;
        color: #66766d;
        line-height: 1.5;
        margin-top: 5px;
    }

    .tour-info-panel {
        grid-column: 1 / -1;
        background: #f1f6f2;
        border: 1px solid #dce8de;
        border-radius: 12px;
        padding: 16px;
        line-height: 1.6;
        color: #52645a;
        font-size: 14px;
    }

    .tour-info-panel strong {
        color: #18352c;
    }

    .tour-date-summary {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 12px;
        grid-column: 1 / -1;
    }

    .tour-date-card {
        background: #f8faf8;
        border: 1px solid #e2e9e4;
        border-radius: 10px;
        padding: 13px;
    }

    .tour-date-card span {
        display: block;
        font-size: 12px;
        color: #66766d;
        margin-bottom: 5px;
    }

    .tour-date-card strong {
        color: #18352c;
    }

    [hidden] {
        display: none !important;
    }

    @@media(max-width: 600px) {
        .booking-grid {
            grid-template-columns: 1fr;
        }

        .booking-panel {
            padding: 20px;
        }

        .tour-choice,
        .tour-date-summary {
            grid-template-columns: 1fr;
        }
    }
</style>

<main class="booking-wrap">
    <p class="booking-intro">KARNEL TRAVEL GUIDE / BOOKING REQUEST</p>

    @if (isRestaurant)
    {
        <h1>Plan your dining experience.</h1>
    }
    else if (isTour)
    {
        <h1>Choose how you want to travel.</h1>
    }
    else
    {
        <h1>Plan your next journey.</h1>
    }

    <p class="booking-intro">
        Complete the form below. Our team can review your request and confirm
        availability with you.
    </p>

    <section class="booking-panel">
        <h2>@serviceName</h2>

        <p class="booking-intro">
            This submits a booking request, not an instantly confirmed reservation.
        </p>

        <form asp-controller="Bookings" asp-action="Create" method="post">
            @Html.AntiForgeryToken()

            <input asp-for="ServiceType" type="hidden" />
            <input asp-for="ServiceId" type="hidden" />

            <div asp-validation-summary="ModelOnly"
                 class="booking-validation"></div>

            <div class="booking-grid">

                @* CUSTOMER INFORMATION *@

                <div class="booking-field">
                    <label asp-for="CustomerName"></label>
                    <input asp-for="CustomerName" autocomplete="name" />
                    <span asp-validation-for="CustomerName"
                          class="booking-validation"></span>
                </div>

                <div class="booking-field">
                    <label asp-for="Phone"></label>
                    <input asp-for="Phone" autocomplete="tel" />
                    <span asp-validation-for="Phone"
                          class="booking-validation"></span>
                </div>

                <div class="booking-field full">
                    <label asp-for="Email"></label>
                    <input asp-for="Email" autocomplete="email" />
                    <span asp-validation-for="Email"
                          class="booking-validation"></span>
                </div>

                @* TOUR BOOKING OPTIONS *@

                @if (isTour)
                {
                    <div class="tour-choice">

                        <label class="tour-choice-option">
                            <input type="radio"
                                   name="TourBookingType"
                                   value="Scheduled"
                                   checked="@(Model.TourBookingType == "Scheduled")" />

                            <strong>Scheduled departure</strong>

                            <small>
                                Choose from the departure dates already
                                published by Karnel Travel Guide.
                            </small>
                        </label>

                        <label class="tour-choice-option">
                            <input type="radio"
                                   name="TourBookingType"
                                   value="Custom"
                                   checked="@(Model.TourBookingType == "Custom")" />

                            <strong>Custom travel dates</strong>

                            <small>
                                Request your preferred dates and let
                                our team review your travel plan.
                            </small>
                        </label>

                    </div>

                    <span asp-validation-for="TourBookingType"
                          class="booking-validation full"></span>

                    @* SCHEDULED TOUR *@

                    <div class="booking-field full"
                         id="scheduledDepartureField"
                         hidden="@(Model.TourBookingType != "Scheduled")">

                        <label asp-for="TourDepartureId">
                            Select departure
                        </label>

                        <select asp-for="TourDepartureId"
                                id="tourDepartureSelect">

                            <option value="">Choose a departure</option>

                            @foreach (var departure in tourDepartures)
                            {
                                <option value="@departure.Id"
                                        data-start="@departure.DepartureDate.ToString("yyyy-MM-dd")"
                                        data-end="@departure.ReturnDate.ToString("yyyy-MM-dd")"
                                        data-seats="@departure.AvailableSeats">

                                    @departure.DepartureDate.ToString("dd MMM yyyy")
                                    –
                                    @departure.ReturnDate.ToString("dd MMM yyyy")
                                    |
                                    @departure.AvailableSeats seats available
                                </option>
                            }
                        </select>

                        <span asp-validation-for="TourDepartureId"
                              class="booking-validation"></span>
                    </div>

                    <div class="tour-date-summary"
                         id="scheduledDateSummary"
                         hidden="@(Model.TourBookingType != "Scheduled")">

                        <div class="tour-date-card">
                            <span>Departure date</span>
                            <strong id="scheduledStartDate">Select a departure</strong>
                        </div>

                        <div class="tour-date-card">
                            <span>Return date</span>
                            <strong id="scheduledEndDate">Select a departure</strong>
                        </div>

                    </div>

                    <div class="tour-info-panel"
                         id="scheduledTourNotice"
                         hidden="@(Model.TourBookingType != "Scheduled")">

                        <strong>Scheduled tour request</strong>

                        <br />

                        Your request will remain Pending. Seats are reserved
                        only after our team confirms your booking.
                    </div>

                    @* CUSTOM TOUR *@

                    <div class="booking-field"
                         id="customStartDateField"
                         hidden="@(Model.TourBookingType != "Custom")">

                        <label asp-for="BookingDate">
                            Preferred departure date
                        </label>

                        <input asp-for="BookingDate"
                               id="customBookingDate"
                               type="date"
                               min="@DateTime.Today.ToString("yyyy-MM-dd")" />

                        <span asp-validation-for="BookingDate"
                              class="booking-validation"></span>
                    </div>

                    <div class="booking-field"
                         id="customReturnDateField"
                         hidden="@(Model.TourBookingType != "Custom")">

                        <label asp-for="ReturnDate">
                            Preferred return date
                        </label>

                        <input asp-for="ReturnDate"
                               id="customReturnDate"
                               type="date"
                               min="@DateTime.Today.ToString("yyyy-MM-dd")" />

                        <span asp-validation-for="ReturnDate"
                              class="booking-validation"></span>
                    </div>

                    <div class="tour-info-panel"
                         id="customTourNotice"
                         hidden="@(Model.TourBookingType != "Custom")">

                        <strong>Custom-date request</strong>

                        <br />

                        You can request your preferred dates. Our team will
                        review the dates and contact you about availability.
                        This request does not reserve seats on a scheduled departure.
                    </div>
                }

                @* TRANSPORT FIELDS *@

                @if (isTransport)
                {
                    <input type="hidden" asp-for="PickupLocation" value="@transportRoute?.StartingCity" />
                    <input type="hidden" asp-for="DropoffLocation" value="@transportRoute?.DestinationCity" />
                    <div class="booking-field full">
                        <label>Route</label>
                        <strong>@transportRoute?.StartingCity → @transportRoute?.DestinationCity</strong>
                    </div>

                    <div class="booking-field full">
                        <label asp-for="TransportVehicleId">Vehicle</label>
                        <select asp-for="TransportVehicleId" required>
                            <option value="">Select an available vehicle</option>
                            @foreach (var vehicle in transportVehicles)
                            {
                                <option value="@vehicle.Id">@vehicle.Name — @vehicle.VehicleType (@vehicle.PassengerCapacity passengers)</option>
                            }
                        </select>
                        <span asp-validation-for="TransportVehicleId" class="booking-validation"></span>
                    </div>

                    <div class="booking-field full">
                        <label asp-for="TripType">Trip type</label>

                        <select asp-for="TripType" id="tripType">
                            <option value="OneWay">One Way</option>
                            <option value="RoundTrip">Round Trip</option>
                        </select>

                        <span asp-validation-for="TripType"
                              class="booking-validation"></span>
                    </div>

                    <div class="fare-panel">
                        <h3>Estimated journey fare</h3>

                        <div class="fare-row">
                            <span>One-way fare</span>
                            <strong id="oneWayFare">PKR 0</strong>
                        </div>

                        <div class="fare-row" id="returnFareRow" hidden>
                            <span>Return journey</span>
                            <strong id="returnFare">PKR 0</strong>
                        </div>

                        <div class="fare-row fare-total">
                            <span>Estimated total</span>
                            <strong id="totalFare">PKR 0</strong>
                        </div>

                        <p class="fare-message" id="fareMessage">
                            Select your pickup and drop-off cities to view the
                            configured route fare.
                        </p>
                    </div>

                    <div class="booking-field full">
                        <span class="route-warning" id="routeWarning"></span>
                    </div>
                }

                @* NON-TOUR BOOKING DATE *@

                @if (!isTour)
                {
                    <div class="booking-field">
                        <label asp-for="BookingDate">
                            @(isRestaurant ? "Preferred visit date" : "Booking date")
                        </label>

                        <input asp-for="BookingDate"
                               type="date"
                               min="@DateTime.Today.ToString("yyyy-MM-dd")" />

                        <span asp-validation-for="BookingDate"
                              class="booking-validation"></span>
                    </div>
                }

                @* RESTAURANT VISIT PERIOD *@

                @if (isRestaurant)
                {
                    <div class="booking-field">
                        <label asp-for="PreferredVisitTime"></label>

                        <select asp-for="PreferredVisitTime">
                            <option value="">Select preferred time</option>
                            <option value="Breakfast">Breakfast</option>
                            <option value="Lunch">Lunch</option>
                            <option value="Afternoon">Afternoon</option>
                            <option value="Dinner">Dinner</option>
                        </select>

                        <span asp-validation-for="PreferredVisitTime"
                              class="booking-validation"></span>
                    </div>
                }

                @* NON-TOUR RETURN DATE *@

                @if (!isTour)
                {
                    <div class="booking-field"
                         id="returnDateField"
                         hidden="@(isTransport && Model.TripType != "RoundTrip")">

                        <label asp-for="ReturnDate"></label>

                        <input asp-for="ReturnDate"
                               id="returnDate"
                               type="date" />

                        <span asp-validation-for="ReturnDate"
                              class="booking-validation"></span>
                    </div>
                }

                @* PASSENGER / GUEST COUNTS *@

                <div class="booking-field">
                    <label asp-for="Adults">
                        @(isRestaurant ? "Adults / guests" :
                          isTour ? "Adults / travellers" : "Adults / passengers")
                    </label>

                    <input asp-for="Adults"
                           type="number"
                           min="1"
                           max="100" />

                    <span asp-validation-for="Adults"
                          class="booking-validation"></span>
                </div>

                <div class="booking-field">
                    <label asp-for="Children"></label>

                    <input asp-for="Children"
                           type="number"
                           min="0"
                           max="100" />

                    <span asp-validation-for="Children"
                          class="booking-validation"></span>
                </div>

                @if (!isTransport && !isRestaurant && !isTour)
                {
                    <div class="booking-field">
                        <label asp-for="Rooms"></label>

                        <input asp-for="Rooms"
                               type="number"
                               min="0"
                               max="100" />

                        <span asp-validation-for="Rooms"
                              class="booking-validation"></span>
                    </div>
                }

                @* CUSTOMER NOTES *@

                <div class="booking-field full">
                    <label asp-for="CustomerNotes"></label>

                    <textarea asp-for="CustomerNotes"
                              rows="4"
                              placeholder="Tell us about your plans or requirements"></textarea>

                    <span asp-validation-for="CustomerNotes"
                          class="booking-validation"></span>
                </div>

            </div>

            <div class="booking-notice">
                Your request will be marked Pending until the team reviews it.
                Submitting this form does not guarantee availability or a final price.
                The final fare is calculated and validated by our server.
            </div>

            <button class="booking-submit" type="submit">
                Submit booking request
            </button>
        </form>
    </section>
</main>

@if (isTour)
{
    <script>
        document.addEventListener("DOMContentLoaded", function () {

            const bookingTypeInputs =
                document.querySelectorAll('input[name="TourBookingType"]');

            const departureField =
                document.getElementById("scheduledDepartureField");

            const dateSummary =
                document.getElementById("scheduledDateSummary");

            const scheduledNotice =
                document.getElementById("scheduledTourNotice");

            const customStartField =
                document.getElementById("customStartDateField");

            const customReturnField =
                document.getElementById("customReturnDateField");

            const customNotice =
                document.getElementById("customTourNotice");

            const departureSelect =
                document.getElementById("tourDepartureSelect");

            const customStartDate =
                document.getElementById("customBookingDate");

            const customReturnDate =
                document.getElementById("customReturnDate");

            const startDisplay =
                document.getElementById("scheduledStartDate");

            const endDisplay =
                document.getElementById("scheduledEndDate");

            function selectedBookingType() {
                return document.querySelector(
                    'input[name="TourBookingType"]:checked'
                )?.value || "Scheduled";
            }

            function updateDepartureSummary() {
                const option = departureSelect.selectedOptions[0];

                if (!option || !option.value) {
                    startDisplay.textContent = "Select a departure";
                    endDisplay.textContent = "Select a departure";
                    return;
                }

                startDisplay.textContent =
                    new Date(option.dataset.start + "T00:00:00")
                        .toLocaleDateString("en-GB", {
                            day: "2-digit",
                            month: "short",
                            year: "numeric"
                        });

                endDisplay.textContent =
                    new Date(option.dataset.end + "T00:00:00")
                        .toLocaleDateString("en-GB", {
                            day: "2-digit",
                            month: "short",
                            year: "numeric"
                        });
            }

            function updateBookingType() {
                const type = selectedBookingType();
                const isScheduled = type === "Scheduled";

                departureField.hidden = !isScheduled;
                dateSummary.hidden = !isScheduled;
                scheduledNotice.hidden = !isScheduled;

                customStartField.hidden = isScheduled;
                customReturnField.hidden = isScheduled;
                customNotice.hidden = isScheduled;

                departureSelect.required = isScheduled;
                customStartDate.required = !isScheduled;
                customReturnDate.required = false;

                customStartDate.disabled = isScheduled;
                customReturnDate.disabled = isScheduled;
                departureSelect.disabled = !isScheduled;

                updateDepartureSummary();
            }

            bookingTypeInputs.forEach(input => {
                input.addEventListener("change", updateBookingType);
            });

            departureSelect.addEventListener(
                "change",
                updateDepartureSummary
            );

            if (customStartDate) {
                customStartDate.addEventListener("change", function () {
                    customReturnDate.min = customStartDate.value;

                    if (customReturnDate.value &&
                        customReturnDate.value < customStartDate.value) {
                        customReturnDate.value = "";
                    }
                });
            }

            updateBookingType();
        });
    </script>
}

@if (isTransport)
{
    <script>
        document.addEventListener("DOMContentLoaded", function () {

            const tripType = document.getElementById("tripType");

            const returnField = document.getElementById("returnDateField");
            const returnDate = document.getElementById("returnDate");

            const oneWayFareElement = document.getElementById("oneWayFare");
            const returnFareElement = document.getElementById("returnFare");
            const totalFareElement = document.getElementById("totalFare");
            const returnFareRow = document.getElementById("returnFareRow");

            const fareMessage = document.getElementById("fareMessage");
            const routeWarning = document.getElementById("routeWarning");

            const route = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(new {
                fare = transportRoute?.StartingPricePKR ?? 0,
                returnFare = transportRoute?.ReturnPricePKR ?? transportRoute?.StartingPricePKR ?? 0
            }));

            function formatPKR(amount) {
                return "PKR " + Number(amount).toLocaleString("en-PK", {
                    maximumFractionDigits: 2
                });
            }

            function updateReturnDate() {
                const isRoundTrip = tripType.value === "RoundTrip";

                returnField.hidden = !isRoundTrip;
                returnFareRow.hidden = !isRoundTrip;

                returnDate.required = isRoundTrip;

                if (!isRoundTrip) {
                    returnDate.value = "";
                }
            }

            function updateFare() {
                const isRoundTrip = tripType.value === "RoundTrip";

                routeWarning.textContent = "";

                if (!route) {
                    oneWayFareElement.textContent = formatPKR(0);
                    returnFareElement.textContent = formatPKR(0);
                    totalFareElement.textContent = formatPKR(0);

                    fareMessage.textContent =
                        "Select a valid pickup and drop-off route to view its fare.";

                    return;
                }

                const outbound = Number(route.fare);

                const returning = isRoundTrip
                    ? Number(route.returnFare)
                    : 0;

                const total = outbound + returning;

                oneWayFareElement.textContent = formatPKR(outbound);
                returnFareElement.textContent = formatPKR(returning);
                totalFareElement.textContent = formatPKR(total);

                fareMessage.textContent = isRoundTrip
                    ? "The return journey uses the separately configured return fare."
                    : "This is the configured one-way route fare.";
            }

            tripType.addEventListener("change", function () {
                updateReturnDate();
                updateFare();
            });

            updateReturnDate();
            updateFare();
        });
    </script>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
