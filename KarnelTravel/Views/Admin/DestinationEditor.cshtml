@{ Layout = "_AdminLayout"; ViewData["Title"] = "Destination editor"; }
<div class="page-heading"><div><div class="eyebrow">Atlas / Destination editor</div><h1>Tell a better story.</h1><p>Draft a destination page that feels as considered as the journey itself.</p></div><div><a class="btn btn-quiet" href="/Admin/Destinations">← Back to atlas</a> <button class="btn btn-primary" data-toast="Preview opened in prototype mode.">Preview page ↗</button></div></div>
<form data-demo-submit><div class="editor-layout"><div><section class="form-section"><h2>Identity</h2><p>The essentials visitors see first.</p><div class="form-grid"><div class="field"><label for="destination-name">Destination name</label><input id="destination-name" class="input" value="Hunza Valley" required /></div><div class="field"><label for="slug">URL slug</label><input id="slug" class="input" value="hunza-valley" required /></div><div class="field"><label for="region">Region</label><select id="region" class="select"><option>Gilgit-Baltistan</option><option>Punjab</option><option>Sindh</option></select></div><div class="field"><label for="status">Publication</label><select id="status" class="select"><option>Published</option><option>Draft</option></select></div><div class="field full"><label for="summary">Short summary</label><textarea id="summary" class="input">A valley of apricot orchards, turquoise rivers and impossibly high passes.</textarea></div><div class="field full"><label for="description">Long description</label><textarea id="description" class="input">Write the long-form editorial introduction here. Keep the voice warm, useful and grounded in place.</textarea></div></div></section><section class="form-section"><h2>Travel notes</h2><p>Make planning feel simple and personal.</p><div class="form-grid"><div class="field"><label>Best time to visit</label><input class="input" value="April – October" /></div><div class="field"><label>Tourist attractions</label><input class="input" value="Baltit Fort, Passu Cones, Attabad Lake" /></div><div class="field full"><label>Practical information</label><textarea class="input">Road access from Islamabad · 12–14 hours by road · Keep a light layer for high passes.</textarea></div></div></section><section class="form-section"><h2>Search appearance</h2><p>Helpful metadata for the public guide.</p><div class="form-grid"><div class="field full"><label>SEO title</label><input class="input" value="Hunza Valley Travel Guide | Karnel" /></div><div class="field full"><label>Meta description</label><textarea class="input">Explore Hunza Valley with thoughtful itineraries, local stays and practical travel guidance from Karnel.</textarea></div></div></section><div><button class="btn btn-primary" type="submit">Save prototype draft</button> <button class="btn" type="button" data-toast="No real upload or database save is connected.">Upload gallery</button></div></div><aside class="editor-aside"><div class="preview-card"><img src="https://images.unsplash.com/photo-1518005020951-eccb494ad742?auto=format&fit=crop&w=800&q=80" alt="Mountain valley preview" /><div><div class="eyebrow">Main image</div><strong>hunza-cover.jpg</strong><p class="muted">1600 × 1000 · JPG</p><button class="btn btn-quiet" type="button" data-toast="Image picker is visual only.">Change image</button></div></div><div class="panel section-space"><div class="panel-title"><h3>Editorial checklist</h3></div><p>✓ Summary is concise</p><p>✓ Main image selected</p><p class="muted">○ Add at least 3 gallery images</p></div></aside></div></form>
