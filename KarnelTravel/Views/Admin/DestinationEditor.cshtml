@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Destination editor";
}

<div class="page-heading">
    <div>
        <div class="eyebrow">Atlas / Destination editor</div>
        <h1>Tell a better story.</h1>
        <p>Draft a destination page that feels as considered as the journey itself.</p>
    </div>
    <div style="display:flex; gap:8px; flex-wrap:wrap;">
        <a class="btn btn-quiet" asp-controller="Admin" asp-action="Destinations">← Back to atlas</a>
        <button class="btn btn-primary" type="button"
                data-prototype="Preview opened in prototype mode.">
            Preview page ↗
        </button>
    </div>
</div>

<form data-demo-submit novalidate>
    <div class="editor-layout">

        <div>

            <!-- Identity -->
            <section class="form-section">
                <h2>Identity</h2>
                <p>The essentials visitors see first.</p>

                <div class="form-grid">
                    <div class="field">
                        <label for="destination-name">Destination name</label>
                        <input id="destination-name" class="input" value="Hunza Valley" required />
                    </div>
                    <div class="field">
                        <label for="slug">URL slug</label>
                        <input id="slug" class="input" value="hunza-valley" required />
                    </div>
                    <div class="field">
                        <label for="region">Region</label>
                        <select id="region" class="select">
                            <option>Gilgit-Baltistan</option>
                            <option>Punjab</option>
                            <option>Sindh</option>
                        </select>
                    </div>
                    <div class="field">
                        <label for="status">Publication</label>
                        <select id="status" class="select">
                            <option>Published</option>
                            <option>Draft</option>
                        </select>
                    </div>
                    <div class="field full">
                        <label for="summary">Short summary</label>
                        <textarea id="summary" class="input" rows="2">A valley of apricot orchards, turquoise rivers and impossibly high passes.</textarea>
                    </div>
                    <div class="field full">
                        <label for="description">Long description</label>
                        <textarea id="description" class="input" rows="6">Write the long-form editorial introduction here. Keep the voice warm, useful and grounded in place.</textarea>
                    </div>
                </div>
            </section>

            <!-- Travel notes -->
            <section class="form-section">
                <h2>Travel notes</h2>
                <p>Make planning feel simple and personal.</p>

                <div class="form-grid">
                    <div class="field">
                        <label for="best-time">Best time to visit</label>
                        <input id="best-time" class="input" value="April – October" />
                    </div>
                    <div class="field">
                        <label for="attractions">Tourist attractions</label>
                        <input id="attractions" class="input" value="Baltit Fort, Passu Cones, Attabad Lake" />
                    </div>
                    <div class="field full">
                        <label for="practical">Practical information</label>
                        <textarea id="practical" class="input" rows="3">Road access from Islamabad · 12–14 hours by road · Keep a light layer for high passes.</textarea>
                    </div>
                </div>
            </section>

            <!-- Search appearance -->
            <section class="form-section">
                <h2>Search appearance</h2>
                <p>Helpful metadata for the public guide.</p>

                <div class="form-grid">
                    <div class="field full">
                        <label for="seo-title">SEO title</label>
                        <input id="seo-title" class="input" value="Hunza Valley Travel Guide | Karnel" />
                    </div>
                    <div class="field full">
                        <label for="seo-desc">Meta description</label>
                        <textarea id="seo-desc" class="input" rows="3">Explore Hunza Valley with thoughtful itineraries, local stays and practical travel guidance from Karnel.</textarea>
                    </div>
                </div>
            </section>

            <!-- Actions -->
            <div style="display:flex; gap:8px; flex-wrap:wrap; margin-top:8px;">
                <button class="btn btn-primary" type="submit">Save prototype draft</button>
                <button class="btn" type="button"
                        data-prototype="No real upload or database save is connected.">
                    Upload gallery
                </button>
            </div>

        </div>

        <!-- Aside -->
        <aside class="editor-aside">

            <div class="preview-card">
                <img src="https://images.unsplash.com/photo-1518005020951-eccb494ad742?auto=format&fit=crop&w=800&q=80"
                     alt="Mountain valley preview" />
                <div>
                    <div class="eyebrow">Main image</div>
                    <strong>hunza-cover.jpg</strong>
                    <p class="muted" style="margin:4px 0 10px;font-size:12px;">1600 × 1000 · JPG</p>
                    <button class="btn btn-quiet" type="button"
                            data-prototype="Image picker is visual only.">
                        Change image
                    </button>
                </div>
            </div>

            <div class="panel section-space">
                <div class="panel-title">
                    <h3>Editorial checklist</h3>
                </div>
                <p>✓ Summary is concise</p>
                <p>✓ Main image selected</p>
                <p class="muted">○ Add at least 3 gallery images</p>
            </div>

        </aside>

    </div>
</form>