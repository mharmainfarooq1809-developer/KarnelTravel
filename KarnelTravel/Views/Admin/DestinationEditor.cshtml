
@model KarnelTravel.Models.Destination

@{
    Layout = "_AdminLayout";
    bool isEdit = Model.Id > 0;

    ViewData["Title"] = isEdit ? "Edit destination" : "New destination";
    ViewData["Section"] = "Destinations";
}

<div class="page-heading">
    <div>
        <div class="eyebrow">Atlas / Destination editor</div>
        <h1>@(isEdit ? "Refine the story." : "Tell a better story.")</h1>
        <p>Manage destination details saved to the Karnel travel database.</p>
    </div>

    <a class="btn btn-quiet" href="/Admin/Destinations">
        ← Back to atlas
    </a>
</div>

<form method="post"
      enctype="multipart/form-data"
      action="@(isEdit ? $"/Admin/Destinations/Edit/{Model.Id}" : "/Admin/Destinations/Create")">

    @Html.AntiForgeryToken()

    <input type="hidden" asp-for="Id" />

    <div asp-validation-summary="ModelOnly"
         class="text-danger"
         role="alert"></div>

    <div class="editor-layout">
        <div>
            <section class="form-section">
                <h2>Identity</h2>
                <p>The essentials visitors see first.</p>

                <div class="form-grid">
                    <div class="field">
                        <label asp-for="Name">Destination name</label>
                        <input asp-for="Name"
                               class="input"
                               required
                               maxlength="150" />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>

                    <div class="field">
                        <label asp-for="Slug">URL slug</label>
                        <input asp-for="Slug"
                               class="input"
                               required
                               maxlength="180" />
                        <span asp-validation-for="Slug" class="text-danger"></span>
                    </div>

                    <div class="field">
                        <label asp-for="Region">Region</label>
                        <input asp-for="Region"
                               class="input"
                               placeholder="e.g. Gilgit-Baltistan"
                               maxlength="100" />
                        <span asp-validation-for="Region" class="text-danger"></span>
                    </div>

                    <div class="field">
                        <label asp-for="DisplayOrder">Display order</label>
                        <input asp-for="DisplayOrder"
                               class="input"
                               type="number"
                               min="0" />
                        <span asp-validation-for="DisplayOrder" class="text-danger"></span>
                    </div>

                    <div class="field full">
                        <label asp-for="ShortDescription">Short summary</label>
                        <textarea asp-for="ShortDescription"
                                  class="input"
                                  rows="3"
                                  maxlength="500"></textarea>
                        <span asp-validation-for="ShortDescription" class="text-danger"></span>
                    </div>

                    <div class="field full">
                        <label asp-for="Description">Long description</label>
                        <textarea asp-for="Description"
                                  class="input"
                                  rows="7"></textarea>
                        <span asp-validation-for="Description" class="text-danger"></span>
                    </div>
                </div>
            </section>

            <section class="form-section">
                <h2>Travel notes</h2>
                <p>Help visitors plan their trip.</p>

                <div class="form-grid">
                    <div class="field full">
                        <label asp-for="BestTimeToVisit">Best time to visit</label>
                        <input asp-for="BestTimeToVisit"
                               class="input"
                               placeholder="e.g. April to October"
                               maxlength="150" />
                        <span asp-validation-for="BestTimeToVisit" class="text-danger"></span>
                    </div>
                </div>
            </section>

            <section class="form-section">
                <h2>Media</h2>
                <p>Select an image from your computer. It will be uploaded to your website.</p>

                <div class="field full">
                    <label for="imageFile">Main destination image</label>

                    @if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
                    {
                        <div style="margin-bottom:12px;">
                            <img src="@Model.ImageUrl"
                                 alt="Current destination image"
                                 style="width:100%;max-width:420px;max-height:240px;object-fit:cover;border-radius:12px;" />
                            <p class="muted">Current image</p>
                        </div>
                    }

                    <input type="file"
                           id="imageFile"
                           name="imageFile"
                           class="input"
                           accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp" />

                    <span asp-validation-for="ImageUrl" class="text-danger"></span>

                    <p class="muted">JPG, PNG or WebP · Maximum 5 MB</p>

                    <img id="image-preview"
                         alt="Selected image preview"
                         style="display:none;width:100%;max-width:420px;max-height:240px;object-fit:cover;border-radius:12px;margin-top:12px;" />
                </div>
            </section>

            <section class="form-section">
                <h2>Publication</h2>
                <p>Control how this destination is managed.</p>

                <div class="field">
                    <label>
                        <input asp-for="IsPublished" />
                        Published
                    </label>
                </div>

                <div class="field">
                    <label>
                        <input asp-for="IsFeatured" />
                        Featured destination
                    </label>
                </div>
            </section>

            <div style="display:flex;gap:8px;flex-wrap:wrap;margin-top:8px;">
                <button class="btn btn-primary" type="submit">
                    @(isEdit ? "Save changes" : "Create destination")
                </button>

                <a class="btn btn-quiet" href="/Admin/Destinations">
                    Cancel
                </a>
            </div>
        </div>

        <aside class="editor-aside">
            <div class="panel section-space">
                <div class="panel-title">
                    <h3>Before publishing</h3>
                </div>

                <p>✓ Add a clear destination name</p>
                <p>✓ Use a unique URL slug</p>
                <p>✓ Write a useful summary</p>
                <p>✓ Select a suitable image</p>
                <p>✓ Check publication status</p>
            </div>

            @if (isEdit)
            {
                <div class="panel section-space">
                    <div class="panel-title">
                        <h3>Record information</h3>
                    </div>

                    <p>Destination ID: @Model.Id</p>
                    <p>Created: @Model.CreatedAt.ToString("dd MMM yyyy")</p>

                    @if (Model.UpdatedAt.HasValue)
                    {
                        <p>Last updated: @Model.UpdatedAt.Value.ToString("dd MMM yyyy")</p>
                    }
                </div>
            }
        </aside>
    </div>
</form>

<script>
    (() => {
        const input = document.getElementById("imageFile");
        const preview = document.getElementById("image-preview");

        let previousUrl = null;

        input.addEventListener("change", () => {
            const file = input.files && input.files[0];

            if (previousUrl) {
                URL.revokeObjectURL(previousUrl);
                previousUrl = null;
            }

            if (!file) {
                preview.style.display = "none";
                preview.removeAttribute("src");
                return;
            }

            const allowedTypes = [
                "image/jpeg",
                "image/png",
                "image/webp"
            ];

            if (!allowedTypes.includes(file.type)) {
                alert("Choose a JPG, PNG, or WebP image.");
                input.value = "";
                preview.style.display = "none";
                preview.removeAttribute("src");
                return;
            }

            if (file.size > 5 * 1024 * 1024) {
                alert("Image size must not exceed 5 MB.");
                input.value = "";
                preview.style.display = "none";
                preview.removeAttribute("src");
                return;
            }

            previousUrl = URL.createObjectURL(file);
            preview.src = previousUrl;
            preview.style.display = "block";
        });
    })();
</script>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
