@{ Layout = "_AdminLayout"; ViewData["Title"] = "Experience editor"; }
<div class="page-heading"><div><div class="eyebrow">Experiences / Package editor</div><h1>Compose the journey.</h1><p>Move through each layer of a package before it meets the world.</p></div><a class="btn btn-quiet" href="/Admin/Tours">← All packages</a></div>
<form data-demo-submit><div class="steps" data-steps><button type="button" class="step is-active" data-step="basic">01 Basic</button><button type="button" class="step" data-step="itinerary">02 Itinerary</button><button type="button" class="step" data-step="details">03 Inclusions</button><button type="button" class="step" data-step="pricing">04 Pricing</button><button type="button" class="step" data-step="dates">05 Dates</button><button type="button" class="step" data-step="publish">06 Publish</button><div class="step-panel is-active" data-panel="basic"><section class="form-section"><h2>The headline</h2><p>Give this journey a clear point of view.</p><div class="form-grid"><div class="field"><label>Package name</label><input class="input" value="Hunza in Autumn" /></div><div class="field"><label>Destination</label><select class="select"><option>Hunza Valley</option><option>Skardu</option></select></div><div class="field full"><label>Intro</label><textarea class="input">A six-day journey through apricot orchards, ancient forts and the golden light of the Karakoram.</textarea></div></div></section></div><div class="step-panel" data-panel="itinerary"><section class="form-section"><h2>Shape the route</h2><p>Day-by-day details will appear here.</p><div class="field"><label>Itinerary</label><textarea class="input">Day 1 — Islamabad to Chilas\nDay 2 — Chilas to Hunza\nDay 3 — Baltit Fort & Karimabad</textarea></div></section></div><div class="step-panel" data-panel="details"><section class="form-section"><h2>What’s included</h2><p>Set expectations with clarity.</p><div class="form-grid"><div class="field"><label>Inclusions</label><textarea class="input">Accommodation\nDaily breakfast\nLocal guide</textarea></div><div class="field"><label>Exclusions</label><textarea class="input">International flights\nTravel insurance</textarea></div></div></section></div><div class="step-panel" data-panel="pricing"><section class="form-section"><h2>Price & group</h2><div class="form-grid"><div class="field"><label>Price per person</label><input class="input" value="$680" /></div><div class="field"><label>Maximum group size</label><input class="input" value="12" /></div></div></section></div><div class="step-panel" data-panel="dates"><section class="form-section"><h2>Departure dates</h2><div class="field"><label>Upcoming departures</label><input class="input" value="18 Oct 2025 · 22 Oct 2025 · 01 Nov 2025" /></div></section></div><div class="step-panel" data-panel="publish"><section class="form-section"><h2>Ready when you are</h2><p>Review the preview, then choose a publication state.</p><button class="btn btn-primary" type="submit">Save prototype package</button></section></div></div></form>
