@{ Layout = "_AdminLayout"; ViewData["Title"] = "Settings"; }
<div class="page-heading"><div><div class="eyebrow">Workspace preferences</div><h1>Make it yours.</h1><p>Organize the details that help the team move with confidence.</p></div><button class="btn btn-primary" data-demo-submit>Save preferences</button></div><form data-demo-submit><div class="settings-grid"><section class="setting-card"><h2>Business information</h2><div class="field"><label>Business name</label><input class="input" value="Karnel Travel Guide" /></div><div class="field section-space"><label>Tagline</label><input class="input" value="Travel with a point of view." /></div></section><section class="setting-card"><h2>Contact information</h2><div class="field"><label>Email</label><input class="input" value="hello@karnel.travel" /></div><div class="field section-space"><label>Phone</label><input class="input" value="+92 51 000 0000" /></div></section><section class="setting-card"><h2>Currency & formatting</h2><div class="field"><label>Display currency</label><select class="select"><option>USD — US Dollar</option><option>PKR — Pakistani Rupee</option></select></div><div class="switch-row"><span>Show tax-inclusive prices</span><button class="switch is-on" type="button" data-switch aria-label="Toggle tax inclusive prices"></button></div></section><section class="setting-card"><h2>Notifications</h2><div class="switch-row"><span>New inquiry alerts</span><button class="switch is-on" type="button" data-switch aria-label="Toggle inquiry alerts"></button></div><div class="switch-row"><span>Departure reminders</span><button class="switch is-on" type="button" data-switch aria-label="Toggle departure reminders"></button></div><div class="switch-row"><span>Weekly report</span><button class="switch" type="button" data-switch aria-label="Toggle weekly report"></button></div></section><section class="setting-card"><h2>Admin profile</h2><div class="field"><label>Display name</label><input class="input" value="Muhammad Harmain" /></div><div class="field section-space"><label>Role</label><input class="input" value="Editorial operations" /></div></section><section class="setting-card"><h2>UI preferences</h2><div class="switch-row"><span>Compact tables</span><button class="switch" type="button" data-switch aria-label="Toggle compact tables"></button></div><div class="switch-row"><span>Reduce motion</span><button class="switch" type="button" data-switch aria-label="Toggle reduced motion"></button></div></section></div></form>
