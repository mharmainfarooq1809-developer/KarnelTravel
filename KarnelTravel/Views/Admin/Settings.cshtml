@model KarnelTravel.ViewModels.SettingsViewModel
@{ Layout = "_AdminLayout"; ViewData["Title"] = "Settings"; }

<style>
    .settings-page { max-width: 1180px; }
    .settings-intro { display:flex; justify-content:space-between; gap:24px; align-items:flex-end; margin-bottom:24px; }
    .settings-intro h1 { margin:.25rem 0 .45rem; }
    .settings-intro p { margin:0; color:#6f766e; }
    .settings-actions { display:flex; gap:10px; align-items:center; }
    .settings-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:18px; }
    .setting-card { background:#fffdf8; border:1px solid #e4e0d5; border-radius:16px; padding:22px; box-shadow:0 10px 24px rgba(37,54,42,.04); }
    .setting-card.wide { grid-column:1/-1; }
    .setting-card h2 { margin:0 0 5px; font-size:1.05rem; color:#244838; }
    .setting-card > p { margin:0 0 18px; color:#777d74; font-size:.88rem; }
    .field { margin-top:14px; }
    .field label { display:block; font-size:.82rem; font-weight:700; color:#39483e; margin-bottom:6px; }
    .input, .select { width:100%; box-sizing:border-box; border:1px solid #d5d8ce; border-radius:9px; padding:10px 11px; background:#fff; color:#26352c; }
    .form-row { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:14px; }
    .switch-row { display:flex; justify-content:space-between; gap:15px; align-items:center; border-top:1px solid #ece9e0; padding:13px 0 0; margin-top:13px; color:#37453b; }
    .switch-row label { font-weight:600; }
    .switch-row small { display:block; color:#838980; font-weight:400; margin-top:3px; }
    .switch-row input { width:18px; height:18px; accent-color:#2d684d; }
    .notice { padding:12px 14px; border-radius:10px; margin-bottom:18px; background:#edf7ef; color:#285f3f; }
    .warning { background:#fbf4df; color:#775c1f; }
    .audit-list { margin-top:18px; overflow:auto; }
    .audit-list table { width:100%; border-collapse:collapse; font-size:.86rem; }
    .audit-list th,.audit-list td { text-align:left; padding:10px 8px; border-bottom:1px solid #ece9e0; white-space:nowrap; }
    .audit-list th { color:#647066; font-size:.76rem; text-transform:uppercase; letter-spacing:.06em; }
    .validation { color:#a03c32; font-size:.82rem; }
    @@media(max-width:760px) { .settings-intro { display:block; } .settings-actions { margin-top:16px; } .settings-grid,.form-row { grid-template-columns:1fr; } .setting-card.wide { grid-column:auto; } }
</style>

<div class="settings-page">
    <div class="settings-intro"><div><div class="eyebrow">Control center</div><h1>Settings</h1><p>Manage operational preferences without changing historical records or website content.</p></div><div class="settings-actions"><a class="btn btn-secondary" asp-action="WebsiteContent">Edit website content</a><button class="btn btn-primary" type="submit" form="settings-form">Save changes</button></div></div>
    @if (TempData["SettingsSuccess"] is string success) { <div class="notice">@success</div> }
    <div class="notice warning">Email delivery is not configured in this application. Notification preferences are stored for future integration and do not send email.</div>
    <form id="settings-form" asp-action="SaveSettings" method="post">@Html.AntiForgeryToken()<div asp-validation-summary="ModelOnly" class="validation"></div><div class="settings-grid">
        <section class="setting-card"><h2>General settings</h2><p>Defaults used across operational interfaces.</p><div class="form-row"><div class="field"><label asp-for="Settings.ApplicationName"></label><input asp-for="Settings.ApplicationName" class="input" /></div><div class="field"><label asp-for="Settings.OrganizationName"></label><input asp-for="Settings.OrganizationName" class="input" /></div><div class="field"><label asp-for="Settings.DefaultCountry"></label><input asp-for="Settings.DefaultCountry" class="input" /></div><div class="field"><label asp-for="Settings.Currency"></label><select asp-for="Settings.Currency" class="select"><option>PKR</option><option>USD</option><option>EUR</option><option>GBP</option></select></div><div class="field"><label asp-for="Settings.TimeZone"></label><input asp-for="Settings.TimeZone" class="input" /></div><div class="field"><label asp-for="Settings.CountryCallingCode"></label><input asp-for="Settings.CountryCallingCode" class="input" /></div><div class="field"><label asp-for="Settings.ContactEmail"></label><input asp-for="Settings.ContactEmail" class="input" /></div><div class="field"><label asp-for="Settings.ContactPhone"></label><input asp-for="Settings.ContactPhone" class="input" /></div></div></section>
        <section class="setting-card"><h2>Website configuration</h2><p>Control public availability. Branding and SEO content remain in Website Content.</p><div class="switch-row"><label asp-for="Settings.PublicWebsiteVisible">Public website visible</label><input asp-for="Settings.PublicWebsiteVisible" /></div><div class="switch-row"><label asp-for="Settings.MaintenanceMode">Maintenance mode<small>Administrators retain access.</small></label><input asp-for="Settings.MaintenanceMode" /></div><div class="switch-row"><label asp-for="Settings.AllowBookingInquiries">Allow booking inquiries</label><input asp-for="Settings.AllowBookingInquiries" /></div><div class="switch-row"><label asp-for="Settings.AllowContactSubmissions">Allow contact submissions</label><input asp-for="Settings.AllowContactSubmissions" /></div><div class="switch-row"><label asp-for="Settings.AllowFeedbackSubmissions">Allow feedback submissions</label><input asp-for="Settings.AllowFeedbackSubmissions" /></div><div class="switch-row"><label asp-for="Settings.ShowDemoContentNotice">Show demo content notice</label><input asp-for="Settings.ShowDemoContentNotice" /></div></section>
        <section class="setting-card"><h2>Booking settings</h2><p>Applied only to new booking inquiries; existing records are unchanged.</p><div class="form-row"><div class="field"><label asp-for="Settings.DefaultBookingStatus"></label><select asp-for="Settings.DefaultBookingStatus" class="select"><option>Pending</option><option>Confirmed</option></select></div><div class="field"><label asp-for="Settings.BookingReferencePrefix"></label><input asp-for="Settings.BookingReferencePrefix" class="input" /></div><div class="field"><label asp-for="Settings.MinimumAdvanceBookingDays"></label><input asp-for="Settings.MinimumAdvanceBookingDays" class="input" type="number" min="0" /></div><div class="field"><label asp-for="Settings.MaximumAdvanceBookingDays"></label><input asp-for="Settings.MaximumAdvanceBookingDays" class="input" type="number" min="1" /></div><div class="field"><label asp-for="Settings.DefaultAdults"></label><input asp-for="Settings.DefaultAdults" class="input" type="number" min="1" /></div><div class="field"><label asp-for="Settings.MaximumAdults"></label><input asp-for="Settings.MaximumAdults" class="input" type="number" min="1" /></div><div class="field"><label asp-for="Settings.MaximumChildren"></label><input asp-for="Settings.MaximumChildren" class="input" type="number" min="0" /></div><div class="field"><label asp-for="Settings.BookingConfirmationBehavior"></label><select asp-for="Settings.BookingConfirmationBehavior" class="select"><option>Inquiry</option><option>Manual review</option></select></div></div><div class="switch-row"><label asp-for="Settings.BookingEnabled">Enable new bookings</label><input asp-for="Settings.BookingEnabled" /></div><div class="switch-row"><label asp-for="Settings.AllowGuestBookings">Allow guest bookings</label><input asp-for="Settings.AllowGuestBookings" /></div><div class="switch-row"><label asp-for="Settings.RequirePhone">Require phone</label><input asp-for="Settings.RequirePhone" /></div><div class="switch-row"><label asp-for="Settings.RequireEmail">Require email</label><input asp-for="Settings.RequireEmail" /></div></section>
        <section class="setting-card"><h2>Notifications</h2><p>Preferences are persisted; delivery is unavailable until SMTP or another provider is configured.</p><div class="field"><label asp-for="Settings.NotificationEmail"></label><input asp-for="Settings.NotificationEmail" class="input" /></div><div class="field"><label asp-for="Settings.NotificationSubjectPrefix"></label><input asp-for="Settings.NotificationSubjectPrefix" class="input" /></div><div class="switch-row"><label asp-for="Settings.AdminNotificationIndicators">Admin notification indicators</label><input asp-for="Settings.AdminNotificationIndicators" /></div><div class="switch-row"><label asp-for="Settings.NotifyNewBooking">New booking inquiry</label><input asp-for="Settings.NotifyNewBooking" /></div><div class="switch-row"><label asp-for="Settings.NotifyNewContact">New contact inquiry</label><input asp-for="Settings.NotifyNewContact" /></div><div class="switch-row"><label asp-for="Settings.NotifyNewFeedback">New feedback</label><input asp-for="Settings.NotifyNewFeedback" /></div><div class="switch-row"><label asp-for="Settings.NotifyBookingStatusChange">Booking status changes</label><input asp-for="Settings.NotifyBookingStatusChange" /></div></section>
        <section class="setting-card wide"><h2>Appearance</h2><p>These preferences are saved and ready for the admin shell to consume.</p><div class="form-row"><div class="field"><label asp-for="Settings.AdminTheme"></label><select asp-for="Settings.AdminTheme" class="select"><option>System</option><option>Light</option><option>Dark</option></select></div><div class="field"><label asp-for="Settings.SidebarBehavior"></label><select asp-for="Settings.SidebarBehavior" class="select"><option>Expanded</option><option>Compact</option></select></div><div class="field"><label asp-for="Settings.InterfaceDensity"></label><select asp-for="Settings.InterfaceDensity" class="select"><option>Comfortable</option><option>Compact</option></select></div><div class="field"><label asp-for="Settings.DashboardDateRange"></label><select asp-for="Settings.DashboardDateRange" class="select"><option>7 days</option><option>30 days</option><option>90 days</option></select></div><div class="field"><label asp-for="Settings.TablePageSize"></label><input asp-for="Settings.TablePageSize" class="input" type="number" min="10" max="100" /></div><div class="field"><label asp-for="Settings.DashboardLayout"></label><select asp-for="Settings.DashboardLayout" class="select"><option>Editorial</option><option>Analytical</option></select></div></div></section>
    </div></form>
    <section class="setting-card wide" style="margin-top:18px"><h2>Activity &amp; audit log</h2><p>Recent supported administrative changes. Secrets and sensitive form contents are never recorded.</p><div class="audit-list"><table><thead><tr><th>Time</th><th>Administrator</th><th>Action</th><th>Description</th><th>Status</th></tr></thead><tbody>@if (Model.AuditLogs.Count == 0) { <tr><td colspan="5">No audit events have been recorded yet.</td></tr> } @foreach (var log in Model.AuditLogs) { <tr><td>@log.CreatedAt.ToLocalTime().ToString("g")</td><td>@log.Administrator</td><td>@log.Action</td><td>@log.Description</td><td>@(log.Succeeded ? "Success" : "Failed")</td></tr> }</tbody></table></div></section>
</div>
