@model IEnumerable<KarnelTravel.Models.TransportRoute>
@using System.Globalization
@using KarnelTravel.Models
@using KarnelTravel.ViewModels

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Transport Routes";
    ViewData["Section"] = "Transport";

    var vehicles = ViewBag.TransportServices as IEnumerable<TransportService> ?? Enumerable.Empty<TransportService>();
    var edit = ViewBag.EditRoute as AdminTransportRouteViewModel;
    var routes = Model?.ToList() ?? new List<TransportRoute>();

    var culture = CultureInfo.CurrentCulture;

    var totalRoutes = routes.Count;
    var publishedRoutes = routes.Count(r => !r.IsArchived && r.IsPublished && r.IsActive);
    var archivedRoutes = routes.Count(r => r.IsArchived);
    var unpublishedRoutes = totalRoutes - publishedRoutes - archivedRoutes;
    var vehiclesAssigned = routes.Where(r => !r.IsArchived).Sum(r => r.VehicleLinks.Count(x => !x.IsArchived));
}

<div class="tr-page">

    <!-- ================= PAGE HEADER ================= -->
    <header class="page-heading">
        <div>
            <p class="eyebrow">Transport · Routes</p>
            <h1>Transport routes</h1>
            <p>Create reusable routes and assign available vehicles to each route.</p>
        </div>

        <a class="btn btn-primary" href="#route-form">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none"
                 stroke="currentColor" stroke-width="2.2"
                 stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M12 5v14" />
                <path d="M5 12h14" />
            </svg>
            Add route
        </a>
    </header>

    <!-- ================= ROUTE SNAPSHOT ================= -->
    <section class="tr-stats" aria-label="Route summary">
        <article class="tr-stat">
            <label>Total routes</label>
            <strong>@totalRoutes</strong>
            <small>Configured in the system</small>
        </article>

        <article class="tr-stat">
            <label>Published</label>
            <strong>@publishedRoutes</strong>
            <small>Live and bookable</small>
        </article>

        <article class="tr-stat">
            <label>Vehicles assigned</label>
            <strong>@vehiclesAssigned</strong>
            <small>Across active routes</small>
        </article>

        <article class="tr-stat">
            <label>Archived</label>
            <strong>@archivedRoutes</strong>
            <small>Preserved booking history</small>
        </article>
    </section>

    <!-- ================= FEEDBACK ================= -->
    @if (TempData["SuccessMessage"] is string success)
    {
        <div class="tr-alert tr-alert-success" role="status">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none"
                 stroke="currentColor" stroke-width="2.2"
                 stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="m5 12 5 5L20 7" />
            </svg>
            <span>@success</span>
        </div>
    }

    @if (TempData["ErrorMessage"] is string error)
    {
        <div class="tr-alert tr-alert-danger" role="alert">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none"
                 stroke="currentColor" stroke-width="2.2"
                 stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="12" cy="12" r="9" />
                <path d="M12 8v5" />
                <path d="M12 16.5h.01" />
            </svg>
            <span>@error</span>
        </div>
    }

    <!-- ================= ROUTES ROSTER ================= -->
    <section class="panel tr-card" aria-label="Configured routes">
        <div class="panel-title">
            <div>
                <h2>Routes</h2>
                <p class="panel-subtitle">
                    @if (totalRoutes > 0)
                    {
                        <text>@totalRoutes route@(totalRoutes == 1 ? "" : "s") configured · @publishedRoutes published</text>
                    }
                    else
                    {
                        <text>No routes configured yet</text>
                    }
                </p>
            </div>
            <span class="tr-count">@totalRoutes</span>
        </div>

        @if (routes.Count == 0)
        {
            <div class="tr-empty">
                <span class="tr-empty-icon" aria-hidden="true">
                    <svg width="26" height="26" viewBox="0 0 24 24" fill="none"
                         stroke="currentColor" stroke-width="1.6"
                         stroke-linecap="round" stroke-linejoin="round">
                        <path d="M3 6l6-3 6 3 6-3v15l-6 3-6-3-6 3z" />
                        <path d="M9 3v15" />
                        <path d="M15 6v15" />
                    </svg>
                </span>
                <h3>No routes configured</h3>
                <p>Add your first route below, then assign the vehicles that serve it.</p>
                <a href="#route-form" class="btn btn-primary">+ Add route</a>
            </div>
        }
        else
        {
            <!-- FILTER TOOLBAR -->
            <div class="tr-toolbar">
                <div class="tr-filters">
                    <input
                        type="search"
                        id="trSearch"
                        class="tr-filter-input"
                        placeholder="Search by name, slug or city..."
                        aria-label="Search routes" />

                    <select id="trStatusFilter" class="tr-filter-input" aria-label="Filter by status">
                        <option value="all">All routes</option>
                        <option value="published">Published</option>
                        <option value="unpublished">Unpublished</option>
                        <option value="archived">Archived</option>
                    </select>
                </div>

                <div class="tr-result-count">
                    Showing <strong id="trVisibleCount">@totalRoutes</strong>
                    of @totalRoutes routes
                </div>
            </div>

            <div class="tr-table-wrap">
                <table class="tr-table">
                    <thead>
                        <tr>
                            <th scope="col">Route</th>
                            <th scope="col">Price</th>
                            <th scope="col">Vehicles</th>
                            <th scope="col">Status</th>
                            <th scope="col" class="tr-col-actions">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var route in routes)
                        {
                            var initial = !string.IsNullOrWhiteSpace(route.Name)
                                ? char.ToUpperInvariant(route.Name.Trim()[0]).ToString()
                                : "?";

                            var routeSearchText = $"{route.Name} {route.Slug} {route.StartingCity} {route.DestinationCity}".ToLowerInvariant();

                            var routeStatus = route.IsArchived
                                ? "archived"
                                : (route.IsPublished && route.IsActive ? "published" : "unpublished");

                            var vehicleCount = route.VehicleLinks.Count(x => !x.IsArchived);

                            <tr class="tr-row"
                                data-search="@routeSearchText"
                                data-status="@routeStatus">

                                <td data-label="Route">
                                    <div class="tr-cell">
                                        <span class="tr-mono" aria-hidden="true">@initial</span>
                                        <div class="tr-cell-text">
                                            <strong>@route.Name</strong>
                                            <span class="tr-route">
                                                <span>@route.StartingCity</span>
                                                <svg width="12" height="12" viewBox="0 0 24 24" fill="none"
                                                     stroke="currentColor" stroke-width="2"
                                                     stroke-linecap="round" stroke-linejoin="round"
                                                     aria-hidden="true">
                                                    <path d="M5 12h14" />
                                                    <path d="m13 6 6 6-6 6" />
                                                </svg>
                                                <span>@route.DestinationCity</span>
                                            </span>
                                        </div>
                                    </div>
                                </td>

                                <td data-label="Price">
                                    <span class="tr-price">
                                        <small>PKR</small>@route.StartingPricePKR.ToString("N0", culture)
                                    </span>
                                </td>

                                <td data-label="Vehicles">
                                    <span class="tr-veh">
                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none"
                                             stroke="currentColor" stroke-width="1.7"
                                             stroke-linecap="round" stroke-linejoin="round"
                                             aria-hidden="true">
                                            <path d="M3 8.5h11v9H3z" />
                                            <path d="M14 11h3.6l3.4 3.4v3.1h-7z" />
                                            <circle cx="7" cy="18" r="1.6" />
                                            <circle cx="17" cy="18" r="1.6" />
                                        </svg>
                                        @vehicleCount
                                        <small>vehicle@(vehicleCount == 1 ? "" : "s")</small>
                                    </span>
                                </td>

                                <td data-label="Status">
                                    @if (route.IsArchived)
                                    {
                                        <span class="tr-status is-archived"><i></i>Archived</span>
                                    }
                                    else if (route.IsPublished && route.IsActive)
                                    {
                                        <span class="tr-status is-live"><i></i>Published</span>
                                    }
                                    else
                                    {
                                        <span class="tr-status is-draft"><i></i>Unpublished</span>
                                    }
                                </td>

                                <td data-label="Actions" class="tr-col-actions">
                                    <div class="tr-actions">
                                        <a class="tr-btn"
                                           href="@Url.Action("Transport", "Admin", new { editId = route.Id })#route-form"
                                           aria-label="Edit @route.Name">
                                            Edit
                                        </a>

                                        @if (route.IsArchived)
                                        {
                                            <form asp-action="RestoreTransportRoute" asp-route-id="@route.Id" method="post" class="tr-form-inline">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="tr-btn tr-btn-success"
                                                        aria-label="Restore @route.Name">
                                                    Restore
                                                </button>
                                            </form>
                                        }
                                        else
                                        {
                                            <form asp-action="ArchiveTransportRoute" asp-route-id="@route.Id" method="post" class="tr-form-inline"
                                                  onsubmit="return confirm('Archive this route and preserve its booking history?');">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="tr-btn tr-btn-warn"
                                                        aria-label="Archive @route.Name">
                                                    Archive
                                                </button>
                                            </form>
                                        }

                                        <form asp-action="DeleteTransportRoute" asp-route-id="@route.Id" method="post" class="tr-form-inline"
                                              onsubmit="return confirm('Permanently delete this route only if it has no booking history?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="tr-btn tr-btn-danger"
                                                    aria-label="Delete @route.Name">
                                                Delete
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div id="trNoResults" class="tr-no-results">
                No routes match your search or selected filter.
            </div>
        }
    </section>

    <!-- ================= ROUTE FORM ================= -->
    <section id="route-form" class="panel tr-form-card" aria-labelledby="route-form-title">
        <div class="tr-form-head">
            <div>
                <p class="eyebrow">@(edit == null ? "New route" : "Editing route")</p>
                <h2 id="route-form-title">
                    @(edit == null ? "Add transport route" : "Edit transport route")
                </h2>
                <p class="panel-subtitle">
                    @(edit == null
                        ? "Define the route, pricing, and the vehicles that serve it."
                        : "Update the route details, then save to apply the changes.")
                </p>
            </div>

            @if (edit != null)
            {
                <a class="tr-btn" href="@Url.Action("Transport", "Admin")">Cancel editing</a>
            }
        </div>

        <form asp-action="SaveTransportRoute" method="post" class="tr-form" novalidate>
            @Html.AntiForgeryToken()
            <input type="hidden" name="Id" value="@(edit?.Id ?? 0)" />

            <!-- Route identity -->
            <div class="tr-section">
                <div class="tr-section-head">
                    <h3>Route identity</h3>
                    <p>How travellers will find and recognise this route.</p>
                </div>

                <div class="tr-grid">
                    <div class="tr-field">
                        <label class="tr-label" for="RouteName">
                            Route name <span class="tr-req" aria-hidden="true">*</span>
                        </label>
                        <input class="tr-input" id="RouteName" name="Name" value="@edit?.Name"
                               placeholder="e.g. Karachi to Lahore Express" required aria-required="true" />
                    </div>

                    <div class="tr-field">
                        <label class="tr-label" for="RouteSlug">
                            URL slug <span class="tr-req" aria-hidden="true">*</span>
                        </label>
                        <input class="tr-input" id="RouteSlug" name="Slug" value="@edit?.Slug"
                               placeholder="e.g. karachi-to-lahore" required aria-required="true" />
                    </div>

                    <div class="tr-field">
                        <label class="tr-label" for="StartingCity">
                            Starting city <span class="tr-req" aria-hidden="true">*</span>
                        </label>
                        <input class="tr-input" id="StartingCity" name="StartingCity" value="@edit?.StartingCity"
                               placeholder="e.g. Karachi" required aria-required="true" />
                    </div>

                    <div class="tr-field">
                        <label class="tr-label" for="DestinationCity">
                            Destination city <span class="tr-req" aria-hidden="true">*</span>
                        </label>
                        <input class="tr-input" id="DestinationCity" name="DestinationCity" value="@edit?.DestinationCity"
                               placeholder="e.g. Lahore" required aria-required="true" />
                    </div>
                </div>
            </div>

            <!-- Pricing & logistics -->
            <div class="tr-section">
                <div class="tr-section-head">
                    <h3>Pricing &amp; logistics</h3>
                    <p>Fares, ordering, and travel estimates shown to travellers.</p>
                </div>

                <div class="tr-grid tr-grid-3">
                    <div class="tr-field">
                        <label class="tr-label" for="StartingPricePKR">
                            Starting price (PKR) <span class="tr-req" aria-hidden="true">*</span>
                        </label>
                        <input class="tr-input" id="StartingPricePKR" name="StartingPricePKR" type="number"
                               step="0.01" min="0.01" value="@edit?.StartingPricePKR"
                               placeholder="0.00" required aria-required="true" />
                    </div>

                    <div class="tr-field">
                        <label class="tr-label" for="ReturnPricePKR">Return price (PKR)</label>
                        <input class="tr-input" id="ReturnPricePKR" name="ReturnPricePKR" type="number"
                               step="0.01" min="0.01" value="@edit?.ReturnPricePKR"
                               placeholder="0.00" />
                    </div>

                    <div class="tr-field">
                        <label class="tr-label" for="DisplayOrder">Display order</label>
                        <input class="tr-input" id="DisplayOrder" name="DisplayOrder" type="number"
                               min="0" value="@(edit?.DisplayOrder ?? 0)" />
                    </div>

                    <div class="tr-field">
                        <label class="tr-label" for="EstimatedDistanceKm">Estimated distance (km)</label>
                        <input class="tr-input" id="EstimatedDistanceKm" name="EstimatedDistanceKm" type="number"
                               step="0.01" min="0" value="@edit?.EstimatedDistanceKm"
                               placeholder="e.g. 1210" />
                    </div>

                    <div class="tr-field">
                        <label class="tr-label" for="EstimatedDurationMinutes">Estimated duration (minutes)</label>
                        <input class="tr-input" id="EstimatedDurationMinutes" name="EstimatedDurationMinutes" type="number"
                               min="0" value="@edit?.EstimatedDurationMinutes"
                               placeholder="e.g. 780" />
                    </div>
                </div>
            </div>

            <!-- Vehicles -->
            <div class="tr-section">
                <div class="tr-section-head">
                    <h3>Associated vehicles</h3>
                    <p>Select every vehicle that can serve this route.</p>
                </div>

                <div class="tr-field">
                    <label class="tr-label" for="VehicleIds">
                        Vehicles <span class="tr-req" aria-hidden="true">*</span>
                    </label>
                    <select class="tr-select" id="VehicleIds" name="VehicleIds" multiple size="6" required
                            aria-required="true" aria-describedby="vehicleHint">
                        @foreach (var vehicle in vehicles)
                        {
                            <option value="@vehicle.Id"
                                    selected="@(edit?.VehicleIds.Contains(vehicle.Id) == true ? "selected" : null)">
                                @vehicle.Name (@vehicle.VehicleType)
                            </option>
                        }
                    </select>
                    <p class="tr-hint" id="vehicleHint">
                        Hold <kbd>Ctrl</kbd> or <kbd>⌘</kbd> to select multiple vehicles.
                        @if (!vehicles.Any())
                        {
                            <span class="tr-hint-warn">No vehicles available — add vehicles first.</span>
                        }
                    </p>
                </div>
            </div>

            <!-- Description -->
            <div class="tr-section">
                <div class="tr-section-head">
                    <h3>Description</h3>
                    <p>Optional context shown on the public route page.</p>
                </div>

                <div class="tr-field">
                    <label class="tr-label" for="Description">Route description</label>
                    <textarea class="tr-input tr-textarea" id="Description" name="Description"
                              rows="4" placeholder="Describe the journey, stops, or highlights…">@edit?.Description</textarea>
                </div>
            </div>

            <!-- Visibility -->
            <div class="tr-section">
                <div class="tr-section-head">
                    <h3>Visibility</h3>
                    <p>Control how this route appears across Karnel.</p>
                </div>

                <div class="tr-checks" role="group" aria-label="Visibility options">
                    <label class="tr-check">
                        <input type="checkbox" name="IsPublished" value="true"
                               @(edit?.IsPublished == true ? "checked" : null) />
                        <span>Published</span>
                    </label>

                    <label class="tr-check">
                        <input type="checkbox" name="IsFeatured" value="true"
                               @(edit?.IsFeatured == true ? "checked" : null) />
                        <span>Featured</span>
                    </label>

                    <label class="tr-check">
                        <input type="checkbox" name="IsActive" value="true"
                               @(edit?.IsActive != false ? "checked" : null) />
                        <span>Active</span>
                    </label>
                </div>
            </div>

            <div class="tr-form-foot">
                <p class="tr-hint"><span class="tr-req">*</span> Required fields</p>
                <div class="tr-form-actions">
                    <a class="tr-btn" href="@Url.Action("Transport", "Admin")">Cancel</a>
                    <button class="btn btn-primary" type="submit">
                        @(edit == null ? "Add route" : "Save route")
                    </button>
                </div>
            </div>
        </form>
    </section>
</div>

<script>
    (() => {
        const searchInput = document.getElementById("trSearch");
        const statusFilter = document.getElementById("trStatusFilter");
        const rows = Array.from(document.querySelectorAll(".tr-row"));
        const visibleCount = document.getElementById("trVisibleCount");
        const noResults = document.getElementById("trNoResults");

        if (!searchInput || !statusFilter) return;

        function filterRoutes() {
            const searchTerm = searchInput.value.trim().toLowerCase();
            const selectedStatus = statusFilter.value;

            let visible = 0;

            rows.forEach(row => {
                const searchText = row.dataset.search || "";
                const status = row.dataset.status || "";

                const matchesSearch = searchText.includes(searchTerm);
                const matchesStatus = selectedStatus === "all" || status === selectedStatus;

                const show = matchesSearch && matchesStatus;
                row.style.display = show ? "" : "none";
                if (show) visible++;
            });

            if (visibleCount) visibleCount.textContent = visible;

            if (noResults) {
                noResults.style.display = visible === 0 ? "block" : "none";
            }
        }

        searchInput.addEventListener("input", filterRoutes);
        statusFilter.addEventListener("change", filterRoutes);
    })();
</script>

<style>
    /* ============================================================
       TRANSPORT ROUTES — premium refinements
       Built on Karnel Admin design tokens from _AdminLayout.
       ============================================================ */

    .tr-page { display: block; }

    /* Smooth in-page anchor scrolling for the "Add route" buttons */
    html { scroll-behavior: smooth; }

    /* ---------- Heading ---------- */
    .tr-page .page-heading {
        align-items: flex-end;
        margin-bottom: 26px;
    }

    .tr-page .page-heading h1 { font-size: clamp(30px, 3.4vw, 46px); }

    .tr-page .page-heading p {
        margin-top: 8px;
        max-width: 60ch;
    }

    .tr-page .page-heading .btn { flex-shrink: 0; }

    /* ---------- Stats ---------- */
    .tr-stats {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 14px;
        margin-bottom: 22px;
    }

    .tr-stat {
        background: var(--surface, var(--white));
        border: 1px solid var(--line);
        border-radius: var(--radius);
        padding: 16px 18px;
        transition: border-color var(--dur) var(--ease),
                    box-shadow var(--dur) var(--ease),
                    transform var(--dur) var(--ease);
    }

    .tr-stat:hover {
        border-color: var(--line-hi);
        box-shadow: var(--shadow-sm);
        transform: translateY(-1px);
    }

    .tr-stat label {
        display: block;
        font-size: 10.5px;
        font-weight: 700;
        letter-spacing: .13em;
        text-transform: uppercase;
        color: var(--muted);
    }

    .tr-stat strong {
        display: block;
        margin: 7px 0 3px;
        font-family: var(--sans);
        font-size: 26px;
        font-weight: 600;
        line-height: 1.05;
        letter-spacing: -.015em;
        color: var(--forest);
        font-variant-numeric: tabular-nums;
    }

    .tr-stat small {
        font-size: 11.5px;
        color: var(--muted);
        line-height: 1.4;
    }

    /* ---------- Alerts ---------- */
    .tr-alert {
        display: flex;
        align-items: flex-start;
        gap: 10px;
        padding: 12px 16px;
        margin-bottom: 14px;
        border-radius: 10px;
        font-size: 13px;
        font-weight: 500;
        line-height: 1.45;
        border: 1px solid transparent;
    }

    .tr-alert svg { flex-shrink: 0; margin-top: 1px; }

    .tr-alert-success {
        background: rgba(60, 145, 105, .10);
        border-color: rgba(60, 145, 105, .22);
        color: #1f5a3f;
    }

    .tr-alert-danger {
        background: rgba(174, 93, 80, .10);
        border-color: rgba(174, 93, 80, .22);
        color: #8b4137;
    }

    /* ---------- Roster card ---------- */
    .tr-card {
        padding: 0;
        overflow: hidden;
    }

    .tr-card .panel-title {
        margin: 0;
        padding: 22px 24px 18px;
        border-bottom: 1px solid var(--line);
    }

    .tr-card .panel-title h2 { font-size: 22px; }

    .tr-count {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 4px 12px;
        border-radius: var(--radius-pill);
        background: var(--soft);
        color: var(--forest);
        font-size: 11.5px;
        font-weight: 700;
        letter-spacing: .03em;
        font-variant-numeric: tabular-nums;
    }

    .tr-count::before {
        content: "";
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: var(--accent);
        box-shadow: 0 0 0 3px rgba(60, 145, 105, .15);
    }

    /* ---------- Filter toolbar ---------- */
    .tr-toolbar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 14px;
        flex-wrap: wrap;
        padding: 14px 22px;
        border-bottom: 1px solid var(--line);
        background: rgba(143, 168, 136, .04);
    }

    .tr-filters {
        display: flex;
        gap: 10px;
        flex: 1;
        flex-wrap: wrap;
    }

    .tr-filter-input {
        min-height: 40px;
        padding: 0 12px;
        border: 1px solid var(--line);
        border-radius: 9px;
        background: var(--surface, var(--white));
        color: var(--ink);
        font-family: var(--sans);
        font-size: 13px;
        outline: none;
        transition: border-color var(--dur-fast) var(--ease),
                    box-shadow var(--dur-fast) var(--ease);
    }

    .tr-filter-input:focus {
        border-color: var(--accent);
        box-shadow: var(--ring-accent);
    }

    .tr-filter-input::placeholder { color: var(--muted); }

    #trSearch { width: min(360px, 100%); min-width: 200px; }
    #trStatusFilter { min-width: 175px; }

    .tr-result-count {
        color: var(--muted);
        font-size: 12px;
        font-weight: 500;
        white-space: nowrap;
    }

    .tr-result-count strong { color: var(--forest); font-weight: 700; }

    /* ---------- Table ---------- */
    .tr-table-wrap {
        width: 100%;
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
        scrollbar-width: thin;
        scrollbar-color: var(--line-hi) transparent;
    }

    .tr-table-wrap::-webkit-scrollbar { height: 8px; }
