@model KarnelTravel.Models.Booking

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Booking Details";
}

<div class="page-heading">
    <div>
        <div class="eyebrow">BOOKING MANAGEMENT</div>
        <h1>Booking Details</h1>
        <p>Reference: @Model.ReferenceNumber</p>
    </div>

    <a href="/Admin/Bookings" class="btn btn-quiet">
        Back to bookings
    </a>
</div>

@if (TempData["BookingSuccess"] is string success)
{
    <div class="booking-message success">@success</div>
}

@if (TempData["BookingError"] is string error)
{
    <div class="booking-message error">@error</div>
}

<div class="booking-details-grid">
    <section class="booking-panel">
        <h2>Customer information</h2>

        <dl>
            <dt>Customer name</dt>
            <dd>@Model.CustomerName</dd>

            <dt>Phone</dt>
            <dd>@Model.Phone</dd>

            <dt>Email</dt>
            <dd>@(Model.Email ?? "Not provided")</dd>
        </dl>
    </section>

    <section class="booking-panel">
        <h2>Service information</h2>

        <dl>
            <dt>Service type</dt>
            <dd>@Model.ServiceType</dd>

            <dt>Service name</dt>
            <dd>@Model.ServiceName</dd>

            <dt>Booking date</dt>
            <dd>@Model.BookingDate.ToString("dd MMM yyyy")</dd>

            <dt>Return date</dt>
            <dd>
                @(Model.ReturnDate?.ToString("dd MMM yyyy")
                    ?? "Not specified")
            </dd>

            <dt>Adults</dt>
            <dd>@Model.Adults</dd>

            <dt>Children</dt>
            <dd>@Model.Children</dd>

            <dt>Rooms</dt>
            <dd>@Model.Rooms</dd>

            <dt>Estimated total</dt>
            <dd>
                @(Model.EstimatedTotalPKR.HasValue
                    ? "PKR " + Model.EstimatedTotalPKR.Value.ToString("N0")
                    : "Not calculated")
            </dd>

            <dt>Submitted</dt>
            <dd>@Model.CreatedAt.ToString("dd MMM yyyy, HH:mm")</dd>
        </dl>
    </section>

    <section class="booking-panel">
        <h2>Customer notes</h2>
        <p class="booking-notes">
            @(string.IsNullOrWhiteSpace(Model.CustomerNotes)
                ? "No customer notes provided."
                : Model.CustomerNotes)
        </p>
    </section>

    <section class="booking-panel">
        <h2>Manage booking</h2>

        <form method="post"
              action="/Admin/BookingDetails/@Model.Id/Update">

            @Html.AntiForgeryToken()

            <label for="status">Booking status</label>
            <select id="status" name="status" class="select" required>
                <option value="Pending"
                        selected="@(Model.Status == "Pending")">
                    Pending
                </option>
                <option value="Confirmed"
                        selected="@(Model.Status == "Confirmed")">
                    Confirmed
                </option>
                <option value="Completed"
                        selected="@(Model.Status == "Completed")">
                    Completed
                </option>
                <option value="Cancelled"
                        selected="@(Model.Status == "Cancelled")">
                    Cancelled
                </option>
            </select>

            <label for="adminNotes">Internal admin notes</label>
            <textarea id="adminNotes"
                      name="adminNotes"
                      class="input"
                      rows="5"
                      maxlength="1000"
                      placeholder="Add internal booking notes...">@Model.AdminNotes</textarea>

            <button type="submit" class="btn">
                Save changes
            </button>
        </form>
    </section>
</div>

<style>
    .booking-details-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 20px;
        margin-top: 24px;
    }

    .booking-panel {
        padding: 24px;
        border: 1px solid var(--border, #e5e7eb);
        border-radius: 14px;
        background: var(--surface, #fff);
        min-width: 0;
    }

    .booking-panel h2 {
        font-size: 18px;
        margin: 0 0 20px;
    }

    .booking-panel dl {
        display: grid;
        grid-template-columns: minmax(100px, 1fr) minmax(0, 1.5fr);
        gap: 14px;
        margin: 0;
    }

    .booking-panel dt {
        opacity: .7;
    }

    .booking-panel dd {
        margin: 0;
        overflow-wrap: anywhere;
        font-weight: 500;
    }

    .booking-panel label {
        display: block;
        margin: 16px 0 8px;
    }

    .booking-panel select,
    .booking-panel textarea {
        width: 100%;
        box-sizing: border-box;
    }

    .booking-panel textarea {
        min-height: 120px;
        padding: 12px;
        resize: vertical;
    }

    .booking-panel button {
        margin-top: 18px;
    }

    .booking-notes {
        white-space: pre-wrap;
        overflow-wrap: anywhere;
    }

    .booking-message {
        padding: 14px 18px;
        border-radius: 8px;
        margin: 18px 0;
    }

    .booking-message.success {
        background: #e8f6ed;
        color: #176536;
    }

    .booking-message.error {
        background: #fff0ee;
        color: #a12c20;
    }

    @@media (max-width: 760px) {
        .booking-details-grid {
            grid-template-columns: 1fr;
        }
    }
</style>
