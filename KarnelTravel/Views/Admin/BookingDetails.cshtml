
@model KarnelTravel.Models.Booking

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Booking Details";
    var isTransport = Model.ServiceType == "Transport";
}

<div class="page-heading booking-heading">
    <div>
        <div class="eyebrow">BOOKING MANAGEMENT</div>
        <h1>Booking Details</h1>
        <p>Reference: <strong>@Model.ReferenceNumber</strong></p>
    </div>

    <a href="/Admin/Bookings" class="btn btn-quiet">
        ← Back to bookings
    </a>
</div>

@if (TempData["BookingSuccess"] is string success)
{
    <div class="booking-message success">@success</div>
}

@if (TempData["BookingError"] is string error)
{
    <div class="booking-message error">@error</div>
}

<div class="booking-details-grid">

    <div class="booking-main-column">

        <section class="booking-panel">
            <div class="panel-heading">
                <div>
                    <span class="panel-kicker">PERSONAL DETAILS</span>
                    <h2>Customer information</h2>
                </div>
                <span class="panel-icon">01</span>
            </div>

            <div class="info-grid">
                <div class="info-item">
                    <span>Customer name</span>
                    <strong>@Model.CustomerName</strong>
                </div>

                <div class="info-item">
                    <span>Phone</span>
                    <strong>@Model.Phone</strong>
                </div>

                <div class="info-item full-width">
                    <span>Email address</span>
                    <strong class="break-text">@(Model.Email ?? "Not provided")</strong>
                </div>
            </div>
        </section>

        <section class="booking-panel">
            <div class="panel-heading">
                <div>
                    <span class="panel-kicker">BOOKED SERVICE</span>
                    <h2>Service information</h2>
                </div>
                <span class="panel-icon">02</span>
            </div>

            <div class="info-grid">
                <div class="info-item">
                    <span>Service type</span>
                    <strong>@Model.ServiceType</strong>
                </div>

                <div class="info-item">
                    <span>Service name</span>
                    <strong>@Model.ServiceName</strong>
                </div>

                <div class="info-item">
                    <span>Reference</span>
                    <strong class="break-text">@Model.ReferenceNumber</strong>
                </div>

                <div class="info-item">
                    <span>Current status</span>
                    <strong>
                        <span class="status-pill">@Model.Status</span>
                    </strong>
                </div>
            </div>
        </section>

        @if (isTransport)
        {
            <section class="booking-panel transport-panel">
                <div class="panel-heading">
                    <div>
                        <span class="panel-kicker">TRANSPORT DETAILS</span>
                        <h2>Journey information</h2>
                    </div>
                    <span class="panel-icon">03</span>
                </div>

                <div class="journey-route">
                    <div class="journey-point">
                        <span class="journey-dot pickup-dot"></span>
                        <div>
                            <span>Pickup location</span>
                            <strong>@(Model.PickupLocation ?? "Not specified")</strong>
                        </div>
                    </div>

                    <div class="journey-line"></div>

                    <div class="journey-point">
                        <span class="journey-dot dropoff-dot"></span>
                        <div>
                            <span>Drop-off location</span>
                            <strong>@(Model.DropoffLocation ?? "Not specified")</strong>
                        </div>
                    </div>
                </div>

                <div class="journey-meta">
                    <div class="info-item">
                        <span>Trip type</span>
                        <strong>@(Model.TripType ?? "Not specified")</strong>
                    </div>

                    <div class="info-item">
                        <span>Departure</span>
                        <strong>@Model.BookingDate.ToString("dd MMM yyyy")</strong>
                    </div>

                    <div class="info-item">
                        <span>Return</span>
                        <strong>@(Model.ReturnDate?.ToString("dd MMM yyyy") ?? "Not applicable")</strong>
                    </div>
                </div>
            </section>
        }

        <section class="booking-panel">
            <div class="panel-heading">
                <div>
                    <span class="panel-kicker">CUSTOMER MESSAGE</span>
                    <h2>Customer notes</h2>
                </div>
            </div>

            <div class="notes-box">
                @(string.IsNullOrWhiteSpace(Model.CustomerNotes)
                    ? "No customer notes provided."
                    : Model.CustomerNotes)
            </div>
        </section>

    </div>

    <div class="booking-side-column">

        <section class="booking-panel">
            <div class="panel-heading">
                <div>
                    <span class="panel-kicker">RESERVATION SUMMARY</span>
                    <h2>Booking information</h2>
                </div>
            </div>

            <div class="summary-list">
                <div class="summary-row">
                    <span>Booking date</span>
                    <strong>@Model.BookingDate.ToString("dd MMM yyyy")</strong>
                </div>

                @if (!isTransport)
                {
                    <div class="summary-row">
                        <span>Return date</span>
                        <strong>@(Model.ReturnDate?.ToString("dd MMM yyyy") ?? "Not specified")</strong>
                    </div>
                }

                <div class="summary-row">
                    <span>Adults</span>
                    <strong>@Model.Adults</strong>
                </div>

                <div class="summary-row">
                    <span>Children</span>
                    <strong>@Model.Children</strong>
                </div>

                @if (!isTransport)
                {
                    <div class="summary-row">
                        <span>Rooms</span>
                        <strong>@Model.Rooms</strong>
                    </div>
                }

                <div class="summary-row total-row">
                    <span>Estimated total</span>
                    <strong>
                        @(Model.EstimatedTotalPKR.HasValue
                            ? "PKR " + Model.EstimatedTotalPKR.Value.ToString("N0")
                            : "Not calculated")
                    </strong>
                </div>
            </div>

            <div class="timestamp-list">
                <div>
                    <span>Submitted</span>
                    <strong>@Model.CreatedAt.ToLocalTime().ToString("dd MMM yyyy, HH:mm")</strong>
                </div>

                <div>
                    <span>Last updated</span>
                    <strong>
                        @(Model.UpdatedAt?.ToLocalTime().ToString("dd MMM yyyy, HH:mm") ?? "Never")
                    </strong>
                </div>
            </div>
        </section>

        <section class="booking-panel manage-panel">
            <div class="panel-heading">
                <div>
                    <span class="panel-kicker">ADMINISTRATION</span>
                    <h2>Manage booking</h2>
                </div>
            </div>

            <form method="post"
                  action="/Admin/BookingDetails/@Model.Id/Update">

                @Html.AntiForgeryToken()

                <div class="form-field">
                    <label for="status">Booking status</label>

                    <select id="status" name="status" class="select" required>
                        <option value="Pending" selected="@(Model.Status == "Pending")">Pending</option>
                        <option value="Confirmed" selected="@(Model.Status == "Confirmed")">Confirmed</option>
                        <option value="Completed" selected="@(Model.Status == "Completed")">Completed</option>
                        <option value="Cancelled" selected="@(Model.Status == "Cancelled")">Cancelled</option>
                    </select>
                </div>

                <div class="form-field">
                    <label for="adminNotes">Internal admin notes</label>

                    <textarea id="adminNotes"
                              name="adminNotes"
                              class="input"
                              rows="6"
                              maxlength="1000"
                              placeholder="Add internal notes about this booking...">@Model.AdminNotes</textarea>

                    <small>These notes are for administration only.</small>
                </div>

                <button type="submit" class="btn save-booking-btn">
                    Save changes
                </button>
            </form>
        </section>

    </div>

</div>

<style>
    .booking-details-grid {
        display: grid;
        grid-template-columns: minmax(0, 1.55fr) minmax(300px, .85fr);
        gap: 24px;
        margin-top: 28px;
        align-items: start;
    }

    .booking-main-column,
    .booking-side-column {
        display: grid;
        gap: 22px;
        min-width: 0;
    }

    .booking-panel {
        min-width: 0;
        padding: 26px;
        border: 1px solid var(--border, #e5e7eb);
        border-radius: 16px;
        background: var(--surface, #fff);
    }

    .panel-heading {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
        margin-bottom: 25px;
    }

    .panel-heading h2 {
        margin: 5px 0 0;
        font-size: 19px;
        font-weight: 650;
    }

    .panel-kicker {
        display: block;
        font-size: 10px;
        font-weight: 700;
        letter-spacing: 1.3px;
        opacity: .55;
    }

    .panel-icon {
        display: grid;
        place-items: center;
        width: 34px;
        height: 34px;
        flex-shrink: 0;
        border-radius: 9px;
        background: var(--surface-alt, #f3f4f6);
        font-size: 12px;
        font-weight: 700;
        opacity: .65;
    }

    .info-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 23px 20px;
    }

    .info-item {
        display: flex;
        flex-direction: column;
        gap: 8px;
        min-width: 0;
    }

    .info-item > span {
        font-size: 12px;
        opacity: .62;
    }

    .info-item strong {
        font-size: 14px;
        font-weight: 600;
        line-height: 1.5;
    }

    .full-width {
        grid-column: 1 / -1;
    }

    .break-text {
        overflow-wrap: anywhere;
    }

    .status-pill {
        display: inline-block;
        padding: 6px 11px;
        border-radius: 20px;
        background: var(--surface-alt, #f3f4f6);
        font-size: 12px;
    }

    .journey-route {
        padding: 18px;
        border-radius: 12px;
        background: var(--surface-alt, #f5f6f4);
    }

    .journey-point {
        display: flex;
        align-items: center;
        gap: 13px;
    }

    .journey-point > div {
        display: flex;
        flex-direction: column;
        gap: 5px;
    }

    .journey-point span:not(.journey-dot) {
        font-size: 11px;
        opacity: .6;
    }

    .journey-point strong {
        font-size: 15px;
    }

    .journey-dot {
        width: 11px;
        height: 11px;
        flex-shrink: 0;
        border: 2px solid currentColor;
        border-radius: 50%;
    }

    .pickup-dot {
        color: #27865c;
    }

    .dropoff-dot {
        color: #b17a35;
    }

    .journey-line {
        width: 2px;
        height: 26px;
        margin: 4px 0 4px 4px;
        background: var(--border, #d1d5db);
    }

    .journey-meta {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 16px;
        margin-top: 23px;
    }

    .journey-meta .info-item strong {
        font-size: 13px;
    }

    .notes-box {
        min-height: 55px;
        padding: 16px;
        border-radius: 10px;
        background: var(--surface-alt, #f5f6f4);
        font-size: 14px;
        line-height: 1.7;
        white-space: pre-wrap;
        overflow-wrap: anywhere;
    }

    .summary-list {
        display: grid;
        gap: 0;
    }

    .summary-row {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 12px;
        padding: 13px 0;
        border-bottom: 1px solid var(--border, #e5e7eb);
        font-size: 13px;
    }

    .summary-row span {
        opacity: .65;
    }

    .summary-row strong {
        text-align: right;
        font-weight: 600;
        overflow-wrap: anywhere;
    }

    .total-row {
        padding-top: 18px;
        border-bottom: 0;
        font-size: 14px;
    }

    .timestamp-list {
        display: grid;
        gap: 14px;
        margin-top: 15px;
        padding-top: 18px;
        border-top: 1px solid var(--border, #e5e7eb);
    }

    .timestamp-list div {
        display: flex;
        flex-direction: column;
        gap: 6px;
    }

    .timestamp-list span {
        font-size: 11px;
        opacity: .6;
    }

    .timestamp-list strong {
        font-size: 12px;
        font-weight: 550;
    }

    .form-field {
        margin-bottom: 22px;
    }

    .form-field label {
        display: block;
        margin-bottom: 9px;
        font-size: 13px;
        font-weight: 600;
    }

    .form-field select,
    .form-field textarea {
        display: block;
        width: 100%;
        box-sizing: border-box;
    }

    .form-field textarea {
        min-height: 145px;
        padding: 13px;
        resize: vertical;
        line-height: 1.6;
    }

    .form-field small {
        display: block;
        margin-top: 8px;
        font-size: 11px;
        opacity: .55;
    }

    .save-booking-btn {
        width: 100%;
        justify-content: center;
        min-height: 46px;
    }

    .booking-message {
        padding: 14px 18px;
        border-radius: 10px;
        margin: 18px 0;
    }

    .booking-message.success {
        background: #e8f6ed;
        color: #176536;
    }

    .booking-message.error {
        background: #fff0ee;
        color: #a12c20;
    }

    @@media (max-width: 1050px) {
        .booking-details-grid {
            grid-template-columns: minmax(0, 1fr);
        }

        .booking-side-column {
            grid-template-columns: repeat(2, minmax(0, 1fr));
            align-items: start;
        }
    }

    @@media (max-width: 650px) {
        .booking-panel {
            padding: 20px;
        }

        .booking-side-column {
            grid-template-columns: 1fr;
        }

        .info-grid {
            grid-template-columns: 1fr;
        }

        .full-width {
            grid-column: auto;
        }

        .journey-meta {
            grid-template-columns: 1fr;
        }

        .booking-heading {
            align-items: flex-start;
            gap: 15px;
        }

        
/* Final booking form usability improvements */

.manage-panel {
    padding: 28px;
}

.manage-panel .panel-heading {
    margin-bottom: 28px;
}

.manage-panel .form-field {
    margin-bottom: 25px;
}

.manage-panel .form-field label {
    display: block;
    margin-bottom: 11px;
    font-size: 13px;
    font-weight: 650;
}

.manage-panel select {
    min-height: 48px;
    padding: 0 14px;
    border: 1px solid var(--border, #d9dedb);
    border-radius: 9px;
    background: var(--surface, #fff);
    font-size: 14px;
    cursor: pointer;
}

.manage-panel textarea {
    min-height: 160px;
    padding: 15px;
    border: 1px solid var(--border, #d9dedb);
    border-radius: 9px;
    font-family: inherit;
    font-size: 14px;
    line-height: 1.7;
}

.manage-panel select:focus,
.manage-panel textarea:focus {
    outline: none;
    border-color: #668b76;
    box-shadow: 0 0 0 3px rgba(102, 139, 118, .12);
}

.manage-panel .form-field small {
    margin-top: 10px;
    line-height: 1.5;
}

.manage-panel .save-booking-btn {
    min-height: 49px;
    border-radius: 9px;
    font-size: 14px;
    font-weight: 650;
}

    }
</style>
