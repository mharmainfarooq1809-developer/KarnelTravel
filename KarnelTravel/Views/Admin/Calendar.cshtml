@{ Layout = "_AdminLayout"; ViewData["Title"] = "Calendar"; }
<div class="page-heading"><div><div class="eyebrow">Schedule desk · October 2025</div><h1>See the season unfold.</h1><p>Tour departures and transport schedules, together.</p></div><button class="btn btn-primary" data-toast="New schedule is visual only.">＋ Add schedule</button></div><div class="panel"><div class="calendar-head"><button class="btn btn-quiet">←</button><h2>October 2025</h2><div><button class="btn tab is-active">Month</button><button class="btn">Week</button><button class="btn">Day</button></div></div><div class="calendar"><div class="calendar-cell"><em>Mon</em></div><div class="calendar-cell"><em>Tue</em></div><div class="calendar-cell"><em>Wed</em></div><div class="calendar-cell"><em>Thu</em></div><div class="calendar-cell"><em>Fri</em></div><div class="calendar-cell"><em>Sat</em></div><div class="calendar-cell"><em>Sun</em></div>@for(var day = 1; day <= 31; day++){<div class="calendar-cell"><em>@day</em>@if(day == 18){<span class="calendar-event">Hunza · 08:00</span>}@if(day == 22){<span class="calendar-event">Deosai · 06:30</span>}@if(day == 24){<span class="calendar-event">Shigar · 09:00</span>}</div>}</div></div>
