
@model List<KarnelTravel.Models.Booking>

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Bookings";

    var statusFilter = ViewBag.StatusFilter as string ?? "all";
    var searchTerm = ViewBag.SearchTerm as string ?? "";
}

<div class="page-heading">
    <div>
        <div class="eyebrow">BOOKING MANAGEMENT</div>
        <h1>Reservations</h1>
        <p>Review and manage customer reservations.</p>
    </div>
</div>

<div class="stats-grid">
    <div class="panel">
        <span>Total bookings</span>
        <h2>@ViewBag.TotalBookings</h2>
    </div>
    <div class="panel">
        <span>Pending</span>
        <h2>@ViewBag.PendingBookings</h2>
    </div>
    <div class="panel">
        <span>Confirmed</span>
        <h2>@ViewBag.ConfirmedBookings</h2>
    </div>
    <div class="panel">
        <span>Completed</span>
        <h2>@ViewBag.CompletedBookings</h2>
    </div>
    <div class="panel">
        <span>Cancelled</span>
        <h2>@ViewBag.CancelledBookings</h2>
    </div>
</div>

<form method="get" action="/Admin/Bookings" class="toolbar">
    <input class="input"
           type="search"
           name="search"
           value="@searchTerm"
           placeholder="Search reference, customer, phone..." />

    <select class="select" name="status">
        <option value="all" selected="@(statusFilter == "all")">All statuses</option>
        <option value="Pending" selected="@(statusFilter == "Pending")">Pending</option>
        <option value="Confirmed" selected="@(statusFilter == "Confirmed")">Confirmed</option>
        <option value="Completed" selected="@(statusFilter == "Completed")">Completed</option>
        <option value="Cancelled" selected="@(statusFilter == "Cancelled")">Cancelled</option>
    </select>

    <button class="btn btn-quiet" type="submit">Search</button>
    <a class="btn btn-quiet" href="/Admin/Bookings">Clear</a>
</form>

<div class="table-wrap">
    <table class="data-table">
        <thead>
            <tr>
                <th>Reference / Customer</th>
                <th>Service</th>
                <th>Travel / Booking date</th>
                <th>Guests / Rooms</th>
                <th>Estimated total</th>
                <th>Status</th>
                <th>Submitted</th>
                <th>Actions</th>
            </tr>
        </thead>

        <tbody>
            @if (Model == null || Model.Count == 0)
            {
                <tr>
                    <td colspan="8">No bookings found.</td>
                </tr>
            }
            else
            {
                @foreach (var booking in Model)
                {
                    <tr>
                        <td>
                            <strong>@booking.ReferenceNumber</strong>
                            <div>@booking.CustomerName</div>
                            <small>@booking.Phone</small>
                        </td>

                        <td>
                            <strong>@booking.ServiceName</strong>
                            <div>@booking.ServiceType</div>
                        </td>

                        <td>
                            @booking.BookingDate.ToString("dd MMM yyyy")

                            @if (booking.ServiceType == "Transport")
                            {
                                <div class="transport-route">
                                    <small>
                                        @(booking.PickupLocation ?? "Pickup not specified")
                                        →
                                        @(booking.DropoffLocation ?? "Drop-off not specified")
                                    </small>
                                </div>
                                <small>@(booking.TripType ?? "Trip type not specified")</small>
                            }
                            else if (booking.ReturnDate.HasValue)
                            {
                                <small>
                                    Return: @booking.ReturnDate.Value.ToString("dd MMM yyyy")
                                </small>
                            }
                        </td>

                        <td>
                            @booking.Adults adults

                            @if (booking.Children > 0)
                            {
                                <div>@booking.Children children</div>
                            }

                            @if (booking.Rooms > 0)
                            {
                                <div>@booking.Rooms rooms</div>
                            }
                        </td>

                        <td>
                            @if (booking.EstimatedTotalPKR.HasValue)
                            {
                                <span>PKR @booking.EstimatedTotalPKR.Value.ToString("N0")</span>
                            }
                            else
                            {
                                <span>Not calculated</span>
                            }
                        </td>

                        <td>
                            <span class="status">
                                @booking.Status
                            </span>
                        </td>

                        <td>
                            @booking.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")
                        </td>

                        <td>
                            <a href="/Admin/BookingDetails/@booking.Id">
                                View details
                            </a>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

<style>
    .transport-route {
        margin-top: 5px;
        max-width: 230px;
        overflow-wrap: anywhere;
    }

    .transport-route small {
        font-weight: 600;
    }
</style>
