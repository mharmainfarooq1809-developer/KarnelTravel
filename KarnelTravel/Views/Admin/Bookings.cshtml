@model List<KarnelTravel.Models.Booking>

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Bookings";

    var statusFilter = ViewBag.StatusFilter as string ?? "all";
    var searchTerm = ViewBag.SearchTerm as string ?? "";
}

<style>
   

    .bookings-page {
        color: var(--ink, #1b2922);
        padding-bottom: 36px;
    }

    /* ---------- Header ---------- */
    .bookings-header {
        margin-bottom: 26px;
    }
    .bookings-eyebrow {
        margin: 0 0 8px;
        color: var(--accent, #3c9169);
        font-size: 11px;
        font-weight: 700;
        letter-spacing: .16em;
        text-transform: uppercase;
    }
    .bookings-header h1 {
        font-family: var(--serif, Georgia, serif);
        font-weight: 400;
        color: var(--forest, #164734);
        font-size: clamp(28px, 3.2vw, 42px);
        line-height: 1.1;
        letter-spacing: -.02em;
        margin: 0;
    }
    .bookings-header p {
        margin: 10px 0 0;
        color: var(--muted, #758078);
        font-size: 13.5px;
        line-height: 1.6;
        max-width: 62ch;
    }

    /* ---------- Stat tiles ---------- */
    .booking-stats {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
        gap: 14px;
        margin-bottom: 22px;
    }
    .booking-stat {
        padding: 18px 20px;
        background: var(--white, #fff);
        border: 1px solid var(--line, #e5e9e3);
        border-radius: 14px;
        border-left: 4px solid var(--line, #e5e9e3);
        transition: border-color .18s ease, box-shadow .18s ease;
        min-width: 0;
    }
    .booking-stat:hover {
        border-color: var(--line-hi, #d6dcd4);
        box-shadow: 0 2px 6px -2px rgba(22,71,52,.08);
    }
    .booking-stat-label {
        display: block;
        color: var(--muted, #758078);
        font-size: 11px;
        font-weight: 600;
        letter-spacing: .06em;
        text-transform: uppercase;
        margin-bottom: 6px;
    }
    .booking-stat-value {
        display: block;
        font-family: var(--serif, Georgia, serif);
        font-weight: 400;
        font-size: 26px;
        color: var(--forest, #164734);
        line-height: 1.15;
        letter-spacing: -.01em;
        font-variant-numeric: tabular-nums;
    }

    /* Coloured accent per status tile */
    .booking-stat.stat-total     { border-left-color: var(--forest, #164734); }
    .booking-stat.stat-pending   { border-left-color: #dca43d; }
    .booking-stat.stat-confirmed { border-left-color: #28b485; }
    .booking-stat.stat-completed { border-left-color: #3c9169; }
    .booking-stat.stat-cancelled { border-left-color: #ae5d50; }

    /* ---------- Toolbar ---------- */
    .booking-toolbar {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        padding: 14px 16px;
        background: var(--white, #fff);
        border: 1px solid var(--line, #e5e9e3);
        border-radius: 12px;
        margin-bottom: 22px;
    }
    .booking-search {
        display: flex;
        align-items: center;
        gap: 9px;
        flex: 1;
        min-width: 200px;
        height: 42px;
        padding: 0 14px;
        border: 1px solid var(--line, #e5e9e3);
        border-radius: 10px;
        background: var(--white, #fff);
        color: var(--muted, #758078);
        transition: border-color .14s ease, box-shadow .14s ease;
    }
    .booking-search:focus-within {
        border-color: var(--accent, #3c9169);
        box-shadow: 0 0 0 3px rgba(60,145,105,.20);
    }
    .booking-search svg {
        width: 16px;
        height: 16px;
        flex-shrink: 0;
        fill: none;
        stroke: currentColor;
        stroke-width: 1.8;
        stroke-linecap: round;
        stroke-linejoin: round;
    }
    .booking-search input {
        width: 100%;
        min-width: 0;
        height: 100%;
        border: 0;
        outline: 0;
        background: transparent;
        color: var(--ink, #1b2922);
        font: inherit;
        font-size: 13px;
    }
    .booking-search input::placeholder { color: var(--muted, #758078); }

    .booking-toolbar select {
        height: 42px;
        padding: 0 34px 0 14px;
        border: 1px solid var(--line, #e5e9e3);
        border-radius: 10px;
        background: var(--white, #fff) url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%23758078' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><polyline points='6 9 12 15 18 9'/></svg>") no-repeat right 12px center / 14px;
        color: var(--ink, #1b2922);
        font: inherit;
        font-size: 13px;
        cursor: pointer;
        appearance: none;
        -webkit-appearance: none;
        transition: border-color .14s ease, box-shadow .14s ease;
    }
    .booking-toolbar select:focus {
        outline: none;
        border-color: var(--accent, #3c9169);
        box-shadow: 0 0 0 3px rgba(60,145,105,.20);
    }

    .booking-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        height: 42px;
        padding: 0 16px;
        border: 1px solid transparent;
        border-radius: 10px;
        font: inherit;
        font-size: 12.5px;
        font-weight: 700;
        text-decoration: none;
        cursor: pointer;
        white-space: nowrap;
        transition: background .14s ease, border-color .14s ease, color .14s ease, box-shadow .14s ease, transform .14s ease;
    }
    .booking-btn-primary {
        background: var(--forest, #164734);
        color: #fff;
        border-color: var(--forest, #164734);
        box-shadow: 0 2px 10px -4px rgba(22,71,52,.4);
    }
    .booking-btn-primary:hover {
        background: var(--green, #236b4d);
        border-color: var(--green, #236b4d);
        color: #fff;
        box-shadow: 0 6px 20px -8px rgba(22,71,52,.5);
        transform: translateY(-1px);
    }
    .booking-btn-secondary {
        background: var(--white, #fff);
        color: var(--ink, #1b2922);
        border-color: var(--line, #e5e9e3);
    }
    .booking-btn-secondary:hover {
        background: var(--soft, #edf2ed);
        border-color: var(--line-hi, #d6dcd4);
        color: var(--forest, #164734);
    }

    /* ---------- Card grid ---------- */
    .booking-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(min(340px, 100%), 1fr));
        gap: 18px;
    }

    .booking-card {
        display: flex;
        flex-direction: column;
        background: var(--white, #fff);
        border: 1px solid var(--line, #e5e9e3);
        border-radius: 14px;
        overflow: hidden;
        contain: layout;
        transition: border-color .18s ease, box-shadow .18s ease, transform .18s ease;
    }
    .booking-card:hover {
        border-color: var(--line-hi, #d6dcd4);
        box-shadow: 0 8px 20px -12px rgba(22,71,52,.22);
        transform: translateY(-2px);
    }

    /* Card head */
    .booking-card-head {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 10px;
        padding: 16px 20px 14px;
        border-bottom: 1px solid var(--line, #e5e9e3);
        background:
            linear-gradient(135deg, rgba(60,145,105,.05), rgba(22,71,52,.02)),
            repeating-linear-gradient(45deg, transparent 0 14px, rgba(60,145,105,.03) 14px 15px);
    }
    .booking-id-block { min-width: 0; }
    .booking-ref {
        display: block;
        font-size: 13px;
        font-weight: 700;
        color: var(--forest, #164734);
        letter-spacing: .01em;
        font-family: ui-monospace, 'SF Mono', 'Cascadia Code', monospace;
    }
    .booking-submitted {
        display: block;
        margin-top: 3px;
        font-size: 11px;
        color: var(--muted, #758078);
    }

    /* Status pill */
    .booking-status {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 4px 10px;
        border-radius: 999px;
        font-size: 10.5px;
        font-weight: 700;
        letter-spacing: .04em;
        text-transform: uppercase;
        white-space: nowrap;
        flex-shrink: 0;
    }
    .booking-status::before {
        content: "";
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: currentColor;
        opacity: .9;
    }
    .booking-status.pending   { background: rgba(220,164,61,.14); color: #8a6516; }
    .booking-status.confirmed { background: rgba(40,180,133,.14); color: #1c8a64; }
    .booking-status.completed { background: rgba(60,145,105,.14); color: #164734; }
    .booking-status.cancelled { background: rgba(174,93,80,.14);  color: #8b4137; }
    .booking-status.unknown   { background: var(--soft, #edf2ed); color: var(--muted, #758078); }

    /* Card body */
    .booking-card-body {
        display: flex;
        flex-direction: column;
        flex: 1;
        padding: 16px 20px 18px;
    }

    .booking-customer {
        font-family: var(--serif, Georgia, serif);
        font-weight: 400;
        font-size: 20px;
        line-height: 1.25;
        letter-spacing: -.01em;
        color: var(--forest, #164734);
        margin: 0 0 4px;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }
    .booking-phone {
        margin: 0 0 14px;
        color: var(--muted, #758078);
        font-size: 12.5px;
    }

    /* Inner grid */
    .booking-fields {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 14px 16px;
        padding: 14px 16px;
        background: var(--surface-sunken, #fbfcfa);
        border: 1px solid var(--line, #e5e9e3);
        border-radius: 11px;
        margin-bottom: 14px;
    }
    .booking-field { min-width: 0; }
    .booking-field-label {
        display: block;
        font-size: 10px;
        font-weight: 700;
        letter-spacing: .08em;
        text-transform: uppercase;
        color: var(--muted, #758078);
        margin-bottom: 4px;
    }
    .booking-field-value {
        display: block;
        font-size: 13px;
        font-weight: 700;
        color: var(--ink, #1b2922);
        line-height: 1.3;
        overflow-wrap: anywhere;
    }
    .booking-field-value.mono {
        font-family: ui-monospace, 'SF Mono', 'Cascadia Code', monospace;
        color: var(--forest, #164734);
        font-variant-numeric: tabular-nums;
    }
    .booking-field-value.empty {
        color: var(--muted, #758078);
        font-weight: 500;
        font-style: italic;
    }
    .booking-field-sub {
        display: block;
        margin-top: 2px;
        font-size: 11.5px;
        color: var(--muted, #758078);
        line-height: 1.45;
        overflow-wrap: anywhere;
    }

    /* Card foot */
    .booking-card-foot {
        display: flex;
        justify-content: flex-end;
        align-items: center;
        margin-top: auto;
    }
    .booking-card-foot .booking-btn {
        height: 38px;
        padding: 0 14px;
        font-size: 12px;
    }

    /* ---------- Empty ---------- */
    .booking-empty {
        padding: 56px 24px;
        text-align: center;
        background: var(--white, #fff);
        border: 1px solid var(--line, #e5e9e3);
        border-radius: 14px;
    }
    .booking-empty-icon {
        width: 56px;
        height: 56px;
        margin: 0 auto 16px;
        border-radius: 50%;
        background: var(--soft, #edf2ed);
        color: var(--accent, #3c9169);
        display: grid;
        place-items: center;
    }
    .booking-empty-icon svg {
        width: 26px;
        height: 26px;
        stroke: currentColor;
        fill: none;
        stroke-width: 1.7;
        stroke-linecap: round;
        stroke-linejoin: round;
    }
    .booking-empty h3 {
        margin: 0 0 8px;
        font-family: var(--serif, Georgia, serif);
        font-weight: 400;
        font-size: 22px;
        color: var(--forest, #164734);
    }
    .booking-empty p {
        max-width: 430px;
        margin: 0 auto;
        color: var(--muted, #758078);
        font-size: 13px;
        line-height: 1.6;
    }

    /* ---------- Responsive ---------- */
    @@media (max-width: 640px) {
        .booking-toolbar {
            flex-direction: column;
        }
        .booking-toolbar select,
        .booking-toolbar .booking-btn {
            width: 100%;
        }
        .booking-fields {
            grid-template-columns: 1fr;
        }
        .booking-card-foot {
            justify-content: stretch;
        }
        .booking-card-foot .booking-btn {
            width: 100%;
        }
    }

    @@media (prefers-reduced-motion: reduce) {
        .booking-card,
        .booking-btn,
        .booking-search input {
            transition-duration: .001ms !important;
        }
        .booking-card:hover { transform: none; }
        .booking-btn-primary:hover { transform: none; }
    }
</style>

<div class="bookings-page">

    <!-- HEADER -->
    <div class="bookings-header">
        <p class="bookings-eyebrow">Booking management</p>
        <h1>Reservations</h1>
        <p>Review and manage customer reservations.</p>
    </div>

    <!-- STATS -->
    <div class="booking-stats">
        <div class="booking-stat stat-total">
            <span class="booking-stat-label">Total bookings</span>
            <span class="booking-stat-value">@ViewBag.TotalBookings</span>
        </div>
        <div class="booking-stat stat-pending">
            <span class="booking-stat-label">Pending</span>
            <span class="booking-stat-value">@ViewBag.PendingBookings</span>
        </div>
        <div class="booking-stat stat-confirmed">
            <span class="booking-stat-label">Confirmed</span>
            <span class="booking-stat-value">@ViewBag.ConfirmedBookings</span>
        </div>
        <div class="booking-stat stat-completed">
            <span class="booking-stat-label">Completed</span>
            <span class="booking-stat-value">@ViewBag.CompletedBookings</span>
        </div>
        <div class="booking-stat stat-cancelled">
            <span class="booking-stat-label">Cancelled</span>
            <span class="booking-stat-value">@ViewBag.CancelledBookings</span>
        </div>
    </div>

    <!-- TOOLBAR -->
    <form method="get" action="/Admin/Bookings" class="booking-toolbar">
        <div class="booking-search">
            <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
            <input type="search"
                   name="search"
                   value="@searchTerm"
                   placeholder="Search reference, customer, phone..."
                   aria-label="Search bookings" />
        </div>

        <select name="status" aria-label="Filter by status">
            <option value="all"       selected="@(statusFilter == "all"       ? "selected" : null)">All statuses</option>
            <option value="Pending"   selected="@(statusFilter == "Pending"   ? "selected" : null)">Pending</option>
            <option value="Confirmed" selected="@(statusFilter == "Confirmed" ? "selected" : null)">Confirmed</option>
            <option value="Completed" selected="@(statusFilter == "Completed" ? "selected" : null)">Completed</option>
            <option value="Cancelled" selected="@(statusFilter == "Cancelled" ? "selected" : null)">Cancelled</option>
        </select>

        <button class="booking-btn booking-btn-primary" type="submit">Search</button>
        <a class="booking-btn booking-btn-secondary" href="/Admin/Bookings">Clear</a>
    </form>

    <!-- CARDS / EMPTY -->
    @if (Model == null || Model.Count == 0)
    {
        <div class="booking-empty">
            <div class="booking-empty-icon">
                <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="2.5"/><path d="M8 3v4M16 3v4M3 10h18"/></svg>
            </div>
            <h3>No bookings found</h3>
            <p>Try adjusting your search or clear the filters to see all reservations.</p>
        </div>
    }
    else
    {
        <div class="booking-grid">
            @foreach (var booking in Model)
            {
                var statusKey = (booking.Status ?? "unknown").ToLowerInvariant();

                <article class="booking-card">

                    <!-- Head -->
                    <div class="booking-card-head">
                        <div class="booking-id-block">
                            <span class="booking-ref">@booking.ReferenceNumber</span>
                            <span class="booking-submitted">
                                Submitted @booking.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")
                            </span>
                        </div>

                        <span class="booking-status @statusKey">
                            @booking.Status
                        </span>
                    </div>

                    <!-- Body -->
                    <div class="booking-card-body">

                        <h3 class="booking-customer">@booking.CustomerName</h3>
                        <p class="booking-phone">@booking.Phone</p>

                        <div class="booking-fields">

                            <!-- Service -->
                            <div class="booking-field">
                                <span class="booking-field-label">Service</span>
                                <strong class="booking-field-value">@booking.ServiceName</strong>
                                @if (!string.IsNullOrWhiteSpace(booking.ServiceType))
                                {
                                    <span class="booking-field-sub">@booking.ServiceType</span>
                                }
                            </div>

                            <!-- Travel date -->
                            <div class="booking-field">
                                <span class="booking-field-label">Travel date</span>
                                <strong class="booking-field-value">@booking.BookingDate.ToString("dd MMM yyyy")</strong>

                                @if (booking.ServiceType == "Transport")
                                {
                                    if (!string.IsNullOrWhiteSpace(booking.PickupLocation) ||
                                        !string.IsNullOrWhiteSpace(booking.DropoffLocation))
                                    {
                                        <span class="booking-field-sub">
                                            @(booking.PickupLocation ?? "Pickup")
                                            →
                                            @(booking.DropoffLocation ?? "Drop-off")
                                        </span>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(booking.TripType))
                                    {
                                        <span class="booking-field-sub">@booking.TripType</span>
                                    }
                                }
                                else if (booking.ReturnDate.HasValue)
                                {
                                    <span class="booking-field-sub">
                                        Return: @booking.ReturnDate.Value.ToString("dd MMM yyyy")
                                    </span>
                                }
                            </div>

                            <!-- Guests -->
                            <div class="booking-field">
                                <span class="booking-field-label">Guests</span>
                                <strong class="booking-field-value">@booking.Adults adults</strong>
                                @if (booking.Children > 0)
                                {
                                    <span class="booking-field-sub">@booking.Children children</span>
                                }
                                @if (booking.Rooms > 0)
                                {
                                    <span class="booking-field-sub">@booking.Rooms rooms</span>
                                }
                            </div>

                            <!-- Total -->
                            <div class="booking-field">
                                <span class="booking-field-label">Estimated total</span>
                                @if (booking.EstimatedTotalPKR.HasValue)
                                {
                                    <strong class="booking-field-value mono">
                                        PKR @booking.EstimatedTotalPKR.Value.ToString("N0")
                                    </strong>
                                }
                                else
                                {
                                    <span class="booking-field-value empty">Not calculated</span>
                                }
                            </div>

                        </div>

                        <!-- Foot -->
                        <div class="booking-card-foot">
                            <a href="/Admin/BookingDetails/@booking.Id"
                               class="booking-btn booking-btn-secondary">
                                View details →
                            </a>
                        </div>
                    </div>
                </article>
            }
        </div>
    }
</div>