
@model KarnelTravel.ViewModels.AdminPropertyFormViewModel

@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";

    var isEdit = ViewData["PropertyId"] != null;
    var propertyId = ViewData["PropertyId"]?.ToString() ?? "";

    ViewData["Title"] = isEdit ? "Edit Property" : "Add Property";
    ViewData["Section"] = "Stays";

    var formAction = isEdit
        ? $"/Admin/Properties/Edit/{propertyId}"
        : "/Admin/Properties/Create";
}

<style>
    .property-form-page {
        max-width: 1100px;
        margin: 0 auto;
        padding-bottom: 48px;
        color: #202820;
    }

    .property-form-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 24px;
        margin-bottom: 30px;
    }

    .property-form-header h1 {
        margin: 0 0 10px;
        font-size: clamp(28px, 4vw, 38px);
        font-weight: 750;
        letter-spacing: -1.2px;
    }

    .property-form-header p {
        margin: 0;
        color: #778078;
        font-size: 14px;
        line-height: 1.7;
    }

    .back-link {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 11px 15px;
        border: 1px solid #dfe5dc;
        border-radius: 10px;
        color: #354336;
        text-decoration: none;
        font-size: 13px;
        font-weight: 650;
        white-space: nowrap;
        transition: background .2s, border-color .2s;
    }

    .back-link:hover {
        background: #f2f5ef;
        border-color: #b9c7b6;
    }

    .property-form {
        display: flex;
        flex-direction: column;
        gap: 22px;
    }

    .form-card {
        padding: 28px;
        border: 1px solid #e5e9e2;
        border-radius: 16px;
        background: #fff;
        box-shadow: 0 5px 22px rgba(30, 45, 30, .035);
    }

    .form-card-heading {
        display: flex;
        align-items: flex-start;
        gap: 13px;
        margin-bottom: 25px;
        padding-bottom: 20px;
        border-bottom: 1px solid #edf0eb;
    }

    .section-number {
        display: flex;
        flex-shrink: 0;
        align-items: center;
        justify-content: center;
        width: 38px;
        height: 38px;
        border-radius: 11px;
        background: #edf3e9;
        color: #496449;
        font-size: 13px;
        font-weight: 750;
    }

    .form-card-heading h2 {
        margin: 0 0 5px;
        color: #263126;
        font-size: 17px;
        font-weight: 750;
    }

    .form-card-heading p {
        margin: 0;
        color: #879087;
        font-size: 12px;
        line-height: 1.6;
    }

    .form-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 21px;
    }

    .form-field {
        min-width: 0;
    }

    .form-field.full-width {
        grid-column: 1 / -1;
    }

    .form-field label {
        display: block;
        margin-bottom: 9px;
        color: #3b473b;
        font-size: 12px;
        font-weight: 700;
    }

    .form-field label span {
        color: #c45e4c;
    }

    .control {
        display: block;
        width: 100%;
        min-height: 45px;
        padding: 11px 13px;
        border: 1px solid #dfe5dc;
        border-radius: 9px;
        outline: none;
        background: #fff;
        color: #293329;
        font: inherit;
        font-size: 13px;
        box-sizing: border-box;
        transition: border-color .2s, box-shadow .2s;
    }

    .control:focus {
        border-color: #829b7c;
        box-shadow: 0 0 0 3px rgba(112, 143, 104, .12);
    }

    .control::placeholder {
        color: #a0a79f;
    }

    textarea.control {
        min-height: 105px;
        resize: vertical;
        line-height: 1.7;
    }

    .field-error {
        display: block;
        margin-top: 6px;
        color: #c34d43;
        font-size: 11px;
    }

    .validation-summary-errors {
        padding: 14px 17px;
        border: 1px solid #efc9c4;
        border-radius: 10px;
        background: #fff5f3;
        color: #a53d34;
        font-size: 13px;
    }

    .validation-summary-errors ul {
        margin: 8px 0 0;
        padding-left: 20px;
    }

    .validation-summary-valid {
        display: none;
    }

    .form-help {
        margin-top: 7px;
        color: #929a91;
        font-size: 11px;
        line-height: 1.6;
    }

    .image-preview {
        display: none;
        margin-top: 13px;
        overflow: hidden;
        width: 100%;
        max-width: 350px;
        border: 1px solid #e4e9e1;
        border-radius: 12px;
        background: #f4f6f2;
    }

    .image-preview img {
        display: block;
        width: 100%;
        max-height: 220px;
        object-fit: cover;
    }

    .image-preview-caption {
        padding: 9px 12px;
        color: #758074;
        font-size: 11px;
    }

    .option-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 14px;
    }

    .option-card {
        display: flex;
        align-items: flex-start;
        gap: 12px;
        padding: 17px;
        border: 1px solid #e2e8df;
        border-radius: 11px;
        background: #fbfcfa;
        cursor: pointer;
    }

    .option-card input {
        width: 17px;
        height: 17px;
        margin: 2px 0 0;
        accent-color: #557653;
        cursor: pointer;
    }

    .option-card strong {
        display: block;
        margin-bottom: 5px;
        color: #344134;
        font-size: 12px;
    }

    .option-card small {
        display: block;
        color: #879087;
        font-size: 11px;
        line-height: 1.6;
    }

    .form-actions {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 15px;
        padding: 20px 0 0;
    }

    .form-actions-note {
        color: #879087;
        font-size: 12px;
        line-height: 1.6;
    }

    .action-buttons {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .btn-cancel,
    .btn-save {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        min-height: 45px;
        padding: 0 20px;
        border-radius: 10px;
        font: inherit;
        font-size: 13px;
        font-weight: 700;
        text-decoration: none;
        cursor: pointer;
        transition: transform .2s, background .2s;
    }

    .btn-cancel {
        border: 1px solid #dfe5dc;
        background: #fff;
        color: #526052;
    }

    .btn-cancel:hover {
        background: #f3f5f1;
    }

    .btn-save {
        border: 1px solid #354d35;
        background: #354d35;
        color: #fff;
    }

    .btn-save:hover {
        background: #263b27;
        transform: translateY(-1px);
    }

    .btn-save:disabled {
        opacity: .65;
        cursor: not-allowed;
        transform: none;
    }

    .category-note {
        margin-top: 9px;
        color: #7c8779;
        font-size: 11px;
        line-height: 1.6;
    }

    @@media (max-width: 700px) {
        .property-form-page {
            padding: 0 0 30px;
        }

        .property-form-header {
            flex-direction: column;
            gap: 15px;
        }

        .form-card {
            padding: 20px;
        }

        .form-grid,
        .option-grid {
            grid-template-columns: 1fr;
        }

        .form-field.full-width {
            grid-column: auto;
        }

        .form-actions {
            align-items: stretch;
            flex-direction: column;
        }

        .action-buttons {
            width: 100%;
        }

        .btn-cancel,
        .btn-save {
            flex: 1;
        }
    }
</style>

<div class="property-form-page">
    <div class="property-form-header">
        <div>
            <h1>@(isEdit ? "Edit Property" : "Add a Property")</h1>
            <p>
                @(isEdit
                    ? "Update the property information and save your changes."
                    : "Add a hotel, restaurant, or resort to your travel directory.")
            </p>
        </div>

        <a href="/Admin/Properties" class="back-link">
            <span aria-hidden="true">←</span>
            Back to Properties
        </a>
    </div>

    <form method="post" action="@formAction" id="propertyForm" class="property-form">
        @Html.AntiForgeryToken()

        <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>

        @if (isEdit)
        {
            <input type="hidden" name="Id" value="@propertyId" />
        }

        <!-- SECTION 1: BASIC INFORMATION -->
        <section class="form-card">
            <div class="form-card-heading">
                <div class="section-number">01</div>
                <div>
                    <h2>Basic Information</h2>
                    <p>Enter the property's name, type, and location.</p>
                </div>
            </div>

            <div class="form-grid">
                <div class="form-field">
                    <label asp-for="Name">Property Name <span>*</span></label>
                    <input asp-for="Name"
                           class="control"
                           placeholder="e.g. Mountain View Resort" />
                    <span asp-validation-for="Name" class="field-error"></span>
                </div>

                <div class="form-field">
                    <label asp-for="Category">Property Type <span>*</span></label>
                    <select asp-for="Category" id="Category" class="control">
                        <option value="Hotel">Hotel</option>
                        <option value="Restaurant">Restaurant</option>
                        <option value="Resort">Resort</option>
                    </select>
                    <span asp-validation-for="Category" class="field-error"></span>
                    <div class="category-note">
                        Choose the type that matches this listing.
                    </div>
                </div>

                <div class="form-field">
                    <label asp-for="Location">Location <span>*</span></label>
                    <input asp-for="Location"
                           class="control"
                           placeholder="e.g. Hunza, Gilgit-Baltistan" />
                    <span asp-validation-for="Location" class="field-error"></span>
                </div>

                <div class="form-field">
                    <label asp-for="DestinationId">Destination ID</label>
                    <input asp-for="DestinationId"
                           type="number"
                           min="1"
                           class="control"
                           placeholder="Optional destination ID" />
                    <span asp-validation-for="DestinationId" class="field-error"></span>
                    <div class="form-help">
                        Enter an existing destination ID if this property belongs to a destination.
                    </div>
                </div>

                <div class="form-field">
                    <label asp-for="ContactPhone">Contact Phone</label>
                    <input asp-for="ContactPhone"
                           class="control"
                           placeholder="e.g. +92 300 1234567" />
                    <span asp-validation-for="ContactPhone" class="field-error"></span>
                </div>

                <div class="form-field">
                    <label asp-for="Price">Price (PKR) <span>*</span></label>
                    <input asp-for="Price"
                           type="number"
                           min="0"
                           step="0.01"
                           class="control"
                           placeholder="e.g. 5000" />
                    <span asp-validation-for="Price" class="field-error"></span>
                    <div class="form-help">
                        Enter the starting price used for this listing.
                    </div>
                </div>

                <div class="form-field full-width">
                    <label asp-for="Address">Full Address</label>
                    <textarea asp-for="Address"
                              class="control"
                              placeholder="Enter the complete property address"></textarea>
                    <span asp-validation-for="Address" class="field-error"></span>
                </div>
            </div>
        </section>

        <!-- SECTION 2: DESCRIPTION -->
        <section class="form-card">
            <div class="form-card-heading">
                <div class="section-number">02</div>
                <div>
                    <h2>About This Property</h2>
                    <p>Write the short introduction and full description visitors will see.</p>
                </div>
            </div>

            <div class="form-grid">
                <div class="form-field full-width">
                    <label asp-for="ShortDescription">Short Description</label>
                    <textarea asp-for="ShortDescription"
                              class="control"
                              placeholder="A brief introduction displayed in property listings..."
                              maxlength="500"></textarea>
                    <span asp-validation-for="ShortDescription" class="field-error"></span>
                    <div class="form-help">
                        Keep this concise so visitors can understand the property at a glance.
                    </div>
                </div>

                <div class="form-field full-width">
                    <label asp-for="Description">Full Description</label>
                    <textarea asp-for="Description"
                              class="control"
                              style="min-height: 160px;"
                              placeholder="Describe the facilities, services, atmosphere, and other important details..."></textarea>
                    <span asp-validation-for="Description" class="field-error"></span>
                </div>
            </div>
        </section>

        <!-- SECTION 3: CATEGORY DETAILS -->
        <section class="form-card">
            <div class="form-card-heading">
                <div class="section-number">03</div>
                <div>
                    <h2>Property Details</h2>
                    <p>These fields change depending on the selected property type.</p>
                </div>
            </div>

            <div class="form-grid">
                <div class="form-field" id="starRatingField">
                    <label asp-for="StarRating">Star Rating</label>
                    <select asp-for="StarRating" class="control" id="StarRating">
                        <option value="">Not specified</option>
                        <option value="1">1 Star</option>
                        <option value="2">2 Stars</option>
                        <option value="3">3 Stars</option>
                        <option value="4">4 Stars</option>
                        <option value="5">5 Stars</option>
                    </select>
                    <span asp-validation-for="StarRating" class="field-error"></span>
                </div>

                <div class="form-field" id="cuisineTypeField">
                    <label asp-for="CuisineType">Cuisine Type <span id="cuisineRequired">*</span></label>
                    <input asp-for="CuisineType"
                           class="control"
                           id="CuisineType"
                           placeholder="e.g. Pakistani, Chinese, BBQ" />
                    <span asp-validation-for="CuisineType" class="field-error"></span>
                </div>
            </div>

            <div class="form-help" id="categoryHelp">
                Select a property type to see the relevant fields.
            </div>
        </section>

        <!-- SECTION 4: IMAGE -->
        <section class="form-card">
            <div class="form-card-heading">
                <div class="section-number">04</div>
                <div>
                    <h2>Property Image</h2>
                    <p>Add a publicly accessible image URL for the listing.</p>
                </div>
            </div>

            <div class="form-grid">
                <div class="form-field full-width">
                    <label asp-for="ImageUrl">Image URL</label>
                    <input asp-for="ImageUrl"
                           id="ImageUrl"
                           class="control"
                           type="url"
                           placeholder="https://example.com/property-image.jpg" />
                    <span asp-validation-for="ImageUrl" class="field-error"></span>

                    <div class="form-help">
                        Use a direct image URL that can be accessed by website visitors.
                    </div>

                    <div class="image-preview" id="imagePreview">
                        <img id="previewImage" src="" alt="Property image preview" />
                        <div class="image-preview-caption">Image preview</div>
                    </div>
                </div>
            </div>
        </section>

        <!-- SECTION 5: DISPLAY SETTINGS -->
        <section class="form-card">
            <div class="form-card-heading">
                <div class="section-number">05</div>
                <div>
                    <h2>Publishing & Display</h2>
                    <p>Control visibility and how this property is presented.</p>
                </div>
            </div>

            <div class="form-grid">
                <div class="form-field">
                    <label asp-for="DisplayOrder">Display Order</label>
                    <input asp-for="DisplayOrder"
                           type="number"
                           min="0"
                           class="control"
                           placeholder="0" />
                    <span asp-validation-for="DisplayOrder" class="field-error"></span>
                    <div class="form-help">
                        Use smaller numbers for properties you want to show earlier.
                    </div>
                </div>
            </div>

            <div class="option-grid" style="margin-top: 22px;">
                <label class="option-card">
                    <input asp-for="IsPublished" type="checkbox" />
                    <span>
                        <strong>Publish this property</strong>
                        <small>Allow this property to appear publicly wherever published listings are displayed.</small>
                    </span>
                </label>

                <label class="option-card">
                    <input asp-for="IsFeatured" type="checkbox" />
                    <span>
                        <strong>Feature this property</strong>
                        <small>Mark this property as featured for use in supported featured sections.</small>
                    </span>
                </label>
            </div>
        </section>

        <!-- FORM ACTIONS -->
        <div class="form-actions">
            <div class="form-actions-note">
                <span>*</span> Required fields must be completed before saving.
            </div>

            <div class="action-buttons">
                <a href="/Admin/Properties" class="btn-cancel">Cancel</a>

                <button type="submit" class="btn-save" id="saveButton">
                    @(isEdit ? "Save Changes" : "Save Property")
                    <span aria-hidden="true">→</span>
                </button>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        (function () {
            "use strict";

            const categorySelect = document.getElementById("Category");
            const starRatingField = document.getElementById("starRatingField");
            const cuisineTypeField = document.getElementById("cuisineTypeField");
            const cuisineTypeInput = document.getElementById("CuisineType");
            const cuisineRequired = document.getElementById("cuisineRequired");
            const categoryHelp = document.getElementById("categoryHelp");

            const imageUrlInput = document.getElementById("ImageUrl");
            const imagePreview = document.getElementById("imagePreview");
            const previewImage = document.getElementById("previewImage");

            const propertyForm = document.getElementById("propertyForm");
            const saveButton = document.getElementById("saveButton");

            function updateCategoryFields() {
                if (!categorySelect) return;

                const category = categorySelect.value;

                const isHotel = category === "Hotel";
                const isRestaurant = category === "Restaurant";
                const isResort = category === "Resort";

                starRatingField.style.display = isHotel ? "" : "none";
                cuisineTypeField.style.display = isRestaurant ? "" : "none";

                if (cuisineTypeInput) {
                    cuisineTypeInput.required = isRestaurant;
                }

                if (cuisineRequired) {
                    cuisineRequired.style.display = isRestaurant ? "" : "none";
                }

                if (categoryHelp) {
                    if (isHotel) {
                        categoryHelp.textContent =
                            "For hotels, provide a star rating when available.";
                    } else if (isRestaurant) {
                        categoryHelp.textContent =
                            "For restaurants, enter the cuisine type. This field is required.";
                    } else if (isResort) {
                        categoryHelp.textContent =
                            "For resorts, use the general description and starting price to describe the experience.";
                    } else {
                        categoryHelp.textContent =
                            "Select a property type to see the relevant fields.";
                    }
                }
            }

            function updateImagePreview() {
                if (!imageUrlInput || !imagePreview || !previewImage) return;

                const url = imageUrlInput.value.trim();

                if (!url) {
                    imagePreview.style.display = "none";
                    previewImage.removeAttribute("src");
                    return;
                }

                try {
                    const parsedUrl = new URL(url);

                    if (parsedUrl.protocol !== "http:" &&
                        parsedUrl.protocol !== "https:") {
                        throw new Error("Unsupported image URL protocol.");
                    }

                    previewImage.onload = function () {
                        imagePreview.style.display = "block";
                    };

                    previewImage.onerror = function () {
                        imagePreview.style.display = "none";
                    };

                    previewImage.src = parsedUrl.href;
                } catch {
                    imagePreview.style.display = "none";
                }
            }

            if (categorySelect) {
                categorySelect.addEventListener("change", updateCategoryFields);
                updateCategoryFields();
            }

            if (imageUrlInput) {
                imageUrlInput.addEventListener("input", updateImagePreview);
                updateImagePreview();
            }

            if (propertyForm && saveButton) {
                propertyForm.addEventListener("submit", function () {
                    if (propertyForm.checkValidity()) {
                        saveButton.disabled = true;
                        saveButton.innerHTML = "Saving...";

                        // Re-enable if the browser prevents navigation.
                        window.setTimeout(function () {
                            saveButton.disabled = false;
                            saveButton.innerHTML =
                                '@(isEdit ? "Save Changes" : "Save Property") <span aria-hidden="true">→</span>';
                        }, 10000);
                    }
                });
            }
        })();
    </script>
}
