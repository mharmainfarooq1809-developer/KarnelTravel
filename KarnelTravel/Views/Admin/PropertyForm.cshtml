@model KarnelTravel.ViewModels.AdminPropertyFormViewModel

@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";

    var isEdit = ViewData["PropertyId"] != null;
    var propertyId = ViewData["PropertyId"]?.ToString() ?? "";

    ViewData["Title"] = isEdit ? "Edit Property" : "Add Property";
    ViewData["Section"] = "Stays";

    var formAction = isEdit
        ? $"/Admin/Properties/Edit/{propertyId}"
        : "/Admin/Properties/Create";
}

<style>
  

    .property-form-page {
        max-width: 1100px;
        margin: 0 auto;
        padding-bottom: 48px;
        color: var(--ink, #1b2922);
    }

    /* ---------- Header ---------- */
    .property-form-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        gap: 24px;
        margin-bottom: 30px;
    }
    .property-form-header h1 {
        font-family: var(--serif, Georgia, serif);
        font-weight: 400;
        color: var(--forest, #164734);
        font-size: clamp(28px, 4vw, 40px);
        letter-spacing: -.02em;
        line-height: 1.1;
        margin: 0 0 10px;
    }
    .property-form-header p {
        margin: 0;
        color: var(--muted, #758078);
        font-size: 13.5px;
        line-height: 1.7;
        max-width: 62ch;
    }

    .back-link {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 10px 15px;
        border: 1px solid var(--line, #e5e9e3);
        border-radius: 10px;
        color: var(--forest, #164734);
        background: var(--white, #fff);
        text-decoration: none;
        font-size: 13px;
        font-weight: 600;
        white-space: nowrap;
        transition: background .18s ease, border-color .18s ease;
    }
    .back-link:hover {
        background: var(--soft, #edf2ed);
        border-color: var(--line-hi, #d6dcd4);
        color: var(--forest, #164734);
    }

    /* ---------- Form layout ---------- */
    .property-form {
        display: flex;
        flex-direction: column;
        gap: 22px;
    }

    .form-card {
        padding: 28px;
        border: 1px solid var(--line, #e5e9e3);
        border-radius: 16px;
        background: var(--white, #fff);
        box-shadow: 0 2px 6px -2px rgba(22,71,52,.06);
        contain: layout;
        transition: border-color .18s ease;
    }
    .form-card:hover { border-color: var(--line-hi, #d6dcd4); }

    /* ---------- Section heading ---------- */
    .form-card-heading {
        display: flex;
        align-items: flex-start;
        gap: 13px;
        margin-bottom: 24px;
        padding-bottom: 18px;
        border-bottom: 1px solid var(--line, #e5e9e3);
    }
    .section-number {
        display: flex;
        flex-shrink: 0;
        align-items: center;
        justify-content: center;
        width: 38px;
        height: 38px;
        border-radius: 11px;
        background: var(--soft, #edf2ed);
        color: var(--forest, #164734);
        font-size: 12.5px;
        font-weight: 700;
        font-variant-numeric: tabular-nums;
        letter-spacing: -.02em;
    }
    .form-card-heading h2 {
        font-family: var(--serif, Georgia, serif);
        font-weight: 400;
        color: var(--forest, #164734);
        font-size: 20px;
        letter-spacing: -.01em;
        margin: 0 0 4px;
        line-height: 1.25;
    }
    .form-card-heading p {
        margin: 0;
        color: var(--muted, #758078);
        font-size: 12.5px;
        line-height: 1.55;
    }

    /* ---------- Fields ---------- */
    .form-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 20px;
    }
    .form-field { min-width: 0; }
    .form-field.full-width { grid-column: 1 / -1; }

    .form-field label {
        display: block;
        margin-bottom: 8px;
        color: var(--ink, #1b2922);
        font-size: 12px;
        font-weight: 700;
        letter-spacing: .01em;
    }
    .form-field label span {
        color: #ae5d50;
        font-weight: 700;
    }

    /* ---------- Inputs ---------- */
    .control {
        display: block;
        width: 100%;
        min-height: 44px;
        padding: 11px 14px;
        border: 1px solid var(--line, #e5e9e3);
        border-radius: 10px;
        outline: none;
        background: var(--white, #fff);
        color: var(--ink, #1b2922);
        font: inherit;
        font-size: 13.5px;
        box-sizing: border-box;
        transition: border-color .14s ease, box-shadow .14s ease;
    }
    .control:hover { border-color: var(--line-hi, #d6dcd4); }
    .control:focus {
        border-color: var(--accent, #3c9169);
        box-shadow: 0 0 0 3px rgba(60,145,105,.20);
    }
    .control::placeholder { color: var(--muted, #758078); }

    textarea.control {
        min-height: 105px;
        resize: vertical;
        line-height: 1.7;
        font-family: inherit;
    }

    select.control {
        appearance: none;
        -webkit-appearance: none;
        padding-right: 34px;
        background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%23758078' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><polyline points='6 9 12 15 18 9'/></svg>");
        background-repeat: no-repeat;
        background-position: right 12px center;
        background-size: 14px;
        cursor: pointer;
    }

    /* ---------- Validation ---------- */
    .field-error {
        display: block;
        margin-top: 6px;
        color: #ae5d50;
        font-size: 11.5px;
        font-weight: 500;
    }

    .validation-summary-errors {
        padding: 13px 16px;
        border: 1px solid rgba(174,93,80,.22);
        border-radius: 10px;
        background: rgba(174,93,80,.08);
        color: #8b4137;
        font-size: 13px;
        line-height: 1.5;
    }
    .validation-summary-errors ul {
        margin: 8px 0 0;
        padding-left: 20px;
    }
    .validation-summary-errors li { margin: 2px 0; }
    .validation-summary-valid { display: none; }

    /* ---------- Help text ---------- */
    .form-help {
        margin-top: 7px;
        color: var(--muted, #758078);
        font-size: 11.5px;
        line-height: 1.55;
    }
    .category-note {
        margin-top: 8px;
        color: var(--muted, #758078);
        font-size: 11.5px;
        line-height: 1.55;
    }

    /* ---------- Image preview ---------- */
    .image-preview {
        display: none;
        margin-top: 13px;
        overflow: hidden;
        width: 100%;
        max-width: 350px;
        border: 1px solid var(--line, #e5e9e3);
        border-radius: 12px;
        background: var(--surface-sunken, #fbfcfa);
    }
    .image-preview img {
        display: block;
        width: 100%;
        max-height: 220px;
        object-fit: cover;
    }
    .image-preview-caption {
        padding: 9px 12px;
        color: var(--muted, #758078);
        font-size: 11px;
        border-top: 1px solid var(--line, #e5e9e3);
    }

    /* ---------- Option cards (checkboxes) ---------- */
    .option-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 14px;
    }
    .option-card {
        display: flex;
        align-items: flex-start;
        gap: 12px;
        padding: 16px 18px;
        border: 1px solid var(--line, #e5e9e3);
        border-radius: 11px;
        background: var(--surface-sunken, #fbfcfa);
        cursor: pointer;
        transition: border-color .14s ease, background .14s ease;
    }
    .option-card:hover {
        border-color: var(--line-hi, #d6dcd4);
        background: var(--white, #fff);
    }
    .option-card:has(input:checked) {
        border-color: var(--accent, #3c9169);
        background: rgba(60,145,105,.05);
    }
    .option-card input[type="checkbox"] {
        width: 18px;
        height: 18px;
        margin: 2px 0 0;
        accent-color: var(--accent, #3c9169);
        cursor: pointer;
        flex-shrink: 0;
    }
    .option-card input[type="checkbox"]:focus-visible {
        outline: 2px solid var(--accent, #3c9169);
        outline-offset: 2px;
    }
    .option-card strong {
        display: block;
        margin-bottom: 4px;
        color: var(--ink, #1b2922);
        font-size: 13px;
        font-weight: 700;
    }
    .option-card small {
        display: block;
        color: var(--muted, #758078);
        font-size: 11.5px;
        line-height: 1.55;
    }

    /* ---------- Form actions ---------- */
    .form-actions {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 15px;
        padding: 8px 0 0;
    }
    .form-actions-note {
        color: var(--muted, #758078);
        font-size: 12px;
        line-height: 1.55;
    }
    .form-actions-note span {
        color: #ae5d50;
        font-weight: 700;
    }

    .action-buttons {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .btn-cancel,
    .btn-save {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 9px;
        min-height: 44px;
        padding: 0 20px;
        border-radius: 10px;
        font: inherit;
        font-size: 13px;
        font-weight: 700;
        text-decoration: none;
        cursor: pointer;
        transition: background .14s ease, border-color .14s ease, color .14s ease, box-shadow .14s ease, transform .14s ease;
    }
    .btn-cancel {
        border: 1px solid var(--line, #e5e9e3);
        background: var(--white, #fff);
        color: var(--ink, #1b2922);
    }
    .btn-cancel:hover {
        background: var(--soft, #edf2ed);
        border-color: var(--line-hi, #d6dcd4);
        color: var(--forest, #164734);
    }
    .btn-save {
        border: 1px solid var(--forest, #164734);
        background: var(--forest, #164734);
        color: #fff;
        box-shadow: 0 2px 10px -4px rgba(22,71,52,.4);
    }
    .btn-save:hover {
        background: var(--green, #236b4d);
        border-color: var(--green, #236b4d);
        box-shadow: 0 6px 20px -8px rgba(22,71,52,.5);
        transform: translateY(-1px);
    }
    .btn-save:active { transform: translateY(0); }
    .btn-save:disabled {
        opacity: .65;
        cursor: not-allowed;
        transform: none;
        box-shadow: none;
    }

    /* ---------- Responsive (escaped @@media) ---------- */
    @@media (max-width: 700px) {
        .property-form-page { padding: 0 0 30px; }

        .property-form-header {
            flex-direction: column;
            align-items: flex-start;
            gap: 15px;
        }
        .back-link { width: auto; }

        .form-card { padding: 20px; }
        .form-grid,
        .option-grid { grid-template-columns: 1fr; }
        .form-field.full-width { grid-column: auto; }

        .form-actions {
            align-items: stretch;
            flex-direction: column;
        }
        .action-buttons { width: 100%; }
        .btn-cancel,
        .btn-save { flex: 1; }
    }

    /* ---------- Reduced motion ---------- */
    @@media (prefers-reduced-motion: reduce) {
        .form-card,
        .option-card,
        .control,
        .btn-cancel,
        .btn-save,
        .back-link {
            transition-duration: .001ms !important;
        }
        .btn-save:hover { transform: none; }
    }
</style>

<div class="property-form-page">
    <div class="property-form-header">
        <div>
            <h1>@(isEdit ? "Edit Property" : "Add a Property")</h1>
            <p>
                @(isEdit
                    ? "Update the property information and save your changes."
                    : "Add a hotel, restaurant, or resort to your travel directory.")
            </p>
        </div>

        <a href="/Admin/Properties" class="back-link">
            <span aria-hidden="true">←</span>
            Back to Properties
        </a>
    </div>

    <form method="post" action="@formAction" id="propertyForm" class="property-form" enctype="multipart/form-data">
        @Html.AntiForgeryToken()

        <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>

        @if (isEdit)
        {
            <input type="hidden" name="Id" value="@propertyId" />
        }

        <!-- SECTION 1: BASIC INFORMATION -->
        <section class="form-card">
            <div class="form-card-heading">
                <div class="section-number">01</div>
                <div>
                    <h2>Basic Information</h2>
                    <p>Enter the property's name, type, and location.</p>
                </div>
            </div>

            <div class="form-grid">
                <div class="form-field">
                    <label asp-for="Name">Property Name <span>*</span></label>
                    <input asp-for="Name"
                           class="control"
                           placeholder="e.g. Mountain View Resort" />
                    <span asp-validation-for="Name" class="field-error"></span>
                </div>

                <div class="form-field">
                    <label asp-for="Category">Property Type <span>*</span></label>
                    <select asp-for="Category" id="Category" class="control">
                        <option value="Hotel">Hotel</option>
                        <option value="Restaurant">Restaurant</option>
                        <option value="Resort">Resort</option>
                    </select>
                    <span asp-validation-for="Category" class="field-error"></span>
                    <div class="category-note">
                        Choose the type that matches this listing.
                    </div>
                </div>

                <div class="form-field">
                    <label asp-for="Location">Location <span>*</span></label>
                    <input asp-for="Location"
                           class="control"
                           placeholder="e.g. Hunza, Gilgit-Baltistan" />
                    <span asp-validation-for="Location" class="field-error"></span>
                </div>

                <div class="form-field">
                    <label asp-for="DestinationId">Destination ID <span>*</span></label>
                    <input asp-for="DestinationId"
                           type="number"
                           min="1"
                           step="1"
                           class="control"
                           placeholder="e.g. 1" />
                    <span asp-validation-for="DestinationId" class="field-error"></span>
                    <div class="form-help">
                        Enter the ID of an existing destination.
                    </div>
                </div>

                <div class="form-field">
                    <label asp-for="ContactPhone">Contact Phone</label>
                    <input asp-for="ContactPhone"
                           class="control"
                           placeholder="e.g. +92 300 1234567" />
                    <span asp-validation-for="ContactPhone" class="field-error"></span>
                </div>

                <div class="form-field">
                    <label asp-for="Price">Price (PKR) <span>*</span></label>
                    <input asp-for="Price"
                           type="number"
                           min="0"
                           step="0.01"
                           class="control"
                           placeholder="e.g. 5000" />
                    <span asp-validation-for="Price" class="field-error"></span>
                    <div class="form-help">
                        Enter the starting price used for this listing.
                    </div>
                </div>

                <div class="form-field full-width">
                    <label asp-for="Address">Full Address</label>
                    <textarea asp-for="Address"
                              class="control"
                              placeholder="Enter the complete property address"></textarea>
                    <span asp-validation-for="Address" class="field-error"></span>
                </div>
            </div>
        </section>

        <!-- SECTION 2: DESCRIPTION -->
        <section class="form-card">
            <div class="form-card-heading">
                <div class="section-number">02</div>
                <div>
                    <h2>About This Property</h2>
                    <p>Write the short introduction and full description visitors will see.</p>
                </div>
            </div>

            <div class="form-grid">
                <div class="form-field full-width">
                    <label asp-for="ShortDescription">Short Description</label>
                    <textarea asp-for="ShortDescription"
                              class="control"
                              placeholder="A brief introduction displayed in property listings..."
                              maxlength="500"></textarea>
                    <span asp-validation-for="ShortDescription" class="field-error"></span>
                    <div class="form-help">
                        Keep this concise so visitors can understand the property at a glance.
                    </div>
                </div>

                <div class="form-field full-width">
                    <label asp-for="Description">Full Description</label>
                    <textarea asp-for="Description"
                              class="control"
                              style="min-height: 160px;"
                              placeholder="Describe the facilities, services, atmosphere, and other important details..."></textarea>
                    <span asp-validation-for="Description" class="field-error"></span>
                </div>
            </div>
        </section>

        <!-- SECTION 3: CATEGORY DETAILS -->
        <section class="form-card">
            <div class="form-card-heading">
                <div class="section-number">03</div>
                <div>
                    <h2>Property Details</h2>
                    <p>These fields change depending on the selected property type.</p>
                </div>
            </div>

            <div class="form-grid">
                <div class="form-field" id="starRatingField">
                    <label asp-for="StarRating">Star Rating</label>
                    <select asp-for="StarRating" class="control" id="StarRating">
                        <option value="">Not specified</option>
                        <option value="1">1 Star</option>
                        <option value="2">2 Stars</option>
                        <option value="3">3 Stars</option>
                        <option value="4">4 Stars</option>
                        <option value="5">5 Stars</option>
                    </select>
                    <span asp-validation-for="StarRating" class="field-error"></span>
                </div>

                <div class="form-field" id="cuisineTypeField">
                    <label asp-for="CuisineType">Cuisine Type <span id="cuisineRequired">*</span></label>
                    <input asp-for="CuisineType"
                           class="control"
                           id="CuisineType"
                           placeholder="e.g. Pakistani, Chinese, BBQ" />
                    <span asp-validation-for="CuisineType" class="field-error"></span>
                </div>
            </div>

            <div class="form-help" id="categoryHelp">
                Select a property type to see the relevant fields.
            </div>
        </section>

        <!-- SECTION 4: IMAGE -->
        <section class="form-card">
            <div class="form-card-heading">
                <div class="section-number">04</div>
                <div>
                    <h2>Property Image</h2>
                    <p>Upload an image from your computer or provide a public image URL.</p>
                </div>
            </div>

            <div class="form-grid">
                <div class="form-field full-width">
                    <label asp-for="ImageFile">Upload image</label>
                    <input asp-for="ImageFile"
                           id="ImageFile"
                           class="control"
                           type="file"
                           accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp" />
                    <span asp-validation-for="ImageFile" class="field-error"></span>
                    <div class="form-help">JPG, PNG, or WebP. Maximum size: 5 MB.</div>

                    <label asp-for="ImageUrl">Or image URL</label>
                    <input asp-for="ImageUrl"
                           id="ImageUrl"
                           class="control"
                           type="url"
                           placeholder="https://example.com/property-image.jpg" />
                    <span asp-validation-for="ImageUrl" class="field-error"></span>

                    <div class="form-help">
                         A newly uploaded file takes priority over the URL. Existing images are retained when editing unless replaced.
                    </div>

                    <div class="image-preview" id="imagePreview">
                        <img id="previewImage"
                             src=""
                             alt="Property image preview"
                             decoding="async" />
                        <div class="image-preview-caption">Image preview</div>
                    </div>
                </div>
            </div>
        </section>

        <!-- SECTION 5: DISPLAY SETTINGS -->
        <section class="form-card">
            <div class="form-card-heading">
                <div class="section-number">05</div>
                <div>
                    <h2>Publishing &amp; Display</h2>
                    <p>Control visibility and how this property is presented.</p>
                </div>
            </div>

            <div class="form-grid">
                <div class="form-field">
                    <label asp-for="DisplayOrder">Display Order</label>
                    <input asp-for="DisplayOrder"
                           type="number"
                           min="0"
                           class="control"
                           placeholder="0" />
                    <span asp-validation-for="DisplayOrder" class="field-error"></span>
                    <div class="form-help">
                        Use smaller numbers for properties you want to show earlier.
                    </div>
                </div>
            </div>

            <div class="option-grid" style="margin-top: 22px;">
                <label class="option-card">
                    <input asp-for="IsPublished" type="checkbox" />
                    <span>
                        <strong>Publish this property</strong>
                        <small>Allow this property to appear publicly wherever published listings are displayed.</small>
                    </span>
                </label>

                <label class="option-card">
                    <input asp-for="IsFeatured" type="checkbox" />
                    <span>
                        <strong>Feature this property</strong>
                        <small>Mark this property as featured for use in supported featured sections.</small>
                    </span>
                </label>
            </div>
        </section>

        <!-- FORM ACTIONS -->
        <div class="form-actions">
            <div class="form-actions-note">
                <span>*</span> Required fields must be completed before saving.
            </div>

            <div class="action-buttons">
                <a href="/Admin/Properties" class="btn-cancel">Cancel</a>

                <button type="submit" class="btn-save" id="saveButton">
                    @(isEdit ? "Save Changes" : "Save Property")
                    <span aria-hidden="true">→</span>
                </button>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        (function () {
            "use strict";

            const categorySelect = document.getElementById("Category");
            const starRatingField = document.getElementById("starRatingField");
            const cuisineTypeField = document.getElementById("cuisineTypeField");
            const cuisineTypeInput = document.getElementById("CuisineType");
            const cuisineRequired = document.getElementById("cuisineRequired");
            const categoryHelp = document.getElementById("categoryHelp");

            const imageUrlInput = document.getElementById("ImageUrl");
            const imagePreview = document.getElementById("imagePreview");
            const previewImage = document.getElementById("previewImage");

            const propertyForm = document.getElementById("propertyForm");
            const saveButton = document.getElementById("saveButton");
            const destinationIdInput = document.getElementById("DestinationId");
            const destinationIds = new Set(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(
                ((IEnumerable<KarnelTravel.Models.Destination>)(ViewBag.Destinations ?? Enumerable.Empty<KarnelTravel.Models.Destination>()))
                    .Select(x => x.Id))));

            function updateCategoryFields() {
                if (!categorySelect) return;

                const category = categorySelect.value;

                const isHotel = category === "Hotel";
                const isRestaurant = category === "Restaurant";
                const isResort = category === "Resort";

                starRatingField.style.display = isHotel ? "" : "none";
                cuisineTypeField.style.display = isRestaurant ? "" : "none";

                if (cuisineTypeInput) {
                    cuisineTypeInput.required = isRestaurant;
                }

                if (cuisineRequired) {
                    cuisineRequired.style.display = isRestaurant ? "" : "none";
                }

                if (categoryHelp) {
                    if (isHotel) {
                        categoryHelp.textContent =
                            "For hotels, provide a star rating when available.";
                    } else if (isRestaurant) {
                        categoryHelp.textContent =
                            "For restaurants, enter the cuisine type. This field is required.";
                    } else if (isResort) {
                        categoryHelp.textContent =
                            "For resorts, use the general description and starting price to describe the experience.";
                    } else {
                        categoryHelp.textContent =
                            "Select a property type to see the relevant fields.";
                    }
                }
            }

            function updateImagePreview() {
                if (!imageUrlInput || !imagePreview || !previewImage) return;

                const url = imageUrlInput.value.trim();

                if (!url) {
                    imagePreview.style.display = "none";
                    previewImage.removeAttribute("src");
                    return;
                }

                try {
                    const parsedUrl = new URL(url);

                    if (parsedUrl.protocol !== "http:" &&
                        parsedUrl.protocol !== "https:") {
                        throw new Error("Unsupported image URL protocol.");
                    }

                    previewImage.onload = function () {
                        imagePreview.style.display = "block";
                    };

                    previewImage.onerror = function () {
                        imagePreview.style.display = "none";
                    };

                    previewImage.src = parsedUrl.href;
                } catch {
                    imagePreview.style.display = "none";
                }
            }

            if (categorySelect) {
                categorySelect.addEventListener("change", updateCategoryFields);
                updateCategoryFields();
            }

            if (imageUrlInput) {
                imageUrlInput.addEventListener("input", updateImagePreview);
                updateImagePreview();
            }

            if (propertyForm && saveButton) {
                propertyForm.addEventListener("submit", function (event) {
                    const destinationId = Number(destinationIdInput?.value);
                    if (!Number.isInteger(destinationId) || !destinationIds.has(destinationId)) {
                        event.preventDefault();
                        alert("There is no destination with ID " + (destinationIdInput?.value || "entered") + ". Enter a valid destination ID.");
                        destinationIdInput?.focus();
                        return;
                    }

                    if (propertyForm.checkValidity()) {
                        saveButton.disabled = true;
                        saveButton.innerHTML = "Saving...";

                        // Re-enable if the browser prevents navigation.
                        window.setTimeout(function () {
                            saveButton.disabled = false;
                            saveButton.innerHTML =
                                '@(isEdit ? "Save Changes" : "Save Property") <span aria-hidden="true">→</span>';
                        }, 10000);
                    }
                });
            }
        })();
    </script>
}