            <div class="bar" style="height:66%" data-value="55 bookings"><span>Sep 15</span></div>
            <div class="bar" style="height:59%" data-value="49 bookings"><span>Sep 22</span></div>
            <div class="bar" style="height:78%" data-value="65 bookings"><span>Sep 29</span></div>
            <div class="bar" style="height:71%" data-value="59 bookings"><span>Oct 6</span></div>
            <div class="bar" style="height:90%" data-value="75 bookings"><span>Oct 13</span></div>
