@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Overview";
}

<style>
    /* ============================================================
       Dashboard refinements — scoped to this view only.
       Complements the shared wwwroot/css/admin.css without
       overriding it. Class names match the shared stylesheet.
       ============================================================ */

    /* Utility: muted body text (not defined in admin.css) */
    .muted {
        color: var(--muted, #758078);
        font-size: 13px;
        line-height: 1.55;
        margin: 0;
    }

    /* Panel titles can carry a subtitle without breaking the flex row */
    .panel-title > div { min-width: 0; }
    .panel-title > div h2 {
        margin: 0;
        line-height: 1.15;
    }
    .panel-subtitle {
        margin: 5px 0 0;
        color: var(--muted, #758078);
        font-size: 12.5px;
        line-height: 1.5;
        letter-spacing: 0;
        font-family: var(--sans, 'DM Sans', system-ui, sans-serif);
        font-weight: 400;
    }

    /* Hero panel: give the CTA breathing room */
    .hero-copy .btn { margin-top: 20px; }

    /* Metric deltas — default neutral, opt-in per class.
       Replaces the shared rule that prefixed EVERY .metric small with ▲. */
    .metric small {
        color: var(--muted, #758078);
        font-size: 12px;
        font-weight: 600;
    }
    .metric small::before { content: ""; }

    .metric small.metric-up { color: var(--accent, #3c9169); }
    .metric small.metric-up::before {
        content: "▲ ";
        font-size: 9px;
        opacity: .8;
    }

    .metric small.metric-warn { color: var(--amber, #b9853c); }
    .metric small.metric-warn::before {
        content: "● ";
        font-size: 9px;
        opacity: .85;
    }

    .metric small.metric-down { color: var(--red, #ae5d50); }
    .metric small.metric-down::before {
        content: "▼ ";
        font-size: 9px;
        opacity: .8;
    }
</style>

<section class="hero-panel">
    <div class="hero-copy">
        <div class="eyebrow">Tuesday · 14 October 2025</div>
        <h1>Good morning,<br />Muhammad Harmain.</h1>
        <p>Your guide to the week ahead: 18 departures are being prepared and three new journeys are ready for review.</p>
        <a class="btn btn-primary" href="/Admin/Tours">Open operations view →</a>
    </div>
    <span class="hero-note">Prototype data · October</span>
</section>

<div class="metric-row">
    <div class="metric">
        <label>Total bookings</label>
        <strong>284</strong>
        <small class="metric-up">18% this month</small>
    </div>
    <div class="metric">
        <label>Pending inquiries</label>
        <strong>17</strong>
        <small class="metric-warn">Needs your attention</small>
    </div>
    <div class="metric">
        <label>Live listings</label>
        <strong>64</strong>
        <small>Across 12 regions</small>
    </div>
    <div class="metric">
        <label>Recorded revenue</label>
        <strong>$42.8k</strong>
        <small class="metric-up">9.4% vs September</small>
    </div>
</div>

