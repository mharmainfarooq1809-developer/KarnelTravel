@model KarnelTravel.ViewModels.AccountSettingsViewModel
@{ Layout = "_AdminLayout"; ViewData["Title"] = "Account & Security"; }
<div class="page-heading"><div><div class="eyebrow">Account & security</div><h1>Your account</h1><p>Update profile details or change your password securely.</p></div></div>
<form asp-action="AccountSettings" method="post" class="setting-card" style="max-width:680px">@Html.AntiForgeryToken()<div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div><div class="field"><label asp-for="DisplayName"></label><input asp-for="DisplayName" class="input" /></div><div class="field"><label asp-for="Email"></label><input asp-for="Email" class="input" /></div><div class="field"><label>Role</label><input value="@Model.Role" class="input" readonly /></div><hr /><h2>Change password</h2><p>Leave these fields blank to keep the current password. Passwords are hashed by the existing authentication service.</p><div class="field"><label asp-for="CurrentPassword"></label><input asp-for="CurrentPassword" class="input" /></div><div class="field"><label asp-for="NewPassword"></label><input asp-for="NewPassword" class="input" /></div><div class="field"><label asp-for="ConfirmPassword"></label><input asp-for="ConfirmPassword" class="input" /></div><button class="btn btn-primary" type="submit">Save account</button></form>
