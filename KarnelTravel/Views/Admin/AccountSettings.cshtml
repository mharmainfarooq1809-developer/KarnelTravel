@model KarnelTravel.ViewModels.AccountSettingsViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Account & Security";

    // Derive initials from DisplayName where practical, with a safe fallback.
    var displayName = Model?.DisplayName;
    string initials = "?";
    if (!string.IsNullOrWhiteSpace(displayName))
    {
        var parts = displayName.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 1)
        {
            initials = parts[0].Length >= 2
                ? parts[0].Substring(0, 2).ToUpperInvariant()
                : parts[0].Substring(0, 1).ToUpperInvariant();
        }
        else
        {
            var first = parts[0].Substring(0, 1);
            var last = parts[parts.Length - 1].Substring(0, 1);
            initials = (first + last).ToUpperInvariant();
        }
    }

    var roleLabel = string.IsNullOrWhiteSpace(Model?.Role) ? "Administrator" : Model!.Role;
}

<div class="acc-page">

    <!-- ================= PAGE INTRODUCTION ================= -->
    <header class="page-heading acc-heading">
        <div>
            <p class="eyebrow">Account &amp; security</p>
            <h1>Account settings</h1>
            <p>Manage your personal information and protect access to your administrator account.</p>
        </div>

        <span class="acc-heading-mark" aria-hidden="true">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none"
                 stroke="currentColor" stroke-width="1.6"
                 stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 3 5 6v5c0 4.4 3 8.3 7 10 4-1.7 7-5.6 7-10V6z" />
                <path d="m9.3 11.8 2 2 3.6-4" />
            </svg>
        </span>
    </header>

    <!-- ================= FORM ================= -->
    <form asp-action="AccountSettings" method="post" class="acc-form" novalidate>
        @Html.AntiForgeryToken()

        <div asp-validation-summary="ModelOnly" class="acc-summary"></div>

        <div class="acc-grid">

            <!-- =====================================================
                 B. ACCOUNT INFORMATION
                 ===================================================== -->
            <section class="acc-card" aria-labelledby="acc-profile-title">
                <header class="acc-card-head">
                    <p class="acc-card-eyebrow">Profile</p>
                    <h2 id="acc-profile-title">Account information</h2>
                    <p class="acc-card-desc">
                        This is how you appear across the Karnel admin. Keep your name and email up to date.
                    </p>
                </header>

                <div class="acc-identity">
                    <span class="acc-avatar" aria-hidden="true">@initials</span>
                    <div class="acc-identity-meta">
                        <strong>@(string.IsNullOrWhiteSpace(Model?.DisplayName) ? "Administrator" : Model!.DisplayName)</strong>
                        <span class="acc-role-badge">
                            <svg width="11" height="11" viewBox="0 0 24 24" fill="none"
                                 stroke="currentColor" stroke-width="2.2"
                                 stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <path d="M12 3 5 6v5c0 4.4 3 8.3 7 10 4-1.7 7-5.6 7-10V6z" />
                            </svg>
                            @roleLabel
                        </span>
                    </div>
                </div>

                <div class="acc-fields">
                    <div class="acc-field">
                        <label asp-for="DisplayName" class="acc-label"></label>
                        <input asp-for="DisplayName" class="acc-input" autocomplete="name" />
                        <span asp-validation-for="DisplayName" class="acc-error"></span>
                    </div>

                    <div class="acc-field">
                        <label asp-for="Email" class="acc-label"></label>
                        <input asp-for="Email" class="acc-input" autocomplete="email" />
                        <span asp-validation-for="Email" class="acc-error"></span>
                    </div>

                    <div class="acc-field">
                        <label for="RoleDisplay" class="acc-label">
                            Role
                            <span class="acc-readonly-tag">Read-only</span>
                        </label>
                        <input id="RoleDisplay"
                               value="@Model?.Role"
                               class="acc-input acc-input--readonly"
                               readonly
                               tabindex="-1"
                               aria-describedby="role-help" />
                        <p id="role-help" class="acc-hint">
                            Your role is managed by the system and cannot be changed from this page.
                        </p>
                    </div>
                </div>
            </section>

            <!-- =====================================================
                 C. PASSWORD & SECURITY
                 ===================================================== -->
            <section class="acc-card" aria-labelledby="acc-password-title">
                <header class="acc-card-head">
                    <p class="acc-card-eyebrow">Security</p>
                    <h2 id="acc-password-title">Password &amp; access</h2>
                    <p class="acc-card-desc">
                        Leave all three fields blank to keep your current password.
                    </p>
                </header>

                <div class="acc-fields">
                    <div class="acc-field">
                        <label asp-for="CurrentPassword" class="acc-label"></label>
                        <div class="acc-input-group">
                            <input asp-for="CurrentPassword" class="acc-input" autocomplete="current-password" />
                            <button type="button" class="acc-eye" data-eye
                                    aria-label="Show current password" aria-pressed="false">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none"
                                     stroke="currentColor" stroke-width="1.8"
                                     stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12z" />
                                    <circle cx="12" cy="12" r="2.6" />
                                </svg>
                            </button>
                        </div>
                        <span asp-validation-for="CurrentPassword" class="acc-error"></span>
                    </div>

                    <div class="acc-field">
                        <label asp-for="NewPassword" class="acc-label"></label>
                        <div class="acc-input-group">
                            <input asp-for="NewPassword" class="acc-input" autocomplete="new-password" />
                            <button type="button" class="acc-eye" data-eye
                                    aria-label="Show new password" aria-pressed="false">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none"
                                     stroke="currentColor" stroke-width="1.8"
                                     stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12z" />
                                    <circle cx="12" cy="12" r="2.6" />
                                </svg>
                            </button>
                        </div>
                        <span asp-validation-for="NewPassword" class="acc-error"></span>
                    </div>

                    <div class="acc-field">
                        <label asp-for="ConfirmPassword" class="acc-label"></label>
                        <div class="acc-input-group">
                            <input asp-for="ConfirmPassword" class="acc-input" autocomplete="new-password" />
                            <button type="button" class="acc-eye" data-eye
                                    aria-label="Show confirm password" aria-pressed="false">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none"
                                     stroke="currentColor" stroke-width="1.8"
                                     stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12z" />
                                    <circle cx="12" cy="12" r="2.6" />
                                </svg>
                            </button>
                        </div>
                        <span asp-validation-for="ConfirmPassword" class="acc-error"></span>
                    </div>
                </div>

                <div class="acc-notice" role="note">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none"
                         stroke="currentColor" stroke-width="1.8"
                         stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <circle cx="12" cy="12" r="9" />
                        <path d="M12 8v.01" />
                        <path d="M11 12h1v4h1" />
                    </svg>
                    <p>
                        Passwords are hashed by the existing authentication service.
                        Never share your credentials with anyone.
                    </p>
                </div>
            </section>
        </div>

        <!-- =====================================================
             D. SAVE ACTIONS
             ===================================================== -->
        <footer class="acc-actions">
            <p class="acc-actions-hint">
                Changes to your account information take effect immediately after saving.
            </p>
            <button class="btn btn-primary acc-save" type="submit">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="2.2"
                     stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="m5 12 5 5L20 7" />
                </svg>
                Save changes
            </button>
        </footer>
    </form>
</div>

<style>
    /* ============================================================
       ACCOUNT & SECURITY — page-scoped refinements
       Uses Karnel Admin tokens from _AdminLayout.
       ============================================================ */

    .acc-page { display: block; max-width: 1160px; }

    /* ---------- Heading ---------- */
    .acc-page .acc-heading {
        align-items: flex-end;
        margin-bottom: 32px;
    }

    .acc-page .acc-heading h1 {
        font-size: clamp(32px, 3.6vw, 48px);
    }

    .acc-page .acc-heading p {
        margin-top: 8px;
        max-width: 60ch;
    }

    .acc-page .acc-heading-mark {
        display: inline-grid;
        place-items: center;
        width: 44px;
        height: 44px;
        border-radius: 12px;
        background: rgba(143, 168, 136, .14);
        color: var(--forest);
        flex-shrink: 0;
        box-shadow: inset 0 0 0 1px var(--line);
    }

    /* ---------- Form & grid ---------- */
    .acc-page .acc-form { display: block; }

    .acc-page .acc-grid {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
        gap: 20px;
        align-items: start;
    }

    /* ---------- Summary ---------- */
    .acc-page .acc-summary {
        margin: 0 0 18px;
        padding: 12px 16px;
        border-radius: 10px;
        border: 1px solid rgba(174, 93, 80, .28);
        background: rgba(174, 93, 80, .08);
        color: #8b4137;
        font-size: 13px;
        line-height: 1.5;
    }

    .acc-page .acc-summary:empty { display: none; }

    .acc-page .acc-summary ul {
        margin: 0;
        padding-left: 18px;
    }

    /* ---------- Card ---------- */
    .acc-page .acc-card {
        background: var(--white);
        border: 1px solid var(--line);
        border-radius: var(--radius);
        padding: 26px 26px 28px;
        display: flex;
        flex-direction: column;
        gap: 22px;
        min-width: 0;
        transition: border-color var(--dur) var(--ease),
                    box-shadow var(--dur) var(--ease);
    }

    .acc-page .acc-card:hover {
        border-color: var(--line-hi);
        box-shadow: var(--shadow-sm);
    }

    .acc-page .acc-card-head { min-width: 0; }

    .acc-page .acc-card-eyebrow {
        margin: 0 0 6px;
        font-size: 10.5px;
        font-weight: 700;
        letter-spacing: .16em;
        text-transform: uppercase;
        color: var(--accent);
    }

    .acc-page .acc-card-head h2 {
        margin: 0;
        font-family: var(--serif);
        font-weight: 400;
        font-size: 24px;
        line-height: 1.15;
        letter-spacing: -.012em;
        color: var(--forest);
    }

    .acc-page .acc-card-desc {
        margin: 8px 0 0;
        font-size: 13px;
        line-height: 1.55;
        color: var(--muted);
        max-width: 42ch;
    }

    /* ---------- Identity block ---------- */
    .acc-page .acc-identity {
        display: flex;
        align-items: center;
        gap: 14px;
        padding: 14px 16px;
        border-radius: 12px;
        border: 1px solid var(--line);
        background: var(--surface-sunken, #fbfcfa);
    }

    .acc-page .acc-avatar {
        width: 48px;
        height: 48px;
        flex-shrink: 0;
        display: grid;
        place-items: center;
        border-radius: 50%;
        background: linear-gradient(145deg, #F3EAD1 0%, #D8C79B 100%);
        color: var(--forest);
        font-family: var(--serif);
        font-size: 18px;
        line-height: 1;
        letter-spacing: .01em;
    }

    .acc-page .acc-identity-meta {
        min-width: 0;
        display: flex;
        flex-direction: column;
        gap: 5px;
    }

    .acc-page .acc-identity-meta strong {
        font-size: 14.5px;
        font-weight: 600;
        color: var(--ink);
        line-height: 1.25;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .acc-page .acc-role-badge {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        align-self: flex-start;
        padding: 3px 9px;
        border-radius: 999px;
        background: rgba(143, 168, 136, .16);
        color: var(--forest);
        font-size: 11px;
        font-weight: 700;
        letter-spacing: .04em;
        text-transform: uppercase;
    }

    /* ---------- Fields ---------- */
    .acc-page .acc-fields {
        display: flex;
        flex-direction: column;
        gap: 16px;
    }

    .acc-page .acc-field { min-width: 0; }

    .acc-page .acc-label {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
        margin-bottom: 6px;
        font-size: 12.5px;
        font-weight: 600;
        color: var(--ink);
        letter-spacing: .005em;
    }

    .acc-page .acc-readonly-tag {
        display: inline-flex;
        align-items: center;
        padding: 2px 8px;
        border-radius: 999px;
        background: var(--soft);
        color: var(--muted);
        font-size: 9.5px;
        font-weight: 700;
        letter-spacing: .10em;
        text-transform: uppercase;
    }

    /* ---------- Inputs ---------- */
    .acc-page .acc-input {
        display: block;
        width: 100%;
        padding: 11px 13px;
        border-radius: 10px;
        border: 1px solid var(--line);
        background: var(--white);
        color: var(--ink);
        font-family: var(--sans);
        font-size: 14px;
        line-height: 1.4;
        transition: border-color var(--dur-fast) var(--ease),
                    box-shadow var(--dur-fast) var(--ease),
                    background var(--dur-fast) var(--ease);
    }

    .acc-page .acc-input::placeholder { color: var(--muted); opacity: .75; }

    .acc-page .acc-input:hover {
        border-color: var(--line-hi);
    }

    .acc-page .acc-input:focus {
        outline: none;
        border-color: var(--accent);
        box-shadow: var(--ring-accent);
    }

    .acc-page .acc-input--readonly,
    .acc-page .acc-input[readonly] {
        background: var(--surface-sunken, #fbfcfa);
        color: var(--muted);
        cursor: not-allowed;
        border-style: dashed;
    }

    .acc-page .acc-input--readonly:focus {
        outline: none;
        border-color: var(--line);
        box-shadow: none;
    }

    /* Field-level validation */
    .acc-page .acc-input.input-validation-error {
        border-color: rgba(174, 93, 80, .55);
        background: rgba(174, 93, 80, .03);
    }

    .acc-page .acc-input.input-validation-error:focus {
        box-shadow: 0 0 0 3px rgba(174, 93, 80, .18);
    }

    .acc-page .acc-error {
        display: block;
        margin-top: 6px;
        font-size: 11.5px;
        line-height: 1.5;
        color: #8b4137;
        font-weight: 500;
    }

    .acc-page .acc-error:empty { display: none; }

    /* ---------- Input group (password) ---------- */
    .acc-page .acc-input-group {
        position: relative;
        display: flex;
        align-items: stretch;
    }

    .acc-page .acc-input-group .acc-input {
        padding-right: 44px;
    }

    .acc-page .acc-eye {
        position: absolute;
        top: 50%;
        right: 6px;
        transform: translateY(-50%);
        width: 34px;
        height: 34px;
        display: grid;
        place-items: center;
        border-radius: 8px;
        background: transparent;
        color: var(--muted);
        border: 0;
        cursor: pointer;
        transition: color var(--dur-fast) var(--ease),
                    background var(--dur-fast) var(--ease);
    }

    .acc-page .acc-eye:hover {
        color: var(--forest);
        background: var(--soft);
    }

    .acc-page .acc-eye:focus-visible {
        outline: 2px solid var(--accent);
        outline-offset: 1px;
    }

    .acc-page .acc-eye[aria-pressed="true"] {
        color: var(--forest);
        background: var(--soft);
    }

    /* ---------- Hints ---------- */
    .acc-page .acc-hint {
        margin: 6px 0 0;
        font-size: 11.5px;
        line-height: 1.55;
        color: var(--muted);
    }

    /* ---------- Security notice ---------- */
    .acc-page .acc-notice {
        display: flex;
        align-items: flex-start;
        gap: 10px;
        padding: 14px 16px;
        border-radius: 10px;
        border: 1px solid var(--line);
        background: rgba(143, 168, 136, .07);
        color: var(--ink);
    }

    .acc-page .acc-notice svg {
        flex-shrink: 0;
        margin-top: 1px;
        color: var(--sage, #8fa888);
    }

    .acc-page .acc-notice p {
        margin: 0;
        font-size: 12.5px;
        line-height: 1.6;
        color: var(--muted);
    }

    /* ---------- Actions ---------- */
    .acc-page .acc-actions {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        flex-wrap: wrap;
        margin-top: 22px;
        padding: 20px 22px;
        background: var(--white);
        border: 1px solid var(--line);
        border-radius: var(--radius);
    }

    .acc-page .acc-actions-hint {
        margin: 0;
        font-size: 12.5px;
        line-height: 1.5;
        color: var(--muted);
        max-width: 56ch;
    }

    .acc-page .acc-save {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 11px 22px;
        border-radius: 9px;
        font-size: 13.5px;
        flex-shrink: 0;
        transition: background var(--dur-fast) var(--ease),
                    box-shadow var(--dur-fast) var(--ease),
                    transform var(--dur-fast) var(--ease);
    }

    .acc-page .acc-save:hover { transform: translateY(-1px); }
    .acc-page .acc-save:active { transform: translateY(0); }

    /* ============================================================
       RESPONSIVE
       ============================================================ */
    @@media (max-width: 900px) {
        .acc-page .acc-grid { grid-template-columns: 1fr; }
    }

    @@media (max-width: 640px) {
        .acc-page .acc-heading {
            flex-direction: column;
            align-items: flex-start;
            gap: 14px;
        }

        .acc-page .acc-heading-mark { display: none; }

        .acc-page .acc-card {
            padding: 22px 20px 24px;
            border-radius: 14px;
        }

        .acc-page .acc-actions {
            flex-direction: column;
            align-items: stretch;
            gap: 12px;
            padding: 18px;
        }

        .acc-page .acc-save {
            justify-content: center;
            width: 100%;
        }
    }

    /* ============================================================
       DARK THEME TUNING
       ============================================================ */
    html[data-admin-theme="dark"] .acc-page .acc-summary {
        background: rgba(174, 93, 80, .14);
        color: #f0c3ba;
        border-color: rgba(174, 93, 80, .32);
    }

    html[data-admin-theme="dark"] .acc-page .acc-error {
        color: #f0c3ba;
    }

    html[data-admin-theme="dark"] .acc-page .acc-notice {
        background: rgba(143, 168, 136, .10);
        border-color: var(--line);
    }

    html[data-admin-theme="dark"] .acc-page .acc-input--readonly,
    html[data-admin-theme="dark"] .acc-page .acc-input[readonly] {
        background: rgba(255, 255, 255, .03);
    }

    html[data-admin-theme="dark"] .acc-page .acc-identity {
        background: rgba(255, 255, 255, .03);
    }

    @@media (prefers-color-scheme: dark) {
        html[data-admin-theme="system"] .acc-page .acc-summary {
            background: rgba(174, 93, 80, .14);
            color: #f0c3ba;
            border-color: rgba(174, 93, 80, .32);
        }

        html[data-admin-theme="system"] .acc-page .acc-error {
            color: #f0c3ba;
        }

        html[data-admin-theme="system"] .acc-page .acc-notice {
            background: rgba(143, 168, 136, .10);
        }

        html[data-admin-theme="system"] .acc-page .acc-input--readonly,
        html[data-admin-theme="system"] .acc-page .acc-input[readonly] {
            background: rgba(255, 255, 255, .03);
        }

        html[data-admin-theme="system"] .acc-page .acc-identity {
            background: rgba(255, 255, 255, .03);
        }
    }

    /* ============================================================
       REDUCED MOTION
       ============================================================ */
    @@media (prefers-reduced-motion: reduce) {
        .acc-page .acc-card,
        .acc-page .acc-input,
        .acc-page .acc-eye,
        .acc-page .acc-save {
            transition: none !important;
        }

        .acc-page .acc-save:hover { transform: none; }
    }
</style>

@section Scripts {
    <script>
        (function () {
            "use strict";

            /* Password visibility toggles — do not touch the input name/id/value. */
            var toggles = document.querySelectorAll(".acc-page [data-eye]");
            for (var i = 0; i < toggles.length; i++) {
                (function (btn) {
                    btn.addEventListener("click", function () {
                        var group = btn.closest(".acc-input-group");
                        var input = group ? group.querySelector("input") : null;
                        if (!input) return;

                        var show = input.type === "password";
                        input.type = show ? "text" : "password";
                        btn.setAttribute("aria-pressed", show ? "true" : "false");
                        btn.setAttribute("aria-label", (show ? "Hide " : "Show ") +
                            (input.getAttribute("placeholder") || "password").toLowerCase());
                    });
                })(toggles[i]);
            }
        })();
    </script>
}