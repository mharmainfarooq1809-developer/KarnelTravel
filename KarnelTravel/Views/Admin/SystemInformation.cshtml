@{ Layout = "_AdminLayout"; ViewData["Title"] = "System Information"; }
<div class="page-heading"><div><div class="eyebrow">Read-only diagnostics</div><h1>System information</h1><p>Safe operational details and live database counts. Credentials and connection strings are never displayed.</p></div></div>
<div class="settings-grid"><section class="setting-card"><h2>Application</h2><p><strong>Application:</strong> @ViewBag.ApplicationName</p><p><strong>Environment:</strong> @Environment.GetEnvironmentVariable("ASPNETCORE_ENVIRONMENT")</p><p><strong>Server time:</strong> @DateTimeOffset.Now</p><p><strong>Application time zone:</strong> @ViewBag.TimeZone</p><p><strong>Administrator:</strong> @ViewBag.CurrentAdministrator</p><p><strong>Database provider:</strong> @ViewBag.Provider</p><p><strong>Database status:</strong> @(ViewBag.DatabaseConnected ? "Connected" : "Unavailable")</p></section><section class="setting-card"><h2>Content totals</h2><p><strong>Bookings:</strong> @ViewBag.Bookings</p><p><strong>Destinations:</strong> @ViewBag.Destinations</p><p><strong>Hotels:</strong> @ViewBag.Hotels</p><p><strong>Restaurants:</strong> @ViewBag.Restaurants</p><p><strong>Resorts:</strong> @ViewBag.Resorts</p><p><strong>Transport listings:</strong> @ViewBag.Transport</p></section></div>
