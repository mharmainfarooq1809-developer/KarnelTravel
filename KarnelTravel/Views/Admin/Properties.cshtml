<script>
    (() => {
        const searchInput = document.getElementById("propertySearch");
        const typeFilter = document.getElementById("propertyTypeFilter");
        const statusFilter = document.getElementById("propertyStatusFilter");
        const cardGrid = document.getElementById("propertyCardGrid");
        const noResults = document.getElementById("propertyNoResults");
        const resultCount = document.getElementById("propertyResultCount");

        if (!searchInput || !typeFilter || !statusFilter || !cardGrid) {
            return;
        }

        const cards = Array.from(
            cardGrid.querySelectorAll(".property-card")
        );

        function filterProperties() {
            const search = searchInput.value.trim().toLowerCase();
            const selectedType = typeFilter.value;
            const selectedStatus = statusFilter.value;
            let visibleCount = 0;

            cards.forEach(card => {
                const searchableText = [
                    card.dataset.name,
                    card.dataset.location,
                    card.dataset.destination
                ].join(" ").toLowerCase();

                const matchesSearch = searchableText.includes(search);
                const matchesType =
                    !selectedType || card.dataset.type === selectedType;
                const matchesStatus =
                    !selectedStatus || card.dataset.status === selectedStatus;

                const visible =
                    matchesSearch && matchesType && matchesStatus;

                card.hidden = !visible;

                if (visible) {
                    visibleCount++;
                }
            });

            if (noResults) {
                noResults.hidden = visibleCount !== 0;
            }

            if (resultCount) {
                resultCount.textContent =
                    `Showing ${visibleCount} of ${cards.length} properties`;
            }
        }

        // rAF throttle — one filter per frame regardless of typing speed
        let framePending = false;
        function scheduleFilter() {
            if (framePending) return;
            framePending = true;
            requestAnimationFrame(() => {
                filterProperties();
                framePending = false;
            });
        }

        searchInput.addEventListener("input", scheduleFilter);
        typeFilter.addEventListener("change", filterProperties);
        statusFilter.addEventListener("change", filterProperties);

        filterProperties();
    })();
</script>