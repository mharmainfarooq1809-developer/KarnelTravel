@model KarnelTravel.ViewModels.AdminPropertiesViewModel

@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Stays & Properties";
    ViewData["Section"] = "Stays";
}

<section class="admin-page properties-page">

    <div class="admin-page-header">
        <div>
            <p class="admin-eyebrow">Property management</p>
            <h1>Stays &amp; Properties</h1>
            <p class="admin-description">
                Manage hotels, restaurants, and resorts listed on Karnel Travel Guide.
            </p>
        </div>

        <a asp-controller="Admin"
           asp-action="CreateProperty"
           class="admin-button admin-button-primary">
            + Add property
        </a>
    </div>

    @if (TempData["SuccessMessage"] is string successMessage)
    {
        <div class="admin-alert admin-alert-success" role="status">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
            <span>@successMessage</span>
        </div>
    }

    @if (TempData["ErrorMessage"] is string errorMessage)
    {
        <div class="admin-alert admin-alert-error" role="alert">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
            <span>@errorMessage</span>
        </div>
    }

    <div class="property-stat-grid">
        <article class="property-stat-card">
            <div class="property-stat-icon">
                <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="7" height="7" rx="1.6"/><rect x="14" y="3" width="7" height="7" rx="1.6"/><rect x="3" y="14" width="7" height="7" rx="1.6"/><rect x="14" y="14" width="7" height="7" rx="1.6"/></svg>
            </div>
            <p>Total properties</p>
            <h2>@Model.Properties.Count</h2>
            <span>All property types</span>
        </article>

        <article class="property-stat-card">
            <div class="property-stat-icon">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 10.5 12 3l9 7.5"/><path d="M5.5 9.5V21h13V9.5"/><path d="M9.5 21v-5.5h5V21"/></svg>
            </div>
            <p>Hotels</p>
            <h2>@Model.HotelCount</h2>
            <span>Accommodation listings</span>
        </article>

        <article class="property-stat-card">
            <div class="property-stat-icon">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 3v8a2 2 0 1 0 4 0V3"/><path d="M9 11v10"/><path d="M17 3c-1.5 2-2 4-2 6 0 2 1 3 2 3s2-1 2-3c0-2-.5-4-2-6z"/><path d="M17 12v9"/></svg>
            </div>
            <p>Restaurants</p>
            <h2>@Model.RestaurantCount</h2>
            <span>Dining listings</span>
        </article>

        <article class="property-stat-card">
            <div class="property-stat-icon">
                <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v3M12 19v3M4.2 4.2l2.1 2.1M17.7 17.7l2.1 2.1M2 12h3M19 12h3M4.2 19.8l2.1-2.1M17.7 6.3l2.1-2.1"/></svg>
            </div>
            <p>Resorts</p>
            <h2>@Model.ResortCount</h2>
            <span>Resort listings</span>
        </article>
    </div>

    <div class="property-status-grid">
        <div class="property-status-card">
            <span class="status-dot status-dot-published"></span>
            <div>
                <span>Published</span>
                <strong>@Model.PublishedCount</strong>
            </div>
        </div>

        <div class="property-status-card">
            <span class="status-dot status-dot-draft"></span>
            <div>
                <span>Drafts</span>
                <strong>@Model.DraftCount</strong>
            </div>
        </div>
    </div>

    <section class="property-panel" id="property-list">

        <div class="property-panel-header">
            <div>
                <h2>All properties</h2>
                <p>Review, edit, publish, or remove property records.</p>
            </div>

            <span class="property-total-badge">
                @Model.Properties.Count records
            </span>
        </div>

        <div class="property-toolbar">
            <div class="property-search">
                <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
                <input type="search"
                       id="propertySearch"
                       placeholder="Search name, location or destination..."
                       aria-label="Search properties" />
            </div>

            <select id="propertyTypeFilter" aria-label="Filter by property type">
                <option value="">All types</option>
                <option value="hotel">Hotels</option>
                <option value="restaurant">Restaurants</option>
                <option value="resort">Resorts</option>
            </select>

            <select id="propertyStatusFilter" aria-label="Filter by publication status">
                <option value="">All statuses</option>
                <option value="published">Published</option>
                <option value="draft">Draft</option>
            </select>
        </div>

        @if (Model.Properties.Count == 0)
        {
            <div class="property-empty-state">
                <div class="property-empty-icon">
                    <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 10.5 12 3l9 7.5"/><path d="M5.5 9.5V21h13V9.5"/><path d="M9.5 21v-5.5h5V21"/></svg>
                </div>
                <h3>No properties found</h3>
                <p>
                    Your database currently has no hotel, restaurant, or resort records.
                    Add a property to get started.
                </p>

                <a asp-controller="Admin"
                   asp-action="CreateProperty"
                   class="admin-button admin-button-primary">
                    Add your first property
                </a>
            </div>
        }
        else
        {
            <div class="property-card-grid" id="propertyCardGrid">

                @foreach (var property in Model.Properties)
                {
                    var normalizedType =
                        property.Category?.ToLowerInvariant() ?? "";

                    var normalizedStatus = property.IsArchived
                        ? "archived"
                        : property.IsPublished ? "published" : "draft";

                    var price = Convert.ToDecimal(property.Price);

                    var typeLabel = normalizedType switch
                    {
                        "hotel" => "Hotel",
                        "restaurant" => "Restaurant",
                        "resort" => "Resort",
                        _ => property.Category ?? "Property"
                    };

                    <article class="property-card"
                             data-name="@property.Name"
                             data-location="@property.Location"
                             data-destination="@property.DestinationName"
                             data-type="@normalizedType"
                             data-status="@normalizedStatus">

                        <!-- ---------- Media ---------- -->
                        <div class="property-card-media">
                            @if (!string.IsNullOrWhiteSpace(property.ImageUrl))
                            {
                                <img src="@property.ImageUrl"
                                     alt=""
                                     loading="lazy"
                                     decoding="async"
                                     onerror="this.style.display='none';" />
                            }
                            else
                            {
                                <div class="property-card-placeholder">
                                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 10.5 12 3l9 7.5"/><path d="M5.5 9.5V21h13V9.5"/><path d="M9.5 21v-5.5h5V21"/></svg>
                                    <span>@((property.Name ?? "?").Substring(0, 1).ToUpperInvariant())</span>
                                </div>
                            }

                            <div class="property-card-badge-row">
                                <span class="property-card-type type-@normalizedType">
                                    @typeLabel
                                </span>

                                @if (property.IsFeatured)
                                {
                                    <span class="property-card-featured">★ Featured</span>
                                }
                            </div>

                            <span class="property-card-status @normalizedStatus">
                                <span class="status-dot"></span>
                                @(property.IsArchived ? "Archived" : property.IsPublished ? "Published" : "Draft")
                            </span>
                        </div>

                        <!-- ---------- Body ---------- -->
                        <div class="property-card-body">

                            <h3 class="property-card-title">@property.Name</h3>

                            <div class="property-card-meta">
                                <span class="property-card-meta-item">
                                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 21s7-5.6 7-11a7 7 0 1 0-14 0c0 5.4 7 11 7 11z"/><circle cx="12" cy="10" r="2.6"/></svg>
                                    @(string.IsNullOrWhiteSpace(property.Location)
                                        ? "Not specified"
                                        : property.Location)
                                </span>

                                @if (!string.IsNullOrWhiteSpace(property.DestinationName))
                                {
                                    <span class="property-card-meta-item">
                                        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="m15.6 8.4-2.1 5.1-5.1 2.1 2.1-5.1z"/></svg>
                                        @property.DestinationName
                                    </span>
                                }
                            </div>

                            <div class="property-card-divider"></div>

                            <div class="property-card-footer">
                                <div class="property-card-price">
                                    @if (price > 0)
                                    {
                                        <strong>PKR @price.ToString("N0")</strong>
                                        <span>
                                            @(normalizedType == "restaurant"
                                                ? "per meal (average)"
                                                : "per night")
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="property-card-price-empty">Price not set</span>
                                    }
                                </div>

                                <div class="property-card-actions">
                                    <a asp-controller="Admin"
                                       asp-action="EditProperty"
                                       asp-route-id="@property.Id"
                                       asp-route-category="@property.Category"
                                       class="property-card-btn property-card-btn-edit"
                                       aria-label="Edit @property.Name">
                                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4z"/></svg>
                                        Edit
                                    </a>

                                    <form asp-controller="Admin"
                                           asp-action="TogglePropertyActive"
                                           asp-route-id="@property.Id"
                                           method="post"
                                           style="display:inline"
                                           onsubmit="return confirm('@(property.IsPublished ? "Deactivate" : "Activate") @property.Name?');">
                                         @Html.AntiForgeryToken()
                                         <input type="hidden" name="category" value="@property.Category" />
                                         <button type="submit" class="property-card-btn" disabled="@(property.IsArchived)">
                                             @(property.IsPublished ? "Deactivate" : "Activate")
                                         </button>
                                     </form>

                                     <form asp-controller="Admin"
                                           asp-action="@(property.IsArchived ? "RestoreProperty" : "ArchiveProperty")"
                                           asp-route-id="@property.Id"
                                           method="post"
                                           style="display:inline"
                                           onsubmit="return confirm('@(property.IsArchived ? "Restore" : "Archive") @property.Name?');">
                                         @Html.AntiForgeryToken()
                                         <input type="hidden" name="category" value="@property.Category" />
                                         <button type="submit" class="property-card-btn">
                                             @(property.IsArchived ? "Restore" : "Archive")
                                         </button>
                                     </form>

                                     <form asp-controller="Admin"
                                          asp-action="DeleteProperty"
                                          asp-route-id="@property.Id"
                                          method="post"
                                          class="property-card-delete-form"
                                          onsubmit="return confirm('Delete @property.Name? This action cannot be undone.');">

                                        @Html.AntiForgeryToken()

                                        <input type="hidden" name="category" value="@property.Category" />

                                        <button type="submit"
                                                class="property-card-btn property-card-btn-delete"
                                                aria-label="Delete @property.Name">
                                            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 6h18"/><path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6"/><path d="M10 11v6M14 11v6"/></svg>
                                            Delete
                                        </button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </article>
                }
            </div>

            <div id="propertyNoResults" class="property-no-results" hidden>
                <div class="property-empty-icon">
                    <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
                </div>
                <h3>No matching properties</h3>
                <p>Try a different search term or filter.</p>
            </div>

            <div class="property-table-footer">
                <span id="propertyResultCount">
                    Showing @Model.Properties.Count properties
                </span>
            </div>
        }

    </section>
</section>

<style>
   

    .properties-page {
        color: var(--ink, #1b2922);
        padding-bottom: 36px;
    }

    /* ---------- Header ---------- */
    .admin-page-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        gap: 24px;
        margin-bottom: 26px;
    }
    .admin-eyebrow {
        margin: 0 0 8px;
        color: var(--accent, #3c9169);
        font-size: 11px;
        font-weight: 700;
        letter-spacing: .16em;
        text-transform: uppercase;
    }
    .admin-page-header h1 {
        font-family: var(--serif, Georgia, serif);
        font-weight: 400;
        color: var(--forest, #164734);
        font-size: clamp(28px, 3.2vw, 42px);
        line-height: 1.1;
        letter-spacing: -.02em;
        margin: 0;
    }
    .admin-description {
        margin: 10px 0 0;
        color: var(--muted, #758078);
        line-height: 1.6;
        font-size: 13.5px;
        max-width: 62ch;
    }

    /* ---------- Buttons ---------- */
    .admin-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        padding: 11px 18px;
        border-radius: 10px;
        font-size: 13px;
        font-weight: 700;
        text-decoration: none;
        white-space: nowrap;
        transition: background .14s ease, color .14s ease, border-color .14s ease, box-shadow .14s ease, transform .14s ease;
    }
    .admin-button-primary {
        background: var(--forest, #164734);
        color: #fff;
        border: 1px solid var(--forest, #164734);
        box-shadow: 0 2px 10px -4px rgba(22,71,52,.4);
    }
    .admin-button-primary:hover {
        background: var(--green, #236b4d);
        border-color: var(--green, #236b4d);
        color: #fff;
        box-shadow: 0 6px 20px -8px rgba(22,71,52,.5);
        transform: translateY(-1px);
    }

    /* ---------- Alerts ---------- */
    .admin-alert {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 13px 16px;
        margin-bottom: 18px;
        border-radius: 10px;
        font-size: 13px;
        font-weight: 500;
    }
    .admin-alert svg { flex-shrink: 0; }
    .admin-alert-success {
        background: rgba(60,145,105,.10);
        border: 1px solid rgba(60,145,105,.22);
        color: #236b4d;
    }
    .admin-alert-error {
        background: rgba(174,93,80,.10);
        border: 1px solid rgba(174,93,80,.22);
        color: #8b4137;
    }

    /* ---------- Stat cards ---------- */
    .property-stat-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 16px;
        margin-bottom: 18px;
    }
    .property-stat-card {
        padding: 20px 22px;
        background: var(--white, #fff);
        border: 1px solid var(--line, #e5e9e3);
        border-radius: 14px;
        min-width: 0;
        transition: border-color .18s ease, box-shadow .18s ease;
    }
    .property-stat-card:hover {
        border-color: var(--line-hi, #d6dcd4);
        box-shadow: 0 2px 6px -2px rgba(22,71,52,.08);
    }
    .property-stat-icon {
        width: 40px;
        height: 40px;
        display: grid;
        place-items: center;
        margin-bottom: 14px;
        border-radius: 11px;
        background: rgba(60,145,105,.10);
        color: var(--forest, #164734);
    }
    .property-stat-icon svg {
        width: 20px;
        height: 20px;
        fill: none;
        stroke: currentColor;
        stroke-width: 1.7;
        stroke-linecap: round;
        stroke-linejoin: round;
    }
    .property-stat-card p {
        margin: 0 0 6px;
        color: var(--muted, #758078);
        font-size: 11.5px;
        font-weight: 600;
        letter-spacing: .04em;
        text-transform: uppercase;
    }
    .property-stat-card h2 {
        margin: 0;
        font-family: var(--serif, Georgia, serif);
        font-weight: 400;
        font-size: 28px;
        color: var(--forest, #164734);
        line-height: 1.15;
        letter-spacing: -.01em;
        font-variant-numeric: tabular-nums;
    }
    .property-stat-card > span {
        display: block;
        margin-top: 6px;
        color: var(--muted, #758078);
        font-size: 11.5px;
    }

    /* ---------- Status strip ---------- */
    .property-status-grid {
        display: flex;
        gap: 14px;
        margin-bottom: 24px;
    }
    .property-status-card {
        display: flex;
        align-items: center;
        gap: 12px;
        flex: 1;
        padding: 14px 18px;
        background: var(--white, #fff);
        border: 1px solid var(--line, #e5e9e3);
        border-radius: 12px;
    }
    .property-status-card > div {
        display: flex;
        align-items: baseline;
        gap: 10px;
    }
    .property-status-card > div span {
        color: var(--muted, #758078);
        font-size: 12.5px;
        font-weight: 500;
    }
    .property-status-card strong {
        font-size: 18px;
        color: var(--forest, #164734);
        font-variant-numeric: tabular-nums;
    }
    .status-dot {
        display: inline-block;
        width: 7px;
        height: 7px;
        flex-shrink: 0;
        border-radius: 50%;
    }
    .status-dot-published { background: #28b485; box-shadow: 0 0 0 3px rgba(40,180,133,.15); }
    .status-dot-draft     { background: #dca43d; box-shadow: 0 0 0 3px rgba(220,164,61,.15); }

    /* ---------- Panel ---------- */
    .property-panel {
        overflow: hidden;
        background: var(--white, #fff);
        border: 1px solid var(--line, #e5e9e3);
        border-radius: 14px;
    }
    .property-panel-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 15px;
        padding: 20px 24px;
        border-bottom: 1px solid var(--line, #e5e9e3);
    }
    .property-panel-header h2 {
        margin: 0;
        font-family: var(--serif, Georgia, serif);
        font-weight: 400;
        font-size: 20px;
        color: var(--forest, #164734);
        letter-spacing: -.01em;
    }
    .property-panel-header p {
        margin: 6px 0 0;
        color: var(--muted, #758078);
        font-size: 12.5px;
        line-height: 1.5;
    }
    .property-total-badge {
        padding: 6px 11px;
        border: 1px solid var(--line, #e5e9e3);
        border-radius: 999px;
        background: var(--surface-sunken, #fbfcfa);
        color: var(--muted, #758078);
        font-size: 11.5px;
        font-weight: 500;
        white-space: nowrap;
    }

    /* ---------- Toolbar ---------- */
    .property-toolbar {
        display: flex;
        gap: 10px;
        padding: 16px 24px;
        border-bottom: 1px solid var(--line, #e5e9e3);
        background: var(--surface-sunken, #fbfcfa);
    }
    .property-search {
        display: flex;
        align-items: center;
        gap: 9px;
        flex: 1;
        min-width: 150px;
        height: 42px;
        padding: 0 14px;
        border: 1px solid var(--line, #e5e9e3);
        border-radius: 10px;
        background: var(--white, #fff);
        color: var(--muted, #758078);
        transition: border-color .14s ease, box-shadow .14s ease;
    }
    .property-search:focus-within {
        border-color: var(--accent, #3c9169);
        box-shadow: 0 0 0 3px rgba(60,145,105,.20);
    }
    .property-search > svg {
        width: 16px;
        height: 16px;
        flex-shrink: 0;
        fill: none;
        stroke: currentColor;
        stroke-width: 1.8;
        stroke-linecap: round;
        stroke-linejoin: round;
    }
    .property-search input {
        width: 100%;
        min-width: 0;
        height: 100%;
        border: 0;
        outline: 0;
        background: transparent;
        color: var(--ink, #1b2922);
        font: inherit;
        font-size: 13px;
    }
    .property-search input::placeholder { color: var(--muted, #758078); }

    .property-toolbar select {
        height: 42px;
        padding: 0 34px 0 14px;
        border: 1px solid var(--line, #e5e9e3);
        border-radius: 10px;
        background: var(--white, #fff) url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%23758078' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><polyline points='6 9 12 15 18 9'/></svg>") no-repeat right 12px center / 14px;
        color: var(--ink, #1b2922);
        font: inherit;
        font-size: 13px;
        cursor: pointer;
        appearance: none;
        -webkit-appearance: none;
        transition: border-color .14s ease, box-shadow .14s ease;
        max-width: 180px;
    }
    .property-toolbar select:focus {
        outline: none;
        border-color: var(--accent, #3c9169);
        box-shadow: 0 0 0 3px rgba(60,145,105,.20);
    }

    /* ---------- CARD GRID ---------- */
    .property-card-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(min(340px, 100%), 1fr));
        gap: 20px;
        padding: 24px;
    }

    .property-card {
        display: flex;
        flex-direction: column;
        background: var(--white, #fff);
        border: 1px solid var(--line, #e5e9e3);
        border-radius: 14px;
        overflow: hidden;
        contain: layout;
        transition: border-color .18s ease, box-shadow .18s ease, transform .18s ease;
    }
    .property-card:hover {
        border-color: var(--line-hi, #d6dcd4);
        box-shadow: 0 8px 20px -12px rgba(22,71,52,.22);
        transform: translateY(-2px);
    }
    .property-card[hidden] { display: none; }

    /* ---------- Card media ---------- */
    .property-card-media {
        position: relative;
        aspect-ratio: 16 / 10;
        overflow: hidden;
        background: var(--soft, #edf2ed);
    }
    .property-card-media img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform .5s cubic-bezier(.16,1,.3,1);
        backface-visibility: hidden;
    }
    .property-card:hover .property-card-media img {
        will-change: transform;
        transform: scale(1.04);
    }
    .property-card-placeholder {
        width: 100%;
        height: 100%;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 8px;
