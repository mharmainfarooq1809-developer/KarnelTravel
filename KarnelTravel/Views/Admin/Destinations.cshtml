@model IEnumerable<KarnelTravel.Models.Destination>

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Destinations";

    var destinations = Model.ToList();
    var regions = destinations
        .Where(d => !string.IsNullOrWhiteSpace(d.Region))
        .Select(d => d.Region!)
        .Distinct()
        .OrderBy(r => r)
        .ToList();

    var publishedCount = destinations.Count(d => d.IsPublished);
    var draftCount = destinations.Count(d => !d.IsPublished);
    var featuredCount = destinations.Count(d => d.IsFeatured);
}

<style>
    

    /* ---- Stats strip ---- */
    .dest-stats {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 14px;
        margin: 26px 0 24px;
    }
    .dest-stat {
        background: var(--white, #fff);
        border: 1px solid var(--line, #e5e9e3);
        border-radius: 12px;
        padding: 16px 20px;
        transition: border-color .18s ease, box-shadow .18s ease;
    }
    .dest-stat:hover {
        border-color: var(--line-hi, #d6dcd4);
        box-shadow: 0 2px 6px -2px rgba(22,71,52,.08);
    }
    .dest-stat-label {
        display: block;
        font-size: 11px;
        font-weight: 600;
        letter-spacing: .06em;
        text-transform: uppercase;
        color: var(--muted, #758078);
        margin-bottom: 6px;
    }
    .dest-stat-value {
        display: block;
        font-family: var(--serif, Georgia, serif);
        font-weight: 400;
        font-size: 26px;
        color: var(--forest, #164734);
        line-height: 1.1;
        letter-spacing: -.01em;
    }

    /* ---- Banner ---- */
    .destination-banner {
        position: relative;
        min-height: 220px;
        border-radius: 14px;
        overflow: hidden;
        isolation: isolate;
        display: flex;
        align-items: flex-end;
        padding: 34px 40px;
        color: #fff;
        background:
            linear-gradient(90deg, rgba(15,50,37,.92) 0%, rgba(15,50,37,.60) 45%, rgba(15,50,37,.10) 100%),
            url('https://images.unsplash.com/photo-1530789253388-582c481c54b0?auto=format&fit=crop&w=1600&q=80') center/cover;
        box-shadow: 0 12px 35px -12px rgba(22,71,52,.25);
    }
    .destination-banner::after {
        content: "";
        position: absolute;
        inset: 0;
        background: radial-gradient(120% 80% at 100% 100%, transparent 40%, rgba(15,50,37,.35));
        z-index: -1;
        pointer-events: none;
    }
    .destination-banner .eyebrow {
        color: #b9d9bd;
        margin-bottom: 8px;
    }
    .destination-banner h1 {
        font-family: var(--serif, Georgia, serif);
        font-weight: 400;
        font-size: clamp(32px, 3.6vw, 46px);
        line-height: 1.05;
        letter-spacing: -.02em;
        color: #fff;
        margin: 0;
    }
    .destination-banner p {
        margin: 10px 0 0;
        color: #dcebe0;
        font-size: 14.5px;
        max-width: 52ch;
    }

    /* ---- Toolbar ---- */
    .dest-toolbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 12px;
        margin: 22px 0 18px;
    }
    .dest-filters {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        flex: 1;
    }
    .dest-search {
        position: relative;
        flex: 1;
        min-width: 220px;
        max-width: 360px;
    }
    .dest-search svg {
        position: absolute;
        left: 12px;
        top: 50%;
        transform: translateY(-50%);
        width: 16px;
        height: 16px;
        stroke: var(--muted, #758078);
        fill: none;
        stroke-width: 1.8;
        pointer-events: none;
    }
    .dest-search input {
        width: 100%;
        height: 42px;
        padding: 0 14px 0 38px;
        border: 1px solid var(--line, #e5e9e3);
        border-radius: 10px;
        background: var(--white, #fff);
        font-size: 13.5px;
        color: var(--ink, #1b2922);
        transition: border-color .14s ease, box-shadow .14s ease;
    }
    .dest-search input:focus {
        outline: none;
        border-color: var(--accent, #3c9169);
        box-shadow: 0 0 0 3px rgba(60,145,105,.20);
    }
    .dest-filter-select {
        height: 42px;
        padding: 0 34px 0 14px;
        border: 1px solid var(--line, #e5e9e3);
        border-radius: 10px;
        background: var(--white, #fff) url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%23758078' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><polyline points='6 9 12 15 18 9'/></svg>") no-repeat right 12px center / 14px;
        font-size: 13.5px;
        color: var(--ink, #1b2922);
        cursor: pointer;
        appearance: none;
        -webkit-appearance: none;
        transition: border-color .14s ease, box-shadow .14s ease;
    }
    .dest-filter-select:focus {
        outline: none;
        border-color: var(--accent, #3c9169);
        box-shadow: 0 0 0 3px rgba(60,145,105,.20);
    }
    .dest-results-count {
        font-size: 12.5px;
        color: var(--muted, #758078);
        font-weight: 500;
        white-space: nowrap;
    }
    .dest-results-count strong {
        color: var(--forest, #164734);
        font-weight: 700;
    }

    /* ---- Grid ---- */
    .destination-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(min(300px, 100%), 1fr));
        gap: 20px;
    }

    .destination-card {
        position: relative;
        aspect-ratio: 4 / 3;
        border-radius: 14px;
        overflow: hidden;
        cursor: pointer;
        isolation: isolate;
        background-size: cover;
        background-position: center;
        box-shadow: 0 2px 8px -4px rgba(22,71,52,.18);
        transition: transform .35s cubic-bezier(.16,1,.3,1), box-shadow .35s cubic-bezier(.16,1,.3,1);
    }
    .destination-card::before {
        content: "";
        position: absolute;
        inset: 0;
        background: linear-gradient(180deg, rgba(0,0,0,.18) 0%, transparent 30%, transparent 45%, rgba(0,0,0,.82) 100%);
        z-index: 1;
        pointer-events: none;
        transition: opacity .3s ease;
    }
    .destination-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 18px 40px -18px rgba(22,71,52,.40);
    }
    .destination-card .dest-card-image {
        position: absolute;
        inset: 0;
        background: inherit;
        background-size: cover;
        background-position: center;
        transition: transform .7s cubic-bezier(.16,1,.3,1);
        z-index: 0;
    }
    .destination-card:hover .dest-card-image {
        transform: scale(1.06);
    }

    /* ---- Badges ---- */
    .dest-badge-row {
        position: absolute;
        top: 14px;
        left: 14px;
        right: 14px;
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 8px;
        z-index: 2;
    }
    .dest-status {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 5px 10px;
        border-radius: 999px;
        font-size: 10.5px;
        font-weight: 700;
        letter-spacing: .04em;
        text-transform: uppercase;
        color: #fff;
        border: 1px solid rgba(255,255,255,.28);
        background: rgba(15,50,37,.65);
        backdrop-filter: blur(8px);
        -webkit-backdrop-filter: blur(8px);
    }
    .dest-status.is-draft {
        background: rgba(185,133,60,.80);
    }
    .dest-status i {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: #fff;
        flex-shrink: 0;
    }
    .dest-featured {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 5px 10px;
        border-radius: 999px;
        font-size: 10.5px;
        font-weight: 700;
        letter-spacing: .04em;
        text-transform: uppercase;
        color: #2b1f0a;
        background: linear-gradient(145deg, #f0cf8b, #dca43d);
        box-shadow: 0 4px 14px -6px rgba(220,164,61,.65);
    }

    /* ---- Card content ---- */
    .destination-card-content {
        position: absolute;
        left: 20px;
        right: 20px;
        bottom: 18px;
        z-index: 2;
        color: #fff;
    }
    .dest-region {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        font-size: 10.5px;
        font-weight: 600;
        letter-spacing: .14em;
        text-transform: uppercase;
        color: #c7e0cd;
        margin-bottom: 6px;
    }
    .dest-region::before {
        content: "";
        width: 5px;
        height: 5px;
        border-radius: 50%;
        background: #f0cf8b;
    }
    .destination-card h3 {
        font-family: var(--serif, Georgia, serif);
        font-weight: 400;
        font-size: 22px;
        line-height: 1.15;
        letter-spacing: -.01em;
        color: #fff;
        margin: 0 0 6px;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }
    .destination-card p {
        font-size: 12.5px;
        line-height: 1.5;
        color: #d8e3da;
        margin: 0 0 12px;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    /* ---- Card actions ---- */
    .dest-actions {
        display: flex;
        align-items: center;
        gap: 8px;
        opacity: 0;
        transform: translateY(6px);
        transition: opacity .25s ease, transform .25s ease;
    }
    .destination-card:hover .dest-actions,
    .destination-card:focus-within .dest-actions {
        opacity: 1;
        transform: translateY(0);
    }
    .dest-actions .dest-btn {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 7px 12px;
        border-radius: 8px;
        font-size: 12px;
        font-weight: 600;
        text-decoration: none;
        border: 1px solid transparent;
        cursor: pointer;
        transition: background .14s ease, border-color .14s ease, color .14s ease;
        font-family: inherit;
    }
    .dest-actions .dest-btn-primary {
        background: #fff;
        color: var(--forest, #164734);
    }
    .dest-actions .dest-btn-primary:hover {
        background: #f0cf8b;
        color: #1c1305;
    }
    .dest-actions .dest-btn-ghost {
        background: rgba(255,255,255,.14);
        color: #fff;
        border-color: rgba(255,255,255,.28);
        backdrop-filter: blur(6px);
        -webkit-backdrop-filter: blur(6px);
    }
    .dest-actions .dest-btn-ghost:hover {
        background: rgba(174,93,80,.85);
        border-color: rgba(174,93,80,.85);
    }
    .dest-actions form {
        margin: 0;
        display: contents;
    }

    /* ---- Empty states ---- */
    .dest-empty {
        text-align: center;
        padding: 64px 24px;
        background: var(--white, #fff);
        border: 1px dashed var(--line-hi, #d6dcd4);
        border-radius: 14px;
        color: var(--muted, #758078);
    }
    .dest-empty-icon {
        width: 56px;
        height: 56px;
        margin: 0 auto 16px;
        border-radius: 50%;
        background: var(--soft, #edf2ed);
        display: grid;
        place-items: center;
        color: var(--accent, #3c9169);
    }
    .dest-empty h3 {
        font-family: var(--serif, Georgia, serif);
        font-weight: 400;
        font-size: 22px;
        color: var(--forest, #164734);
        margin: 0 0 8px;
    }
    .dest-empty p {
        margin: 0 auto 20px;
        font-size: 13.5px;
        max-width: 40ch;
        line-height: 1.6;
    }

    /* ---- Alerts ---- */
    .dest-alert {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 12px 16px;
        border-radius: 10px;
        font-size: 13px;
        font-weight: 500;
        margin-bottom: 16px;
    }
    .dest-alert-success {
        background: rgba(60,145,105,.10);
        border: 1px solid rgba(60,145,105,.22);
        color: #236b4d;
    }
    .dest-alert-error {
        background: rgba(174,93,80,.10);
        border: 1px solid rgba(174,93,80,.22);
        color: #8b4137;
    }

    /* ---- Responsive (note the @@ escaping for Razor) ---- */
    @@media (max-width: 900px) {
        .dest-stats { grid-template-columns: repeat(2, 1fr); }
        .destination-banner { padding: 28px 24px; min-height: 200px; }
    }
    @@media (max-width: 640px) {
        .dest-toolbar { flex-direction: column; align-items: stretch; }
        .dest-filters { flex-direction: column; }
        .dest-search { max-width: none; }
        .dest-search input,
        .dest-filter-select { width: 100%; }
        .dest-results-count { text-align: right; }
        .destination-banner h1 { font-size: 28px; }
        .dest-badge-row { top: 10px; left: 10px; right: 10px; }
        .destination-card-content { left: 14px; right: 14px; bottom: 14px; }
        .destination-card h3 { font-size: 18px; }
        .dest-actions { opacity: 1; transform: none; }
    }
</style>

<div class="page-heading">
    <div>
        <div class="eyebrow">The atlas · @destinations.Count destinations</div>
        <h1>Places with a pulse.</h1>
        <p>Shape the visual story of every destination in the Karnel guide.</p>
    </div>
    <a class="btn btn-primary" href="/Admin/Destinations/Create">
        + Add destination
    </a>
</div>

@if (TempData["SuccessMessage"] is string success)
{
    <div class="dest-alert dest-alert-success" role="status">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
        @success
    </div>
}

@if (TempData["ErrorMessage"] is string error)
{
    <div class="dest-alert dest-alert-error" role="alert">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
        @error
    </div>
}

<div class="dest-stats">
    <div class="dest-stat">
        <span class="dest-stat-label">Total</span>
        <span class="dest-stat-value">@destinations.Count</span>
    </div>
    <div class="dest-stat">
        <span class="dest-stat-label">Published</span>
        <span class="dest-stat-value">@publishedCount</span>
    </div>
    <div class="dest-stat">
        <span class="dest-stat-label">Drafts</span>
        <span class="dest-stat-value">@draftCount</span>
    </div>
    <div class="dest-stat">
        <span class="dest-stat-label">Featured</span>
        <span class="dest-stat-value">@featuredCount</span>
    </div>
</div>

<section class="destination-banner">
    <div>
        <div class="eyebrow">Your travel atlas</div>
        <h1>Discover Pakistan.</h1>
        <p>Manage destinations, descriptions, imagery and publication status.</p>
    </div>
</section>

<div class="dest-toolbar">
    <div class="dest-filters">
        <div class="dest-search">
            <svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
            <input id="destination-search"
                   type="search"
                   placeholder="Search destinations…"
                   aria-label="Search destinations" />
        </div>

        <select class="dest-filter-select" id="region-filter" aria-label="Filter by region">
            <option value="">All regions</option>
            @foreach (var region in regions)
            {
                <option value="@region">@region</option>
            }
        </select>

        <select class="dest-filter-select" id="status-filter" aria-label="Filter by publication status">
            <option value="">All statuses</option>
            <option value="published">Published</option>
            <option value="draft">Draft</option>
            <option value="featured">Featured</option>
        </select>
    </div>
    <span class="dest-results-count">
        Showing <strong id="visible-count">@destinations.Count</strong> of @destinations.Count
    </span>
</div>

@if (destinations.Count == 0)
{
    <div class="dest-empty">
        <div class="dest-empty-icon">
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21s7-5.6 7-11a7 7 0 1 0-14 0c0 5.4 7 11 7 11z"/><circle cx="12" cy="10" r="2.6"/></svg>
        </div>
        <h3>No destinations yet</h3>
        <p>Your atlas is a blank canvas. Add your first destination and the story begins.</p>
        <a class="btn btn-primary" href="/Admin/Destinations/Create">+ Add your first destination</a>
    </div>
}
else
{
    <div class="destination-grid" id="destination-list">
        @foreach (var destination in destinations)
        {
            var status = destination.IsPublished ? "published" : "draft";
            var region = destination.Region ?? "";
            var image = string.IsNullOrWhiteSpace(destination.ImageUrl)
                ? "https://images.unsplash.com/photo-1518005020951-eccb494ad742?auto=format&fit=crop&w=1000&q=80"
                : destination.ImageUrl;

            <article class="destination-card filterable"
                     data-name="@destination.Name"
                     data-region="@region"
                     data-status="@status"
                     data-featured="@destination.IsFeatured.ToString().ToLowerInvariant()"
                     style="background-image: url('@image');">

                <div class="dest-card-image"></div>

                <div class="dest-badge-row">
                    <span class="dest-status @(destination.IsPublished ? "" : "is-draft")">
                        <i></i>
                        @(destination.IsPublished ? "Published" : "Draft")
                    </span>
                    @if (destination.IsFeatured)
                    {
                        <span class="dest-featured">★ Featured</span>
                    }
                </div>

                <div class="destination-card-content">
                    @if (!string.IsNullOrWhiteSpace(region))
                    {
                        <span class="dest-region">@region</span>
                    }

                    <h3>@destination.Name</h3>

                    <p>
                        @(string.IsNullOrWhiteSpace(destination.ShortDescription)
                            ? "No summary added yet."
                            : destination.ShortDescription)
                    </p>

                    <div class="dest-actions">
                        <a class="dest-btn dest-btn-primary"
                           href="/Admin/Destinations/Edit/@destination.Id">
                            Edit →
                        </a>
                        <form method="post"
                              action="/Admin/Destinations/Delete/@destination.Id"
                              onsubmit="return confirm('Delete this destination permanently?');">
                            @Html.AntiForgeryToken()
                            <button class="dest-btn dest-btn-ghost" type="submit">
                                Delete
                            </button>
                        </form>
                    </div>
                </div>
            </article>
        }
    </div>

    <div id="no-filter-results" class="dest-empty" style="display:none;">
        <div class="dest-empty-icon">
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
        </div>
        <h3>No matches</h3>
        <p>Try a different search term or reset the filters to see all destinations.</p>
        <button class="btn btn-quiet" type="button" id="reset-filters">Reset filters</button>
    </div>
}

<script>
    (() => {
        const search = document.getElementById("destination-search");
        const region = document.getElementById("region-filter");
        const status = document.getElementById("status-filter");
        const cards = [...document.querySelectorAll("#destination-list .destination-card")];
        const noResults = document.getElementById("no-filter-results");
        const visibleCount = document.getElementById("visible-count");
        const resetBtn = document.getElementById("reset-filters");

        if (!search) return;

        function filterDestinations() {
            const query = search.value.trim().toLowerCase();
            const selectedRegion = region.value.toLowerCase();
            const selectedStatus = status.value;
            let visible = 0;

            cards.forEach(card => {
                const name = (card.dataset.name || "").toLowerCase();
                const cardRegion = (card.dataset.region || "").toLowerCase();
                const cardStatus = card.dataset.status;
                const featured = card.dataset.featured === "true";

                const matches =
                    name.includes(query) &&
                    (!selectedRegion || cardRegion === selectedRegion) &&
                    (!selectedStatus ||
                        cardStatus === selectedStatus ||
                        (selectedStatus === "featured" && featured));

                card.style.display = matches ? "" : "none";
                if (matches) visible++;
            });

            if (visibleCount) visibleCount.textContent = visible;
            if (noResults) {
                noResults.style.display =
                    cards.length > 0 && visible === 0 ? "block" : "none";
            }
        }

        search.addEventListener("input", filterDestinations);
        region.addEventListener("change", filterDestinations);
        status.addEventListener("change", filterDestinations);

        if (resetBtn) {
            resetBtn.addEventListener("click", () => {
                search.value = "";
                region.value = "";
                status.value = "";
                filterDestinations();
                search.focus();
            });
        }
    })();
</script>