
@model IEnumerable<KarnelTravel.Models.Destination>

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Destinations";

    var destinations = Model.ToList();
    var regions = destinations
        .Where(d => !string.IsNullOrWhiteSpace(d.Region))
        .Select(d => d.Region!)
        .Distinct()
        .OrderBy(r => r)
        .ToList();
}

<div class="page-heading">
    <div>
        <div class="eyebrow">The atlas · @destinations.Count destinations</div>
        <h1>Places with a pulse.</h1>
        <p>Shape the visual story of every destination in the Karnel guide.</p>
    </div>
    <a class="btn btn-primary" href="/Admin/Destinations/Create">
        ＋ Add destination
    </a>
</div>

@if (TempData["SuccessMessage"] is string success)
{
    <div class="status status-confirmed" role="status">@success</div>
}

@if (TempData["ErrorMessage"] is string error)
{
    <div class="status status-pending" role="alert">@error</div>
}

<section class="destination-banner">
    <div>
        <div class="eyebrow">Your travel atlas</div>
        <h1>Discover Pakistan.</h1>
        <p>Manage destinations, descriptions, imagery and publication status.</p>
    </div>
</section>

<div class="toolbar">
    <div class="filters">
        <input class="input search-input"
               id="destination-search"
               placeholder="Search destinations..."
               aria-label="Search destinations" />

        <select class="select" id="region-filter" aria-label="Filter by region">
            <option value="">All regions</option>
            @foreach (var region in regions)
            {
                <option value="@region">@region</option>
            }
        </select>

        <select class="select" id="status-filter" aria-label="Filter by publication status">
            <option value="">All statuses</option>
            <option value="published">Published</option>
            <option value="draft">Draft</option>
            <option value="featured">Featured</option>
        </select>
    </div>
</div>

<div class="destination-grid" id="destination-list">
    @foreach (var destination in destinations)
    {
        var status = destination.IsPublished ? "published" : "draft";
        var region = destination.Region ?? "";
        var image = string.IsNullOrWhiteSpace(destination.ImageUrl)
            ? "https://images.unsplash.com/photo-1518005020951-eccb494ad742?auto=format&fit=crop&w=1000&q=80"
            : destination.ImageUrl;

        <article class="destination-card filterable"
                 data-name="@destination.Name"
                 data-region="@region"
                 data-status="@status"
                 data-featured="@destination.IsFeatured.ToString().ToLowerInvariant()"
                 style="background-image: linear-gradient(0deg, rgba(0,0,0,.88), rgba(0,0,0,.05)), url('@image'); background-size: cover; background-position: center;">

            <div class="destination-card-content">
                <span class="status @(destination.IsPublished ? "status-confirmed" : "status-pending")">
                    <i></i>
                    @(destination.IsPublished ? "Published" : "Draft")
                    @if (!string.IsNullOrWhiteSpace(region))
                    {
                        <text> · @region</text>
                    }
                </span>

                @if (destination.IsFeatured)
                {
                    <span class="eyebrow">★ Featured</span>
                }

                <h3>@destination.Name</h3>

                <p>
                    @(string.IsNullOrWhiteSpace(destination.ShortDescription)
                        ? "No summary added yet."
                        : destination.ShortDescription)
                </p>

                <div style="display:flex;gap:8px;flex-wrap:wrap;align-items:center;">
                    <a class="btn btn-primary"
                       href="/Admin/Destinations/Edit/@destination.Id">
                        Edit destination →
                    </a>

                    <form method="post"
                          action="/Admin/Destinations/Delete/@destination.Id"
                          onsubmit="return confirm('Delete this destination permanently?');">
                        @Html.AntiForgeryToken()
                        <button class="btn btn-quiet" type="submit">
                            Delete
                        </button>
                    </form>
                </div>
            </div>
        </article>
    }
</div>

<p id="no-destinations"
   class="muted"
   style="display:@(destinations.Count == 0 ? "block" : "none");">
    No destinations have been added yet. Select “Add destination” to create your first one.
</p>

<p id="no-filter-results" class="muted" style="display:none;">
    No destinations match your filters.
</p>

<script>
    (() => {
        const search = document.getElementById("destination-search");
        const region = document.getElementById("region-filter");
        const status = document.getElementById("status-filter");
        const cards = [...document.querySelectorAll("#destination-list .destination-card")];
        const noResults = document.getElementById("no-filter-results");

        function filterDestinations() {
            const query = search.value.trim().toLowerCase();
            const selectedRegion = region.value.toLowerCase();
            const selectedStatus = status.value;
            let visible = 0;

            cards.forEach(card => {
                const name = (card.dataset.name || "").toLowerCase();
                const cardRegion = (card.dataset.region || "").toLowerCase();
                const cardStatus = card.dataset.status;
                const featured = card.dataset.featured === "true";

                const matches =
                    name.includes(query) &&
                    (!selectedRegion || cardRegion === selectedRegion) &&
                    (!selectedStatus ||
                        cardStatus === selectedStatus ||
                        (selectedStatus === "featured" && featured));

                card.style.display = matches ? "" : "none";
                if (matches) visible++;
            });

            noResults.style.display =
                cards.length > 0 && visible === 0 ? "block" : "none";
        }

        search.addEventListener("input", filterDestinations);
        region.addEventListener("change", filterDestinations);
        status.addEventListener("change", filterDestinations);
    })();
</script>
