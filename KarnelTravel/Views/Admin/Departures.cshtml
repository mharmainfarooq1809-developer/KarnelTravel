
@model IEnumerable<KarnelTravel.ViewModels.AdminTourDepartureRowViewModel>

@{
     Layout = "_AdminLayout";
    ViewData["Title"] = "Tour Departures";
    var departures = Model?.ToList() ?? new List<KarnelTravel.ViewModels.AdminTourDepartureRowViewModel>();
    var packageId = departures.FirstOrDefault()?.TourPackageId ?? ViewBag.PackageId ?? 0;
    var packageName = departures.FirstOrDefault()?.PackageName ?? ViewBag.PackageName ?? "Tour Package";
    var totalDepartures = departures.Count;
    var activeDepartures = departures.Count(x => x.IsActive);
    var reservedSeats = departures.Sum(x => x.ReservedSeats);
    var availableSeats = departures.Sum(x => x.AvailableSeats);
}

<style>
    .departure-page {
        padding: 28px;
        color: #25352e;
    }

    .departure-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 20px;
        flex-wrap: wrap;
        margin-bottom: 28px;
    }

    .departure-eyebrow {
        color: #73877b;
        font-size: 11px;
        font-weight: 800;
        letter-spacing: 2px;
        text-transform: uppercase;
        margin-bottom: 9px;
    }

    .departure-title {
        font-size: clamp(25px, 3vw, 34px);
        font-weight: 750;
        letter-spacing: -1.2px;
        margin: 0;
        color: #20352b;
    }

    .departure-subtitle {
        color: #829087;
        font-size: 14px;
        margin-top: 8px;
    }

    .departure-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 9px;
        padding: 12px 19px;
        border-radius: 8px;
        background: #244b38;
        color: #fff;
        text-decoration: none;
        font-size: 13px;
        font-weight: 700;
        border: 1px solid #244b38;
        transition: .2s ease;
    }

    .departure-btn:hover {
        background: #183827;
        color: #fff;
        transform: translateY(-1px);
    }

    .departure-btn.secondary {
        background: #fff;
        color: #395347;
        border-color: #dce5df;
    }

    .departure-btn.secondary:hover {
        background: #f4f7f4;
        color: #20352b;
    }

    .departure-stats {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 15px;
        margin-bottom: 25px;
    }

    .departure-stat {
        background: #fff;
        border: 1px solid #e7ece8;
        border-radius: 11px;
        padding: 19px;
    }

    .departure-stat-label {
        color: #839087;
        font-size: 11px;
        font-weight: 800;
        letter-spacing: .8px;
        text-transform: uppercase;
    }

    .departure-stat-value {
        display: block;
        color: #253c30;
        font-size: 27px;
        font-weight: 750;
        margin-top: 9px;
    }

    .departure-stat-note {
        color: #9aa69e;
        font-size: 12px;
        margin-top: 3px;
    }

    .departure-table-card {
        background: #fff;
        border: 1px solid #e7ece8;
        border-radius: 12px;
        overflow: hidden;
    }

    .departure-table-heading {
        padding: 19px 22px;
        border-bottom: 1px solid #edf0ed;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        flex-wrap: wrap;
    }

    .departure-table-heading h2 {
        color: #2a4034;
        font-size: 16px;
        font-weight: 750;
        margin: 0;
    }

    .departure-table-heading span {
        color: #8b978f;
        font-size: 12px;
    }

    .departure-table {
        width: 100%;
        border-collapse: collapse;
        min-width: 850px;
    }

    .departure-table th {
        background: #f8faf8;
        color: #839087;
        font-size: 10px;
        font-weight: 800;
        letter-spacing: .8px;
        text-transform: uppercase;
        padding: 15px 18px;
        text-align: left;
        white-space: nowrap;
    }

    .departure-table td {
        padding: 17px 18px;
        border-top: 1px solid #edf0ed;
        color: #45574c;
        font-size: 13px;
        vertical-align: middle;
    }

    .departure-table tbody tr:hover {
        background: #fbfcfb;
    }

    .date-main {
        color: #2b4034;
        font-weight: 750;
    }

    .date-sub {
        color: #929e96;
        font-size: 11px;
        margin-top: 4px;
    }

    .capacity-number {
        font-weight: 750;
        color: #2b4034;
    }

    .capacity-bar {
        width: 100px;
        height: 5px;
        border-radius: 20px;
        background: #e9eee9;
        overflow: hidden;
        margin-top: 7px;
    }

    .capacity-fill {
        height: 100%;
        background: #527d60;
        border-radius: 20px;
    }

    .departure-status {
        display: inline-flex;
        align-items: center;
        padding: 6px 10px;
        border-radius: 30px;
        font-size: 10px;
        font-weight: 800;
    }

    .departure-status.active {
        color: #356c49;
        background: #eaf4ec;
    }

    .departure-status.inactive {
        color: #8a6252;
        background: #f6eeea;
    }

    .departure-actions {
        display: flex;
        gap: 7px;
        align-items: center;
    }

    .departure-action {
        display: inline-flex;
        justify-content: center;
        align-items: center;
        min-width: 57px;
        padding: 7px 10px;
        border: 1px solid #e0e7e1;
        border-radius: 6px;
        color: #40594a;
        background: #fff;
        text-decoration: none;
        font-size: 11px;
        font-weight: 700;
        cursor: pointer;
    }

    .departure-action:hover {
        background: #f2f6f2;
        color: #203b2b;
    }

    .departure-action.delete {
        color: #a34d48;
        border-color: #f0dfdd;
    }

    .departure-action.delete:hover {
        background: #fff3f1;
    }

    .departure-empty {
        padding: 65px 20px;
        text-align: center;
    }

    .departure-empty h3 {
        color: #304638;
        font-size: 19px;
        font-weight: 750;
    }

    .departure-empty p {
        color: #87948b;
        font-size: 13px;
        max-width: 420px;
        margin: 9px auto 20px;
    }

    .departure-alert {
        padding: 13px 16px;
        border-radius: 8px;
        margin-bottom: 18px;
        font-size: 13px;
    }

    .departure-alert.success {
        color: #28633e;
        background: #edf7ef;
        border: 1px solid #d8ebdc;
    }

    .departure-alert.error {
        color: #91423e;
        background: #fff0ee;
        border: 1px solid #f0d9d6;
    }

    @@media (max-width: 900px) {
        .departure-stats {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @@media (max-width: 600px) {
        .departure-page {
            padding: 16px;
        }

        .departure-stats {
            gap: 9px;
        }

        .departure-stat {
            padding: 14px;
        }

        .departure-stat-value {
            font-size: 23px;
        }
    }
</style>

<div class="departure-page">

    <div class="departure-header">
        <div>
            <div class="departure-eyebrow">Tour management / Schedule</div>
            <h1 class="departure-title">Departure Schedule</h1>
            <div class="departure-subtitle">
                Manage scheduled trips for <strong>@packageName</strong>.
            </div>
        </div>

        <div style="display:flex;gap:9px;flex-wrap:wrap;">
            <a asp-controller="Admin"
               asp-action="Tours"
               class="departure-btn secondary">
                ← Back to tours
            </a>

            <a asp-controller="Admin"
               asp-action="CreateDeparture"
               asp-route-packageId="@packageId"
               class="departure-btn">
                + Add departure
            </a>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="departure-alert success">
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="departure-alert error">
            @TempData["Error"]
        </div>
    }

    <div class="departure-stats">
        <div class="departure-stat">
            <div class="departure-stat-label">Total departures</div>
            <span class="departure-stat-value">@totalDepartures</span>
            <div class="departure-stat-note">Scheduled trips</div>
        </div>

        <div class="departure-stat">
            <div class="departure-stat-label">Active departures</div>
            <span class="departure-stat-value">@activeDepartures</span>
            <div class="departure-stat-note">Currently available schedules</div>
        </div>

        <div class="departure-stat">
            <div class="departure-stat-label">Reserved seats</div>
            <span class="departure-stat-value">@reservedSeats</span>
            <div class="departure-stat-note">Confirmed and completed bookings</div>
        </div>

        <div class="departure-stat">
            <div class="departure-stat-label">Available seats</div>
            <span class="departure-stat-value">@availableSeats</span>
            <div class="departure-stat-note">Across listed departures</div>
        </div>
    </div>

    <div class="departure-table-card">
        <div class="departure-table-heading">
            <h2>Scheduled departures</h2>
            <span>@totalDepartures schedule(s)</span>
        </div>

        @if (departures.Any())
        {
            <div style="overflow-x:auto;">
                <table class="departure-table">
                    <thead>
                        <tr>
                            <th>Departure</th>
                            <th>Return</th>
                            <th>Capacity</th>
                            <th>Reserved</th>
                            <th>Available</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var departure in departures.OrderBy(x => x.DepartureDate))
                        {
                            var percentage = departure.MaximumGroupSize > 0
                                ? Math.Clamp((double)departure.ReservedSeats / departure.MaximumGroupSize * 100, 0, 100)
                                : 0;

                            <tr>
                                <td>
                                    <div class="date-main">
                                        @departure.DepartureDate.ToString("dd MMM yyyy")
                                    </div>
                                    <div class="date-sub">
                                        @departure.DepartureDate.ToString("dddd")
                                    </div>
                                </td>

                                <td>
                                    <div class="date-main">
                                        @departure.ReturnDate.ToString("dd MMM yyyy")
                                    </div>
                                    <div class="date-sub">
                                        @departure.ReturnDate.ToString("dddd")
                                    </div>
                                </td>

                                <td>
                                    <div class="capacity-number">
                                        @departure.MaximumGroupSize seats
                                    </div>
                                    <div class="capacity-bar">
                                        <div class="capacity-fill"
                                             style="width:@percentage.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)%;">
                                        </div>
                                    </div>
                                </td>

                                <td>
                                    <span class="capacity-number">@departure.ReservedSeats</span>
                                </td>

                                <td>
                                    <span class="capacity-number">@departure.AvailableSeats</span>
                                </td>

                                <td>
                                    @if (departure.IsActive)
                                    {
                                        <span class="departure-status active">Active</span>
                                    }
                                    else
                                    {
                                        <span class="departure-status inactive">Inactive</span>
                                    }
                                </td>

                                <td>
                                    <div class="departure-actions">
                                        <a asp-controller="Admin"
                                           asp-action="EditDeparture"
                                           asp-route-packageId="@departure.TourPackageId"
                                           asp-route-id="@departure.Id"
                                           class="departure-action">
                                            Edit
                                        </a>

                                        <form asp-controller="Admin"
                                              asp-action="DeleteDeparture"
                                              asp-route-packageId="@departure.TourPackageId"
                                              asp-route-id="@departure.Id"
                                              method="post"
                                              onsubmit="return confirm('Are you sure you want to delete this departure? This action cannot be undone.');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="departure-action delete">
                                                Delete
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="departure-empty">
                <h3>No departures scheduled yet</h3>
                <p>
                    This tour does not have any scheduled departures.
                    Create a departure to make a fixed travel date available.
                </p>

                <a asp-controller="Admin"
                   asp-action="CreateDeparture"
                   asp-route-packageId="@packageId"
                   class="departure-btn">
                    + Create first departure
                </a>
            </div>
        }
    </div>

</div>
