@model IReadOnlyList<KarnelTravel.ViewModels.AdminCustomerViewModel>
@{ Layout = "_AdminLayout"; ViewData["Title"] = "Customers"; }
<div class="page-heading"><div><div class="eyebrow">CUSTOMER MANAGEMENT</div><h1>Customers</h1><p>Customer accounts and legacy booking owners connected to the travel portal.</p></div></div>
<div class="table-card">
    <div style="overflow-x:auto;">
        <table class="admin-table" style="width:100%;">
            <thead><tr><th>Customer</th><th>Email</th><th>Phone</th><th>Account</th><th>Verification</th><th>Bookings</th><th>Created</th></tr></thead>
            <tbody>
            @if (Model.Count == 0)
            {
                <tr><td colspan="7">No customer accounts have been registered yet.</td></tr>
            }
            else
            {
                foreach (var customer in Model)
                {
                    <tr>
                        <td><strong>@customer.Name</strong></td>
                        <td>@customer.Email</td>
                        <td>@(string.IsNullOrWhiteSpace(customer.PhoneNumber) ? "Not provided" : customer.PhoneNumber)</td>
                        <td>@customer.AccountType</td>
                        <td>@(customer.EmailConfirmed ? "Verified" : "Pending")</td>
                        <td>@customer.BookingCount</td>
                        <td>@(customer.CreatedAt == DateTime.MinValue ? "Legacy account" : customer.CreatedAt.ToString("dd MMM yyyy"))</td>
                    </tr>
                }
            }
            </tbody>
        </table>
    </div>
</div>
