@model KarnelTravel.Models.TransportService

@{
    ViewData["Title"] = Model.Id == 0 ? "Add Vehicle" : "Edit Vehicle";
    ViewData["Section"] = "Transport";
    Layout = "_AdminLayout";
    var isEdit = Model.Id > 0;
}

<div class="vehicle-form-page">
    <div class="page-heading">
        <div>
            <a asp-controller="Admin" asp-action="Transport" asp-route-tab="vehicles" class="back-link">
                <span aria-hidden="true">←</span> Back to Vehicles
            </a>
            <h1>@(isEdit ? "Edit Vehicle" : "Add Vehicle")</h1>
            <p>@(isEdit
                ? "Update the vehicle details below."
                : "Enter the vehicle information below.")</p>
        </div>
    </div>

    <form asp-controller="Admin"
          asp-action="@(isEdit ? "EditVehicle" : "CreateVehicle")"
          method="post"
          enctype="multipart/form-data"
          class="vehicle-form">

        @Html.AntiForgeryToken()

        <input type="hidden" asp-for="Id" />

        <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

        <!-- ================= IDENTITY ================= -->
        <section class="form-section">
            <div class="form-section-head">
                <h2>01. Vehicle identity</h2>
                <p>Name, slug and type used across the fleet and public site.</p>
            </div>

            <div class="form-grid">
                <div class="form-group">
                    <label asp-for="Name">Vehicle name <span class="req" aria-hidden="true">*</span></label>
                    <input asp-for="Name" placeholder="e.g. Toyota Corolla" required aria-required="true" />
                    <span asp-validation-for="Name" class="field-error"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Slug">URL slug <span class="req" aria-hidden="true">*</span></label>
                    <input asp-for="Slug" placeholder="e.g. toyota-corolla" required aria-required="true" />
                    <span asp-validation-for="Slug" class="field-error"></span>
                </div>

                <div class="form-group">
                    <label asp-for="VehicleType">Vehicle type</label>
                    <input asp-for="VehicleType" placeholder="e.g. Private Car" />
                </div>

                <div class="form-group">
                    <label asp-for="PassengerCapacity">Passenger capacity</label>
                    <input asp-for="PassengerCapacity" type="number" min="1" placeholder="4" />
                </div>
            </div>
        </section>

        <!-- ================= CONTACT ================= -->
        <section class="form-section">
            <div class="form-section-head">
                <h2>02. Contact</h2>
                <p>Phone number customers can reach for this vehicle.</p>
            </div>

            <div class="form-grid">
                <div class="form-group full-width">
                    <label asp-for="ContactPhone">Contact phone</label>
                    <input asp-for="ContactPhone" placeholder="03XXXXXXXXX" />
                </div>
            </div>
        </section>

        <!-- ================= IMAGE ================= -->
        <section class="form-section">
            <div class="form-section-head">
                <h2>03. Vehicle image</h2>
                <p>Upload a cover image. Leave empty to keep the current image when editing.</p>
            </div>

            <div class="form-group full-width">
                <label>Vehicle image</label>

                <label class="upload-box" id="uploadZone">
                    <input type="file"
                           id="VehicleImage"
                           name="VehicleImage"
                           accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp" />

                    <div class="upload-icon" aria-hidden="true">
                        <svg width="26" height="26" viewBox="0 0 24 24" fill="none"
                             stroke="currentColor" stroke-width="1.7"
                             stroke-linecap="round" stroke-linejoin="round">
                            <path d="M12 16V4" />
                            <path d="m6 10 6-6 6 6" />
                            <path d="M20 16v3a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1v-3" />
                        </svg>
                    </div>

                    <strong>Choose an image</strong>
                    <small>JPG, JPEG, PNG or WebP. Maximum size: 5 MB.</small>
                </label>

                <div class="image-preview-container" id="previewContainer"
                     style="@(string.IsNullOrWhiteSpace(Model.ImageUrl) ? "display:none" : "display:block")">

                    <img id="imagePreview"
                         src="@Model.ImageUrl"
                         alt="Vehicle image preview" />

                    <span>Image preview</span>
                </div>

                @if (isEdit && !string.IsNullOrWhiteSpace(Model.ImageUrl))
                {
                    <p class="current-image-note">
                        Leave the upload empty to keep the current image.
                    </p>
                }
            </div>
        </section>

        <!-- ================= DESCRIPTION ================= -->
        <section class="form-section">
            <div class="form-section-head">
                <h2>04. Description</h2>
                <p>Optional context shown on the vehicle's public page.</p>
            </div>

            <div class="form-grid">
                <div class="form-group full-width">
                    <label asp-for="Description">Description</label>
                    <textarea asp-for="Description" rows="4"
                              placeholder="Describe this vehicle..."></textarea>
                </div>
            </div>
        </section>

        <!-- ================= VISIBILITY ================= -->
        <section class="form-section">
            <div class="form-section-head">
                <h2>05. Visibility</h2>
                <p>Control how this vehicle appears on the website.</p>
            </div>

            <div class="form-grid">
                <div class="form-group">
                    <label asp-for="DisplayOrder">Display order</label>
                    <input asp-for="DisplayOrder" type="number" min="0" />
                    <span class="field-hint">Lower numbers appear earlier when sorted.</span>
                </div>

                <div class="form-group checkbox-group" role="group" aria-label="Visibility options">
                    <label class="check-option">
                        <input asp-for="IsPublished" />
                        <span>Published</span>
                    </label>

                    <label class="check-option">
                        <input asp-for="IsFeatured" />
                        <span>Featured</span>
                    </label>
                </div>
            </div>
        </section>

        <!-- ================= ACTIONS ================= -->
        <div class="form-actions">
            <a asp-controller="Admin" asp-action="Transport" asp-route-tab="vehicles" class="cancel-button">
                Cancel
            </a>
            <button type="submit" class="save-button">
                @(isEdit ? "Save Changes" : "Add Vehicle")
            </button>
        </div>
    </form>
</div>

<style>
    /* ============================================================
       VEHICLE EDITOR — premium page refinements
       Built on the Karnel Admin design tokens from _AdminLayout.
       ============================================================ */

    .vehicle-form-page {
        max-width: 1050px;
        margin: 0 auto;
        color: var(--ink);
    }

    /* ---------- Heading ---------- */
    .page-heading {
        margin-bottom: 26px;
    }

    .back-link {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        margin-bottom: 16px;
        padding: 7px 12px;
        border: 1px solid var(--line);
        border-radius: var(--radius-pill);
        background: var(--white);
        color: var(--forest);
        font-size: 12.5px;
        font-weight: 600;
        text-decoration: none;
        transition: background var(--dur-fast) var(--ease),
                    border-color var(--dur-fast) var(--ease),
                    box-shadow var(--dur-fast) var(--ease);
    }

    .back-link:hover {
        background: var(--soft);
        border-color: var(--line-hi);
        box-shadow: var(--shadow-sm);
    }

    .page-heading h1 {
        margin: 0 0 8px;
        font-size: clamp(26px, 3.2vw, 36px);
        font-weight: 700;
        letter-spacing: -.02em;
        color: var(--forest);
    }

    .page-heading p {
        margin: 0;
        max-width: 60ch;
        color: var(--muted);
        font-size: 14px;
        line-height: 1.6;
    }

    /* ---------- Form shell ---------- */
    .vehicle-form {
        background: var(--white);
        border: 1px solid var(--line);
        border-radius: var(--radius-lg, 16px);
        box-shadow: var(--shadow-sm);
        overflow: hidden;
    }

    /* ---------- Sections ---------- */
    .form-section {
        padding: 26px 28px;
        border-bottom: 1px solid var(--line);
    }

    .form-section:last-of-type {
        border-bottom: 0;
    }

    .form-section-head {
        margin-bottom: 20px;
    }

    .form-section-head h2 {
        margin: 0;
        font-size: 14px;
        font-weight: 700;
        letter-spacing: .01em;
        color: var(--forest);
    }

    .form-section-head p {
        margin: 6px 0 0;
        font-size: 12.5px;
        color: var(--muted);
        line-height: 1.55;
    }

    /* ---------- Grid ---------- */
    .form-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 20px 22px;
    }

    .form-group {
        display: flex;
        flex-direction: column;
        gap: 8px;
        min-width: 0;
    }

    .full-width {
        grid-column: 1 / -1;
    }

    .form-group > label,
    .form-group > .check-option > span {
        font-size: 13px;
        font-weight: 600;
        color: var(--ink);
        letter-spacing: .005em;
    }

    .req {
        color: #b42318;
        font-weight: 700;
    }

    /* ---------- Inputs ---------- */
    .form-group input:not([type="checkbox"]):not([type="file"]),
    .form-group textarea {
        width: 100%;
        box-sizing: border-box;
        border: 1px solid var(--line);
        border-radius: 9px;
        padding: 12px 13px;
        font: inherit;
        font-size: 13.5px;
        background: var(--white);
        color: var(--ink);
        outline: none;
        transition: border-color var(--dur-fast) var(--ease),
                    box-shadow var(--dur-fast) var(--ease),
                    background var(--dur-fast) var(--ease);
    }

    .form-group input::placeholder,
    .form-group textarea::placeholder {
        color: var(--muted);
        opacity: .85;
    }

    .form-group input:focus,
    .form-group textarea:focus {
        border-color: var(--accent);
        box-shadow: var(--ring-accent);
    }

    .form-group input.input-validation-error,
    .form-group textarea.input-validation-error {
        border-color: #d67e73 !important;
        background: #fff7f6;
    }

    .form-group textarea {
        min-height: 110px;
        resize: vertical;
        line-height: 1.6;
    }

    .field-hint {
        font-size: 11.5px;
        color: var(--muted);
        line-height: 1.5;
    }

    /* ---------- Upload ---------- */
    .upload-box {
        position: relative;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 26px 22px;
        border: 1.5px dashed var(--line-hi);
        border-radius: 12px;
        background: var(--soft);
        text-align: center;
        cursor: pointer;
        transition: border-color var(--dur-fast) var(--ease),
                    background var(--dur-fast) var(--ease),
                    box-shadow var(--dur-fast) var(--ease);
    }

    .upload-box:hover,
    .upload-box.drag-over {
        border-color: var(--accent);
        background: rgba(60, 145, 105, .06);
        box-shadow: 0 0 0 4px rgba(60, 145, 105, .06);
    }

    .upload-box input[type="file"] {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        opacity: 0;
        cursor: pointer;
    }

    .upload-icon {
        display: grid;
        place-items: center;
        width: 48px;
        height: 48px;
        margin-bottom: 12px;
        border-radius: 14px;
        background: var(--white);
        border: 1px solid var(--line);
        color: var(--accent);
    }

    .upload-box strong {
        font-size: 13px;
        font-weight: 600;
        color: var(--ink);
    }

    .upload-box small {
        margin-top: 5px;
        font-size: 11.5px;
        color: var(--muted);
    }

    /* ---------- Image preview ---------- */
    .image-preview-container {
        margin-top: 14px;
    }

    .image-preview-container img {
        display: block;
        width: 240px;
        max-width: 100%;
        height: 150px;
        object-fit: cover;
        border-radius: 10px;
        border: 1px solid var(--line);
        margin-bottom: 8px;
        box-shadow: var(--shadow-sm);
    }

    .image-preview-container span {
        font-size: 11.5px;
        color: var(--muted);
        letter-spacing: .02em;
    }

    .current-image-note {
        margin-top: 8px;
        font-size: 11.5px;
        color: var(--muted);
        line-height: 1.55;
    }

    /* ---------- Checkboxes ---------- */
    .checkbox-group {
        flex-direction: row;
        align-items: center;
        gap: 12px;
        padding-top: 6px;
        flex-wrap: wrap;
    }

    .check-option {
        display: inline-flex;
        align-items: center;
        gap: 9px;
        padding: 9px 14px 9px 12px;
        border: 1px solid var(--line);
        border-radius: 9px;
        background: var(--white);
        cursor: pointer;
        user-select: none;
        transition: border-color var(--dur-fast) var(--ease),
                    background var(--dur-fast) var(--ease);
    }

    .check-option:hover {
        border-color: var(--line-hi);
        background: var(--soft);
    }

    .check-option:has(input:checked) {
        border-color: rgba(60, 145, 105, .45);
        background: rgba(60, 145, 105, .08);
        color: #1f5a3f;
    }

    .check-option input[type="checkbox"] {
        width: 15px;
        height: 15px;
        margin: 0;
        accent-color: var(--accent);
        cursor: pointer;
    }

    /* ---------- Validation ---------- */
    .validation-summary {
        margin: 0 28px 0;
        padding: 13px 16px;
        border-radius: 10px;
        border: 1px solid rgba(174, 93, 80, .22);
        background: rgba(174, 93, 80, .08);
        color: #8b4137;
        font-size: 13px;
        font-weight: 500;
    }

    .validation-summary ul {
        margin: 6px 0 0;
        padding-left: 18px;
    }

    .validation-summary.validation-summary-valid {
        display: none;
    }

    .field-error {
        color: #b42318;
        font-size: 11.5px;
        font-weight: 500;
    }

    /* ---------- Actions ---------- */
    .form-actions {
        display: flex;
        justify-content: flex-end;
        gap: 10px;
        padding: 22px 28px;
        background: rgba(143, 168, 136, .05);
        border-top: 1px solid var(--line);
    }

    .save-button,
    .cancel-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 42px;
        padding: 0 20px;
        border-radius: 9px;
        border: 1px solid transparent;
        font: inherit;
        font-size: 13px;
        font-weight: 600;
        text-decoration: none;
        cursor: pointer;
        transition: background var(--dur-fast) var(--ease),
                    border-color var(--dur-fast) var(--ease),
                    box-shadow var(--dur-fast) var(--ease),
                    transform var(--dur-fast) var(--ease);
    }

    .save-button {
        background: var(--forest);
        color: #fff;
        box-shadow: 0 8px 20px -12px rgba(49, 92, 64, .55);
    }

    .save-button:hover {
        background: #244b38;
        transform: translateY(-1px);
        box-shadow: 0 12px 26px -12px rgba(49, 92, 64, .65);
    }

    .cancel-button {
        background: var(--white);
        border-color: var(--line);
        color: var(--ink);
    }

    .cancel-button:hover {
        background: var(--soft);
        border-color: var(--line-hi);
    }

    /* ---------- Responsive ---------- */
    @@media (max-width: 650px) {
        .vehicle-form-page { padding: 0; }
        .form-section { padding: 20px 18px; }
        .form-grid { grid-template-columns: 1fr; gap: 16px; }
        .full-width { grid-column: auto; }
        .checkbox-group { flex-wrap: wrap; }
        .form-actions { padding: 18px; flex-direction: column-reverse; align-items: stretch; }
        .form-actions .save-button,
        .form-actions .cancel-button { width: 100%; }
        .validation-summary { margin: 0 18px 0; }
    }

    /* ---------- Dark theme tuning ---------- */
    html[data-admin-theme="dark"] .validation-summary {
        background: rgba(174, 93, 80, .16);
        color: #f0c3ba;
        border-color: rgba(174, 93, 80, .32);
    }

    html[data-admin-theme="dark"] .upload-box {
        background: rgba(143, 168, 136, .06);
    }

    html[data-admin-theme="dark"] .upload-box:hover {
        background: rgba(60, 145, 105, .10);
    }

    @@media (prefers-color-scheme: dark) {
        html[data-admin-theme="system"] .validation-summary {
            background: rgba(174, 93, 80, .16);
            color: #f0c3ba;
            border-color: rgba(174, 93, 80, .32);
        }

        html[data-admin-theme="system"] .upload-box {
            background: rgba(143, 168, 136, .06);
        }

        html[data-admin-theme="system"] .upload-box:hover {
            background: rgba(60, 145, 105, .10);
        }
    }
</style>

<script>
    (() => {
        const imageInput = document.getElementById("VehicleImage");
        const preview = document.getElementById("imagePreview");
        const previewContainer = document.getElementById("previewContainer");
        const uploadZone = document.getElementById("uploadZone");

        if (!imageInput || !preview || !previewContainer) return;

        imageInput.addEventListener("change", function () {
            const file = this.files && this.files[0];

            if (!file) return;

            const allowedTypes = ["image/jpeg", "image/png", "image/webp"];

            if (!allowedTypes.includes(file.type)) {
                alert("Please select a JPG, PNG or WebP image.");
                this.value = "";
                return;
            }

            if (file.size > 5 * 1024 * 1024) {
                alert("Image size must not exceed 5 MB.");
                this.value = "";
                return;
            }

            const url = URL.createObjectURL(file);
            preview.onload = () => URL.revokeObjectURL(url);
            preview.src = url;
            previewContainer.style.display = "block";
        });

        // Drag-and-drop visual feedback on the upload zone.
        if (uploadZone) {
            ["dragenter", "dragover"].forEach(ev =>
                uploadZone.addEventListener(ev, e => {
                    e.preventDefault();
                    uploadZone.classList.add("drag-over");
                })
            );

            ["dragleave", "drop"].forEach(ev =>
                uploadZone.addEventListener(ev, e => {
                    e.preventDefault();
                    uploadZone.classList.remove("drag-over");
                })
            );
        }
    })();
</script>