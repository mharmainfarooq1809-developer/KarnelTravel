@{
    ViewData["Title"] = "Ways to Wander — Travel Information | Karnel Travel Guide";
    ViewData["Description"] = "Illustrative transport options between destinations in Pakistan — coach, private car, shared transport and air travel.";
}

@section Styles {
    <style>
        .page-hero { padding: calc(var(--header-h) + 60px) 0 60px; background: var(--forest-deep); color: var(--ivory); }
        .page-hero h1 { color: var(--ivory); max-width: 14ch; }
        .page-hero p { color: rgba(248, 246, 240, .82); font-size: 1.05rem; max-width: 62ch; }
        .page-hero .eyebrow { color: var(--sage); }

        .transport-card {
            display: grid;
            grid-template-columns: 1fr 2fr;
            gap: 0;
            border: 1px solid var(--line);
            border-radius: var(--radius-lg);
            overflow: hidden;
            background: var(--white);
            margin-bottom: 24px;
            transition: box-shadow .4s var(--ease);
        }
        .transport-card:hover { box-shadow: var(--shadow-md); }
        .transport-card .media { aspect-ratio: auto; min-height: 220px; border-radius: 0; }
        .transport-card__body { padding: 26px 28px; display: flex; flex-direction: column; gap: 12px; }
        .transport-card__meta { font-size: .68rem; letter-spacing: .16em; text-transform: uppercase; color: var(--muted); }
        .transport-card h3 { margin: 0; font-size: 1.35rem; }
        .transport-card p { color: var(--muted); font-size: .92rem; margin: 0; }
        .transport-card__info {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
            gap: 12px;
            padding-top: 14px;
            border-top: 1px solid var(--line);
        }
        .transport-card__info div span {
            display: block;
            font-size: .66rem;
            letter-spacing: .14em;
            text-transform: uppercase;
            color: var(--muted);
            margin-bottom: 3px;
        }
        .transport-card__info div strong {
            font-family: var(--serif);
            font-size: 1rem;
            font-weight: 400;
            color: var(--forest-deep);
        }

        .cta-band {
            background: var(--sand); padding: clamp(56px, 8vw, 100px) 0; text-align: center;
        }
        .cta-band p { color: var(--muted); max-width: 56ch; margin: 0 auto 28px; }

        @@media (max-width: 780px) {
            .transport-card { grid-template-columns: 1fr; }
            .transport-card .media { aspect-ratio: 16 / 10; min-height: 0; }
        }
    </style>
}

<header class="page-hero">
    <div class="container" data-reveal>
        <p class="eyebrow">Discover More · Travel Information</p>
        <h1>Ways to Wander.</h1>
        <p>Routes, fares and facilities are sample data shown in the structure the real
           inventory will use. Availability is not live yet.</p>
    </div>
</header>

<section class="section section--ivory">
    <div class="container">

        <article class="transport-card" data-reveal>
            <div class="media" data-fallback-label="Intercity coach">
                <img src="https://images.unsplash.com/photo-1544620347-c4fd4a3d5957?auto=format&fit=crop&w=900&q=70"
                     alt="Coach travelling on the highway" loading="lazy" />
            </div>
            <div class="transport-card__body">
                <span class="transport-card__meta">Bus &amp; Coach · Sample route</span>
                <h3>Islamabad → Gilgit</h3>
                <p>Long-distance coach service along the Karakoram Highway. Sample listing.</p>
                <div class="transport-card__info">
                    <div><span>Departure</span><strong>Islamabad</strong></div>
                    <div><span>Arrival</span><strong>Gilgit</strong></div>
                    <div><span>Sample fare</span><strong>PKR 6,500</strong></div>
                    <div><span>Duration</span><strong>~14 hours</strong></div>
                </div>
            </div>
        </article>

        <article class="transport-card" data-reveal>
            <div class="media" data-fallback-label="Private car">
                <img src="https://images.unsplash.com/photo-1494976388531-d1058494cdd8?auto=format&fit=crop&w=900&q=70"
                     alt="Car on a scenic road" loading="lazy" />
            </div>
            <div class="transport-card__body">
                <span class="transport-card__meta">Private Car · Sample service</span>
                <h3>Chauffeur-driven day hire</h3>
                <p>Flexible itineraries with a driver, ideal for multi-stop days.</p>
                <div class="transport-card__info">
                    <div><span>Base</span><strong>Lahore</strong></div>
                    <div><span>Sample rate / day</span><strong>PKR 18,000</strong></div>
                    <div><span>Seats</span><strong>Up to 4</strong></div>
                    <div><span>Fuel</span><strong>Included</strong></div>
                </div>
            </div>
        </article>

        <article class="transport-card" data-reveal>
            <div class="media" data-fallback-label="Shared transport">
                <img src="https://images.unsplash.com/photo-1544620347-c4fd4a3d5957?auto=format&fit=crop&w=900&q=70"
                     alt="Shared van on a mountain road" loading="lazy" />
            </div>
            <div class="transport-card__body">
                <span class="transport-card__meta">Shared Transport · Sample route</span>
                <h3>Gilgit → Hunza (shared van)</h3>
                <p>Shared vans serving common northern routes — details to be confirmed.</p>
                <div class="transport-card__info">
                    <div><span>Departure</span><strong>Gilgit</strong></div>
                    <div><span>Arrival</span><strong>Hunza</strong></div>
                    <div><span>Sample fare</span><strong>PKR 1,500</strong></div>
                    <div><span>Duration</span><strong>~2 hours</strong></div>
                </div>
            </div>
        </article>

        <article class="transport-card" data-reveal>
            <div class="media" data-fallback-label="Air travel">
                <img src="https://images.unsplash.com/photo-1544620347-c4fd4a3d5957?auto=format&fit=crop&w=900&q=70"
                     alt="Aircraft on the tarmac" loading="lazy" />
            </div>
            <div class="transport-card__body">
                <span class="transport-card__meta">Air Travel · Sample route</span>
                <h3>Islamabad → Skardu</h3>
                <p>Domestic flight to a northern hub. Fares are dynamic and not shown here.</p>
                <div class="transport-card__info">
                    <div><span>Departure</span><strong>Islamabad</strong></div>
                    <div><span>Arrival</span><strong>Skardu</strong></div>
                    <div><span>Sample fare</span><strong>On request</strong></div>
                    <div><span>Duration</span><strong>~1 hour</strong></div>
                </div>
            </div>
        </article>

    </div>
</section>

<section class="cta-band">
    <div class="container" data-reveal>
        <h2>Need help choosing a route?</h2>
        <p>Send us a message and we'll suggest an option that fits your itinerary.</p>
        <a class="btn" href="@Url.Action("Index", "Contact")">Get in Touch</a>
    </div>
</section>